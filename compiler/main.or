// orin — the self-hosted Orin compiler driver (Stage 1+).
//   orin workspace list|lock|check [--root <directory>]
//   orin check [--format=json] [--deps] [--strict-contracts] <entry.or | package-dir>
//   orin api [--check <snapshot>] <entry.or | package-dir>   public API snapshot / change detection
//   orin graph <entry.or | package-dir> [-o out.json]   OSIG snapshot (docs/osig.md)
//   orin diff --base <dir|.or|.json> --head <dir|.or|.json> [--format=json|text|html]   OSIG diff report
//   orin effects <entry.or | package-dir> [--format=json] [--summary] [--module M] [--function F] [--no-paths] [--tests] [--check-purity]
//       transitive effect summaries per function, module, package and `main`, with explanation paths (docs/capabilities.md)
//   orin expand [--input] <entry.or | package-dir>   the companion modules (`m.gen`) of the program, through the formatter (ADR-0046)
//   check/expand/compile run annotation processors (ADR-0046 S5) for the `.gen` modules they import:
//       [--processor-timeout S] [--processor-cache DIR] [--cc CMD] [--runtime DIR] [--verbose]
//   orin compile [--format=json] <entry.or> -o <out.c> [--no-verify] [--c-builtins] [--rt-wrappers] [--check-contracts] [--strict-contracts]
//       default pipeline: HIR -> MIR -> ownership verifier -> C (--backend=llvm: LLVM IR, -o x.ll)
//   orin fmt [--check] [--stdout] <file.or>...
//   orin lsp                 language server on stdio (spec 18)
//   orin mcp [--root <dir>] [--allow-exec] [--repo <dir>]   MCP server on stdio (spec 10)
//   orin test [--filter S] [--format=json] [--runtime DIR] [--cc CMD] <entry.or | package-dir>   run the @Test functions (docs/testing.md)
//   orin mir <entry.or>      print the MIR
//   orin verify --contracts [--format=json] [--z3 PATH] [--timeout-ms N] [--retry-ms N] [--rlimit N] [--strict] <entry.or>   verify contracts with z3 (docs/contracts.md)
//   orin verify <entry.or>   run the MIR ownership verifier (errors and warning count)
//   (compile/mir/verify run the MIR optimiser, compiler/opt, unless --no-opt is given)
//   compile/mir/verify load the std prelude (library/core/, spec 19 R1) implicitly: moved built-ins call
//   Orin code. --c-builtins skips it and keeps the C runtime path.

import { runWorkspaceWithOptions } from "./package";
import { Host, useHost } from "std:host";
import { FsGrant } from "std:fs";
import { ProcessGrant, args, exit } from "std:process";
import { StdioGrant } from "std:io";
import { ClockGrant, monotonicNow } from "std:time";
import { writeFile, fsErrorMessage } from "std:fs";
import {
  SourceMap, Diagnostic, render, describeSpan, TerminalOptions, terminalOptions, renderTerminal,
  paint,
} from "./diag";
import { loadWithRoots, preludeRoots, noPreludeRoots } from "./loader";
import { SourceFile } from "./diag";
import {
  check, checkWithIndex, checkRuntime, deprecationWarnings, hasDeprecated, qualityWarnings,
  strictContracts, parallelWarnings,
} from "./check";
import { runTestCommand, hasTests, eraseTests, ensureMain } from "./testing";
import {
  expandProgram, expandCompanions, noteGenerated, companionsText, inputsText, Cause, ProcConfig, defaultProcConfig,
  processorDiags,
} from "./expand";
import { LoadedProgram } from "./loader";
import { verifyContracts, reportJson, reportText, failedCount, unknownCount, SolverLimits, defaultSolverLimits } from "./vc";
import {
  moduleDeps, depsText, depsJsonText, apiSnapshot, apiDiff, effectPolicyDiags, policySourceMap,
  effectsContext, orbitPlan, orbitManifestC, ORBIT_TARGET, ORBIT_TARGET32, isOrbitTarget,
} from "./analysis";
import { readFile } from "std:fs";
import { lower } from "./lower";
import { emitCFacts, emitCSites, emitCSplit } from "./backends/c";
import { emitLlvmFacts } from "./backends/llvm";
import { MProgram, printProgram, hasSpan, withRtWrappers } from "./mir";
import { verify, VerifyIssue } from "./verify";
import { optimize, pruneProgram } from "./opt";
import { fuseProgram, FuseOut, ChainInfo } from "./fuse";
import { Program } from "./hir";
import {
  runFmt, printDiagnosticsJson, runGraph, runDiff, runEffects, runPackage, jsonString,
} from "./tools";
import { runLsp } from "./lsp";
import { runMcp } from "./mcp";

function usage(): void {
  console.error(
    "usage:\n  orin workspace list|lock|check [--root <directory>]\n  orin check [--format=json] [--deps] [--strict-contracts] <entry.or | package-dir>\n  orin api [--check <snapshot>] <entry.or | package-dir>\n  orin expand [--input] [--processor-timeout <seconds>] [--processor-cache <dir>] <entry.or | package-dir>\n  orin graph <entry.or | package-dir> [-o out.json]\n  orin diff --base <dir|.or|.json> --head <dir|.or|.json> [--format=json|text|html] [--link-base <url>] [-o out] [--exit-code]\n  orin effects <entry.or | package-dir> [--format=json] [--summary] [--module <id>] [--function <name>] [--no-paths] [--tests] [--check-purity]\n  orin compile [--format=json] <entry.or> -o <out.c> [--no-verify] [--no-opt] [--no-fuse] [--fuse-report] [--c-builtins] [--backend=c|llvm] [--target=native|wasm64-orbit|wasm32-orbit] [--check-contracts] [--strict-contracts] [--stats-sites] [--assert-facts] [--rt-wrappers] [--split <n>] [--timings <file.json>]\n  orin fmt [--check] [--stdout] <file.or>...\n  orin lsp\n  orin mcp [--root <dir>] [--allow-exec] [--repo <dir>]\n  orin test [--filter <substring>] [--format=json] [--runtime <dir>] [--cc <cmd>] <entry.or | package-dir>\n  orin mir <entry.or>\n  orin verify [--contracts [--format=json] [--z3 PATH] [--timeout-ms N] [--retry-ms N] [--rlimit N] [--strict]] <entry.or>",
  );
  exit(2);
}

function report(sm: SourceMap, diags: Diagnostic[], json: bool, ui: TerminalOptions): void {
  if (json) {
    printDiagnosticsJson(sm, diags);
    exit(1);
    return;
  }
  let shown: usize = 0;
  for (const d of diags) {
    if (ui.rich && shown >= ui.maxErrors) {
      break;
    }
    shown += 1;
    console.error(ui.rich ? renderTerminal(sm, d, ui.color, ui.ascii) + "\n" : render(sm, d));
  }
  if (ui.rich) {
    if (shown < diags.length) {
      console.error(
        (diags.length - shown).toString() + " more errors; use --max-errors N to show more.\n",
      );
    }
    const task = ui.args.length > 0 && ui.args[0] == "check" ? "Check" : "Compilation";
    console.error(
      task + " failed · " + diags.length.toString() + (diags.length == 1 ? " error" : " errors"),
    );
  }
  exit(1);
}

// Prints the warnings of the program without failing: `@Deprecated` uses (ADR-0024) and contract-quality
// warnings (ADR-0028; the strict ones when `strictFlag` or `[contracts] strict = true` is set), to stderr as
// text, or as JSON objects on stdout with --format=json.
function printWarnings(
  program: LoadedProgram,
  sm: SourceMap,
  json: bool,
  strictFlag: bool,
  ui: TerminalOptions,
): void {
  let ws: Diagnostic[] = [];
  if (hasDeprecated(program)) {
    ws = deprecationWarnings(program, checkWithIndex(program, sm).index);
  }
  ws = ws.concat(qualityWarnings(program, sm, strictContracts(program, strictFlag)));
  if (ws.length == 0) {
    return;
  }
  if (json) {
    printDiagnosticsJson(sm, ws);
    return;
  }
  for (const d of ws) {
    console.error(ui.rich ? renderTerminal(sm, d, ui.color, ui.ascii) + "\n" : render(sm, d));
  }
}

// The effect policy of `orin.toml` (`[effects]`, ADR-0037 D4): a module whose inferred effects exceed its allowance is a
// compile error (E0473). Checked on the program a build ships (`@Test` functions erased); a no-op without an `[effects]` table.
function policyCheck(program: LoadedProgram, sm: SourceMap, json: bool, ui: TerminalOptions): void {
  const shipped = hasTests(program) ? eraseTests(program) : program;
  const ds = effectPolicyDiags(shipped, sm);
  if (ds.length > 0) {
    report(policySourceMap(shipped, sm), ds, json, ui);
  }
}

// Runs the verifier; prints errors (and warnings when `verbose`). Returns the error count.
// An issue is located by function, block and instruction index and, when the MIR carries source positions
// (docs/mir.md v2.0), by `path:line:col` of the HIR node it was lowered from: `f b3 i2 at src/a.or:12:5: message`.
function issueWhere(sm: SourceMap, d: VerifyIssue): string {
  const where = d.func + " b" + d.block.toString() + " i" + d.instr.toString();
  return hasSpan(d.span) ? where + " at " + describeSpan(sm, d.span) : where;
}

function runVerify(prog: MProgram, sm: SourceMap, verbose: bool): usize {
  const rep = verify(prog);
  for (const d of rep.errors) {
    console.error("verify error: " + issueWhere(sm, d) + ": " + d.message);
  }
  if (verbose) {
    for (const d of rep.warnings) {
      console.log("warning: " + issueWhere(sm, d) + ": " + d.message);
    }
    console.log(
      "verify: " + rep.errors.length.toString() + " errors, " + rep.warnings.length.toString()
          + " warnings",
    );
  }
  return rep.errors.length;
}

// The compiler needs the whole file system (it reads sources and writes C / LLVM IR next to them), the process grant
// (`orin test`, `orin mcp` and `orin verify --contracts` run the C compiler and the solver; every command reads its
// arguments) and stdio (`orin lsp`, `orin mcp`); the clock is read only for `compile --timings`. The grants come from the host policy
// (ORIN_DENY, ADR-0027).
// The fusion pass (compiler/fuse); with `--fuse-report` every array pipeline it found is listed on stderr: where, its stages,
// and whether it became one loop (or why not).
function fused(p: Program, sm: SourceMap, report: bool): Program {
  const out = fuseProgram(p);
  if (report) {
    for (const c of out.chains) {
      const how = c.fused
          ? `fused into one loop${c.parallel ? " per chunk" : ""}${c.earlyExit ? ", early exit" : ""}${c.exactCap ? ", exact capacity" : ""}`
          : `not fused: ${c.reason}`;
      console.error(
        `${describeSpan(sm, c.span)}: ${c.parallel ? "parallel " : ""}${c.stages.join(" -> ")}: ${how}`,
      );
    }
  }
  return out.program;
}

function main(host: Host): void {
  useHost(
    host,
    (fs, proc, stdio, clock) => {
      driver(fs, proc, stdio, clock);
    },
  );
}

// A tool subcommand that owns its own arguments: the exit status of its run, or None when `cmd` is not one of them.
function runTool(
  fs: FsGrant,
  proc: ProcessGrant,
  stdio: StdioGrant,
  ui: TerminalOptions,
  cmd: string,
  rest: string[],
): Option<int> {
  return match (cmd) {
    "workspace" => Some(runWorkspaceWithOptions(fs, rest, ui).toInt()),
    "__package" => Some(runPackage(fs, rest)),
    "fmt" => Some(runFmt(fs, rest, ui)),
    "graph" => Some(runGraph(fs, rest)),
    "diff" => Some(runDiff(fs, rest)),
    "effects" => Some(runEffects(fs, rest, eraseTests)),
    "lsp" => Some(runLsp(fs, stdio)),
    "test" => Some(runTestCommand(fs, proc, args(proc).slice(1, args(proc).length))),
    "mcp" => Some(runMcp(fs, proc, stdio, rest)),
    _ => None,
  };
}

// The options of `check`, `api`, `mir`, `verify` and `compile`. `switches` holds the boolean flags that were given (see
// `switchNames`); the remaining words are the command, the entry and, for `compile`, `-o <out>`.
type Options = {
  switches: string[];
  z3: string;
  lim: SolverLimits;   // `--timeout-ms`, `--retry-ms`, `--rlimit` of `verify --contracts`
  checkSnap: Option<string>;
  timings: Option<string>;
  split: usize;
  target: string;      // `--target=`: "native" (default), "wasm64-orbit" or "wasm32-orbit" (analysis/orbit.or)
  argv: string[];
  procs: ProcConfig;   // `--processor-timeout`, `--cc`, `--runtime`, `--processor-cache` (ADR-0046 S5)
};

// Every boolean flag of the build commands. `--backend=c` is the absence of `--backend=llvm`.
function switchNames(): string[] {
  return [
    "--contracts",
    "--strict",
    "--strict-contracts",
    "--check-contracts",
    "--deps",
    "--input", // `orin expand --input`: the std:meta inputs of the processor runs instead of the companions
    "--format=json",
    "--no-verify",
    "--no-opt",
    "--no-fuse",
    "--fuse-report",
    "--backend=llvm",
    "--c-builtins",
    "--stats-sites",
    "--assert-facts", // check every forwarded load against its slot at run time (docs/mir.md v2.4); never on by default
    "--rt-wrappers", // also define the C-named test wrappers of the $rt entries (tools/rt_stub.sh, ADR-0052 Addendum B section 3)
  ];
}

function on(o: Options, flag: string): bool {
  return o.switches.includes(flag);
}

// None after printing the usage or the unknown-option error (both exit).
function parseOptions(all: string[]): Option<Options> {
  const known = switchNames();
  let o = Options { switches: [], z3: "z3", lim: defaultSolverLimits(), checkSnap: None, timings: None, split: 0, target: "native", argv: [], procs: defaultProcConfig() };
  let expectZ3 = false;
  let ai: usize = 0;
  while (ai < all.length) {
    const a = all[ai];
    ai += 1;
    if (expectZ3) {
      o.z3 = a;
      expectZ3 = false;
    } else if (a == "--z3") {
      expectZ3 = true;
    } else if (a == "--timeout-ms" || a == "--retry-ms" || a == "--rlimit") {
      const v = parseInt(ai < all.length ? all[ai] : "");
      ai += 1;
      if (v.isNone() || v.unwrap() < 0 || a == "--timeout-ms" && v.unwrap() == 0) {
        console.error("error: " + a + " needs a number of " + (a == "--rlimit" ? "resource units (0 = none)" : "milliseconds" + (a == "--retry-ms" ? " (0 = no retry)" : " (at least 1)")));
        exit(2);
        return None;
      }
      if (a == "--timeout-ms") {
        o.lim.timeoutMs = v.unwrap();
      } else if (a == "--retry-ms") {
        o.lim.retryMs = v.unwrap();
      } else {
        o.lim.rlimit = v.unwrap();
      }
    } else if (a == "--processor-timeout"
        || a == "--cc"
        || a == "--runtime"
        || a == "--processor-cache") {
      if (ai >= all.length) {
        usage();
        return None;
      }
      const v = all[ai];
      ai += 1;
      if (a == "--cc") {
        o.procs.cc = v;
      } else if (a == "--runtime") {
        o.procs.runtime = v;
      } else if (a == "--processor-cache") {
        o.procs.cacheDir = v;
      } else {
        const n = parseInt(v);
        if (n.isNone() || n.unwrap() < 0) {
          console.error("error: --processor-timeout needs a number of seconds (0 = unlimited)");
          exit(2);
          return None;
        }
        o.procs.timeout = n.unwrap();
      }
    } else if (a == "--check") {
      if (ai >= all.length) {
        usage();
        return None;
      }
      o.checkSnap = Some(all[ai]);
      ai += 1;
    } else if (a == "--timings") {
      if (ai >= all.length) {
        usage();
        return None;
      }
      o.timings = Some(all[ai]);
      ai += 1;
    } else if (a == "--split") {
      const n = parseInt(ai < all.length ? all[ai] : "");
      if (n.isNone() || n.unwrap() < 1 || n.unwrap() > 1024) {
        console.error("error: --split needs a number of translation units from 1 to 1024");
        exit(2);
        return None;
      }
      o.split = n.unwrap().toUsize();
      ai += 1;
    } else if (a.startsWith("--target=")) {
      const t = a.substring(9, a.length);
      if (t != "native" && !isOrbitTarget(t)) {
        console.error("error: unknown target `" + t + "`; the targets are native, " + ORBIT_TARGET + " and " + ORBIT_TARGET32);
        exit(2);
        return None;
      }
      o.target = t;
    } else if (a == "--backend=c") {
      o.switches = o.switches.filter(f => f != "--backend=llvm");
    } else if (known.includes(a)) {
      o.switches.push(a);
    } else if (a.startsWith("-") && a != "-o") {
      console.error("error: Unknown option `" + a + "`. Run `orin help` for available options.");
      exit(2);
      return None;
    } else {
      o.argv.push(a);
    }
  }
  return Some(o);
}

// Wall time per pipeline phase for `orin compile --timings <file>` (schema orin-timings/0.1). The only clock a program can
// reach is the monotonic one of std:time, in whole milliseconds, so a phase shorter than a millisecond reads 0 and the numbers
// are for trends over many runs, not for a single small program. A disabled timer reads no clock and records nothing, so
// the generated output cannot depend on the flag.
type Timer = { enabled: bool; last: int; names: string[]; ms: int[]; };

function nowMs(clock: ClockGrant, fallback: int): int {
  const r = monotonicNow(clock);
  return r.isOk() ? r.unwrap().millis : fallback;
}

function newTimer(clock: ClockGrant, enabled: bool): Timer {
  return Timer { enabled: enabled, last: enabled ? nowMs(clock, 0) : 0, names: [], ms: [] };
}

// the timer after the phase `name`, which began at the previous lap (unchanged when disabled)
function lapped(t: Timer, clock: ClockGrant, name: string): Timer {
  if (!t.enabled) {
    return t;
  }
  const n = nowMs(clock, t.last);
  return Timer { enabled: true, last: n, names: t.names.concat([name]), ms: t.ms.concat([n - t.last]) };
}

function timingsJson(t: Timer, entry: string, backend: string): string {
  let total: int = 0;
  let phases: string[] = [];
  let k: usize = 0;
  while (k < t.names.length) {
    total += t.ms[k];
    phases.push("{\"name\":" + jsonString(t.names[k]) + ",\"ms\":" + t.ms[k].toString() + "}");
    k += 1;
  }
  return "{\"schema\":\"orin-timings/0.1\",\"entry\":" + jsonString(entry) + ",\"backend\":" + jsonString(backend)
      + ",\"clock\":\"monotonic-ms\",\"phases\":[" + phases.join(",") + "],\"total\":" + total.toString() + "}\n";
}

type Built = { mir: MProgram; timer: Timer; };

// HIR -> fused -> MIR -> optimised: the pipeline of `mir`, `verify` and `compile`, with the timer after each phase.
function buildMir(checked: Program, sm: SourceMap, o: Options, t0: Timer, clock: ClockGrant): Built {
  const prepared = on(o, "--no-fuse") ? checked : fused(checked, sm, on(o, "--fuse-report"));
  const t1 = lapped(t0, clock, "hir");
  const m = lower(prepared);
  const t2 = lapped(t1, clock, "mir");
  const opt = on(o, "--no-opt") ? m : optimize(m);
  return Built { mir: opt, timer: lapped(t2, clock, "optimise") };
}

function driver(fs: FsGrant, proc: ProcessGrant, stdio: StdioGrant, clock: ClockGrant): void {
  const raw = args(proc);
  if (raw.length == 5 && raw[0] == "__result") {
    console.log(
      "{\"schemaVersion\":1,\"command\":" + jsonString(raw[1]) + ",\"ok\":" + raw[2] + ","
          + jsonString(raw[3]) + ":" + jsonString(raw[4]) + "}",
    );
    return;
  }
  const ui = terminalOptions(raw);
  const all = ui.args;
  if (all.length >= 1) {
    const tool = runTool(fs, proc, stdio, ui, all[0], all.slice(1, all.length));
    if (tool.isSome()) {
      exit(tool.unwrap());
      return;
    }
  }
  const parsed = parseOptions(all);
  if (parsed.isNone()) {
    return;
  }
  runBuildCommand(fs, proc, clock, ui, parsed.unwrap());
}

// `orin api`: prints the public API snapshot, or compares it with the snapshot given by `--check`.
function runApi(
  fs: FsGrant,
  program: LoadedProgram,
  sm: SourceMap,
  o: Options,
  json: bool,
  ui: TerminalOptions,
): void {
  const ci = checkWithIndex(program, sm);
  if (ci.result.isErr()) {
    report(sm, ci.result.unwrapErr(), json, ui);
    return;
  }
  const snap = apiSnapshot(program, ci.index);
  if (o.checkSnap.isNone()) {
    console.log(snap.substring(0, snap.length - 1));
    return;
  }
  const path = o.checkSnap.unwrap();
  const old = readFile(fs, path);
  if (old.isErr()) {
    console.error("error: cannot read " + path + ": " + fsErrorMessage(old.unwrapErr()));
    exit(2);
    return;
  }
  if (old.unwrap() == snap) {
    console.log("api unchanged");
    return;
  }
  console.error("error: public API changed (compared with " + path + "):");
  for (const l of apiDiff(old.unwrap(), snap)) {
    console.error(l);
  }
  exit(1);
}

// `orin check`: the program already checked; optionally prints the module dependencies.
function runCheck(program: LoadedProgram, o: Options, json: bool, ui: TerminalOptions): void {
  const deps = on(o, "--deps");
  if (deps) {
    const md = moduleDeps(program);
    const text = json ? depsJsonText(program, md) : depsText(program, md);
    console.log(text.substring(0, text.length - 1));
  }
  if (ui.rich && !json && !deps && !ui.quiet) {
    console.error(paint(ui.ascii ? "OK Check passed" : "✓ Check passed", "32", ui.color));
  }
}

// `orin verify --contracts`: proves the contracts with z3.
function runVerifyContracts(
  fs: FsGrant,
  proc: ProcessGrant,
  program: LoadedProgram,
  sm: SourceMap,
  checked: Program,
  o: Options,
  json: bool,
): void {
  const rep = verifyContracts(fs, proc, program, sm, checked, o.z3, o.lim);
  console.log(json ? reportJson(rep) : reportText(rep));
  if (failedCount(rep) > 0 || on(o, "--strict") && unknownCount(rep) > 0) {
    exit(1);
  }
}

// The file name of `path`: the text after the last `/`.
function baseName(path: string): string {
  let start: usize = 0;
  let i: usize = 0;
  while (i < path.length) {
    if (path.charCodeAt(i) == 47) {
      start = i + 1;
    }
    i += 1;
  }
  return path.substring(start, path.length);
}

// `orin compile`: MIR -> ownership verifier -> C (or LLVM IR) written to `out`.
function runCompile(
  fs: FsGrant,
  sm: SourceMap,
  checked: Program,
  o: Options,
  out: string,
  entry: string,
  t0: Timer,
  clock: ClockGrant,
  manifest: string,
): void {
  const llvm = on(o, "--backend=llvm");
  const assertFacts = on(o, "--assert-facts");
  const statsSites = on(o, "--stats-sites");
  const built = buildMir(checked, sm, o, t0, clock);
  const mir = on(o, "--rt-wrappers") ? withRtWrappers(built.mir) : built.mir;
  if (!on(o, "--no-verify") && runVerify(mir, sm, false) > 0) {
    console.error("error: internal compiler error: MIR ownership verification failed");
    exit(70);
    return;
  }
  const t1 = lapped(built.timer, clock, "verify");
  if (assertFacts && statsSites) {
    console.error("error: --assert-facts cannot be combined with --stats-sites");
    exit(2);
    return;
  }
  if (statsSites && llvm) {
    console.error("error: --stats-sites needs the C backend");
    exit(2);
    return;
  }
  if (o.split > 0 && (llvm || statsSites)) {
    console.error("error: --split needs the C backend without --stats-sites");
    exit(2);
    return;
  }
  let c = "";
  let parts: string[] = [];
  let partNames: string[] = [];
  if (o.split > 0) {
    // `out` is written as usual (the single-file unit, byte-identical to a build without the flag); the split layout is
    // written next to it: `<base>.h`, `<base>.<k>.c` and `<base>.data.c` (backends/c/split.or).
    const base = out.endsWith(".c") ? out.substring(0, out.length - 2) : out;
    const sp = emitCSplit(pruneProgram(mir), assertFacts, o.split, baseName(base) + ".h");
    c = sp.whole;
    parts.push(sp.header);
    partNames.push(base + ".h");
    parts.push(sp.data);
    partNames.push(base + ".data.c");
    let k: usize = 0;
    while (k < sp.units.length) {
      parts.push(sp.units[k]);
      partNames.push(base + "." + k.toString() + ".c");
      k += 1;
    }
  } else if (statsSites) {
    let paths: string[] = [];
    for (const f of sm.files) {
      paths.push(f.path);
    }
    c = emitCSites(pruneProgram(mir), paths);
  } else {
    c = llvm
        ? emitLlvmFacts(pruneProgram(mir), assertFacts)
        : emitCFacts(pruneProgram(mir), assertFacts);
  }
  // the Orbit capability manifest ("" for the native target): the very last thing in the file (analysis/orbit.or)
  c = c + manifest;
  const written = writeFile(fs, out, c);
  if (written.isErr()) {
    console.error("error: cannot write " + out + ": " + fsErrorMessage(written.unwrapErr()));
    exit(1);
    return;
  }
  let pi: usize = 0;
  while (pi < parts.length) {
    const pw = writeFile(fs, partNames[pi], parts[pi]);
    if (pw.isErr()) {
      console.error("error: cannot write " + partNames[pi] + ": " + fsErrorMessage(pw.unwrapErr()));
      exit(1);
      return;
    }
    pi += 1;
  }
  const t2 = lapped(t1, clock, "emit");
  if (t2.enabled) {
    const tw = writeFile(fs, o.timings.unwrap(), timingsJson(t2, entry, llvm ? "llvm" : "c"));
    if (tw.isErr()) {
      console.error("error: cannot write " + o.timings.unwrap() + ": " + fsErrorMessage(tw.unwrapErr()));
      exit(1);
    }
  }
}

// The settings for running processors: the command line options, `--verbose`, and whether a missing C compiler is only a
// warning (`orin check`, W0490).
function procConfig(o: Options, ui: TerminalOptions, lenient: bool): ProcConfig {
  return ProcConfig { ...o.procs, verbose: ui.verbose, lenient: lenient };
}

function runBuildCommand(
  fs: FsGrant,
  proc: ProcessGrant,
  clock: ClockGrant,
  ui: TerminalOptions,
  o: Options,
): void {
  const argv = o.argv;
  if (argv.length < 2) {
    usage();
    return;
  }
  const json = on(o, "--format=json");
  const verifyContractsFlag = on(o, "--contracts");
  const cmd = argv[0];
  const entry = argv[1];
  const isCompile = cmd == "compile";
  if (!isCompile && cmd != "check" && cmd != "mir" && cmd != "verify" && cmd != "api" && cmd != "expand") {
    usage();
    return;
  }
  if (isCompile && (argv.length < 4 || argv[2] != "-o")) {
    usage();
    return;
  }
  if (o.timings.isSome() && !isCompile) {
    console.error("error: --timings needs the compile command");
    exit(2);
    return;
  }
  const wasm = isOrbitTarget(o.target);
  if (o.target != "native" && !isCompile) {
    console.error("error: --target needs the compile command");
    exit(2);
    return;
  }
  if (wasm && (on(o, "--backend=llvm") || on(o, "--stats-sites") || o.split > 0)) {
    console.error("error: --target=" + o.target + " needs the C backend without --stats-sites and --split");
    exit(2);
    return;
  }
  const timer0 = newTimer(clock, o.timings.isSome());
  const usePrelude = !on(o, "--c-builtins") && cmd != "check" && cmd != "api" && cmd != "expand";
  const noOverlay: SourceFile[] = [];
  const loaded = loadWithRoots(
    fs,
    entry,
    noOverlay,
    usePrelude ? preludeRoots() : noPreludeRoots(),
  );
  if (loaded.diags.length > 0) {
    report(loaded.sm, loaded.diags, json, ui);
    return;
  }
  const timer1 = lapped(timer0, clock, "load");
  let program = loaded.program.unwrap();
  if (cmd == "expand") {
    const cs = expandCompanions(fs, proc, program, loaded.sm, procConfig(o, ui, false));
    if (cs.isErr()) {
      report(loaded.sm, cs.unwrapErr(), json, ui);
      return;
    }
    const text = on(o, "--input") ? inputsText(cs.unwrap()) : companionsText(program, cs.unwrap());
    console.log(text.endsWith("\n") ? text.substring(0, text.length - 1) : text);
    return;
  }
  // Companion modules (`import .. from "./m.gen"`, ADR-0046): filled from the recorded outputs; any other program is unchanged.
  const expanded = expandProgram(fs, proc, program, loaded.sm, procConfig(o, ui, cmd == "check"));
  if (expanded.isErr()) {
    report(loaded.sm, expanded.unwrapErr(), json, ui);
    return;
  }
  program = expanded.unwrap().program;
  const generated: Cause[] = expanded.unwrap().causes;
  for (const w of expanded.unwrap().warnings) {
    console.error(render(loaded.sm, w));
  }
  if (cmd == "check"
      && program.manifest.isSome()
      && (program.manifest.unwrap().entry == "module.or"
          || program.manifest.unwrap().entry.endsWith("/module.or"))) {
    program = ensureMain(program);
  }
  if (cmd == "api") {
    runApi(fs, program, loaded.sm, o, json, ui);
    return;
  }
  const strictFlag = on(o, "--strict-contracts");
  const withTests = cmd != "check" && hasTests(program);
  if (withTests) {
    // `@Test` functions are checked like everything else (so they cannot rot) but erased from the
    // program that is lowered: nothing they use reaches the output (ADR-0024).
    const full = check(program, loaded.sm);
    if (full.isErr()) {
      report(loaded.sm, noteGenerated(generated, full.unwrapErr()), json, ui);
      return;
    }
    printWarnings(program, loaded.sm, json && !verifyContractsFlag, strictFlag, ui);
    program = eraseTests(program);
  }
  const checked = on(o, "--check-contracts")
      ? checkRuntime(program, loaded.sm)
      : check(program, loaded.sm);
  if (checked.isErr()) {
    report(loaded.sm, noteGenerated(generated, checked.unwrapErr()), json, ui);
    return;
  }
  // `@Processor` rules and purity (ADR-0046 S5, E0448).
  const procDiags = processorDiags(program, loaded.sm, checked.unwrap().functions);
  if (procDiags.length > 0) {
    report(loaded.sm, procDiags, json, ui);
    return;
  }
  policyCheck(program, loaded.sm, json, ui);
  // Warnings that need the typed program: the parallel reductions of ADR-0039 (W0480, W0481).
  const pw = parallelWarnings(checked.unwrap().functions);
  if (pw.length > 0 && json && !verifyContractsFlag) {
    printDiagnosticsJson(loaded.sm, pw);
  } else if (pw.length > 0 && !json) {
    for (const d of pw) {
      console.error(
        ui.rich ? renderTerminal(loaded.sm, d, ui.color, ui.ascii) : render(loaded.sm, d),
      );
    }
  }
  if (!withTests) {
    printWarnings(program, loaded.sm, json && !verifyContractsFlag, strictFlag, ui);
  }
  const timer2 = lapped(timer1, clock, "check");
  // `--target=wasm64-orbit|wasm32-orbit`: the capabilities `main` needs, from the effect analysis; an effect the target lacks is E0523.
  let manifest = "";
  if (isCompile && wasm) {
    const shipped = hasTests(program) ? eraseTests(program) : program;
    const ci = checkWithIndex(shipped, loaded.sm);
    const plan = orbitPlan(effectsContext(shipped, ci.index, loaded.sm), o.target);
    if (plan.errors.length > 0) {
      report(loaded.sm, plan.errors, json, ui);
      return;
    }
    manifest = orbitManifestC(plan.requires);
  }
  if (cmd == "check") {
    runCheck(program, o, json, ui);
  } else if (cmd == "mir") {
    console.log(printProgram(buildMir(checked.unwrap(), loaded.sm, o, timer2, clock).mir));
  } else if (cmd == "verify" && verifyContractsFlag) {
    runVerifyContracts(fs, proc, program, loaded.sm, checked.unwrap(), o, json);
  } else if (cmd == "verify") {
    if (runVerify(buildMir(checked.unwrap(), loaded.sm, o, timer2, clock).mir, loaded.sm, true) > 0) {
      exit(1);
    }
  } else {
    runCompile(fs, loaded.sm, checked.unwrap(), o, argv[3], entry, timer2, clock, manifest);
  }
}
