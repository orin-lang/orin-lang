import { SourceFile } from "../diag";

export function embeddedRtFiles(): SourceFile[] {
  let out: SourceFile[] = [];
  out.push(SourceFile { path: "$rt/array.or", text: "// $rt/array -- array slice, concatenation and extension and the byte conversions, written in Orin (ADR-0052 Addendum A, step R3d.4).\n//\n// The backends call these functions by name (compiler/mir/rt.or lists them; opt/prune.or keeps them) in place of the C runtime\n// functions `orin_array_slice`, `orin_array_concat`, `orin_array_extend`, `orin_bytes_to_string` and `orin_string_to_bytes`; the C\n// unit tests of the runtime reach them through the wrappers of the same C names. An object is its address as a `usize`; the layout\n// is the frozen one (heap.or): array len@16 cap@24 is_ref@32 items@40, the items 8-byte slots; string len@16 cap@24 data@32.\n// A reference array (`is_ref` != 0) owns one count of each element: copying it retains every element (a loop over the slots), a\n// scalar array is copied as bytes. Counters are updated exactly as the C versions did (the ORIN_STATS=1 report is the oracle).\n\nimport { load8, load32, load64, store8, store64, memCopy, heapBase, cfg, wadd, wsub, wmul, shl, and, or } from \"std:core\";\nimport { taskTrap } from \"std:fsraw\";\nimport { sbRealloc, addAt, statGrow, siteGrow, S_ARRAY_GROWS } from \"./heap\";\nimport { arrayNew, strAlloc } from \"./object\";\nimport { retain, release } from \"./rc\";\nimport { trapShape } from \"./leaf\";\n\n// Copy `n` slots from `src` to `dst` (ranges that do not overlap); a reference array retains each element.\n@Inline\nfunction copySlots(dst: usize, src: usize, n: usize, isRef: usize): void {\n  if (n == 0) {\n    return;\n  }\n  if (isRef != 0) {\n    let i: usize = 0;\n    while (i < n) {\n      const v = load64(wadd(src, shl(i, 3)));\n      store64(wadd(dst, shl(i, 3)), v);\n      retain(v);\n      i = wadd(i, 1);\n    }\n  } else {\n    memCopy(dst, src, shl(n, 3));\n  }\n}\n\n// The slots `lo .. hi` of `o` as a new array of the same element kind; traps \"slice out of range\" unless lo <= hi <= len.\nexport function arraySlice(o: usize, lo: usize, hi: usize): usize {\n  if (lo > hi || hi > load64(wadd(o, 16))) {\n    taskTrap(\"slice out of range\");\n  }\n  const isRef = load64(wadd(o, 32));\n  const k = wsub(hi, lo);\n  const r = arrayNew(k, isRef);\n  if (k != 0) {\n    copySlots(load64(wadd(r, 40)), wadd(load64(wadd(o, 40)), shl(lo, 3)), k, isRef);\n    store64(wadd(r, 16), k);\n  }\n  return r;\n}\n\n// x ++ y as a new array (a reference array when either is).\nexport function arrayConcat(x: usize, y: usize): usize {\n  const la = load64(wadd(x, 16));\n  const lb = load64(wadd(y, 16));\n  const n = wadd(la, lb);\n  const r = arrayNew(n, or(load64(wadd(x, 32)), load64(wadd(y, 32))));\n  if (n != 0) {\n    const dst = load64(wadd(r, 40));\n    copySlots(dst, load64(wadd(x, 40)), la, load64(wadd(x, 32)));\n    copySlots(wadd(dst, shl(la, 3)), load64(wadd(y, 40)), lb, load64(wadd(y, 32)));\n    store64(wadd(r, 16), n);\n  }\n  return r;\n}\n\n// The item buffer of the unique array `x` grown to hold at least `n` slots: at least twice the capacity, 4 slots at the least. Out of\n// line: the in-place path of `arrayExtend` stays small.\nfunction growItems(x: usize, n: usize): void {\n  const cap = load64(wadd(x, 24));\n  let ncap = wmul(cap, 2);\n  if (ncap < n) {\n    ncap = n;\n  }\n  if (ncap < 4) {\n    ncap = 4;\n  }\n  if (ncap > 1099511627776) {\n    taskTrap(\"array too large\");\n  }\n  store64(wadd(x, 40), sbRealloc(load64(wadd(x, 40)), shl(cap, 3), shl(ncap, 3)));\n  statGrow(shl(wsub(ncap, cap), 3));\n  if (cfg(1) == 1) {\n    addAt(wadd(heapBase(), S_ARRAY_GROWS), 1);\n  }\n  siteGrow(x, shl(wsub(ncap, cap), 3));\n  store64(wadd(x, 24), ncap);\n}\n\n// x ++ y as a new array and one count of `x` released (the copying path of `arrayExtend`).\nfunction extendCopy(x: usize, y: usize): usize {\n  const r = arrayConcat(x, y);\n  release(x);\n  return r;\n}\n\n// x = x ++ y. Consumes `x`; `y` is only read. In place only when `x` is unique, is not `y` and the element kinds agree (or `x` is\n// empty); else a new array and one count of `x` released.\nexport function arrayExtend(x: usize, y: usize): usize {\n  if (load32(wadd(x, 8)) != 2 || load32(wadd(y, 8)) != 2) {\n    trapShape();\n  }\n  const lb = load64(wadd(y, 16));\n  if (lb == 0) {\n    return x;\n  }\n  const la = load64(wadd(x, 16));\n  const xRef = load64(wadd(x, 32));\n  const yRef = load64(wadd(y, 32));\n  if (load64(x) == 1 && x != y && (xRef == yRef || la == 0)) {\n    const n = wadd(la, lb);\n    if (n > load64(wadd(x, 24))) {\n      growItems(x, n);\n    }\n    store64(wadd(x, 32), yRef);\n    copySlots(wadd(load64(wadd(x, 40)), shl(la, 3)), load64(wadd(y, 40)), lb, yRef);\n    store64(wadd(x, 16), n);\n    return x;\n  }\n  return extendCopy(x, y);\n}\n\n// Narrow `n` 8-byte slots at `src` to bytes at `dst`. The slots of a u8 array hold 0..255, but the runtime does not trust that: the\n// result is the OR of all slots, so a value above 255 shows as a result above 255. Eight elements per step.\nfunction narrow(dst: usize, src: usize, n: usize): usize {\n  let bad: usize = 0;\n  let i: usize = 0;\n  const n8 = wsub(n, and(n, 7));\n  let p = src;\n  let q = dst;\n  while (i < n8) {\n    const a = load64(p);\n    const b = load64(wadd(p, 8));\n    const c = load64(wadd(p, 16));\n    const d = load64(wadd(p, 24));\n    const e = load64(wadd(p, 32));\n    const f = load64(wadd(p, 40));\n    const g = load64(wadd(p, 48));\n    const h = load64(wadd(p, 56));\n    bad = or(bad, or(or(or(a, b), or(c, d)), or(or(e, f), or(g, h))));\n    store8(q, a);\n    store8(wadd(q, 1), b);\n    store8(wadd(q, 2), c);\n    store8(wadd(q, 3), d);\n    store8(wadd(q, 4), e);\n    store8(wadd(q, 5), f);\n    store8(wadd(q, 6), g);\n    store8(wadd(q, 7), h);\n    p = wadd(p, 64);\n    q = wadd(q, 8);\n    i = wadd(i, 8);\n  }\n  while (i < n) {\n    const v = load64(p);\n    bad = or(bad, v);\n    store8(q, v);\n    p = wadd(p, 8);\n    q = wadd(q, 1);\n    i = wadd(i, 1);\n  }\n  return bad;\n}\n\n// Widen `n` bytes at `src` to 8-byte slots at `dst`. Eight elements per step.\nfunction widen(dst: usize, src: usize, n: usize): void {\n  let i: usize = 0;\n  const n8 = wsub(n, and(n, 7));\n  let p = src;\n  let q = dst;\n  while (i < n8) {\n    store64(q, load8(p));\n    store64(wadd(q, 8), load8(wadd(p, 1)));\n    store64(wadd(q, 16), load8(wadd(p, 2)));\n    store64(wadd(q, 24), load8(wadd(p, 3)));\n    store64(wadd(q, 32), load8(wadd(p, 4)));\n    store64(wadd(q, 40), load8(wadd(p, 5)));\n    store64(wadd(q, 48), load8(wadd(p, 6)));\n    store64(wadd(q, 56), load8(wadd(p, 7)));\n    p = wadd(p, 8);\n    q = wadd(q, 64);\n    i = wadd(i, 8);\n  }\n  while (i < n) {\n    store64(q, load8(p));\n    p = wadd(p, 1);\n    q = wadd(q, 8);\n    i = wadd(i, 1);\n  }\n}\n\n// The bytes `o[start .. start + len)` of a u8 array as a string. Traps on a value that is not an array of scalars, on a range outside\n// the array (\"slice out of range\") and on an element above 255 (\"byte out of range\").\nexport function bytesToString(o: usize, start: usize, len: usize): usize {\n  if (load32(wadd(o, 8)) != 2 || load64(wadd(o, 32)) != 0) {\n    trapShape();\n  }\n  const alen = load64(wadd(o, 16));\n  if (start > alen || len > wsub(alen, start)) {\n    taskTrap(\"slice out of range\");\n  }\n  const s = strAlloc(len, len);\n  // an empty array may have no item buffer: form an element address only when len > 0\n  if (len != 0) {\n    const bad = narrow(wadd(s, 32), wadd(load64(wadd(o, 40)), shl(start, 3)), len);\n    if (bad > 255) {\n      release(s);\n      taskTrap(\"byte out of range\");\n    }\n  }\n  return s;\n}\n\n// The bytes of a string as a u8 array.\nexport function stringToBytes(o: usize): usize {\n  if (load32(wadd(o, 8)) != 1) {\n    trapShape();\n  }\n  const len = load64(wadd(o, 16));\n  const r = arrayNew(len, 0);\n  if (len != 0) {\n    widen(load64(wadd(r, 40)), wadd(o, 32), len);\n    store64(wadd(r, 16), len);\n  }\n  return r;\n}\n" });
  out.push(SourceFile { path: "$rt/coreprobe.or", text: "// std:coreprobe -- self-test of the core operations (ADR-0052 step R3a, spec 19 section 4; hir/coreops.or).\n//\n// INTERNAL. The core operations (raw loads / stores at a usize address, platform memory functions, the object address of a\n// reference) are reachable only through the internal module std:core, which only the modules of the embedded `$rt` root\n// (runtime/core/) can import, so a test of them has to live here. It is reached as `std:coreprobe` (loader/resolve.or). `coreProbe()` runs every operation on memory it allocates itself and returns one line per\n// check; `tests/run/core_ops.or` prints it and the conformance suite compares the output on both backends (C and LLVM). It\n// touches no memory but its own allocations. Delete it when the runtime modules of R3b+ exercise the operations for real.\n\nimport {\n  load8, load32, load64, loadF64, store8, store32, store64, storeF64, memAlloc, memFree, memCopy, memSet, addrOf,\n  and, or, xor, shl, shr, expect, cfg, heapBase, memRealloc, memMove, memCmp, wadd, wsub, wmul, hook, plat, fnAddr, sharedBase\n} from \"std:core\";\nimport {\n  PL_THREAD_CREATE, PL_THREAD_JOIN, PL_THREAD_ID, PL_MONITOR_NEW, PL_MONITOR_FREE, PL_MONITOR_LOCK, PL_MONITOR_UNLOCK,\n  PL_MONITOR_WAIT_UNTIL, PL_MONITOR_NOTIFY, PL_MONITOR_GET, PL_MONITOR_SET, PL_MONITOR_GROW, PL_RUNTIME_LOCK, PL_RUNTIME_UNLOCK,\n  PL_CPU_COUNT, PL_GETENV, PL_WRITE_LINE\n} from \"./plat\";\nimport { H_SCRATCH } from \"./heap\";\n\n// The target of `fnAddr` below: the thread entry `void(void *)` of the probe (mir/rt.or `RT_CORE_PROBE_FN`, entry 55, with the C-ABI wrapper\n// `orin_probe_entry`). It runs on a thread that L0 starts; the argument is the address of a word that it sets.\nexport function probeEntry(cell: usize): void {\n  store64(cell, 42);\n}\n\ntype Pair = { x: int; y: int; };\n\nfunction line(name: string, ok: bool): string {\n  return name + (ok ? \" ok\" : \" FAIL\") + \"\\n\";\n}\n\n// One line per operation: \"<name> ok\" or \"<name> FAIL\".\nexport function coreProbe(): string {\n  let out = \"\";\n  const a = memAlloc(64);\n  out += line(\"memAlloc\", a != 0);\n\n  // memSet / load8: every byte of the block, and only the low 8 bits of the value are used\n  memSet(a, 0, 64);\n  out += line(\"memSet zero\", load64(a) == 0 && load64(a + 56) == 0);\n  memSet(a, 0x1AB, 16);\n  out += line(\"memSet byte\", load8(a) == 0xAB && load8(a + 15) == 0xAB && load8(a + 16) == 0);\n  out += line(\"load8 zero-extends\", load8(a) == 171);\n\n  // store8 / store32 / store64 and the loads, at unaligned addresses too\n  memSet(a, 0, 64);\n  store8(a, 0x1FF);\n  out += line(\"store8 low byte\", load8(a) == 255 && load8(a + 1) == 0);\n  store32(a + 4, 0x1DEADBEEF);\n  out += line(\"store32 low word\", load32(a + 4) == 0xDEADBEEF && load32(a + 8) == 0);\n  out += line(\"load32 zero-extends\", load32(a + 4) == 3735928559);\n  store64(a + 8, 0x0123456789ABCDEF);\n  out += line(\"store64\", load64(a + 8) == 0x0123456789ABCDEF);\n  store64(a + 17, 18446744073709551615);\n  out += line(\"load64 unaligned\", load64(a + 17) == 18446744073709551615 && load8(a + 16) == 0 && load8(a + 25) == 0);\n  store32(a + 33, 1);\n  out += line(\"load32 unaligned\", load32(a + 33) == 1);\n  out += line(\"native order\", load8(a + 8) == load64(a + 8) - (load64(a + 8) / 256) * 256);\n\n  // floats\n  storeF64(a + 40, 1.5);\n  out += line(\"storeF64 / loadF64\", loadF64(a + 40) == 1.5);\n  storeF64(a + 41, -0.25);\n  out += line(\"loadF64 unaligned\", loadF64(a + 41) == -0.25);\n  store64(a + 48, 0x3FF0000000000000);\n  out += line(\"loadF64 bits\", loadF64(a + 48) == 1.0);\n  storeF64(a + 48, 2.0);\n  out += line(\"storeF64 bits\", load64(a + 48) == 0x4000000000000000);\n\n  // memCopy\n  const b = memAlloc(64);\n  memSet(b, 7, 64);\n  memCopy(b + 3, a + 8, 8);\n  out += line(\"memCopy\", load64(b + 3) == 0x0123456789ABCDEF && load8(b + 2) == 7 && load8(b + 11) == 7);\n  memCopy(b, a, 0);\n  out += line(\"memCopy zero length\", load8(b) == 7);\n\n  // memAlloc(0) is a valid block of one byte, never address 0\n  const z = memAlloc(0);\n  out += line(\"memAlloc zero\", z != 0);\n  store8(z, 9);\n  out += line(\"memAlloc zero usable\", load8(z) == 9);\n\n  // addrOf: the object address of a reference; stable, distinct per object, and it leaves the object alone\n  const s = \"core\";\n  const t = \"dore\";\n  const xs: int[] = [1, 2, 3];\n  out += line(\"addrOf string\", addrOf(s) != 0 && addrOf(s) == addrOf(s) && addrOf(s) != addrOf(t));\n  out += line(\"addrOf array\", addrOf(xs) != 0 && addrOf(xs) == addrOf(xs) && addrOf(xs) != addrOf(s));\n  out += line(\"addrOf aligned\", addrOf(s) / 8 * 8 == addrOf(s) && addrOf(xs) / 8 * 8 == addrOf(xs));\n  out += line(\"addrOf leaves value\", s == \"core\" && xs.length == 3 && xs[2] == 3);\n\n  // addrOf needs the real object (ADR-0052 Addendum A, rule 2): the optimiser must not unbox the record or scalar-replace the\n  // array, so the layout is there: string len@16 data@32, array len@16 items@40 (a pointer to the buffer), struct nslots@16 slots@32\n  const u = \"wxyz\";\n  const pr = Pair { x: 7, y: 9 };\n  const ys: int[] = [4, 5, 6];\n  out += line(\"addrOf string layout\", load64(addrOf(u) + 16) == 4 && load8(addrOf(u) + 32) == 119 && load8(addrOf(u) + 35) == 122);\n  out += line(\"addrOf array layout\", load64(addrOf(ys) + 16) == 3 && load64(load64(addrOf(ys) + 40)) == 4 && load64(load64(addrOf(ys) + 40) + 16) == 6);\n  out += line(\"addrOf record layout\", load64(addrOf(pr) + 16) == 2 && load64(addrOf(pr) + 32) == 7 && load64(addrOf(pr) + 40) == 9);\n\n  // bit operations on usize\n  out += line(\"and\", and(0xF0F0, 0xFF00) == 0xF000 && and(18446744073709551615, 5) == 5);\n  out += line(\"or\", or(0xF0F0, 0x0F0F) == 0xFFFF && or(0, 0) == 0);\n  out += line(\"xor\", xor(0xFF, 0x0F) == 0xF0 && xor(18446744073709551615, 18446744073709551615) == 0);\n  out += line(\"shl\", shl(1, 3) == 8 && shl(1, 63) == 9223372036854775808 && shl(3, 63) == 9223372036854775808);\n  out += line(\"shl 64 or more\", shl(1, 64) == 0 && shl(18446744073709551615, 200) == 0);\n  out += line(\"shr\", shr(256, 4) == 16 && shr(18446744073709551615, 63) == 1 && shr(5, 0) == 5);\n  out += line(\"shr 64 or more\", shr(18446744073709551615, 64) == 0 && shr(1, 1000) == 0);\n  out += line(\"shr is logical\", shr(9223372036854775808, 62) == 2);\n  const refmask: usize = 5;\n  out += line(\"bit test\", and(shr(refmask, 2), 1) == 1 && and(shr(refmask, 1), 1) == 0);\n\n  // wrapping arithmetic on usize: no overflow trap\n  out += line(\"wadd\", wadd(1, 2) == 3 && wadd(18446744073709551615, 2) == 1 && wadd(18446744073709551615, 1) == 0);\n  out += line(\"wsub\", wsub(5, 3) == 2 && wsub(0, 1) == 18446744073709551615 && wsub(3, 3) == 0);\n  out += line(\"wmul\", wmul(6, 7) == 42 && wmul(9223372036854775808, 2) == 0 && wmul(4294967296, 4294967296) == 0);\n\n  // expect is the identity on its first argument\n  const yes = a != 0;\n  out += line(\"expect\", expect(yes, true) && !expect(!yes, true) && expect(yes, false) && !expect(!yes, false));\n\n  // cfg: 0 or 1 for the three switches, 0 for an unknown number\n  out += line(\"cfg\", cfg(0) <= 1 && cfg(1) <= 1 && cfg(2) <= 1 && cfg(3) == 0 && cfg(100) == 0);\n\n  // heapBase: a stable 8-aligned address; word 63 (byte 504) is ours (`probe` of OrinHeap) (zero at first, then what we store)\n  const h = heapBase();\n  out += line(\"heapBase\", h != 0 && h == heapBase() && h / 8 * 8 == h);\n  out += line(\"heapBase zeroed\", load64(h + 504) == 0);\n  store64(h + 504, 77);\n  out += line(\"heapBase usable\", load64(h + 504) == 77 && load64(heapBase() + 504) == 77);\n  store64(h + 504, 0);\n\n  // memRealloc keeps the contents, grows and shrinks, and a size of 0 is one byte\n  const c = memAlloc(16);\n  store64(c, 0x1122334455667788);\n  store64(c + 8, 0x99AABBCCDDEEFF00);\n  const c2 = memRealloc(c, 4096);\n  out += line(\"memRealloc grow\", c2 != 0 && load64(c2) == 0x1122334455667788 && load64(c2 + 8) == 0x99AABBCCDDEEFF00);\n  store8(c2 + 4095, 5);\n  out += line(\"memRealloc usable\", load8(c2 + 4095) == 5);\n  const c3 = memRealloc(c2, 8);\n  out += line(\"memRealloc shrink\", c3 != 0 && load64(c3) == 0x1122334455667788);\n  const c4 = memRealloc(c3, 0);\n  out += line(\"memRealloc zero\", c4 != 0 && load8(c4) == 0x88);\n\n  // memMove: overlapping ranges in both directions\n  memSet(b, 0, 64);\n  store64(b, 0x0807060504030201);\n  memMove(b + 2, b, 8);\n  out += line(\"memMove up\", load8(b) == 1 && load8(b + 1) == 2 && load8(b + 2) == 1 && load8(b + 9) == 8);\n  memMove(b, b + 2, 8);\n  out += line(\"memMove down\", load8(b) == 1 && load8(b + 7) == 8);\n  memMove(b, a, 0);\n  out += line(\"memMove zero length\", load8(b) == 1);\n\n  // memCmp: -1, 0, 1 by the first differing byte, bytes compare unsigned\n  const x = memAlloc(8);\n  const y = memAlloc(8);\n  memSet(x, 3, 8);\n  memSet(y, 3, 8);\n  out += line(\"memCmp equal\", memCmp(x, y, 8) == 0 && memCmp(x, y, 0) == 0);\n  store8(y + 5, 4);\n  out += line(\"memCmp less\", memCmp(x, y, 8) == -1 && memCmp(x, y, 5) == 0);\n  out += line(\"memCmp greater\", memCmp(y, x, 8) == 1);\n  store8(y + 1, 200);\n  out += line(\"memCmp unsigned\", memCmp(x, y, 8) == -1 && memCmp(y, x, 8) == 1);\n  memFree(y);\n  memFree(x);\n\n  // hook: the totals of finished tasks have addresses (hooks 4, 5), and the build says whether the hot counters are on (hook 6: 0 or 1)\n  out += line(\"hook\", hook(4, 0, 0, 0) != 0 && hook(5, 0, 0, 0) != 0 && hook(6, 1, 2, 3) <= 1);\n\n  // sharedBase: a stable 8-aligned address, not the heap block; word 63 (byte 504, the reserved range) is ours, zero at first\n  const sh = sharedBase();\n  out += line(\"sharedBase\", sh != 0 && sh == sharedBase() && sh / 8 * 8 == sh && sh != heapBase());\n  out += line(\"sharedBase zeroed\", load64(sh + 504) == 0);\n  store64(sh + 504, 91);\n  out += line(\"sharedBase usable\", load64(sh + 504) == 91 && load64(sharedBase() + 504) == 91);\n  store64(sh + 504, 0);\n\n  // fnAddr: the address of the C-ABI wrapper of the probe entry (55), a literal; stable and distinct from any data address\n  out += line(\"fnAddr\", fnAddr(55) != 0 && fnAddr(55) == fnAddr(55) && fnAddr(55) != sh);\n\n  // plat: the L0 functions by table index (a literal); `thread_exit` and `exit` do not return and are exercised by the task tests\n  out += line(\"plat thread_id\", plat(PL_THREAD_ID, 0, 0, 0) >= 1 && plat(PL_THREAD_ID, 0, 0, 0) == plat(PL_THREAD_ID, 0, 0, 0));\n  out += line(\"plat cpu_count\", plat(PL_CPU_COUNT, 0, 0, 0) >= 1);\n  plat(PL_RUNTIME_LOCK, 0, 0, 0);\n  plat(PL_RUNTIME_UNLOCK, 0, 0, 0);\n  out += line(\"plat runtime_lock\", true);\n  out += line(\"plat getenv\", plat(PL_GETENV, addrOf(\"ORIN_CORE_PROBE_SURELY_UNSET\") + 32, 0, 0) == 0);\n  const wl = \"plat write_line\";\n  plat(PL_WRITE_LINE, 1, addrOf(wl) + 32, 15);\n  const w = heapBase() + H_SCRATCH;\n  const m = plat(PL_MONITOR_NEW, 2, 0, 0);\n  out += line(\"plat monitor_new\", m != 0);\n  out += line(\"plat monitor_lock\", plat(PL_MONITOR_LOCK, m, 0, 0) == 0);\n  out += line(\"plat monitor_lock twice\", plat(PL_MONITOR_LOCK, m, 0, 0) != 0);\n  out += line(\"plat monitor_set / get\", plat(PL_MONITOR_SET, m, 1, 99) == 0 && plat(PL_MONITOR_GET, m, 1, w) == 0 && load64(w) == 99);\n  out += line(\"plat monitor_get range\", plat(PL_MONITOR_GET, m, 5, w) != 0);\n  out += line(\"plat monitor_grow\", plat(PL_MONITOR_GROW, m, 8, 0) == 0 && plat(PL_MONITOR_GET, m, 7, w) == 0 && load64(w) == 0);\n  out += line(\"plat monitor_wait_until\", plat(PL_MONITOR_WAIT_UNTIL, m, 0, 0) == 1);\n  out += line(\"plat monitor_notify\", plat(PL_MONITOR_NOTIFY, m, 0, 1) == 0 && plat(PL_MONITOR_NOTIFY, m, 1, 0) == 0);\n  out += line(\"plat monitor_unlock\", plat(PL_MONITOR_UNLOCK, m, 0, 0) == 0 && plat(PL_MONITOR_UNLOCK, m, 0, 0) != 0);\n  out += line(\"plat monitor_free\", plat(PL_MONITOR_FREE, m, 0, 0) == 0 && plat(PL_MONITOR_FREE, m, 0, 0) != 0);\n  const cell = memAlloc(8);\n  store64(cell, 0);\n  const th = plat(PL_THREAD_CREATE, fnAddr(55), cell, 0);\n  out += line(\"plat thread_create\", th > 0);\n  store64(w, 0); // the join writes a `void *`: on a 32-bit target only the low half of the word, so the caller clears it first (plat.or)\n  out += line(\"plat thread_join\", plat(PL_THREAD_JOIN, th, w, 0) == 0 && load64(w) == cell && load64(cell) == 42);\n  memFree(cell);\n\n  memFree(c4);\n  memFree(z);\n  memFree(b);\n  memFree(a);\n  out += line(\"memFree\", true);\n  return out;\n}\n\n// A failed allocation traps \"out of memory\" (exit 101) instead of returning 0: `tests/run/core_oom_trap.or`.\nexport function coreOom(): usize {\n  return memAlloc(18446744073709551600);\n}\n\n// The same for memRealloc.\nexport function coreOomRealloc(): usize {\n  const p = memAlloc(8);\n  return memRealloc(p, 18446744073709551600);\n}\n" });
  out.push(SourceFile { path: "$rt/heap.or", text: "// $rt/heap -- the per-thread heap block and the small-block cache, written in Orin (ADR-0052 Addendum A, step R3d.3).\n//\n// Every task / thread has one zero-initialised block (`OrinHeap`, 1024 bytes, `heapBase()`): the free lists of struct objects and\n// array headers, the live-object balance, the work stack of `destroy`, the counters (`OrinStats`) and the small-block cache. The\n// offsets are the ones pinned by the _Static_asserts of runtime/core/orin_runtime.h (spec 19 \"R3d.1\"). A block is plain malloc\n// memory, so a node that came from another thread's heap joins this one's list (capped by FL_CAP / SB_CAP).\n//\n// Address arithmetic uses the wrapping core operations `wadd`, `wsub`, `wmul` (hir/coreops.or): the checked `+` of the language\n// would add a trap path to every access. The free lists and the small-block cache exist only when `cfg(0) == 1` (off under\n// ASan / MSan and with -DORIN_NO_FREELIST: then every block goes straight to the allocator, as before), the counters only when\n// `cfg(1) == 1` (-DORIN_STATS_ENABLED). The configuration is a constant, so the dead code folds away.\n//\n// Object layout (frozen, spec 19): header rc@0 kind@8 tag@12 (16 bytes); string len@16 cap@24 data@32; array len@16 cap@24\n// is_ref@32 items@40; struct nslots@16 refmask@24 slots@32; kinds string 1, array 2, struct 3.\n\nimport { load64, store64, memAlloc, memFree, memRealloc, memCopy, heapBase, cfg, hook, wadd, wsub, shl, shr, xor } from \"std:core\";\n\n// ---------------------------------------------------------------- offsets in the heap block\n\nexport const FL_STRUCT: usize = 0;   // free struct objects by nslots 0..8, 8 bytes each\nexport const FL_ARRAY: usize = 72;   // free array headers\nexport const FL_N: usize = 80;       // list lengths: [nslots] for structs, [9] (@152) for the array headers\nexport const LIVE: usize = 160;      // live objects of this heap (signed)\nexport const DSTACK: usize = 168;    // the work stack of destroy (0 until first use)\nexport const DCAP: usize = 176;      // its capacity in entries\nexport const S_ALLOC_STRING: usize = 192;\nexport const S_ALLOC_ARRAY: usize = 200;\nexport const S_ALLOC_STRUCT: usize = 208;\nexport const S_FREES: usize = 216;\nexport const S_RETAINS: usize = 224;\nexport const S_RELEASES: usize = 232;\nexport const S_COW_COPIES: usize = 240;\nexport const S_COW_INPLACE: usize = 248;\nexport const S_ARRAY_GROWS: usize = 256;\nexport const S_STRING_GROWS: usize = 264;\nexport const S_PEAK_LIVE_OBJS: usize = 272;\nexport const S_PEAK_LIVE_BYTES: usize = 280;\nexport const S_LIVE_BYTES: usize = 288;\nexport const S_FILE_OPENS: usize = 296;\nexport const S_FILE_CLOSES: usize = 304;\nexport const S_TRANSFER_MOVES: usize = 312;\nexport const S_TRANSFER_COPIES: usize = 320;\nexport const S_TASKS_SPAWNED: usize = 328;\n// (R3e.0) the per-task words of the reserved range 336..503; the C offsets are pinned in orin_runtime.h\nexport const H_TASK: usize = 336;     // address of the RtTask record of this thread, 0 on a thread that is not a task\nexport const H_JOINED: usize = 344;   // the record of the task joined last by this thread\nexport const H_GRANTS: usize = 352;   // reserved for R3c: the grant table of this task\nexport const H_FILES: usize = 360;    // reserved for R3c: the open-file table of this task\nexport const H_NETBUF: usize = 368;   // the per-task network buffer\nexport const H_SCRATCH: usize = 376;  // scratch word: the out parameter of L0 calls (thread_join, monitor_get)\nexport const H_CHILDREN: usize = 384; // (C2) the registry of the tasks this thread started and has not joined: first node (task.or)\nexport const H_CHILDREN_TAIL: usize = 392; // its last node\nexport const H_TRAPPING: usize = 400; // 1 once this thread runs the cleanup of a trap (a trap inside it is an exit)\nexport const SB: usize = 512;        // small-block cache: 17 classes of {head, length}, 16 bytes each\n\nexport const FL_CAP: usize = 262144;  // 2^18 objects per free list\nexport const SB_CAP: usize = 32768;   // 2^15 blocks per small-block class\nexport const SB_MAX: usize = 256;     // the largest cached block\n\nconst SIGN: usize = 9223372036854775808;\n\n// ---------------------------------------------------------------- C runtime hooks and the allocation-site census\n\n// The services of the C runtime that Orin code reaches through the core operation `hook` (orin_core_hook in runtime/core/orin_runtime.c\n// lists the same numbers): the totals of finished tasks, the allocation-site census. Numbers 0..3 were the environment, the runtime lock\n// and stderr; they are L0 functions and Orin code calls them with `plat` (plat.or) since R3e.1.\nexport const HK_FOLD_STATS: usize = 4;   // -> the address of the OrinStats of the finished tasks (under the lock)\nexport const HK_FOLD_LIVE: usize = 5;    // -> the address of their live-object balance (an i64)\nexport const HK_STATS_ON: usize = 6;     // -> 1 when the runtime was built with the hot counters (ORIN_STATS_ENABLED)\nexport const HK_SITE_ALLOC: usize = 7;   // (o, kind 0 string 1 value array 2 reference array 3 struct, bytes): census, a new object\nexport const HK_SITE_GROW: usize = 8;    // (o, bytes): census, a buffer of `o` grew\nexport const HK_SITE_FREE: usize = 9;    // (o): census, `o` is being freed\nexport const HK_SITE_RC: usize = 10;     // (o, what: 0 retain 1 release 2 copy-on-write copy): census, a reference-count operation\nexport const HK_SITE_REPORT: usize = 11; // the census table (ORIN_STATS=sites)\nexport const HK_REVOKE_GRANTS: usize = 12; // revoke every live grant of this task (the end of its heap; task.heapRetire)\nexport const HK_CLOSE_FILES: usize = 13;   // close the files this task left open (files_at_exit)\nexport const HK_FREE_NETBUF: usize = 14;   // free the per-task network buffer of this task\nexport const HK_SITE_FOLD: usize = 15;     // census builds: fold this task's site tables into the process tables (under the runtime lock)\n\n// The census prefix word (ADR-0052 Addendum A, rule 4): in a census build (cfg 2) every heap object is preceded by 8 bytes holding the\n// site that allocated it, so the offsets of the object layout are the same in all builds. `pfx()` is that size (0 in a normal build).\n// The address of an object is the address of its block plus `pfx()`; a free list holds the block address (the link is stored in the\n// first word of the block, the prefix word in a census build).\n@Inline\nexport function pfx(): usize {\n  return shl(cfg(2), 3);\n}\n\n// Census: `o` was allocated (kind 0 string, 1 value array, 2 reference array, 3 struct; `bytes` as a normal build lays it out).\n@Inline\nexport function siteAlloc(o: usize, kind: usize, bytes: usize): void {\n  if (cfg(2) == 1) {\n    hook(HK_SITE_ALLOC, o, kind, bytes);\n  }\n}\n\n// Census: a buffer of `o` grew by `bytes`.\n@Inline\nexport function siteGrow(o: usize, bytes: usize): void {\n  if (cfg(2) == 1) {\n    hook(HK_SITE_GROW, o, bytes, 0);\n  }\n}\n\n// Census: `o` is being freed.\n@Inline\nexport function siteFree(o: usize): void {\n  if (cfg(2) == 1) {\n    hook(HK_SITE_FREE, o, 0, 0);\n  }\n}\n\n// Census: a reference-count operation on `o` (0 retain, 1 release, 2 copy-on-write copy).\n@Inline\nexport function siteRc(o: usize, what: usize): void {\n  if (cfg(2) == 1) {\n    hook(HK_SITE_RC, o, what, 0);\n  }\n}\n\n// ---------------------------------------------------------------- word helpers\n\n// word at `p` += d (wrapping)\n@Inline\nexport function addAt(p: usize, d: usize): void {\n  store64(p, wadd(load64(p), d));\n}\n\n// word at `p` -= d (wrapping)\n@Inline\nexport function subAt(p: usize, d: usize): void {\n  store64(p, wsub(load64(p), d));\n}\n\n// True when a reference count is positive as a signed 64-bit number: a live object (not immortal, not lend-pinned).\n@Inline\nexport function isLive(rc: usize): bool {\n  return wsub(rc, 1) < 9223372036854775807;\n}\n\n// ---------------------------------------------------------------- accounting (the static counters, hot path under cfg(1))\n\n// One more object, `bytes` more live bytes, and the peaks. `counter` is the offset of the kind's allocation counter.\n@Inline\nexport function statAlloc(counter: usize, bytes: usize): void {\n  if (cfg(1) == 1) {\n    const h = heapBase();\n    addAt(wadd(h, counter), 1);\n    const lb = wadd(load64(wadd(h, S_LIVE_BYTES)), bytes);\n    store64(wadd(h, S_LIVE_BYTES), lb);\n    if (xor(lb, SIGN) > xor(load64(wadd(h, S_PEAK_LIVE_BYTES)), SIGN)) {\n      store64(wadd(h, S_PEAK_LIVE_BYTES), lb);\n    }\n    const lv = load64(wadd(h, LIVE));\n    if (xor(lv, SIGN) > xor(load64(wadd(h, S_PEAK_LIVE_OBJS)), SIGN)) {\n      store64(wadd(h, S_PEAK_LIVE_OBJS), lv);\n    }\n  }\n}\n\n// `bytes` more live bytes (a buffer grew) and the peak.\n@Inline\nexport function statGrow(bytes: usize): void {\n  if (cfg(1) == 1) {\n    const h = heapBase();\n    const lb = wadd(load64(wadd(h, S_LIVE_BYTES)), bytes);\n    store64(wadd(h, S_LIVE_BYTES), lb);\n    if (xor(lb, SIGN) > xor(load64(wadd(h, S_PEAK_LIVE_BYTES)), SIGN)) {\n      store64(wadd(h, S_PEAK_LIVE_BYTES), lb);\n    }\n  }\n}\n\n// One more live object (the balance may go negative on a task that frees what another allocated: it is signed).\n@Inline\nexport function liveInc(): void {\n  addAt(wadd(heapBase(), LIVE), 1);\n}\n\n// One object freed: the live balance and the `frees` counter.\n@Inline\nexport function liveDec(): void {\n  subAt(wadd(heapBase(), LIVE), 1);\n  if (cfg(1) == 1) {\n    addAt(wadd(heapBase(), S_FREES), 1);\n  }\n}\n\n// ---------------------------------------------------------------- small-block cache (variable-size buffers <= SB_MAX)\n\n// A buffer of `n` bytes: string objects (sizeof(OrinString) + cap + 1) and array item buffers (cap * 8). Blocks of at most\n// SB_MAX bytes are rounded up to a 16-byte class and taken from the class list when it has one; a block can sit on any thread's\n// list and needs no header, because its free passes the same size.\n@Inline\nexport function sbAlloc(n: usize): usize {\n  if (cfg(0) == 1 && n <= 256) {\n    const c = shr(wadd(n, 15), 4);\n    const q = wadd(wadd(heapBase(), SB), shl(c, 4));\n    const f = load64(q);\n    if (f != 0) {\n      store64(q, load64(f));\n      subAt(wadd(q, 8), 1);\n      return f;\n    }\n    return memAlloc(shl(c, 4));\n  }\n  return memAlloc(n);\n}\n\n// Return the block `p` of `n` bytes to the cache, or to the allocator when the class is full or the block is large.\n@Inline\nexport function sbFree(p: usize, n: usize): void {\n  if (cfg(0) == 1 && n <= 256) {\n    const c = shr(wadd(n, 15), 4);\n    const q = wadd(wadd(heapBase(), SB), shl(c, 4));\n    if (load64(wadd(q, 8)) < 32768) {\n      store64(p, load64(q));\n      store64(q, p);\n      addAt(wadd(q, 8), 1);\n      return;\n    }\n  }\n  memFree(p);\n}\n\n// Grow (or shrink) the buffer `p` (0 when `old` is 0) from `old` to `n` bytes. Large buffers keep the in-place growth of `realloc`; a\n// small one stays where it is while it fits its 16-byte class, else it moves to a block of the new class.\nexport function sbRealloc(p: usize, old: usize, n: usize): usize {\n  if (cfg(0) == 0) {\n    return memRealloc(p, n);\n  }\n  if (old > 256 && n > 256) {\n    return memRealloc(p, n);\n  }\n  if (p != 0 && old <= 256 && n <= 256 && shr(wadd(old, 15), 4) == shr(wadd(n, 15), 4)) {\n    return p;\n  }\n  const q = sbAlloc(n);\n  if (p != 0) {\n    memCopy(q, p, old < n ? old : n);\n    sbFree(p, old);\n  }\n  return q;\n}\n" });
  out.push(SourceFile { path: "$rt/leaf.or", text: "// $rt/leaf -- the leaves of the object model without allocator state, written in Orin (ADR-0052 Addendum A, step R3d.2).\n//\n// The backends call these functions by name (compiler/mir/rt.or lists them; opt/prune.or keeps them) in place of the C runtime\n// functions of the same name (`orin_opt_unwrap`, `orin_res_unwrap`, `orin_res_unwrap_err`, `orin_v_unwrap`, `orin_trap_shape`,\n// `orin_assert_fact`, `orin_assert_array`), which the frozen snapshot bootstrap/seed/runtime/ keeps for the seed and `--c-builtins`.\n// An object is its address as a `usize`: the emitted call casts the pointer (the language cannot forge a reference). The\n// layout is the frozen one (spec 19, rule 3 of Addendum A section 2): kind@8 tag@12; struct nslots@16 slots@32; array len@16\n// items@40; kinds string 1, array 2, struct 3. A trap is `taskTrap`: the message of the C `orin_trap` (stdout flushed,\n// `trap: <msg>` on stderr, exit 101, and a trap on a task ends that task only).\n\nimport { load32, load64 } from \"std:core\";\nimport { taskTrap } from \"std:fsraw\";\nimport { exit } from \"std:process\";\n\n// The trap of every checked field or element access on an object of the wrong shape (docs/assurance.md \"shape confusion\").\nexport function trapShape(): void {\n  taskTrap(\"field access on a value of the wrong shape (compiler bug)\");\n}\n\n// Slot 0 of the struct at `o`: a struct with at least one slot, else the shape trap.\n@Inline\nfunction slot0(o: usize): usize {\n  if (load32(o + 8) != 3 || load32(o + 16) == 0) {\n    trapShape();\n  }\n  return load64(o + 32);\n}\n\n// `opt.unwrap()`: the payload slot of Some (tag 0).\n@Inline\nexport function optUnwrap(o: usize): usize {\n  if (load32(o + 12) != 0) {\n    taskTrap(\"unwrap on None\");\n  }\n  return slot0(o);\n}\n\n// `res.unwrap()`: the payload slot of Ok (tag 0), 0 for an Ok without payload.\n@Inline\nexport function resUnwrap(o: usize): usize {\n  if (load32(o + 12) != 0) {\n    taskTrap(\"unwrap on Err\");\n  }\n  if (load32(o + 8) == 3 && load32(o + 16) == 0) {\n    return 0;\n  }\n  return slot0(o);\n}\n\n// `res.unwrapErr()`: the payload slot of Err (tag 1).\n@Inline\nexport function resUnwrapErr(o: usize): usize {\n  if (load32(o + 12) != 1) {\n    taskTrap(\"unwrapErr on Ok\");\n  }\n  return slot0(o);\n}\n\n// The unboxed Option / Result (docs/mir.md v2.2): `word` when `tag` is the expected one, else the trap of the boxed builtin.\n// what: 0 = Option.unwrap (tag 0), 1 = Result.unwrap (tag 0), 2 = Result.unwrapErr (tag 1).\n@Inline\nexport function vUnwrap(tag: usize, word: usize, what: int): usize {\n  if (what == 0 && tag != 0) {\n    taskTrap(\"unwrap on None\");\n  }\n  if (what == 1 && tag != 0) {\n    taskTrap(\"unwrap on Err\");\n  }\n  if (what == 2 && tag != 1) {\n    taskTrap(\"unwrapErr on Ok\");\n  }\n  return word;\n}\n\n// `orin2 compile --assert-facts` (docs/mir.md v2.4): the dynamic check of a forwarded load. `got` is the value an IForward\n// claimed for slot `key` of `o` (a field index or an array index); the slot itself is read here, as the original getfield /\n// arrayget would have. A difference is an optimiser or verifier bug, not a program error: exit 70 (internal error).\nexport function assertFact(o: usize, key: usize, got: usize): void {\n  const kind = load32(o + 8);\n  let want: usize = 0;\n  let why = \"\";\n  if (kind == 3 && key < load32(o + 16)) {\n    want = load64(o + 32 + key * 8);\n  } else if (kind == 2 && key < load64(o + 16)) {\n    want = load64(load64(o + 40) + key * 8);\n  } else {\n    why = \"internal error: --assert-facts: a forwarded load names a slot that does not exist\";\n  }\n  if (why == \"\" && want != got) {\n    why = \"internal error: --assert-facts: a forwarded load differs from the slot it was forwarded from\";\n  }\n  if (why != \"\") {\n    console.error(why);\n    exit(70);\n  }\n}\n\n// `orin2 compile --assert-facts` (docs/mir.md v2.6, rule U1): the kind check and the bounds check that an IArrayGetU /\n// IArraySetU leaves out, executed before it. A failure is a verifier or optimiser bug: exit 70 (internal error).\nexport function assertArray(o: usize, i: usize): void {\n  let why = \"\";\n  if (load32(o + 8) != 2) {\n    why = \"internal error: --assert-facts: an unchecked array access on an object that is not an array\";\n  } else if (i >= load64(o + 16)) {\n    why = \"internal error: --assert-facts: an unchecked array access is out of bounds\";\n  }\n  if (why != \"\") {\n    console.error(why);\n    exit(70);\n  }\n}\n" });
  out.push(SourceFile { path: "$rt/lend.or", text: "// $rt/lend -- the lend of `.parallel()` (ADR-0039 section 4), written in Orin (ADR-0052 Addendum B, step R3e.3).\n//\n// A LEND lets other tasks READ a value of the lending task for a bounded time without copying it. Reference counts are not atomic,\n// so a lent graph is PINNED: every object in it with a positive count gets the count PIN | owner << 32 | count, which is negative,\n// so retain / release (inline in the generated code of both backends) treat the object as immortal: a reader never writes the shared\n// count, and nothing in the graph is freed or changed in place (`makeUniqueSlow` copies an object whose count is not 1). Ending the\n// lend restores every count it pinned (`transfer.drop`: the lend token is a slot of the transfer table with `pins` set, so the one\n// `drop` of std:task ends both a value in flight and a lend).\n//   * Sharing: a transfer (transfer.put) by the OWNER of a pin shares the pinned object instead of copying it: this is how the closure\n//     of a worker task reaches the lent array. A transfer by any OTHER task copies pinned objects, so a result sent back to the owner\n//     never refers into the lent graph (after the end that reference would be uncounted).\n//   * The owner's obligation (std:task `forkJoin` keeps it): between lend and end it only spawns the tasks that read the value and\n//     joins them, so every reference to a pinned object made meanwhile is gone before the end (a retain or a release of a pinned object\n//     is a no-op, so a reference that outlived the lend would be uncounted).\n//   * Not pinned (left to the copying transfer): an object with a count of 2^32 or more, and everything when the owner's thread id does\n//     not fit in 30 bits. Immortal objects (count -1) and objects pinned by another lend are skipped.\n// The lend token is a transfer slot whose box is a TWO-slot record { value, unused } (a value in flight has one slot). The walk over the\n// graph is iterative (a work stack from `memAlloc`), so a list 200,000 deep is pinned without recursion.\n\nimport { load32, load64, store64, memAlloc, memFree, memRealloc, plat, wadd, wsub, shl, shr, and, or } from \"std:core\";\nimport { PL_THREAD_ID } from \"./plat\";\nimport { isLive } from \"./heap\";\nimport { retain } from \"./rc\";\nimport { trapShape } from \"./leaf\";\nimport { publish, PIN_TAG, TID_LIMIT } from \"./transfer\";\n\nconst NOT_PINNED_FROM: usize = 4294967296;   // a count of 2^32 or more is left to the copying transfer\n\n// Lend the value of the two-slot record `box` { value, _ } that the caller has just built; returns the lend token (end it with\n// transfer.drop). The owner's own references stay valid; every object of the graph with a count below 2^32 is pinned.\nexport function put(box: usize): usize {\n  if (load32(wadd(box, 8)) != 3 || load32(wadd(box, 16)) != 2) {\n    trapShape();\n  }\n  const tid = plat(PL_THREAD_ID, 0, 0, 0);\n  let cap: usize = 16;\n  let n: usize = 0;\n  let pins = memAlloc(shl(cap, 3));\n  let scap: usize = 64;\n  let sp: usize = 0;\n  let st = memAlloc(shl(scap, 3));\n  const v = load64(wadd(box, 32));\n  if (and(load64(wadd(box, 24)), 1) == 1 && v != 0 && tid < TID_LIMIT) {\n    store64(st, v);\n    sp = 1;\n  }\n  while (sp != 0) {\n    sp = wsub(sp, 1);\n    const x = load64(wadd(st, shl(sp, 3)));\n    const rc = load64(x);\n    if (isLive(rc) && rc < NOT_PINNED_FROM) {\n      store64(x, or(or(PIN_TAG, shl(tid, 32)), rc));\n      if (n == cap) {\n        cap = shl(cap, 1);\n        pins = memRealloc(pins, shl(cap, 3));\n      }\n      store64(wadd(pins, shl(n, 3)), x);\n      n = wadd(n, 1);\n      const kind = load32(wadd(x, 8));\n      let items: usize = 0;\n      let len: usize = 0;\n      let mask: usize = 0;\n      let all = false;\n      if (kind == 3) {\n        items = wadd(x, 32);\n        len = load32(wadd(x, 16));\n        mask = load64(wadd(x, 24));\n      } else if (kind == 2 && load64(wadd(x, 32)) != 0) {\n        items = load64(wadd(x, 40));\n        len = load64(wadd(x, 16));\n        all = true;\n      }\n      let i: usize = 0;\n      while (i < len) {\n        if (all || and(shr(mask, i), 1) == 1) {\n          const c = load64(wadd(items, shl(i, 3)));\n          if (c != 0 && isLive(load64(c))) {\n            if (sp == scap) {\n              scap = shl(scap, 1);\n              st = memRealloc(st, shl(scap, 3));\n            }\n            store64(wadd(st, shl(sp, 3)), c);\n            sp = wadd(sp, 1);\n          }\n        }\n        i = wadd(i, 1);\n      }\n    }\n  }\n  memFree(st);\n  retain(box);   // the slot keeps the box, and so the value, alive until the lend ends\n  return publish(box, pins, n);\n}\n" });
  out.push(SourceFile { path: "$rt/module.or", text: "// $rt entry: the runtime core written in Orin (ADR-0052 Addendum A). Loaded implicitly into every program.\nexport { rtLayoutVersion } from \"./rt\";\nexport { trapShape, optUnwrap, resUnwrap, resUnwrapErr, vUnwrap, assertFact, assertArray } from \"./leaf\";\nexport { structNew, variant1, arrayNew, strAlloc, arrayPushGrow } from \"./object\";\nexport { sbAlloc, sbFree, sbRealloc } from \"./heap\";\nexport { destroy, makeUniqueSlow } from \"./rc\";\nexport {\n  strConcat, strAppend, strAppendSub, strAppendUsize, strAppendInt, strPrepend\n} from \"./str\";\nexport { arraySlice, arrayConcat, arrayExtend, bytesToString, stringToBytes } from \"./array\";\nexport { statsReport, liveCount } from \"./stats\";\nexport { monNew, monFree, monLock, monUnlock, monWait, monNotifyAll, monNotifyOne, monWaitUntil, monGet, monSet, monGrow } from \"./sync\";\nexport { put as transferPut, take as transferTake, drop as transferDrop, count as transferCount } from \"./transfer\";\nexport { put as lendPut } from \"./lend\";\nexport { parThreads, spawn as taskSpawn, join as taskJoin, message as taskMessage, watch as taskWatch, trapStr, main as taskMain, trap, heapRetire } from \"./task\";\n" });
  out.push(SourceFile { path: "$rt/object.or", text: "// $rt/object -- allocation of structs and arrays, written in Orin (ADR-0052 Addendum A, step R3d.3 (a)).\n//\n// The backends call these functions by name (compiler/mir/rt.or lists them; opt/prune.or keeps them) in place of the C runtime\n// functions `orin_struct_new`, `orin_variant1` and `orin_array_new`; the C shells of the runtime reach them through the\n// exported wrappers of the same names that the emitted code defines. An object is its address as a `usize`. The layout and the\n// heap block are described in heap.or. A failed allocation traps \"out of memory\" in `memAlloc` itself. Counters and the\n// live-object balance are updated exactly as the C versions did (the ORIN_STATS=1 report is the equivalence oracle). In a census build\n// (cfg 2) each object is preceded by the census prefix word (heap.or `pfx`) and the allocation is reported to the census (`siteAlloc`).\n\nimport { load64, store8, store32, store64, memAlloc, memSet, heapBase, cfg, expect, wadd, wsub, wmul, shl, and } from \"std:core\";\nimport { taskTrap } from \"std:fsraw\";\nimport {\n  sbAlloc, sbRealloc, subAt, addAt, liveInc, statAlloc, statGrow, pfx, siteAlloc, siteGrow, S_ALLOC_STRING, S_ALLOC_STRUCT,\n  S_ALLOC_ARRAY, S_ARRAY_GROWS, FL_ARRAY, FL_N\n} from \"./heap\";\n\n// A new struct with all slots zero (null refs): `nslots` slots of 8 bytes behind the 32-byte header, rc 1. `refmask` bit i set:\n// slot i is a reference (at most 64 slots).\n@Inline\nexport function structNew(tag: usize, nslots: usize, refmask: usize): usize {\n  if (nslots > 64) {\n    taskTrap(\"struct has more than 64 slots\");\n  }\n  let s: usize = 0;\n  if (cfg(0) == 1 && nslots < 9) {\n    // the free list of this size: the next pointer is word 0 of a free object\n    const lp = wadd(heapBase(), shl(nslots, 3));\n    const head = load64(lp);\n    if (expect(head != 0, true)) {\n      store64(lp, load64(head));\n      subAt(wadd(wadd(heapBase(), FL_N), shl(nslots, 3)), 1);\n      s = wadd(head, pfx());\n    }\n  }\n  if (s == 0) {\n    s = wadd(memAlloc(wadd(wadd(32, shl(nslots, 3)), pfx())), pfx());\n  }\n  store64(s, 1);\n  store32(wadd(s, 8), 3);\n  store32(wadd(s, 12), tag);\n  store32(wadd(s, 16), nslots);\n  store32(wadd(s, 20), 0);\n  store64(wadd(s, 24), refmask);\n  // small records dominate: plain stores, no loop and no call\n  if (nslots > 4) {\n    memSet(wadd(s, 32), 0, shl(nslots, 3));\n  } else {\n    if (nslots >= 1) {\n      store64(wadd(s, 32), 0);\n    }\n    if (nslots >= 2) {\n      store64(wadd(s, 40), 0);\n    }\n    if (nslots >= 3) {\n      store64(wadd(s, 48), 0);\n    }\n    if (nslots >= 4) {\n      store64(wadd(s, 56), 0);\n    }\n  }\n  liveInc();\n  statAlloc(S_ALLOC_STRUCT, wadd(32, shl(nslots, 3)));\n  siteAlloc(s, 3, wadd(32, shl(nslots, 3)));\n  return s;\n}\n\n// A variant with one slot; consumes the slot's reference if the slot is a ref (`refmask` 0 or 1).\n@Inline\nexport function variant1(tag: usize, refmask: usize, slot: usize): usize {\n  const o = structNew(tag, 1, and(refmask, 1));\n  store64(wadd(o, 32), slot);\n  return o;\n}\n\n// A new empty array of capacity `cap`; `isRef` != 0: the elements are references (retained / released).\n@Inline\nexport function arrayNew(cap: usize, isRef: usize): usize {\n  if (cap > 1099511627776) {\n    taskTrap(\"array too large\");\n  }\n  let a: usize = 0;\n  if (cfg(0) == 1) {\n    const lp = wadd(heapBase(), FL_ARRAY);\n    const head = load64(lp);\n    if (head != 0) {\n      store64(lp, load64(head));\n      subAt(wadd(wadd(heapBase(), FL_N), 72), 1);\n      a = wadd(head, pfx());\n    }\n  }\n  if (a == 0) {\n    a = wadd(memAlloc(wadd(48, pfx())), pfx());\n  }\n  store64(a, 1);\n  store32(wadd(a, 8), 2);\n  store32(wadd(a, 12), 0);\n  store64(wadd(a, 16), 0);\n  store64(wadd(a, 24), cap);\n  store64(wadd(a, 32), isRef != 0 ? 1 : 0);\n  store64(wadd(a, 40), cap != 0 ? sbAlloc(shl(cap, 3)) : 0);\n  liveInc();\n  statAlloc(S_ALLOC_ARRAY, wadd(48, shl(cap, 3)));\n  siteAlloc(a, isRef != 0 ? 2 : 1, wadd(48, shl(cap, 3)));\n  return a;\n}\n\n// A new string object of length `len` and capacity `cap` (at least `len`; the bytes are not written, the NUL terminator is): the\n// object and its data are one block of 32 + cap + 1 bytes.\n@Inline\nexport function strAlloc(len: usize, cap0: usize): usize {\n  const cap = cap0 < len ? len : cap0;\n  if (cap > 281474976710656) {\n    taskTrap(\"string too large\");\n  }\n  const total = wadd(cap, 33);\n  const s = wadd(sbAlloc(wadd(total, pfx())), pfx());\n  store64(s, 1);\n  store32(wadd(s, 8), 1);\n  store32(wadd(s, 12), 0);\n  store64(wadd(s, 16), len);\n  store64(wadd(s, 24), cap);\n  store8(wadd(wadd(s, 32), len), 0);\n  liveInc();\n  statAlloc(S_ALLOC_STRING, total);\n  siteAlloc(s, 0, total);\n  return s;\n}\n\n// `push` on a full array (len == cap): double the item buffer (4 slots at first), then store `slot`.\nexport function arrayPushGrow(o: usize, slot: usize): void {\n  const cap0 = load64(wadd(o, 24));\n  const cap = cap0 != 0 ? wmul(cap0, 2) : 4;\n  const items = sbRealloc(load64(wadd(o, 40)), shl(cap0, 3), shl(cap, 3));\n  store64(wadd(o, 40), items);\n  statGrow(shl(wsub(cap, cap0), 3));\n  if (cfg(1) == 1) {\n    addAt(wadd(heapBase(), S_ARRAY_GROWS), 1);\n  }\n  siteGrow(o, shl(wsub(cap, cap0), 3));\n  store64(wadd(o, 24), cap);\n  const len = load64(wadd(o, 16));\n  store64(wadd(items, shl(len, 3)), slot);\n  store64(wadd(o, 16), wadd(len, 1));\n}\n" });
  out.push(SourceFile { path: "$rt/plat.or", text: "// $rt/plat -- the names of the L0 functions that `plat(k, a, b, c)` calls (ADR-0052 Addendum B, step R3e.0; hir/coreops.or).\n//\n// `plat` takes the table index `k` as a literal: a named constant is inlined to its literal, so the calls of `$rt` read\n// `plat(PL_MONITOR_LOCK, m, 0, 0)`. The index is the position in the closed table of hir/coreops.or (`platOpName`); the signature of every\n// function is in runtime/platform/orin_platform.h. Words go in, the result comes back as a word (a C `int` sign-extended; L0 returns 0 or\n// a positive code), pointers are addresses, void functions give 0.\n\nexport const PL_THREAD_CREATE: usize = 0;       // (entry: fnAddr of a void(void *) entry, arg) -> handle > 0, 0 on failure\nexport const PL_THREAD_JOIN: usize = 1;         // (handle, &word of *arg) -> 0; L0 stores a `void *`, on a 32-bit target only the low 4 bytes: clear the word first\nexport const PL_THREAD_EXIT: usize = 2;         // () never returns\nexport const PL_THREAD_ID: usize = 3;           // () -> id >= 1\nexport const PL_MONITOR_NEW: usize = 4;         // (nwords) -> handle, 0 when none could be made\nexport const PL_MONITOR_FREE: usize = 5;        // (handle) -> 0, EBUSY, EINVAL\nexport const PL_MONITOR_LOCK: usize = 6;        // (handle) -> 0, EINVAL, EDEADLK\nexport const PL_MONITOR_UNLOCK: usize = 7;      // (handle) -> 0, EINVAL\nexport const PL_MONITOR_WAIT: usize = 8;        // (handle, cond) -> 0, EINVAL\nexport const PL_MONITOR_WAIT_UNTIL: usize = 9;  // (handle, cond, deadline_ms) -> 0, WAIT_TIMEOUT (1), EINVAL\nexport const PL_MONITOR_NOTIFY: usize = 10;     // (handle, cond, all) -> 0, EINVAL\nexport const PL_MONITOR_GET: usize = 11;        // (handle, i, &word) -> 0, EINVAL\nexport const PL_MONITOR_SET: usize = 12;        // (handle, i, v) -> 0, EINVAL\nexport const PL_MONITOR_GROW: usize = 13;       // (handle, nwords) -> 0, EINVAL, ENOMEM\nexport const PL_RUNTIME_LOCK: usize = 14;       // () the process-wide runtime lock\nexport const PL_RUNTIME_UNLOCK: usize = 15;     // ()\nexport const PL_CPU_COUNT: usize = 16;          // () -> processors online >= 1\nexport const PL_GETENV: usize = 17;             // (name: C string) -> the value (C string) or 0\nexport const PL_WRITE_LINE: usize = 18;         // (stream, buf, n): n bytes and a newline; stream 1 stdout (buffered), 2 stderr\nexport const PL_EXIT: usize = 19;               // (code) never returns\nexport const PL_WAKE_SIGNAL: usize = 20;        // (token) -> 1 when this call cancelled the token, 0 when it was cancelled already or is stale (C2)\nexport const PL_WAKE_BOUND: usize = 21;         // () -> the cancellation token bound to this thread, 0 = none (C2)\n" });
  out.push(SourceFile { path: "$rt/rc.or", text: "// $rt/rc -- destroy and copy-on-write, written in Orin (ADR-0052 Addendum A, step R3d.3 (b)).\n//\n// `destroy` frees an object whose count reached 0 (iterative, so long chains and deep trees cannot overflow the stack; the work\n// stack is per task and lives in the heap block), `makeUniqueSlow` is the copying path of `make_unique`. The backends call them by\n// name in place of `orin_destroy` and `orin_make_unique_slow` (compiler/mir/rt.or); the C shells reach them through the wrappers of\n// the same names that the emitted code defines. The retain / release fast paths stay inline in the emitted code.\n//\n// A count above 0 is a live object; a count of 0 or below is immortal (static literals, the nullary objects) or pinned by a\n// lend (docs/concurrency.md, \"lending\"): neither is counted. Counters and the live balance are updated exactly as the C versions\n// did. In a census build (cfg 2) the reference-count operations, the frees and the copy-on-write copies are reported to the census\n// (`siteRc`, `siteFree`; the headers' inline retain / release of the generated C do the same), and an object's block starts `pfx()`\n// bytes before its address.\n\nimport { load32, load64, store64, memFree, memRealloc, memCopy, heapBase, cfg, wadd, wsub, wmul, shl, shr, and } from \"std:core\";\nimport {\n  isLive, addAt, subAt, liveDec, sbFree, pfx, siteFree, siteRc, FL_STRUCT, FL_ARRAY, FL_N, FL_CAP, DSTACK, DCAP, S_RELEASES, S_RETAINS,\n  S_COW_COPIES, S_LIVE_BYTES\n} from \"./heap\";\nimport { structNew, arrayNew, strAlloc } from \"./object\";\n\n// One reference dropped: true when the count of the live object `c` reached 0 (the caller destroys it). Immortal, pinned and null\n// references are left alone.\n@Inline\nfunction decRef(c: usize): bool {\n  if (c != 0) {\n    const rc = load64(c);\n    if (isLive(rc)) {\n      if (cfg(1) == 1) {\n        addAt(wadd(heapBase(), S_RELEASES), 1);\n      }\n      siteRc(c, 1);\n      const n = wsub(rc, 1);\n      store64(c, n);\n      return n == 0;\n    }\n  }\n  return false;\n}\n\n// One reference taken (`orin_retain`): a live object's count goes up, an immortal one is left alone.\n@Inline\nexport function retain(o: usize): void {\n  const rc = load64(o);\n  if (isLive(rc)) {\n    store64(o, wadd(rc, 1));\n    if (cfg(1) == 1) {\n      addAt(wadd(heapBase(), S_RETAINS), 1);\n    }\n    siteRc(o, 0);\n  }\n}\n\n// One reference dropped (`orin_release`): the count of a live object goes down and the object is destroyed at 0; an immortal or\n// pinned object is left alone. `o` is not null.\n@Inline\nexport function release(o: usize): void {\n  const rc = load64(o);\n  if (isLive(rc)) {\n    if (cfg(1) == 1) {\n      addAt(wadd(heapBase(), S_RELEASES), 1);\n    }\n    siteRc(o, 1);\n    const n = wsub(rc, 1);\n    store64(o, n);\n    if (n == 0) {\n      destroy(o);\n    }\n  }\n}\n\n// The work stack outgrew its capacity `scap` (0 before the first use): twice as many entries, 256 at first. The new block and\n// capacity are stored in the heap block; returns the capacity.\nfunction growStack(scap: usize): usize {\n  const h = heapBase();\n  const ncap = scap != 0 ? wmul(scap, 2) : 256;\n  store64(wadd(h, DSTACK), memRealloc(load64(wadd(h, DSTACK)), shl(ncap, 3)));\n  store64(wadd(h, DCAP), ncap);\n  return ncap;\n}\n\n// Free the object `o` (count 0) and every child whose count reaches 0 through it. The first dying child of an object is freed next\n// without a trip through the work stack (`cur`), the others wait on the stack: the order differs from a plain stack, the set of freed\n// objects does not. A freed struct or array header goes back on its free list (capped by FL_CAP); a string and an item buffer go to\n// the small-block cache; the rest to the allocator.\nexport function destroy(o: usize): void {\n  const h = heapBase();\n  let stack = load64(wadd(h, DSTACK));\n  let scap = load64(wadd(h, DCAP));\n  let sp: usize = 0;\n  let cur = o;\n  while (cur != 0 || sp != 0) {\n    if (cur == 0) {\n      sp = wsub(sp, 1);\n      cur = load64(wadd(stack, shl(sp, 3)));\n    }\n    const x = cur;\n    cur = 0;\n    siteFree(x);\n    const base = wsub(x, pfx());\n    const kind = load32(wadd(x, 8));\n    let recycled = false;\n    if (kind == 2) {\n      // array: release the elements of a reference array, free the item buffer, recycle the header\n      const cap = load64(wadd(x, 24));\n      const items = load64(wadd(x, 40));\n      if (load64(wadd(x, 32)) != 0) {\n        const len = load64(wadd(x, 16));\n        let p = items;\n        let i: usize = 0;\n        while (i < len) {\n          const c = load64(p);\n          if (decRef(c)) {\n            if (cur == 0) {\n              cur = c;\n            } else {\n              if (sp == scap) {\n                scap = growStack(scap);\n                stack = load64(wadd(h, DSTACK));\n              }\n              store64(wadd(stack, shl(sp, 3)), c);\n              sp = wadd(sp, 1);\n            }\n          }\n          p = wadd(p, 8);\n          i = wadd(i, 1);\n        }\n      }\n      if (cfg(1) == 1) {\n        subAt(wadd(h, S_LIVE_BYTES), wadd(48, shl(cap, 3)));\n      }\n      if (items != 0) {\n        sbFree(items, shl(cap, 3));\n      }\n      if (cfg(0) == 1 && load64(wadd(wadd(h, FL_N), 72)) < FL_CAP) {\n        store64(base, load64(wadd(h, FL_ARRAY)));\n        store64(wadd(h, FL_ARRAY), base);\n        addAt(wadd(wadd(h, FL_N), 72), 1);\n        liveDec();\n        recycled = true;\n      }\n    } else if (kind == 3) {\n      // struct: release the reference slots (refmask, lowest bit first, stopping at the last set bit; no bit is set at or above nslots), recycle the object by\n      // size class\n      const n = load32(wadd(x, 16));\n      let m = load64(wadd(x, 24));\n      let p = wadd(x, 32);\n      while (m != 0) {\n        if (and(m, 1) == 1) {\n          const c = load64(p);\n          if (decRef(c)) {\n            if (cur == 0) {\n              cur = c;\n            } else {\n              if (sp == scap) {\n                scap = growStack(scap);\n                stack = load64(wadd(h, DSTACK));\n              }\n              store64(wadd(stack, shl(sp, 3)), c);\n              sp = wadd(sp, 1);\n            }\n          }\n        }\n        m = shr(m, 1);\n        p = wadd(p, 8);\n      }\n      if (cfg(1) == 1) {\n        subAt(wadd(h, S_LIVE_BYTES), wadd(32, shl(n, 3)));\n      }\n      if (cfg(0) == 1 && n < 9 && load64(wadd(wadd(h, FL_N), shl(n, 3))) < FL_CAP) {\n        const lp = wadd(wadd(h, FL_STRUCT), shl(n, 3));\n        store64(base, load64(lp));\n        store64(lp, base);\n        addAt(wadd(wadd(h, FL_N), shl(n, 3)), 1);\n        liveDec();\n        recycled = true;\n      }\n    } else {\n      // string: one block of 32 + cap + 1 bytes\n      const total = wadd(load64(wadd(x, 24)), 33);\n      if (cfg(1) == 1) {\n        subAt(wadd(h, S_LIVE_BYTES), total);\n      }\n      sbFree(base, wadd(total, pfx()));\n      liveDec();\n      recycled = true;\n    }\n    if (!recycled) {\n      memFree(base);\n      liveDec();\n    }\n  }\n}\n\n// The copying path of `make_unique` (the count of `o` is not 1): a shallow copy with the children retained, one count of `o`\n// released. Consumes the caller's reference to `o`, returns an owned one.\nexport function makeUniqueSlow(o: usize): usize {\n  if (cfg(1) == 1) {\n    addAt(wadd(heapBase(), S_COW_COPIES), 1);\n  }\n  siteRc(o, 2);\n  const kind = load32(wadd(o, 8));\n  let r: usize = 0;\n  if (kind == 3) {\n    const n = load32(wadd(o, 16));\n    const mask = load64(wadd(o, 24));\n    r = structNew(load32(wadd(o, 12)), n, mask);\n    let i: usize = 0;\n    while (i < n) {\n      const v = load64(wadd(wadd(o, 32), shl(i, 3)));\n      store64(wadd(wadd(r, 32), shl(i, 3)), v);\n      if (and(shr(mask, i), 1) == 1) {\n        retain(v);\n      }\n      i = wadd(i, 1);\n    }\n  } else if (kind == 2) {\n    const len = load64(wadd(o, 16));\n    const isRef = load64(wadd(o, 32));\n    r = arrayNew(len, isRef);\n    const src = load64(wadd(o, 40));\n    const dst = load64(wadd(r, 40));\n    if (isRef != 0) {\n      let i: usize = 0;\n      while (i < len) {\n        const v = load64(wadd(src, shl(i, 3)));\n        store64(wadd(dst, shl(i, 3)), v);\n        retain(v);\n        i = wadd(i, 1);\n      }\n    } else if (len != 0) {\n      memCopy(dst, src, shl(len, 3));\n    }\n    store64(wadd(r, 16), len);\n  } else {\n    const len = load64(wadd(o, 16));\n    r = strAlloc(len, len);\n    if (len != 0) {\n      memCopy(wadd(r, 32), wadd(o, 32), len);\n    }\n  }\n  release(o);\n  return r;\n}\n" });
  out.push(SourceFile { path: "$rt/rt.or", text: "// $rt/rt -- the first module of the runtime core written in Orin (ADR-0052 Addendum A, step R3d.0; spec 19 section 3).\n//\n// `runtime/core/*.or` is the embedded root `$rt` (tools/embed_prelude.py, compiler/loader/prelude.or). Its entry\n// `$rt/module.or` is loaded into every compiled program like `$std`; unreferenced functions are pruned (compiler/opt/prune.or),\n// so a program that does not call into it is unchanged. Only modules of this root may import the internal module `std:core`\n// (the core operations of hir/coreops.or). The L1 object-model modules (layout, heap, object, rc, stats) of R3d.1..R3d.5 land here.\n\n// The version of the object layout that the L1 modules assume (spec 19; rule 3 of Addendum A section 2). It changes with the\n// frozen offsets, never otherwise.\nexport function rtLayoutVersion(): usize {\n  return 1;\n}\n" });
  out.push(SourceFile { path: "$rt/stats.or", text: "// $rt/stats -- the ORIN_STATS report and the live-object count, written in Orin (ADR-0052 Addendum A, step R3d.5).\n//\n// `statsReport` runs at process exit (the C `orin_init` registers the wrapper `orin_stats_report` with the platform's at-exit list):\n// with ORIN_STATS=1 it prints the one-line JSON report of the counters on stderr, with ORIN_STATS=sites (census builds) it prints\n// the census table first. The counters are the ones of the heap block (heap.or, `OrinStats`, 18 words from byte 192) of the exiting\n// thread plus the totals of the finished tasks, which the C runtime keeps in `g_fold` / `g_fold_live` and which Orin reaches through\n// the hooks HK_FOLD_STATS / HK_FOLD_LIVE under the runtime lock (`plat`). The report is assembled by hand in a raw buffer (no Orin string is\n// allocated: the counters must not change while they are read) and is byte for byte the one the C `stats_report` printed.\n// `liveCount` is `orin_live_count`: the balance of this thread's heap plus the finished tasks'. The census itself (the per-site\n// tables, their fold and report) stays C in runtime/core/orin_runtime.c and is reached through hooks (heap.or).\n\nimport { load8, load64, store8, store64, memAlloc, memFree, memCopy, heapBase, cfg, hook, plat, addrOf, wadd, wsub, shl } from \"std:core\";\nimport { HK_FOLD_STATS, HK_FOLD_LIVE, HK_STATS_ON, HK_SITE_REPORT, LIVE } from \"./heap\";\nimport { PL_RUNTIME_LOCK, PL_RUNTIME_UNLOCK, PL_GETENV, PL_WRITE_LINE } from \"./plat\";\n\nconst STATS: usize = 192;             // OrinStats in the heap block\nconst SIGN: usize = 9223372036854775808;\n\n// True when the C string at `p` (0: none) is exactly the text of `s`.\nfunction cstrIs(p: usize, s: string): bool {\n  if (p == 0) {\n    return false;\n  }\n  const a = addrOf(s);\n  const n = load64(wadd(a, 16));\n  let i: usize = 0;\n  while (i < n) {\n    if (load8(wadd(p, i)) != load8(wadd(wadd(a, 32), i))) {\n      return false;\n    }\n    i = wadd(i, 1);\n  }\n  return load8(wadd(p, n)) == 0;\n}\n\n// Append the text of `s` to the buffer `buf` holding `n` bytes; returns the new length.\nfunction putStr(buf: usize, n: usize, s: string): usize {\n  const a = addrOf(s);\n  const k = load64(wadd(a, 16));\n  memCopy(wadd(buf, n), wadd(a, 32), k);\n  return wadd(n, k);\n}\n\n// Append the decimal digits of `v`; returns the new length.\nfunction putU(buf: usize, n: usize, v: usize): usize {\n  let digits: usize = 1;\n  let t = v / 10;\n  while (t != 0) {\n    digits = wadd(digits, 1);\n    t = t / 10;\n  }\n  let p = wadd(wadd(buf, n), digits);\n  let w = v;\n  store8(wsub(p, 1), wadd(48, w % 10));\n  p = wsub(p, 1);\n  w = w / 10;\n  while (w != 0) {\n    store8(wsub(p, 1), wadd(48, w % 10));\n    p = wsub(p, 1);\n    w = w / 10;\n  }\n  return wadd(n, digits);\n}\n\n// Append `,\"key\":` and the decimal value; `key` includes the leading comma and the colon.\nfunction putField(buf: usize, n: usize, key: string, v: usize): usize {\n  return putU(buf, putStr(buf, n, key), v);\n}\n\n// The balance of live objects: this thread's heap plus the finished tasks' (signed, as a word).\nexport function liveCount(): usize {\n  plat(PL_RUNTIME_LOCK, 0, 0, 0);\n  const folded = load64(hook(HK_FOLD_LIVE, 0, 0, 0));\n  plat(PL_RUNTIME_UNLOCK, 0, 0, 0);\n  return wadd(load64(wadd(heapBase(), LIVE)), folded);\n}\n\n// The report. `t` holds the 18 counters of the exiting thread, to which the finished tasks' totals are added under the runtime lock\n// (the sums, and the larger of the two peaks).\nexport function statsReport(): void {\n  const name = \"ORIN_STATS\";\n  const e = plat(PL_GETENV, wadd(addrOf(name), 32), 0, 0);\n  let sites = false;\n  if (cfg(2) == 1 && cstrIs(e, \"sites\")) {\n    sites = true;\n    hook(HK_SITE_REPORT, 0, 0, 0);\n  }\n  if (!sites && !cstrIs(e, \"1\")) {\n    return;\n  }\n  const t = memAlloc(144);\n  memCopy(t, wadd(heapBase(), STATS), 144);\n  plat(PL_RUNTIME_LOCK, 0, 0, 0);\n  const g = hook(HK_FOLD_STATS, 0, 0, 0);\n  let i: usize = 0;\n  while (i < 18) {\n    const o = shl(i, 3);\n    const a = load64(wadd(t, o));\n    const b = load64(wadd(g, o));\n    if (i == 10 || i == 11) {\n      store64(wadd(t, o), b > a ? b : a);\n    } else {\n      store64(wadd(t, o), wadd(a, b));\n    }\n    i = wadd(i, 1);\n  }\n  plat(PL_RUNTIME_UNLOCK, 0, 0, 0);\n  const r = memAlloc(1024);\n  let n = putStr(r, 0, \"{\\\"orin_stats\\\":\");\n  n = putStr(r, n, hook(HK_STATS_ON, 0, 0, 0) == 1 ? \"{\\\"counters\\\":\\\"all\\\"\" : \"{\\\"counters\\\":\\\"cold\\\"\");\n  n = putField(r, n, \",\\\"alloc_string\\\":\", load64(t));\n  n = putField(r, n, \",\\\"alloc_array\\\":\", load64(wadd(t, 8)));\n  n = putField(r, n, \",\\\"alloc_struct\\\":\", load64(wadd(t, 16)));\n  n = putField(r, n, \",\\\"alloc_total\\\":\", wadd(wadd(load64(t), load64(wadd(t, 8))), load64(wadd(t, 16))));\n  n = putField(r, n, \",\\\"frees\\\":\", load64(wadd(t, 24)));\n  n = putField(r, n, \",\\\"retains\\\":\", load64(wadd(t, 32)));\n  n = putField(r, n, \",\\\"releases\\\":\", load64(wadd(t, 40)));\n  n = putField(r, n, \",\\\"cow_copies\\\":\", load64(wadd(t, 48)));\n  n = putField(r, n, \",\\\"cow_inplace\\\":\", load64(wadd(t, 56)));\n  n = putField(r, n, \",\\\"array_grows\\\":\", load64(wadd(t, 64)));\n  n = putField(r, n, \",\\\"string_grows\\\":\", load64(wadd(t, 72)));\n  n = putField(r, n, \",\\\"peak_live_objs\\\":\", load64(wadd(t, 80)));\n  n = putField(r, n, \",\\\"peak_live_bytes\\\":\", load64(wadd(t, 88)));\n  n = putField(r, n, \",\\\"file_opens\\\":\", load64(wadd(t, 104)));\n  n = putField(r, n, \",\\\"file_closes\\\":\", load64(wadd(t, 112)));\n  n = putField(r, n, \",\\\"transfer_moves\\\":\", load64(wadd(t, 120)));\n  n = putField(r, n, \",\\\"transfer_copies\\\":\", load64(wadd(t, 128)));\n  n = putField(r, n, \",\\\"tasks_spawned\\\":\", load64(wadd(t, 136)));\n  n = putStr(r, n, \",\\\"live_objs_at_exit\\\":\");\n  const live = liveCount();\n  if (live >= SIGN) {\n    store8(wadd(r, n), 45);\n    n = putU(r, wadd(n, 1), wsub(0, live));\n  } else {\n    n = putU(r, n, live);\n  }\n  n = putStr(r, n, \"}}\");\n  plat(PL_WRITE_LINE, 2, r, n);\n  memFree(r);\n  memFree(t);\n}\n" });
  out.push(SourceFile { path: "$rt/str.or", text: "// $rt/str -- the string append family, written in Orin (ADR-0052 Addendum A, step R3d.4).\n//\n// The backends call these functions by name (compiler/mir/rt.or lists them; opt/prune.or keeps them) in place of the C runtime\n// functions `orin_str_concat`, `orin_str_append`, `orin_str_prepend`, `orin_str_append_sub`, `orin_str_append_int` and\n// `orin_str_append_usize`; the C unit tests of the runtime reach `strConcat` and `strAppend` through the wrappers of the same C\n// names. An object is its address as a `usize`; the layout is the frozen one (heap.or): string len@16 cap@24 data@32, the bytes\n// followed by a NUL. The sharing rule of every append is the C one: the string `a` (consumed, the result replaces it) is extended in\n// place only when its count is 1, else a fresh string is built and one count of `a` is released. The in-place path grows the\n// capacity to at least twice, 16 bytes at the least; the fresh one reserves a half more (append) so that a loop of appends on\n// a shared string turns into in-place appends. Counters are updated exactly as the C versions did (the ORIN_STATS=1 report is the\n// equivalence oracle).\n\nimport { load64, store8, store64, memCopy, memMove, heapBase, cfg, wadd, wsub, wmul, shr } from \"std:core\";\nimport { taskTrap } from \"std:fsraw\";\nimport { sbRealloc, addAt, pfx, siteGrow, S_LIVE_BYTES, S_STRING_GROWS } from \"./heap\";\nimport { strAlloc } from \"./object\";\nimport { retain, release } from \"./rc\";\n\n// The unique string `a` (count 1) with a capacity of at least `n` bytes: the grown block (which may have moved).\nfunction strGrow(a: usize, n: usize): usize {\n  const oldCap = load64(wadd(a, 24));\n  let cap = wmul(oldCap, 2);\n  if (cap < n) {\n    cap = n;\n  }\n  if (cap < 16) {\n    cap = 16;\n  }\n  const x = wadd(sbRealloc(wsub(a, pfx()), wadd(wadd(oldCap, 33), pfx()), wadd(wadd(cap, 33), pfx())), pfx());\n  if (cfg(1) == 1) {\n    const h = heapBase();\n    addAt(wadd(h, S_LIVE_BYTES), wsub(cap, oldCap));\n    addAt(wadd(h, S_STRING_GROWS), 1);\n  }\n  siteGrow(x, wsub(cap, oldCap));\n  store64(wadd(x, 24), cap);\n  return x;\n}\n\n// The fresh string a ++ y (a shared or immortal `a`, or the strings are the same): `n` is the new length, `src` the address of the\n// `k` bytes to append. Reserves a half more than the length, releases one count of `a`. Out of line: the in-place path of the\n// callers stays small.\nfunction appendFresh(a: usize, src: usize, k: usize, n: usize): usize {\n  const r = strAlloc(n, wadd(n, wadd(shr(n, 1), 8)));\n  const xl = wsub(n, k);\n  if (xl != 0) {\n    memCopy(wadd(r, 32), wadd(a, 32), xl);\n  }\n  memCopy(wadd(wadd(r, 32), xl), src, k);\n  release(a);\n  return r;\n}\n\n// a ++ b as a new string, or the other operand shared when one is empty.\nexport function strConcat(a: usize, b: usize): usize {\n  const xl = load64(wadd(a, 16));\n  const yl = load64(wadd(b, 16));\n  if (yl == 0) {\n    retain(a);\n    return a;\n  }\n  if (xl == 0) {\n    retain(b);\n    return b;\n  }\n  const n = wadd(xl, yl);\n  const r = strAlloc(n, n);\n  memCopy(wadd(r, 32), wadd(a, 32), xl);\n  memCopy(wadd(wadd(r, 32), xl), wadd(b, 32), yl);\n  return r;\n}\n\n// a = a ++ b. Consumes `a`; `b` is only read.\nexport function strAppend(a: usize, b: usize): usize {\n  const yl = load64(wadd(b, 16));\n  if (yl == 0) {\n    return a;\n  }\n  const xl = load64(wadd(a, 16));\n  const n = wadd(xl, yl);\n  if (load64(a) == 1 && a != b) {\n    let x = a;\n    if (n > load64(wadd(a, 24))) {\n      x = strGrow(a, n);\n    }\n    memCopy(wadd(wadd(x, 32), xl), wadd(b, 32), yl);\n    store64(wadd(x, 16), n);\n    store8(wadd(wadd(x, 32), n), 0);\n    return x;\n  }\n  return appendFresh(a, wadd(b, 32), yl, n);\n}\n\n// a = a ++ s.substring(i, j) without the substring object. Consumes `a`; traps \"substring out of range\" unless i <= j <= len(s).\nexport function strAppendSub(a: usize, s: usize, i: usize, j: usize): usize {\n  if (i > j || j > load64(wadd(s, 16))) {\n    taskTrap(\"substring out of range\");\n  }\n  if (i == j) {\n    return a;\n  }\n  const k = wsub(j, i);\n  const xl = load64(wadd(a, 16));\n  const n = wadd(xl, k);\n  if (load64(a) == 1 && a != s) {\n    let x = a;\n    if (n > load64(wadd(a, 24))) {\n      x = strGrow(a, n);\n    }\n    memCopy(wadd(wadd(x, 32), xl), wadd(wadd(s, 32), i), k);\n    store64(wadd(x, 16), n);\n    store8(wadd(wadd(x, 32), n), 0);\n    return x;\n  }\n  return appendFresh(a, wadd(wadd(s, 32), i), k, n);\n}\n\n// Write the decimal digits of `v` (`digits` of them) so that they end just before `end`, and a minus sign before them when `neg` is 1.\n@Inline\nfunction putDigits(end: usize, v: usize, neg: usize): void {\n  let p = wsub(end, 1);\n  store8(p, wadd(48, v % 10));\n  let w = v / 10;\n  while (w != 0) {\n    p = wsub(p, 1);\n    store8(p, wadd(48, w % 10));\n    w = w / 10;\n  }\n  if (neg == 1) {\n    store8(wsub(p, 1), 45);\n  }\n}\n\n// a = a ++ decimal text of `v` (a minus sign first when `neg` is 1) for a shared or immortal `a`: a fresh string, one count of `a`\n// released. `n` is the new length, `k` the length of the text.\nfunction decimalFresh(a: usize, v: usize, neg: usize, k: usize, n: usize): usize {\n  const r = strAlloc(n, wadd(n, wadd(shr(n, 1), 8)));\n  const xl = wsub(n, k);\n  if (xl != 0) {\n    memCopy(wadd(r, 32), wadd(a, 32), xl);\n  }\n  const end = wadd(wadd(r, 32), n);\n  store8(end, 0);\n  putDigits(end, v, neg);\n  release(a);\n  return r;\n}\n\n// The number of decimal digits of `v` (at least 1). A ladder of compares for the common short numbers, a division loop from six digits on:\n// counting by repeated division would cost as much as writing the digits (R3d.5: it was +1.4 % instructions on `mapfreq`).\n@Inline\nfunction decimalDigits(v: usize): usize {\n  if (v < 10) {\n    return 1;\n  }\n  if (v < 100) {\n    return 2;\n  }\n  if (v < 1000) {\n    return 3;\n  }\n  if (v < 10000) {\n    return 4;\n  }\n  if (v < 100000) {\n    return 5;\n  }\n  let d: usize = 5;\n  let t = v / 100000;\n  while (t != 0) {\n    d = wadd(d, 1);\n    t = t / 10;\n  }\n  return d;\n}\n\n// a = a ++ decimal text of `v` (a minus sign first when `neg` is 1). The digits are written straight behind the old bytes.\nfunction appendDecimal(a: usize, v: usize, neg: usize): usize {\n  const k = wadd(decimalDigits(v), neg);\n  const n = wadd(load64(wadd(a, 16)), k);\n  if (load64(a) != 1) {\n    return decimalFresh(a, v, neg, k, n);\n  }\n  let r = a;\n  if (n > load64(wadd(a, 24))) {\n    r = strGrow(a, n);\n  }\n  store64(wadd(r, 16), n);\n  const end = wadd(wadd(r, 32), n);\n  store8(end, 0);\n  putDigits(end, v, neg);\n  return r;\n}\n\n// a = a ++ decimal text of the unsigned `v`.\nexport function strAppendUsize(a: usize, v: usize): usize {\n  return appendDecimal(a, v, 0);\n}\n\n// a = a ++ decimal text of the signed `v`.\nexport function strAppendInt(a: usize, v: int): usize {\n  if (v < 0) {\n    return appendDecimal(a, wadd((-(v + 1)).toUsize(), 1), 1);\n  }\n  return appendDecimal(a, v.toUsize(), 0);\n}\n\n// The fresh string b ++ a of length `n` (a shared or immortal, or a is b), one count of `a` released.\nfunction prependFresh(a: usize, b: usize, n: usize): usize {\n  const yl = load64(wadd(b, 16));\n  const xl = load64(wadd(a, 16));\n  const r = strAlloc(n, n);\n  memCopy(wadd(r, 32), wadd(b, 32), yl);\n  if (xl != 0) {\n    memCopy(wadd(wadd(r, 32), yl), wadd(a, 32), xl);\n  }\n  release(a);\n  return r;\n}\n\n// a = b ++ a. Consumes `a`; `b` is only read.\nexport function strPrepend(a: usize, b: usize): usize {\n  const yl = load64(wadd(b, 16));\n  if (yl == 0) {\n    return a;\n  }\n  const xl = load64(wadd(a, 16));\n  const n = wadd(xl, yl);\n  if (load64(a) == 1 && a != b) {\n    let x = a;\n    if (n > load64(wadd(a, 24))) {\n      x = strGrow(a, n);\n    }\n    memMove(wadd(wadd(x, 32), yl), wadd(x, 32), xl);\n    memCopy(wadd(x, 32), wadd(b, 32), yl);\n    store64(wadd(x, 16), n);\n    store8(wadd(wadd(x, 32), n), 0);\n    return x;\n  }\n  return prependFresh(a, b, n);\n}\n" });
  out.push(SourceFile { path: "$rt/sync.or", text: "// $rt/sync -- the monitor operations of `std:task`, written in Orin (ADR-0052 Addendum B, step R3e.1).\n//\n// A monitor is an L0 object (runtime/platform: a mutex, two condition queues and an array of 64-bit words readable and writable only\n// while the caller holds the mutex). `std:task` reaches it through eleven builtins (`monNew` .. `monWaitUntil`, hir/taskops.or 0..8, 23\n// and 27); the backends call these functions in place of the C forwarders `orin_mon_*` of runtime/core/orin_runtime.c (mir/rt.or\n// `l1Task`), which stay in the live runtime until R3e.6 and in the frozen snapshot for the seed. Every function is one `plat` call (a\n// direct call of the L0 function, hir/coreops.or) plus the test of its result: a failed L0 call is a trap with the message the C\n// forwarders had (`mon_check`), and a trap on a task thread ends that task only (taskTrap).\n//\n// The result of `plat` is the `int` of L0 sign-extended; L0 returns 0, a positive error code, or for `monitor_wait_until` the\n// positive WAIT_TIMEOUT (1). EINVAL (22) and ENOMEM (12) have the same value on every platform (orin_platform.h); EDEADLK does not (35\n// on Linux, 11 on macOS), and `monitor_lock` is the only function that can return it, so an error of `monLock` that is not EINVAL is\n// EDEADLK.\n\nimport { load64, heapBase, plat, wadd } from \"std:core\";\nimport { taskTrap } from \"std:fsraw\";\nimport {\n  PL_MONITOR_NEW, PL_MONITOR_FREE, PL_MONITOR_LOCK, PL_MONITOR_UNLOCK, PL_MONITOR_WAIT, PL_MONITOR_WAIT_UNTIL, PL_MONITOR_NOTIFY,\n  PL_MONITOR_GET, PL_MONITOR_SET, PL_MONITOR_GROW\n} from \"./plat\";\nimport { H_SCRATCH } from \"./heap\";\nimport { waitBegin, waitEnd } from \"./task\";\n\nconst EINVAL: usize = 22;\nconst ENOMEM: usize = 12;\nconst INT64_MAX: usize = 9223372036854775807;\n\n// The trap for a non-zero result `rc` of a monitor call; `lock` is true for monitor_lock (see the file comment).\nfunction monFail(rc: usize, lock: bool): void {\n  if (rc == ENOMEM) {\n    taskTrap(\"out of memory\");\n  }\n  if (lock && rc != EINVAL) {\n    taskTrap(\"monitor locked twice by the same task\");\n  }\n  taskTrap(\"invalid monitor operation (stale handle, lock not held, or index out of range)\");\n}\n\n// A monitor of `n` words, all 0, unlocked; its handle.\n@Inline\nexport function monNew(n: usize): usize {\n  const h = plat(PL_MONITOR_NEW, n, 0, 0);\n  if (h == 0) {\n    taskTrap(\"cannot create a monitor (limit reached)\");\n  }\n  return h;\n}\n\n// Release the monitor `m` (it must be unlocked, with no waiter).\n@Inline\nexport function monFree(m: usize): void {\n  const rc = plat(PL_MONITOR_FREE, m, 0, 0);\n  if (rc != 0) {\n    monFail(rc, false);\n  }\n}\n\n// Lock `m`, blocking until it is free.\n@Inline\nexport function monLock(m: usize): void {\n  const rc = plat(PL_MONITOR_LOCK, m, 0, 0);\n  if (rc != 0) {\n    monFail(rc, true);\n  }\n}\n\n// Unlock `m`.\n@Inline\nexport function monUnlock(m: usize): void {\n  const rc = plat(PL_MONITOR_UNLOCK, m, 0, 0);\n  if (rc != 0) {\n    monFail(rc, false);\n  }\n}\n\n// Sleep on condition queue `c` (0 or 1) of the locked monitor `m` until it is notified (or spuriously): re-check the condition. A task whose\n// ancestor trapped (C2, task.or) does not return from here: it ends (`waitBegin` / `waitEnd`).\n@Inline\nexport function monWait(m: usize, c: usize): void {\n  waitBegin(m, c);\n  const rc = plat(PL_MONITOR_WAIT, m, c, 0);\n  waitEnd(m);\n  if (rc != 0) {\n    monFail(rc, false);\n  }\n}\n\n// Wake every waiter of queue `c` of `m`.\n@Inline\nexport function monNotifyAll(m: usize, c: usize): void {\n  const rc = plat(PL_MONITOR_NOTIFY, m, c, 1);\n  if (rc != 0) {\n    monFail(rc, false);\n  }\n}\n\n// Wake one waiter of queue `c` of `m`.\n@Inline\nexport function monNotifyOne(m: usize, c: usize): void {\n  const rc = plat(PL_MONITOR_NOTIFY, m, c, 0);\n  if (rc != 0) {\n    monFail(rc, false);\n  }\n}\n\n// Timed wait on an absolute CLOCK_MONOTONIC deadline in milliseconds: 1 when the deadline passed, 0 when notified (or spuriously).\n@Inline\nexport function monWaitUntil(m: usize, c: usize, deadline: usize): usize {\n  waitBegin(m, c);\n  const rc = plat(PL_MONITOR_WAIT_UNTIL, m, c, deadline > INT64_MAX ? INT64_MAX : deadline);\n  waitEnd(m);\n  if (rc == 1) {\n    return 1;\n  }\n  if (rc != 0) {\n    monFail(rc, false);\n  }\n  return 0;\n}\n\n// Word `i` of the locked monitor `m`. L0 writes it to the scratch word of this thread's heap block.\n@Inline\nexport function monGet(m: usize, i: usize): usize {\n  const s = wadd(heapBase(), H_SCRATCH);\n  const rc = plat(PL_MONITOR_GET, m, i, s);\n  if (rc != 0) {\n    monFail(rc, false);\n  }\n  return load64(s);\n}\n\n// Set word `i` of the locked monitor `m` to `v`.\n@Inline\nexport function monSet(m: usize, i: usize, v: usize): void {\n  const rc = plat(PL_MONITOR_SET, m, i, v);\n  if (rc != 0) {\n    monFail(rc, false);\n  }\n}\n\n// Grow the locked monitor `m` to `n` words (the new ones are 0).\n@Inline\nexport function monGrow(m: usize, n: usize): void {\n  const rc = plat(PL_MONITOR_GROW, m, n, 0);\n  if (rc != 0) {\n    monFail(rc, false);\n  }\n}\n" });
  out.push(SourceFile { path: "$rt/task.or", text: "// $rt/task -- the task interface of `std:task`, written in Orin (ADR-0052 Addendum B, steps R3e.3 and R3e.4).\n//\n// A task is an operating-system thread with its own heap (ADR-0017). `spawn` makes the task record (`RtTask`, 512 bytes of raw memory,\n// never the small-block cache: the joiner frees it on another thread) and starts the thread at `main`; `main` claims the body (a closure\n// in a transfer box), runs it, retires the heap and publishes the end; `join` waits for the thread and keeps its record as the task\n// joined last (`message` reads the trap message from it; it is freed at the next join and when the heap retires). A trap on a task\n// thread (`trap`, the function behind the C name `orin_trap`) records the message, retires the heap, publishes the end and ends the\n// thread with `thread_exit` (forced unwinding of every frame between the trap and the thread entry, risk 3 of the ADR); a trap on the\n// main thread prints `trap: <message>` on stderr and exits with status 101. The trap path allocates nothing (the line buffer is in the\n// shared block, the message goes into the task record) and holds no lock when it ends the thread; a failure inside it is an exit.\n//\n// The record, in bytes: tok@0 (the transfer token of the body), trapped@8 (1 when the task ended on a trap), done_mon@16 (the monitor\n// of `watch`, 0 = none), message@24 (480 bytes and a NUL), and from 512 the fields of the trap-safe cleanup (C2, below). The\n// thread-local state is in the heap block: `task` (H_TASK, the address of the record of this thread, 0 on the main thread), `joined`\n// (H_JOINED) and the registry of children (H_CHILDREN). The C-named wrappers (`orin_trap`, the test wrappers) are made by the\n// backends (mir/rt.or); the C task functions stay in the live runtime until R3e.6.\n//\n// TRAP-SAFE CLEANUP (C2, docs/concurrency.md \"Panics\"). A trap never leaves a task behind that the trapping thread started:\n//  * Every `spawn` enters the new task in the REGISTRY of the spawning thread (a list of nodes in the heap block, in spawn order), and\n//    `join` removes it. The registry is therefore exactly the set of live, unjoined children; the scopes of std:task need not know.\n//  * A task that traps CANCELS ITS SCOPE (it signals the token that was bound to the spawner when it was started, once its children are\n//    joined and its trap has its rank), so siblings stop at their next checkpoint (`isCancelled`, network waits).\n//  * The thread that traps (task or main) then UNWINDS its children before it ends: it is DOOMED (a flag in its record, or in the\n//    shared block for the main thread), every token of a live child is cancelled, every descendant that waits in a monitor\n//    (channel `recv` / `send` / `select`, a scope waiting for its tasks) is woken and ends with \"task cancelled\" at once, and the\n//    thread joins every child of the registry. A doomed task ends at its next monitor wait (`waitBegin` / `waitEnd`, called by\n//    `monWait` / `monWaitUntil` of sync.or) and runs this same cleanup for its own children, so the whole subtree is cancelled and joined\n//    before the trap is reported to the joiner or the process exits. A task that ended this way is not a failure of its own\n//    (flag `T_FLAGS`); a child that trapped while it was being unwound is a SECONDARY failure.\n//  * PRIMARY AND SECONDARY failures: the message of the task that trapped is the primary one. A secondary failure found while\n//    unwinding is appended to it (a task) or printed after it (the main thread, one line each). When several children of one scope\n//    trap, `join` reports the one that trapped first (`T_SEQ`, the order in which traps were published), with the message of the\n//    joined task appended, whatever the order in which they are joined.\n//  Not interrupted: a descendant that computes without ever waiting or checking `isCancelled()`; the cleanup waits for it.\n\nimport {\n  load8, load64, store8, store64, memAlloc, memFree, memCopy, memMove, heapBase, sharedBase, cfg, hook, plat, fnAddr, addrOf, wadd, wmul, shl\n} from \"std:core\";\nimport { transitTake, transitDrop, taskTrap } from \"std:fsraw\";\nimport {\n  PL_THREAD_CREATE, PL_THREAD_JOIN, PL_THREAD_EXIT, PL_MONITOR_LOCK, PL_MONITOR_UNLOCK, PL_MONITOR_SET, PL_MONITOR_NOTIFY,\n  PL_RUNTIME_LOCK, PL_RUNTIME_UNLOCK, PL_WRITE_LINE, PL_EXIT, PL_GETENV, PL_CPU_COUNT, PL_WAKE_SIGNAL, PL_WAKE_BOUND\n} from \"./plat\";\nimport {\n  H_TASK, H_JOINED, H_SCRATCH, H_CHILDREN, H_CHILDREN_TAIL, H_TRAPPING, DSTACK, DCAP, FL_STRUCT, FL_ARRAY, FL_N, LIVE, SB, S_ALLOC_STRING, S_TASKS_SPAWNED, addAt,\n  HK_FOLD_STATS, HK_FOLD_LIVE, HK_REVOKE_GRANTS, HK_CLOSE_FILES, HK_FREE_NETBUF, HK_SITE_FOLD\n} from \"./heap\";\nimport { strAlloc } from \"./object\";\n\nconst E_TASK_MAIN: usize = 52;   // the entry number of `main` (mir/rt.or RT_TASK_MAIN): `fnAddr` takes the address of its C-ABI wrapper\n\nconst TASK_SIZE: usize = 640;    // the task record\nconst T_TOK: usize = 0;\nconst T_TRAPPED: usize = 8;\nconst T_DONE: usize = 16;\nconst T_MSG: usize = 24;\nconst MSG_MAX: usize = 480;      // the longest trap message (a longer one is cut)\n// (C2) the fields after the message; all of them are read and written under the runtime lock unless noted\nconst T_PARENT: usize = 512;     // the record of the task that started this one, 0 = the main thread (never changes after spawn)\nconst T_SCOPE: usize = 520;      // the cancellation token that was bound to the spawner when this task was started (never changes)\nconst T_KILL: usize = 528;       // 1 once this task is trapping or was cancelled by an ancestor's trap: its descendants are doomed\nconst T_SEQ: usize = 536;        // 0, or the rank of this task's trap among the published traps (1 = the first); set once, last\nconst T_FLAGS: usize = 544;      // 1 when the task ended because an ancestor trapped (a cancellation, not a failure of its own)\nconst T_WM: usize = 552;         // the monitor the task waits in, and its condition queue (while T_WAITING = 1)\nconst T_WQ: usize = 560;\nconst T_WNEXT: usize = 568;      // the list of waiting tasks (head: shared word SH_WAITERS)\nconst T_WPREV: usize = 576;\nconst T_POKED: usize = 584;      // 1 once the wait that is registered was already woken by a doomed ancestor\nconst T_WAITING: usize = 592;\n// the shared words (byte offsets in orin_shared) and the registry nodes\nconst SH_MAIN_DOOMED: usize = 64;\nconst SH_TRAP_SEQ: usize = 72;\nconst SH_WAITERS: usize = 80;\nconst NODE_SIZE: usize = 32;     // a registry node: next@0, handle@8 (the thread), rec@16 (the task record)\nconst N_NEXT: usize = 0;\nconst N_HANDLE: usize = 8;\nconst N_REC: usize = 16;\nconst TRAPLINE: usize = 512;     // the line buffer of the process trap in the shared block (orin_shared.trapline, 512 bytes)\n\ntype Thunk = () => void;\n// The unit of transfer of `std:task` (`Box<Thunk>`): a one-field record holding the body of the task.\ntype TaskBox = { v: Thunk; };\n\n// The number of worker threads of a parallel pipeline (ADR-0039): the environment variable ORIN_THREADS when it is a number from 1 to\n// 1024, otherwise the processors online. Results never depend on it (fixed chunks, combined in chunk order). `std:task` reaches this\n// through `BTask(26)`; the backends call it in place of the C `orin_rt_par_threads` (mir/rt.or `l1Task`).\nexport function parThreads(): usize {\n  const name = \"ORIN_THREADS\";\n  const e = plat(PL_GETENV, wadd(addrOf(name), 32), 0, 0);\n  if (e != 0 && load8(e) != 0) {\n    let v: usize = 0;\n    let ok = true;\n    let p = e;\n    let c = load8(p);\n    while (c != 0 && ok) {\n      if (c < 48 || c > 57 || v > 1024) {\n        ok = false;\n      } else {\n        v = wadd(wmul(v, 10), c - 48);\n      }\n      p = wadd(p, 1);\n      c = load8(p);\n    }\n    if (ok && v >= 1 && v <= 1024) {\n      return v;\n    }\n  }\n  return plat(PL_CPU_COUNT, 0, 0, 0);\n}\n\n// ---------------------------------------------------------------- the end of a task\n\n// Return the free list at `lp` (head) and its length word at `np` to the allocator. A node holds the address of the next one in its first\n// word (heap.or); a node may have come from another thread's heap.\nfunction drainList(lp: usize, np: usize): void {\n  let n = load64(lp);\n  while (n != 0) {\n    const next = load64(n);\n    memFree(n);\n    n = next;\n  }\n  store64(lp, 0);\n  store64(np, 0);\n}\n\n// A task's heap ends (the C `orin_rt_heap_exit`): close what the task left open, free the buffers it holds, return the free lists and the\n// small-block cache to the allocator, and fold its counters into the process totals (what ORIN_STATS prints). The grants, the files and\n// the network buffer are C tables until R3c: the hooks reach them. Allocates nothing; the order is the one of the C function.\nexport function heapRetire(): void {\n  const h = heapBase();\n  hook(HK_REVOKE_GRANTS, 0, 0, 0);\n  hook(HK_CLOSE_FILES, 0, 0, 0);\n  hook(HK_FREE_NETBUF, 0, 0, 0);\n  const j = load64(wadd(h, H_JOINED));\n  if (j != 0) {\n    memFree(j);\n    store64(wadd(h, H_JOINED), 0);\n  }\n  let nd = load64(wadd(h, H_CHILDREN));\n  while (nd != 0) { // children nobody joined (their records are not freed here: the threads may still run)\n    const nx = load64(wadd(nd, N_NEXT));\n    memFree(nd);\n    nd = nx;\n  }\n  store64(wadd(h, H_CHILDREN), 0);\n  store64(wadd(h, H_CHILDREN_TAIL), 0);\n  const d = load64(wadd(h, DSTACK));\n  if (d != 0) {\n    memFree(d);\n  }\n  store64(wadd(h, DSTACK), 0);\n  store64(wadd(h, DCAP), 0);\n  if (cfg(0) == 1) {\n    let c: usize = 0;\n    while (c < 9) {\n      drainList(wadd(wadd(h, FL_STRUCT), shl(c, 3)), wadd(wadd(h, FL_N), shl(c, 3)));\n      c = wadd(c, 1);\n    }\n    drainList(wadd(h, FL_ARRAY), wadd(wadd(h, FL_N), 72));\n    c = 0;\n    while (c <= 16) {\n      const q = wadd(wadd(h, SB), shl(c, 4));\n      drainList(q, wadd(q, 8));\n      c = wadd(c, 1);\n    }\n  }\n  plat(PL_RUNTIME_LOCK, 0, 0, 0);\n  const live = hook(HK_FOLD_LIVE, 0, 0, 0);\n  store64(live, wadd(load64(live), load64(wadd(h, LIVE))));\n  const g = hook(HK_FOLD_STATS, 0, 0, 0);\n  let i: usize = 0;\n  while (i < 18) {\n    const o = shl(i, 3);\n    const a = load64(wadd(g, o));\n    const b = load64(wadd(wadd(h, S_ALLOC_STRING), o));\n    if (i == 10 || i == 11) {\n      store64(wadd(g, o), b > a ? b : a);\n    } else {\n      store64(wadd(g, o), wadd(a, b));\n    }\n    i = wadd(i, 1);\n  }\n  if (cfg(2) == 1) {\n    hook(HK_SITE_FOLD, 0, 0, 0);\n  }\n  plat(PL_RUNTIME_UNLOCK, 0, 0, 0);\n}\n\n// The task `t` is over (its heap is gone): publish it for a timed join (`watch`): word 1 of the monitor becomes 1 and queue 0 is notified.\n// Only L0 calls, no check of their results (as before); the joiner frees the monitor after the join.\nfunction signalDone(t: usize): void {\n  const m = load64(wadd(t, T_DONE));\n  if (m != 0) {\n    plat(PL_MONITOR_LOCK, m, 0, 0);\n    plat(PL_MONITOR_SET, m, 1, 1);\n    plat(PL_MONITOR_NOTIFY, m, 0, 1);\n    plat(PL_MONITOR_UNLOCK, m, 0, 0);\n  }\n}\n\n// ---------------------------------------------------------------- spawn, main, join\n\n// Start a task that runs the body in the transfer box `tok` (a `Box<() => void>` published by std:task). Returns the thread handle.\nexport function spawn(tok: usize): usize {\n  const t = memAlloc(TASK_SIZE);\n  store64(wadd(t, T_TOK), tok);\n  store64(wadd(t, T_TRAPPED), 0);\n  store64(wadd(t, T_DONE), 0);\n  store8(wadd(t, T_MSG), 0);\n  store64(wadd(t, T_PARENT), load64(wadd(heapBase(), H_TASK)));\n  store64(wadd(t, T_SCOPE), plat(PL_WAKE_BOUND, 0, 0, 0));\n  store64(wadd(t, T_KILL), 0);\n  store64(wadd(t, T_SEQ), 0);\n  store64(wadd(t, T_FLAGS), 0);\n  store64(wadd(t, T_WAITING), 0);\n  const nd = memAlloc(NODE_SIZE);\n  const h = plat(PL_THREAD_CREATE, fnAddr(E_TASK_MAIN), t, 0);\n  if (h == 0) {\n    memFree(t);\n    memFree(nd);\n    transitDrop(tok);\n    taskTrap(\"cannot start a task (thread limit reached)\");\n  }\n  store64(wadd(nd, N_NEXT), 0);\n  store64(wadd(nd, N_HANDLE), h);\n  store64(wadd(nd, N_REC), t);\n  const hb = heapBase();\n  const tail = load64(wadd(hb, H_CHILDREN_TAIL));\n  if (tail == 0) {\n    store64(wadd(hb, H_CHILDREN), nd);\n  } else {\n    store64(wadd(tail, N_NEXT), nd);\n  }\n  store64(wadd(hb, H_CHILDREN_TAIL), nd);\n  addAt(wadd(hb, S_TASKS_SPAWNED), 1);\n  return h;\n}\n\n// Take the node of the thread `h` out of the registry (when it is there) and free it.\nfunction unregister(h: usize): void {\n  const hb = heapBase();\n  let prev: usize = 0;\n  let n = load64(wadd(hb, H_CHILDREN));\n  while (n != 0 && load64(wadd(n, N_HANDLE)) != h) {\n    prev = n;\n    n = load64(wadd(n, N_NEXT));\n  }\n  if (n != 0) {\n    const next = load64(wadd(n, N_NEXT));\n    if (prev == 0) {\n      store64(wadd(hb, H_CHILDREN), next);\n    } else {\n      store64(wadd(prev, N_NEXT), next);\n    }\n    if (next == 0) {\n      store64(wadd(hb, H_CHILDREN_TAIL), prev);\n    }\n    memFree(n);\n  }\n}\n\n// Claim the body and run it. A function of its own so that the box (and the closure it holds) is released before the heap retires.\nfunction run(tok: usize): void {\n  const b: TaskBox = transitTake(tok);\n  b.v();\n}\n\n// The thread entry (the C-ABI wrapper `orin_task_main`, `fnAddr`): `t` is the record `spawn` made. The body runs with the record\n// published in the heap block (`trap` finds it there); at the end the heap retires and the end is signalled. The block word is cleared\n// before the retire, so a trap inside the retire is a trap of a thread that is not a task (an exit), never a second retire.\nexport function main(t: usize): void {\n  store64(wadd(heapBase(), H_TASK), t);\n  run(load64(wadd(t, T_TOK)));\n  store64(wadd(heapBase(), H_TASK), 0);\n  heapRetire();\n  signalDone(t);\n}\n\n// Wait for the task of handle `h` to end. 0: it returned; 1: it trapped (its message is kept for `message`). The record of the task\n// joined before is freed here; this one is freed at the next join or when this thread's heap retires.\nexport function join(h: usize): usize {\n  const s = wadd(heapBase(), H_SCRATCH);\n  store64(s, 0);\n  if (plat(PL_THREAD_JOIN, h, s, 0) != 0) {\n    taskTrap(\"invalid task handle (joined twice, or forged)\");\n  }\n  const t = load64(s);\n  unregister(h);\n  const prev = load64(wadd(heapBase(), H_JOINED));\n  if (prev != 0) {\n    memFree(prev);\n  }\n  store64(wadd(heapBase(), H_JOINED), t);\n  const trapped = load64(wadd(t, T_TRAPPED));\n  if (trapped != 0) {\n    primaryFirst(t);\n  }\n  return trapped;\n}\n\n// The trap message of the task joined last by this thread, as a new string (empty when the task did not trap).\nexport function message(): usize {\n  const t = load64(wadd(heapBase(), H_JOINED));\n  let n: usize = 0;\n  if (t != 0) {\n    while (n < MSG_MAX && load8(wadd(wadd(t, T_MSG), n)) != 0) {\n      n = wadd(n, 1);\n    }\n  }\n  const s = strAlloc(n, n);\n  if (n != 0) {\n    memCopy(wadd(s, 32), wadd(t, T_MSG), n);\n  }\n  return s;\n}\n\n// Called by a task on its own thread (std:task `spawn`): word 1 of monitor `m` becomes 1 and queue 0 is notified when the task ends.\nexport function watch(m: usize): void {\n  const t = load64(wadd(heapBase(), H_TASK));\n  if (t != 0) {\n    store64(wadd(t, T_DONE), m);\n  }\n}\n\n// ---------------------------------------------------------------- cleanup after a trap (C2)\n\n// The task `t` or an ancestor of it trapped (or was cancelled by a trap), or the main thread is trapping. Under the runtime lock.\nfunction isDoomed(t: usize): bool {\n  let x = t;\n  while (x != 0) {\n    if (load64(wadd(x, T_KILL)) != 0) {\n      return true;\n    }\n    x = load64(wadd(x, T_PARENT));\n  }\n  return load64(wadd(sharedBase(), SH_MAIN_DOOMED)) != 0;\n}\n\n// The number of bytes before the NUL of the message of the record `t`.\nfunction msgLen(t: usize): usize {\n  let n: usize = 0;\n  while (n < 479 && load8(wadd(wadd(t, T_MSG), n)) != 0) {\n    n = wadd(n, 1);\n  }\n  return n;\n}\n\n// Append `n` bytes at `p` to the message of the record `t` (cut at 479 bytes).\nfunction msgAppend(t: usize, p: usize, n: usize): void {\n  const at = msgLen(t);\n  let k = n;\n  if (wadd(at, k) > 479) {\n    k = 479 - at;\n  }\n  if (k != 0) {\n    memCopy(wadd(wadd(t, T_MSG), at), p, k);\n  }\n  store8(wadd(wadd(t, T_MSG), wadd(at, k)), 0);\n}\n\n// Append the Orin string `s` to the message of the record `t`.\nfunction msgAppendStr(t: usize, s: usize): void {\n  msgAppend(t, wadd(s, 32), load64(wadd(s, 16)));\n}\n\n// The task `t` is blocked in monitor `m`, queue `c`: enter it in the list of waiting tasks. Under the runtime lock.\nfunction waitRegister(t: usize, m: usize, c: usize): void {\n  const sh = sharedBase();\n  const head = load64(wadd(sh, SH_WAITERS));\n  store64(wadd(t, T_WM), m);\n  store64(wadd(t, T_WQ), c);\n  store64(wadd(t, T_POKED), 0);\n  store64(wadd(t, T_WNEXT), head);\n  store64(wadd(t, T_WPREV), 0);\n  if (head != 0) {\n    store64(wadd(head, T_WPREV), t);\n  }\n  store64(wadd(sh, SH_WAITERS), t);\n  store64(wadd(t, T_WAITING), 1);\n}\n\n// Take the task `t` out of the list of waiting tasks (when it is in it). Under the runtime lock.\nfunction waitUnregister(t: usize): void {\n  if (load64(wadd(t, T_WAITING)) != 0) {\n    const p = load64(wadd(t, T_WPREV));\n    const n = load64(wadd(t, T_WNEXT));\n    if (p == 0) {\n      store64(wadd(sharedBase(), SH_WAITERS), n);\n    } else {\n      store64(wadd(p, T_WNEXT), n);\n    }\n    if (n != 0) {\n      store64(wadd(n, T_WPREV), p);\n    }\n    store64(wadd(t, T_WAITING), 0);\n  }\n}\n\n// The calling task ends because an ancestor trapped (its wait in the locked monitor `m` is abandoned: `m` is unlocked first). It is not a\n// failure of its own: flag T_FLAGS, no rank in the order of traps, its scope is not cancelled (the trap of the ancestor cancels it anyway).\nfunction dieDoomed(m: usize): void {\n  if (m != 0) {\n    plat(PL_MONITOR_UNLOCK, m, 0, 0);\n  }\n  const t = load64(wadd(heapBase(), H_TASK));\n  store64(wadd(heapBase(), H_TASK), 0);\n  store64(wadd(heapBase(), H_TRAPPING), 1);\n  const msg = \"task cancelled: a task that started it trapped\";\n  store8(wadd(t, T_MSG), 0);\n  msgAppendStr(t, addrOf(msg));\n  store64(wadd(t, T_TRAPPED), 1);\n  store64(wadd(t, T_FLAGS), 1);\n  unwindChildren(t);\n  heapRetire();\n  signalDone(t);\n  plat(PL_THREAD_EXIT, 0, 0, 0);\n}\n\n// Called by `monWait` / `monWaitUntil` (sync.or) with the monitor `m` locked, before the L0 wait: a task whose ancestor trapped ends here;\n// any other task registers itself as waiting in `m`, queue `c`, so that the cleanup of a trapping ancestor can wake it.\nexport function waitBegin(m: usize, c: usize): void {\n  const t = load64(wadd(heapBase(), H_TASK));\n  if (t != 0) {\n    plat(PL_RUNTIME_LOCK, 0, 0, 0);\n    const d = isDoomed(t);\n    if (!d) {\n      waitRegister(t, m, c);\n    }\n    plat(PL_RUNTIME_UNLOCK, 0, 0, 0);\n    if (d) {\n      dieDoomed(m);\n    }\n  }\n}\n\n// Called after the L0 wait (`m` locked again): leave the list of waiting tasks; a task whose ancestor trapped meanwhile ends here.\nexport function waitEnd(m: usize): void {\n  const t = load64(wadd(heapBase(), H_TASK));\n  if (t != 0) {\n    plat(PL_RUNTIME_LOCK, 0, 0, 0);\n    waitUnregister(t);\n    const d = isDoomed(t);\n    plat(PL_RUNTIME_UNLOCK, 0, 0, 0);\n    if (d) {\n      dieDoomed(m);\n    }\n  }\n}\n\n// The task `t` (0 = the main thread) is trapping: doom its descendants and wake those that wait in a monitor, so that they end.\nfunction doom(t: usize): void {\n  const sh = sharedBase();\n  plat(PL_RUNTIME_LOCK, 0, 0, 0);\n  if (t != 0) {\n    store64(wadd(t, T_KILL), 1);\n  } else {\n    store64(wadd(sh, SH_MAIN_DOOMED), 1);\n  }\n  plat(PL_RUNTIME_UNLOCK, 0, 0, 0);\n  let more = true;\n  while (more) {\n    plat(PL_RUNTIME_LOCK, 0, 0, 0);\n    let w = load64(wadd(sh, SH_WAITERS));\n    let found: usize = 0;\n    while (w != 0 && found == 0) {\n      if (load64(wadd(w, T_POKED)) == 0 && isDoomed(w)) {\n        found = w;\n      } else {\n        w = load64(wadd(w, T_WNEXT));\n      }\n    }\n    let m: usize = 0;\n    let q: usize = 0;\n    if (found != 0) {\n      store64(wadd(found, T_POKED), 1);\n      m = load64(wadd(found, T_WM));\n      q = load64(wadd(found, T_WQ));\n    }\n    plat(PL_RUNTIME_UNLOCK, 0, 0, 0);\n    if (found != 0) {\n      // the waiter holds `m` until it sleeps, so the notification cannot get lost between its test and its wait; results ignored\n      plat(PL_MONITOR_LOCK, m, 0, 0);\n      plat(PL_MONITOR_NOTIFY, m, q, 1);\n      plat(PL_MONITOR_UNLOCK, m, 0, 0);\n    } else {\n      more = false;\n    }\n  }\n}\n\n// A child of the trapping thread `t` (0 = the main thread) trapped on its own while it was being unwound: a secondary failure, appended to\n// the message of `t` or, on the main thread, written as a line of its own after the primary one.\nfunction secondary(t: usize, r: usize): void {\n  const pre = \"also trapped while cleaning up: \";\n  const pl = load64(wadd(addrOf(pre), 16));\n  if (t != 0) {\n    const at = msgLen(t);\n    if (at < 479) {\n      store8(wadd(wadd(t, T_MSG), at), 10);\n      store8(wadd(wadd(t, T_MSG), at + 1), 0);\n    }\n    msgAppendStr(t, addrOf(pre));\n    msgAppend(t, wadd(r, T_MSG), msgLen(r));\n  } else {\n    const b = wadd(sharedBase(), TRAPLINE);\n    memCopy(b, wadd(addrOf(pre), 32), pl);\n    const n = msgLen(r);\n    memCopy(wadd(b, pl), wadd(r, T_MSG), n);\n    plat(PL_WRITE_LINE, 2, b, wadd(pl, n));\n  }\n}\n\n// Cancel and join every child of the calling thread that is still in its registry. `t` is the record of this thread (0 = main).\nfunction unwindChildren(t: usize): void {\n  doom(t);\n  const hb = heapBase();\n  let n = load64(wadd(hb, H_CHILDREN));\n  while (n != 0) {\n    const tok = load64(wadd(load64(wadd(n, N_REC)), T_SCOPE));\n    if (tok != 0) {\n      plat(PL_WAKE_SIGNAL, tok, 0, 0);\n    }\n    n = load64(wadd(n, N_NEXT));\n  }\n  n = load64(wadd(hb, H_CHILDREN));\n  while (n != 0) {\n    const next = load64(wadd(n, N_NEXT));\n    store64(wadd(hb, H_CHILDREN), next);\n    if (next == 0) {\n      store64(wadd(hb, H_CHILDREN_TAIL), 0);\n    }\n    const s = wadd(hb, H_SCRATCH);\n    store64(s, 0);\n    plat(PL_THREAD_JOIN, load64(wadd(n, N_HANDLE)), s, 0);\n    const r = load64(s);\n    if (r != 0) {\n      if (load64(wadd(r, T_TRAPPED)) != 0 && load64(wadd(r, T_FLAGS)) == 0) {\n        secondary(t, r);\n      }\n      memFree(r);\n    }\n    memFree(n);\n    n = next;\n  }\n}\n\n// The task `t` publishes its trap: its rank among the traps (under the runtime lock), after its message is final.\nfunction publish(t: usize): void {\n  const sh = sharedBase();\n  plat(PL_RUNTIME_LOCK, 0, 0, 0);\n  const k = wadd(load64(wadd(sh, SH_TRAP_SEQ)), 1);\n  store64(wadd(sh, SH_TRAP_SEQ), k);\n  store64(wadd(t, T_SEQ), k);\n  plat(PL_RUNTIME_UNLOCK, 0, 0, 0);\n}\n\n// The record `t`, just joined by this thread, trapped. If a task of the same scope that this thread has not joined yet trapped before it,\n// that is the primary failure: the message of `t` becomes its message, followed by the message of `t` as a secondary one.\nfunction primaryFirst(t: usize): void {\n  const tseq = load64(wadd(t, T_SEQ));\n  if (tseq != 0) {\n    plat(PL_RUNTIME_LOCK, 0, 0, 0);\n    let best: usize = 0;\n    let bestSeq = tseq;\n    let n = load64(wadd(heapBase(), H_CHILDREN));\n    while (n != 0) {\n      const r = load64(wadd(n, N_REC));\n      const q = load64(wadd(r, T_SEQ));\n      if (q != 0 && q < bestSeq && load64(wadd(r, T_SCOPE)) == load64(wadd(t, T_SCOPE))) {\n        best = r;\n        bestSeq = q;\n      }\n      n = load64(wadd(n, N_NEXT));\n    }\n    if (best != 0) {\n      const pre = \"\\nalso trapped: \";\n      const pl = load64(wadd(addrOf(pre), 16));\n      const pm = msgLen(best);\n      const off = wadd(pm, pl);\n      let keep = msgLen(t);\n      if (wadd(off, keep) > 479) {\n        keep = off < 479 ? 479 - off : 0;\n      }\n      let end = pm;\n      if (keep != 0) {\n        memMove(wadd(wadd(t, T_MSG), off), wadd(t, T_MSG), keep);\n        memCopy(wadd(wadd(t, T_MSG), pm), wadd(addrOf(pre), 32), pl);\n        end = wadd(off, keep);\n      }\n      memCopy(wadd(t, T_MSG), wadd(best, T_MSG), pm);\n      store8(wadd(wadd(t, T_MSG), end), 0);\n    }\n    plat(PL_RUNTIME_UNLOCK, 0, 0, 0);\n  }\n}\n\n// ---------------------------------------------------------------- the trap\n\n// End the program or the task with the message at `p`: its length is the number of bytes before the first NUL, at most `limit`. On a\n// task thread (the heap block names a record) the message goes into the record, the scope of the task is cancelled, the children are\n// cancelled and joined (C2), the heap retires, the end is signalled and the thread exits; the joiner traps with the message. On the main\n// thread `trap: <message>` is written to stderr (one line, the buffer is in the shared block: no allocation), the children are\n// cancelled and joined, and the process exits with status 101. A trap inside the cleanup is an exit. Never returns.\nfunction trapAt(p: usize, limit: usize): void {\n  let n: usize = 0;\n  while (n < limit && load8(wadd(p, n)) != 0) {\n    n = wadd(n, 1);\n  }\n  const t = load64(wadd(heapBase(), H_TASK));\n  if (t != 0) {\n    if (n > 479) {\n      n = 479;\n    }\n    if (n != 0) {\n      memCopy(wadd(t, T_MSG), p, n);\n    }\n    store8(wadd(wadd(t, T_MSG), n), 0);\n    store64(wadd(t, T_TRAPPED), 1);\n    store64(wadd(heapBase(), H_TASK), 0);\n    store64(wadd(heapBase(), H_TRAPPING), 1);\n    unwindChildren(t);\n    publish(t);\n    const tok = load64(wadd(t, T_SCOPE)); // after the rank: a sibling that traps because of this trap ranks after it\n    if (tok != 0) {\n      plat(PL_WAKE_SIGNAL, tok, 0, 0);\n    }\n    heapRetire();\n    signalDone(t);\n    plat(PL_THREAD_EXIT, 0, 0, 0);\n  }\n  const b = wadd(sharedBase(), TRAPLINE);\n  const pre = \"trap: \";\n  memCopy(b, wadd(addrOf(pre), 32), 6);\n  if (n != 0) {\n    memCopy(wadd(b, 6), p, n);\n  }\n  plat(PL_WRITE_LINE, 2, b, wadd(6, n));\n  if (load64(wadd(heapBase(), H_TRAPPING)) == 0) {\n    store64(wadd(heapBase(), H_TRAPPING), 1);\n    unwindChildren(0);\n  }\n  plat(PL_EXIT, 101, 0, 0);\n}\n\n// `orin_trap(msg)`: `msg` is a C string. Every checked failure of generated code and of the runtime ends here.\nexport function trap(msg: usize): void {\n  trapAt(msg, MSG_MAX);\n}\n\n// `std:task`'s `taskTrap(msg)`: the trap with the Orin string `msg` (cut to 479 bytes, and at a NUL byte, as the C function did).\nexport function trapStr(msg: usize): void {\n  const len = load64(wadd(msg, 16));\n  trapAt(wadd(msg, 32), len > 479 ? 479 : len);\n}\n" });
  out.push(SourceFile { path: "$rt/transfer.or", text: "// $rt/transfer -- the transfer of values between task heaps, written in Orin (ADR-0052 Addendum B, step R3e.2).\n//\n// A transfer moves a value from one task to another: `put` detaches the value of a one-slot box the sender has just built and\n// publishes it in the slot table (a value in flight, owned by nobody) and returns a token; `take` claims the slot and hands the\n// receiver the box; `drop` ends a value in flight (frees it) or a lend (restores the counts it pinned, see lend.or). The value is\n// moved when every reference in its graph is the only one, deep-copied otherwise, so the receiver always gets a graph no other\n// task can reach; reference counts therefore stay non-atomic. `count` gives the moves and copies of this task (ORIN_STATS).\n// std:task reaches these through `BTask(9, 10, 11, 16)`; the backends call them in place of the C functions `orin_rt_transfer_put`,\n// `orin_rt_transfer_take`, `orin_rt_transfer_drop` and `orin_rt_transfer_count` (mir/rt.or `l1Task`), which stay in the live runtime\n// until R3e.6 (the C task code still uses them) and in the frozen snapshot for the seed. An object is its address as a `usize`.\n//\n// The slot table lives in the shared block (`sharedBase()`, words 0..3: pointer, n, cap, free head) and is read and written only\n// between the runtime lock and its release, so the C functions and these share one table. A slot is 32 bytes: box@0 (0 = free),\n// gen@8 (u32), next@12 (u32, the free list, 1-based), pins@16, npins@24. A slot with `pins` != 0 is a LEND (lend.or); a value in\n// flight has pins 0. A token is `gen << 32 | (index + 1)`; the generation makes a token that was taken, dropped or forged invalid.\n// No trap happens with the lock held, and no allocation either except in `publish` (which allocates before it takes the lock).\n//\n// Every walk over a graph is iterative with a work stack from `memAlloc` (an object graph can be a list 200,000 deep). The\n// layout is the frozen one (heap.or): rc@0 kind@8 tag@12; string len@16 cap@24 data@32; array len@16 cap@24 is_ref@32 items@40;\n// struct nslots@16 refmask@24 slots@32; kinds string 1, array 2, struct 3. A count of 0 or below is an immortal object or one\n// pinned by a lend: neither is counted. A pinned object has the top two bits 10, the owner's thread id in bits 32..61 and its\n// count below (docs/concurrency.md, \"lending\").\n\nimport { load32, load64, store32, store64, memAlloc, memFree, memCopy, memRealloc, heapBase, sharedBase, plat, wadd, wsub, shl, shr, and, or } from \"std:core\";\nimport { taskTrap } from \"std:fsraw\";\nimport { PL_RUNTIME_LOCK, PL_RUNTIME_UNLOCK, PL_THREAD_ID } from \"./plat\";\nimport { S_TRANSFER_MOVES, S_TRANSFER_COPIES, addAt } from \"./heap\";\nimport { structNew, arrayNew, strAlloc } from \"./object\";\nimport { retain, release } from \"./rc\";\nimport { trapShape } from \"./leaf\";\n\nconst T_PTR: usize = 0;            // the words of the shared block: the slot table, its slots in use, its capacity, the free head\nconst T_N: usize = 8;\nconst T_CAP: usize = 16;\nconst T_FREE: usize = 24;\nconst SLOT_SHIFT: usize = 5;       // a slot is 32 bytes\nconst SIGN: usize = 9223372036854775808;\nconst LOW32: usize = 4294967295;\nexport const PIN_TAG: usize = 9223372036854775808;\nexport const TID_LIMIT: usize = 1073741824;\n\n@Inline\nfunction lock(): void {\n  plat(PL_RUNTIME_LOCK, 0, 0, 0);\n}\n\n@Inline\nfunction unlock(): void {\n  plat(PL_RUNTIME_UNLOCK, 0, 0, 0);\n}\n\n// ---------------------------------------------------------------- pins (the count of an object lent by a task, lend.or)\n\n// True when the count `rc` is negative as a signed number (an immortal or a pinned object).\n@Inline\nexport function isNeg(rc: usize): bool {\n  return rc >= SIGN;\n}\n\n// True when a negative count belongs to an object pinned by another task than `tid`: copied by a transfer, never shared.\n@Inline\nfunction pinnedForeign(rc: usize, tid: usize): bool {\n  return shr(rc, 62) == 2 && and(shr(rc, 32), 1073741823) != tid;\n}\n\n// ---------------------------------------------------------------- the slot table\n\n// The slot of token `tok` (the runtime lock is held), 0 when the token is not valid: taken or dropped already, never issued, forged.\nfunction lookup(tok: usize): usize {\n  const sh = sharedBase();\n  const i = and(wsub(tok, 1), LOW32);\n  if (tok == 0 || i >= load64(wadd(sh, T_N))) {\n    return 0;\n  }\n  const s = wadd(load64(wadd(sh, T_PTR)), shl(i, SLOT_SHIFT));\n  if (load64(s) == 0 || load32(wadd(s, 8)) != shr(tok, 32)) {\n    return 0;\n  }\n  return s;\n}\n\n// Release the slot `s` (the lock is held) to the free list.\nfunction freeSlot(s: usize): void {\n  const sh = sharedBase();\n  const i = shr(wsub(s, load64(wadd(sh, T_PTR))), SLOT_SHIFT);\n  store64(s, 0);\n  store64(wadd(s, 16), 0);\n  store64(wadd(s, 24), 0);\n  store32(wadd(s, 12), load64(wadd(sh, T_FREE)));\n  store64(wadd(sh, T_FREE), wadd(i, 1));\n}\n\n// The trap for a token that is not valid, with the lock released first.\nfunction badToken(): void {\n  unlock();\n  taskTrap(\"invalid transfer token (taken twice, dropped, or forged)\");\n}\n\n// Publish `box` in a free slot: a value in flight when `pins` is 0, else a lend that pinned the `npins` objects at `pins`. Returns the\n// token. The table grows by doubling (256 slots at first); the new table is allocated before the lock is taken, so a failed allocation\n// traps without the lock held.\nexport function publish(box: usize, pins: usize, npins: usize): usize {\n  const sh = sharedBase();\n  lock();\n  while (load64(wadd(sh, T_FREE)) == 0 && load64(wadd(sh, T_N)) == load64(wadd(sh, T_CAP))) {\n    const cap = load64(wadd(sh, T_CAP));\n    unlock();\n    const ncap = cap != 0 ? shl(cap, 1) : 256;\n    const t = memAlloc(shl(ncap, SLOT_SHIFT));\n    lock();\n    if (load64(wadd(sh, T_CAP)) == cap) {\n      const old = load64(wadd(sh, T_PTR));\n      if (old != 0) {\n        memCopy(t, old, shl(load64(wadd(sh, T_N)), SLOT_SHIFT));\n        memFree(old);\n      }\n      store64(wadd(sh, T_PTR), t);\n      store64(wadd(sh, T_CAP), ncap);\n    } else {\n      memFree(t);\n    }\n  }\n  let s: usize = 0;\n  const f = load64(wadd(sh, T_FREE));\n  if (f != 0) {\n    s = wadd(load64(wadd(sh, T_PTR)), shl(wsub(f, 1), SLOT_SHIFT));\n    store64(wadd(sh, T_FREE), load32(wadd(s, 12)));\n  } else {\n    const n = load64(wadd(sh, T_N));\n    s = wadd(load64(wadd(sh, T_PTR)), shl(n, SLOT_SHIFT));\n    store64(wadd(sh, T_N), wadd(n, 1));\n    store32(wadd(s, 8), 0);\n  }\n  const gen = and(wadd(load32(wadd(s, 8)), 1), LOW32);\n  store64(s, box);\n  store32(wadd(s, 8), gen);\n  store64(wadd(s, 16), pins);\n  store64(wadd(s, 24), npins);\n  const tok = or(shl(gen, 32), wadd(shr(wsub(s, load64(wadd(sh, T_PTR))), SLOT_SHIFT), 1));\n  unlock();\n  return tok;\n}\n\n// ---------------------------------------------------------------- uniqueness and copying\n\n// The children of the object `x` as (first slot address, count, all slots are references): the slots of a struct, the items of a\n// reference array, nothing for a string or a value array. The result is the count, `first` and `mask` are read back from the object\n// by the caller (see the loops below), so that no pair of values has to be returned.\n@Inline\nfunction childCount(x: usize): usize {\n  const kind = load32(wadd(x, 8));\n  if (kind == 3) {\n    return load32(wadd(x, 16));\n  }\n  if (kind == 2 && load64(wadd(x, 32)) != 0) {\n    return load64(wadd(x, 16));\n  }\n  return 0;\n}\n\n// Is every object reachable from `root` referenced exactly once (immortals excepted)? Then the graph has no other owner in this task\n// and can change hands without copying. An object pinned by another task makes the answer no (it is copied, never shared).\n// Iterative: a long list cannot overflow the stack.\nfunction graphUnique(root: usize, tid: usize): bool {\n  if (load64(root) != 1) {\n    return false;\n  }\n  let cap: usize = 64;\n  let sp: usize = 1;\n  let st = memAlloc(shl(cap, 3));\n  store64(st, root);\n  let ok = true;\n  while (sp != 0 && ok) {\n    sp = wsub(sp, 1);\n    const x = load64(wadd(st, shl(sp, 3)));\n    const n = childCount(x);\n    const isArr = load32(wadd(x, 8)) == 2;\n    const mask = isArr ? 0 : load64(wadd(x, 24));\n    const items = isArr ? load64(wadd(x, 40)) : wadd(x, 32);\n    let i: usize = 0;\n    while (i < n && ok) {\n      if (isArr || and(shr(mask, i), 1) == 1) {\n        const c = load64(wadd(items, shl(i, 3)));\n        if (c != 0) {\n          const rc = load64(c);\n          if (isNeg(rc)) {\n            if (pinnedForeign(rc, tid)) {\n              ok = false;\n            }\n          } else if (rc != 1) {\n            ok = false;\n          } else {\n            if (sp == cap) {\n              cap = shl(cap, 1);\n              st = memRealloc(st, shl(cap, 3));\n            }\n            store64(wadd(st, shl(sp, 3)), c);\n            sp = wadd(sp, 1);\n          }\n        }\n      }\n      i = wadd(i, 1);\n    }\n  }\n  memFree(st);\n  return ok;\n}\n\n// Queue the copy of the child `c` into the slot at `dst` (a slot of the copy being built), or store `c` as it is when it is null, an\n// immortal object or one pinned by this very task (shared, not counted). `jobs` is the buffer of (destination, source) pairs and `n` its\n// fill; the caller has made room (`cap` is its capacity); the new fill is returned.\n@Inline\nfunction queue(jobs: usize, n: usize, cap: usize, dst: usize, c: usize, tid: usize): usize {\n  if (c != 0) {\n    const rc = load64(c);\n    if (!isNeg(rc) || pinnedForeign(rc, tid)) {\n      store64(wadd(jobs, shl(n, 4)), dst);\n      store64(wadd(wadd(jobs, shl(n, 4)), 8), c);\n      return wadd(n, 1);\n    }\n  }\n  store64(dst, c);\n  return n;\n}\n\n// Deep copy of the graph at `root`: a string is copied byte for byte, a value array and the scalar slots of a struct as words, each\n// reference slot gets its own copy of the child (a job). Children of immortal or own-pinned objects are shared. Iterative.\nfunction deepCopy(root: usize, tid: usize): usize {\n  const cell = memAlloc(8);\n  let cap: usize = 64;\n  let jobs = memAlloc(shl(cap, 4));\n  store64(jobs, cell);\n  store64(wadd(jobs, 8), root);\n  let n: usize = 1;\n  while (n != 0) {\n    n = wsub(n, 1);\n    const dst = load64(wadd(jobs, shl(n, 4)));\n    const x = load64(wadd(wadd(jobs, shl(n, 4)), 8));\n    const kind = load32(wadd(x, 8));\n    let r: usize = 0;\n    if (kind == 1) {\n      const len = load64(wadd(x, 16));\n      r = strAlloc(len, len);\n      if (len != 0) {\n        memCopy(wadd(r, 32), wadd(x, 32), len);\n      }\n    } else if (kind == 2) {\n      const len = load64(wadd(x, 16));\n      const isRef = load64(wadd(x, 32));\n      r = arrayNew(len, isRef);\n      store64(wadd(r, 16), len);\n      if (isRef == 0) {\n        if (len != 0) {\n          memCopy(load64(wadd(r, 40)), load64(wadd(x, 40)), shl(len, 3));\n        }\n      } else {\n        if (wadd(n, len) > cap) {\n          cap = shl(wadd(n, len), 1);\n          jobs = memRealloc(jobs, shl(cap, 4));\n        }\n        const src = load64(wadd(x, 40));\n        const items = load64(wadd(r, 40));\n        let i: usize = 0;\n        while (i < len) {\n          n = queue(jobs, n, cap, wadd(items, shl(i, 3)), load64(wadd(src, shl(i, 3))), tid);\n          i = wadd(i, 1);\n        }\n      }\n    } else {\n      const ns = load32(wadd(x, 16));\n      const mask = load64(wadd(x, 24));\n      r = structNew(load32(wadd(x, 12)), ns, mask);\n      if (wadd(n, ns) > cap) {\n        cap = shl(wadd(n, ns), 1);\n        jobs = memRealloc(jobs, shl(cap, 4));\n      }\n      let i: usize = 0;\n      while (i < ns) {\n        const v = load64(wadd(wadd(x, 32), shl(i, 3)));\n        if (and(shr(mask, i), 1) == 1) {\n          n = queue(jobs, n, cap, wadd(wadd(r, 32), shl(i, 3)), v, tid);\n        } else {\n          store64(wadd(wadd(r, 32), shl(i, 3)), v);\n        }\n        i = wadd(i, 1);\n      }\n    }\n    store64(dst, r);\n  }\n  const out = load64(cell);\n  memFree(jobs);\n  memFree(cell);\n  return out;\n}\n\n// ---------------------------------------------------------------- the operations of std:task\n\n// Detach the value in `box` (a one-slot record the sender has just built and still owns, or a zero-slot record for a void value)\n// and publish it; returns the token. Moved when every reference in it is the only one, deep-copied otherwise. Either way the\n// receiver gets a graph no other task can reach.\n//\n// Box once: when the box itself is referenced only by the sender (rc == 1, the normal case: std:task builds it right before the call)\n// and its value is a scalar or a uniquely owned graph, the box itself is published: it is retained here (rc 2) and the sender's release\n// that follows the call brings it back to 1, the reference the token owns. No second box is allocated. This relies on the protocol of\n// the only caller, std:task (`putBox`): the sender releases its reference before the token can reach another task (putBox returns the\n// token only after the box died in it, and a token travels only through a monitor or a thread start, both of which order the sender's\n// release before the receiver's take). Otherwise (a shared box, which std:task never passes) a fresh box is built as before.\nexport function put(box: usize): usize {\n  if (load32(wadd(box, 8)) != 3 || load32(wadd(box, 16)) > 1) {\n    trapShape();\n  }\n  const ns = load32(wadd(box, 16));\n  const refmask = load64(wadd(box, 24));\n  const slot0 = ns == 0 ? 0 : load64(wadd(box, 32));\n  // ns == 0: the box of a void value (ADR-0040), nothing to move\n  const scalar = ns == 0 || and(refmask, 1) == 0 || slot0 == 0;\n  const tid = plat(PL_THREAD_ID, 0, 0, 0);\n  if (load64(box) == 1 && (scalar || graphUnique(box, tid))) {\n    retain(box);\n    if (!scalar) {\n      addAt(wadd(heapBase(), S_TRANSFER_MOVES), 1);\n    }\n    return publish(box, 0, 0);\n  }\n  let out: usize = 0;\n  if (scalar) {\n    out = structNew(load32(wadd(box, 12)), ns, refmask);\n    if (ns != 0) {\n      store64(wadd(out, 32), slot0);\n    }\n  } else if (graphUnique(box, tid)) {\n    out = structNew(load32(wadd(box, 12)), 1, refmask);\n    store64(wadd(out, 32), slot0);\n    store64(wadd(box, 32), 0);\n    addAt(wadd(heapBase(), S_TRANSFER_MOVES), 1);\n  } else {\n    out = deepCopy(box, tid);\n    addAt(wadd(heapBase(), S_TRANSFER_COPIES), 1);\n  }\n  return publish(out, 0, 0);\n}\n\n// Claim the value in flight `tok`: the box the sender published, owned by the caller. A token that was taken, dropped or forged traps;\n// so does the token of a lend (a lend is only ended, by `drop`).\nexport function take(tok: usize): usize {\n  lock();\n  const s = lookup(tok);\n  if (s == 0) {\n    badToken();\n  }\n  if (load64(wadd(s, 16)) != 0) {\n    unlock();\n    taskTrap(\"a lent value cannot be taken, only ended\");\n  }\n  const b = load64(s);\n  freeSlot(s);\n  unlock();\n  return b;\n}\n\n// End a value in flight (frees it) or a lend (restores the counts it pinned and releases the lent box). Only the owner holds a lend token.\nexport function drop(tok: usize): void {\n  lock();\n  const s = lookup(tok);\n  if (s == 0) {\n    badToken();\n  }\n  const b = load64(s);\n  const pins = load64(wadd(s, 16));\n  const np = load64(wadd(s, 24));\n  freeSlot(s);\n  unlock();\n  if (pins == 0) {\n    release(b);\n    return;\n  }\n  // a lend: every pinned object gets its own count back (the low 32 bits), then the buffer and the box go\n  let i: usize = 0;\n  while (i < np) {\n    const o = load64(wadd(pins, shl(i, 3)));\n    store64(o, and(load64(o), LOW32));\n    i = wadd(i, 1);\n  }\n  memFree(pins);\n  release(b);\n}\n\n// 0: the values moved by this task so far, 1: the values copied (ORIN_STATS `transfer_moves`, `transfer_copies`).\nexport function count(which: usize): usize {\n  if (which == 0) {\n    return load64(wadd(heapBase(), S_TRANSFER_MOVES));\n  }\n  if (which == 1) {\n    return load64(wadd(heapBase(), S_TRANSFER_COPIES));\n  }\n  return 0;\n}\n" });
  return out;
}
