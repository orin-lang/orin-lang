// Loader output types: the loaded program (units in dependency order) and the outcome of a load.

import { Module, Item, ImportDecl } from "../syntax";
import { SourceFile, SourceMap, Diagnostic, allRenderable, allWellFormed } from "../diag";
import { Manifest } from "../package";
import { isNormalized } from "./path";

// StdFs = "std:fsraw" (internal: the primitives behind std:fs, library/std/fs.or), StdProcess = "std:process", StdClock = "std:clock" (internal; std:time wraps it), StdCore = "std:core" (internal: the core operations, only the `$rt/` modules may import it)
export type ImportTarget = ImportUnit(usize) | ImportStd(StdModule);
export type StdModule = StdFs | StdProcess | StdClock | StdCore;

export type Unit = {
  file: usize; // index into SourceMap.files
  path: string; // normalized path (as opened)
  name: string; // relative to the entry file's directory, "/"-separated, no ".or"
  module: string; // module id: directory of the nearest enclosing `module.or` relative to the src root ("." = root; "" = prelude/outside the src root)
  ast: Module;
  imports: ImportTarget[]; // one per IImport / IReExport item, in item order
};

// units are topologically sorted (dependencies first, entry last); entry = index of entry.
// `manifest` is Some when an orin.toml governs the load (its rules were enforced by the loader).
export type LoadedProgram = { units: Unit[]; entry: usize; manifest: Option<Manifest>; };

// Like a successful load, but also available on failure: `sm` holds every file read so far (so the
// diagnostics can be rendered); `program` is Some exactly when `diags` is empty.
export type LoadOutcome = { sm: SourceMap; program: Option<LoadedProgram>; diags: Diagnostic[]; };

// A failed load: no program, at least one diagnostic, every diagnostic renderable against the files read.
@Requires(diags.length > 0 && allWellFormed(diags))
@Requires(allRenderable(SourceMap { files: files }, diags))
@Ensures(result.program.isNone() && result.diags.length == diags.length)
@Ensures(result.sm.files.length == files.length)
export function failedLoad(files: SourceFile[], diags: Diagnostic[]): LoadOutcome {
  return LoadOutcome { sm: SourceMap { files: files }, program: None, diags: diags };
}

// The import declaration of an `import` / `export ... from` item.
export function importOf(item: Item): Option<ImportDecl> {
  return match (item) {
    IImport(i) => Some(i),
    IReExport(i) => Some(i),
    _ => None,
  };
}

// A plain loop: closures (`filter`) would make the function impure, and contracts may only call pure ones.
@Ensures(result <= m.items.length)
function importCount(m: Module): usize {
  let n: usize = 0;
  for (const it of m.items) {
    if (importOf(it).isSome()) {
      n += 1;
    }
  }
  return n;
}

@Ensures(result.isSome()
    == match (t) {
      ImportUnit(_) => true,
      ImportStd(_) => false,
    })
function importedUnit(t: ImportTarget): Option<usize> {
  return match (t) {
    ImportUnit(i) => Some(i),
    ImportStd(_) => None,
  };
}

// True when `t` is a std import or a unit import below `n` (an index into the units completed so far).
export function targetBelow(t: ImportTarget, n: usize): bool {
  return match (t) {
    ImportUnit(i) => i < n,
    ImportStd(_) => true,
  };
}

// True when `t` is not a unit import of unit `k` or a later one. A unit may only import units that
// were completed before it, which is what makes the unit graph acyclic and the order topological.
function importsEarlier(imports: ImportTarget[], k: usize): bool {
  for (const t of imports) {
    const dep = importedUnit(t);
    if (dep.isSome() && dep.unwrap() >= k) {
      return false;
    }
  }
  return true;
}

// True when every unit imports only earlier units (dependencies first; hence no import cycle).
@Ensures(units.length == 0 ==> result)
export function isTopological(units: Unit[]): bool {
  let k: usize = 0;
  while (k < units.length) {
    if (!importsEarlier(units[k].imports, k)) {
      return false;
    }
    k += 1;
  }
  return true;
}

// True when `file` ids of the units are pairwise distinct and all below `n`.
function fileIdsDistinct(units: Unit[], n: usize): bool {
  let seen: bool[] = [];
  let k: usize = 0;
  while (k < n) {
    seen.push(false);
    k += 1;
  }
  for (const u of units) {
    if (u.file >= n || seen[u.file]) {
      return false;
    }
    seen[u.file] = true;
  }
  return true;
}

// True when no two units have the same path or the same name (names become symbol prefixes later).
export function unitIdsUnique(units: Unit[]): bool {
  let i: usize = 0;
  while (i < units.length) {
    let j: usize = i + 1;
    while (j < units.length) {
      if (units[i].path == units[j].path || units[i].name == units[j].name) {
        return false;
      }
      j += 1;
    }
    i += 1;
  }
  return true;
}

// True when every unit has one import target per import item of its syntax tree.
function importCountsMatch(units: Unit[]): bool {
  for (const u of units) {
    if (u.imports.length != importCount(u.ast)) {
      return false;
    }
  }
  return true;
}

// True when the unit's own fields agree: its path is normalized, a prelude (virtual `$...`) path has
// the empty module id, and the AST belongs to the unit's file.
export function isWellFormedUnit(u: Unit): bool {
  return isNormalized(u.path)
      && (!u.path.startsWith("$") || u.module == "")
      && u.ast.file == u.file;
}

// True when `isWellFormedUnit` holds for every unit.
@Ensures(units.length == 0 ==> result)
export function allUnitsWellFormed(units: Unit[]): bool {
  return units.every(u => isWellFormedUnit(u));
}

// The structural guarantees of a successful load (written with loops so that contracts may call it):
// the units are in one-to-one correspondence with the files of `sm`, the entry is the last unit and
// keeps file id 0, every unit has one import target per import item, every unit import points at an
// *earlier* unit, and paths and names are unique and well-formed.
@Ensures(result ==> p.units.length > 0 && p.entry == p.units.length - 1 && sm.files.length == p.units.length)
export function isWellFormed(p: LoadedProgram, sm: SourceMap): bool {
  const n = p.units.length;
  return n > 0
      && p.entry == n - 1
      && sm.files.length == n
      && p.units[p.entry].file == 0
      && fileIdsDistinct(p.units, n)
      && importCountsMatch(p.units)
      && isTopological(p.units)
      && allUnitsWellFormed(p.units)
      && unitIdsUnique(p.units);
}

// What every load result must satisfy (the contract of all `load*` functions): a program exactly when
// there are no diagnostics, a well-formed program, and diagnostics that can be rendered.
@Ensures(result ==> o.program.isSome() == (o.diags.length == 0))
@Ensures(result ==> allRenderable(o.sm, o.diags))
@Ensures(result && o.program.isSome() ==> isWellFormed(o.program.unwrap(), o.sm))
export function isValidOutcome(o: LoadOutcome): bool {
  return o.program.isSome() == (o.diags.length == 0)
      && allRenderable(o.sm, o.diags)
      && (o.program.isNone() || isWellFormed(o.program.unwrap(), o.sm));
}
