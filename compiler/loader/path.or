// Pure, lexical path utilities (no realpath: `..` is resolved textually). Paths use "/" separators and
// may be absolute ("/a/b") or relative to the current directory ("a/b", "../a").

@Ensures(result == (p.length > 0 && p.charCodeAt(0) == 47))
export function isAbs(p: string): bool {
  return p.length > 0 && p.charCodeAt(0) == 47;
}

// True when every path of `ps` is in the form `normalizePath` produces.
@Ensures(ps.length == 0 ==> result)
@Ensures(result == ps.every(p => isNormalized(p)))
export function allNormalized(ps: string[]): bool {
  return ps.every(p => isNormalized(p));
}

// True when no two strings of `ps` are equal.
@Ensures(ps.length <= 1 ==> result)
export function allDistinct(ps: string[]): bool {
  let i: usize = 0;
  while (i < ps.length) {
    let j: usize = i + 1;
    while (j < ps.length) {
      if (ps[i] == ps[j]) {
        return false;
      }
      j += 1;
    }
    i += 1;
  }
  return true;
}

// Non-empty path segments of `p`, without ".". (A loop, not `filter`: `normalizePath` is called from
// contracts, and a call through a function value would make it impure, E0416.)
function segments(p: string): string[] {
  let out: string[] = [];
  for (const s of p.split("/")) {
    if (s.length > 0 && s != ".") {
      out.push(s);
    }
  }
  return out;
}

// True when `p` is in the form `normalizePath` produces: no empty or "." segments, no trailing "/"
// (except the root "/"), ".." only as leading segments of a relative path, and "." only as the
// whole (empty) relative path. Used by the contracts below.
@Ensures((p == "." || p == "/") ==> result)
@Ensures(p.length == 0 ==> !result)
export function isNormalized(p: string): bool {
  if (p == "." || p == "/") {
    return true;
  }
  if (p.length == 0 || p.endsWith("/")) {
    return false;
  }
  const abs = isAbs(p);
  let named = false;
  for (const s of (abs ? p.substring(1, p.length) : p).split("/")) {
    if (s.length == 0 || s == ".") {
      return false;
    }
    if (s != "..") {
      named = true;
    } else if (abs || named) {
      return false;
    }
  }
  return true;
}

// Resolve "." and ".." lexically and collapse "//". Relative results never start with "./";
// the empty relative path is ".". ".." above the root of an absolute path is dropped.
// Idempotence (`normalizePath(result) == result`) cannot be stated here (a self-call from the
// contract never terminates under --check-contracts); `isNormalized(result)` is its structural form.
@Ensures(isNormalized(result) && isAbs(result) == isAbs(p))
@Ensures(isAbs(result) ==> !result.includes(".."))
@Ensures(result.length <= (p.length > 0 ? p.length : 1))
@Ensures(isNormalized(p) ==> result == p)
export function normalizePath(p: string): string {
  const abs = isAbs(p);
  let out: string[] = [];
  for (const s of segments(p)) {
    if (s != "..") {
      out.push(s);
    } else if (out.length > 0 && out[out.length - 1] != "..") {
      out.pop();
    } else if (!abs) {
      out.push("..");
    }
  }
  const body = out.join("/");
  if (abs) {
    return "/" + body;
  }
  return body.length == 0 ? "." : body;
}

// Directory part of `p` (normalized first): "a/b.or" -> "a", "b.or" -> ".", "/b.or" -> "/".
@Ensures(isNormalized(result) && isAbs(result) == isAbs(p))
@Ensures(result.length <= normalizePath(p).length)
export function dirname(p: string): string {
  const n = normalizePath(p);
  let i: usize = n.length;
  @Invariant(i <= n.length)
  while (i > 0) {
    if (n.charCodeAt(i - 1) == 47) {
      return i == 1 ? "/" : n.substring(0, i - 1);
    }
    i -= 1;
  }
  return ".";
}

// `b` resolved against directory `a` (an absolute `b` wins), normalized.
@Ensures(isNormalized(result))
@Ensures(isAbs(b) ==> result == normalizePath(b))
@Ensures(a.length > 0 ==> isAbs(result) == (isAbs(a) || isAbs(b)))
export function joinPath(a: string, b: string): string {
  return isAbs(b) ? normalizePath(b) : normalizePath(a + "/" + b);
}

function leadingDotDots(s: string[]): usize {
  let k: usize = 0;
  while (k < s.length && s[k] == "..") {
    k += 1;
  }
  return k;
}

// Path of `path` relative to directory `base`, "/"-separated; "." when equal.
// Components outside `base` become leading "../".
@Ensures(isNormalized(result) && !isAbs(result))
@Ensures(normalizePath(base) == normalizePath(path) ==> result == ".")
@Ensures(isAbs(base) && isAbs(path) ==> joinPath(base, result) == normalizePath(path))
export function relativeTo(base: string, path: string): string {
  const b = segments(normalizePath(base));
  const c = segments(normalizePath(path));
  let common: usize = 0;
  @Invariant(common <= b.length && common <= c.length)
  while (common < b.length && common < c.length && b[common] == c[common]) {
    common += 1;
  }
  const parts = b.slice(common, b.length).map(s => "..").concat(c.slice(common, c.length));
  return parts.length == 0 ? "." : parts.join("/");
}

// True when `prefix` is a leading part of `s`.
function startsWithSegments(s: string[], prefix: string[]): bool {
  if (prefix.length > s.length) {
    return false;
  }
  let i: usize = 0;
  while (i < prefix.length) {
    if (prefix[i] != s[i]) {
      return false;
    }
    i += 1;
  }
  return true;
}

// True when `path` equals `dir` or lies below it. A relative `dir` made only of ".." segments
// also contains every relative path with fewer leading ".." (those live deeper in its subtree).
@Ensures(normalizePath(dir) == normalizePath(path) ==> result)
@Ensures(result ==> isAbs(dir) == isAbs(path))
@Ensures(normalizePath(dir) == "/" && isAbs(path) ==> result)
@Ensures(normalizePath(dir) == "." && !isAbs(path) && !normalizePath(path).startsWith("..")
    ==> result)
export function isInside(dir: string, path: string): bool {
  const dn = normalizePath(dir);
  const pn = normalizePath(path);
  if (isAbs(dn) != isAbs(pn)) {
    return false;
  }
  const d = segments(dn);
  const p = segments(pn);
  if (d.length == 0 && !isAbs(dn)) {
    return leadingDotDots(p) == 0;
  }
  if (d.length > p.length) {
    return false;
  }
  if (startsWithSegments(p, d)) {
    return true;
  }
  const k = leadingDotDots(d);
  return !isAbs(dn) && k == d.length && leadingDotDots(p) < k;
}
