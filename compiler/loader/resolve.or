// Import resolution: which file or std module an `import ... from "path"` names, and the module
// boundary rule.

import { Span, Diagnostic, diag } from "../diag";
import { StdModule, LoadedProgram } from "./program";
import { IImport } from "../syntax";
import { parseManifest } from "../package";
import { Sources } from "./sources";
import { FsGrant } from "std:fs";
import { normalizePath, isNormalized, dirname, joinPath, relativeTo, isInside } from "./path";

// An import resolves to a std module implemented by the C runtime (`std` is Some, `path` is empty)
// or to the normalized path of a source file.
@Invariant(this.std.isSome() ==> this.path == "")
@Invariant(this.std.isNone() ==> isNormalized(this.path))
export type Resolved = { std: Option<StdModule>; path: string; };

// `/`-separated path of `p` relative to `base`, without a trailing `.or`. Prelude units (virtual
// paths, see prelude.or) keep their path: their name does not depend on the entry file.
@Requires(isNormalized(base) && isNormalized(p))
@Ensures(p.startsWith("$") ==> p.startsWith(result) && p.length - result.length <= 3)
@Ensures(!p.startsWith("$") ==> !result.startsWith("/"))
export function unitName(base: string, p: string): string {
  const s = p.startsWith("$") ? p : relativeTo(base, p);
  return s.endsWith(".or") ? s.substring(0, s.length - 3) : s;
}

// Std modules written in Orin (library/std/, embedded as the `$stdlib` library root, see prelude.or).
function isStdlibModule(p: string): bool {
  return match (p) {
    "std:fs" => true,
    "std:path" => true,
    "std:json" => true,
    "std:json/number" => true,
    "std:json/decode" => true,
    "std:json/legacy" => true,
    "std:time" => true,
    "std:io" => true,
    "std:graph" => true,
    "std:test" => true,
    "std:host" => true,
    "std:bytes" => true,
    "std:bytes/internal" => true,
    "std:encoding" => true,
    "std:utf8" => true,
    "std:url" => true,
    "std:collections" => true,
    "std:collections/internal" => true,
    "std:http" => true,
    "std:seq" => true,
    "std:task" => true,
    "std:task/internal" => true,
    "std:net" => true,
    "std:net/internal" => true,
    "std:text" => true,
    "std:html" => true,
    "std:ox" => true,
    "std:meta" => true,
    "std:metacore" => true,
    "std:metajson" => true,
    _ => false,
  };
}

// The public module to use instead of the internal std module `p` (ADR-0048 rule 7.3, ADR-0056), or None when `p` is not internal.
// Internal: `std:metacore`, `std:metajson` and every `std:x/internal`.
function publicModuleFor(p: string): Option<string> {
  if (p == "std:metacore" || p == "std:metajson") {
    return Some("std:meta");
  }
  if (p.startsWith("std:") && p.endsWith("/internal")) {
    return Some(p.substring(0, p.length - 9));
  }
  return None;
}

// W0493: a source file outside the std library imports an internal std module. Files whose path starts with `$` (the
// embedded `$stdlib`, `$rt` and `$array` roots) are library code and do not warn; so does no file of the compiler itself,
// which imports none of these modules.
export function internalImportWarnings(prog: LoadedProgram): Diagnostic[] {
  let out: Diagnostic[] = [];
  for (const u of prog.units) {
    if (u.path.startsWith("$")) {
      continue;
    }
    for (const it of u.ast.items) {
      match (it) {
        IImport(d) => {
          const alt = publicModuleFor(d.path);
          if (alt.isSome()) {
            out.push(
              Diagnostic {
                code: "W0493",
                message: `\`${d.path}\` is an internal module; its API may change without notice`,
                span: d.pathSpan,
                notes: [`use \`${alt.unwrap()}\` instead`],
              },
            );
          }
        },
        _ => {},
      }
    }
  }
  return out;
}

// Std modules backed by the C runtime. `std:fsraw` is internal: the file primitives behind `std:fs`
// (library/std/fs.or) and of `std:io` (library/std/io.or); only library code may import it. `std:clock` is internal too (`std:time` wraps it).
// The two tables are disjoint: a module that is in both would resolve to the C runtime silently.
@Ensures(result.isSome() ==> p.startsWith("std:") && !isStdlibModule(p) && p != "std:math" && p != "std:coreprobe")
function runtimeModule(p: string): Option<StdModule> {
  return match (p) {
    "std:fsraw" => Some(StdFs),
    "std:process" => Some(StdProcess),
    "std:clock" => Some(StdClock),
    "std:core" => Some(StdCore),
    _ => None,
  };
}

@Requires(sp.start <= sp.end)
@Ensures(result.code == "E0301" && result.span.start == sp.start && result.span.end == sp.end)
function unknownStd(p: string, sp: Span): Diagnostic {
  return diag(
    "E0301",
    sp,
    `unknown standard module \`${p}\` (available: std:fs, std:process, std:io, std:math, std:path, std:json, std:json/number, std:json/decode, std:json/legacy, std:time, std:graph, std:test, std:host, std:bytes, std:encoding, std:utf8, std:url, std:collections, std:http, std:seq, std:task, std:net, std:text, std:html, std:ox, std:meta, std:metacore, std:metajson)`,
  );
}

// Resolves the imports of one load: knows where files come from (`src`) and the directory of the
// entry file (`base`), which unit names are relative to.
@Invariant(isNormalized(this.base))
export class ImportResolver {
  private src: Sources;
  private base: string;

  @Requires(isNormalized(base))
  constructor(src: Sources, base: string) {
    this.src = src;
    this.base = base;
  }

  // The unit name of the file at normalized path `p` (see `unitName`).
  @Requires(isNormalized(p))
  nameOf(p: string): string {
    return unitName(this.base, p);
  }

  // Resolve import path `p` of file `importer` to a std module or a normalized file path.
  // Reports E0301 (unknown module) and E0302 (module boundary).
  //
  // Postconditions: a source file result is a normalized path ending in `.or` (`$...` for prelude
  // files), a std module result has no path; only a prelude file may import `std:fsraw`; every
  // error is E0301 or E0302 at the span of the import path.
  @Requires(isNormalized(importer) && sp.start <= sp.end)
  @Ensures(!p.startsWith("$") && result.isOk()
      ==> result.unwrap().std.isSome() || result.unwrap().path.endsWith(".or"))
  @Ensures(result.isOk() ==> result.unwrap().std.isSome() == (result.unwrap().path.length == 0))
  @Ensures(result.isOk() ==> result.unwrap().std.isNone() ==> isNormalized(result.unwrap().path))
  @Ensures(result.isOk() && result.unwrap().std.isSome() ==> p.startsWith("std:"))
  @Ensures(p == "std:fsraw" && !importer.startsWith("$") ==> result.isErr())
  @Ensures(p == "std:core" && !importer.startsWith("$rt/") ==> result.isErr())
  @Ensures(p.startsWith("$") ==> result.isOk() && result.unwrap().path == normalizePath(p))
  @Ensures(result.isErr()
      ==> result.unwrapErr().code == "E0301" || result.unwrapErr().code == "E0302")
  @Ensures(result.isErr()
      ==> result.unwrapErr().span.start == sp.start && result.unwrapErr().span.end == sp.end)
  resolve(fs: FsGrant, importer: string, p: string, sp: Span): Result<Resolved, Diagnostic> {
    if (p.startsWith("$")) {
      // The implicit import of a prelude root's entry file (added to the program's entry file by the loader).
      return Ok(Resolved { std: None, path: normalizePath(p) });
    }
    if (p == "std:coreprobe") {
      // std:coreprobe is the self-test of the core operations (runtime/core/coreprobe.or, part of the embedded `$rt` root), loaded on demand.
      return Ok(Resolved { std: None, path: "$rt/coreprobe.or" });
    }
    if (p == "std:math") {
      // std:math is Orin code (library/collections/math.or, part of the embedded `$array` prelude root), loaded on demand.
      return Ok(Resolved { std: None, path: "$array/math.or" });
    }
    if (p.startsWith("std:")) {
      if (isStdlibModule(p)) {
        // `std:x/internal` (ADR-0048 rule 7.3) is the file `x_internal.or`; other submodules (`std:json/number`) live in
        // sub-directories of the library root.
        const id = p.substring(4, p.length);
        const file = id.endsWith("/internal") ? id.split("/").join("_") : id;
        return Ok(Resolved { std: None, path: `$stdlib/${file}.or` });
      }
      const m = runtimeModule(p);
      if (m.isNone() || p == "std:fsraw" && !importer.startsWith("$") || p == "std:core" && !importer.startsWith("$rt/")) {
        return Err(unknownStd(p, sp));
      }
      return Ok(Resolved { std: m, path: "" });
    }
    if (!p.startsWith(".") && !p.startsWith("/")) {
      let root = dirname(importer);
      while (true) {
        const manifestPath = joinPath(root, "orin.toml");
        if (this.src.exists(fs, manifestPath)) {
          const text = this.src.read(fs, manifestPath);
          if (text.isOk()) {
            const parsed = parseManifest(sp.file, text.unwrap());
            if (parsed.isOk()) {
              for (const dep of parsed.unwrap().dependencies) {
                if (dep.name == p) {
                  if (dep.dev && !isInside(joinPath(root, "tests"), importer)) {
                    return Err(
                      diag("E0301", sp, "dev dependency `" + p + "` is only available to tests"),
                    );
                  }
                  const depRoot = dep.path != ""
                      ? joinPath(root, dep.path)
                      : joinPath(root, ".orin/packages/" + dep.name);
                  const target = joinPath(depRoot, "src/module.or");
                  if (!this.src.exists(fs, target)) {
                    return Err(
                      diag(
                        "E0301",
                        sp,
                        "dependency `" + p + "` is unavailable; run `orin fetch` (expected `"
                            + target + "`)",
                      ),
                    );
                  }
                  return Ok(Resolved { std: None, path: target });
                }
              }
            }
          }
          break;
        }
        const parent = dirname(root);
        if (parent == root) {
          break;
        }
        root = parent;
      }
    }
    const dir = dirname(importer);
    const asFile = joinPath(dir, p + ".or");
    const asModule = joinPath(dir, p + "/module.or");
    let target = asFile;
    if (!this.src.exists(fs, asFile)) {
      if (!this.src.exists(fs, asModule)) {
        return Err(
          diag(
            "E0301",
            sp,
            `cannot find module \`${p}\` (tried \`${asFile}\` and \`${asModule}\`)`,
          ),
        );
      }
      target = asModule;
    }
    const blocked = this.privateModuleOf(fs, importer, target);
    if (blocked.isSome()) {
      const owner = blocked.unwrap();
      return Err(
        diag(
          "E0302",
          sp,
          `cannot import private file \`${this.nameOf(target)}\` of module \`${this.nameOf(owner)}\`; import the module itself`,
        ),
      );
    }
    return Ok(Resolved { std: None, path: target });
  }

  // Module boundary rule (E0302): the directory (nearest first) of an ancestor module of `target`
  // whose `module.or` is not `target` itself and which does not contain `importer`; None when the
  // import is allowed. Walks up to the filesystem root, or to the start of a relative path.
  @Requires(isNormalized(importer) && isNormalized(target))
  @Ensures(result.isSome()
      ==> isNormalized(result.unwrap()) && !isInside(result.unwrap(), importer))
  @Ensures(result.isSome() ==> isInside(result.unwrap(), target))
  private privateModuleOf(fs: FsGrant, importer: string, target: string): Option<string> {
    let d = dirname(target);
    while (d != ".") {
      const m = joinPath(d, "module.or");
      if (target != m && this.src.exists(fs, m) && !isInside(d, importer)) {
        return Some(d);
      }
      const parent = dirname(d);
      if (parent == d) {
        break;
      }
      d = parent;
    }
    return None;
  }
}
