// Implicit prelude roots (spec 19 R1; docs/architecture.md "Preludes").
//
// A prelude root is a directory of Orin sources that is compiled into the compiler
// (tools/embed_prelude.py generates `embedded_<name>.or`) and loaded implicitly into every
// program: the loader serves its files through the overlay under virtual paths `$<name>/...` and
// adds an empty import of `entry` to the program's entry file, so its units sort before the entry.
// Unit names of prelude files are their virtual path without `.or` ("$std/strings"); the leading
// `$` is the marker used by lowering and pruning (compiler/lower/prelude.or, compiler/opt/prune.or).
//
// To add a prelude (e.g. the closure / array-API prelude): generate its embedded file, import it
// here and append one PreludeRoot to `preludeRoots()`. Order = load order = unit order.

import { SourceFile } from "../diag";
import { embeddedStdFiles } from "./embedded_std";
import { embeddedArrayFiles } from "./embedded_array";
import { embeddedStdlibFiles } from "./embedded_stdlib";
import { embeddedRtFiles } from "./embedded_rt";
import { isNormalized } from "./path";

// `entry` is "" (a library root) or the virtual path of one of `files`. (Record invariants are not
// checked at run time: `isWellFormedRoot` / `rootsWellFormed` are the checked form, used by the
// contracts of the functions below and of `loadWithRoots`.)
@Invariant(this.entry == "" || isNormalized(this.entry))
export type PreludeRoot = { entry: string; files: SourceFile[]; };

// True when `r` is a usable root: every file has a normalized virtual path (`$name/...`, so that it can
// never collide with a file of the user's program), paths are unique within the root, and a non-empty
// entry names one of the files.
export function isWellFormedRoot(r: PreludeRoot): bool {
  let entryFound = r.entry == "";
  let i: usize = 0;
  while (i < r.files.length) {
    const p = r.files[i].path;
    if (!p.startsWith("$") || !isNormalized(p)) {
      return false;
    }
    if (p == r.entry) {
      entryFound = true;
    }
    let j: usize = i + 1;
    while (j < r.files.length) {
      if (r.files[j].path == p) {
        return false;
      }
      j += 1;
    }
    i += 1;
  }
  return entryFound;
}

// Number of roots that have an entry file (those the entry unit imports implicitly).
export function countEntries(rs: PreludeRoot[]): usize {
  let n: usize = 0;
  for (const r of rs) {
    if (r.entry != "") {
      n += 1;
    }
  }
  return n;
}

// True when every root is well formed and no two roots serve the same virtual path.
@Ensures(rs.length == 0 ==> result)
export function rootsWellFormed(rs: PreludeRoot[]): bool {
  let a: usize = 0;
  @Invariant(a <= rs.length)
  while (a < rs.length) {
    if (!isWellFormedRoot(rs[a])) {
      return false;
    }
    let b: usize = a + 1;
    while (b < rs.length) {
      for (const f of rs[a].files) {
        for (const g of rs[b].files) {
          if (f.path == g.path) {
            return false;
          }
        }
      }
      b += 1;
    }
    a += 1;
  }
  return true;
}

// The array API (closures, ADR-0011): `xs.map(f)` etc. are calls of its functions (check/body.or).
@Ensures(isWellFormedRoot(result) && result.entry != "")
function arrayRoot(): PreludeRoot {
  return PreludeRoot { entry: "$array/module.or", files: embeddedArrayFiles() };
}

// Std modules written in Orin (std:path, std:json (and std:json/number, std:json/decode, std:json/legacy), std:time, std:io, std:graph, std:test, std:bytes, std:utf8, std:url, std:collections, std:http, std:seq, std:task, std:taskcore, std:net, std:text, std:html, std:ox, std:meta): a library root
// without an implicit import (entry ""); the loader resolves `import ... from "std:path"` to "$stdlib/path.or".
@Ensures(isWellFormedRoot(result) && result.entry == "")
function stdlibRoot(): PreludeRoot {
  return PreludeRoot { entry: "", files: embeddedStdlibFiles() };
}

// The runtime core written in Orin (runtime/core/*.or, ADR-0052 Addendum A): the only root whose modules may import `std:core`.
// Below the checker: `noPreludeRoots()` does not have it.
@Ensures(isWellFormedRoot(result) && result.entry == "$rt/module.or")
function rtRoot(): PreludeRoot {
  return PreludeRoot { entry: "$rt/module.or", files: embeddedRtFiles() };
}

@Ensures(rootsWellFormed(result) && result.length == 4)
export function preludeRoots(): PreludeRoot[] {
  return [
    PreludeRoot { entry: "$std/module.or", files: embeddedStdFiles() },
    arrayRoot(),
    stdlibRoot(),
    rtRoot(),
  ];
}

// The roots loaded even without the std prelude (--c-builtins, `check`, the language server): the
// array API is part of the language (ADR-0011), not a library implementation detail.
@Ensures(rootsWellFormed(result) && result.length == 2)
export function noPreludeRoots(): PreludeRoot[] {
  return [arrayRoot(), stdlibRoot()];
}
