     }\n    }\n  }\n  return out;\n}\n\n// ------------------------------------------------------------------------------------------ OrderedMap\n\n// One node of the B-tree: `keys` sorted, `vals` parallel to them, `kids` empty for a leaf, else keys.length + 1\n// child ids (indices into the arena `nodes` of the map).\nexport type OrdNode<K, V> = { keys: K[]; vals: V[]; kids: usize[]; };\n\n// The first index whose key is >= k (keys.length when there is none). Binary search, O(log keys.length).\n@Ensures(result <= keys.length)\n@Ensures(result < keys.length ==> (keys[result] >= k))\n@Ensures(result > 0 ==> (keys[result - 1] < k))\nexport function lowerBoundOrd<K extends Ord>(keys: K[], k: K): usize {\n  let lo: usize = 0;\n  let hi: usize = keys.length;\n  while (lo < hi) {\n    const mid = lo + (hi - lo) / 2;\n    if ((keys[mid] < k)) {\n      lo = mid + 1;\n    } else {\n      hi = mid;\n    }\n  }\n  return lo;\n}\n\n// Is `nodes` a well-formed B-tree arena of minimum degree t rooted at `root`, with free list `free`? Checked\n// iteratively with an explicit stack: every node id is in range and reached exactly once (no dangling or shared\n// ids, no cycles), keys and values have the same length, a leaf has no children and an inner node has one more\n// child than keys (and at least one key), every non-root node holds t-1 .. 2t-1 keys and the root at most 2t-1,\n// all leaves have the same depth, the free list holds distinct ids of unreachable nodes, and every arena slot is\n// either reachable or free.\nexport function btreeOrdShapeOk<K extends Ord, V>(nodes: OrdNode<K, V>[], root: usize, t: usize, free: usize[]): bool {\n  const n = nodes.length;\n  if (t < 2 || root >= n) {\n    return false;\n  }\n  let seen: bool[] = [];\n  let i: usize = 0;\n  while (i < n) {\n    seen.push(false);\n    i += 1;\n  }\n  i = 0;\n  while (i < free.length) {\n    if (free[i] >= n || seen[free[i]]) {\n      return false;\n    }\n    seen[free[i]] = true;\n    i += 1;\n  }\n  let ids: usize[] = [root];\n  let depths: usize[] = [0];\n  let leafDepth: int = -1;\n  let reachable: usize = 0;\n  while (ids.length > 0) {\n    const id = ids.pop().unwrap();\n    const d = depths.pop().unwrap();\n    if (seen[id]) {\n      return false;\n    }\n    seen[id] = true;\n    reachable += 1;\n    const kc = nodes[id].keys.length;\n    if (nodes[id].vals.length != kc || kc > 2 * t - 1) {\n      return false;\n    }\n    if (id != root && kc < t - 1) {\n      return false;\n    }\n    const kk = nodes[id].kids.length;\n    if (kk == 0) {\n      if (leafDepth < 0) {\n        leafDepth = d.toInt();\n      } else if (leafDepth != d.toInt()) {\n        return false;\n      }\n    } else {\n      if (kk != kc + 1 || kc == 0) {\n        return false;\n      }\n      let c: usize = 0;\n      while (c < kk) {\n        if (nodes[id].kids[c] >= n) {\n          return false;\n        }\n        ids.push(nodes[id].kids[c]);\n        depths.push(d + 1);\n        c += 1;\n      }\n    }\n  }\n  return reachable + free.length == n;\n}\n\n// Are the keys ordered? Inside every node strictly increasing, and every key of a child lies strictly between the\n// separator keys around it in the parent (inherited bounds), which together say the in-order sequence is strictly\n// increasing. Iterative; tolerates a broken shape (out-of-range ids, revisits) by answering false.\nexport function btreeOrdOrderOk<K extends Ord, V>(nodes: OrdNode<K, V>[], root: usize): bool {\n  if (root >= nodes.length) {\n    return false;\n  }\n  let ids: usize[] = [root];\n  let los: Option<K>[] = [None];\n  let his: Option<K>[] = [None];\n  let visited: usize = 0;\n  while (ids.length > 0) {\n    visited += 1;\n    if (visited > nodes.length) {\n      return false;\n    }\n    const id = ids.pop().unwrap();\n    const lo = los.pop().unwrap();\n    const hi = his.pop().unwrap();\n    const kc = nodes[id].keys.length;\n    let j: usize = 0;\n    while (j < kc) {\n      if (j > 0 && (nodes[id].keys[j - 1] >= nodes[id].keys[j])) {\n        return false;\n      }\n      j += 1;\n    }\n    if (kc > 0) {\n      if (lo.isSome() && (nodes[id].keys[0] <= lo.unwrap())) {\n        return false;\n      }\n      if (hi.isSome() && (nodes[id].keys[kc - 1] >= hi.unwrap())) {\n        return false;\n      }\n    }\n    const kk = nodes[id].kids.length;\n    if (kk > 0 && kk != kc + 1) {\n      return false;\n    }\n    let c: usize = 0;\n    while (c < kk) {\n      if (nodes[id].kids[c] >= nodes.length) {\n        return false;\n      }\n      ids.push(nodes[id].kids[c]);\n      if (c == 0) {\n        los.push(lo);\n      } else {\n        los.push(Some(nodes[id].keys[c - 1]));\n      }\n      if (c == kc) {\n        his.push(hi);\n      } else {\n        his.push(Some(nodes[id].keys[c]));\n      }\n      c += 1;\n    }\n  }\n  return true;\n}\n\n// The number of keys stored in the tree below `root` (iterative; a revisit or bad id stops the walk early).\nexport function btreeOrdKeyCount<K extends Ord, V>(nodes: OrdNode<K, V>[], root: usize): usize {\n  if (root >= nodes.length) {\n    return 0;\n  }\n  let ids: usize[] = [root];\n  let total: usize = 0;\n  let visited: usize = 0;\n  while (ids.length > 0) {\n    visited += 1;\n    if (visited > nodes.length) {\n      return total;\n    }\n    const id = ids.pop().unwrap();\n    total += nodes[id].keys.length;\n    let c: usize = 0;\n    while (c < nodes[id].kids.length) {\n      if (nodes[id].kids[c] < nodes.length) {\n        ids.push(nodes[id].kids[c]);\n      }\n      c += 1;\n    }\n  }\n  return total;\n}\n\n// Height of the tree: the number of levels (1 for a single leaf root). Follows the first child down. O(height).\nexport function btreeOrdHeight<K extends Ord, V>(nodes: OrdNode<K, V>[], root: usize): usize {\n  let h: usize = 1;\n  let id = root;\n  while (id < nodes.length && nodes[id].kids.length > 0 && h <= nodes.length) {\n    id = nodes[id].kids[0];\n    h += 1;\n  }\n  return h;\n}\n\n// The fewest keys a tree of minimum degree t and the given height can hold: the root has 1 key, every other node\n// at least t-1, so level d >= 1 has >= 2 t^(d-1) nodes and the total is 2 t^(h-1) - 1 (height 1: 1 key, but the\n// root leaf may also be empty, so 0 is returned for an empty tree by the caller). This is why height is O(log_t n).\n@Requires(t >= 2 && h >= 1)\nexport function btreeMinKeysOrd(h: usize, t: usize): usize {\n  let p: usize = 1;\n  let d: usize = 1;\n  while (d < h) {\n    p *= t;\n    d += 1;\n  }\n  return 2 * p - 1;\n}\n\n// All keys in order, by an explicit-stack in-order walk (the stack holds a node id and how many of its children\n// were visited). O(n).\nexport function btreeOrdKeys<K extends Ord, V>(nodes: OrdNode<K, V>[], root: usize): K[] {\n  let out: K[] = [];\n  let ids: usize[] = [root];\n  let js: usize[] = [0];\n  while (ids.length > 0) {\n    const top = ids.length - 1;\n    const id = ids[top];\n    const j = js[top];\n    const kc = nodes[id].keys.length;\n    if (nodes[id].kids.length == 0) {\n      let a: usize = 0;\n      while (a < kc) {\n        out.push(nodes[id].keys[a]);\n        a += 1;\n      }\n      ids.pop();\n      js.pop();\n    } else {\n      if (j > 0 && j - 1 < kc) {\n        out.push(nodes[id].keys[j - 1]);\n      }\n      if (j <= kc) {\n        js[top] = j + 1;\n        ids.push(nodes[id].kids[j]);\n        js.push(0);\n      } else {\n        ids.pop();\n        js.pop();\n      }\n    }\n  }\n  return out;\n}\n\n// All values in key order (same walk as `btreeOrdKeys`). O(n).\nexport function btreeOrdVals<K extends Ord, V>(nodes: OrdNode<K, V>[], root: usize): V[] {\n  let out: V[] = [];\n  let ids: usize[] = [root];\n  let js: usize[] = [0];\n  while (ids.length > 0) {\n    const top = ids.length - 1;\n    const id = ids[top];\n    const j = js[top];\n    const kc = nodes[id].keys.length;\n    if (nodes[id].kids.length == 0) {\n      let a: usize = 0;\n      while (a < kc) {\n        out.push(nodes[id].vals[a]);\n        a += 1;\n      }\n      ids.pop();\n      js.pop();\n    } else {\n      if (j > 0 && j - 1 < kc) {\n        out.push(nodes[id].vals[j - 1]);\n      }\n      if (j <= kc) {\n        js[top] = j + 1;\n        ids.push(nodes[id].kids[j]);\n        js.push(0);\n      } else {\n        ids.pop();\n        js.pop();\n      }\n    }\n  }\n  return out;\n}\n\n// END GENERATED\n" });
  out.push(SourceFile { path: "$stdlib/encoding.or", text: "// std:encoding: strict RFC 4648 byte codecs (hex, Base64, Base64url) and the one home of hex (ADR-0048 section 7.2).\n// See docs/std-encoding.md for padding policy, error precedence, allocation and complexity. No crypto claims.\n//\n// Shape of the API (ADR-0048 sections 1.2, 2.5, 3.1): codec functions are `<codec>Encode` / `<codec>Decode`; the\n// decoders take `Bytes`, and `<codec>DecodeText` takes the same input as a `string`. The Base64 padding policy is a\n// named variant, `Padding = Padded | Unpadded`, not a `bool`. Errors are `EncodingError { kind, offset }` with the\n// renderer `encodingErrorMessage`.\nimport { Bytes, ByteBuilder, fromString } from \"std:bytes\";\n\n// Why a decoder refused its input. InvalidByte: a byte outside the alphabet; InvalidLength: the length cannot be\n// valid; InvalidPadding: `=` where padding is not allowed, missing or misplaced; NonCanonical: nonzero unused bits.\nexport type EncodingErrorKind = InvalidByte | InvalidLength | InvalidPadding | NonCanonical;\n\n// offset is the byte offset in the input where the problem was found (the input length for a length error).\nexport type EncodingError = { kind: EncodingErrorKind; offset: usize; };\n\n// Base64 padding policy: Padded requires `=` padding to a multiple of four on decode and writes it on encode;\n// Unpadded forbids it on both (ADR-0048 rule 2.5; replaces the `padded: bool` parameter).\nexport type Padding = Padded | Unpadded;\n\nfunction isPadded(p: Padding): bool {\n  return match (p) {\n    Padded => true,\n    Unpadded => false,\n  };\n}\n\n// encodingErrorMessage(e): string -- diagnostic text, \"encoding error at byte <offset>: <cause>\". Never fails; O(1),\n// allocates the message.\n@Ensures(result.length > 0)\nexport function encodingErrorMessage(e: EncodingError): string {\n  const why = match (e.kind) {\n    InvalidByte => \"invalid alphabet byte\",\n    InvalidLength => \"invalid encoded length\",\n    InvalidPadding => \"invalid padding\",\n    NonCanonical => \"nonzero unused bits\",\n  };\n  return `encoding error at byte ${e.offset.toString()}: ${why}`;\n}\n\nfunction bad(offset: usize, kind: EncodingErrorKind): Result<Bytes, EncodingError> {\n  return Err(EncodingError { kind: kind, offset: offset });\n}\n\nfunction hexValue(c: int): int {\n  if (c >= 48 && c <= 57) {\n    return c - 48;\n  }\n  if (c >= 65 && c <= 70) {\n    return c - 55;\n  }\n  if (c >= 97 && c <= 102) {\n    return c - 87;\n  }\n  return -1;\n}\n\n// hexEncode(src): string -- lower-case ASCII hex, two digits per byte (`src.toHex()`). Never fails; O(n) time and\n// storage, one final conversion to string.\n@Ensures(result.length / 2 == src.length() && result.length % 2 == 0)\nexport function hexEncode(src: Bytes): string {\n  return src.toHex();\n}\n\n// hexDecode(src): Result<Bytes, EncodingError> -- both cases accepted. Err(InvalidByte) at the first non-hex byte, which\n// takes precedence over Err(InvalidLength) (offset = length) for an odd number of digits. Never traps; O(n).\n@Ensures(result.isOk() ==> src.length() % 2 == 0 && result.unwrap().length() == src.length() / 2)\n@Ensures(result.isErr() ==> result.unwrapErr().offset <= src.length())\nexport function hexDecode(src: Bytes): Result<Bytes, EncodingError> {\n  const data = src.storage();\n  const start = src.storageStart();\n  const n = src.length();\n  let i: usize = 0;\n  while (i < n) {\n    if (hexValue(data[start + i].toInt()) < 0) {\n      return bad(i, InvalidByte);\n    }\n    i += 1;\n  }\n  if (n % 2 != 0) {\n    return bad(n, InvalidLength);\n  }\n  let out = new ByteBuilder();\n  i = 0;\n  while (i < n) {\n    const hi = hexValue(data[start + i].toInt());\n    const lo = hexValue(data[start + i + 1].toInt());\n    out.appendU8((hi * 16 + lo).toU8());\n    i += 2;\n  }\n  return Ok(out.build());\n}\n\n// hexDecodeText(s): Result<Bytes, EncodingError> -- `hexDecode` of the bytes of a string. Same errors and offsets.\n@Ensures(result.isOk() ==> s.length % 2 == 0 && result.unwrap().length() == s.length / 2)\n@Ensures(result.isErr() ==> result.unwrapErr().offset <= s.length)\nexport function hexDecodeText(s: string): Result<Bytes, EncodingError> {\n  return hexDecode(fromString(s));\n}\n\nfunction alphabet(url: bool): string {\n  return url\n      ? \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_\"\n      : \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\";\n}\n\nfunction value(c: int, url: bool): int {\n  if (c >= 65 && c <= 90) {\n    return c - 65;\n  }\n  if (c >= 97 && c <= 122) {\n    return c - 71;\n  }\n  if (c >= 48 && c <= 57) {\n    return c + 4;\n  }\n  if (c == (url ? 45 : 43)) {\n    return 62;\n  }\n  if (c == (url ? 95 : 47)) {\n    return 63;\n  }\n  return -1;\n}\n\nfunction encode64(src: Bytes, padded: bool, url: bool): string {\n  const digits = alphabet(url);\n  const data = src.storage();\n  const start = src.storageStart();\n  const n = src.length();\n  let out = new ByteBuilder();\n  let i: usize = 0;\n  while (i < n) {\n    const a = data[start + i].toInt();\n    const remaining = n - i;\n    let b = 0;\n    let c = 0;\n    if (remaining > 1) {\n      b = data[start + i + 1].toInt();\n    }\n    if (remaining > 2) {\n      c = data[start + i + 2].toInt();\n    }\n    out.appendU8(digits.charCodeAt((a / 4).toUsize()).toU8());\n    out.appendU8(digits.charCodeAt((a % 4 * 16 + b / 16).toUsize()).toU8());\n    if (remaining > 1) {\n      out.appendU8(digits.charCodeAt((b % 16 * 4 + c / 64).toUsize()).toU8());\n    } else {\n      if (padded) {\n        out.appendU8(61);\n      }\n    }\n    if (remaining > 2) {\n      out.appendU8(digits.charCodeAt((c % 64).toUsize()).toU8());\n    } else {\n      if (padded) {\n        out.appendU8(61);\n      }\n    }\n    // Avoid stepping past the last (possibly partial) group.\n    i += remaining < 3 ? remaining : 3;\n  }\n  return out.build().toRawString();\n}\n\nfunction decode64(src: Bytes, padded: bool, url: bool): Result<Bytes, EncodingError> {\n  const data = src.storage();\n  const start = src.storageStart();\n  const n = src.length();\n  let count = n;\n  let padding: usize = 0;\n  let i: usize = 0;\n  while (i < n) {\n    const c = data[start + i].toInt();\n    if (c == 61) {\n      if (!padded || padding == 2 || i % 4 < 2) {\n        return bad(i, InvalidPadding);\n      }\n      if (padding == 0) {\n        count = i;\n      }\n      padding += 1;\n    } else {\n      if (value(c, url) < 0) {\n        return bad(i, InvalidByte);\n      }\n      if (padding > 0) {\n        return bad(i, InvalidPadding);\n      }\n    }\n    i += 1;\n  }\n  const tail = count % 4;\n  if (padded) {\n    if (n % 4 != 0) {\n      return bad(n, InvalidLength);\n    }\n    if (padding == 1 && tail != 3 || padding == 2 && tail != 2) {\n      return bad(n, InvalidPadding);\n    }\n  } else {\n    if (tail == 1) {\n      return bad(n, InvalidLength);\n    }\n  }\n  if (tail == 2 && value(data[start + count - 1].toInt(), url) % 16 != 0) {\n    return bad(count - 1, NonCanonical);\n  }\n  if (tail == 3 && value(data[start + count - 1].toInt(), url) % 4 != 0) {\n    return bad(count - 1, NonCanonical);\n  }\n  let out = new ByteBuilder();\n  let acc = 0;\n  let phase: usize = 0;\n  i = 0;\n  while (i < count) {\n    const v = value(data[start + i].toInt(), url);\n    if (phase == 0) {\n      acc = v;\n    }\n    if (phase == 1) {\n      out.appendU8((acc * 4 + v / 16).toU8());\n      acc = v % 16;\n    }\n    if (phase == 2) {\n      out.appendU8((acc * 16 + v / 4).toU8());\n      acc = v % 4;\n    }\n    if (phase == 3) {\n      out.appendU8((acc * 64 + v).toU8());\n      acc = 0;\n    }\n    phase = (phase + 1) % 4;\n    i += 1;\n  }\n  return Ok(out.build());\n}\n\n// base64Encode(src, padding): string -- RFC 4648 standard alphabet; Padded writes `=` up to a multiple of four,\n// Unpadded writes none. Never fails; O(n) time and allocation.\n@Ensures(isPadded(padding) ==> result.length % 4 == 0)\n@Ensures(isPadded(padding)\n    ==> result.length / 4 == src.length() / 3 + (src.length() % 3 == 0 ? 0 : 1).toUsize())\n@Ensures(!isPadded(padding) ==> result.length / 4 == src.length() / 3)\n@Ensures(!isPadded(padding) ==> result.length % 4 == (src.length() % 3 == 0 ? 0 : src.length() % 3 + 1))\nexport function base64Encode(src: Bytes, padding: Padding): string {\n  return encode64(src, isPadded(padding), false);\n}\n\n// base64Decode(src, padding): Result<Bytes, EncodingError> -- strict RFC 4648 standard alphabet. Err(InvalidByte |\n// InvalidPadding | InvalidLength | NonCanonical) with the offset of the first problem; no partial result. Never\n// traps; O(n) time and allocation.\n@Ensures(result.isErr() ==> result.unwrapErr().offset <= src.length())\n@Ensures(result.isOk() ==> result.unwrap().length() <= src.length())\nexport function base64Decode(src: Bytes, padding: Padding): Result<Bytes, EncodingError> {\n  return decode64(src, isPadded(padding), false);\n}\n\n// base64DecodeText(s, padding): Result<Bytes, EncodingError> -- `base64Decode` of the bytes of a string.\n@Ensures(result.isErr() ==> result.unwrapErr().offset <= s.length)\n@Ensures(result.isOk() ==> result.unwrap().length() <= s.length)\nexport function base64DecodeText(s: string, padding: Padding): Result<Bytes, EncodingError> {\n  return decode64(fromString(s), isPadded(padding), false);\n}\n\n// base64UrlEncode(src, padding): string -- RFC 4648 URL alphabet (`-` and `_`); padding policy as `base64Encode`.\n// Never fails; O(n) time and allocation.\n@Ensures(isPadded(padding) ==> result.length % 4 == 0)\n@Ensures(isPadded(padding)\n    ==> result.length / 4 == src.length() / 3 + (src.length() % 3 == 0 ? 0 : 1).toUsize())\n@Ensures(!isPadded(padding) ==> result.length / 4 == src.length() / 3)\n@Ensures(!isPadded(padding) ==> result.length % 4 == (src.length() % 3 == 0 ? 0 : src.length() % 3 + 1))\nexport function base64UrlEncode(src: Bytes, padding: Padding): string {\n  return encode64(src, isPadded(padding), true);\n}\n\n// base64UrlDecode(src, padding): Result<Bytes, EncodingError> -- strict, URL alphabet; errors as `base64Decode`.\n@Ensures(result.isErr() ==> result.unwrapErr().offset <= src.length())\n@Ensures(result.isOk() ==> result.unwrap().length() <= src.length())\nexport function base64UrlDecode(src: Bytes, padding: Padding): Result<Bytes, EncodingError> {\n  return decode64(src, isPadded(padding), true);\n}\n\n// base64UrlDecodeText(s, padding): Result<Bytes, EncodingError> -- `base64UrlDecode` of the bytes of a string.\n@Ensures(result.isErr() ==> result.unwrapErr().offset <= s.length)\n@Ensures(result.isOk() ==> result.unwrap().length() <= s.length)\nexport function base64UrlDecodeText(s: string, padding: Padding): Result<Bytes, EncodingError> {\n  return decode64(fromString(s), isPadded(padding), true);\n}\n" });
  out.push(SourceFile { path: "$stdlib/fs.or", text: "// std:fs -- whole-file functions and streaming file access through the scope API (ADR-0025).\n//\n// UNSTABLE (ADR-0016 two-stage freeze): std I/O stays unstable until the project owner confirms the freeze. Every\n// function that touches the file system takes the FILE-SYSTEM GRANT (`FsGrant`, ADR-0027) as its first argument:\n// `readFile(fs, path)`, `withFile(fs, path, mode, body)`. A grant comes from `main(host: Host)` through std:host\n// (`useFs(host, fs => ...)`) and can be narrowed with `withUnder` / `withReadOnly` below; the scope shape and the `File`\n// methods did not change. The language rules for `File` and for grants are not unstable: see below.\n//\n// `File` is a RESOURCE HANDLE, not a value (spec 06): it can be passed to functions (borrowed) but not stored in a\n// record / class / array / Option / Result / Map, returned, assigned to another variable, captured by a closure,\n// compared or converted to string; those uses are compile errors E0450 / E0451 / E0452 (compiler/check/resources.or)\n// and, independently, MIR verifier errors (docs/mir.md, \"Resource handles\"). The only way to obtain one is a\n// scope function below: it opens the file, calls `body` with the handle as the body's PARAMETER, and closes the\n// file when `body` returns -- on every path, including when the result is later turned into an `Err`. A trap\n// inside `body` ends the process; the runtime flushes and closes open files in its exit hook, so bytes already\n// handed to `write` are not lost (a kill by signal still loses buffered bytes).\n//\n// Errors of reads/writes/flushes inside the scope are remembered by the file (the methods themselves stay\n// simple: `readLine(): Option<string>`, `write(s): void`); the scope function reports the first one as\n// `Err(FsError)` when it closes the file. A failed read looks like end of file to `body`.\n//\n// Why two flavours: a generic result `T` cannot be `void`; `withFile` returns the body's value, `useFile`\n// takes a body that returns nothing. Both exist for one file and for two files (`withFiles`, `useFiles`), which is how\n// you stream from one file to another: a handle cannot be captured by a nested scope's closure.\n//\n// Failure (ADR-0048 section 3): every function that can fail for an outside reason returns `Result<_, FsError>`; the\n// error has a `kind` (NotFound, PermissionDenied, Denied, ...), the failed operation `op`, the `path` and the `reason`\n// text, and `fsErrorMessage(e)` renders it. Nothing traps on a missing path, a non-directory, a permission error or a\n// refusal by the host policy / the narrowed grant; only a forged, stale or wrong-family grant and allocation failure do.\n//\n// Whole-file functions: readFile(fs, path): Result<string, FsError>, writeFile(fs, path, data): Result<void, FsError>,\n// exists(fs, path): Result<bool, FsError>, listDir(fs, path): Result<string[], FsError> (the entries of a directory in\n// byte order, physical subdirectories with a trailing `/`; directory symlinks are not followed; a readable empty\n// directory yields `Ok([])`; a partial listing is never returned).\n//\n// Narrowing (ADR-0027): `withUnder(fs, dir, body)` runs `body` with a grant that only reaches paths inside `dir`\n// (compared after making both absolute and removing \".\" / \"..\" / repeated \"/\" -- and, for existing path prefixes,\n// after resolving symbolic links, so a link that leaves the scope does not work); `withReadOnly(fs, body)` with a\n// grant that cannot create, write or truncate. A narrowed grant never has more authority than its parent: asking for\n// a directory outside the parent's scope yields a grant that reaches nothing. Narrowed grants are handles like any\n// other (a scope parameter, no capture, no storing).\n\nimport {\n  File, FsGrant, fsReadFile, fsWriteFile, fsExists, fsListDir, fileOpen, fileIsOpen, fileOpenError, fileClose, grantUnder,\n  grantReadOnly, grantRevoke\n} from \"std:fsraw\";\n\nexport { File, FsGrant } from \"std:fsraw\";\n\n// Why an operation failed. NotFound, PermissionDenied, IsDirectory, NotDirectory and AlreadyExists are the operating\n// system's answers; Denied is the host policy (ORIN_DENY names `fs`), OutsideScope a path outside a narrowed grant\n// (`withUnder`) or one that cannot be resolved inside it, ReadOnly a write through `withReadOnly`, WrongMode a read on\n// a file opened for writing or the reverse, TooManyFiles the limit of 256 open files, Io every other system error.\nexport type FsErrorKind =\n  NotFound\n  | PermissionDenied\n  | IsDirectory\n  | NotDirectory\n  | AlreadyExists\n  | Denied\n  | OutsideScope\n  | ReadOnly\n  | WrongMode\n  | TooManyFiles\n  | Io;\n\n// What was being attempted when the error happened.\nexport type FsOp = OpRead | OpWrite | OpOpen | OpList | OpStat | OpClose;\n\n// An error of this module. `path` is the path as the caller wrote it, `reason` the system's or the policy's explanation\n// (diagnostic text, not for matching: match on `kind`). Render it with `fsErrorMessage`.\nexport type FsError = { kind: FsErrorKind; op: FsOp; path: string; reason: string; };\n\n// fsErrorMessage(e: FsError): string -- \"cannot read 'a.txt': No such file or directory\" (verbs: read, write, open, list,\n// check; a failure found when a file is closed reads \"I/O error on 'p': reason\"). Never empty. O(path + reason).\nexport function fsErrorMessage(e: FsError): string {\n  return match (e.op) {\n    OpClose => \"I/O error on '\" + e.path + \"': \" + e.reason,\n    _ => \"cannot \" + opVerb(e.op) + \" '\" + e.path + \"': \" + e.reason\n  };\n}\n\nfunction opVerb(op: FsOp): string {\n  return match (op) {\n    OpRead => \"read\",\n    OpWrite => \"write\",\n    OpOpen => \"open\",\n    OpList => \"list\",\n    OpStat => \"check\",\n    OpClose => \"close\"\n  };\n}\n\n// The kind for the explanation text of the runtime (the strerror text of the platform or one of the policy texts).\nfunction kindOfReason(reason: string): FsErrorKind {\n  if (reason == \"denied by the host policy (ORIN_DENY)\") {\n    return Denied;\n  }\n  if (reason == \"outside the granted file scope\" || reason == \"path cannot be resolved inside the granted scope\") {\n    return OutsideScope;\n  }\n  if (reason == \"the file grant is read-only\") {\n    return ReadOnly;\n  }\n  if (reason == \"No such file or directory\") {\n    return NotFound;\n  }\n  if (reason == \"Permission denied\" || reason == \"Operation not permitted\") {\n    return PermissionDenied;\n  }\n  if (reason == \"Is a directory\") {\n    return IsDirectory;\n  }\n  if (reason == \"Not a directory\") {\n    return NotDirectory;\n  }\n  if (reason == \"File exists\") {\n    return AlreadyExists;\n  }\n  if (reason == \"Bad file descriptor\") {\n    return WrongMode;\n  }\n  if (reason == \"Too many open files\") {\n    return TooManyFiles;\n  }\n  return Io;\n}\n\n// The runtime reports \"cannot <verb> '<path>': <reason>\"; the reason is what follows the prefix.\nfunction reasonOf(op: FsOp, path: string, raw: string): string {\n  const prefix = \"cannot \" + opVerb(op) + \" '\" + path + \"': \";\n  if (raw.startsWith(prefix)) {\n    return raw.substring(prefix.length, raw.length);\n  }\n  return raw;\n}\n\nfunction fromReason(op: FsOp, path: string, reason: string): FsError {\n  return FsError { kind: kindOfReason(reason), op: op, path: path, reason: reason };\n}\n\nfunction fromRaw(op: FsOp, path: string, raw: string): FsError {\n  return fromReason(op, path, reasonOf(op, path, raw));\n}\n\n// The error for a refusal code of the grant (100001 host policy, 100003 read-only, 100002 scope, 100004 unresolvable).\nfunction denial(op: FsOp, path: string, code: int): FsError {\n  if (code == 100001) {\n    return FsError { kind: Denied, op: op, path: path, reason: \"denied by the host policy (ORIN_DENY)\" };\n  }\n  if (code == 100003) {\n    return FsError { kind: ReadOnly, op: op, path: path, reason: \"the file grant is read-only\" };\n  }\n  if (code == 100004) {\n    return FsError { kind: OutsideScope, op: op, path: path, reason: \"path cannot be resolved inside the granted scope\" };\n  }\n  return FsError { kind: OutsideScope, op: op, path: path, reason: \"outside the granted file scope\" };\n}\n\n// readFile(fs, path): Result<string, FsError>\n// The whole file as text. Err: NotFound, PermissionDenied, IsDirectory, Denied, OutsideScope or Io. O(file size); allocates\n// the result.\nexport function readFile(fs: FsGrant, path: string): Result<string, FsError> {\n  const r = fsReadFile(fs, path);\n  return match (r) {\n    Ok(text) => Ok(text),\n    Err(raw) => Err(fromRaw(OpRead, path, raw))\n  };\n}\n\n// writeFile(fs, path, data): Result<void, FsError>\n// Creates or truncates `path` and writes `data`. Err: NotFound (missing directory), PermissionDenied, IsDirectory,\n// Denied, OutsideScope, ReadOnly or Io. O(data size).\nexport function writeFile(fs: FsGrant, path: string, data: string): Result<void, FsError> {\n  const r = fsWriteFile(fs, path, data);\n  if (r.isErr()) {\n    return Err(fromRaw(OpWrite, path, r.unwrapErr()));\n  }\n  return Ok();\n}\n\n// exists(fs, path): Result<bool, FsError>\n// True when `path` names a file, a directory or the target of a symbolic link; a dangling link and a path the process\n// cannot stat are `Ok(false)`. Err only when the grant refuses the query (Denied, OutsideScope). O(1) system call.\nexport function exists(fs: FsGrant, path: string): Result<bool, FsError> {\n  const r = fsExists(fs, path);\n  if (r < 0) {\n    return Err(denial(OpStat, path, 0 - r));\n  }\n  return Ok(r != 0);\n}\n\n// listDir(fs, path): Result<string[], FsError>\n// The entries of the directory in byte order, subdirectories with a trailing \"/\", \".\" and \"..\" omitted; symbolic links are\n// not followed. Err: NotFound, NotDirectory, PermissionDenied, Denied, OutsideScope or Io, never a partial listing.\n// O(n log n) in the number of entries; allocates the array.\nexport function listDir(fs: FsGrant, path: string): Result<string[], FsError> {\n  const r = fsListDir(fs, path);\n  return match (r) {\n    Ok(entries) => Ok(entries),\n    Err(raw) => Err(fromRaw(OpList, path, raw))\n  };\n}\n\n// How a file is opened: Read (the file must exist), Write (create or truncate), Append (create if missing,\n// every write goes to the end). A file opened with Read cannot be written and vice versa (the failed operation is\n// reported as an `Err` of kind WrongMode when the scope ends).\nexport type FileMode = Read | Write | Append;\n\nfunction modeCode(m: FileMode): int {\n  return match (m) {\n    Read => 0,\n    Write => 1,\n    Append => 2\n  };\n}\n\n// The error of a failed open: the handle holds the reason text.\nfunction openError(path: string, h: File): FsError {\n  return fromReason(OpOpen, path, fileOpenError(h));\n}\n\n// The error of a failed operation found at close (\"I/O error: <reason>\" from the runtime).\nfunction closeError(path: string, raw: string): FsError {\n  const prefix = \"I/O error: \";\n  const reason = raw.startsWith(prefix) ? raw.substring(prefix.length, raw.length) : raw;\n  return fromReason(OpClose, path, reason);\n}\n\n// The first failure of the closes of two files (path A first).\nfunction firstClose(pathA: string, a: Option<string>, pathB: string, b: Option<string>): Option<FsError> {\n  return match (a) {\n    Some(m) => Some(closeError(pathA, m)),\n    None => match (b) {\n      Some(n) => Some(closeError(pathB, n)),\n      None => None\n    }\n  };\n}\n\n// withFile<T>(fs, path, mode, body): Result<T, FsError>\n// Opens `path`, runs `body(file)`, closes the file, and returns `Ok(<body's value>)`; `Err` if the file cannot be opened\n// (body is not called; kinds as for readFile / writeFile) or if any operation on it or the final flush/close failed (the\n// body's value is discarded). O(1) plus the work of `body`; at most 256 files can be open at once.\nexport function withFile<T>(fs: FsGrant, path: string, mode: FileMode, body: (file: File) => T): Result<T, FsError> {\n  const h = fileOpen(fs, path, modeCode(mode));\n  if (!fileIsOpen(h)) {\n    const err = openError(path, h);\n    fileClose(h);\n    return Err(err);\n  }\n  const r = body(h);\n  const e = fileClose(h);\n  return match (e) {\n    Some(m) => Err(closeError(path, m)),\n    None => Ok(r)\n  };\n}\n\n// useFile(fs, path, mode, body): Result<void, FsError> -- `withFile` for a body that returns nothing.\nexport function useFile(fs: FsGrant, path: string, mode: FileMode, body: (file: File) => void): Result<void, FsError> {\n  const h = fileOpen(fs, path, modeCode(mode));\n  if (!fileIsOpen(h)) {\n    const err = openError(path, h);\n    fileClose(h);\n    return Err(err);\n  }\n  body(h);\n  const e = fileClose(h);\n  return match (e) {\n    Some(m) => Err(closeError(path, m)),\n    None => Ok()\n  };\n}\n\n// withFiles<T>(fs, pathA, modeA, pathB, modeB, body): Result<T, FsError>\n// Two files open at the same time (for example copying a file line by line). If the second cannot be opened the first is\n// closed again; the first failure to close is reported (file A before file B).\nexport function withFiles<T>(\n  fs: FsGrant, pathA: string, modeA: FileMode, pathB: string, modeB: FileMode, body: (a: File, b: File) => T\n): Result<T, FsError> {\n  const a = fileOpen(fs, pathA, modeCode(modeA));\n  if (!fileIsOpen(a)) {\n    const err = openError(pathA, a);\n    fileClose(a);\n    return Err(err);\n  }\n  const b = fileOpen(fs, pathB, modeCode(modeB));\n  if (!fileIsOpen(b)) {\n    const err = openError(pathB, b);\n    fileClose(b);\n    fileClose(a);\n    return Err(err);\n  }\n  const r = body(a, b);\n  const eb = fileClose(b);\n  const ea = fileClose(a);\n  return match (firstClose(pathA, ea, pathB, eb)) {\n    Some(err) => Err(err),\n    None => Ok(r)\n  };\n}\n\n// useFiles(fs, pathA, modeA, pathB, modeB, body): Result<void, FsError> -- `withFiles` for a body that returns nothing.\nexport function useFiles(\n  fs: FsGrant, pathA: string, modeA: FileMode, pathB: string, modeB: FileMode, body: (a: File, b: File) => void\n): Result<void, FsError> {\n  const a = fileOpen(fs, pathA, modeCode(modeA));\n  if (!fileIsOpen(a)) {\n    const err = openError(pathA, a);\n    fileClose(a);\n    return Err(err);\n  }\n  const b = fileOpen(fs, pathB, modeCode(modeB));\n  if (!fileIsOpen(b)) {\n    const err = openError(pathB, b);\n    fileClose(b);\n    fileClose(a);\n    return Err(err);\n  }\n  body(a, b);\n  const eb = fileClose(b);\n  const ea = fileClose(a);\n  return match (firstClose(pathA, ea, pathB, eb)) {\n    Some(err) => Err(err),\n    None => Ok()\n  };\n}\n\n// withUnder<T>(fs, dir, body: (sub: FsGrant) => T): T\n// Runs `body` with a grant restricted to the directory `dir` (and below). `dir` may be relative (to the working\n// directory) or absolute. Not allowed to widen: if `dir` is not inside the scope of `fs`, the result reaches nothing\n// (every operation is refused with OutsideScope). O(1) plus the work of `body`.\nexport function withUnder<T>(fs: FsGrant, dir: string, body: (sub: FsGrant) => T): T {\n  const g = grantUnder(fs, dir);\n  const r = body(g);\n  grantRevoke(g);\n  return r;\n}\n\n// useUnder(fs, dir, body: (sub: FsGrant) => void): void -- `withUnder` for a body that returns nothing.\nexport function useUnder(fs: FsGrant, dir: string, body: (sub: FsGrant) => void): void {\n  const g = grantUnder(fs, dir);\n  body(g);\n  grantRevoke(g);\n}\n\n// withReadOnly<T>(fs, body: (ro: FsGrant) => T): T\n// Runs `body` with a grant that can read but not create, write or truncate (such an operation is refused with ReadOnly).\n// O(1) plus the work of `body`.\nexport function withReadOnly<T>(fs: FsGrant, body: (ro: FsGrant) => T): T {\n  const g = grantReadOnly(fs);\n  const r = body(g);\n  grantRevoke(g);\n  return r;\n}\n\n// useReadOnly(fs, body: (ro: FsGrant) => void): void -- `withReadOnly` for a body that returns nothing.\nexport function useReadOnly(fs: FsGrant, body: (ro: FsGrant) => void): void {\n  const g = grantReadOnly(fs);\n  body(g);\n  grantRevoke(g);\n}\n\n// withFileFs<T>(fs, path, mode, body: (file: File, fs: FsGrant) => T): Result<T, FsError>\n// `withFile` whose body also receives the SAME grant again as a parameter. A closure cannot capture a grant (the capture\n// would let it outlive the scope), so a body that must open further files (a nested scope, a recursive helper) gets the\n// grant this way.\nexport function withFileFs<T>(fs: FsGrant, path: string, mode: FileMode, body: (file: File, fs: FsGrant) => T): Result<T, FsError> {\n  const h = fileOpen(fs, path, modeCode(mode));\n  if (!fileIsOpen(h)) {\n    const err = openError(path, h);\n    fileClose(h);\n    return Err(err);\n  }\n  const r = body(h, fs);\n  const e = fileClose(h);\n  return match (e) {\n    Some(m) => Err(closeError(path, m)),\n    None => Ok(r)\n  };\n}\n" });
  out.push(SourceFile { path: "$stdlib/graph.or", text: "// std:graph -- Graph<T> with generational, graph-tagged node ids (spec 06 \"Cyclic graph\", ADR-0016, ADR-0026).\n//\n// Cyclic structures are not expressible with owning values (no owning cycles), so a graph owner\n// holds all nodes and edges are checked, non-owning `GraphId<T>` handles:\n//   * Each id carries the graph's tag, the slot index and the slot's generation. Removing a node\n//     bumps its slot's generation, so an id that outlived its node is STALE and every operation\n//     rejects it with `Err(StaleId)`; an id minted by a graph with a different tag is `Err(ForeignId)`.\n//     (An id whose index lies beyond the graph is also `ForeignId`.)\n//   * `Graph<T>` is a generic class (value semantics like every class): `let g = new Graph<string>(1);\n//     const a = g.add(\"alpha\");`. A copy (`const h = g`) is independent: later changes to `g` are not\n//     visible in `h` (an id removed in `g` is still valid in the older `h`: ids identify a node of one\n//     *tag*, generations track its history).\n//   * The tag is supplied by the caller: `new Graph<T>(tag)`. Use a different tag per logical graph.\n//     TODO(after global state): an automatic unique tag once the language has a process-wide counter.\n//   * Edges are directed and stored in the source slot as (index, generation) pairs. Removing a node\n//     does not touch edges pointing at it: they become dangling and `neighbors` silently skips them\n//     (an edge only counts while both ends are live with the generations recorded at addEdge time).\n//     Duplicate edges are allowed and reported once per addEdge call.\n//   * Complexity: `add`, `get`, `has`, `size` are O(1) (freed slots are reused through a free list);\n//     `remove` is O(1); `neighbors` is O(out-degree), `ids` O(nodes). Mutating methods update the\n//     graph in place when it is not shared; a shared graph is copied on the first change (O(nodes)).\n//\n// TODO(after floats/map): `Map`-based index, edge weights.\n\n// Opaque handle of a node of a graph with value type T. `T` is only a phantom parameter that ties\n// the id to its graph's value type; obtain ids through `Graph.add`.\nexport type GraphId<T> = { tag: int; index: usize; gen: int; };\n\n// Why an id was rejected (ADR-0048 rule 3.1). StaleId: the node was removed (the slot has a newer generation or is\n// empty). ForeignId: the id belongs to another graph (different tag) or does not name a slot at all.\nexport type GraphErrorKind = StaleId | ForeignId;\n\n// The error of every fallible `Graph` method. There is no byte offset: the cause is the whole error.\nexport type GraphError = { kind: GraphErrorKind; };\n\ntype Edge = { index: usize; gen: int; };\n\ntype Slot<T> = { gen: int; value: Option<T>; edges: Edge[]; };\n\n// graphErrorMessage(e): string -- \"stale graph id\" / \"foreign graph id\". Never fails; O(1).\nexport function graphErrorMessage(e: GraphError): string {\n  return match (e.kind) {\n    StaleId => \"stale graph id\",\n    ForeignId => \"foreign graph id\"\n  };\n}\n\n// A directed graph owning its nodes; see the header for ids, tags and generations.\nexport class Graph<T> {\n  private tag: int;\n  private slots: Slot<T>[] = [];\n  private free: usize[] = [];\n  private live: usize = 0;\n\n  // new Graph<T>(tag) -- an empty graph. Ids minted by it are accepted only by graphs with the same `tag`.\n  constructor(tag: int) {\n    this.tag = tag;\n  }\n\n  // size(): usize -- number of live nodes. Never fails. O(1).\n  size(): usize {\n    return this.live;\n  }\n\n  // Validates `id`: Ok(slot index) when it names a live node of this graph.\n  private lookup(id: GraphId<T>): Result<usize, GraphError> {\n    if (id.tag != this.tag || id.index >= this.slots.length) {\n      return Err(GraphError { kind: ForeignId });\n    }\n    if (this.slots[id.index].gen != id.gen || this.slots[id.index].value.isNone()) {\n      return Err(GraphError { kind: StaleId });\n    }\n    return Ok(id.index);\n  }\n\n  // has(id): bool -- true when `id` names a live node of this graph. Never fails (a stale or foreign id is just false). O(1).\n  has(id: GraphId<T>): bool {\n    return this.lookup(id).isOk();\n  }\n\n  @Deprecated(\"use has(id) (ADR-0048)\")\n  contains(id: GraphId<T>): bool {\n    return this.has(id);\n  }\n\n  // isEmpty(): bool -- no live node. Never fails. O(1).\n  isEmpty(): bool {\n    return this.live == 0;\n  }\n\n  // add(value): GraphId<T> -- adds a node (reusing a freed slot, whose generation `remove` already bumped) and returns\n  // its id. Never fails. O(1).\n  add(value: T): GraphId<T> {\n    if (this.free.length > 0) {\n      const i = this.free.pop().unwrap();\n      this.slots[i].value = Some(value);\n      this.live += 1;\n      return GraphId<T> { tag: this.tag, index: i, gen: this.slots[i].gen };\n    }\n    this.slots.push(Slot<T> { gen: 0, value: Some(value), edges: [] });\n    this.live += 1;\n    return GraphId<T> { tag: this.tag, index: this.slots.length - 1, gen: 0 };\n  }\n\n  // get(id): Result<T, GraphError> -- the value of a live node. Err(StaleId) for a removed node, Err(ForeignId) for an\n  // id of another graph. O(1).\n  get(id: GraphId<T>): Result<T, GraphError> {\n    const i = this.lookup(id)?;\n    return Ok(this.slots[i].value.unwrap());\n  }\n\n  // set(id, value): Result<void, GraphError> -- replaces a live node's value (its edges and id stay). Errors as `get`.\n  // O(1).\n  set(id: GraphId<T>, value: T): Result<void, GraphError> {\n    const i = this.lookup(id)?;\n    this.slots[i].value = Some(value);\n    return Ok();\n  }\n\n  // remove(id): Result<T, GraphError> -- removes a live node and its outgoing edges and returns its value. The slot\n  // generation is bumped (invalidating `id` and every copy of it) and the slot is freed for reuse. Edges of other\n  // nodes that pointed at it dangle and are skipped by `neighbors`. Errors as `get`. O(1).\n  remove(id: GraphId<T>): Result<T, GraphError> {\n    const i = this.lookup(id)?;\n    const old = this.slots[i].value.unwrap();\n    const gone: Option<T> = None;\n    this.slots[i].value = gone;\n    this.slots[i].gen += 1;\n    this.slots[i].edges = [];\n    this.free.push(i);\n    this.live -= 1;\n    return Ok(old);\n  }\n\n  // addEdge(a, b): Result<void, GraphError> -- adds the directed edge a -> b (self loops and duplicates allowed). Both\n  // ids must be live in this graph; the first failing id's error is returned (`a` is checked first). O(1).\n  addEdge(a: GraphId<T>, b: GraphId<T>): Result<void, GraphError> {\n    const i = this.lookup(a)?;\n    const j = this.lookup(b)?;\n    this.slots[i].edges.push(Edge { index: j, gen: b.gen });\n    return Ok();\n  }\n\n  // neighbors(id): Result<GraphId<T>[], GraphError> -- the targets of the outgoing edges of a live node, in insertion\n  // order, skipping dangling edges (removed targets). Errors as `get`. O(out-degree).\n  neighbors(id: GraphId<T>): Result<GraphId<T>[], GraphError> {\n    const i = this.lookup(id)?;\n    let out: GraphId<T>[] = [];\n    for (const e of this.slots[i].edges) {\n      if (this.slots[e.index].gen == e.gen && this.slots[e.index].value.isSome()) {\n        out.push(GraphId<T> { tag: this.tag, index: e.index, gen: e.gen });\n      }\n    }\n    return Ok(out);\n  }\n\n  // ids(): GraphId<T>[] -- ids of all live nodes in slot order. Never fails. O(nodes).\n  ids(): GraphId<T>[] {\n    let out: GraphId<T>[] = [];\n    let i: usize = 0;\n    while (i < this.slots.length) {\n      if (this.slots[i].value.isSome()) {\n        out.push(GraphId<T> { tag: this.tag, index: i, gen: this.slots[i].gen });\n      }\n      i += 1;\n    }\n    return out;\n  }\n}\n" });
  out.push(SourceFile { path: "$stdlib/host.or", text: "// std:host -- the root of authority (ADR-0021 Stage A, ADR-0027).\n//\n// UNSTABLE (ADR-0016 two-stage freeze): std I/O stays unstable until the project owner confirms the freeze.\n//\n// A program that performs I/O declares `function main(host: Host): void`. `Host` is the program's handle on the\n// machine it runs on: a RESOURCE HANDLE (ADR-0025 rules: it can only be passed as an argument; it cannot be stored in\n// a variable, record, class or array, returned, captured by a closure, copied or compared) that only the runtime\n// can create. `main()` without the parameter has NO I/O authority: every std I/O function takes a grant as its first\n// argument, so such a program cannot call one (compile error E0470).\n//\n// From the Host a program derives grants, one per family of operation (the \"root operation families\"):\n//   FsGrant       std:fs       open / read / write / list files (further narrowed by `withUnder`, `withReadOnly`)\n//   ProcessGrant  std:io       `shell`, `shellTimeout`; std:process `args` (further narrowed by `withArgsOnly`: no spawning)\n//   StdioGrant    std:io       read stdin, `writeStdout`\n//   ClockGrant    std:time     `nowMillis`\n//   NetGrant      std:net      listen / connect / resolve (`useNet`; narrowed by `useListen`, `useConnect`)\n// (`useHost` hands out the first four only: take the network grant with `useNet`.) `console.log` / `console.error` and\n// `exit` need no grant (ADR-0027, \"ambient output\"); they are still recorded as primitive OUTPUT / CONTROL events by\n// the OSIG.\n//\n// A grant is obtained only through a SCOPE function: it creates the grant, calls `body` with the grant as the body's\n// PARAMETER and revokes it when `body` returns, on every path. Because a handle cannot be captured, a nested scope\n// cannot use the outer grant: take every grant you need at once with `withHost` / `useHost`, or pass grants on as\n// arguments. One function per scope (ADR-0048 section 6): `with*` returns the body's value and accepts a body that returns nothing (T = void); the `use*` names are deprecated wrappers.\n//\n// The host policy decides what the OS process may give: by default everything the process has; the environment\n// variable ORIN_DENY (a comma-separated list of: fs, process, stdio, clock, net, all) denies families. A denied family is\n// still handed out (the program type-checks and runs); every operation then reports an `Err` (FsError kind Denied, ...)\n// if it returns a Result, and traps (\"capability denied: ...\") otherwise.\n//\n// The raw primitives (grantFs, grantRevoke ... of the internal module std:fsraw) can only be used by the std\n// library: user code cannot name them (E0301), so it cannot create, copy or forge a grant.\n\nimport {\n  Host, FsGrant, ProcessGrant, StdioGrant, ClockGrant, NetGrant, grantNet, grantFs, grantProcess, grantStdio, grantClock, grantArgsOnly, grantRevoke\n} from \"std:fsraw\";\n\nexport { Host } from \"std:fsraw\";\n\n// withFs<T>(host, body: (fs: FsGrant) => T): T\n// The file-system grant of the host policy (the whole file system, unless the policy denies `fs`). Revoked when `body`\n// returns.\nexport function withFs<T>(host: Host, body: (fs: FsGrant) => T): T {\n  const g = grantFs(host);\n  const r = body(g);\n  grantRevoke(g);\n  return r;\n}\n\n// useFs(host, body: (fs: FsGrant) => void): void -- `withFs` for a body that returns nothing.\n@Deprecated(\"use withFs(host, body) with a void body (ADR-0048)\")\nexport function useFs(host: Host, body: (fs: FsGrant) => void): void {\n  withFs(host, body);\n}\n\n// withProcess<T>(host, body: (proc: ProcessGrant) => T): T\n// The process grant (`shell`, `shellTimeout` of std:io, `args` of std:process). Revoked when `body` returns.\nexport function withProcess<T>(host: Host, body: (proc: ProcessGrant) => T): T {\n  const g = grantProcess(host);\n  const r = body(g);\n  grantRevoke(g);\n  return r;\n}\n\n// useProcess(host, body: (proc: ProcessGrant) => void): void -- `withProcess` for a body that returns nothing.\n@Deprecated(\"use withProcess(host, body) with a void body (ADR-0048)\")\nexport function useProcess(host: Host, body: (proc: ProcessGrant) => void): void {\n  withProcess(host, body);\n}\n\n// withStdio<T>(host, body: (stdio: StdioGrant) => T): T\n// The standard input / output grant of std:io (`readLine`, `readBytes`, `writeStdout`). Revoked when `body` returns.\nexport function withStdio<T>(host: Host, body: (stdio: StdioGrant) => T): T {\n  const g = grantStdio(host);\n  const r = body(g);\n  grantRevoke(g);\n  return r;\n}\n\n// useStdio(host, body: (stdio: StdioGrant) => void): void -- `withStdio` for a body that returns nothing.\n@Deprecated(\"use withStdio(host, body) with a void body (ADR-0048)\")\nexport function useStdio(host: Host, body: (stdio: StdioGrant) => void): void {\n  withStdio(host, body);\n}\n\n// withClock<T>(host, body: (clock: ClockGrant) => T): T\n// The clock grant of std:time (`nowMillis`, `monotonicNow`). Revoked when `body` returns.\nexport function withClock<T>(host: Host, body: (clock: ClockGrant) => T): T {\n  const g = grantClock(host);\n  const r = body(g);\n  grantRevoke(g);\n  return r;\n}\n\n// useClock(host, body: (clock: ClockGrant) => void): void -- `withClock` for a body that returns nothing.\n@Deprecated(\"use withClock(host, body) with a void body (ADR-0048)\")\nexport function useClock(host: Host, body: (clock: ClockGrant) => void): void {\n  withClock(host, body);\n}\n\n// withNet<T>(host, body: (net: NetGrant) => T): T\n// The network grant (std:net, ADR-0033): may listen and connect anywhere the host policy allows (unless the policy denies\n// `net`: then every network operation is refused). Narrow it with `useListen` / `useConnect` of std:net. Revoked when\n// `body` returns.\nexport function withNet<T>(host: Host, body: (net: NetGrant) => T): T {\n  const g = grantNet(host);\n  const r = body(g);\n  grantRevoke(g);\n  return r;\n}\n\n// useNet(host, body: (net: NetGrant) => void): void -- `withNet` for a body that returns nothing.\n@Deprecated(\"use withNet(host, body) with a void body (ADR-0048)\")\nexport function useNet(host: Host, body: (net: NetGrant) => void): void {\n  withNet(host, body);\n}\n\n// withHost<T>(host, body: (fs, proc, stdio, clock) => T): T\n// All four grants at once (the usual shape of a command line program's main); the network grant is taken with `withNet`.\n// Revoked in reverse order when `body` returns.\nexport function withHost<T>(\n  host: Host, body: (fs: FsGrant, proc: ProcessGrant, stdio: StdioGrant, clock: ClockGrant) => T\n): T {\n  const f = grantFs(host);\n  const p = grantProcess(host);\n  const s = grantStdio(host);\n  const c = grantClock(host);\n  const r = body(f, p, s, c);\n  grantRevoke(c);\n  grantRevoke(s);\n  grantRevoke(p);\n  grantRevoke(f);\n  return r;\n}\n\n// useHost(host, body: (fs, proc, stdio, clock) => void): void -- `withHost` for a body that returns nothing.\n@Deprecated(\"use withHost(host, body) with a void body (ADR-0048)\")\nexport function useHost(\n  host: Host, body: (fs: FsGrant, proc: ProcessGrant, stdio: StdioGrant, clock: ClockGrant) => void\n): void {\n  withHost(host, body);\n}\n\n// withArgsOnly<T>(proc, body: (p: ProcessGrant) => T): T\n// A process grant that can read `args` but not spawn (`shell` and `shellTimeout` trap with \"capability denied\").\n// Narrowing only restricts: the new grant never has more authority than `proc`.\nexport function withArgsOnly<T>(proc: ProcessGrant, body: (p: ProcessGrant) => T): T {\n  const g = grantArgsOnly(proc);\n  const r = body(g);\n  grantRevoke(g);\n  return r;\n}\n\n// useArgsOnly(proc, body: (p: ProcessGrant) => void): void -- `withArgsOnly` for a body that returns nothing.\n@Deprecated(\"use withArgsOnly(proc, body) with a void body (ADR-0048)\")\nexport function useArgsOnly(proc: ProcessGrant, body: (p: ProcessGrant) => void): void {\n  withArgsOnly(proc, body);\n}\n" });
  out.push(SourceFile { path: "$stdlib/html.or", text: "// std:html -- escaping and rendering for HTML output, and the OX provider for HTML (ADR-0043, ADR-0044).\n//\n// `Html` is rendered, trusted HTML. Only OX, `trustHtml` and this module construct it (`Html` is @Sealed: the compiler\n// rejects the record literal `Html { .. }` and assignment to `.html` outside this module). Everything else is `string`\n// and is escaped on its way into an `Html`, so a string can never become markup by accident.\n// Orin strings are byte strings (see std:utf8): the five escaped characters are ASCII, every other byte\n// (UTF-8 multi-byte sequences included) is copied unchanged.\n// Only HTML text and quoted attribute values are covered. CSS, JavaScript, unquoted attribute values and\n// attribute or tag names are other contexts and are NOT handled by `escape`.\n// A file selects this module as its OX provider with `import ox from \"std:html\";`; `ox()` below is the provider\n// literal (the HTML rules: escape table, void and raw-text elements, URL and event attributes).\n// No platform calls, no additional trusted code, no runtime reflection.\n// Every function is total (never traps) and O(n) in the size of its input and output.\n//\n// Names (ADR-0048). The documentation writes `import * as html from \"std:html\"`: `empty`, `document`, `escape`, `fragment`\n// are generic words that collide with other imports; the module exports `fromText` (not `text`, a module name) and\n// `renderAll` / `renderDocument` (markup to string is `render`). The old names stay as deprecated wrappers for one release.\n\nimport { Markup, AttrRule, Escape } from \"std:ox\";\n\n// Html -- rendered, trusted HTML (a record with the sealed field `html`; build it with `fromText`, `fragment`, `trustHtml` or OX).\n@Sealed\nexport type Html = { html: string; };\n\n// What `safeUrl` returns instead of a URL with a scheme that is not allowed.\nconst UNSAFE_URL: string = \"about:invalid#orin-unsafe-url\";\n\n// True for the five characters `escape` replaces: & < > \" ' (the character code `c` of a byte).\nfunction isSpecial(c: int): bool {\n  return c == 38 || c == 60 || c == 62 || c == 34 || c == 39;\n}\n\n// The entity for the character code `c`: \"\" for every character that is not escaped.\nfunction entityOf(c: int): string {\n  if (c == 38) {\n    return \"&amp;\";\n  }\n  if (c == 60) {\n    return \"&lt;\";\n  }\n  if (c == 62) {\n    return \"&gt;\";\n  }\n  if (c == 34) {\n    return \"&quot;\";\n  }\n  if (c == 39) {\n    return \"&#39;\";\n  }\n  return \"\";\n}\n\n// hasSpecialChars(s): bool -- `s` contains one of & < > \" ' (so `escape(s)` differs from `s`). O(n).\nexport function hasSpecialChars(s: string): bool {\n  let i: usize = 0;\n  while (i < s.length) {\n    if (isSpecial(s.charCodeAt(i))) {\n      return true;\n    }\n    i += 1;\n  }\n  return false;\n}\n\n// needsEscape(s): bool -- use `hasSpecialChars`.\n@Deprecated(\"use hasSpecialChars\")\nexport function needsEscape(s: string): bool {\n  return hasSpecialChars(s);\n}\n\n// escape(s): string -- HTML escaping for text and for (double- or single-quoted) attribute values: & < > \" ' become\n// &amp; &lt; &gt; &quot; &#39;; every other byte is copied unchanged. A string without those characters is\n// returned as is (the hot path: one scan, no allocation); otherwise the result is built from the runs between\n// the special characters, not byte by byte.\n@Ensures(result.indexOf(\"<\").isNone() && result.indexOf(\">\").isNone())\n@Ensures(result.indexOf(\"\\\"\").isNone() && result.indexOf(\"'\").isNone())\n@Ensures(result.length >= s.length)\n@Ensures(!hasSpecialChars(s) ==> result == s)\n@Ensures(hasSpecialChars(s) ==> result.length > s.length)\nexport function escape(s: string): string {\n  const n = s.length;\n  let i: usize = 0;\n  while (i < n && !isSpecial(s.charCodeAt(i))) {\n    i += 1;\n  }\n  if (i == n) {\n    return s;\n  }\n  let out = \"\";\n  let start: usize = 0;\n  while (i < n) {\n    const e = entityOf(s.charCodeAt(i));\n    if (e.length > 0) {\n      out += s.substring(start, i);\n      out += e;\n      start = i + 1;\n    }\n    i += 1;\n  }\n  out += s.substring(start, n);\n  return out;\n}\n\n// The index of the ':' that ends a URL scheme: the first of ':' '/' '?' '#' in `u` when it is a ':', else -1\n// (a relative URL: no scheme).\nfunction schemeEnd(u: string): int {\n  let i: usize = 0;\n  while (i < u.length) {\n    const c = u.charCodeAt(i);\n    if (c == 58) {\n      return i.toInt();\n    }\n    if (c == 47 || c == 63 || c == 35) {\n      return -1;\n    }\n    i += 1;\n  }\n  return -1;\n}\n\n// True when the first `end` bytes of `u`, ASCII-lowercased, are exactly `lit` (`lit` is lowercase ASCII).\nfunction schemeIs(u: string, end: usize, lit: string): bool {\n  if (end != lit.length) {\n    return false;\n  }\n  let i: usize = 0;\n  while (i < end) {\n    let c = u.charCodeAt(i);\n    if (c >= 65 && c <= 90) {\n      c += 32;\n    }\n    if (c != lit.charCodeAt(i)) {\n      return false;\n    }\n    i += 1;\n  }\n  return true;\n}\n\n// hasSafeScheme(u): bool -- the URL rule: true when `u` is relative (no ':' before the first '/', '?' or '#') or its scheme, compared\n// ASCII-case-insensitively, is exactly http, https, mailto or tel. A scheme with a leading space, a control\n// character or an embedded TAB is not one of those, so \" javascript:\" and \"java\\tscript:\" are rejected.\nexport function hasSafeScheme(u: string): bool {\n  const e = schemeEnd(u);\n  if (e < 0) {\n    return true;\n  }\n  const end = e.toUsize();\n  return schemeIs(u, end, \"http\") || schemeIs(u, end, \"https\") || schemeIs(u, end, \"mailto\") || schemeIs(u, end, \"tel\");\n}\n\n// isSafeUrl(u): bool -- `u` may be put into a URL attribute: it passes the scheme rule or it is the constant `safeUrl`\n// substitutes for a rejected URL.\nexport function isSafeUrl(u: string): bool {\n  return hasSafeScheme(u) || u == UNSAFE_URL;\n}\n\n// safeUrl(s): string -- URL attribute sanitising (href, src, action, ...), the rule of Go's html/template: a URL whose scheme is not\n// http, https, mailto or tel (javascript:, vbscript:, data:, ...) becomes \"about:invalid#orin-unsafe-url\"; a\n// relative URL, and an allowed one, is returned unchanged (the same string, no allocation). The result is not\n// HTML-escaped: use `escapeUrl` for the attribute value.\n@Ensures(result == s || result == \"about:invalid#orin-unsafe-url\")\n@Ensures(isSafeUrl(result))\n@Ensures(hasSafeScheme(s) ==> result == s)\n@Ensures(!hasSafeScheme(s) ==> result == \"about:invalid#orin-unsafe-url\")\nexport function safeUrl(s: string): string {\n  if (hasSafeScheme(s)) {\n    return s;\n  }\n  return UNSAFE_URL;\n}\n\n// escapeUrl(s): string -- `escape(safeUrl(s))`: a URL as the value of a quoted attribute.\n@Ensures(result == escape(safeUrl(s)))\n@Ensures(result.indexOf(\"<\").isNone() && result.indexOf(\">\").isNone())\n@Ensures(result.indexOf(\"\\\"\").isNone() && result.indexOf(\"'\").isNone())\nexport function escapeUrl(s: string): string {\n  return escape(safeUrl(s));\n}\n\n// renderAll(xs): string -- the concatenation of the rendered strings of `xs` (the children `{items.map(i => <li>..</li>)}`\n// of OX). O(total length).\n@Ensures(xs.length == 0 ==> result == \"\")\n@Ensures(xs.length == 1 ==> result == xs[0].html)\n@Ensures(xs.length >= 1 ==> result.startsWith(xs[0].html) && result.endsWith(xs[xs.length - 1].html))\n@Inline\nexport function renderAll(xs: Html[]): string {\n  let out = \"\";\n  for (const x of xs) {\n    out += x.html;\n  }\n  return out;\n}\n\n// joinAll(xs): string -- use `renderAll`.\n@Deprecated(\"use renderAll\")\nexport function joinAll(xs: Html[]): string {\n  return renderAll(xs);\n}\n\n// trustHtml(raw): Html -- the explicit, auditable escape hatch: `raw` is HTML and is NOT escaped. Every use is a place to review.\n@Ensures(result.html == raw)\n@Inline\nexport function trustHtml(raw: string): Html {\n  return Html { html: raw };\n}\n\n// fromText(s): Html -- `s` as text: escaped. O(n).\n@Ensures(result.html == escape(s))\nexport function fromText(s: string): Html {\n  return Html { html: escape(s) };\n}\n\n// text(s): Html -- use `fromText` (`text` is also the name of a std module).\n@Deprecated(\"use fromText\")\nexport function text(s: string): Html {\n  return fromText(s);\n}\n\n// empty(): Html -- no markup. O(1).\n@Ensures(result.html == \"\")\nexport function empty(): Html {\n  return Html { html: \"\" };\n}\n\n// fragment(xs): Html -- several elements, one after the other. O(total length).\n@Ensures(result.html == renderAll(xs))\nexport function fragment(xs: Html[]): Html {\n  return Html { html: renderAll(xs) };\n}\n\n// render(h): string -- the markup as a string. O(1).\n@Ensures(result == h.html)\n@Inline\nexport function render(h: Html): string {\n  return h.html;\n}\n\n// renderDocument(h): string -- a whole page: the doctype, then `h`. O(length).\n@Ensures(result.startsWith(\"<!DOCTYPE html>\") && result.endsWith(h.html))\n@Ensures(result.length == 15 + h.html.length)\nexport function renderDocument(h: Html): string {\n  return \"<!DOCTYPE html>\" + h.html;\n}\n\n// document(h): string -- use `renderDocument`.\n@Deprecated(\"use renderDocument\")\nexport function document(h: Html): string {\n  return renderDocument(h);\n}\n\n// isEmpty(h): bool -- `h` renders to nothing. O(1).\n@Ensures(result == (h.html.length == 0))\nexport function isEmpty(h: Html): bool {\n  return h.html.length == 0;\n}\n\n// ox(): Markup<Html> -- the OX provider of HTML (ADR-0044 \xc2\xa75): the compiler reads this literal and calls the named\n// functions. A root of markup is `trustHtml(buffer)`, an `Html` child is `render(h)`, an `Html[]` child is `renderAll(hs)`, a computed\n// string child or attribute value is `escape(s)`; the attributes of `names` take `escapeUrl` (an unsafe scheme such\n// as `javascript:` becomes a harmless constant), attributes starting with `on` are static only (their value is\n// JavaScript). `escapes` is the compile-time twin of `escape` (tests/next/run/ox_escape_diff.or compares them).\nexport function ox(): Markup<Html> {\n  return Markup<Html> {\n    wrap: trustHtml,\n    embed: render,\n    embedAll: renderAll,\n    text: escape,\n    attr: escape,\n    rules: [\n      AttrRule {\n        names: [\"href\", \"src\", \"action\", \"formaction\", \"cite\", \"poster\", \"background\", \"manifest\", \"ping\", \"data\", \"xlink-href\"],\n        prefix: \"\",\n        convert: Some(escapeUrl),\n      },\n      AttrRule { names: [], prefix: \"on\", convert: None },\n    ],\n    escapes: [\n      Escape { char: \"&\", encoded: \"&amp;\" },\n      Escape { char: \"<\", encoded: \"&lt;\" },\n      Escape { char: \">\", encoded: \"&gt;\" },\n      Escape { char: \"\\\"\", encoded: \"&quot;\" },\n      Escape { char: \"'\", encoded: \"&#39;\" },\n    ],\n    voidTags: [\"area\", \"base\", \"br\", \"col\", \"embed\", \"hr\", \"img\", \"input\", \"link\", \"meta\", \"source\", \"track\", \"wbr\"],\n    voidEnd: \">\",\n    rawTextTags: [\"script\", \"style\"],\n    presenceAttrs: true,\n  };\n}\n" });
  out.push(SourceFile { path: "$stdlib/http.or", text: "// std:http -- the pure part of HTTP/1.1 (RFC 9110, RFC 9112): message types, an incremental request and response\n// parser, and a serializer. Pure safe Orin over `std:bytes`: no sockets, no I/O, no grants, no C (ADR-0030 \xc2\xa73,\n// layer \"protocols\"). The network part (`std:net`, the server loop) comes later with ADR-0033.\n//\n// Why strict. Most HTTP request smuggling and response splitting attacks work because two parsers on one path\n// disagree about where a message ends or which header says what. This module therefore REJECTS every ambiguity\n// instead of guessing (RFC 9112 \xc2\xa76.3, \xc2\xa711.2 and \xc2\xa711.3):\n//\n//   * both `Content-Length` and `Transfer-Encoding`, a duplicate or non-numeric `Content-Length`, a duplicate\n//     `Transfer-Encoding`, any transfer coding other than `chunked`;\n//   * obs-fold (a header line that starts with SP or HTAB), whitespace between a field name and the colon, a bare\n//     LF or a bare CR where CRLF is required, any control character or NUL in a start line, field, chunk header\n//     or chunk extension, invalid token characters in a method or field name;\n//   * chunk sizes that are empty, not hexadecimal (`-1`, `0x10`, `+5`), or larger than the remaining body limit\n//     (so the size can never overflow); a chunk that is not followed by CRLF;\n//   * HTTP/1.1 requests without exactly one valid `Host` field, framing fields (Content-Length, Transfer-Encoding,\n//     Trailer, Host) in trailers.\n//\n// Limits are part of the parser (`HttpLimits`, checked by `isValidLimits`): request/status line length, header line length,\n// total header section size, header count, chunk header line length and body size. A message that exceeds a limit\n// is an error at the first byte over the limit, never a truncated parse.\n//\n// Incremental parsing. `RequestParser.feed(chunk)` takes bytes in arbitrary chunks (as `recv` delivers them) and\n// answers `NeedMore` (every byte of the chunk was consumed into the parser state), `Done(message, used)` (the\n// message is complete; `used` bytes of THIS chunk belonged to it, the rest `chunk[used..]` is the start of the next\n// pipelined message) or `Failed(HttpError)` (`kind` = the violated rule, `offset` = byte offset from the start of the\n// message; the text is `httpErrorMessage(e)`).\n// A partial message is never returned as complete. The result for a message is independent of how the bytes are\n// split into chunks (tests: every split point, 1-byte chunks, random splits).\n//\n// The state machine (explicit: `S_*` constants, `edgeAllowed`, class invariants). A request starts in METHOD, a\n// response in VERSION:\n//\n//   request   METHOD -> TARGET -> VERSION -> START_LF\n//   response  VERSION -> CODE -> REASON -> START_LF\n//   START_LF -> HDR_LINE <-> (HDR_NAME -> HDR_OWS -> HDR_VALUE -> HDR_LF)     one cycle per header field\n//   HDR_LINE -> HEAD_END_LF          the empty line; then, decided by the framing rules (RFC 9112 \xc2\xa76.3):\n//        HEAD_END_LF -> DONE                          no body (or Content-Length 0, HEAD, 1xx, 204, 304)\n//        HEAD_END_LF -> BODY -> DONE                  Content-Length\n//        HEAD_END_LF -> BODY_CLOSE -> (atEof) DONE    responses only: the body ends when the connection closes\n//        HEAD_END_LF -> CHUNK_SIZE -> [CHUNK_BWS] -> [CHUNK_EXT] -> CHUNK_SIZE_LF        Transfer-Encoding: chunked\n//          CHUNK_SIZE_LF -> CHUNK_DATA -> CHUNK_CR -> CHUNK_LF -> CHUNK_SIZE              (size > 0)\n//          CHUNK_SIZE_LF -> HDR_LINE ... HEAD_END_LF -> DONE                               (size 0: the trailer section)\n//   any non-terminal state -> ERROR (sticky); DONE and ERROR are terminal until `reset()`.\n//\n// Algorithm. One forward pass, no backtracking, no regex, no look-ahead. Bytes are classified by a 256-entry table\n// (`HTTP_CLASS`: control, LF, CR, HTAB, SP, obs-text, other VCHAR, `:`, `;`, token symbol, letter, hex letter,\n// digit; ordered so that \"is a token character\" is `class >= 10` and \"may occur in a field value\" is `class >= 3`)\n// and `HTTP_HEXV` (hex digit value or 16). Orin has no constant arrays, so both are string constants read with\n// `charCodeAt` like the DFA tables of std:utf8. Runs of ordinary bytes (a method, a header name, a header value) are\n// scanned in a tight loop and handled once per run, not once per byte; the state changes once per token. The loops\n// index the chunk's storage array (`Bytes.storage`, no copy) instead of calling `Bytes.at` per byte; a body is a\n// slice of the chunk and is never scanned. Measured throughput and the cost model: docs/std.md.\n//\n// Contract standard (ADR-0030 \xc2\xa73): classes carry `@Invariant`s that `orin test` checks after every public method;\n// `Headers`, `Status`, `Request`, `Response` validate in their constructors in EVERY build (a header with CR/LF\n// cannot be built: header injection is impossible by construction), the guards that run in every build are loops\n// (`allTokens`, `allFieldValues`: no closure call per element on the hot path) while contract clauses may state the\n// same facts with `every` / `some` / `filter` (ADR-0031 A: `Headers.has`, `countOf`, `getAll`), and\n// `serializeRequest` / `serializeResponse` ENSURE that the parser accepts the output and reproduces the message\n// (the round-trip contract).\n//\n// Not covered: HTTP/2 and HTTP/3, TLS, sockets, content codings (gzip), `Expect: 100-continue` handling,\n// connection management, URI parsing beyond the shape checks of `isValidTarget`, cookies and any header semantics\n// other than the framing and `Host` rules above.\n//\n// Internal helpers (ADR-0048 section 7.3). The rule predicates and tables below the line \"character classes\" (`charClass`,\n// `isTokenChar`, `isFieldByte`, `isToken`, `isFieldValue`, `isReasonPhrase`, `isHostValue`, `parseContentLength`,\n// `toLowerAscii`, `standardReason`, `statusHasNoBody`, `isValidTarget`, `isValidMethod`, `edgeAllowed`, `stateName`,\n// `hexString`, `httpError`) are NOT API: they exist to state the contracts and to be tested. They belong in\n// `std:http/internal`; the loader has no library submodules yet (and no warning for importing `internal` ones), so they stay\n// exported from here, each marked \"Internal\" in its comment, until it has. `eqIgnoreCase` is a string utility waiting for\n// the string builtins (7.4).\n\nimport { Bytes, ByteBuilder, fromString, empty } from \"std:bytes\";\n\n// ------------------------------------------------------------------------------------ character classes\n\n// Class codes of `HTTP_CLASS` (see the algorithm note above). Generated from the RFC 9110 / 9112 character sets\n// by tools/gen_http_tables.py; tests/std/http_test.or recomputes every entry from the RFC definitions.\nconst C_CTL: int = 0;\nconst C_LF: int = 1;\nconst C_CR: int = 2;\nconst C_HTAB: int = 3;\nconst C_SP: int = 4;\nconst C_OBS: int = 5;\nconst C_COLON: int = 7;\nconst C_SEMI: int = 8;\nconst C_TOKEN: int = 10;\nconst C_HEXALPHA: int = 12;\nconst C_DIGIT: int = 13;\n\nconst HTTP_CLASS: string = \"\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x03\\x01\\x00\\x00\\x02\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x04\\x0a\\x06\\x0a\\x0a\\x0a\\x0a\\x0a\\x06\\x06\\x0a\\x0a\\x06\\x0a\\x0a\\x06\\x0d\\x0d\\x0d\\x0d\\x0d\\x0d\\x0d\\x0d\\x0d\\x0d\\x07\\x08\\x06\\x06\\x06\\x06\\x06\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x06\\x06\\x06\\x0a\\x0a\\x0a\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x0b\\x06\\x0a\\x06\\x0a\\x00\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\\x05\";\nconst HTTP_HEXV: string = \"\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x00\\x01\\x02\\x03\\x04\\x05\\x06\\x07\\x08\\x09\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x0a\\x0b\\x0c\\x0d\\x0e\\x0f\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x0a\\x0b\\x0c\\x0d\\x0e\\x0f\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\\x10\";\n\n\n// charClass(c): int -- the class code of byte value c (0..255). O(1). Internal.\n@Requires(c >= 0 && c <= 255)\n@Ensures(result >= 0 && result <= 13)\nexport function charClass(c: int): int {\n  return HTTP_CLASS.charCodeAt(c.toUsize());\n}\n\n// isTokenChar(c): bool -- c is a `tchar` (RFC 9110 \xc2\xa75.6.2): ALPHA, DIGIT or one of !#$%&'*+-.^_`|~. O(1). Internal.\n@Requires(c >= 0 && c <= 255)\nexport function isTokenChar(c: int): bool {\n  return HTTP_CLASS.charCodeAt(c.toUsize()) >= C_TOKEN;\n}\n\n// isFieldByte(c): bool -- c may occur inside a field value or a reason phrase: HTAB, SP, VCHAR or obs-text. O(1). Internal.\n@Requires(c >= 0 && c <= 255)\nexport function isFieldByte(c: int): bool {\n  return HTTP_CLASS.charCodeAt(c.toUsize()) >= C_HTAB;\n}\n\n// isOws(c): SP or HTAB. O(1).\nfunction isOws(c: int): bool {\n  return c == 32 || c == 9;\n}\n\n// lowerAscii(c): the lower-case form of an ASCII letter code, other codes unchanged. O(1).\nfunction lowerAscii(c: int): int {\n  if (c >= 65 && c <= 90) {\n    return c + 32;\n  }\n  return c;\n}\n\n// eqIgnoreCase(a, b): bool -- equal after ASCII lower-casing (header names, RFC 9110 \xc2\xa75.1). O(n). A string utility;\n// it moves to the string builtins (ADR-0048 7.4).\n@Ensures(result ==> a.length == b.length)\nexport function eqIgnoreCase(a: string, b: string): bool {\n  if (a.length != b.length) {\n    return false;\n  }\n  let i: usize = 0;\n  while (i < a.length) {\n    if (lowerAscii(a.charCodeAt(i)) != lowerAscii(b.charCodeAt(i))) {\n      return false;\n    }\n    i += 1;\n  }\n  return true;\n}\n\n// toLowerAscii(s): string -- s with ASCII letters lower-cased; other bytes (including obs-text) unchanged. O(n). Internal\n// (ADR-0048 7.4: becomes `std:http/internal`).\n@Ensures(result.length == s.length)\n@Ensures(s.length > 0 ==> result.charCodeAt(0) == lowerAscii(s.charCodeAt(0)))\n@Ensures(s.length > 0 ==> result.charCodeAt(s.length - 1) == lowerAscii(s.charCodeAt(s.length - 1)))\nexport function toLowerAscii(s: string): string {\n  let out = \"\";\n  let i: usize = 0;\n  while (i < s.length) {\n    out += String.fromCharCode(lowerAscii(s.charCodeAt(i)));\n    i += 1;\n  }\n  return out;\n}\n\n// isToken(s): bool -- a non-empty run of token characters (a method or a field name). O(n). Internal.\n@Ensures(result ==> s.length > 0)\nexport function isToken(s: string): bool {\n  if (s.length == 0) {\n    return false;\n  }\n  let i: usize = 0;\n  while (i < s.length) {\n    if (HTTP_CLASS.charCodeAt(s.charCodeAt(i).toUsize()) < C_TOKEN) {\n      return false;\n    }\n    i += 1;\n  }\n  return true;\n}\n\n// isFieldValue(s): bool -- a valid field value: only HTAB, SP, VCHAR and obs-text (so no CR, LF, NUL or other control\n// character), no leading or trailing SP/HTAB (the parser strips optional whitespace, so a stored value is\n// canonical). The empty string is valid. O(n). Internal.\n@Ensures(result ==> s.length == 0 || (!isOws(s.charCodeAt(0)) && !isOws(s.charCodeAt(s.length - 1))))\nexport function isFieldValue(s: string): bool {\n  if (s.length == 0) {\n    return true;\n  }\n  if (isOws(s.charCodeAt(0)) || isOws(s.charCodeAt(s.length - 1))) {\n    return false;\n  }\n  let i: usize = 0;\n  while (i < s.length) {\n    if (HTTP_CLASS.charCodeAt(s.charCodeAt(i).toUsize()) < C_HTAB) {\n      return false;\n    }\n    i += 1;\n  }\n  return true;\n}\n\n// isReasonPhrase(s): bool -- (internal) `*( HTAB / SP / VCHAR / obs-text )`; may be empty and may have leading or trailing blanks\n// (the status line keeps it byte for byte). O(n).\nexport function isReasonPhrase(s: string): bool {\n  let i: usize = 0;\n  while (i < s.length) {\n    if (HTTP_CLASS.charCodeAt(s.charCodeAt(i).toUsize()) < C_HTAB) {\n      return false;\n    }\n    i += 1;\n  }\n  return true;\n}\n\n// Characters of a `Host` value / authority (RFC 3986 reg-name, IP-literal and port, without userinfo):\n// unreserved, `%`, sub-delims, `:`, `[`, `]`.\nfunction isHostChar(c: int): bool {\n  if ((c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122)) {\n    return true;\n  }\n  return c == 45 || c == 46 || c == 95 || c == 126 || c == 37 || c == 33 || c == 36 || c == 38 || c == 39\n    || c == 40 || c == 41 || c == 42 || c == 43 || c == 44 || c == 59 || c == 61 || c == 58 || c == 91 || c == 93;\n}\n\n// isHostValue(s): bool -- (internal) a plausible `Host` field value or CONNECT authority: only host characters (no SP, `/`, `@`, `?`,\n// `#`). The empty string is allowed here (an empty authority is legal in `Host`). O(n).\nexport function isHostValue(s: string): bool {\n  let i: usize = 0;\n  while (i < s.length) {\n    if (!isHostChar(s.charCodeAt(i))) {\n      return false;\n    }\n    i += 1;\n  }\n  return true;\n}\n\n// parseContentLength(v): Option<usize> -- (internal) the value of a `Content-Length` field: 1 to 18 decimal digits (so it fits every integer\n// type; larger values are refused instead of overflowing). No sign, no blanks, no list. O(n).\n@Ensures(result.isSome() ==> v.length >= 1 && v.length <= 18)\nexport function parseContentLength(v: string): Option<usize> {\n  if (v.length == 0 || v.length > 18) {\n    return None;\n  }\n  let n: usize = 0;\n  let i: usize = 0;\n  while (i < v.length) {\n    const c = v.charCodeAt(i);\n    if (c < 48 || c > 57) {\n      return None;\n    }\n    n = n * 10 + (c - 48).toUsize();\n    i += 1;\n  }\n  return Some(n);\n}\n\n// A request-target may contain only 0x21..0x7E (everything else must be percent-encoded) and no fragment `#`.\nfunction isTargetChars(s: string): bool {\n  if (s.length == 0) {\n    return false;\n  }\n  let i: usize = 0;\n  while (i < s.length) {\n    const c = s.charCodeAt(i);\n    if (HTTP_CLASS.charCodeAt(c.toUsize()) < 6 || c == 35) {\n      return false;\n    }\n    i += 1;\n  }\n  return true;\n}\n\n// scheme \"://\" rest, scheme = ALPHA *( ALPHA / DIGIT / \"+\" / \"-\" / \".\" )  (absolute-form, RFC 9112 \xc2\xa73.2.2).\nfunction isAbsoluteForm(s: string): bool {\n  if (s.length < 4) {\n    return false;\n  }\n  const c0 = lowerAscii(s.charCodeAt(0));\n  if (c0 < 97 || c0 > 122) {\n    return false;\n  }\n  let i: usize = 1;\n  while (i < s.length) {\n    const c = s.charCodeAt(i);\n    const l = lowerAscii(c);\n    if (!((l >= 97 && l <= 122) || (c >= 48 && c <= 57) || c == 43 || c == 45 || c == 46)) {\n      break;\n    }\n    i += 1;\n  }\n  return i + 3 < s.length && s.charCodeAt(i) == 58 && s.charCodeAt(i + 1) == 47 && s.charCodeAt(i + 2) == 47;\n}\n\n// ----------------------------------------------------------------------------------------- small types\n\n// The protocol versions this module speaks. Other versions (`HTTP/0.9`, `HTTP/2.0`) are rejected by the parsers.\nexport type HttpVersion = Http10 | Http11;\n\n// versionText(v): string -- \"HTTP/1.0\" or \"HTTP/1.1\". O(1).\n@Ensures(result.length == 8)\nexport function versionText(v: HttpVersion): string {\n  return match (v) {\n    Http10 => \"HTTP/1.0\",\n    Http11 => \"HTTP/1.1\"\n  };\n}\n\n// versionMinor(v): int -- 0 or 1. O(1).\n@Ensures(result == 0 || result == 1)\nexport function versionMinor(v: HttpVersion): int {\n  return match (v) {\n    Http10 => 0,\n    Http11 => 1\n  };\n}\n\n// The request methods of RFC 9110 \xc2\xa79 plus RFC 5789 `PATCH`, and `Ext(token)` for any other token. The canonical\n// form (what the parser produces and the invariants of `Request` demand): a standard method is never an `Ext`.\nexport type Method = Get | Head | Post | Put | Delete | Connect | Options | Trace | Patch | Ext(string);\n\n// methodName(m): string -- the method token, e.g. \"GET\". O(1).\n@Ensures(result.length > 0 || !isValidMethod(m))\nexport function methodName(m: Method): string {\n  return match (m) {\n    Get => \"GET\",\n    Head => \"HEAD\",\n    Post => \"POST\",\n    Put => \"PUT\",\n    Delete => \"DELETE\",\n    Connect => \"CONNECT\",\n    Options => \"OPTIONS\",\n    Trace => \"TRACE\",\n    Patch => \"PATCH\",\n    Ext(t) => t\n  };\n}\n\n// isStandardMethodName(t): t is the exact (case-sensitive) name of one of the nine standard methods. O(1).\nfunction isStandardMethodName(t: string): bool {\n  return t == \"GET\" || t == \"HEAD\" || t == \"POST\" || t == \"PUT\" || t == \"DELETE\" || t == \"CONNECT\" || t == \"OPTIONS\"\n    || t == \"TRACE\" || t == \"PATCH\";\n}\n\n// isValidMethod(m): bool -- (internal) canonical and well-formed: a standard method, or `Ext(t)` with a token `t` that is not a\n// standard method name. O(n).\nexport function isValidMethod(m: Method): bool {\n  return match (m) {\n    Ext(t) => isToken(t) && !isStandardMethodName(t),\n    _ => true\n  };\n}\n\n// methodFromToken(t): Option<Method> -- the method with name t; None when t is not a token. Method names are case-sensitive:\n// \"get\" is `Ext(\"get\")`. O(n).\n@Ensures(result.isSome() == isToken(t))\n@Ensures(result.isSome() ==> isValidMethod(result.unwrap()) && methodName(result.unwrap()) == t)\nexport function methodFromToken(t: string): Option<Method> {\n  if (!isToken(t)) {\n    return None;\n  }\n  return match (t) {\n    \"GET\" => Some(Get),\n    \"HEAD\" => Some(Head),\n    \"POST\" => Some(Post),\n    \"PUT\" => Some(Put),\n    \"DELETE\" => Some(Delete),\n    \"CONNECT\" => Some(Connect),\n    \"OPTIONS\" => Some(Options),\n    \"TRACE\" => Some(Trace),\n    \"PATCH\" => Some(Patch),\n    _ => Some(Ext(t))\n  };\n}\n\n// isConnect(m) / isOptions(m): used by the request-target rules.\nfunction isConnect(m: Method): bool {\n  return match (m) {\n    Connect => true,\n    _ => false\n  };\n}\n\nfunction isOptions(m: Method): bool {\n  return match (m) {\n    Options => true,\n    _ => false\n  };\n}\n\n// methodEquals(a, b): bool -- the same method. O(n).\nexport function methodEquals(a: Method, b: Method): bool {\n  return methodName(a) == methodName(b);\n}\n\n// isValidTarget(m, target): bool -- (internal) the request-target has a legal shape for the method (RFC 9112 \xc2\xa73.2): `CONNECT` takes an\n// authority (`host:port`); `OPTIONS` also takes `*`; every method takes origin-form (`/path?query`) or\n// absolute-form (`scheme://authority/path`). Only the characters 0x21..0x7E occur and there is no fragment. O(n).\n@Ensures(result ==> target.length > 0)\nexport function isValidTarget(m: Method, target: string): bool {\n  if (isConnect(m)) {\n    return target.length > 0 && isHostValue(target);\n  }\n  if (!isTargetChars(target)) {\n    return false;\n  }\n  if (target == \"*\") {\n    return isOptions(m);\n  }\n  return target.charCodeAt(0) == 47 || isAbsoluteForm(target);\n}\n\n// ----------------------------------------------------------------------------------------------- errors\n\n// Why a message was refused or could not be built. One variant per rule, so that callers (and tests) can tell the cases\n// apart. The last four are only produced by the constructors (`Status.tryNew`, `Request.tryNew`, `Response.tryNew`); the\n// parsers produce the others.\nexport type HttpErrorKind =\n  InvalidMethod | InvalidTarget | InvalidVersion | UnsupportedVersion | InvalidStatusCode | InvalidStatusLine\n  | InvalidFieldName | MissingColon | SpaceBeforeColon | InvalidFieldValue | ObsFold | BareLf | BareCr\n  | StartLineTooLong | HeaderLineTooLong | HeadersTooLarge | TooManyHeaders | BodyTooLarge | ChunkLineTooLong\n  | InvalidContentLength | DuplicateContentLength | ContentLengthWithTransferEncoding | DuplicateTransferEncoding\n  | UnsupportedTransferEncoding | ForbiddenFraming | MissingHost | DuplicateHost | InvalidHost\n  | InvalidChunkSize | InvalidChunkExtension | InvalidChunkTerminator | ForbiddenTrailer\n  | UnexpectedEof | ParserFinished\n  | InvalidStatusReason | UnexpectedBody | BodyLengthMismatch | MissingFraming;\n\n// HttpReason -- the former name of `HttpErrorKind` (the variants `Bad*` are now `Invalid*`).\n@Deprecated(\"use HttpErrorKind; the variants Bad* are now Invalid* (BadHeaderName is InvalidFieldName, BadHeaderValue is InvalidFieldValue)\")\nexport type HttpReason = HttpErrorKind;\n\n// httpErrorKindName(k): string -- the variant name, stable (for logs and tests). Never empty. O(1).\n@Ensures(result.length > 0)\nexport function httpErrorKindName(k: HttpErrorKind): string {\n  return match (k) {\n    InvalidMethod => \"InvalidMethod\",\n    InvalidTarget => \"InvalidTarget\",\n    InvalidVersion => \"InvalidVersion\",\n    UnsupportedVersion => \"UnsupportedVersion\",\n    InvalidStatusCode => \"InvalidStatusCode\",\n    InvalidStatusLine => \"InvalidStatusLine\",\n    InvalidFieldName => \"InvalidFieldName\",\n    MissingColon => \"MissingColon\",\n    SpaceBeforeColon => \"SpaceBeforeColon\",\n    InvalidFieldValue => \"InvalidFieldValue\",\n    ObsFold => \"ObsFold\",\n    BareLf => \"BareLf\",\n    BareCr => \"BareCr\",\n    StartLineTooLong => \"StartLineTooLong\",\n    HeaderLineTooLong => \"HeaderLineTooLong\",\n    HeadersTooLarge => \"HeadersTooLarge\",\n    TooManyHeaders => \"TooManyHeaders\",\n    BodyTooLarge => \"BodyTooLarge\",\n    ChunkLineTooLong => \"ChunkLineTooLong\",\n    InvalidContentLength => \"InvalidContentLength\",\n    DuplicateContentLength => \"DuplicateContentLength\",\n    ContentLengthWithTransferEncoding => \"ContentLengthWithTransferEncoding\",\n    DuplicateTransferEncoding => \"DuplicateTransferEncoding\",\n    UnsupportedTransferEncoding => \"UnsupportedTransferEncoding\",\n    ForbiddenFraming => \"ForbiddenFraming\",\n    MissingHost => \"MissingHost\",\n    DuplicateHost => \"DuplicateHost\",\n    InvalidHost => \"InvalidHost\",\n    InvalidChunkSize => \"InvalidChunkSize\",\n    InvalidChunkExtension => \"InvalidChunkExtension\",\n    InvalidChunkTerminator => \"InvalidChunkTerminator\",\n    ForbiddenTrailer => \"ForbiddenTrailer\",\n    UnexpectedEof => \"UnexpectedEof\",\n    ParserFinished => \"ParserFinished\",\n    InvalidStatusReason => \"InvalidStatusReason\",\n    UnexpectedBody => \"UnexpectedBody\",\n    BodyLengthMismatch => \"BodyLengthMismatch\",\n    MissingFraming => \"MissingFraming\"\n  };\n}\n\n// httpErrorKindText(k): string -- a sentence naming the violated rule. Never empty. O(1).\n@Ensures(result.length > 0)\nexport function httpErrorKindText(k: HttpErrorKind): string {\n  return match (k) {\n    InvalidMethod => \"invalid character in the method (not a token)\",\n    InvalidTarget => \"invalid request-target\",\n    InvalidVersion => \"malformed HTTP version\",\n    UnsupportedVersion => \"unsupported HTTP version (only HTTP/1.0 and HTTP/1.1)\",\n    InvalidStatusCode => \"the status code must be three digits in 100..599\",\n    InvalidStatusLine => \"malformed status line\",\n    InvalidFieldName => \"invalid character in a field name (not a token)\",\n    MissingColon => \"a header line without a colon\",\n    SpaceBeforeColon => \"whitespace between the field name and the colon\",\n    InvalidFieldValue => \"control character in a field value\",\n    ObsFold => \"obsolete line folding (a header line that starts with SP or HTAB)\",\n    BareLf => \"bare LF: a line must end with CRLF\",\n    BareCr => \"bare CR: a CR must be followed by LF\",\n    StartLineTooLong => \"the start line exceeds the limit\",\n    HeaderLineTooLong => \"a header line exceeds the limit\",\n    HeadersTooLarge => \"the header section exceeds the limit\",\n    TooManyHeaders => \"too many header fields\",\n    BodyTooLarge => \"the body exceeds the limit\",\n    ChunkLineTooLong => \"a chunk header line exceeds the limit\",\n    InvalidContentLength => \"invalid Content-Length (1 to 18 digits expected)\",\n    DuplicateContentLength => \"duplicate Content-Length\",\n    ContentLengthWithTransferEncoding => \"both Content-Length and Transfer-Encoding (request smuggling)\",\n    DuplicateTransferEncoding => \"duplicate Transfer-Encoding\",\n    UnsupportedTransferEncoding => \"unsupported Transfer-Encoding (only `chunked` on HTTP/1.1)\",\n    ForbiddenFraming => \"Content-Length or Transfer-Encoding is not allowed in this message\",\n    MissingHost => \"an HTTP/1.1 request needs a Host field\",\n    DuplicateHost => \"duplicate Host field\",\n    InvalidHost => \"invalid Host field value\",\n    InvalidChunkSize => \"invalid chunk size (hexadecimal digits expected)\",\n    InvalidChunkExtension => \"control character in a chunk extension\",\n    InvalidChunkTerminator => \"chunk data is not followed by CRLF\",\n    ForbiddenTrailer => \"a framing field is not allowed in the trailer section\",\n    UnexpectedEof => \"the input ended before the message was complete\",\n    ParserFinished => \"the parser already finished its message (call reset())\",\n    InvalidStatusReason => \"invalid character in the reason phrase\",\n    UnexpectedBody => \"a message that never has a body has a body or trailers\",\n    BodyLengthMismatch => \"Content-Length does not match the length of the body\",\n    MissingFraming => \"a body needs Content-Length or Transfer-Encoding\"\n  };\n}\n\n\n// reasonName(k): string -- use `httpErrorKindName`.\n@Deprecated(\"use httpErrorKindName\")\nexport function reasonName(k: HttpErrorKind): string {\n  return httpErrorKindName(k);\n}\n\n// reasonText(k): string -- use `httpErrorKindText`.\n@Deprecated(\"use httpErrorKindText\")\nexport function reasonText(k: HttpErrorKind): string {\n  return httpErrorKindText(k);\n}\n\n// The error of a parser or of a message constructor. `offset` is the 0-based byte offset (from the first byte of the\n// message) of the byte that violates the rule (for limits: the first byte over the limit; for end-of-headers rules such\n// as Content-Length + Transfer-Encoding: the CR of the empty line; for a duplicate field: the first byte of the offending\n// line; for `UnexpectedEof`: the number of bytes received). Errors of the constructors have no input: their offset is 0,\n// except `InvalidStatusReason`, whose offset is the index of the offending byte of the phrase. The text is\n// `httpErrorMessage(e)`.\nexport type HttpError = { kind: HttpErrorKind; offset: usize; };\n\n// httpError(offset, kind): HttpError -- the error with this kind at this byte offset. O(1).\n@Ensures(result.offset == offset)\nexport function httpError(offset: usize, kind: HttpErrorKind): HttpError {\n  return HttpError { kind: kind, offset: offset };\n}\n\n// httpErrorMessage(e): string -- \"<sentence for the kind> at byte <offset>\". Never empty. O(1).\n@Ensures(result.length > 0)\nexport function httpErrorMessage(e: HttpError): string {\n  return `${httpErrorKindText(e.kind)} at byte ${e.offset.toString()}`;\n}\n\n// The answer of a parser: the message is incomplete, complete, or refused. `Done(message, used)`: `used` is the\n// number of bytes of the chunk just fed that belong to the message.\nexport type ParseResult<T> = NeedMore | Done(T, usize) | Failed(HttpError);\n\n\n// ---------------------------------------------------------------------------------------------- Headers\n\n// Why a header field was refused: `InvalidHeaderName` (not a non-empty token), `InvalidHeaderValue` (a control character\n// or a leading or trailing blank), `MismatchedLists` (`tryHeaders` got lists of different lengths).\nexport type HeaderErrorKind = InvalidHeaderName | InvalidHeaderValue | MismatchedLists;\n\n// The error of `Headers.add`, `Headers.set` and `tryHeaders`. The text is `headerErrorMessage(e)`.\nexport type HeaderError = { kind: HeaderErrorKind; };\n\n// headerErrorMessage(e): string -- a sentence. Never empty. O(1).\n@Ensures(result.length > 0)\nexport function headerErrorMessage(e: HeaderError): string {\n  return match (e.kind) {\n    InvalidHeaderName => \"invalid field name: a non-empty token is required\",\n    InvalidHeaderValue => \"invalid field value: no control characters (CR, LF, NUL, ...) and no leading or trailing blanks\",\n    MismatchedLists => \"the lists of field names and field values differ in length\"\n  };\n}\n\n// Traps in every build (also without contract checking) when `ok` is false. The guard of the constructors that\n// make invalid values impossible: a failed `@Requires` is also a trap in a checked build, this keeps it so in\n// the unchecked one.\nfunction enforce(ok: bool, what: string): void {\n  if (!ok) {\n    const r: Result<int, string> = Err(what);\n    r.unwrap();\n  }\n}\n\n// allTokens(xs): every element is a token. Loop-based so that contracts can use it. Internal.\nfunction allTokens(xs: string[]): bool {\n  let i: usize = 0;\n  while (i < xs.length) {\n    if (!isToken(xs[i])) {\n      return false;\n    }\n    i += 1;\n  }\n  return true;\n}\n\n// allFieldValues(xs): every element is a valid field value. Internal.\nfunction allFieldValues(xs: string[]): bool {\n  let i: usize = 0;\n  while (i < xs.length) {\n    if (!isFieldValue(xs[i])) {\n      return false;\n    }\n    i += 1;\n  }\n  return true;\n}\n\nfunction headerError(kind: HeaderErrorKind): HeaderError {\n  return HeaderError { kind: kind };\n}\n\n// An ordered list of header fields (also used for trailers). Names are case-insensitive for every lookup and are\n// stored as given (so a message serializes the way it was written); the same name may occur several times and the\n// order of all fields is kept. Invariants: as many values as names, every name is a token, every value is a\n// valid field value (no CR, LF, NUL or other control character, no leading or trailing blanks). They are checked\n// by the constructor in every build and cannot be broken afterwards: `add` and `set` validate before they change\n// anything, so a header value can never smuggle a line break into a serialized message.\n@Invariant(this.names.length == this.values.length)\n@Invariant(allTokens(this.names))\n@Invariant(allFieldValues(this.values))\nexport class Headers {\n  private names: string[];\n  private values: string[];\n\n  // new Headers(names, values) -- the fields (names[i], values[i]) in order. Traps (in every build) when the lists\n  // differ in length or an element is not a token / valid value; `tryHeaders` answers a Result instead.\n  @Requires(names.length == values.length && allTokens(names) && allFieldValues(values))\n  constructor(names: string[], values: string[]) {\n    this.names = names;\n    this.values = values;\n    enforce(names.length == values.length && allTokens(names) && allFieldValues(values), \"invalid Headers\");\n  }\n\n  // size(): usize -- number of fields. O(1).\n  @Ensures(result == this.names.length)\n  size(): usize {\n    return this.names.length;\n  }\n\n  // count(): usize -- use `size()`.\n  @Deprecated(\"use size()\")\n  count(): usize {\n    return this.names.length;\n  }\n\n  // isEmpty(): bool -- there are no fields. O(1).\n  @Ensures(result == (this.size() == 0))\n  isEmpty(): bool {\n    return this.names.length == 0;\n  }\n\n  // nameAt(i): string -- the name of the i-th field, as written. Traps unless i < size(). O(1).\n  @Requires(i < this.names.length)\n  @Ensures(isToken(result))\n  nameAt(i: usize): string {\n    return this.names[i];\n  }\n\n  // valueAt(i): string -- the value of the i-th field. Traps unless i < size(). O(1).\n  @Requires(i < this.names.length)\n  @Ensures(isFieldValue(result))\n  valueAt(i: usize): string {\n    return this.values[i];\n  }\n\n  // countOf(name): usize -- number of fields called `name` (case-insensitive). O(size).\n  @Ensures(result <= this.names.length)\n  @Ensures(result == this.names.filter(n => eqIgnoreCase(n, name)).length)\n  countOf(name: string): usize {\n    let n: usize = 0;\n    let i: usize = 0;\n    while (i < this.names.length) {\n      if (eqIgnoreCase(this.names[i], name)) {\n        n += 1;\n      }\n      i += 1;\n    }\n    return n;\n  }\n\n  // has(name): bool -- some field is called `name` (case-insensitive). O(size).\n  @Ensures(result == (this.countOf(name) > 0))\n  @Ensures(result == this.names.some(n => eqIgnoreCase(n, name)))\n  has(name: string): bool {\n    let i: usize = 0;\n    while (i < this.names.length) {\n      if (eqIgnoreCase(this.names[i], name)) {\n        return true;\n      }\n      i += 1;\n    }\n    return false;\n  }\n\n  // get(name): Option<string> -- the value of the first field called `name`, or None. O(size).\n  @Ensures(result.isSome() == this.has(name))\n  @Ensures(result.isSome() ==> isFieldValue(result.unwrap()))\n  get(name: string): Option<string> {\n    let i: usize = 0;\n    while (i < this.names.length) {\n      if (eqIgnoreCase(this.names[i], name)) {\n        return Some(this.values[i]);\n      }\n      i += 1;\n    }\n    return None;\n  }\n\n  // getAll(name): string[] -- the values of all fields called `name`, in order. O(size).\n  @Ensures(result.length == this.countOf(name))\n  @Ensures(result.every(v => isFieldValue(v)))\n  getAll(name: string): string[] {\n    let out: string[] = [];\n    let i: usize = 0;\n    while (i < this.names.length) {\n      if (eqIgnoreCase(this.names[i], name)) {\n        out.push(this.values[i]);\n      }\n      i += 1;\n    }\n    return out;\n  }\n\n  // add(name, value): Result<void, HeaderError> -- appends a field. Err (and no change) when `name` is not a token\n  // (InvalidHeaderName) or `value` is not a valid field value (InvalidHeaderValue). O(name + value).\n  @Ensures(result.isOk() == (isToken(name) && isFieldValue(value)))\n  @Ensures(result.isOk() ==> this.size() == old(this.size()) + 1)\n  @Ensures(result.isOk() ==> this.nameAt(this.size() - 1) == name && this.valueAt(this.size() - 1) == value)\n  @Ensures(result.isErr() ==> this.size() == old(this.size()))\n  add(name: string, value: string): Result<void, HeaderError> {\n    if (!isToken(name)) {\n      return Err(headerError(InvalidHeaderName));\n    }\n    if (!isFieldValue(value)) {\n      return Err(headerError(InvalidHeaderValue));\n    }\n    this.names.push(name);\n    this.values.push(value);\n    return Ok();\n  }\n\n  // remove(name): usize -- deletes every field called `name`; the number removed (0 if there was none). O(size).\n  @Ensures(this.countOf(name) == 0)\n  @Ensures(this.size() + result == old(this.size()))\n  @Ensures(result == old(this.countOf(name)))\n  remove(name: string): usize {\n    let ns: string[] = [];\n    let vs: string[] = [];\n    let i: usize = 0;\n    while (i < this.names.length) {\n      if (!eqIgnoreCase(this.names[i], name)) {\n        ns.push(this.names[i]);\n        vs.push(this.values[i]);\n      }\n      i += 1;\n    }\n    const removed = this.names.length - ns.length;\n    this.names = ns;\n    this.values = vs;\n    return removed;\n  }\n\n  // set(name, value): Result<void, HeaderError> -- replaces every field called `name` by one field (appended at the\n  // end). Err (and no change) when the name or value is invalid, as for `add`. O(size).\n  @Ensures(result.isOk() == (isToken(name) && isFieldValue(value)))\n  @Ensures(result.isOk() ==> this.countOf(name) == 1 && this.get(name).unwrap() == value)\n  @Ensures(result.isErr() ==> this.size() == old(this.size()))\n  set(name: string, value: string): Result<void, HeaderError> {\n    if (!isToken(name)) {\n      return Err(headerError(InvalidHeaderName));\n    }\n    if (!isFieldValue(value)) {\n      return Err(headerError(InvalidHeaderValue));\n    }\n    this.remove(name);\n    this.names.push(name);\n    this.values.push(value);\n    return Ok();\n  }\n\n  // equals(other): bool -- the same fields in the same order, names compared as written (byte for byte). O(size).\n  @Ensures(result ==> this.size() == other.size())\n  equals(other: Headers): bool {\n    if (this.names.length != other.size()) {\n      return false;\n    }\n    let i: usize = 0;\n    while (i < this.names.length) {\n      if (this.names[i] != other.nameAt(i) || this.values[i] != other.valueAt(i)) {\n        return false;\n      }\n      i += 1;\n    }\n    return true;\n  }\n}\n\n// emptyHeaders(): Headers -- no fields. O(1).\n@Ensures(result.size() == 0)\nexport function emptyHeaders(): Headers {\n  return new Headers([], []);\n}\n\n// tryHeaders(names, values): Result<Headers, HeaderError> -- the fields (names[i], values[i]) as a Result instead of a\n// trap: Err(MismatchedLists) when the lists differ in length, Err(InvalidHeaderName) / Err(InvalidHeaderValue) for the\n// first kind of violation found (names are checked before values). The twin of `new Headers(names, values)`. O(size).\n@Ensures(result.isOk() == (names.length == values.length && allTokens(names) && allFieldValues(values)))\nexport function tryHeaders(names: string[], values: string[]): Result<Headers, HeaderError> {\n  if (names.length != values.length) {\n    return Err(headerError(MismatchedLists));\n  }\n  if (!allTokens(names)) {\n    return Err(headerError(InvalidHeaderName));\n  }\n  if (!allFieldValues(values)) {\n    return Err(headerError(InvalidHeaderValue));\n  }\n  return Ok(new Headers(names, values));\n}\n\n// headersFromLists(names, values): Result<Headers, HeaderError> -- use `tryHeaders`.\n@Deprecated(\"use tryHeaders (a length mismatch is now MismatchedLists, no longer InvalidHeaderValue)\")\nexport function headersFromLists(names: string[], values: string[]): Result<Headers, HeaderError> {\n  return tryHeaders(names, values);\n}\n\n// ----------------------------------------------------------------------------------------------- Status\n\n// standardReason(code): Option<string> -- the registered reason phrase of a status code (RFC 9110 \xc2\xa715), None when\n// the code is unregistered. O(1). Internal.\nexport function standardReason(code: int): Option<string> {\n  return match (code) {\n    100 => Some(\"Continue\"),\n    101 => Some(\"Switching Protocols\"),\n    102 => Some(\"Processing\"),\n    103 => Some(\"Early Hints\"),\n    200 => Some(\"OK\"),\n    201 => Some(\"Created\"),\n    202 => Some(\"Accepted\"),\n    203 => Some(\"Non-Authoritative Information\"),\n    204 => Some(\"No Content\"),\n    205 => Some(\"Reset Content\"),\n    206 => Some(\"Partial Content\"),\n    207 => Some(\"Multi-Status\"),\n    300 => Some(\"Multiple Choices\"),\n    301 => Some(\"Moved Permanently\"),\n    302 => Some(\"Found\"),\n    303 => Some(\"See Other\"),\n    304 => Some(\"Not Modified\"),\n    305 => Some(\"Use Proxy\"),\n    307 => Some(\"Temporary Redirect\"),\n    308 => Some(\"Permanent Redirect\"),\n    400 => Some(\"Bad Request\"),\n    401 => Some(\"Unauthorized\"),\n    402 => Some(\"Payment Required\"),\n    403 => Some(\"Forbidden\"),\n    404 => Some(\"Not Found\"),\n    405 => Some(\"Method Not Allowed\"),\n    406 => Some(\"Not Acceptable\"),\n    407 => Some(\"Proxy Authentication Required\"),\n    408 => Some(\"Request Timeout\"),\n    409 => Some(\"Conflict\"),\n    410 => Some(\"Gone\"),\n    411 => Some(\"Length Required\"),\n    412 => Some(\"Precondition Failed\"),\n    413 => Some(\"Content Too Large\"),\n    414 => Some(\"URI Too Long\"),\n    415 => Some(\"Unsupported Media Type\"),\n    416 => Some(\"Range Not Satisfiable\"),\n    417 => Some(\"Expectation Failed\"),\n    418 => Some(\"I'm a teapot\"),\n    421 => Some(\"Misdirected Request\"),\n    422 => Some(\"Unprocessable Content\"),\n    426 => Some(\"Upgrade Required\"),\n    428 => Some(\"Precondition Required\"),\n    429 => Some(\"Too Many Requests\"),\n    431 => Some(\"Request Header Fields Too Large\"),\n    451 => Some(\"Unavailable For Legal Reasons\"),\n    500 => Some(\"Internal Server Error\"),\n    501 => Some(\"Not Implemented\"),\n    502 => Some(\"Bad Gateway\"),\n    503 => Some(\"Service Unavailable\"),\n    504 => Some(\"Gateway Timeout\"),\n    505 => Some(\"HTTP Version Not Supported\"),\n    _ => None\n  };\n}\n\n// statusHasNoBody(code): bool -- a response with this status never has a message body: 1xx, 204 and 304 (RFC 9112 \xc2\xa76.3).\n// O(1). Internal.\n@Ensures(result == (code < 200 || code == 204 || code == 304))\nexport function statusHasNoBody(code: int): bool {\n  return code < 200 || code == 204 || code == 304;\n}\n\n// The index of the first byte of `s` that may not occur in a reason phrase, or None. O(n).\nfunction badReasonByte(s: string): Option<usize> {\n  let i: usize = 0;\n  while (i < s.length) {\n    if (HTTP_CLASS.charCodeAt(s.charCodeAt(i).toUsize()) < C_HTAB) {\n      return Some(i);\n    }\n    i += 1;\n  }\n  return None;\n}\n\n// A response status: the code (100..599, the invariant) and the reason phrase, which is kept byte for byte.\n@Invariant(this.statusCode >= 100 && this.statusCode <= 599)\n@Invariant(isReasonPhrase(this.phrase))\nexport class Status {\n  private statusCode: int;\n  private phrase: string;\n\n  // new Status(code, reason) -- traps (in every build) unless 100 <= code <= 599 and `reason` has only HTAB, SP,\n  // VCHAR and obs-text. `Status.tryNew` answers a Result instead; `standardStatus(code)` picks the registered phrase.\n  @Requires(code >= 100 && code <= 599 && isReasonPhrase(reason))\n  constructor(code: int, reason: string) {\n    this.statusCode = code;\n    this.phrase = reason;\n    enforce(code >= 100 && code <= 599 && isReasonPhrase(reason), \"invalid Status\");\n  }\n\n  // Status.tryNew(code, reason): Result<Status, HttpError> -- the status as a Result instead of a trap:\n  // Err(InvalidStatusCode) (offset 0) unless 100 <= code <= 599, Err(InvalidStatusReason) with the offset of the first\n  // offending byte of the phrase. The twin of `new Status(code, reason)`. O(n).\n  @Ensures(result.isOk() == (code >= 100 && code <= 599 && isReasonPhrase(reason)))\n  static tryNew(code: int, reason: string): Result<Status, HttpError> {\n    if (code < 100 || code > 599) {\n      return Err(httpError(0, InvalidStatusCode));\n    }\n    const bad = badReasonByte(reason);\n    if (bad.isSome()) {\n      return Err(httpError(bad.unwrap(), InvalidStatusReason));\n    }\n    return Ok(new Status(code, reason));\n  }\n\n  // code(): int -- 100..599. O(1).\n  @Ensures(result >= 100 && result <= 599)\n  code(): int {\n    return this.statusCode;\n  }\n\n  // reason(): string -- the reason phrase (may be empty). O(1).\n  @Ensures(isReasonPhrase(result))\n  reason(): string {\n    return this.phrase;\n  }\n\n  // hasNoBody(): bool -- see `statusHasNoBody`. O(1).\n  @Ensures(result == statusHasNoBody(this.statusCode))\n  hasNoBody(): bool {\n    return statusHasNoBody(this.statusCode);\n  }\n\n  // equals(other): bool -- same code and same phrase. O(n).\n  @Ensures(result ==> this.statusCode == other.code())\n  equals(other: Status): bool {\n    return this.statusCode == other.code() && this.phrase == other.reason();\n  }\n}\n\n// standardStatus(code): Status -- the status with the registered phrase of `code` (\"Unknown Status\" for an unregistered\n// code). Traps unless 100 <= code <= 599. O(1).\n@Requires(code >= 100 && code <= 599)\n@Ensures(result.code() == code)\nexport function standardStatus(code: int): Status {\n  const r = standardReason(code);\n  return new Status(code, r.isSome() ? r.unwrap() : \"Unknown Status\");\n}\n\n// makeStatus(code, reason): Result<Status, string> -- use `Status.tryNew` (a typed error instead of a string).\n@Deprecated(\"use Status.tryNew\")\nexport function makeStatus(code: int, reason: string): Result<Status, string> {\n  const r = Status.tryNew(code, reason);\n  if (r.isErr()) {\n    return Err(httpErrorKindText(r.unwrapErr().kind));\n  }\n  return Ok(r.unwrap());\n}\n\n// ------------------------------------------------------------------------------- message validity rules\n\nfunction isHttp11(v: HttpVersion): bool {\n  return match (v) {\n    Http11 => true,\n    Http10 => false\n  };\n}\n\n// Trailer fields must not be framing or routing fields (RFC 9110 \xc2\xa76.5.1).\nfunction isForbiddenTrailerName(n: string): bool {\n  return eqIgnoreCase(n, \"content-length\") || eqIgnoreCase(n, \"transfer-encoding\") || eqIgnoreCase(n, \"trailer\")\n    || eqIgnoreCase(n, \"host\");\n}\n\nfunction hasForbiddenTrailer(t: Headers): bool {\n  let i: usize = 0;\n  while (i < t.size()) {\n    if (isForbiddenTrailerName(t.nameAt(i))) {\n      return true;\n    }\n    i += 1;\n  }\n  return false;\n}\n\n// framingProblem(...): None when the header fields frame the body unambiguously and consistently with `body` and\n// `trailers`, else the first violated rule. `bodyless`: the message never has a body (response to HEAD, 1xx, 204,\n// 304); `closeOk`: a body without Content-Length / Transfer-Encoding is allowed (a response: it ends at connection\n// close); `noFraming`: neither field may occur (1xx and 204 responses). The rules are exactly those of the parser.\n// Internal.\nfunction framingProblem(h: Headers, trailers: Headers, body: Bytes, version: HttpVersion, bodyless: bool, closeOk: bool,\n    noFraming: bool): Option<HttpErrorKind> {\n  const cl = h.countOf(\"content-length\");\n  const te = h.countOf(\"transfer-encoding\");\n  if (noFraming && (cl > 0 || te > 0)) {\n    return Some(ForbiddenFraming);\n  }\n  if (cl > 1) {\n    return Some(DuplicateContentLength);\n  }\n  if (te > 1) {\n    return Some(DuplicateTransferEncoding);\n  }\n  if (cl == 1 && te == 1) {\n    return Some(ContentLengthWithTransferEncoding);\n  }\n  let chunked = false;\n  if (te == 1) {\n    if (!eqIgnoreCase(h.get(\"transfer-encoding\").unwrap(), \"chunked\")) {\n      return Some(UnsupportedTransferEncoding);\n    }\n    if (!isHttp11(version)) {\n      return Some(UnsupportedTransferEncoding);\n    }\n    chunked = true;\n  }\n  let declared: usize = 0;\n  if (cl == 1) {\n    const p = parseContentLength(h.get(\"content-length\").unwrap());\n    if (p.isNone()) {\n      return Some(InvalidContentLength);\n    }\n    declared = p.unwrap();\n  }\n  if (bodyless) {\n    if (body.length() != 0 || trailers.size() != 0) {\n      return Some(UnexpectedBody);\n    }\n    return None;\n  }\n  if (trailers.size() > 0 && !chunked) {\n    return Some(ForbiddenTrailer);\n  }\n  if (hasForbiddenTrailer(trailers)) {\n    return Some(ForbiddenTrailer);\n  }\n  if (chunked) {\n    return None;\n  }\n  if (cl == 1) {\n    if (declared != body.length()) {\n      return Some(BodyLengthMismatch);\n    }\n    return None;\n  }\n  if (!closeOk && body.length() != 0) {\n    return Some(MissingFraming);\n  }\n  return None;\n}\n\n// requestProblem(...): None when the parts form a well-formed request, else the first violated rule. The class\n// invariant of `Request`, the check of its constructor and the rules of the parser. O(size). Internal.\nfunction requestProblem(method: Method, target: string, version: HttpVersion, headers: Headers, body: Bytes,\n    trailers: Headers): Option<HttpErrorKind> {\n  if (!isValidMethod(method)) {\n    return Some(InvalidMethod);\n  }\n  if (!isValidTarget(method, target)) {\n    return Some(InvalidTarget);\n  }\n  const hosts = headers.countOf(\"host\");\n  if (hosts > 1) {\n    return Some(DuplicateHost);\n  }\n  if (hosts == 0 && isHttp11(version)) {\n    return Some(MissingHost);\n  }\n  if (hosts == 1 && !isHostValue(headers.get(\"host\").unwrap())) {\n    return Some(InvalidHost);\n  }\n  return framingProblem(headers, trailers, body, version, false, false, false);\n}\n\n// responseProblem(...): None when the parts form a well-formed response. `forHead`: the response to a HEAD request\n// (its headers describe a body that is not sent). O(size). Internal.\nfunction responseProblem(status: Status, version: HttpVersion, headers: Headers, body: Bytes, trailers: Headers,\n    forHead: bool): Option<HttpErrorKind> {\n  const code = status.code();\n  return framingProblem(headers, trailers, body, version, forHead || statusHasNoBody(code), true, code < 200 || code == 204);\n}\n\n// ---------------------------------------------------------------------------------- Request and Response\n\n// The parts of a request, for `Request.tryNew` (six positional arguments of different meaning invite transposition).\nexport type RequestParts = {\n  method: Method; target: string; version: HttpVersion; headers: Headers; body: Bytes; trailers: Headers;\n};\n\n// A parsed or to-be-serialized HTTP request: method, request-target, version, header fields, body, trailers.\n// Invariant: `requestProblem(...)` is None (valid method and target, one Host on HTTP/1.1, unambiguous framing that\n// matches the body). The constructor enforces it in every build; there is no mutating method. A chunked request\n// stores the decoded body and its trailer fields (chunk boundaries and extensions are not kept); a request with\n// `Transfer-Encoding: chunked` has `isChunked()`.\n@Invariant(requestProblem(this.reqMethod, this.reqTarget, this.reqVersion, this.reqHeaders, this.reqBody, this.reqTrailers).isNone())\nexport class Request {\n  private reqMethod: Method;\n  private reqTarget: string;\n  private reqVersion: HttpVersion;\n  private reqHeaders: Headers;\n  private reqBody: Bytes;\n  private reqTrailers: Headers;\n\n  // new Request(method, target, version, headers, body, trailers) -- traps (in every build) unless the parts form a\n  // well-formed request (valid method and target, one Host on HTTP/1.1, unambiguous framing matching the body);\n  // `Request.tryNew` answers a Result instead.\n  @Requires(requestProblem(method, target, version, headers, body, trailers).isNone())\n  constructor(method: Method, target: string, version: HttpVersion, headers: Headers, body: Bytes, trailers: Headers) {\n    this.reqMethod = method;\n    this.reqTarget = target;\n    this.reqVersion = version;\n    this.reqHeaders = headers;\n    this.reqBody = body;\n    this.reqTrailers = trailers;\n    enforce(requestProblem(method, target, version, headers, body, trailers).isNone(), \"invalid Request\");\n  }\n\n  // Request.tryNew(parts): Result<Request, HttpError> -- the request, or the first violated rule as the kind of the\n  // error (InvalidMethod, InvalidTarget, DuplicateHost, MissingHost, InvalidHost, or a framing kind such as\n  // BodyLengthMismatch; offset 0), instead of a trap. The twin of `new Request(..)`. O(size).\n  @Ensures(result.isOk() == requestProblem(parts.method, parts.target, parts.version, parts.headers, parts.body, parts.trailers).isNone())\n  static tryNew(parts: RequestParts): Result<Request, HttpError> {\n    const p = requestProblem(parts.method, parts.target, parts.version, parts.headers, parts.body, parts.trailers);\n    if (p.isSome()) {\n      return Err(httpError(0, p.unwrap()));\n    }\n    return Ok(new Request(parts.method, parts.target, parts.version, parts.headers, parts.body, parts.trailers));\n  }\n\n  // method(): Method -- the request method. O(1).\n  @Ensures(isValidMethod(result))\n  method(): Method {\n    return this.reqMethod;\n  }\n\n  // target(): string -- the request-target as sent. O(1).\n  @Ensures(isValidTarget(this.reqMethod, result))\n  target(): string {\n    return this.reqTarget;\n  }\n\n  // version(): HttpVersion -- HTTP/1.0 or HTTP/1.1. O(1).\n  version(): HttpVersion {\n    return this.reqVersion;\n  }\n\n  // headers(): Headers -- the header fields in order. O(1).\n  headers(): Headers {\n    return this.reqHeaders;\n  }\n\n  // body(): Bytes -- the (decoded) message body. O(1).\n  body(): Bytes {\n    return this.reqBody;\n  }\n\n  // trailers(): Headers -- the trailer fields of a chunked body (empty otherwise). O(1).\n  @Ensures(result.size() > 0 ==> this.isChunked())\n  trailers(): Headers {\n    return this.reqTrailers;\n  }\n\n  // isChunked(): bool -- the body is sent with `Transfer-Encoding: chunked`. O(size of headers).\n  @Ensures(result == (this.reqHeaders.countOf(\"transfer-encoding\") == 1))\n  isChunked(): bool {\n    return this.reqHeaders.countOf(\"transfer-encoding\") == 1;\n  }\n\n  // equals(other): bool -- the same method, target, version, headers, body and trailers. O(size).\n  equals(other: Request): bool {\n    return methodEquals(this.reqMethod, other.method()) && this.reqTarget == other.target()\n      && versionMinor(this.reqVersion) == versionMinor(other.version()) && this.reqHeaders.equals(other.headers())\n      && this.reqBody.equals(other.body()) && this.reqTrailers.equals(other.trailers());\n  }\n}\n\n// makeRequest(method, target, version, headers, body, trailers): Result<Request, string> -- use `Request.tryNew`\n// (one `RequestParts` record, a typed error instead of a string).\n@Deprecated(\"use Request.tryNew(RequestParts)\")\nexport function makeRequest(method: Method, target: string, version: HttpVersion, headers: Headers, body: Bytes,\n    trailers: Headers): Result<Request, string> {\n  const p = requestProblem(method, target, version, headers, body, trailers);\n  if (p.isSome()) {\n    return Err(httpErrorKindText(p.unwrap()));\n  }\n  return Ok(new Request(method, target, version, headers, body, trailers));\n}\n\n// The parts of a response, for `Response.tryNew`. `forHead`: the response to a HEAD request.\nexport type ResponseParts = {\n  status: Status; version: HttpVersion; headers: Headers; body: Bytes; trailers: Headers; forHead: bool;\n};\n\n// A parsed or to-be-serialized HTTP response. Invariant: `responseProblem(...)` is None. `forHead`: the response to\n// a HEAD request, whose headers (Content-Length, Transfer-Encoding) describe a body that is not sent; 1xx, 204\n// and 304 responses are bodyless in any case (`isBodyless()`).\n@Invariant(responseProblem(this.resStatus, this.resVersion, this.resHeaders, this.resBody, this.resTrailers, this.resForHead).isNone())\nexport class Response {\n  private resStatus: Status;\n  private resVersion: HttpVersion;\n  private resHeaders: Headers;\n  private resBody: Bytes;\n  private resTrailers: Headers;\n  private resForHead: bool;\n\n  // new Response(status, version, headers, body, trailers, forHead) -- traps (in every build) unless the parts form a\n  // well-formed response (unambiguous framing matching the body; no body for 1xx, 204, 304 or a HEAD response);\n  // `Response.tryNew` answers a Result instead.\n  @Requires(responseProblem(status, version, headers, body, trailers, forHead).isNone())\n  constructor(status: Status, version: HttpVersion, headers: Headers, body: Bytes, trailers: Headers, forHead: bool) {\n    this.resStatus = status;\n    this.resVersion = version;\n    this.resHeaders = headers;\n    this.resBody = body;\n    this.resTrailers = trailers;\n    this.resForHead = forHead;\n    enforce(responseProblem(status, version, headers, body, trailers, forHead).isNone(), \"invalid Response\");\n  }\n\n  // Response.tryNew(parts): Result<Response, HttpError> -- the response, or the first violated rule as the kind of the\n  // error (a framing kind such as UnexpectedBody or BodyLengthMismatch; offset 0), instead of a trap. The twin of\n  // `new Response(..)`. O(size).\n  @Ensures(result.isOk() == responseProblem(parts.status, parts.version, parts.headers, parts.body, parts.trailers, parts.forHead).isNone())\n  static tryNew(parts: ResponseParts): Result<Response, HttpError> {\n    const p = responseProblem(parts.status, parts.version, parts.headers, parts.body, parts.trailers, parts.forHead);\n    if (p.isSome()) {\n      return Err(httpError(0, p.unwrap()));\n    }\n    return Ok(new Response(parts.status, parts.version, parts.headers, parts.body, parts.trailers, parts.forHead));\n  }\n\n  // status(): Status -- code and reason phrase. O(1).\n  status(): Status {\n    return this.resStatus;\n  }\n\n  // version(): HttpVersion -- HTTP/1.0 or HTTP/1.1. O(1).\n  version(): HttpVersion {\n    return this.resVersion;\n  }\n\n  // headers(): Headers -- the header fields in order. O(1).\n  headers(): Headers {\n    return this.resHeaders;\n  }\n\n  // body(): Bytes -- the (decoded) message body. O(1).\n  body(): Bytes {\n    return this.resBody;\n  }\n\n  // trailers(): Headers -- the trailer fields of a chunked body (empty otherwise). O(1).\n  @Ensures(result.size() > 0 ==> this.isChunked())\n  trailers(): Headers {\n    return this.resTrailers;\n  }\n\n  // isBodyless(): bool -- no body is sent: response to HEAD, or status 1xx, 204, 304. O(1).\n  @Ensures(result == (this.resForHead || this.resStatus.hasNoBody()))\n  @Ensures(result ==> this.resBody.length() == 0)\n  isBodyless(): bool {\n    return this.resForHead || this.resStatus.hasNoBody();\n  }\n\n  // isForHead(): bool -- the response to a HEAD request. O(1).\n  @Ensures(result == this.resForHead)\n  isForHead(): bool {\n    return this.resForHead;\n  }\n\n  // isChunked(): bool -- the body is sent with `Transfer-Encoding: chunked` (never true for a bodyless message when\n  // serialized: no chunks are written). O(size of headers).\n  @Ensures(result == (this.resHeaders.countOf(\"transfer-encoding\") == 1))\n  isChunked(): bool {\n    return this.resHeaders.countOf(\"transfer-encoding\") == 1;\n  }\n\n  // equals(other): bool -- the same status, version, headers, body, trailers and HEAD flag. O(size).\n  equals(other: Response): bool {\n    return this.resStatus.equals(other.status()) && versionMinor(this.resVersion) == versionMinor(other.version())\n      && this.resHeaders.equals(other.headers()) && this.resBody.equals(other.body())\n      && this.resTrailers.equals(other.trailers()) && this.resForHead == other.isForHead();\n  }\n}\n\n// makeResponse(status, version, headers, body, trailers, forHead): Result<Response, string> -- use `Response.tryNew`\n// (one `ResponseParts` record, a typed error instead of a string).\n@Deprecated(\"use Response.tryNew(ResponseParts)\")\nexport function makeResponse(status: Status, version: HttpVersion, headers: Headers, body: Bytes, trailers: Headers,\n    forHead: bool): Result<Response, string> {\n  const p = responseProblem(status, version, headers, body, trailers, forHead);\n  if (p.isSome()) {\n    return Err(httpErrorKindText(p.unwrap()));\n  }\n  return Ok(new Response(status, version, headers, body, trailers, forHead));\n}\n\n\n// -------------------------------------------------------------------------------------------------- Limits\n\n// The resource limits of a parser. Every message that exceeds one is refused at the first byte over the limit\n// (a request line, a header line, the header section, the header count, a chunk header line, the body). A parser\n// can only be built with limits that satisfy `isValidLimits`, so it can never run with a limit that is zero,\n// negative or large enough to overflow the chunk-size arithmetic. Start from `defaultLimits()` and replace fields:\n// `HttpLimits { ...defaultLimits(), maxBody: 65536 }`.\n//   maxStartLine    bytes of the request line / status line without CRLF   (default 8192, RFC 9112 \xc2\xa73: at least 8000)\n//   maxHeaderCount  header fields (and, separately, trailer fields)         (default 100)\n//   maxHeaderLine   bytes of one header line without CRLF                   (default 8192)\n//   maxHeaderBytes  the whole header section (start line .. empty line), and separately the trailer section\n//                                                                           (default 65536)\n//   maxChunkLine    bytes of a chunk-size line (size and extension)         (default 1024)\n//   maxBody         bytes of the (decoded) body                             (default 1048576 = 1 MiB)\nexport type HttpLimits = {\n  maxStartLine: usize; maxHeaderCount: usize; maxHeaderLine: usize; maxHeaderBytes: usize; maxChunkLine: usize;\n  maxBody: usize;\n};\n\n// isValidLimits(l): bool -- every field is in range: maxStartLine 16..1048576, maxHeaderCount 1..65536, maxHeaderLine\n// 16..1048576, maxHeaderBytes 64..67108864, maxChunkLine 8..65536, maxBody <= 1099511627776. The constructors of the\n// parsers trap unless this holds. O(1).\nexport function isValidLimits(l: HttpLimits): bool {\n  return l.maxStartLine >= 16 && l.maxStartLine <= 1048576 && l.maxHeaderCount >= 1 && l.maxHeaderCount <= 65536\n    && l.maxHeaderLine >= 16 && l.maxHeaderLine <= 1048576 && l.maxHeaderBytes >= 64 && l.maxHeaderBytes <= 67108864\n    && l.maxChunkLine >= 8 && l.maxChunkLine <= 65536 && l.maxBody <= 1099511627776;\n}\n\n// defaultLimits(): HttpLimits -- 8192 start line, 100 headers, 8192 header line, 65536 header section, 1024 chunk line,\n// 1 MiB body. Valid. O(1).\n@Ensures(isValidLimits(result))\n@Ensures(result.maxStartLine == 8192 && result.maxHeaderCount == 100 && result.maxBody == 1048576)\nexport function defaultLimits(): HttpLimits {\n  return HttpLimits {\n    maxStartLine: 8192, maxHeaderCount: 100, maxHeaderLine: 8192, maxHeaderBytes: 65536, maxChunkLine: 1024,\n    maxBody: 1048576\n  };\n}\n\n// What a response answers: a HEAD request (its headers describe a body that is not sent, whatever they say) or any\n// other request. A named pair instead of a `bool` (ADR-0048 rule 2.5).\nexport type ResponseTo = ToHead | ToOther;\n\nfunction isToHead(to: ResponseTo): bool {\n  return match (to) {\n    ToHead => true,\n    ToOther => false\n  };\n}\n\n// ------------------------------------------------------------------------------------------ state machine\n\nconst S_METHOD: int = 0;\nconst S_TARGET: int = 1;\nconst S_VERSION: int = 2;\nconst S_CODE: int = 3;\nconst S_REASON: int = 4;\nconst S_START_LF: int = 5;\nconst S_HDR_LINE: int = 6;\nconst S_HDR_NAME: int = 7;\nconst S_HDR_OWS: int = 8;\nconst S_HDR_VALUE: int = 9;\nconst S_HDR_LF: int = 10;\nconst S_HEAD_END_LF: int = 11;\nconst S_BODY: int = 12;\nconst S_CHUNK_SIZE: int = 13;\nconst S_CHUNK_BWS: int = 14;\nconst S_CHUNK_EXT: int = 15;\nconst S_CHUNK_SIZE_LF: int = 16;\nconst S_CHUNK_DATA: int = 17;\nconst S_CHUNK_CR: int = 18;\nconst S_CHUNK_LF: int = 19;\nconst S_BODY_CLOSE: int = 20;\nconst S_DONE: int = 21;\nconst S_ERROR: int = 22;\n\n// stateName(s): string -- (internal) the name of state s, for diagnostics and tests. O(1).\n@Ensures(result.length > 0)\nexport function stateName(s: int): string {\n  return match (s) {\n    0 => \"METHOD\",\n    1 => \"TARGET\",\n    2 => \"VERSION\",\n    3 => \"CODE\",\n    4 => \"REASON\",\n    5 => \"START_LF\",\n    6 => \"HDR_LINE\",\n    7 => \"HDR_NAME\",\n    8 => \"HDR_OWS\",\n    9 => \"HDR_VALUE\",\n    10 => \"HDR_LF\",\n    11 => \"HEAD_END_LF\",\n    12 => \"BODY\",\n    13 => \"CHUNK_SIZE\",\n    14 => \"CHUNK_BWS\",\n    15 => \"CHUNK_EXT\",\n    16 => \"CHUNK_SIZE_LF\",\n    17 => \"CHUNK_DATA\",\n    18 => \"CHUNK_CR\",\n    19 => \"CHUNK_LF\",\n    20 => \"BODY_CLOSE\",\n    21 => \"DONE\",\n    22 => \"ERROR\",\n    _ => \"?\"\n  };\n}\n\n// edgeAllowed(src, dst): bool -- (internal) the transition relation of the parser (the diagram at the top of this file). Every\n// state change goes through `MessageParser.go`, which requires it; `ERROR` is reachable from every non-terminal\n// state (through `fail`) and `DONE` / `ERROR` have no outgoing edge. O(1).\n@Ensures(src >= S_DONE ==> !result)\n@Ensures(result ==> src != dst)\nexport function edgeAllowed(src: int, dst: int): bool {\n  return match (src) {\n    0 => dst == S_TARGET,\n    1 => dst == S_VERSION,\n    2 => dst == S_START_LF || dst == S_CODE,\n    3 => dst == S_REASON,\n    4 => dst == S_START_LF,\n    5 => dst == S_HDR_LINE,\n    6 => dst == S_HDR_NAME || dst == S_HEAD_END_LF,\n    7 => dst == S_HDR_OWS,\n    8 => dst == S_HDR_VALUE || dst == S_HDR_LF,\n    9 => dst == S_HDR_LF,\n    10 => dst == S_HDR_LINE,\n    11 => dst == S_BODY || dst == S_CHUNK_SIZE || dst == S_BODY_CLOSE || dst == S_DONE,\n    12 => dst == S_DONE,\n    13 => dst == S_CHUNK_BWS || dst == S_CHUNK_EXT || dst == S_CHUNK_SIZE_LF,\n    14 => dst == S_CHUNK_EXT || dst == S_CHUNK_SIZE_LF,\n    15 => dst == S_CHUNK_SIZE_LF,\n    16 => dst == S_CHUNK_DATA || dst == S_HDR_LINE,\n    17 => dst == S_CHUNK_CR,\n    18 => dst == S_CHUNK_LF,\n    19 => dst == S_CHUNK_SIZE,\n    20 => dst == S_DONE,\n    _ => false\n  };\n}\n\n// The framing of the body, decided at the end of the header section.\nconst F_NONE: int = 0;\nconst F_LENGTH: int = 1;\nconst F_CHUNKED: int = 2;\nconst F_CLOSE: int = 3;\n\nfunction lineLimitReason(st: int): HttpErrorKind {\n  if (st <= S_REASON) {\n    return StartLineTooLong;\n  }\n  if (st <= S_HDR_VALUE) {\n    return HeaderLineTooLong;\n  }\n  return ChunkLineTooLong;\n}\n\n// Is the state one whose bytes count toward `lineLen` (the start line, a header line, a chunk-size line)?\nfunction isLineState(st: int): bool {\n  return st <= S_REASON || (st >= S_HDR_NAME && st <= S_HDR_VALUE) || (st >= S_CHUNK_SIZE && st <= S_CHUNK_EXT);\n}\n\n\n// The bytes xs[a, b) as a string (one byte per character, no decoding): one allocation and a copy loop in the runtime\n// (`bytesToString`; the per-character `s += String.fromCharCode(..)` loop it replaced cost about 7 ns per byte).\n@Requires(a <= b && b <= xs.length)\n@Ensures(result.length == b - a)\nfunction sliceString(xs: u8[], a: usize, b: usize): string {\n  return bytesToString(xs, a, b - a);\n}\n\n// s without trailing SP / HTAB. O(trailing blanks).\n@Ensures(result.length <= s.length)\nfunction trimEndOws(s: string): string {\n  let e = s.length;\n  while (e > 0 && isOws(s.charCodeAt(e - 1))) {\n    e -= 1;\n  }\n  return e == s.length ? s : s.substring(0, e);\n}\n\nfunction resultKind<T>(r: ParseResult<T>): int {\n  return match (r) {\n    NeedMore => 0,\n    Done(v, used) => 1,\n    Failed(e) => 2\n  };\n}\n\nfunction resultUsed<T>(r: ParseResult<T>): usize {\n  return match (r) {\n    Done(v, used) => used,\n    _ => 0\n  };\n}\n\n// The scanners read the chunk's storage array directly (`Bytes.storage`, no copy), so that the byte loops index an\n// array instead of calling `Bytes.at` per byte (a call plus a reference count per byte). Their cursor `this.cur` is an\n// index into that array; the chunk starts at index `this.off` of it, which is stream offset `this.base`.\n\n// posAt(base, off, j): the stream offset of index j of a storage array whose index `off` is at stream offset `base`.\n@Requires(j >= off)\n@Ensures(result == base + (j - off))\nfunction posAt(base: usize, off: usize, j: usize): usize {\n  return base + (j - off);\n}\n\n// The incremental parser shared by `RequestParser` and `ResponseParser`: the state machine described at the top of\n// the file. `feed` consumes input in one forward pass; all state is in the fields, so the input may be split\n// anywhere. Invariants (checked after every public method in a checked build) tie the state to the data: the state\n// is one of the 23 states; a failed parser holds its error and only a failed parser does; the header lists are\n// parallel and within the count limit; the line counter is within the line limit; the header section never exceeds\n// its budget; counters of the framing fields never pass one (a second one is an error at once); pending body bytes\n// exist only in a body state; a response parser never visits the request-line states.\n@Invariant(this.state >= S_METHOD && this.state <= S_ERROR)\n@Invariant((this.state == S_ERROR) == this.err.isSome())\n@Invariant(this.hnames.length == this.hvals.length && this.tnames.length == this.tvals.length)\n@Invariant(this.hnames.length <= this.maxCount && this.tnames.length <= this.maxCount)\n@Invariant(this.lineLen <= this.lineMax)\n@Invariant(this.state > S_HEAD_END_LF || this.total <= this.sectionEnd)\n@Invariant(this.state == S_ERROR || (this.clCount <= 1 && this.teCount <= 1 && this.hostCount <= 1))\n@Invariant(this.bodyLen <= this.maxBody)\n@Invariant(this.remaining == 0 || this.state == S_BODY || this.state == S_CHUNK_DATA || this.state == S_ERROR)\n@Invariant(this.state != S_DONE || this.remaining == 0)\n@Invariant(!this.inTrailers || this.state >= S_HDR_LINE)\n@Invariant(this.isReq || (this.state != S_METHOD && this.state != S_TARGET))\n@Invariant(this.isReq || this.state != S_START_LF || this.vidx == 8)\n@Invariant(this.state != S_BODY_CLOSE || !this.isReq)\n@Invariant(this.state != S_BODY || this.framing == F_LENGTH)\n@Invariant(this.state != S_BODY_CLOSE || this.framing == F_CLOSE)\n@Invariant(this.vidx <= 8 && this.codeDigits <= 3)\n@Invariant(this.noBody.length() == 0)\n@Invariant(this.acc.length == 0 || this.state == S_METHOD || this.state == S_TARGET || this.state == S_REASON\n  || this.state == S_HDR_NAME || this.state == S_HDR_VALUE || this.state == S_ERROR)\nclass MessageParser {\n  private isReq: bool;\n  private forHead: bool;\n  private maxStart: usize;\n  private maxCount: usize;\n  private maxLine: usize;\n  private maxHead: usize;\n  private maxChunk: usize;\n  private maxBody: usize;\n  private state: int;\n  private err: Option<HttpError> = None;\n  private base0: usize = 0;\n  private base: usize = 0;\n  private off: usize = 0;\n  private cur: usize = 0;\n  private total: usize = 0;\n  private sectionEnd: usize;\n  private lineLen: usize = 0;\n  private lineMax: usize;\n  private lineStart: usize = 0;\n  private acc: string = \"\";\n  private meth: Method = Get;\n  private methodToken: string = \"\";\n  private target: string = \"\";\n  private targetPos: usize = 0;\n  private vidx: usize = 0;\n  private minor: int = 1;\n  private code: int = 0;\n  private codeDigits: usize = 0;\n  private reason: string = \"\";\n  private hnames: string[] = [];\n  private hvals: string[] = [];\n  private tnames: string[] = [];\n  private tvals: string[] = [];\n  private inTrailers: bool = false;\n  private curName: string = \"\";\n  private curValue: string = \"\";\n  private clCount: usize = 0;\n  private teCount: usize = 0;\n  private hostCount: usize = 0;\n  private clValue: usize = 0;\n  private framing: int = F_NONE;\n  private remaining: usize = 0;\n  private bodyLen: usize = 0;\n  private parts: Bytes[] = [];\n  private noBody: Bytes = empty();\n  private chunkSize: usize = 0;\n  private chunkDigits: usize = 0;\n\n  constructor(isReq: bool, forHead: bool, limits: HttpLimits) {\n    this.isReq = isReq;\n    this.forHead = forHead;\n    this.maxStart = limits.maxStartLine;\n    this.maxCount = limits.maxHeaderCount;\n    this.maxLine = limits.maxHeaderLine;\n    this.maxHead = limits.maxHeaderBytes;\n    this.maxChunk = limits.maxChunkLine;\n    this.maxBody = limits.maxBody;\n    this.state = isReq ? S_METHOD : S_VERSION;\n    this.sectionEnd = limits.maxHeaderBytes;\n    this.lineMax = limits.maxStartLine;\n  }\n\n  // reset(): forget the message and start over (the next pipelined message, or after an error). O(1).\n  @Ensures(this.isIdle())\n  reset(): void {\n    this.state = this.isReq ? S_METHOD : S_VERSION;\n    this.err = None;\n    this.base0 = 0;\n    this.base = 0;\n    this.off = 0;\n    this.cur = 0;\n    this.total = 0;\n    this.sectionEnd = this.maxHead;\n    this.lineLen = 0;\n    this.lineMax = this.maxStart;\n    this.lineStart = 0;\n    this.acc = \"\";\n    this.meth = Get;\n    this.methodToken = \"\";\n    this.target = \"\";\n    this.targetPos = 0;\n    this.vidx = 0;\n    this.minor = 1;\n    this.code = 0;\n    this.codeDigits = 0;\n    this.reason = \"\";\n    // the arrays are replaced only when they hold something: a message without trailers (nearly all of them) leaves the\n    // trailer arrays empty, and a new empty array per field per message is an allocation each. (The header arrays are\n    // shared with the finished message's `Headers`, so they cannot be emptied in place.)\n    if (this.hnames.length > 0) {\n      this.hnames = [];\n      this.hvals = [];\n    }\n    if (this.tnames.length > 0) {\n      this.tnames = [];\n      this.tvals = [];\n    }\n    this.inTrailers = false;\n    this.curName = \"\";\n    this.curValue = \"\";\n    this.clCount = 0;\n    this.teCount = 0;\n    this.hostCount = 0;\n    this.clValue = 0;\n    this.framing = F_NONE;\n    this.remaining = 0;\n    this.bodyLen = 0;\n    if (this.parts.length > 0) {\n      this.parts = [];\n    }\n    this.chunkSize = 0;\n    this.chunkDigits = 0;\n  }\n\n  // isIdle(): no byte of a message was consumed yet. O(1).\n  @Ensures(result == (this.total == 0 && this.state < S_DONE))\n  isIdle(): bool {\n    return this.total == 0 && this.state < S_DONE;\n  }\n\n  // isDone() / isFailed(): the message is complete / refused. O(1).\n  @Ensures(result == (this.state == S_DONE))\n  isDone(): bool {\n    return this.state == S_DONE;\n  }\n\n  @Ensures(result == (this.state == S_ERROR))\n  isFailed(): bool {\n    return this.state == S_ERROR;\n  }\n\n  // stateCode(): the current state (`stateName` gives its name). O(1).\n  @Ensures(result >= S_METHOD && result <= S_ERROR)\n  stateCode(): int {\n    return this.state;\n  }\n\n  // consumed(): bytes consumed since the start of the message (for a failed parser: the offset of the offending\n  // byte). O(1).\n  @Ensures(result == this.total)\n  consumed(): usize {\n    return this.total;\n  }\n\n  // The state change to `dst`; the only way the state changes besides `fail`, and only along `edgeAllowed`.\n  @Requires(edgeAllowed(this.state, dst))\n  @Ensures(this.state == dst)\n  private go(dst: int): void {\n    this.state = dst;\n  }\n\n  // fail(pos, reason): the parser fails at the absolute offset `pos`. Sticky until `reset`.\n  @Requires(this.state < S_DONE)\n  @Ensures(this.state == S_ERROR && this.err.isSome())\n  @Ensures(this.err.unwrap().offset == pos)\n  private fail(pos: usize, reason: HttpErrorKind): void {\n    this.err = Some(httpError(pos, reason));\n    this.state = S_ERROR;\n  }\n\n  // posOf(j): the stream offset of index j of the storage array the scanners read (index `this.off` is the first\n  // byte of the chunk, at stream offset `this.base`). Assignments to fields use `posAt` directly: a method call on\n  // `this` inside the right-hand side of a field store makes the lowering emit an extra `makeunique` of `this`.\n  @Requires(j >= this.off)\n  @Ensures(result == this.base + (j - this.off))\n  private posOf(j: usize): usize {\n    return posAt(this.base, this.off, j);\n  }\n\n  // feed(chunk): consumes bytes of the message. NeedMore: all of `chunk` was consumed. Done(_, used): the message is\n  // complete after `used` bytes of this chunk. Failed(e): refused. In a terminal state it answers Failed without\n  // consuming anything (the stored error, or `ParserFinished` after Done).\n  //\n  // The loop takes one token per step. A step handles the bytes at the cursor `this.cur` in the current state and\n  // moves the cursor; it consumes at least one byte or ends in ERROR, so the loop terminates in at most\n  // chunk.length() + 1 steps. Scanning states read the chunk's storage array (`xs`, the cursor an index\n  // into it); the body states copy nothing: they slice the chunk.\n  @Ensures(resultKind(result) == 0 ==> this.state < S_DONE && this.total == old(this.total) + chunk.length())\n  @Ensures(resultKind(result) == 1 ==> this.state == S_DONE && resultUsed(result) <= chunk.length())\n  @Ensures(resultKind(result) == 1 ==> this.total == old(this.total) + resultUsed(result))\n  @Ensures(resultKind(result) == 2 ==> this.state >= S_DONE)\n  @Ensures(old(this.state) >= S_DONE ==> this.state == old(this.state) && this.total == old(this.total))\n  feed(chunk: Bytes): ParseResult<int> {\n    if (this.state >= S_DONE) {\n      if (this.state == S_ERROR) {\n        return Failed(this.err.unwrap());\n      }\n      return Failed(httpError(this.total, ParserFinished));\n    }\n    this.base0 = this.total;\n    const n = chunk.length();\n    const xs = chunk.storage();\n    const off = chunk.storageStart();\n    this.base = this.base0;\n    this.off = off;\n    let i: usize = 0;\n    while (i < n && this.state < S_DONE) {\n      const st = this.state;\n      if (st == S_BODY) {\n        this.cur = i;\n        this.doBody(chunk, n);\n        i = this.cur;\n      } else if (st == S_CHUNK_DATA) {\n        this.cur = i;\n        this.doChunkData(chunk, n);\n        i = this.cur;\n      } else if (st == S_BODY_CLOSE) {\n        this.cur = i;\n        this.doBodyClose(chunk, n);\n        i = this.cur;\n      } else {\n        let end = n;\n        if (st <= S_HEAD_END_LF) {\n          const budget = this.sectionEnd - this.base0;\n          if (budget < end) {\n            end = budget;\n          }\n          if (i >= end) {\n            this.fail(this.base0 + i, HeadersTooLarge);\n            break;\n          }\n        }\n        const lim = off + end;\n        this.cur = off + i;\n        if (this.lineLen >= this.lineMax && isLineState(st) && HTTP_CLASS.charCodeAt(xs[this.cur].toUsize()) != C_CR) {\n          this.fail(this.posOf(this.cur), lineLimitReason(st));\n          break;\n        }\n        if (st == S_HDR_VALUE) {\n          this.doValue(xs, lim);\n        } else if (st == S_HDR_NAME) {\n          this.doName(xs, lim);\n        } else if (st == S_HDR_LINE) {\n          this.doLineStart(xs, lim);\n        } else if (st == S_HDR_OWS) {\n          this.doOws(xs, lim);\n        } else if (st == S_HDR_LF) {\n          this.doHeaderLf(xs);\n        } else if (st == S_METHOD) {\n          this.doMethod(xs, lim);\n        } else if (st == S_TARGET) {\n          this.doTarget(xs, lim);\n        } else if (st == S_VERSION) {\n          this.doVersion(xs, lim);\n        } else if (st == S_CODE) {\n          this.doCode(xs, lim);\n        } else if (st == S_REASON) {\n          this.doReason(xs, lim);\n        } else if (st == S_START_LF) {\n          this.doStartLf(xs);\n        } else if (st == S_HEAD_END_LF) {\n          this.doHeadEnd(xs);\n        } else if (st == S_CHUNK_SIZE) {\n          this.doChunkSize(xs, lim);\n        } else if (st == S_CHUNK_BWS) {\n          this.doChunkBws(xs, lim);\n        } else if (st == S_CHUNK_EXT) {\n          this.doChunkExt(xs, lim);\n        } else if (st == S_CHUNK_SIZE_LF) {\n          this.doChunkSizeLf(xs);\n        } else if (st == S_CHUNK_CR) {\n          this.doChunkCr(xs);\n        } else {\n          this.doChunkLf(xs);\n        }\n        i = this.cur - off;\n      }\n    }\n    this.total = this.base0 + i;\n    if (this.state == S_ERROR) {\n      return Failed(this.err.unwrap());\n    }\n    if (this.state == S_DONE) {\n      return Done(0, i);\n    }\n    return NeedMore;\n  }\n\n  // atEof(): the peer closed the connection. A response body without Content-Length / chunking ends here (Done);\n  // any other incomplete message is `UnexpectedEof` at the number of bytes received. In a terminal state like `feed`.\n  @Ensures(resultKind(result) == 1 ==> this.state == S_DONE && old(this.state) == S_BODY_CLOSE)\n  @Ensures(resultKind(result) != 0)\n  atEof(): ParseResult<int> {\n    if (this.state == S_BODY_CLOSE) {\n      this.go(S_DONE);\n      return Done(0, 0);\n    }\n    if (this.state >= S_DONE) {\n      if (this.state == S_ERROR) {\n        return Failed(this.err.unwrap());\n      }\n      return Failed(httpError(this.total, ParserFinished));\n    }\n    this.fail(this.total, UnexpectedEof);\n    return Failed(this.err.unwrap());\n  }\n\n  // ---------------------------------------------------------------------------------------- start line\n  // Every step below reads the cursor `this.cur`, handles the bytes xs[cur .. n) in its state and leaves the new\n  // cursor in `this.cur`: a position past at least one byte, or the position of the byte it refused (ERROR).\n\n  // METHOD: a run of token characters, then SP.\n  @Requires(this.state == S_METHOD && this.cur < n && n <= xs.length)\n  @Ensures(this.cur > old(this.cur) || this.state == S_ERROR)\n  private doMethod(xs: u8[], n: usize): void {\n    const i = this.cur;\n    const room = this.lineMax - this.lineLen;\n    const lim = (n - i) < room ? n : i + room;\n    let j = i;\n    while (j < lim && HTTP_CLASS.charCodeAt(xs[j].toUsize()) >= C_TOKEN) {\n      j += 1;\n    }\n    let tok = \"\";\n    if (j > i) {\n      tok = sliceString(xs, i, j);\n      this.lineLen += j - i;\n    }\n    this.cur = j;\n    if (j >= n) {\n      if (j > i) {\n        this.acc += tok;\n      }\n      return;\n    }\n    const c = HTTP_CLASS.charCodeAt(xs[j].toUsize());\n    if (c >= C_TOKEN) {\n      if (j > i) {\n        this.acc += tok;\n      }\n      return;\n    }\n    if (c == C_SP && this.lineLen > 0) {\n      if (this.lineLen >= this.lineMax) {\n        this.fail(this.posOf(j), StartLineTooLong);\n        return;\n      }\n      this.lineLen += 1;\n      if (this.acc.length > 0) {\n        this.acc += tok;\n        tok = this.acc;\n        this.acc = \"\";\n      }\n      this.methodToken = tok;\n      this.meth = methodFromToken(tok).unwrap();\n      this.go(S_TARGET);\n      this.targetPos = posAt(this.base, this.off, j) + 1;\n      this.cur = j + 1;\n      return;\n    }\n    this.fail(this.posOf(j), InvalidMethod);\n  }\n\n  // TARGET: a run of 0x21..0x7E, then SP.\n  @Requires(this.state == S_TARGET && this.cur < n && n <= xs.length)\n  @Ensures(this.cur > old(this.cur) || this.state == S_ERROR)\n  private doTarget(xs: u8[], n: usize): void {\n    const i = this.cur;\n    const room = this.lineMax - this.lineLen;\n    const lim = (n - i) < room ? n : i + room;\n    let j = i;\n    while (j < lim && HTTP_CLASS.charCodeAt(xs[j].toUsize()) >= 6) {\n      j += 1;\n    }\n    let tok = \"\";\n    if (j > i) {\n      tok = sliceString(xs, i, j);\n      this.lineLen += j - i;\n    }\n    this.cur = j;\n    if (j >= n) {\n      if (j > i) {\n        this.acc += tok;\n      }\n      return;\n    }\n    const c = HTTP_CLASS.charCodeAt(xs[j].toUsize());\n    if (c >= 6) {\n      if (j > i) {\n        this.acc += tok;\n      }\n      return;\n    }\n    if (c == C_SP && this.lineLen > this.methodToken.length + 1) {\n      if (this.lineLen >= this.lineMax) {\n        this.fail(this.posOf(j), StartLineTooLong);\n        return;\n      }\n      this.lineLen += 1;\n      if (this.acc.length > 0) {\n        this.acc += tok;\n        tok = this.acc;\n        this.acc = \"\";\n      }\n      this.target = tok;\n      this.go(S_VERSION);\n      this.vidx = 0;\n      this.cur = j + 1;\n      return;\n    }\n    if (c == C_CR && this.lineLen > this.methodToken.length + 1) {\n      this.fail(this.posOf(j), InvalidVersion);\n      return;\n    }\n    this.fail(this.posOf(j), InvalidTarget);\n  }\n\n  // VERSION: \"HTTP/1.\" and a digit (0 or 1), then CR (request) or SP (response).\n  @Requires(this.state == S_VERSION && this.cur < n && n <= xs.length)\n  @Ensures(this.cur > old(this.cur) || this.state == S_ERROR)\n  private doVersion(xs: u8[], n: usize): void {\n    let j = this.cur;\n    while (j < n && this.vidx < 8 && this.lineLen < this.lineMax) {\n      const c = xs[j].toInt();\n      const k = this.vidx;\n      if (k < 7) {\n        if (c != \"HTTP/1.\".charCodeAt(k)) {\n          this.cur = j;\n          if (k == 5 && c >= 48 && c <= 57) {\n            this.fail(this.posOf(j), UnsupportedVersion);\n          } else {\n            this.fail(this.posOf(j), InvalidVersion);\n          }\n          return;\n        }\n      } else if (c == 48) {\n        this.minor = 0;\n      } else if (c == 49) {\n        this.minor = 1;\n      } else if (c >= 50 && c <= 57) {\n        this.cur = j;\n        this.fail(this.posOf(j), UnsupportedVersion);\n        return;\n      } else {\n        this.cur = j;\n        this.fail(this.posOf(j), InvalidVersion);\n        return;\n      }\n      this.vidx += 1;\n      this.lineLen += 1;\n      j += 1;\n    }\n    this.cur = j;\n    if (this.vidx < 8) {\n      if (j < n) {\n        if (this.lineLen >= this.lineMax && HTTP_CLASS.charCodeAt(xs[j].toUsize()) != C_CR) {\n          this.fail(this.posOf(j), StartLineTooLong);\n        } else {\n          this.fail(this.posOf(j), InvalidVersion);\n        }\n      }\n      return;\n    }\n    if (j >= n) {\n      return;\n    }\n    const d = HTTP_CLASS.charCodeAt(xs[j].toUsize());\n    if (this.isReq) {\n      if (d == C_CR) {\n        this.go(S_START_LF);\n        this.cur = j + 1;\n        return;\n      }\n      if (d == C_LF) {\n        this.fail(this.posOf(j), BareLf);\n      } else {\n        this.fail(this.posOf(j), InvalidVersion);\n      }\n      return;\n    }\n    if (d == C_SP) {\n      if (this.lineLen >= this.lineMax) {\n        this.fail(this.posOf(j), StartLineTooLong);\n        return;\n      }\n      this.lineLen += 1;\n      this.go(S_CODE);\n      this.code = 0;\n      this.codeDigits = 0;\n      this.cur = j + 1;\n      return;\n    }\n    if (d == C_LF) {\n      this.fail(this.posOf(j), BareLf);\n    } else {\n      this.fail(this.posOf(j), InvalidStatusLine);\n    }\n  }\n\n  // CODE: exactly three digits (first 1..5), then SP.\n  @Requires(this.state == S_CODE && this.cur < n && n <= xs.length)\n  @Ensures(this.cur > old(this.cur) || this.state == S_ERROR)\n  private doCode(xs: u8[], n: usize): void {\n    let j = this.cur;\n    while (j < n && this.codeDigits < 3 && this.lineLen < this.lineMax) {\n      const c = xs[j].toInt();\n      if (c < 48 || c > 57 || (this.codeDigits == 0 && (c < 49 || c > 53))) {\n        this.cur = j;\n        this.fail(this.posOf(j), InvalidStatusCode);\n        return;\n      }\n      this.code = this.code * 10 + (c - 48);\n      this.codeDigits += 1;\n      this.lineLen += 1;\n      j += 1;\n    }\n    this.cur = j;\n    if (this.codeDigits < 3) {\n      if (j < n) {\n        if (this.lineLen >= this.lineMax && HTTP_CLASS.charCodeAt(xs[j].toUsize()) != C_CR) {\n          this.fail(this.posOf(j), StartLineTooLong);\n        } else {\n          this.fail(this.posOf(j), InvalidStatusCode);\n        }\n      }\n      return;\n    }\n    if (j >= n) {\n      return;\n    }\n    const d = HTTP_CLASS.charCodeAt(xs[j].toUsize());\n    if (d == C_SP) {\n      if (this.lineLen >= this.lineMax) {\n        this.fail(this.posOf(j), StartLineTooLong);\n        return;\n      }\n      this.lineLen += 1;\n      this.go(S_REASON);\n      this.cur = j + 1;\n      return;\n    }\n    if (d == C_LF) {\n      this.fail(this.posOf(j), BareLf);\n    } else {\n      this.fail(this.posOf(j), InvalidStatusLine);\n    }\n  }\n\n  // REASON: a run of field bytes, then CR.\n  @Requires(this.state == S_REASON && this.cur < n && n <= xs.length)\n  @Ensures(this.cur > old(this.cur) || this.state == S_ERROR)\n  private doReason(xs: u8[], n: usize): void {\n    const i = this.cur;\n    const room = this.lineMax - this.lineLen;\n    const lim = (n - i) < room ? n : i + room;\n    let j = i;\n    while (j < lim && HTTP_CLASS.charCodeAt(xs[j].toUsize()) >= C_HTAB) {\n      j += 1;\n    }\n    let tok = \"\";\n    if (j > i) {\n      tok = sliceString(xs, i, j);\n      this.lineLen += j - i;\n    }\n    this.cur = j;\n    if (j >= n) {\n      if (j > i) {\n        this.acc += tok;\n      }\n      return;\n    }\n    const c = HTTP_CLASS.charCodeAt(xs[j].toUsize());\n    if (c >= C_HTAB) {\n      if (j > i) {\n        this.acc += tok;\n      }\n      return;\n    }\n    if (c == C_CR) {\n      if (this.acc.length > 0) {\n        this.acc += tok;\n        tok = this.acc;\n        this.acc = \"\";\n      }\n      this.reason = tok;\n      this.go(S_START_LF);\n      this.cur = j + 1;\n      return;\n    }\n    if (c == C_LF) {\n      this.fail(this.posOf(j), BareLf);\n    } else {\n      this.fail(this.posOf(j), InvalidStatusLine);\n    }\n  }\n\n  // START_LF: the LF of the start line; then the header section begins.\n  @Requires(this.state == S_START_LF && this.cur < xs.length)\n  @Ensures(this.cur > old(this.cur) || this.state == S_ERROR)\n  private doStartLf(xs: u8[]): void {\n    const i = this.cur;\n    if (xs[i].toInt() != 10) {\n      this.fail(this.posOf(i), BareCr);\n      return;\n    }\n    if (this.isReq && !isValidTarget(this.meth, this.target)) {\n      this.fail(this.targetPos, InvalidTarget);\n      return;\n    }\n    this.go(S_HDR_LINE);\n    this.lineLen = 0;\n    this.lineMax = this.maxLine;\n    this.lineStart = posAt(this.base, this.off, i) + 1;\n    this.cur = i + 1;\n  }\n\n  // ----------------------------------------------------------------------------- header and trailer fields\n\n  // HDR_LINE: the first byte of a line of the header (or trailer) section.\n  @Requires(this.state == S_HDR_LINE && this.cur < n && n <= xs.length)\n  @Ensures(this.cur > old(this.cur) || this.state == S_ERROR)\n  private doLineStart(xs: u8[], n: usize): void {\n    const i = this.cur;\n    const c = HTTP_CLASS.charCodeAt(xs[i].toUsize());\n    if (c >= C_TOKEN) {\n      const count = this.inTrailers ? this.tnames.length : this.hnames.length;\n      if (count >= this.maxCount) {\n        this.fail(this.posOf(i), TooManyHeaders);\n        return;\n      }\n      this.lineStart = posAt(this.base, this.off, i);\n      this.lineLen = 0;\n      this.go(S_HDR_NAME);\n      this.doName(xs, n);\n      return;\n    }\n    if (c == C_CR) {\n      this.go(S_HEAD_END_LF);\n      this.cur = i + 1;\n      return;\n    }\n    if (c == C_LF) {\n      this.fail(this.posOf(i), BareLf);\n    } else if (c == C_SP || c == C_HTAB) {\n      this.fail(this.posOf(i), ObsFold);\n    } else {\n      this.fail(this.posOf(i), InvalidFieldName);\n    }\n  }\n\n  // HDR_NAME: a run of token characters, then \":\".\n  @Requires(this.state == S_HDR_NAME && this.cur < n && n <= xs.length)\n  @Ensures(this.cur > old(this.cur) || this.state == S_ERROR)\n  private doName(xs: u8[], n: usize): void {\n    const i = this.cur;\n    const room = this.lineMax - this.lineLen;\n    const lim = (n - i) < room ? n : i + room;\n    let j = i;\n    while (j < lim && HTTP_CLASS.charCodeAt(xs[j].toUsize()) >= C_TOKEN) {\n      j += 1;\n    }\n    let tok = \"\";\n    if (j > i) {\n      tok = sliceString(xs, i, j);\n      this.lineLen += j - i;\n    }\n    this.cur = j;\n    if (j >= n) {\n      if (j > i) {\n        this.acc += tok;\n      }\n      return;\n    }\n    const c = HTTP_CLASS.charCodeAt(xs[j].toUsize());\n    if (c >= C_TOKEN) {\n      if (j > i) {\n        this.acc += tok;\n      }\n      return;\n    }\n    if (c == C_COLON) {\n      if (this.lineLen >= this.lineMax) {\n        this.fail(this.posOf(j), HeaderLineTooLong);\n        return;\n      }\n      this.lineLen += 1;\n      if (this.acc.length > 0) {\n        this.acc += tok;\n        tok = this.acc;\n        this.acc = \"\";\n      }\n      this.curName = tok;\n      this.go(S_HDR_OWS);\n      this.cur = j + 1;\n      return;\n    }\n    if (c == C_SP || c == C_HTAB) {\n      this.fail(this.posOf(j), SpaceBeforeColon);\n    } else if (c == C_CR) {\n      this.fail(this.posOf(j), MissingColon);\n    } else if (c == C_LF) {\n      this.fail(this.posOf(j), BareLf);\n    } else {\n      this.fail(this.posOf(j), InvalidFieldName);\n    }\n  }\n\n  // HDR_OWS: optional whitespace after the colon, then the value (or CR for an empty value).\n  @Requires(this.state == S_HDR_OWS && this.cur < n && n <= xs.length)\n  @Ensures(this.cur > old(this.cur) || this.state == S_ERROR)\n  private doOws(xs: u8[], n: usize): void {\n    const i = this.cur;\n    const room = this.lineMax - this.lineLen;\n    const lim = (n - i) < room ? n : i + room;\n    let j = i;\n    while (j < lim && isOws(xs[j].toInt())) {\n      j += 1;\n    }\n    this.lineLen += j - i;\n    this.cur = j;\n    if (j >= n) {\n      return;\n    }\n    const c = HTTP_CLASS.charCodeAt(xs[j].toUsize());\n    if (c == C_SP || c == C_HTAB) {\n      return;\n    }\n    if (c == C_CR) {\n      this.curValue = \"\";\n      this.go(S_HDR_LF);\n      this.cur = j + 1;\n      return;\n    }\n    this.go(S_HDR_VALUE);\n    if (j > i) {\n      return;\n    }\n    this.doValue(xs, n);\n  }\n\n  // HDR_VALUE: a run of field bytes, then CR; trailing blanks are not part of the value.\n  @Requires(this.state == S_HDR_VALUE && this.cur < n && n <= xs.length)\n  @Ensures(this.cur > old(this.cur) || this.state == S_ERROR)\n  private doValue(xs: u8[], n: usize): void {\n    const i = this.cur;\n    const room = this.lineMax - this.lineLen;\n    const lim = (n - i) < room ? n : i + room;\n    let j = i;\n    while (j < lim && HTTP_CLASS.charCodeAt(xs[j].toUsize()) >= C_HTAB) {\n      j += 1;\n    }\n    this.lineLen += j - i;\n    this.cur = j;\n    if (j >= n || (j == lim && HTTP_CLASS.charCodeAt(xs[j].toUsize()) >= C_HTAB)) {\n      if (j > i) {\n        const tok = sliceString(xs, i, j);\n        this.acc += tok;\n      }\n      return;\n    }\n    const c = HTTP_CLASS.charCodeAt(xs[j].toUsize());\n    if (c == C_CR) {\n      let e = j;\n      while (e > i && isOws(xs[e - 1].toInt())) {\n        e -= 1;\n      }\n      if (this.acc.length == 0) {\n        this.curValue = sliceString(xs, i, e);\n      } else {\n        this.acc += sliceString(xs, i, e);\n        this.curValue = trimEndOws(this.acc);\n        this.acc = \"\";\n      }\n      this.go(S_HDR_LF);\n      this.cur = j + 1;\n      return;\n    }\n    if (c == C_LF) {\n      this.fail(this.posOf(j), BareLf);\n    } else {\n      this.fail(this.posOf(j), InvalidFieldValue);\n    }\n  }\n\n  // HDR_LF: the LF that ends a header line; the field is complete and checked.\n  @Requires(this.state == S_HDR_LF && this.cur < xs.length)\n  @Ensures(this.cur > old(this.cur) || this.state == S_ERROR)\n  private doHeaderLf(xs: u8[]): void {\n    const i = this.cur;\n    if (xs[i].toInt() != 10) {\n      this.fail(this.posOf(i), BareCr);\n      return;\n    }\n    this.commitHeader();\n    if (this.state == S_ERROR) {\n      return;\n    }\n    this.go(S_HDR_LINE);\n    this.lineLen = 0;\n    this.lineStart = posAt(this.base, this.off, i) + 1;\n    this.cur = i + 1;\n  }\n\n  // The field (curName, curValue) is complete: apply the framing and Host rules, then store it.\n  @Requires(this.state == S_HDR_LF)\n  @Ensures(this.state == S_ERROR || this.state == S_HDR_LF)\n  private commitHeader(): void {\n    const name = this.curName;\n    if (this.inTrailers) {\n      if (isForbiddenTrailerName(name)) {\n        this.fail(this.lineStart, ForbiddenTrailer);\n        return;\n      }\n      this.tnames.push(name);\n      this.tvals.push(this.curValue);\n      return;\n    }\n    const nl = name.length;\n    if (nl == 14 && eqIgnoreCase(name, \"content-length\")) {\n      this.clCount += 1;\n      if (this.clCount > 1) {\n        this.fail(this.lineStart, DuplicateContentLength);\n        return;\n      }\n      const v = parseContentLength(this.curValue);\n      if (v.isNone()) {\n        this.fail(this.lineStart, InvalidContentLength);\n        return;\n      }\n      this.clValue = v.unwrap();\n    } else if (nl == 17 && eqIgnoreCase(name, \"transfer-encoding\")) {\n      this.teCount += 1;\n      if (this.teCount > 1) {\n        this.fail(this.lineStart, DuplicateTransferEncoding);\n        return;\n      }\n      if (!eqIgnoreCase(this.curValue, \"chunked\")) {\n        this.fail(this.lineStart, UnsupportedTransferEncoding);\n        return;\n      }\n    } else if (nl == 4 && this.isReq && eqIgnoreCase(name, \"host\")) {\n      this.hostCount += 1;\n      if (this.hostCount > 1) {\n        this.fail(this.lineStart, DuplicateHost);\n        return;\n      }\n      if (!isHostValue(this.curValue)) {\n        this.fail(this.lineStart, InvalidHost);\n        return;\n      }\n    }\n    this.hnames.push(name);\n    this.hvals.push(this.curValue);\n  }\n\n  // HEAD_END_LF: the LF of the empty line. The end of the headers decides the framing; the end of the trailers\n  // ends the message.\n  @Requires(this.state == S_HEAD_END_LF && this.cur < xs.length)\n  @Ensures(this.cur > old(this.cur) || this.state == S_ERROR)\n  private doHeadEnd(xs: u8[]): void {\n    const i = this.cur;\n    if (xs[i].toInt() != 10) {\n      this.fail(this.posOf(i), BareCr);\n      return;\n    }\n    this.cur = i + 1;\n    if (this.inTrailers) {\n      this.go(S_DONE);\n      return;\n    }\n    this.decideFraming(this.posOf(i) - 1);\n  }\n\n  // End of the header section at `at` (the CR of the empty line): apply the rules that need all the fields and pick\n  // how the body is delimited (RFC 9112 \xc2\xa76.3).\n  @Requires(this.state == S_HEAD_END_LF && !this.inTrailers)\n  @Ensures(this.state != S_HEAD_END_LF)\n  private decideFraming(at: usize): void {\n    if (this.isReq && this.minor == 1 && this.hostCount == 0) {\n      this.fail(at, MissingHost);\n      return;\n    }\n    if (this.teCount > 0 && this.minor == 0) {\n      this.fail(at, UnsupportedTransferEncoding);\n      return;\n    }\n    if (this.teCount > 0 && this.clCount > 0) {\n      this.fail(at, ContentLengthWithTransferEncoding);\n      return;\n    }\n    let bodyless = false;\n    if (!this.isReq) {\n      if ((this.code < 200 || this.code == 204) && (this.teCount > 0 || this.clCount > 0)) {\n        this.fail(at, ForbiddenFraming);\n        return;\n      }\n      bodyless = this.forHead || this.code < 200 || this.code == 204 || this.code == 304;\n    }\n    if (bodyless) {\n      this.go(S_DONE);\n      return;\n    }\n    if (this.teCount > 0) {\n      this.framing = F_CHUNKED;\n      this.chunkSize = 0;\n      this.chunkDigits = 0;\n      this.lineLen = 0;\n      this.lineMax = this.maxChunk;\n      this.go(S_CHUNK_SIZE);\n      return;\n    }\n    if (this.clCount > 0) {\n      if (this.clValue > this.maxBody) {\n        this.fail(at, BodyTooLarge);\n        return;\n      }\n      if (this.clValue == 0) {\n        this.go(S_DONE);\n        return;\n      }\n      this.framing = F_LENGTH;\n      this.remaining = this.clValue;\n      this.go(S_BODY);\n      return;\n    }\n    if (this.isReq) {\n      this.go(S_DONE);\n      return;\n    }\n    this.framing = F_CLOSE;\n    this.go(S_BODY_CLOSE);\n  }\n\n  // ------------------------------------------------------------------------------------------------ body\n  // The body states take the cursor as an absolute index into the chunk (no window): they slice the chunk.\n\n  // BODY: the next bytes of a Content-Length body: a slice of the chunk, no copy.\n  @Requires(this.state == S_BODY && this.cur < n && n <= chunk.length())\n  @Ensures(this.cur > old(this.cur))\n  private doBody(chunk: Bytes, n: usize): void {\n    const i = this.cur;\n    const avail = n - i;\n    const take = avail < this.remaining ? avail : this.remaining;\n    this.parts.push(chunk.slice(i, i + take));\n    this.remaining -= take;\n    this.bodyLen += take;\n    if (this.remaining == 0) {\n      this.go(S_DONE);\n    }\n    this.cur = i + take;\n  }\n\n  // BODY_CLOSE: a response body that runs until the peer closes (`atEof`), within the body limit.\n  @Requires(this.state == S_BODY_CLOSE && this.cur < n && n <= chunk.length())\n  @Ensures(this.cur > old(this.cur) || this.state == S_ERROR)\n  private doBodyClose(chunk: Bytes, n: usize): void {\n    const i = this.cur;\n    const room = this.maxBody - this.bodyLen;\n    if (room == 0) {\n      this.fail(this.base0 + i, BodyTooLarge);\n      return;\n    }\n    const avail = n - i;\n    const take = avail < room ? avail : room;\n    this.parts.push(chunk.slice(i, i + take));\n    this.bodyLen += take;\n    this.cur = i + take;\n  }\n\n  // CHUNK_DATA: the next bytes of the current chunk: a slice of the input.\n  @Requires(this.state == S_CHUNK_DATA && this.cur < n && n <= chunk.length())\n  @Ensures(this.cur > old(this.cur))\n  private doChunkData(chunk: Bytes, n: usize): void {\n    const i = this.cur;\n    const avail = n - i;\n    const take = avail < this.remaining ? avail : this.remaining;\n    this.parts.push(chunk.slice(i, i + take));\n    this.remaining -= take;\n    this.bodyLen += take;\n    if (this.remaining == 0) {\n      this.go(S_CHUNK_CR);\n    }\n    this.cur = i + take;\n  }\n\n  // CHUNK_SIZE: hexadecimal digits of the chunk size, then (BWS) \";\" extension or CR.\n  @Requires(this.state == S_CHUNK_SIZE && this.cur < n && n <= xs.length)\n  @Ensures(this.cur > old(this.cur) || this.state == S_ERROR)\n  private doChunkSize(xs: u8[], n: usize): void {\n    const i = this.cur;\n    const room = this.lineMax - this.lineLen;\n    const lim = (n - i) < room ? n : i + room;\n    const allowed = this.maxBody - this.bodyLen;\n    let sz = this.chunkSize;\n    let j = i;\n    while (j < lim) {\n      const hv = HTTP_HEXV.charCodeAt(xs[j].toUsize());\n      if (hv > 15) {\n        break;\n      }\n      sz = sz * 16 + hv.toUsize();\n      if (sz > allowed) {\n        this.chunkSize = sz;\n        this.cur = j;\n        this.fail(this.posOf(j), BodyTooLarge);\n        return;\n      }\n      j += 1;\n    }\n    this.chunkSize = sz;\n    this.chunkDigits += j - i;\n    this.lineLen += j - i;\n    this.cur = j;\n    if (j >= n) {\n      return;\n    }\n    if (HTTP_HEXV.charCodeAt(xs[j].toUsize()) <= 15) {\n      return;\n    }\n    const c = HTTP_CLASS.charCodeAt(xs[j].toUsize());\n    if (this.chunkDigits == 0) {\n      this.fail(this.posOf(j), InvalidChunkSize);\n      return;\n    }\n    if (c == C_CR) {\n      this.go(S_CHUNK_SIZE_LF);\n      this.cur = j + 1;\n      return;\n    }\n    if (c == C_SEMI || c == C_SP || c == C_HTAB) {\n      if (this.lineLen >= this.lineMax) {\n        this.fail(this.posOf(j), ChunkLineTooLong);\n        return;\n      }\n      this.lineLen += 1;\n      this.go(c == C_SEMI ? S_CHUNK_EXT : S_CHUNK_BWS);\n      this.cur = j + 1;\n      return;\n    }\n    if (c == C_LF) {\n      this.fail(this.posOf(j), BareLf);\n    } else {\n      this.fail(this.posOf(j), InvalidChunkSize);\n    }\n  }\n\n  // CHUNK_BWS: blanks after the size, then \";\" or CR.\n  @Requires(this.state == S_CHUNK_BWS && this.cur < n && n <= xs.length)\n  @Ensures(this.cur > old(this.cur) || this.state == S_ERROR)\n  private doChunkBws(xs: u8[], n: usize): void {\n    const i = this.cur;\n    const room = this.lineMax - this.lineLen;\n    const lim = (n - i) < room ? n : i + room;\n    let j = i;\n    while (j < lim && isOws(xs[j].toInt())) {\n      j += 1;\n    }\n    this.lineLen += j - i;\n    this.cur = j;\n    if (j >= n) {\n      return;\n    }\n    const c = HTTP_CLASS.charCodeAt(xs[j].toUsize());\n    if (c == C_SP || c == C_HTAB) {\n      return;\n    }\n    if (c == C_CR) {\n      this.go(S_CHUNK_SIZE_LF);\n      this.cur = j + 1;\n      return;\n    }\n    if (c == C_SEMI) {\n      if (this.lineLen >= this.lineMax) {\n        this.fail(this.posOf(j), ChunkLineTooLong);\n        return;\n      }\n      this.lineLen += 1;\n      this.go(S_CHUNK_EXT);\n      this.cur = j + 1;\n      return;\n    }\n    if (c == C_LF) {\n      this.fail(this.posOf(j), BareLf);\n    } else {\n      this.fail(this.posOf(j), InvalidChunkSize);\n    }\n  }\n\n  // CHUNK_EXT: the chunk extension, ignored: a run of field bytes, then CR; control characters are refused.\n  @Requires(this.state == S_CHUNK_EXT && this.cur < n && n <= xs.length)\n  @Ensures(this.cur > old(this.cur) || this.state == S_ERROR)\n  private doChunkExt(xs: u8[], n: usize): void {\n    const i = this.cur;\n    const room = this.lineMax - this.lineLen;\n    const lim = (n - i) < room ? n : i + room;\n    let j = i;\n    while (j < lim && HTTP_CLASS.charCodeAt(xs[j].toUsize()) >= C_HTAB) {\n      j += 1;\n    }\n    this.lineLen += j - i;\n    this.cur = j;\n    if (j >= n) {\n      return;\n    }\n    const c = HTTP_CLASS.charCodeAt(xs[j].toUsize());\n    if (c >= C_HTAB) {\n      return;\n    }\n    if (c == C_CR) {\n      this.go(S_CHUNK_SIZE_LF);\n      this.cur = j + 1;\n      return;\n    }\n    if (c == C_LF) {\n      this.fail(this.posOf(j), BareLf);\n    } else {\n      this.fail(this.posOf(j), InvalidChunkExtension);\n    }\n  }\n\n  // CHUNK_SIZE_LF: the LF of the chunk-size line. Size 0: the trailer section follows; else the chunk data.\n  // (The cursor is an index into the storage array here; the chunk data state that follows uses a cursor relative to\n  // the chunk, which `feed` recomputes from the chunk's start in the array.)\n  @Requires(this.state == S_CHUNK_SIZE_LF && this.cur < xs.length)\n  @Ensures(this.cur > old(this.cur) || this.state == S_ERROR)\n  private doChunkSizeLf(xs: u8[]): void {\n    const i = this.cur;\n    if (xs[i].toInt() != 10) {\n      this.fail(this.posOf(i), BareCr);\n      return;\n    }\n    this.cur = i + 1;\n    if (this.chunkSize == 0) {\n      this.inTrailers = true;\n      this.sectionEnd = posAt(this.base, this.off, i) + 1 + this.maxHead;\n      this.lineLen = 0;\n      this.lineMax = this.maxLine;\n      this.lineStart = posAt(this.base, this.off, i) + 1;\n      this.go(S_HDR_LINE);\n      return;\n    }\n    this.remaining = this.chunkSize;\n    this.go(S_CHUNK_DATA);\n  }\n\n  // CHUNK_CR: the CR after the chunk data.\n  @Requires(this.state == S_CHUNK_CR && this.cur < xs.length)\n  @Ensures(this.cur > old(this.cur) || this.state == S_ERROR)\n  private doChunkCr(xs: u8[]): void {\n    const i = this.cur;\n    const c = xs[i].toInt();\n    if (c == 13) {\n      this.go(S_CHUNK_LF);\n      this.cur = i + 1;\n      return;\n    }\n    if (c == 10) {\n      this.fail(this.posOf(i), BareLf);\n    } else {\n      this.fail(this.posOf(i), InvalidChunkTerminator);\n    }\n  }\n\n  // CHUNK_LF: the LF after the chunk data; the next chunk-size line follows.\n  @Requires(this.state == S_CHUNK_LF && this.cur < xs.length)\n  @Ensures(this.cur > old(this.cur) || this.state == S_ERROR)\n  private doChunkLf(xs: u8[]): void {\n    const i = this.cur;\n    if (xs[i].toInt() != 10) {\n      this.fail(this.posOf(i), BareCr);\n      return;\n    }\n    this.chunkSize = 0;\n    this.chunkDigits = 0;\n    this.lineLen = 0;\n    this.lineMax = this.maxChunk;\n    this.go(S_CHUNK_SIZE);\n    this.cur = i + 1;\n  }\n\n  // ---------------------------------------------------------------------------------- the finished message\n\n  // bodyBytes(): the collected body (all `parts` concatenated; one part is returned as it is, without a copy, and no\n  // part as the parser's one empty `Bytes`).\n  @Requires(this.state == S_DONE)\n  @Ensures(result.length() == this.bodyLen)\n  bodyBytes(): Bytes {\n    if (this.parts.length == 0) {\n      return this.noBody;\n    }\n    if (this.parts.length == 1) {\n      return this.parts[0];\n    }\n    let all = new ByteBuilder();\n    all.reserve(this.bodyLen);\n    let k: usize = 0;\n    while (k < this.parts.length) {\n      all.appendBytes(this.parts[k]);\n      k += 1;\n    }\n    return all.build();\n  }\n\n  // httpVersion(): the version of the start line.\n  @Requires(this.state == S_DONE)\n  httpVersion(): HttpVersion {\n    return this.minor == 0 ? Http10 : Http11;\n  }\n\n  // buildRequest(): the parsed request (the constructor re-checks every rule). Request parsers only.\n  @Requires(this.state == S_DONE && this.isReq)\n  buildRequest(): Request {\n    return new Request(this.meth, this.target, this.httpVersion(), new Headers(this.hnames, this.hvals), this.bodyBytes(),\n      new Headers(this.tnames, this.tvals));\n  }\n\n  // buildResponse(): the parsed response. Response parsers only.\n  @Requires(this.state == S_DONE && !this.isReq)\n  buildResponse(): Response {\n    return new Response(new Status(this.code, this.reason), this.httpVersion(), new Headers(this.hnames, this.hvals),\n      this.bodyBytes(), new Headers(this.tnames, this.tvals), this.forHead);\n  }\n}\n\n\n// --------------------------------------------------------------------------------- public parser classes\n\n// The incremental HTTP/1.1 request parser. `feed` accepts bytes in arbitrary chunks; see the top of the file.\n// After `Done` (or `Failed`) call `reset()` to parse the next message of a connection.\n@Invariant(this.core.stateCode() >= S_METHOD && this.core.stateCode() <= S_ERROR)\n@Invariant(!this.core.isDone() || this.core.consumed() > 0)\nexport class RequestParser {\n  private core: MessageParser;\n\n  // new RequestParser(limits) -- a parser in its start state. Traps unless `isValidLimits(limits)`.\n  @Requires(isValidLimits(limits))\n  constructor(limits: HttpLimits) {\n    this.core = new MessageParser(true, false, limits);\n    enforce(isValidLimits(limits), \"invalid HttpLimits\");\n  }\n\n  // feed(chunk): ParseResult<Request> -- the next bytes of the request: NeedMore | Done(request, used) | Failed(error).\n  // O(chunk) per call.\n  @Ensures(resultKind(result) == 0 ==> !this.isDone() && !this.isFailed())\n  @Ensures(resultKind(result) == 1 ==> this.isDone() && resultUsed(result) <= chunk.length())\n  @Ensures(resultKind(result) == 2 ==> this.isFailed() || old(this.isDone()))\n  feed(chunk: Bytes): ParseResult<Request> {\n    const r = this.core.feed(chunk);\n    return match (r) {\n      NeedMore => NeedMore,\n      Failed(e) => Failed(e),\n      Done(z, used) => Done(this.core.buildRequest(), used)\n    };\n  }\n\n  // atEof(): ParseResult<Request> -- the peer closed the connection: always `Failed(UnexpectedEof)` for a request that is\n  // not complete.\n  @Ensures(resultKind(result) == 2)\n  atEof(): ParseResult<Request> {\n    const r = this.core.atEof();\n    return match (r) {\n      NeedMore => NeedMore,\n      Failed(e) => Failed(e),\n      Done(z, used) => Done(this.core.buildRequest(), used)\n    };\n  }\n\n  // reset(): void -- forgets the current message and starts a new one. O(1).\n  @Ensures(this.isIdle())\n  reset(): void {\n    this.core.reset();\n  }\n\n  // isIdle(): bool -- no byte of a message consumed yet (a connection closed now is a clean close). O(1).\n  @Ensures(result == (this.consumed() == 0 && !this.isDone() && !this.isFailed()))\n  isIdle(): bool {\n    return this.core.isIdle();\n  }\n\n  // isDone(): bool -- the message is complete (call `reset()` for the next one). O(1).\n  isDone(): bool {\n    return this.core.isDone();\n  }\n\n  // isFailed(): bool -- the message was refused; the error was returned as `Failed` (call `reset()` to start over). O(1).\n  isFailed(): bool {\n    return this.core.isFailed();\n  }\n\n  // consumed(): usize -- bytes consumed since the start of the message. O(1).\n  consumed(): usize {\n    return this.core.consumed();\n  }\n\n  // stateName(): string -- the current state, e.g. \"HDR_VALUE\". O(1).\n  @Ensures(result.length > 0)\n  stateName(): string {\n    return stateName(this.core.stateCode());\n  }\n}\n\n// The incremental HTTP/1.1 response parser (for a client). `forHead`: the response is to a HEAD request, so no body\n// follows whatever the headers say. A response without Content-Length and Transfer-Encoding ends at connection\n// close: feed all input, then call `atEof()` for `Done`.\n@Invariant(this.core.stateCode() >= S_VERSION && this.core.stateCode() <= S_ERROR)\nexport class ResponseParser {\n  private core: MessageParser;\n\n  // new ResponseParser(limits, to) -- a parser in its start state; `to` says whether the response answers a HEAD\n  // request. Traps unless `isValidLimits(limits)`.\n  @Requires(isValidLimits(limits))\n  constructor(limits: HttpLimits, to: ResponseTo) {\n    this.core = new MessageParser(false, isToHead(to), limits);\n    enforce(isValidLimits(limits), \"invalid HttpLimits\");\n  }\n\n  // feed(chunk): ParseResult<Response> -- the next bytes of the response: NeedMore | Done(response, used) | Failed(error).\n  // O(chunk) per call.\n  @Ensures(resultKind(result) == 0 ==> !this.isDone() && !this.isFailed())\n  @Ensures(resultKind(result) == 1 ==> this.isDone() && resultUsed(result) <= chunk.length())\n  @Ensures(resultKind(result) == 2 ==> this.isFailed() || old(this.isDone()))\n  feed(chunk: Bytes): ParseResult<Response> {\n    const r = this.core.feed(chunk);\n    return match (r) {\n      NeedMore => NeedMore,\n      Failed(e) => Failed(e),\n      Done(z, used) => Done(this.core.buildResponse(), used)\n    };\n  }\n\n  // atEof(): ParseResult<Response> -- the peer closed the connection: `Done` for a response whose body runs until close,\n  // else `Failed(UnexpectedEof)`.\n  @Ensures(resultKind(result) != 0)\n  atEof(): ParseResult<Response> {\n    const r = this.core.atEof();\n    return match (r) {\n      NeedMore => NeedMore,\n      Failed(e) => Failed(e),\n      Done(z, used) => Done(this.core.buildResponse(), used)\n    };\n  }\n\n  // reset(): void -- forgets the current message and starts a new one. O(1).\n  @Ensures(this.isIdle())\n  reset(): void {\n    this.core.reset();\n  }\n\n  // isIdle(): bool -- no byte of a message consumed yet. O(1).\n  isIdle(): bool {\n    return this.core.isIdle();\n  }\n\n  // isDone(): bool -- the message is complete (call `reset()` for the next one). O(1).\n  isDone(): bool {\n    return this.core.isDone();\n  }\n\n  // isFailed(): bool -- the message was refused; the error was returned as `Failed` (call `reset()` to start over). O(1).\n  isFailed(): bool {\n    return this.core.isFailed();\n  }\n\n  // consumed(): usize -- bytes consumed since the start of the message. O(1).\n  consumed(): usize {\n    return this.core.consumed();\n  }\n\n  // stateName(): string -- the current state, e.g. \"BODY\". O(1).\n  @Ensures(result.length > 0)\n  stateName(): string {\n    return stateName(this.core.stateCode());\n  }\n}\n\n// parseRequest(data, limits): ParseResult<Request> -- a one-shot parse of all of `data` (a fresh parser, one `feed`). NeedMore when `data`\n// is a proper prefix of a message; `Done(request, used)` leaves `data[used..]` for the next message. O(data).\n@Ensures(resultKind(result) == 1 ==> resultUsed(result) <= data.length())\nexport function parseRequest(data: Bytes, limits: HttpLimits): ParseResult<Request> {\n  let p = new RequestParser(limits);\n  return p.feed(data);\n}\n\n// parseResponse(data, limits, to): ParseResult<Response> -- the same for a response (`to`: what it answers); `atEof` is\n// NOT applied (use `parseResponseToEof` for a response that ends at connection close). O(data).\n@Ensures(resultKind(result) == 1 ==> resultUsed(result) <= data.length())\nexport function parseResponse(data: Bytes, limits: HttpLimits, to: ResponseTo): ParseResult<Response> {\n  let p = new ResponseParser(limits, to);\n  return p.feed(data);\n}\n\n// parseResponseToEof(data, limits, to): ParseResult<Response> -- `data` is everything the peer sent before it closed the connection;\n// a close-delimited body is complete. O(data).\nexport function parseResponseToEof(data: Bytes, limits: HttpLimits, to: ResponseTo): ParseResult<Response> {\n  let p = new ResponseParser(limits, to);\n  const r = p.feed(data);\n  if (resultKind(r) == 0) {\n    return p.atEof();\n  }\n  return r;\n}\n\n\n\n// ------------------------------------------------------------------------------------------- serializer\n\n// hexString(n): string -- n in lower-case hexadecimal without leading zeros (\"0\" for 0). O(digits). Internal (number\n// formatting; it belongs to the numbers prelude).\n@Ensures(result.length >= 1)\nexport function hexString(n: usize): string {\n  if (n == 0) {\n    return \"0\";\n  }\n  let digits: string[] = [];\n  let v = n;\n  while (v > 0) {\n    digits.push(\"0123456789abcdef\".charAt(v % 16));\n    v = v / 16;\n  }\n  let out = \"\";\n  let k = digits.length;\n  while (k > 0) {\n    k -= 1;\n    out += digits[k];\n  }\n  return out;\n}\n\n// The fields of `h`, one line each: `name: value CRLF`. Names and values were validated by `Headers`, so no field\n// can contain a CR or LF: a field can never end its line early or start another one (no header injection).\n@Ensures(result.length == headerBytes(h))\nfunction fieldsText(h: Headers): string {\n  let out = \"\";\n  let i: usize = 0;\n  while (i < h.size()) {\n    out += h.nameAt(i);\n    out += \": \";\n    out += h.valueAt(i);\n    out += \"\\r\\n\";\n    i += 1;\n  }\n  return out;\n}\n\n// The serialized size of the fields of `h`.\nfunction headerBytes(h: Headers): usize {\n  let n: usize = 0;\n  let i: usize = 0;\n  while (i < h.size()) {\n    n += h.nameAt(i).length + h.valueAt(i).length + 4;\n    i += 1;\n  }\n  return n;\n}\n\n// A chunked body: chunks of at most `chunkSize` bytes, the last chunk, the trailers and the final CRLF.\n@Requires(chunkSize >= 1)\n@Ensures(result.length() >= 5 + body.length() + headerBytes(trailers))\nfunction chunkedBytes(body: Bytes, trailers: Headers, chunkSize: usize): Bytes {\n  let out = new ByteBuilder();\n  let off: usize = 0;\n  while (off < body.length()) {\n    const left = body.length() - off;\n    const take = left < chunkSize ? left : chunkSize;\n    out.appendString(hexString(take));\n    out.appendString(\"\\r\\n\");\n    out.appendBytes(body.slice(off, off + take));\n    out.appendString(\"\\r\\n\");\n    off += take;\n  }\n  out.appendString(\"0\\r\\n\");\n  out.appendString(fieldsText(trailers));\n  out.appendString(\"\\r\\n\");\n  return out.build();\n}\n\n// Limits large enough for any message of `n` bytes (the contract of the serializers parses their output with them).\nfunction limitsFor(n: usize): HttpLimits {\n  const big = n < 16 ? 16 : (n > 1048576 ? 1048576 : n);\n  const head = n < 64 ? 64 : (n > 67108864 ? 67108864 : n);\n  return HttpLimits { maxStartLine: big, maxHeaderCount: 65536, maxHeaderLine: big, maxHeaderBytes: head, maxChunkLine: 1024, maxBody: n };\n}\n\n// Does the parser accept `wire` as exactly the request `r`? (The round-trip check of the contracts.)\nfunction roundTripsRequest(wire: Bytes, r: Request): bool {\n  if (wire.length() > 1048576 || r.headers().size() > 65536 || r.trailers().size() > 65536) {\n    return true;\n  }\n  const p = parseRequest(wire, limitsFor(wire.length()));\n  return match (p) {\n    Done(q, used) => used == wire.length() && q.equals(r),\n    _ => false\n  };\n}\n\n// Does the parser accept `wire` as exactly the response `r`?\nfunction roundTripsResponse(wire: Bytes, r: Response): bool {\n  if (wire.length() > 1048576 || r.headers().size() > 65536 || r.trailers().size() > 65536) {\n    return true;\n  }\n  const p = parseResponseToEof(wire, limitsFor(wire.length()), r.isForHead() ? ToHead : ToOther);\n  return match (p) {\n    Done(q, used) => q.equals(r),\n    _ => false\n  };\n}\n\n// serializeRequestChunked(r, chunkSize): Bytes -- the request as wire bytes; a chunked body is split into chunks of at most\n// `chunkSize` bytes. ROUND-TRIP CONTRACT: for every request `r` the parser accepts the output (with limits that fit\n// it) and returns a request equal to `r`: parse(serialize(r)) == r. O(size).\n@Requires(chunkSize >= 1)\n@Ensures(roundTripsRequest(result, r))\nexport function serializeRequestChunked(r: Request, chunkSize: usize): Bytes {\n  let out = new ByteBuilder();\n  out.appendString(methodName(r.method()));\n  out.appendString(\" \");\n  out.appendString(r.target());\n  out.appendString(\" \");\n  out.appendString(versionText(r.version()));\n  out.appendString(\"\\r\\n\");\n  out.appendString(fieldsText(r.headers()));\n  out.appendString(\"\\r\\n\");\n  if (r.isChunked()) {\n    out.appendBytes(chunkedBytes(r.body(), r.trailers(), chunkSize));\n  } else {\n    out.appendBytes(r.body());\n  }\n  return out.build();\n}\n\n// serializeRequest(r): Bytes -- the request as wire bytes (a chunked body in one chunk). The output starts with the request line\n// and ends with the last byte of the body; every line ends with CRLF. Round-trip contract as above. O(size).\n@Ensures(roundTripsRequest(result, r))\nexport function serializeRequest(r: Request): Bytes {\n  const size = r.body().length();\n  return serializeRequestChunked(r, size == 0 ? 1 : size);\n}\n\n// serializeResponseChunked(r, chunkSize): Bytes -- the response as wire bytes; a chunked body is split into chunks of at most\n// `chunkSize` bytes; a bodyless response (HEAD, 1xx, 204, 304) has no body bytes. Round-trip contract: the parser\n// (`parseResponseToEof`, with `forHead` as in `r`) accepts the output and returns a response equal to `r`. O(size).\n@Requires(chunkSize >= 1)\n@Ensures(roundTripsResponse(result, r))\nexport function serializeResponseChunked(r: Response, chunkSize: usize): Bytes {\n  let out = new ByteBuilder();\n  out.appendString(versionText(r.version()));\n  out.appendString(\" \");\n  out.appendString(r.status().code().toString());\n  out.appendString(\" \");\n  out.appendString(r.status().reason());\n  out.appendString(\"\\r\\n\");\n  out.appendString(fieldsText(r.headers()));\n  out.appendString(\"\\r\\n\");\n  if (!r.isBodyless()) {\n    if (r.isChunked()) {\n      out.appendBytes(chunkedBytes(r.body(), r.trailers(), chunkSize));\n    } else {\n      out.appendBytes(r.body());\n    }\n  }\n  return out.build();\n}\n\n// serializeResponse(r): Bytes -- the response as wire bytes (a chunked body in one chunk). Round-trip contract as above. O(size).\n@Ensures(roundTripsResponse(result, r))\nexport function serializeResponse(r: Response): Bytes {\n  const size = r.body().length();\n  return serializeResponseChunked(r, size == 0 ? 1 : size);\n}\n\n" });
  out.push(SourceFile { path: "$stdlib/io.or", text: "// std:io -- standard input/output and child processes (ADR-0027, ADR-0045, ADR-0048).\n//\n// UNSTABLE (ADR-0016 two-stage freeze): std I/O stays unstable until the project owner confirms the freeze.\n//\n// Every function takes the grant of its family as its first argument: `StdioGrant` for `readBytes`, `readLine` and\n// `writeStdout`, `ProcessGrant` for `shell` and `shellTimeout` (both come from `main(host: Host)` through std:host:\n// `useStdio`, `useProcess`, `useHost`). `console.log` / `console.error` need no grant.\n//\n// `shell` and `shellTimeout` run a command to completion through `/bin/sh -c` and report how it ended as a\n// `Result<int, ProcessError>`: `Ok(status)` is the exit status 0..255 of the command, so a command that ran and failed is\n// still an `Ok` (compare the status); `Err` means no status exists (ADR-0048 rule 3.1 replaces the sentinels -1 and -2 of\n// ADR-0045). A process grant narrowed by `withArgsOnly` (std:host), or one denied by the host policy (ORIN_DENY names\n// `process`), cannot spawn: the call traps (\"capability denied\"), like every operation that does not return a `Result`\n// for a refused grant.\n\nimport { StdioGrant, ProcessGrant, shellRaw, shellTimeoutRaw } from \"std:fsraw\";\nimport { Duration } from \"std:time\";\n\nexport { StdioGrant, ProcessGrant, readBytes, readLine, writeStdout } from \"std:fsraw\";\n\n// Why no exit status exists. Timeout: the command did not finish within the allowed time and its process group was\n// killed; InvalidDuration: the timeout is not positive (nothing was started); Failed: the command could not be run to\n// completion (spawn failure, killed by a signal, or an operating-system error).\nexport type ProcessErrorKind = Timeout | InvalidDuration | Failed;\n\n// An error of this module: the `kind` and the command line that was (or would have been) run. Render it with\n// `processErrorMessage`.\nexport type ProcessError = { kind: ProcessErrorKind; command: string; };\n\n// processErrorMessage(e: ProcessError): string -- \"command timed out: <command>\" and so on. Never empty. O(command).\nexport function processErrorMessage(e: ProcessError): string {\n  return match (e.kind) {\n    Timeout => \"command timed out: \" + e.command,\n    InvalidDuration => \"timeout must be positive: \" + e.command,\n    Failed => \"command could not be run to completion: \" + e.command\n  };\n}\n\n// shell(proc: ProcessGrant, cmd: string): Result<int, ProcessError>\n// Runs `cmd` with `/bin/sh -c`, waits for it, and returns its exit status 0..255. Err(Failed) when the command could not\n// be run to completion. Traps with \"capability denied\" when `proc` cannot spawn. No time limit: use `shellTimeout` for\n// anything that might hang. O(command bytes) plus the run time of the command.\nexport function shell(proc: ProcessGrant, cmd: string): Result<int, ProcessError> {\n  const status = shellRaw(proc, cmd);\n  if (status < 0) {\n    return Err(ProcessError { kind: Failed, command: cmd });\n  }\n  return Ok(status);\n}\n\n// shellTimeout(proc: ProcessGrant, cmd: string, timeout: Duration): Result<int, ProcessError>\n// Like `shell`, but the command and its process group are killed when `timeout` has passed (whole-second granularity:\n// the timeout is rounded up to the next second). Ok(0..255) is the exit status. Err(Timeout) when the time ran out,\n// Err(InvalidDuration) when `timeout` is not positive (nothing is started), Err(Failed) for a spawn failure, a signal\n// or an operating-system error. Traps with \"capability denied\" when `proc` cannot spawn.\n// O(command bytes + elapsed time / 10 ms); sleeps between checks.\nexport function shellTimeout(proc: ProcessGrant, cmd: string, timeout: Duration): Result<int, ProcessError> {\n  if (timeout.millis <= 0) {\n    return Err(ProcessError { kind: InvalidDuration, command: cmd });\n  }\n  const whole = timeout.millis / 1000;\n  const seconds = timeout.millis % 1000 > 0 ? whole + 1 : whole;\n  const status = shellTimeoutRaw(proc, cmd, seconds);\n  if (status == 0 - 2) {\n    return Err(ProcessError { kind: Timeout, command: cmd });\n  }\n  if (status < 0) {\n    return Err(ProcessError { kind: Failed, command: cmd });\n  }\n  return Ok(status);\n}\n" });
  out.push(SourceFile { path: "$stdlib/json.or", text: "// std:json -- exact, bounded JSON documents (ADR-0048 section 7.1; formerly std:jsonvalue).\n//\n// Data model: `JsonValue` is a plain union; numbers are exact validated lexemes (`JsonNumber`, see\n// std:json/number), objects are ordered member lists. Parsing and writing are bounded by `JsonLimits`.\n// Application decoding with field paths lives in std:json/decode. The integer-only legacy model is\n// std:json/legacy (deprecated), with `toValue` / `fromValue` to cross over.\n// Policies, error precedence, allocation and complexity: docs/std-json.md.\nimport { JsonNumber, jsonNumber } from \"std:json/number\";\nimport { validate, encodeCodePoint } from \"std:utf8\";\n\n// JsonValue -- a JSON value: ValueNull | ValueBool | ValueNumber (exact lexeme) | ValueString (UTF-8) |\n// ValueArray | ValueObject (ordered members, duplicates only with PreserveDuplicates).\nexport type JsonValue =\n  ValueNull\n  | ValueBool(bool)\n  | ValueNumber(JsonNumber)\n  | ValueString(string)\n  | ValueArray(JsonValue[])\n  | ValueObject(JsonMember[]);\n// JsonMember -- one object member in source order.\nexport type JsonMember = { key: string; value: JsonValue; };\n// JsonDuplicatePolicy -- RejectDuplicates fails with JsonDuplicateKey, PreserveDuplicates keeps every member.\nexport type JsonDuplicatePolicy = RejectDuplicates | PreserveDuplicates;\n// JsonLimits -- the budgets of one parse or write; every field must be positive, maxDepth at most 200.\nexport type JsonLimits = {\n  maxInputBytes: usize;\n  maxDepth: usize;\n  maxNodes: usize;\n  maxContainerItems: usize;\n  maxStringBytes: usize;\n  maxDecodedStringBytes: usize;\n  maxNumberBytes: usize;\n  maxOutputBytes: usize;\n};\n// JsonReadOptions -- limits plus the duplicate-key policy for parseDocument.\nexport type JsonReadOptions = { limits: JsonLimits; duplicates: JsonDuplicatePolicy; };\n// JsonValueErrorKind -- why a parse or write failed.\nexport type JsonValueErrorKind =\n  JsonSyntax\n  | JsonInvalidUtf8\n  | JsonInvalidSurrogate\n  | JsonDuplicateKey\n  | JsonLimitExceeded\n  | JsonInvalidLimits;\n// JsonParseError -- `offset` is the 0-based byte offset where the problem was detected (<= text length),\n// `line`/`column` are 1-based (column counts bytes), `limit` names the exceeded budget for JsonLimitExceeded.\nexport type JsonParseError = {\n  kind: JsonValueErrorKind;\n  offset: usize;\n  line: usize;\n  column: usize;\n  limit: Option<string>;\n};\n// JsonWriteError -- writer errors have no source position: values may have been built by the caller.\nexport type JsonWriteError = { kind: JsonValueErrorKind; limit: Option<string>; };\n\nfunction kindText(kind: JsonValueErrorKind, limit: Option<string>): string {\n  const why = match (kind) {\n    JsonSyntax => \"invalid JSON syntax\",\n    JsonInvalidUtf8 => \"invalid UTF-8\",\n    JsonInvalidSurrogate => \"invalid surrogate escape\",\n    JsonDuplicateKey => \"duplicate object key\",\n    JsonLimitExceeded => \"limit exceeded\",\n    JsonInvalidLimits => \"invalid limits\",\n  };\n  if (limit.isSome()) {\n    return why + \" (\" + limit.unwrap() + \")\";\n  }\n  return why;\n}\n\n// jsonParseErrorMessage(e: JsonParseError): string -- \"line L, column C: <cause>[ (limit)]\". Never fails. O(1).\n@Ensures(result.length > 0)\nexport function jsonParseErrorMessage(e: JsonParseError): string {\n  return \"line \" + e.line.toString() + \", column \" + e.column.toString() + \": \"\n      + kindText(e.kind, e.limit);\n}\n\n// jsonWriteErrorMessage(e: JsonWriteError): string -- \"<cause>[ (limit)]\". Never fails. O(1).\n@Ensures(result.length > 0)\nexport function jsonWriteErrorMessage(e: JsonWriteError): string {\n  return kindText(e.kind, e.limit);\n}\n\n// defaultLimits(): JsonLimits -- 1 MiB input, depth 64, 100000 nodes, 4 MiB output. Never fails. O(1).\n@Ensures(result.maxDepth == 64 && result.maxInputBytes == 1048576)\nexport function defaultLimits(): JsonLimits {\n  return JsonLimits {\n    maxInputBytes: 1048576,\n    maxDepth: 64,\n    maxNodes: 100000,\n    maxContainerItems: 10000,\n    maxStringBytes: 262144,\n    maxDecodedStringBytes: 1048576,\n    maxNumberBytes: 1024,\n    maxOutputBytes: 4194304,\n  };\n}\n\n// defaultReadOptions(): JsonReadOptions -- defaultLimits() and RejectDuplicates. Never fails. O(1).\nexport function defaultReadOptions(): JsonReadOptions {\n  return JsonReadOptions { limits: defaultLimits(), duplicates: RejectDuplicates };\n}\n\n// defaultJsonLimits(): JsonLimits -- deprecated spelling of defaultLimits().\n@Deprecated(\"use defaultLimits()\")\nexport function defaultJsonLimits(): JsonLimits {\n  return defaultLimits();\n}\n\n// defaultJsonOptions(): JsonReadOptions -- deprecated spelling of defaultReadOptions().\n@Deprecated(\"use defaultReadOptions()\")\nexport function defaultJsonOptions(): JsonReadOptions {\n  return defaultReadOptions();\n}\n\nfunction validLimits(l: JsonLimits): bool {\n  return l.maxInputBytes > 0\n      && l.maxDepth > 0\n      && l.maxDepth <= 200\n      && l.maxNodes > 0\n      && l.maxContainerItems > 0\n      && l.maxStringBytes > 0\n      && l.maxDecodedStringBytes > 0\n      && l.maxNumberBytes > 0\n      && l.maxOutputBytes > 0;\n}\n\nfunction parseError(\n  s: string,\n  kind: JsonValueErrorKind,\n  at: usize,\n  limit: Option<string>,\n): JsonParseError {\n  let line: usize = 1;\n  let start: usize = 0;\n  let i: usize = 0;\n  while (i < at) {\n    if (s.charCodeAt(i) == 10) {\n      line += 1;\n      start = i + 1;\n    }\n    i += 1;\n  }\n  return JsonParseError {\n    kind: kind,\n    offset: at,\n    line: line,\n    column: at - start + 1,\n    limit: limit,\n  };\n}\n\nfunction digit(c: int): bool {\n  return c >= 48 && c <= 57;\n}\nfunction hex(c: int): int {\n  if (digit(c)) {\n    return c - 48;\n  }\n  if (c >= 65 && c <= 70) {\n    return c - 55;\n  }\n  if (c >= 97 && c <= 102) {\n    return c - 87;\n  }\n  return -1;\n}\n\n@Invariant(this.pos <= this.text.length\n    && this.nodes <= this.limits.maxNodes\n    && this.decoded <= this.limits.maxDecodedStringBytes)\nclass DocumentParser {\n  private text: string;\n  private limits: JsonLimits;\n  private reject: bool;\n  private pos: usize = 0;\n  private nodes: usize = 0;\n  private decoded: usize = 0;\n\n  constructor(text: string, options: JsonReadOptions) {\n    this.text = text;\n    this.limits = options.limits;\n    this.reject = match (options.duplicates) {\n      RejectDuplicates => true,\n      PreserveDuplicates => false,\n    };\n  }\n\n  private fail(kind: JsonValueErrorKind, at: usize, limit: Option<string>): JsonParseError {\n    return parseError(this.text, kind, at, limit);\n  }\n  private peek(): int {\n    return this.pos < this.text.length ? this.text.charCodeAt(this.pos) : -1;\n  }\n  private ws(): void {\n    while (this.pos < this.text.length) {\n      const c = this.peek();\n      if (c != 32 && c != 9 && c != 10 && c != 13) {\n        break;\n      }\n      this.pos += 1;\n    }\n  }\n\n  private stringBudget(current: usize, count: usize, at: usize): Result<void, JsonParseError> {\n    if (count > this.limits.maxStringBytes - current) {\n      return Err(this.fail(JsonLimitExceeded, at, Some(\"maxStringBytes\")));\n    }\n    if (count > this.limits.maxDecodedStringBytes - this.decoded) {\n      return Err(this.fail(JsonLimitExceeded, at, Some(\"maxDecodedStringBytes\")));\n    }\n    this.decoded += count;\n    return Ok();\n  }\n\n  private hex4(): Result<int, JsonParseError> {\n    let n = 0;\n    let k = 0;\n    while (k < 4) {\n      const h = hex(this.peek());\n      if (h < 0) {\n        return Err(this.fail(JsonSyntax, this.pos, None));\n      }\n      n = n * 16 + h;\n      this.pos += 1;\n      k += 1;\n    }\n    return Ok(n);\n  }\n\n  // Caller has consumed no part of the opening quote. No old(this) snapshots\n  // or ByteBuilder per-byte contracts: the local byte buffer stays unique.\n  private stringValue(): Result<string, JsonParseError> {\n    this.pos += 1;\n    let out: u8[] = [];\n    while (this.pos < this.text.length) {\n      const at = this.pos;\n      const c = this.peek();\n      if (c == 34) {\n        this.pos += 1;\n        // Empty arrays have no backing storage; avoid null+0 in bytesToString.\n        if (out.length == 0) {\n          return Ok(\"\");\n        }\n        return Ok(bytesToString(out, 0, out.length));\n      }\n      if (c < 32) {\n        return Err(this.fail(JsonSyntax, at, None));\n      }\n      if (c != 92) {\n        this.stringBudget(out.length, 1, at)?;\n        out.push(c.toU8());\n        this.pos += 1;\n        continue;\n      }\n      this.pos += 1;\n      const e = this.peek();\n      if (e < 0) {\n        return Err(this.fail(JsonSyntax, this.pos, None));\n      }\n      this.pos += 1;\n      let encoded = \"\";\n      if (e == 34 || e == 92 || e == 47) {\n        encoded = String.fromCharCode(e);\n      } else if (e == 98) {\n        encoded = \"\\x08\";\n      } else if (e == 102) {\n        encoded = \"\\x0c\";\n      } else if (e == 110) {\n        encoded = \"\\n\";\n      } else if (e == 114) {\n        encoded = \"\\r\";\n      } else if (e == 116) {\n        encoded = \"\\t\";\n      } else if (e == 117) {\n        let cp = this.hex4()?;\n        if (cp >= 55296 && cp <= 56319) {\n          if (this.peek() != 92\n              || this.pos + 1 >= this.text.length\n              || this.text.charCodeAt(this.pos + 1) != 117) {\n            return Err(this.fail(JsonInvalidSurrogate, at, None));\n          }\n          this.pos += 2;\n          const low = this.hex4()?;\n          if (low < 56320 || low > 57343) {\n            return Err(this.fail(JsonInvalidSurrogate, at, None));\n          }\n          cp = 65536 + (cp - 55296) * 1024 + low - 56320;\n        } else if (cp >= 56320 && cp <= 57343) {\n          return Err(this.fail(JsonInvalidSurrogate, at, None));\n        }\n        encoded = encodeCodePoint(cp).unwrap();\n      } else {\n        return Err(this.fail(JsonSyntax, this.pos - 1, None));\n      }\n      this.stringBudget(out.length, encoded.length, at)?;\n      let j: usize = 0;\n      while (j < encoded.length) {\n        out.push(encoded.charCodeAt(j).toU8());\n        j += 1;\n      }\n    }\n    return Err(this.fail(JsonSyntax, this.pos, None));\n  }\n\n  private numberValue(): Result<JsonValue, JsonParseError> {\n    const start = this.pos;\n    while (this.pos < this.text.length) {\n      const c = this.peek();\n      if (!digit(c) && c != 45 && c != 43 && c != 46 && c != 101 && c != 69) {\n        break;\n      }\n      if (this.pos - start == this.limits.maxNumberBytes) {\n        return Err(this.fail(JsonLimitExceeded, this.pos, Some(\"maxNumberBytes\")));\n      }\n      this.pos += 1;\n    }\n    const token = this.text.substring(start, this.pos);\n    const n = jsonNumber(token, this.limits.maxNumberBytes);\n    if (n.isErr()) {\n      return Err(this.fail(JsonSyntax, start + n.unwrapErr().offset.unwrapOr(0), None));\n    }\n    return Ok(ValueNumber(n.unwrap()));\n  }\n\n  private literal(word: string): Result<void, JsonParseError> {\n    let i: usize = 0;\n    while (i < word.length) {\n      if (this.peek() != word.charCodeAt(i)) {\n        return Err(this.fail(JsonSyntax, this.pos, None));\n      }\n      this.pos += 1;\n      i += 1;\n    }\n    return Ok();\n  }\n\n  private arrayValue(depth: usize): Result<JsonValue, JsonParseError> {\n    this.pos += 1;\n    this.ws();\n    let values: JsonValue[] = [];\n    if (this.peek() == 93) {\n      this.pos += 1;\n      return Ok(ValueArray(values));\n    }\n    while (true) {\n      this.ws();\n      if (this.peek() < 0 || this.peek() == 93) {\n        return Err(this.fail(JsonSyntax, this.pos, None));\n      }\n      if (values.length == this.limits.maxContainerItems) {\n        return Err(this.fail(JsonLimitExceeded, this.pos, Some(\"maxContainerItems\")));\n      }\n      const v = this.value(depth)?;\n      values.push(v);\n      this.ws();\n      if (this.peek() == 93) {\n        this.pos += 1;\n        return Ok(ValueArray(values));\n      }\n      if (this.peek() != 44) {\n        return Err(this.fail(JsonSyntax, this.pos, None));\n      }\n      this.pos += 1;\n    }\n    return Err(this.fail(JsonSyntax, this.pos, None));\n  }\n\n  private objectValue(depth: usize): Result<JsonValue, JsonParseError> {\n    this.pos += 1;\n    this.ws();\n    let members: JsonMember[] = [];\n    let seen = new Map<string, bool>();\n    if (this.peek() == 125) {\n      this.pos += 1;\n      return Ok(ValueObject(members));\n    }\n    while (true) {\n      this.ws();\n      const at = this.pos;\n      if (this.peek() != 34) {\n        return Err(this.fail(JsonSyntax, at, None));\n      }\n      if (members.length == this.limits.maxContainerItems) {\n        return Err(this.fail(JsonLimitExceeded, at, Some(\"maxContainerItems\")));\n      }\n      const key = this.stringValue()?;\n      if (this.reject) {\n        if (seen.has(key)) {\n          return Err(this.fail(JsonDuplicateKey, at, None));\n        }\n        seen.set(key, true);\n      }\n      this.ws();\n      if (this.peek() != 58) {\n        return Err(this.fail(JsonSyntax, this.pos, None));\n      }\n      this.pos += 1;\n      const v = this.value(depth)?;\n      members.push(JsonMember { key: key, value: v });\n      this.ws();\n      if (this.peek() == 125) {\n        this.pos += 1;\n        return Ok(ValueObject(members));\n      }\n      if (this.peek() != 44) {\n        return Err(this.fail(JsonSyntax, this.pos, None));\n      }\n      this.pos += 1;\n    }\n    return Err(this.fail(JsonSyntax, this.pos, None));\n  }\n\n  private value(depth: usize): Result<JsonValue, JsonParseError> {\n    this.ws();\n    const at = this.pos;\n    const c = this.peek();\n    if (c < 0) {\n      return Err(this.fail(JsonSyntax, at, None));\n    }\n    if (this.nodes == this.limits.maxNodes) {\n      return Err(this.fail(JsonLimitExceeded, at, Some(\"maxNodes\")));\n    }\n    this.nodes += 1;\n    if ((c == 91 || c == 123) && depth == this.limits.maxDepth) {\n      return Err(this.fail(JsonLimitExceeded, at, Some(\"maxDepth\")));\n    }\n    if (c == 34) {\n      return Ok(ValueString(this.stringValue()?));\n    }\n    if (c == 91) {\n      return this.arrayValue(depth + 1);\n    }\n    if (c == 123) {\n      return this.objectValue(depth + 1);\n    }\n    if (c == 45 || digit(c)) {\n      return this.numberValue();\n    }\n    if (c == 116) {\n      this.literal(\"true\")?;\n      return Ok(ValueBool(true));\n    }\n    if (c == 102) {\n      this.literal(\"false\")?;\n      return Ok(ValueBool(false));\n    }\n    if (c == 110) {\n      this.literal(\"null\")?;\n      return Ok(ValueNull);\n    }\n    return Err(this.fail(JsonSyntax, at, None));\n  }\n\n  @Ensures(result.isErr() ==> result.unwrapErr().offset <= this.text.length)\n  document(): Result<JsonValue, JsonParseError> {\n    const v = this.value(0)?;\n    this.ws();\n    if (this.pos != this.text.length) {\n      return Err(this.fail(JsonSyntax, this.pos, None));\n    }\n    return Ok(v);\n  }\n}\n\n// parseDocument(text, options): Result<JsonValue, JsonParseError> -- parses one strict JSON document.\n// Errors, checked in this order: JsonInvalidLimits, input over maxInputBytes (JsonLimitExceeded), invalid\n// UTF-8, then syntax, surrogates, duplicates (RejectDuplicates) and budgets while scanning; `offset` is\n// always <= text.length. Never traps. O(n) time, O(n) allocation.\n@Ensures(result.isErr() ==> result.unwrapErr().offset <= text.length)\nexport function parseDocument(\n  text: string,\n  options: JsonReadOptions,\n): Result<JsonValue, JsonParseError> {\n  if (!validLimits(options.limits)) {\n    return Err(parseError(text, JsonInvalidLimits, 0, None));\n  }\n  if (text.length > options.limits.maxInputBytes) {\n    return Err(\n      parseError(text, JsonLimitExceeded, options.limits.maxInputBytes, Some(\"maxInputBytes\")),\n    );\n  }\n  const utf8 = validate(text);\n  if (utf8.isErr()) {\n    return Err(parseError(text, JsonInvalidUtf8, utf8.unwrapErr().offset, None));\n  }\n  let parser = new DocumentParser(text, options);\n  return parser.document();\n}\n\nfunction writeError(kind: JsonValueErrorKind, limit: Option<string>): JsonWriteError {\n  return JsonWriteError { kind: kind, limit: limit };\n}\n\n@Invariant(this.out.length <= this.limits.maxOutputBytes\n    && this.nodes <= this.limits.maxNodes\n    && this.decoded <= this.limits.maxDecodedStringBytes)\nclass DocumentWriter {\n  private limits: JsonLimits;\n  private out: u8[] = [];\n  private nodes: usize = 0;\n  private decoded: usize = 0;\n  constructor(limits: JsonLimits) {\n    this.limits = limits;\n  }\n\n  private byte(b: u8): Result<void, JsonWriteError> {\n    if (this.out.length == this.limits.maxOutputBytes) {\n      return Err(writeError(JsonLimitExceeded, Some(\"maxOutputBytes\")));\n    }\n    this.out.push(b);\n    return Ok();\n  }\n  private raw(s: string): Result<void, JsonWriteError> {\n    if (s.length > this.limits.maxOutputBytes - this.out.length) {\n      return Err(writeError(JsonLimitExceeded, Some(\"maxOutputBytes\")));\n    }\n    let i: usize = 0;\n    while (i < s.length) {\n      this.out.push(s.charCodeAt(i).toU8());\n      i += 1;\n    }\n    return Ok();\n  }\n  private stringValue(s: string): Result<void, JsonWriteError> {\n    if (s.length > this.limits.maxStringBytes) {\n      return Err(writeError(JsonLimitExceeded, Some(\"maxStringBytes\")));\n    }\n    if (s.length > this.limits.maxDecodedStringBytes - this.decoded) {\n      return Err(writeError(JsonLimitExceeded, Some(\"maxDecodedStringBytes\")));\n    }\n    if (validate(s).isErr()) {\n      return Err(writeError(JsonInvalidUtf8, None));\n    }\n    this.decoded += s.length;\n    this.byte(34)?;\n    const digits = \"0123456789abcdef\";\n    let i: usize = 0;\n    while (i < s.length) {\n      const c = s.charCodeAt(i);\n      if (c == 34) {\n        this.raw(\"\\\\\\\"\")?;\n      } else if (c == 92) {\n        this.raw(\"\\\\\\\\\")?;\n      } else if (c == 8) {\n        this.raw(\"\\\\b\")?;\n      } else if (c == 12) {\n        this.raw(\"\\\\f\")?;\n      } else if (c == 10) {\n        this.raw(\"\\\\n\")?;\n      } else if (c == 13) {\n        this.raw(\"\\\\r\")?;\n      } else if (c == 9) {\n        this.raw(\"\\\\t\")?;\n      } else if (c < 32) {\n        this.raw(\"\\\\u00\")?;\n        this.byte(digits.charCodeAt((c / 16).toUsize()).toU8())?;\n        this.byte(digits.charCodeAt((c % 16).toUsize()).toU8())?;\n      } else {\n        this.byte(c.toU8())?;\n      }\n      i += 1;\n    }\n    this.byte(34)?;\n    return Ok();\n  }\n\n  private value(v: JsonValue, depth: usize): Result<void, JsonWriteError> {\n    if (this.nodes == this.limits.maxNodes) {\n      return Err(writeError(JsonLimitExceeded, Some(\"maxNodes\")));\n    }\n    this.nodes += 1;\n    match (v) {\n      ValueNull => {\n        this.raw(\"null\")?;\n      },\n      ValueBool(b) => {\n        this.raw(b ? \"true\" : \"false\")?;\n      },\n      ValueNumber(n) => {\n        if (n.token.length > this.limits.maxNumberBytes) {\n          return Err(writeError(JsonLimitExceeded, Some(\"maxNumberBytes\")));\n        }\n        this.raw(n.token)?;\n      },\n      ValueString(s) => {\n        this.stringValue(s)?;\n      },\n      ValueArray(values) => {\n        if (depth == this.limits.maxDepth) {\n          return Err(writeError(JsonLimitExceeded, Some(\"maxDepth\")));\n        }\n        if (values.length > this.limits.maxContainerItems) {\n          return Err(writeError(JsonLimitExceeded, Some(\"maxContainerItems\")));\n        }\n        this.byte(91)?;\n        let i: usize = 0;\n        while (i < values.length) {\n          if (i > 0) {\n            this.byte(44)?;\n          }\n          this.value(values[i], depth + 1)?;\n          i += 1;\n        }\n        this.byte(93)?;\n      },\n      ValueObject(members) => {\n        if (depth == this.limits.maxDepth) {\n          return Err(writeError(JsonLimitExceeded, Some(\"maxDepth\")));\n        }\n        if (members.length > this.limits.maxContainerItems) {\n          return Err(writeError(JsonLimitExceeded, Some(\"maxContainerItems\")));\n        }\n        this.byte(123)?;\n        let i: usize = 0;\n        while (i < members.length) {\n          if (i > 0) {\n            this.byte(44)?;\n          }\n          this.stringValue(members[i].key)?;\n          this.byte(58)?;\n          this.value(members[i].value, depth + 1)?;\n          i += 1;\n        }\n        this.byte(125)?;\n      },\n    }\n    return Ok();\n  }\n\n  @Ensures(result.isOk() ==> result.unwrap().length <= this.limits.maxOutputBytes)\n  document(v: JsonValue): Result<string, JsonWriteError> {\n    this.value(v, 0)?;\n    return Ok(bytesToString(this.out, 0, this.out.length));\n  }\n}\n\n// writeDocument(v, limits): Result<string, JsonWriteError> -- compact deterministic text for a caller-built\n// tree. Errors: JsonInvalidLimits, JsonInvalidUtf8 (strings, keys), JsonLimitExceeded (depth, nodes,\n// items, string bytes, number bytes, output bytes). Duplicate members are written as given. Never traps.\n// O(size of v) time and allocation.\n@Ensures(result.isOk() ==> result.unwrap().length <= limits.maxOutputBytes)\nexport function writeDocument(v: JsonValue, limits: JsonLimits): Result<string, JsonWriteError> {\n  if (!validLimits(limits)) {\n    return Err(writeError(JsonInvalidLimits, None));\n  }\n  let writer = new DocumentWriter(limits);\n  return writer.document(v);\n}\n" });
  out.push(SourceFile { path: "$stdlib/json/decode.or", text: "// std:json/decode -- pure validation over JsonValue (ADR-0048 section 7.1; formerly std:jsondecode).\n// No coercion, I/O, source offsets or value leakage. API/error ordering/complexity: docs/std-json-decode.md.\nimport { JsonValue, JsonMember, JsonLimits } from \"std:json\";\nimport { JsonNumber, NumberErrorKind, numberAsInt } from \"std:json/number\";\nimport { validate } from \"std:utf8\";\n\n// PathSegment -- one step from the root: an object key or an array index.\nexport type PathSegment = Key(string) | Index(usize);\n// DecodeErrorKind -- why a decode step failed.\nexport type DecodeErrorKind =\n  DecodeMissingField\n  | DecodeWrongType\n  | DecodeNotIntegral\n  | DecodeIntegerRange\n  | DecodeFloatOverflow\n  | DecodeFloatUnderflow\n  | DecodeUnknownField\n  | DecodeDuplicateField\n  | DecodeLimitExceeded\n  | DecodeInvalidLimits\n  | DecodeInvalidSchema;\n// DecodeError -- `path` locates the value (render with formatPath), `expected` and `actual` are fixed schema or\n// type words (\"string\", \"missing\"); they never contain input values.\nexport type DecodeError = {\n  kind: DecodeErrorKind;\n  path: PathSegment[];\n  expected: string;\n  actual: string;\n};\n// UnknownFieldPolicy -- RejectUnknown fails with DecodeUnknownField, IgnoreUnknown skips extra fields.\nexport type UnknownFieldPolicy = RejectUnknown | IgnoreUnknown;\n\n// The private class has only read-only methods. Sealing a wrapper with exposed\n// arrays alone would not protect against all inferred array-method mutations.\n@Invariant(this.segments.length <= this.caps.maxDepth\n    && this.bytes <= this.caps.maxDecodedStringBytes)\nclass CursorState {\n  private item: JsonValue;\n  private segments: PathSegment[];\n  private caps: JsonLimits;\n  private bytes: usize;\n  constructor(item: JsonValue, segments: PathSegment[], caps: JsonLimits, bytes: usize) {\n    this.item = item;\n    this.segments = segments;\n    this.caps = caps;\n    this.bytes = bytes;\n  }\n  itemValue(): JsonValue {\n    return this.item;\n  }\n  @Ensures(result.length <= this.caps.maxDepth)\n  pathSegments(): PathSegment[] {\n    return this.segments;\n  }\n  budget(): JsonLimits {\n    return this.caps;\n  }\n  @Ensures(result <= this.caps.maxDecodedStringBytes)\n  pathBytes(): usize {\n    return this.bytes;\n  }\n}\n\n// DecodeCursor -- a validated position in a JsonValue tree; only this module can construct one.\n@Sealed\nexport type DecodeCursor = { _state: CursorState; };\n\n// cursorValue(c): JsonValue -- the value under the cursor. Never fails. O(1); a COW copy, mutating it cannot\n// change the cursor.\nexport function cursorValue(c: DecodeCursor): JsonValue {\n  return c._state.itemValue();\n}\n// cursorPath(c): PathSegment[] -- the path from the root, length <= maxDepth. Never fails. O(1) (COW copy).\n@Ensures(result.length <= c._state.budget().maxDepth)\nexport function cursorPath(c: DecodeCursor): PathSegment[] {\n  return c._state.pathSegments();\n}\n\nfunction cursor(v: JsonValue, path: PathSegment[], l: JsonLimits, bytes: usize): DecodeCursor {\n  return DecodeCursor { _state: new CursorState(v, path, l, bytes) };\n}\nfunction extend(path: PathSegment[], segment: PathSegment): PathSegment[] {\n  let out = path;\n  out.push(segment);\n  return out;\n}\nfunction failure(\n  k: DecodeErrorKind,\n  path: PathSegment[],\n  expected: string,\n  actual: string,\n): DecodeError {\n  return DecodeError { kind: k, path: path, expected: expected, actual: actual };\n}\nfunction typeName(v: JsonValue): string {\n  return match (v) {\n    ValueNull => \"null\",\n    ValueBool(_) => \"boolean\",\n    ValueNumber(_) => \"number\",\n    ValueString(_) => \"string\",\n    ValueArray(_) => \"array\",\n    ValueObject(_) => \"object\",\n  };\n}\nfunction wrong(c: DecodeCursor, expected: string): DecodeError {\n  return failure(DecodeWrongType, cursorPath(c), expected, typeName(cursorValue(c)));\n}\nfunction validLimits(l: JsonLimits): bool {\n  return l.maxInputBytes > 0\n      && l.maxDepth > 0\n      && l.maxDepth <= 200\n      && l.maxNodes > 0\n      && l.maxContainerItems > 0\n      && l.maxStringBytes > 0\n      && l.maxDecodedStringBytes > 0\n      && l.maxNumberBytes > 0\n      && l.maxOutputBytes > 0;\n}\n\n@Invariant(this.path.length <= this.limits.maxDepth\n    && this.nodes <= this.limits.maxNodes\n    && this.decoded <= this.limits.maxDecodedStringBytes\n    && this.bytes <= this.decoded)\nclass RootValidator {\n  private limits: JsonLimits;\n  private nodes: usize = 0;\n  private decoded: usize = 0;\n  private path: PathSegment[] = [];\n  private bytes: usize = 0;\n  constructor(limits: JsonLimits) {\n    this.limits = limits;\n  }\n  private bad(k: DecodeErrorKind, expected: string, actual: string): DecodeError {\n    return failure(k, this.path, expected, actual);\n  }\n  private text(s: string, key: bool): Result<void, DecodeError> {\n    if (s.length > this.limits.maxStringBytes) {\n      return Err(\n        this.bad(DecodeLimitExceeded, \"maxStringBytes\", key ? \"key bytes\" : \"string bytes\"),\n      );\n    }\n    if (s.length > this.limits.maxDecodedStringBytes - this.decoded) {\n      return Err(this.bad(DecodeLimitExceeded, \"maxDecodedStringBytes\", \"decoded bytes\"));\n    }\n    if (validate(s).isErr()) {\n      return Err(\n        this.bad(DecodeWrongType, key ? \"UTF-8 object key\" : \"UTF-8 string\", \"invalid UTF-8\"),\n      );\n    }\n    this.decoded += s.length;\n    return Ok();\n  }\n  private visit(v: JsonValue, depth: usize): Result<void, DecodeError> {\n    if (this.nodes == this.limits.maxNodes) {\n      return Err(this.bad(DecodeLimitExceeded, \"maxNodes\", typeName(v)));\n    }\n    this.nodes += 1;\n    match (v) {\n      ValueNull => {},\n      ValueBool(_) => {},\n      ValueNumber(n) => {\n        if (n.token.length > this.limits.maxNumberBytes) {\n          return Err(this.bad(DecodeLimitExceeded, \"maxNumberBytes\", \"number bytes\"));\n        }\n      },\n      ValueString(s) => {\n        this.text(s, false)?;\n      },\n      ValueArray(values) => {\n        if (depth == this.limits.maxDepth) {\n          return Err(this.bad(DecodeLimitExceeded, \"maxDepth\", \"array\"));\n        }\n        if (values.length > this.limits.maxContainerItems) {\n          return Err(this.bad(DecodeLimitExceeded, \"maxContainerItems\", \"array items\"));\n        }\n        let i: usize = 0;\n        while (i < values.length) {\n          this.path.push(Index(i));\n          this.visit(values[i], depth + 1)?;\n          this.path.pop();\n          i += 1;\n        }\n      },\n      ValueObject(fields) => {\n        if (depth == this.limits.maxDepth) {\n          return Err(this.bad(DecodeLimitExceeded, \"maxDepth\", \"object\"));\n        }\n        if (fields.length > this.limits.maxContainerItems) {\n          return Err(this.bad(DecodeLimitExceeded, \"maxContainerItems\", \"object members\"));\n        }\n        let seen = new Map<string, bool>();\n        for (const field of fields) {\n          // Invalid/oversized key names are reported at the parent, before adding\n          // an invalid/unbounded string to an error path.\n          this.text(field.key, true)?;\n          this.path.push(Key(field.key));\n          this.bytes += field.key.length;\n          if (seen.has(field.key)) {\n            return Err(this.bad(DecodeDuplicateField, \"unique object field\", \"duplicate field\"));\n          }\n          seen.set(field.key, true);\n          this.visit(field.value, depth + 1)?;\n          this.path.pop();\n          this.bytes -= field.key.length;\n        }\n      },\n    }\n    return Ok();\n  }\n  @Ensures(result.isErr() ==> result.unwrapErr().path.length <= this.limits.maxDepth)\n  validate(v: JsonValue): Result<void, DecodeError> {\n    return this.visit(v, 0);\n  }\n}\n\n// decodeRoot(v, limits): Result<DecodeCursor, DecodeError> -- validates a caller-built tree (UTF-8, depth,\n// nodes, items, string and number budgets, duplicate keys) and returns the cursor at the root. Errors:\n// DecodeInvalidLimits, DecodeLimitExceeded, DecodeWrongType (invalid UTF-8), DecodeDuplicateField. Never traps.\n// O(size of v) time, O(depth) allocation.\n@Ensures(result.isOk() ==> cursorPath(result.unwrap()).length == 0)\nexport function decodeRoot(v: JsonValue, limits: JsonLimits): Result<DecodeCursor, DecodeError> {\n  if (!validLimits(limits)) {\n    return Err(failure(DecodeInvalidLimits, [], \"valid JSON limits\", \"invalid limits\"));\n  }\n  let validator = new RootValidator(limits);\n  validator.validate(v)?;\n  return Ok(cursor(v, [], limits, 0));\n}\n\n// Schema names are caller input, bounded separately from the validated tree.\nfunction schemaKey(c: DecodeCursor, key: string): Result<void, DecodeError> {\n  const l = c._state.budget();\n  if (key.length > l.maxStringBytes) {\n    return Err(failure(DecodeLimitExceeded, cursorPath(c), \"maxStringBytes\", \"schema key bytes\"));\n  }\n  if (validate(key).isErr()) {\n    return Err(failure(DecodeInvalidSchema, cursorPath(c), \"UTF-8 field name\", \"invalid schema\"));\n  }\n  return Ok();\n}\n\nfunction lookup(c: DecodeCursor, key: string): Result<Option<DecodeCursor>, DecodeError> {\n  match (cursorValue(c)) {\n    ValueObject(fields) => {\n      schemaKey(c, key)?;\n      for (const f of fields) {\n        if (f.key == key) {\n          return Ok(\n            Some(\n              cursor(\n                f.value,\n                extend(cursorPath(c), Key(key)),\n                c._state.budget(),\n                c._state.pathBytes() + key.length,\n              ),\n            ),\n          );\n        }\n      }\n      return Ok(None);\n    },\n    _ => {\n      return Err(wrong(c, \"object\"));\n    },\n  }\n}\n\n// requiredField(c, key): Result<DecodeCursor, DecodeError> -- the member `key` of an object cursor. Errors:\n// DecodeWrongType (not an object), DecodeInvalidSchema (key not valid UTF-8 or over budget),\n// DecodeMissingField (path includes `key`). O(members * path depth).\n@Ensures(result.isOk() ==> cursorPath(result.unwrap()).length == cursorPath(c).length + 1)\nexport function requiredField(c: DecodeCursor, key: string): Result<DecodeCursor, DecodeError> {\n  const found = lookup(c, key)?;\n  if (found.isSome()) {\n    return Ok(found.unwrap());\n  }\n  return Err(\n    failure(DecodeMissingField, extend(cursorPath(c), Key(key)), \"field present\", \"missing\"),\n  );\n}\n\n// optionalField(c, key): Result<Option<DecodeCursor>, DecodeError> -- like requiredField, but None only when\n// the member is absent; a present ValueNull is Some(cursor). Same errors except DecodeMissingField.\n@Ensures(result.isOk() && result.unwrap().isSome()\n    ==> cursorPath(result.unwrap().unwrap()).length == cursorPath(c).length + 1)\nexport function optionalField(\n  c: DecodeCursor,\n  key: string,\n): Result<Option<DecodeCursor>, DecodeError> {\n  return lookup(c, key);\n}\n\n// decodeString(c): Result<string, DecodeError> -- the string under the cursor. Error: DecodeWrongType (no coercion). O(1).\n@Ensures(result.isOk() ==> result.unwrap().length <= c._state.budget().maxStringBytes)\nexport function decodeString(c: DecodeCursor): Result<string, DecodeError> {\n  return match (cursorValue(c)) {\n    ValueString(s) => Ok(s),\n    _ => Err(wrong(c, \"string\")),\n  };\n}\n// decodeBool(c): Result<bool, DecodeError> -- the bool under the cursor. Error: DecodeWrongType (no coercion). O(1).\nexport function decodeBool(c: DecodeCursor): Result<bool, DecodeError> {\n  return match (cursorValue(c)) {\n    ValueBool(b) => Ok(b),\n    _ => Err(wrong(c, \"boolean\")),\n  };\n}\n// decodeNumber(c): Result<JsonNumber, DecodeError> -- the exact number token. Error: DecodeWrongType. O(1).\n@Ensures(result.isOk() ==> result.unwrap().token.length <= c._state.budget().maxNumberBytes)\nexport function decodeNumber(c: DecodeCursor): Result<JsonNumber, DecodeError> {\n  return match (cursorValue(c)) {\n    ValueNumber(n) => Ok(n),\n    _ => Err(wrong(c, \"number\")),\n  };\n}\n\n// decodeInt(c, min, max): Result<int, DecodeError> -- an exact integer in the inclusive range. Errors, in\n// order: DecodeInvalidSchema (min > max), DecodeWrongType, DecodeNotIntegral, DecodeIntegerRange. O(token bytes).\n@Ensures(result.isOk() ==> result.unwrap() >= min && result.unwrap() <= max)\nexport function decodeInt(c: DecodeCursor, min: int, max: int): Result<int, DecodeError> {\n  if (min > max) {\n    return Err(failure(DecodeInvalidSchema, cursorPath(c), \"min <= max\", \"invalid range\"));\n  }\n  const n = decodeNumber(c)?;\n  const r = numberAsInt(n);\n  if (r.isErr()) {\n    const k = match (r.unwrapErr().kind) {\n      NotIntegral => DecodeNotIntegral,\n      IntegerRange => DecodeIntegerRange,\n      FloatOverflow => DecodeFloatOverflow,\n      FloatUnderflow => DecodeFloatUnderflow,\n      _ => DecodeWrongType,\n    };\n    const actual = match (r.unwrapErr().kind) {\n      NotIntegral => \"non-integral number\",\n      IntegerRange => \"out-of-range integer\",\n      FloatOverflow => \"float overflow\",\n      FloatUnderflow => \"float underflow\",\n      _ => \"invalid number\",\n    };\n    return Err(failure(k, cursorPath(c), \"exact int\", actual));\n  }\n  const v = r.unwrap();\n  if (v < min || v > max) {\n    return Err(\n      failure(\n        DecodeIntegerRange,\n        cursorPath(c),\n        \"integer in inclusive range\",\n        \"out-of-range integer\",\n      ),\n    );\n  }\n  return Ok(v);\n}\n\n// decodeArray(c): Result<DecodeCursor[], DecodeError> -- one cursor per element, paths extended by Index.\n// Error: DecodeWrongType. O(elements * path depth) time and allocation.\n@Ensures(result.isOk() ==> result.unwrap().length <= c._state.budget().maxContainerItems)\nexport function decodeArray(c: DecodeCursor): Result<DecodeCursor[], DecodeError> {\n  match (cursorValue(c)) {\n    ValueArray(values) => {\n      let out: DecodeCursor[] = [];\n      let i: usize = 0;\n      while (i < values.length) {\n        out.push(\n          cursor(\n            values[i],\n            extend(cursorPath(c), Index(i)),\n            c._state.budget(),\n            c._state.pathBytes(),\n          ),\n        );\n        i += 1;\n      }\n      return Ok(out);\n    },\n    _ => {\n      return Err(wrong(c, \"array\"));\n    },\n  }\n}\n\n// checkFields(c, allowed, policy): Result<void, DecodeError> -- with RejectUnknown, every member name must be\n// in `allowed`. Errors: DecodeWrongType (not an object), DecodeLimitExceeded or DecodeInvalidSchema (the\n// schema list itself: too long, invalid UTF-8, duplicate names), DecodeUnknownField (path includes the key).\n// O(members + allowed bytes).\nexport function checkFields(\n  c: DecodeCursor,\n  allowed: string[],\n  policy: UnknownFieldPolicy,\n): Result<void, DecodeError> {\n  match (cursorValue(c)) {\n    ValueObject(fields) => {\n      const l = c._state.budget();\n      if (allowed.length > l.maxContainerItems) {\n        return Err(\n          failure(DecodeLimitExceeded, cursorPath(c), \"maxContainerItems\", \"schema items\"),\n        );\n      }\n      let names = new Map<string, bool>();\n      let total: usize = 0;\n      for (const name of allowed) {\n        schemaKey(c, name)?;\n        if (name.length > l.maxDecodedStringBytes - total) {\n          return Err(\n            failure(\n              DecodeLimitExceeded,\n              cursorPath(c),\n              \"maxDecodedStringBytes\",\n              \"schema key bytes\",\n            ),\n          );\n        }\n        total += name.length;\n        if (names.has(name)) {\n          return Err(\n            failure(\n              DecodeInvalidSchema,\n              cursorPath(c),\n              \"unique schema fields\",\n              \"duplicate schema field\",\n            ),\n          );\n        }\n        names.set(name, true);\n      }\n      const reject = match (policy) {\n        RejectUnknown => true,\n        IgnoreUnknown => false,\n      };\n      if (reject) {\n        for (const f of fields) {\n          if (!names.has(f.key)) {\n            return Err(\n              failure(\n                DecodeUnknownField,\n                extend(cursorPath(c), Key(f.key)),\n                \"allowed field\",\n                \"unknown field\",\n              ),\n            );\n          }\n        }\n      }\n      return Ok();\n    },\n    _ => {\n      return Err(wrong(c, \"object\"));\n    },\n  }\n}\n\n// formatPath(path: PathSegment[]): string -- JSON Pointer string form. Root is empty; Key(\"\") is \"/\"; `~`\n// and `/` in keys are escaped as ~0 and ~1. Key vs Index identity stays in the PathSegment array, even if\n// their display coincides. Never fails. O(path bytes).\n@Ensures(path.length == 0 ==> result.length == 0)\n@Ensures(path.length > 0 ==> result.length > 0 && result.charCodeAt(0) == 47)\nexport function formatPath(path: PathSegment[]): string {\n  let out: u8[] = [];\n  for (const segment of path) {\n    out.push(47);\n    const s = match (segment) {\n      Key(key) => key,\n      Index(i) => i.toString(),\n    };\n    let i: usize = 0;\n    while (i < s.length) {\n      const c = s.charCodeAt(i);\n      if (c == 126) {\n        out.push(126);\n        out.push(48);\n      } else if (c == 47) {\n        out.push(126);\n        out.push(49);\n      } else {\n        out.push(c.toU8());\n      }\n      i += 1;\n    }\n  }\n  if (out.length == 0) {\n    return \"\";\n  }\n  return bytesToString(out, 0, out.length);\n}\n\nfunction decodeKindText(k: DecodeErrorKind): string {\n  return match (k) {\n    DecodeMissingField => \"missing field\",\n    DecodeWrongType => \"wrong type\",\n    DecodeNotIntegral => \"number is not an integer\",\n    DecodeIntegerRange => \"integer out of range\",\n    DecodeFloatOverflow => \"float overflow\",\n    DecodeFloatUnderflow => \"float underflow\",\n    DecodeUnknownField => \"unknown field\",\n    DecodeDuplicateField => \"duplicate field\",\n    DecodeLimitExceeded => \"limit exceeded\",\n    DecodeInvalidLimits => \"invalid limits\",\n    DecodeInvalidSchema => \"invalid schema\",\n  };\n}\n\n// decodeErrorMessage(e: DecodeError): string -- \"<pointer or (root)>: <cause>: expected E, found A\". Contains\n// the path (keys) but never an input value. Never fails. O(path bytes).\n@Ensures(result.length > 0)\nexport function decodeErrorMessage(e: DecodeError): string {\n  const where = e.path.length == 0 ? \"(root)\" : formatPath(e.path);\n  return where + \": \" + decodeKindText(e.kind) + \": expected \" + e.expected + \", found \" + e.actual;\n}\n" });
  out.push(SourceFile { path: "$stdlib/json/legacy.or", text: "// std:json/legacy -- the integer-only JSON model (spec 08, ADR-0016), moved here from std:json by ADR-0048\n// section 7.1. DEPRECATED for new code: use std:json (exact numbers, bounded parser and writer) and cross over\n// with `toValue` / `fromValue` below. The module stays for callers that need the old shape (LSP/MCP protocol\n// servers, tooling); it receives no new features.\n//\n// Data model: `Json` is a plain union (no classes), so values copy like any other value and are\n// inspected with `match`. Numbers are INTEGERS ONLY (`JNum(int)`) until floats land; see the\n// TODO(after floats/map) notes. Objects are ordered field lists (`JField[]`), not maps.\n//\n//   * parse accepts RFC 8259 JSON with these restrictions: numbers must be integers in the\n//     range -9223372036854775807 .. 9223372036854775807; a fraction or exponent (`1.5`, `1e3`)\n//     is a JsonError (\"floats are not supported yet\"). Nesting deeper than 200 levels is an error.\n//   * Strings are Orin byte strings holding UTF-8. `\\uXXXX` escapes decode to UTF-8; a surrogate\n//     pair gives one 4-byte sequence, a lone surrogate gives U+FFFD. Raw control characters\n//     (< 0x20) inside strings are rejected. Bytes >= 0x80 are copied through unchanged (the\n//     input is not validated as UTF-8).\n//   * Duplicate object keys are kept (in order); `get` returns the LAST occurrence (JS semantics).\n//   * Errors carry the byte offset plus a 1-based line and column (column counts bytes after the\n//     last \"\\n\"; \"\\r\\n\" ends a line at \"\\n\").\n//   * stringify is compact and deterministic; `pretty` indents with spaces. Object field order is\n//     insertion order. Strings escape `\"`, `\\`, \\b \\f \\n \\r \\t and other control characters as\n//     \\u00XX; all other bytes pass through unchanged.\n//\n// TODO(after floats/map): JNum(float) / separate JFloat, `parse<T>` is post-1.0 (ADR-0016).\n\nimport { JsonValue, JsonMember } from \"std:json\";\nimport { NumberError, numberFromInt, numberAsInt } from \"std:json/number\";\n\n// Json -- the integer-only value: JNull | JBool | JNum(int) | JStr | JArr | JObj (ordered fields).\nexport type Json = JNull | JBool(bool) | JNum(int) | JStr(string) | JArr(Json[]) | JObj(JField[]);\n\n// JField -- one object field in source order (duplicates are kept).\nexport type JField = { key: string; value: Json; };\n\n// JsonError -- parse failure: `message` describes the problem, `offset` is the 0-based byte offset where it was\n// detected (== text length for \"unexpected end of input\"), `line`/`column` are 1-based.\nexport type JsonError = { message: string; offset: usize; line: usize; column: usize; };\n\n// ---- constructors -------------------------------------------------------------------------\n\n// field(key: string, value: Json): JField -- builds an object field. O(1).\nexport function field(key: string, value: Json): JField {\n  return JField { key: key, value: value };\n}\n\n// ---- parser -------------------------------------------------------------------------------\n\ntype PErr = { msg: string; at: usize; };\ntype PRes = { v: Json; pos: usize; };\ntype SRes = { text: string; pos: usize; };\ntype NRes = { n: int; pos: usize; };\n\nconst MAX_DEPTH: int = 200;\n\nfunction fail(msg: string, at: usize): PErr {\n  return PErr { msg: msg, at: at };\n}\n\nfunction isWs(c: int): bool {\n  return c == 32 || c == 9 || c == 10 || c == 13;\n}\n\nfunction skipWs(s: string, start: usize): usize {\n  let i = start;\n  while (i < s.length && isWs(s.charCodeAt(i))) {\n    i += 1;\n  }\n  return i;\n}\n\nfunction hexVal(c: int): int {\n  if (c >= 48 && c <= 57) {\n    return c - 48;\n  }\n  if (c >= 97 && c <= 102) {\n    return c - 87;\n  }\n  if (c >= 65 && c <= 70) {\n    return c - 55;\n  }\n  return -1;\n}\n\n// Four hex digits at `at`, or -1.\nfunction hex4(s: string, at: usize): int {\n  if (at + 4 > s.length) {\n    return -1;\n  }\n  let v = 0;\n  let k: usize = 0;\n  while (k < 4) {\n    const h = hexVal(s.charCodeAt(at + k));\n    if (h < 0) {\n      return -1;\n    }\n    v = v * 16 + h;\n    k += 1;\n  }\n  return v;\n}\n\nfunction utf8(cp: int): string {\n  if (cp < 128) {\n    return String.fromCharCode(cp);\n  }\n  if (cp < 2048) {\n    return String.fromCharCode(192 + cp / 64) + String.fromCharCode(128 + cp % 64);\n  }\n  if (cp < 65536) {\n    return String.fromCharCode(224 + cp / 4096) + String.fromCharCode(128 + (cp / 64) % 64)\n      + String.fromCharCode(128 + cp % 64);\n  }\n  return String.fromCharCode(240 + cp / 262144) + String.fromCharCode(128 + (cp / 4096) % 64)\n    + String.fromCharCode(128 + (cp / 64) % 64) + String.fromCharCode(128 + cp % 64);\n}\n\n// `s[start]` is the opening quote.\nfunction parseString(s: string, start: usize): Result<SRes, PErr> {\n  let out = \"\";\n  let i = start + 1;\n  let runStart = i;\n  while (true) {\n    if (i >= s.length) {\n      return Err(fail(\"unterminated string\", start));\n    }\n    const c = s.charCodeAt(i);\n    if (c == 34) {\n      if (i > runStart) {\n        out += s.substring(runStart, i);\n      }\n      return Ok(SRes { text: out, pos: i + 1 });\n    }\n    if (c < 32) {\n      return Err(fail(\"control character in string\", i));\n    }\n    if (c != 92) {\n      i += 1;\n      continue;\n    }\n    if (i > runStart) {\n      out += s.substring(runStart, i);\n    }\n    if (i + 1 >= s.length) {\n      return Err(fail(\"unterminated escape\", i));\n    }\n    const e = s.charCodeAt(i + 1);\n    i += 2;\n    if (e == 34) {\n      out += \"\\\"\";\n    } else if (e == 92) {\n      out += \"\\\\\";\n    } else if (e == 47) {\n      out += \"/\";\n    } else if (e == 98) {\n      out += String.fromCharCode(8);\n    } else if (e == 102) {\n      out += String.fromCharCode(12);\n    } else if (e == 110) {\n      out += \"\\n\";\n    } else if (e == 114) {\n      out += \"\\r\";\n    } else if (e == 116) {\n      out += \"\\t\";\n    } else if (e == 117) {\n      const u = hex4(s, i);\n      if (u < 0) {\n        return Err(fail(\"invalid \\\\u escape\", i - 2));\n      }\n      i += 4;\n      let cp = u;\n      if (u >= 55296 && u <= 56319) {\n        // High surrogate: needs a following \\uDC00..\\uDFFF.\n        let lo = -1;\n        if (i + 1 < s.length && s.charCodeAt(i) == 92 && s.charCodeAt(i + 1) == 117) {\n          lo = hex4(s, i + 2);\n        }\n        if (lo >= 56320 && lo <= 57343) {\n          cp = 65536 + (u - 55296) * 1024 + (lo - 56320);\n          i += 6;\n        } else {\n          cp = 65533;\n        }\n      } else if (u >= 56320 && u <= 57343) {\n        cp = 65533;\n      }\n      out += utf8(cp);\n    } else {\n      return Err(fail(\"invalid escape\", i - 2));\n    }\n    runStart = i;\n  }\n  return Err(fail(\"unreachable\", i));\n}\n\nfunction isDigit(c: int): bool {\n  return c >= 48 && c <= 57;\n}\n\nconst INT_MAX: int = 9223372036854775807;\n\nfunction parseNumber(s: string, start: usize): Result<NRes, PErr> {\n  let i = start;\n  let neg = false;\n  if (s.charCodeAt(i) == 45) {\n    neg = true;\n    i += 1;\n  }\n  const ds = i;\n  while (i < s.length && isDigit(s.charCodeAt(i))) {\n    i += 1;\n  }\n  if (i == ds) {\n    return Err(fail(\"invalid number\", start));\n  }\n  if (i - ds > 1 && s.charCodeAt(ds) == 48) {\n    return Err(fail(\"leading zero in number\", ds));\n  }\n  let v = 0;\n  let k = ds;\n  while (k < i) {\n    const d = s.charCodeAt(k) - 48;\n    if (v > (INT_MAX - d) / 10) {\n      return Err(fail(\"integer out of range\", start));\n    }\n    v = v * 10 + d;\n    k += 1;\n  }\n  if (i < s.length && (s.charCodeAt(i) == 46 || s.charCodeAt(i) == 101 || s.charCodeAt(i) == 69)) {\n    return Err(fail(\"floats are not supported yet (integers only)\", i));\n  }\n  if (neg) {\n    v = 0 - v;\n  }\n  return Ok(NRes { n: v, pos: i });\n}\n\nfunction expectLit(s: string, at: usize, lit: string): bool {\n  if (at + lit.length > s.length) {\n    return false;\n  }\n  return s.substring(at, at + lit.length) == lit;\n}\n\nfunction parseValue(s: string, start: usize, depth: int): Result<PRes, PErr> {\n  const i = skipWs(s, start);\n  if (i >= s.length) {\n    return Err(fail(\"unexpected end of input\", i));\n  }\n  if (depth > MAX_DEPTH) {\n    return Err(fail(\"nesting too deep\", i));\n  }\n  const c = s.charCodeAt(i);\n  if (c == 34) {\n    const r = parseString(s, i)?;\n    return Ok(PRes { v: JStr(r.text), pos: r.pos });\n  }\n  if (c == 123) {\n    return parseObject(s, i, depth);\n  }\n  if (c == 91) {\n    return parseArray(s, i, depth);\n  }\n  if (c == 45 || isDigit(c)) {\n    const r = parseNumber(s, i)?;\n    return Ok(PRes { v: JNum(r.n), pos: r.pos });\n  }\n  if (expectLit(s, i, \"true\")) {\n    return Ok(PRes { v: JBool(true), pos: i + 4 });\n  }\n  if (expectLit(s, i, \"false\")) {\n    return Ok(PRes { v: JBool(false), pos: i + 5 });\n  }\n  if (expectLit(s, i, \"null\")) {\n    return Ok(PRes { v: JNull, pos: i + 4 });\n  }\n  return Err(fail(\"unexpected character\", i));\n}\n\nfunction parseArray(s: string, start: usize, depth: int): Result<PRes, PErr> {\n  let items: Json[] = [];\n  let i = skipWs(s, start + 1);\n  if (i < s.length && s.charCodeAt(i) == 93) {\n    return Ok(PRes { v: JArr(items), pos: i + 1 });\n  }\n  while (true) {\n    const r = parseValue(s, i, depth + 1)?;\n    items.push(r.v);\n    i = skipWs(s, r.pos);\n    if (i >= s.length) {\n      return Err(fail(\"unexpected end of input, expected `,` or `]`\", i));\n    }\n    const c = s.charCodeAt(i);\n    if (c == 93) {\n      return Ok(PRes { v: JArr(items), pos: i + 1 });\n    }\n    if (c != 44) {\n      return Err(fail(\"expected `,` or `]`\", i));\n    }\n    i += 1;\n  }\n  return Err(fail(\"unreachable\", i));\n}\n\nfunction parseObject(s: string, start: usize, depth: int): Result<PRes, PErr> {\n  let fields: JField[] = [];\n  let i = skipWs(s, start + 1);\n  if (i < s.length && s.charCodeAt(i) == 125) {\n    return Ok(PRes { v: JObj(fields), pos: i + 1 });\n  }\n  while (true) {\n    i = skipWs(s, i);\n    if (i >= s.length) {\n      return Err(fail(\"unexpected end of input, expected string key\", i));\n    }\n    if (s.charCodeAt(i) != 34) {\n      return Err(fail(\"expected string key\", i));\n    }\n    const k = parseString(s, i)?;\n    i = skipWs(s, k.pos);\n    if (i >= s.length) {\n      return Err(fail(\"unexpected end of input, expected `:`\", i));\n    }\n    if (s.charCodeAt(i) != 58) {\n      return Err(fail(\"expected `:`\", i));\n    }\n    const r = parseValue(s, i + 1, depth + 1)?;\n    fields.push(JField { key: k.text, value: r.v });\n    i = skipWs(s, r.pos);\n    if (i >= s.length) {\n      return Err(fail(\"unexpected end of input, expected `,` or `}`\", i));\n    }\n    const c = s.charCodeAt(i);\n    if (c == 125) {\n      return Ok(PRes { v: JObj(fields), pos: i + 1 });\n    }\n    if (c != 44) {\n      return Err(fail(\"expected `,` or `}`\", i));\n    }\n    i += 1;\n  }\n  return Err(fail(\"unreachable\", i));\n}\n\n// 1-based line and column of byte `offset` in `s`.\nfunction locate(s: string, offset: usize): JsonError {\n  let line: usize = 1;\n  let lineStart: usize = 0;\n  let i: usize = 0;\n  while (i < offset && i < s.length) {\n    if (s.charCodeAt(i) == 10) {\n      line += 1;\n      lineStart = i + 1;\n    }\n    i += 1;\n  }\n  return JsonError { message: \"\", offset: offset, line: line, column: offset - lineStart + 1 };\n}\n\nfunction toError(s: string, e: PErr): JsonError {\n  const l = locate(s, e.at);\n  return JsonError { message: e.msg, offset: e.at, line: l.line, column: l.column };\n}\n\n// parse(text: string): Result<Json, JsonError>\n// Parses one JSON document (surrounding whitespace allowed, trailing characters are an error:\n// \"trailing characters\"). Errors: syntax errors, unsupported floats, integer overflow, nesting\n// deeper than 200, each with offset/line/column. Complexity: O(n) time and allocation (plus\n// O(n) to locate the line/column of an error).\nexport function parse(text: string): Result<Json, JsonError> {\n  const r = parseValue(text, 0, 0);\n  if (r.isErr()) {\n    return Err(toError(text, r.unwrapErr()));\n  }\n  const ok = r.unwrap();\n  const end = skipWs(text, ok.pos);\n  if (end < text.length) {\n    return Err(toError(text, fail(\"trailing characters\", end)));\n  }\n  return Ok(ok.v);\n}\n\n// jsonErrorMessage(e: JsonError): string -- \"line L, column C: message\". Never fails. O(1).\nexport function jsonErrorMessage(e: JsonError): string {\n  return \"line \" + e.line.toString() + \", column \" + e.column.toString() + \": \" + e.message;\n}\n\n// formatError(e: JsonError): string -- deprecated spelling of jsonErrorMessage.\n@Deprecated(\"use jsonErrorMessage(e)\")\nexport function formatError(e: JsonError): string {\n  return jsonErrorMessage(e);\n}\n\n// ---- printers -----------------------------------------------------------------------------\n\nfunction hexDigit(n: int): string {\n  if (n < 10) {\n    return String.fromCharCode(48 + n);\n  }\n  return String.fromCharCode(87 + n);\n}\n\n// quote(s: string): string -- `s` as a JSON string literal with escapes. O(n).\nexport function quote(s: string): string {\n  let out = \"\\\"\";\n  let runStart: usize = 0;\n  let i: usize = 0;\n  while (i < s.length) {\n    const c = s.charCodeAt(i);\n    if (c == 34 || c == 92 || c < 32) {\n      if (i > runStart) {\n        out += s.substring(runStart, i);\n      }\n      if (c == 34) {\n        out += \"\\\\\\\"\";\n      } else if (c == 92) {\n        out += \"\\\\\\\\\";\n      } else if (c == 10) {\n        out += \"\\\\n\";\n      } else if (c == 13) {\n        out += \"\\\\r\";\n      } else if (c == 9) {\n        out += \"\\\\t\";\n      } else if (c == 8) {\n        out += \"\\\\b\";\n      } else if (c == 12) {\n        out += \"\\\\f\";\n      } else {\n        out += \"\\\\u00\" + hexDigit(c / 16) + hexDigit(c % 16);\n      }\n      runStart = i + 1;\n    }\n    i += 1;\n  }\n  if (s.length > runStart) {\n    out += s.substring(runStart, s.length);\n  }\n  out += \"\\\"\";\n  return out;\n}\n\nfunction emit(j: Json, out: string[]): string[] {\n  let o = out;\n  match (j) {\n    JNull => { o.push(\"null\"); },\n    JBool(b) => { o.push(b ? \"true\" : \"false\"); },\n    JNum(n) => { o.push(n.toString()); },\n    JStr(s) => { o.push(quote(s)); },\n    JArr(a) => {\n      o.push(\"[\");\n      let i: usize = 0;\n      while (i < a.length) {\n        if (i > 0) {\n          o.push(\",\");\n        }\n        o = emit(a[i], o);\n        i += 1;\n      }\n      o.push(\"]\");\n    },\n    JObj(fs) => {\n      o.push(\"{\");\n      let i: usize = 0;\n      while (i < fs.length) {\n        if (i > 0) {\n          o.push(\",\");\n        }\n        o.push(quote(fs[i].key));\n        o.push(\":\");\n        o = emit(fs[i].value, o);\n        i += 1;\n      }\n      o.push(\"}\");\n    }\n  }\n  return o;\n}\n\n// stringify(j: Json): string\n// Compact deterministic serialization (no whitespace). Never fails. O(n) in the size of `j`.\n// parse(stringify(j)) == j for every j whose integers are in range.\nexport function stringify(j: Json): string {\n  const out: string[] = [];\n  return emit(j, out).join(\"\");\n}\n\nfunction spaces(n: usize): string {\n  let out = \"\";\n  let i: usize = 0;\n  while (i < n) {\n    out += \" \";\n    i += 1;\n  }\n  return out;\n}\n\nfunction emitPretty(j: Json, indent: usize, level: usize, out: string[]): string[] {\n  let o = out;\n  match (j) {\n    JArr(a) => {\n      if (a.length == 0) {\n        o.push(\"[]\");\n      } else {\n        o.push(\"[\\n\");\n        let i: usize = 0;\n        while (i < a.length) {\n          o.push(spaces(indent * (level + 1)));\n          o = emitPretty(a[i], indent, level + 1, o);\n          o.push(i + 1 < a.length ? \",\\n\" : \"\\n\");\n          i += 1;\n        }\n        o.push(spaces(indent * level));\n        o.push(\"]\");\n      }\n    },\n    JObj(fs) => {\n      if (fs.length == 0) {\n        o.push(\"{}\");\n      } else {\n        o.push(\"{\\n\");\n        let i: usize = 0;\n        while (i < fs.length) {\n          o.push(spaces(indent * (level + 1)));\n          o.push(quote(fs[i].key));\n          o.push(\": \");\n          o = emitPretty(fs[i].value, indent, level + 1, o);\n          o.push(i + 1 < fs.length ? \",\\n\" : \"\\n\");\n          i += 1;\n        }\n        o.push(spaces(indent * level));\n        o.push(\"}\");\n      }\n    },\n    _ => { o = emit(j, o); }\n  }\n  return o;\n}\n\n// pretty(j: Json, indent: usize): string\n// Multi-line serialization: one array element / object field per line, `indent` spaces per\n// nesting level, \": \" after keys, empty containers as `[]` / `{}`, no trailing newline.\n// `pretty(j, 0)` still puts every element on its own line (use `stringify` for compact output).\n// Never fails. O(n) in the size of `j` (plus the indentation written).\nexport function pretty(j: Json, indent: usize): string {\n  const out: string[] = [];\n  return emitPretty(j, indent, 0, out).join(\"\");\n}\n\n// ---- accessors ----------------------------------------------------------------------------\n// All accessors are total: a wrong kind or a missing key gives None. They never trap.\n\n// get(j: Json, key: string): Option<Json>\n// The value of field `key` when `j` is an object (the LAST field with that key), else None.\n// O(fields).\nexport function get(j: Json, key: string): Option<Json> {\n  return match (j) {\n    JObj(fs) => lastField(fs, key),\n    _ => None\n  };\n}\n\nfunction lastField(fs: JField[], key: string): Option<Json> {\n  let i = fs.length;\n  while (i > 0) {\n    i -= 1;\n    if (fs[i].key == key) {\n      return Some(fs[i].value);\n    }\n  }\n  return None;\n}\n\n// getIndex(j: Json, index: usize): Option<Json> -- element `index` of an array, else None. O(1).\nexport function getIndex(j: Json, index: usize): Option<Json> {\n  return match (j) {\n    JArr(a) => index < a.length ? Some(a[index]) : None,\n    _ => None\n  };\n}\n\n// at(j: Json, index: usize): Option<Json> -- deprecated spelling of getIndex (`at` means a trapping read elsewhere).\n@Deprecated(\"use getIndex(j, index)\")\nexport function at(j: Json, index: usize): Option<Json> {\n  return getIndex(j, index);\n}\n\n// getPath(j: Json, keys: string[]): Option<Json> -- follows object keys: getPath(j, [\"a\", \"b\"]) is\n// get(get(j, \"a\"), \"b\"); an empty `keys` gives Some(j). O(sum of fields visited).\nexport function getPath(j: Json, keys: string[]): Option<Json> {\n  let cur = j;\n  for (const k of keys) {\n    const f = get(cur, k);\n    if (f.isNone()) {\n      return None;\n    }\n    cur = f.unwrap();\n  }\n  return Some(cur);\n}\n\n// path(j: Json, keys: string[]): Option<Json> -- deprecated spelling of getPath (collides with std:path).\n@Deprecated(\"use getPath(j, keys)\")\nexport function path(j: Json, keys: string[]): Option<Json> {\n  return getPath(j, keys);\n}\n\n// asString(j: Json): Option<string> -- Some for JStr. O(1).\nexport function asString(j: Json): Option<string> {\n  return match (j) {\n    JStr(s) => Some(s),\n    _ => None\n  };\n}\n\n// asInt(j: Json): Option<int> -- Some for JNum. O(1).\nexport function asInt(j: Json): Option<int> {\n  return match (j) {\n    JNum(n) => Some(n),\n    _ => None\n  };\n}\n\n// asBool(j: Json): Option<bool> -- Some for JBool. O(1).\nexport function asBool(j: Json): Option<bool> {\n  return match (j) {\n    JBool(b) => Some(b),\n    _ => None\n  };\n}\n\n// asArray(j: Json): Option<Json[]> -- Some for JArr. O(1) (the array is copied lazily).\nexport function asArray(j: Json): Option<Json[]> {\n  return match (j) {\n    JArr(a) => Some(a),\n    _ => None\n  };\n}\n\n// asObject(j: Json): Option<JField[]> -- Some for JObj, in insertion order. O(1).\nexport function asObject(j: Json): Option<JField[]> {\n  return match (j) {\n    JObj(fs) => Some(fs),\n    _ => None\n  };\n}\n\n// isNull(j: Json): bool -- true for JNull. O(1).\nexport function isNull(j: Json): bool {\n  return match (j) {\n    JNull => true,\n    _ => false\n  };\n}\n\n// keys(j: Json): string[] -- the field names of an object in order (duplicates included);\n// [] for any non-object. O(fields).\nexport function keys(j: Json): string[] {\n  let out: string[] = [];\n  match (j) {\n    JObj(fs) => {\n      for (const f of fs) {\n        out.push(f.key);\n      }\n    },\n    _ => {}\n  }\n  return out;\n}\n\n// getString(j: Json, key: string): Option<string> -- `get` followed by `asString`; None when the key is missing\n// or has another kind. O(fields).\nexport function getString(j: Json, key: string): Option<string> {\n  const f = get(j, key);\n  if (f.isNone()) {\n    return None;\n  }\n  return asString(f.unwrap());\n}\n\n// getInt(j: Json, key: string): Option<int> -- `get` followed by `asInt`. O(fields).\nexport function getInt(j: Json, key: string): Option<int> {\n  const f = get(j, key);\n  if (f.isNone()) {\n    return None;\n  }\n  return asInt(f.unwrap());\n}\n\n// getBool(j: Json, key: string): Option<bool> -- `get` followed by `asBool`. O(fields).\nexport function getBool(j: Json, key: string): Option<bool> {\n  const f = get(j, key);\n  if (f.isNone()) {\n    return None;\n  }\n  return asBool(f.unwrap());\n}\n\n// getArray(j: Json, key: string): Option<Json[]> -- `get` followed by `asArray`. O(fields).\nexport function getArray(j: Json, key: string): Option<Json[]> {\n  const f = get(j, key);\n  if (f.isNone()) {\n    return None;\n  }\n  return asArray(f.unwrap());\n}\n\n// ---- bridge to std:json -------------------------------------------------------------------\n\n// toValue(j: Json): JsonValue -- the same tree in the exact model: JNum(n) becomes the token of n, fields keep\n// their order and duplicates. Never fails (no limits are applied; check the result with writeDocument or\n// decodeRoot if it must satisfy JsonLimits). O(size of j).\nexport function toValue(j: Json): JsonValue {\n  match (j) {\n    JNull => { return ValueNull; },\n    JBool(b) => { return ValueBool(b); },\n    JNum(n) => { return ValueNumber(numberFromInt(n)); },\n    JStr(s) => { return ValueString(s); },\n    JArr(a) => {\n      let out: JsonValue[] = [];\n      for (const e of a) {\n        out.push(toValue(e));\n      }\n      return ValueArray(out);\n    },\n    JObj(fs) => {\n      let out: JsonMember[] = [];\n      for (const f of fs) {\n        out.push(JsonMember { key: f.key, value: toValue(f.value) });\n      }\n      return ValueObject(out);\n    }\n  }\n}\n\n// fromValue(v: JsonValue): Result<Json, NumberError> -- the tree in the integer-only model. Error: a number\n// that is not an int (NotIntegral, e.g. `1.5`, or IntegerRange); `offset` is None. `1.0` and `1e3` convert\n// (they are integral). Integers survive exactly, so fromValue(toValue(j)) == Ok(j). O(size of v).\nexport function fromValue(v: JsonValue): Result<Json, NumberError> {\n  match (v) {\n    ValueNull => { return Ok(JNull); },\n    ValueBool(b) => { return Ok(JBool(b)); },\n    ValueNumber(n) => { return Ok(JNum(numberAsInt(n)?)); },\n    ValueString(s) => { return Ok(JStr(s)); },\n    ValueArray(a) => {\n      let out: Json[] = [];\n      for (const e of a) {\n        out.push(fromValue(e)?);\n      }\n      return Ok(JArr(out));\n    },\n    ValueObject(ms) => {\n      let out: JField[] = [];\n      for (const m of ms) {\n        out.push(JField { key: m.key, value: fromValue(m.value)? });\n      }\n      return Ok(JObj(out));\n    }\n  }\n}\n" });
  out.push(SourceFile { path: "$stdlib/json/number.or", text: "// std:json/number -- exact JSON numeric lexemes (ADR-0048 section 7.1; formerly std:jsonnumber).\n// Grammar, errors, precedence, allocation and bounds: docs/std-json-number.md.\n// Every JsonNumber is validated even when contracts are disabled.\n\n// JsonNumber -- the exact validated ASCII lexeme (`1`, `1.0`, `-0`, `1e999` stay distinct); only this\n// module can construct one.\n@Sealed\nexport type JsonNumber = { token: string; };\n\n// NumberErrorKind -- why a number operation failed. The final three kinds are reserved by the approved JSON RFC for later float\n// utilities; none of the current functions emits them.\nexport type NumberErrorKind =\n  InvalidNumber\n  | NumberLimit\n  | InvalidLimits\n  | NotIntegral\n  | IntegerRange\n  | NonFinite\n  | FloatOverflow\n  | FloatUnderflow;\n// NumberError -- `offset` is the byte offset of the first invalid byte (or the limit) when the input text is at\n// fault, None for conversion failures of a valid token.\nexport type NumberError = { kind: NumberErrorKind; offset: Option<usize>; };\n\nfunction error(kind: NumberErrorKind, offset: Option<usize>): NumberError {\n  return NumberError { kind: kind, offset: offset };\n}\n\n// numberErrorMessage(e: NumberError): string -- the cause, plus \" at byte N\" when `offset` is present. O(1).\n@Ensures(result.length > 0)\nexport function numberErrorMessage(e: NumberError): string {\n  const why = match (e.kind) {\n    InvalidNumber => \"invalid JSON number\",\n    NumberLimit => \"JSON number exceeds byte limit\",\n    InvalidLimits => \"JSON number byte limit must be positive\",\n    NotIntegral => \"JSON number is not an integer\",\n    IntegerRange => \"JSON number is outside the int range\",\n    NonFinite => \"non-finite number\",\n    FloatOverflow => \"float overflow\",\n    FloatUnderflow => \"float underflow\",\n  };\n  if (e.offset.isSome()) {\n    return why + \" at byte \" + e.offset.unwrap().toString();\n  }\n  return why;\n}\n\nfunction digit(c: int): bool {\n  return c >= 48 && c <= 57;\n}\n\n// Returns the first invalid byte/EOF, or None for a complete valid token.\nfunction invalidAt(s: string): Option<usize> {\n  const n = s.length;\n  let i: usize = 0;\n  if (i < n && s.charCodeAt(i) == 45) {\n    i += 1;\n  }\n  if (i == n) {\n    return Some(i);\n  }\n  if (s.charCodeAt(i) == 48) {\n    i += 1;\n  } else {\n    if (s.charCodeAt(i) < 49 || s.charCodeAt(i) > 57) {\n      return Some(i);\n    }\n    while (i < n && digit(s.charCodeAt(i))) {\n      i += 1;\n    }\n  }\n  if (i < n && s.charCodeAt(i) == 46) {\n    i += 1;\n    if (i == n || !digit(s.charCodeAt(i))) {\n      return Some(i);\n    }\n    while (i < n && digit(s.charCodeAt(i))) {\n      i += 1;\n    }\n  }\n  if (i < n && (s.charCodeAt(i) == 101 || s.charCodeAt(i) == 69)) {\n    i += 1;\n    if (i < n && (s.charCodeAt(i) == 43 || s.charCodeAt(i) == 45)) {\n      i += 1;\n    }\n    if (i == n || !digit(s.charCodeAt(i))) {\n      return Some(i);\n    }\n    while (i < n && digit(s.charCodeAt(i))) {\n      i += 1;\n    }\n  }\n  return i == n ? None : Some(i);\n}\n\n// jsonNumber(text, maxBytes): Result<JsonNumber, NumberError> -- validates `text` as one JSON number token.\n// Errors, in order: InvalidLimits (maxBytes == 0), NumberLimit (text longer than maxBytes, offset maxBytes),\n// InvalidNumber (offset of the first invalid byte or text.length). Retains the original immutable string (no\n// token copy); the lexeme spelling is preserved. Never traps. O(n) time, O(1) allocation.\n@Ensures(result.isOk() ==> result.unwrap().token == text && text.length <= maxBytes)\n@Ensures(result.isErr()\n    ==> result.unwrapErr().offset.isNone() || result.unwrapErr().offset.unwrap() <= text.length)\nexport function jsonNumber(text: string, maxBytes: usize): Result<JsonNumber, NumberError> {\n  if (maxBytes == 0) {\n    return Err(error(InvalidLimits, None));\n  }\n  if (text.length > maxBytes) {\n    return Err(error(NumberLimit, Some(maxBytes)));\n  }\n  const bad = invalidAt(text);\n  if (bad.isSome()) {\n    return Err(error(InvalidNumber, bad));\n  }\n  return Ok(JsonNumber { token: text });\n}\n\n// numberFromInt(n: int): JsonNumber -- the token of `n`, exact including -9223372036854775808. Never fails.\n// O(1) (bounded by the int width).\n@Ensures(result.token == n.toString())\nexport function numberFromInt(n: int): JsonNumber {\n  return JsonNumber { token: n.toString() };\n}\n\n// numberAsInt(n: JsonNumber): Result<int, NumberError> -- the integer value of the token when it is integral\n// (`1e3`, `10.0`) and fits the int range. Errors: NotIntegral, IntegerRange (a NotIntegral result wins for\n// fractional values); `offset` is always None because the token is valid. Never traps. O(token bytes), no\n// exponent expansion.\n@Ensures(result.isErr() ==> result.unwrapErr().offset.isNone())\nexport function numberAsInt(n: JsonNumber): Result<int, NumberError> {\n  const s = n.token;\n  const len = s.length;\n  const negative = s.charCodeAt(0) == 45;\n  const start: usize = negative ? 1 : 0;\n  let i = start;\n  let fraction: usize = 0;\n  let afterPoint = false;\n  let significant: usize = 0;\n  let trailing: usize = 0;\n  let nonzero = false;\n  while (i < len && s.charCodeAt(i) != 101 && s.charCodeAt(i) != 69) {\n    const c = s.charCodeAt(i);\n    if (c == 46) {\n      afterPoint = true;\n    } else {\n      if (afterPoint) {\n        fraction += 1;\n      }\n      if (c != 48) {\n        nonzero = true;\n        trailing = 0;\n      } else {\n        if (nonzero) {\n          trailing += 1;\n        }\n      }\n      if (nonzero) {\n        significant += 1;\n      }\n    }\n    i += 1;\n  }\n  // Zero remains integral for any valid exponent, including enormous ones.\n  if (!nonzero) {\n    return Ok(0);\n  }\n  let exponent: usize = 0;\n  let exponentNegative = false;\n  let huge = false;\n  // Runtime strings have at most 2^48 bytes (str_alloc), so +20 cannot overflow\n  // usize. A magnitude > len+20 forces range/non-integrality for nonzero input.\n  const cap = len + 20;\n  if (i < len) {\n    i += 1;\n    if (s.charCodeAt(i) == 45 || s.charCodeAt(i) == 43) {\n      exponentNegative = s.charCodeAt(i) == 45;\n      i += 1;\n    }\n    while (i < len) {\n      const d = (s.charCodeAt(i) - 48).toUsize();\n      if (!huge) {\n        if (exponent > (cap - d) / 10) {\n          huge = true;\n        } else {\n          exponent = exponent * 10 + d;\n        }\n      }\n      i += 1;\n    }\n  }\n  if (huge) {\n    return Err(error(exponentNegative ? NotIntegral : IntegerRange, None));\n  }\n  let count: usize = 0;\n  if (exponentNegative) {\n    if (fraction > trailing || exponent > trailing - fraction) {\n      return Err(error(NotIntegral, None));\n    }\n    count = significant - fraction - exponent;\n  } else {\n    if (exponent < fraction) {\n      const discard = fraction - exponent;\n      if (discard > trailing) {\n        return Err(error(NotIntegral, None));\n      }\n      count = significant - discard;\n    } else {\n      const zeros = exponent - fraction;\n      if (zeros > 19 || significant > 19 - zeros) {\n        return Err(error(IntegerRange, None));\n      }\n      count = significant + zeros;\n    }\n  }\n  if (count > 19) {\n    return Err(error(IntegerRange, None));\n  }\n  const limit: int = negative ? -9223372036854775807 - 1 : -9223372036854775807;\n  const cutoff = limit / 10;\n  const last = 0 - limit % 10;\n  let value = 0;\n  let taken: usize = 0;\n  let began = false;\n  i = start;\n  while (taken < count) {\n    let d = 0;\n    if (i < len && s.charCodeAt(i) != 101 && s.charCodeAt(i) != 69) {\n      const c = s.charCodeAt(i);\n      i += 1;\n      if (c == 46) {\n        continue;\n      }\n      d = c - 48;\n      if (!began && d == 0) {\n        continue;\n      }\n      began = true;\n    }\n    // Accumulate negatively, preserving i64 minimum without abs/negation overflow.\n    if (value < cutoff || value == cutoff && d > last) {\n      return Err(error(IntegerRange, None));\n    }\n    value = value * 10 - d;\n    taken += 1;\n  }\n  return Ok(negative ? value : 0 - value);\n}\n" });
  out.push(SourceFile { path: "$stdlib/meta.or", text: "// std:meta -- types and builders for ADR-0046 annotation processors (slice S3): the immutable `Input` a processor\n// receives, the `Output` tree (`MDecl` / `MStmt` / `MExpr` / `MType`) it builds, `fresh` / `NameGen` hygiene, and the\n// stable JSON encoding of both. UNSTABLE until ADR-0046 is implemented (docs/std-meta.md).\n//\n// This file only re-exports: the definitions are in `std:metacore` (model and builders) and `std:metajson` (codec).\n// Pure: no grants, no I/O.\nexport {\n  MRef, MConst, MCBool, MCInt, MCFloat, MCString, MCTag, MCArray, MCNone, MCSome, MType, MNamed,\n  MArray, MOption, MResult, MFn, MUnion, MVariant, MParam, MArg, MAnnotation, MContractKind,\n  MRequires, MEnsures, MInvariant, MDecreases, MRule, MContract, MDeclKind, MKRecord, MKUnion,\n  MKAlias, MKClass, MKInterface, MKFunction, MKConst, MFieldView, MMethodView, MDeclView, MShape,\n  MSRecord, MSUnion, MSAlias, MSOpaque, MTypeShape, Input, MUnOp, OpNeg, OpNot, OpBitNot, MBinOp,\n  OpAdd, OpSub, OpMul, OpDiv, OpRem, OpEq, OpNe, OpLt, OpLe, OpGt, OpGe, OpAnd, OpOr, OpBitAnd,\n  OpBitOr, OpBitXor, OpShl, OpShr, MPattern, MPWild, MPBind, MPVariant, MPLit, MExpr, MEInt,\n  MEFloat, MEString, MEBool, MEName, MECall, MEMethod, MEField, MEIndex, MERecord, MEArray, MEUnary,\n  MEBinary, MEMatch, METry, MECond, MFieldInit, MArm, MStmt, MSConst, MSLet, MSAssign, MSReturn,\n  MSExpr, MSIf, MSWhile, MSForOf, MSMatch, MFnDecl, MConstDecl, MRecordDecl, MUnionDecl,\n  MClassField, MCtorDecl, MClassDecl, MDecl, MDFn, MDConst, MDRecord, MDUnion, MDClass, MImport,\n  MSeverity, MError, MWarning, MDiagnostic, Output, fresh, NameGen, nameGen, ref, annotationArg,\n  findAnnotation, constString, constInt, constBool, emptyInput, named, generic, arrayOf, optionOf,\n  resultOf, fnOf, unionOf, variant, param, cInt, cStr, cBool, pWild, pBind, pVariant, pLit, intLit,\n  floatLit, str, boolLit, name, call, callExpr, callGeneric, method, dot, index, initField, record,\n  arrayLit, unary, binary, neg, not, add, sub, mul, div, rem, eq, ne, lt, le, gt, ge, andAlso,\n  orElse, tryOp, cond, arm, armStmts, matchExpr, constS, constT, letS, letT, assign, ret, retVoid,\n  exprS, ifS, whileS, forOf, matchS, fn, constant, recordType, unionType, classField, ctor,\n  methodDecl, classType, declName, declExported, exportDecl, withTypeParams, withDoc, importFrom,\n  diagError, diagWarning, emptyOutput, output, withImports, withDiagnostics, hasErrors,\n} from \"std:metacore\";\nexport {\n  inputToJson, encodeInput, inputFromJson, decodeInput, outputToJson, encodeOutput, outputFromJson,\n  decodeOutput,\n} from \"std:metajson\";\n" });
  out.push(SourceFile { path: "$stdlib/metacore.or", text: "// std:metacore -- the data model and the builders of std:meta (ADR-0046 \xc2\xa72, slice S3). Import `std:meta`, which\n// re-exports this module and the JSON codec of `std:metajson`.\n//\n// UNSTABLE until ADR-0046 is fully implemented (slices S4/S5 connect it to the compiler).\n//\n// Everything here is PURE: plain records and unions (values, no classes with identity, no grants, no I/O). A processor\n// (`@Processor(A) function p(input: Input): Output`) reads an `Input` and builds an `Output` out of the builders below.\n//\n//   * Input side: `Input` -> `MDeclView` (one per annotated declaration, in source order) -> `MFieldView`,\n//     `MMethodView`, `MVariant`, `MAnnotation`/`MArg`/`MConst`, `MContract`; types are `MType` trees; every named type\n//     that occurs is listed once in `Input.types` with its `MTypeShape`.\n//   * Output side: `Output` -> `MDecl` -> `MStmt` / `MExpr` / `MPattern` / `MType`, plus imports and diagnostics. A\n//     diagnostic points at the input with an `MRef` the processor copied from an input item, never a free position.\n//   * Hygiene: `fresh(name, n)` yields `__g<n>_<name>`; the counter is NOT global state. It is threaded by the caller:\n//     either pass your own `n`, or use a `NameGen` that starts at `Input.freshBase` (the compiler gives every\n//     processor run a distinct base, so two processors in one companion module never produce the same name).\n//\n// Complexity: every builder is O(1) in its arguments' size (it only wraps them); nothing here traverses a tree.\n\n// ---- shared pieces --------------------------------------------------------------------------------------------------\n\n// An opaque handle for an item of the input (declaration, field, method). Assigned by the compiler, unique within one\n// `Input`; a diagnostic carries one so that the compiler can point at the source span of the item.\nexport type MRef = { id: int; };\n\n// A constant argument of an applied annotation. `MCFloat` keeps the source text of the literal (the JSON encoding is\n// integer only). `MCTag` is a variant name of a payload-free union. `MCNone`/`MCSome` are `Option` values.\nexport type MConst =\n  MCBool(bool)\n  | MCInt(int)\n  | MCFloat(string)\n  | MCString(string)\n  | MCTag(string)\n  | MCArray(MConst[])\n  | MCNone\n  | MCSome(MConst);\n\n// A type. `MNamed(\"User\", [])`, `MNamed(\"Pair\", [a, b])`, `MArray(t)` is `t[]`, `MOption(t)` is `Option<t>`,\n// `MResult(t, e)` is `Result<t, e>`, `MFn(params, ret)` a function type, `MUnion(vs)` an anonymous union.\nexport type MType =\n  MNamed(string, MType[])\n  | MArray(MType)\n  | MOption(MType)\n  | MResult(MType, MType)\n  | MFn(MType[], MType)\n  | MUnion(MVariant[]);\n\n// A union variant with its payload types (empty for a tag).\nexport type MVariant = { name: string; payload: MType[]; };\n\n// A named, typed value: a parameter, a record field.\nexport type MParam = { name: string; ty: MType; };\n\n// ---- input ----------------------------------------------------------------------------------------------------------\n\n// One argument of an applied annotation: the field name of the annotation record, and its constant. Omitted trailing\n// `Option` arguments are present as `MCNone`, so `args` always has one entry per annotation field, in field order.\nexport type MArg = { name: string; value: MConst; };\n\n// An applied annotation: `source` is the module path that declares it (\"std:json\", \"./route\"), `name` its name.\nexport type MAnnotation = { source: string; name: string; args: MArg[]; };\n\nexport type MContractKind = MRequires | MEnsures | MInvariant | MDecreases | MRule;\n\n// A contract clause as read-only text (the expression exactly as the formatter prints it).\nexport type MContract = { kind: MContractKind; text: string; };\n\nexport type MDeclKind = MKRecord | MKUnion | MKAlias | MKClass | MKInterface | MKFunction | MKConst;\n\nexport type MFieldView = {\n  ref: MRef;\n  name: string;\n  ty: MType;\n  exported: bool;\n  annotations: MAnnotation[];\n};\n\nexport type MMethodView = {\n  ref: MRef;\n  name: string;\n  exported: bool;\n  typeParams: string[];\n  params: MParam[];\n  returns: MType;\n  doc: string;\n  annotations: MAnnotation[];\n  contracts: MContract[];\n};\n\n// An annotated declaration. Which members are filled depends on `kind`; the others are empty / None:\n//   MKRecord    fields                          MKUnion      variants\n//   MKAlias     ty = the aliased type           MKClass      fields, ctorParams, methods\n//   MKInterface methods                         MKFunction   params, ty = Some(return type), contracts\n//   MKConst     ty = Some(declared type)\nexport type MDeclView = {\n  ref: MRef;\n  kind: MDeclKind;\n  name: string;\n  exported: bool;\n  typeParams: string[];\n  doc: string;\n  annotations: MAnnotation[];\n  contracts: MContract[];\n  fields: MFieldView[];\n  ctorParams: MParam[];\n  methods: MMethodView[];\n  variants: MVariant[];\n  params: MParam[];\n  ty: Option<MType>;\n};\n\n// The shape of a named type that occurs in the input and is visible from the source module.\nexport type MShape = MSRecord(MFieldView[]) | MSUnion(MVariant[]) | MSAlias(MType) | MSOpaque;\n\nexport type MTypeShape = { name: string; source: string; typeParams: string[]; shape: MShape; };\n\n// What a processor receives: the module it runs over, the annotation it was registered for, the annotated\n// declarations (source order), the named types they mention (first occurrence order), and the base of `NameGen`.\nexport type Input = {\n  modulePath: string;\n  annotation: string;\n  freshBase: int;\n  decls: MDeclView[];\n  types: MTypeShape[];\n};\n\n// ---- output ---------------------------------------------------------------------------------------------------------\n\nexport type MUnOp = OpNeg | OpNot | OpBitNot;\nexport type MBinOp =\n  OpAdd\n  | OpSub\n  | OpMul\n  | OpDiv\n  | OpRem\n  | OpEq\n  | OpNe\n  | OpLt\n  | OpLe\n  | OpGt\n  | OpGe\n  | OpAnd\n  | OpOr\n  | OpBitAnd\n  | OpBitOr\n  | OpBitXor\n  | OpShl\n  | OpShr;\n\n// `Some(x)`, `Ok(v)`, `Err(e)`, `Get`, `None` are all `MPVariant` (no sub-patterns for a tag); `MPBind` binds a name;\n// `MPLit` matches a constant (int, string, bool).\nexport type MPattern = MPWild | MPBind(string) | MPVariant(string, MPattern[]) | MPLit(MConst);\n\nexport type MExpr =\n  MEInt(int)\n  | MEFloat(string)\n  | MEString(string)\n  | MEBool(bool)\n  | MEName(string)\n  | MECall(MExpr, MType[], MExpr[])\n  | MEMethod(MExpr, string, MExpr[])\n  | MEField(MExpr, string)\n  | MEIndex(MExpr, MExpr)\n  | MERecord(string, MFieldInit[])\n  | MEArray(MExpr[])\n  | MEUnary(MUnOp, MExpr)\n  | MEBinary(MBinOp, MExpr, MExpr)\n  | MEMatch(MExpr, MArm[])\n  | METry(MExpr)\n  | MECond(MExpr, MExpr, MExpr);\n\nexport type MFieldInit = { name: string; value: MExpr; };\n\n// A `match` arm. In an expression (`MEMatch`) the arm yields `value` (required) after running `stmts`; in a statement\n// (`MSMatch`) `value` is None or an expression evaluated for effect.\nexport type MArm = { pattern: MPattern; stmts: MStmt[]; value: Option<MExpr>; };\n\nexport type MStmt =\n  MSConst(string, Option<MType>, MExpr)\n  | MSLet(string, Option<MType>, MExpr)\n  | MSAssign(MExpr, MExpr)\n  | MSReturn(Option<MExpr>)\n  | MSExpr(MExpr)\n  | MSIf(MExpr, MStmt[], MStmt[])\n  | MSWhile(MExpr, MStmt[])\n  | MSForOf(string, MExpr, MStmt[])\n  | MSMatch(MExpr, MArm[]);\n\nexport type MFnDecl = {\n  name: string;\n  exported: bool;\n  typeParams: string[];\n  params: MParam[];\n  returns: MType;\n  body: MStmt[];\n  doc: string;\n};\nexport type MConstDecl = { name: string; exported: bool; ty: MType; value: MExpr; doc: string; };\nexport type MRecordDecl = {\n  name: string;\n  exported: bool;\n  typeParams: string[];\n  fields: MParam[];\n  doc: string;\n};\nexport type MUnionDecl = {\n  name: string;\n  exported: bool;\n  typeParams: string[];\n  variants: MVariant[];\n  doc: string;\n};\n// Class fields are private unless `exported`. A class without `ctor` has none. Methods use `MFnDecl`: `exported` means\n// public; their `typeParams` are the method's own. No inheritance.\nexport type MClassField = { name: string; ty: MType; exported: bool; };\nexport type MCtorDecl = { params: MParam[]; body: MStmt[]; };\nexport type MClassDecl = {\n  name: string;\n  exported: bool;\n  typeParams: string[];\n  fields: MClassField[];\n  ctor: Option<MCtorDecl>;\n  methods: MFnDecl[];\n  doc: string;\n};\n\nexport type MDecl =\n  MDFn(MFnDecl)\n  | MDConst(MConstDecl)\n  | MDRecord(MRecordDecl)\n  | MDUnion(MUnionDecl)\n  | MDClass(MClassDecl);\n\n// `import { names } from \"source\"` needed by the generated code.\nexport type MImport = { names: string[]; source: string; };\n\nexport type MSeverity = MError | MWarning;\n\n// `at` is a ref copied from an input item; the compiler turns it into the span of that item.\nexport type MDiagnostic = { severity: MSeverity; message: string; at: MRef; };\n\nexport type Output = { imports: MImport[]; decls: MDecl[]; diagnostics: MDiagnostic[]; };\n\n// ---- hygiene --------------------------------------------------------------------------------------------------------\n\n// fresh(name: string, n: int): string -- \"__g<n>_<name>\". Pure: the same (name, n) always gives the same string, and\n// different `n` give different strings. `name` must be an identifier (not checked). Identifiers that start with\n// \"__g\" are reserved for generated code. O(len).\nexport function fresh(name: string, n: int): string {\n  return \"__g\" + n.toString() + \"_\" + name;\n}\n\n// A counter threaded through a processor: `let g = nameGen(input.freshBase); const t = g.fresh(\"tmp\");`. Every call\n// of `fresh` returns a new name (`__g<base>_x`, `__g<base+1>_x`, ...). The state is local to the value you create, and\n// so is deterministic for a deterministic processor; there is no global counter.\nexport class NameGen {\n  private next: int;\n\n  constructor(start: int) {\n    this.next = start;\n  }\n\n  fresh(name: string): string {\n    const n = this.next;\n    this.next = n + 1;\n    return fresh(name, n);\n  }\n\n  // The next number that `fresh` will use (to continue a counter elsewhere).\n  peek(): int {\n    return this.next;\n  }\n}\n\nexport function nameGen(start: int): NameGen {\n  return new NameGen(start);\n}\n\n// ---- input helpers --------------------------------------------------------------------------------------------------\n\n// ref(id: int): MRef\nexport function ref(id: int): MRef {\n  return MRef { id: id };\n}\n\n// annotationArg(a: MAnnotation, name: string): Option<MConst> -- the argument named `name` (the LAST if repeated). O(args).\nexport function annotationArg(a: MAnnotation, name: string): Option<MConst> {\n  let i = a.args.length;\n  while (i > 0) {\n    i -= 1;\n    if (a.args[i].name == name) {\n      return Some(a.args[i].value);\n    }\n  }\n  return None;\n}\n\n// findAnnotation(as: MAnnotation[], name: string): Option<MAnnotation> -- the first annotation called `name`. O(n).\nexport function findAnnotation(list: MAnnotation[], name: string): Option<MAnnotation> {\n  for (const a of list) {\n    if (a.name == name) {\n      return Some(a);\n    }\n  }\n  return None;\n}\n\n// constString(c: MConst): Option<string> / constInt / constBool: the payload when the constant has that kind.\nexport function constString(c: MConst): Option<string> {\n  return match (c) {\n    MCString(s) => Some(s),\n    _ => None,\n  };\n}\n\nexport function constInt(c: MConst): Option<int> {\n  return match (c) {\n    MCInt(n) => Some(n),\n    _ => None,\n  };\n}\n\nexport function constBool(c: MConst): Option<bool> {\n  return match (c) {\n    MCBool(b) => Some(b),\n    _ => None,\n  };\n}\n\n// emptyInput(modulePath, annotation): an Input without declarations (for tests and tools).\nexport function emptyInput(modulePath: string, annotation: string): Input {\n  return Input {\n    modulePath: modulePath,\n    annotation: annotation,\n    freshBase: 0,\n    decls: [],\n    types: [],\n  };\n}\n\n// ---- type builders --------------------------------------------------------------------------------------------------\n\nexport function named(name: string): MType {\n  return MNamed(name, []);\n}\n\nexport function generic(name: string, args: MType[]): MType {\n  return MNamed(name, args);\n}\n\nexport function arrayOf(t: MType): MType {\n  return MArray(t);\n}\n\nexport function optionOf(t: MType): MType {\n  return MOption(t);\n}\n\nexport function resultOf(ok: MType, err: MType): MType {\n  return MResult(ok, err);\n}\n\nexport function fnOf(params: MType[], returns: MType): MType {\n  return MFn(params, returns);\n}\n\nexport function unionOf(variants: MVariant[]): MType {\n  return MUnion(variants);\n}\n\nexport function variant(name: string, payload: MType[]): MVariant {\n  return MVariant { name: name, payload: payload };\n}\n\nexport function param(name: string, ty: MType): MParam {\n  return MParam { name: name, ty: ty };\n}\n\n// ---- constants and patterns -----------------------------------------------------------------------------------------\n\nexport function cInt(n: int): MConst {\n  return MCInt(n);\n}\n\nexport function cStr(s: string): MConst {\n  return MCString(s);\n}\n\nexport function cBool(b: bool): MConst {\n  return MCBool(b);\n}\n\nexport function pWild(): MPattern {\n  return MPWild;\n}\n\nexport function pBind(name: string): MPattern {\n  return MPBind(name);\n}\n\nexport function pVariant(name: string, subs: MPattern[]): MPattern {\n  return MPVariant(name, subs);\n}\n\nexport function pLit(c: MConst): MPattern {\n  return MPLit(c);\n}\n\n// ---- expression builders --------------------------------------------------------------------------------------------\n\nexport function intLit(n: int): MExpr {\n  return MEInt(n);\n}\n\nexport function floatLit(text: string): MExpr {\n  return MEFloat(text);\n}\n\nexport function str(s: string): MExpr {\n  return MEString(s);\n}\n\nexport function boolLit(b: bool): MExpr {\n  return MEBool(b);\n}\n\nexport function name(n: string): MExpr {\n  return MEName(n);\n}\n\n// call(\"encodeUser\", [x]) -- a call of a named function. callExpr calls any expression; callGeneric passes type arguments.\nexport function call(fnName: string, args: MExpr[]): MExpr {\n  return MECall(MEName(fnName), [], args);\n}\n\nexport function callExpr(callee: MExpr, args: MExpr[]): MExpr {\n  return MECall(callee, [], args);\n}\n\nexport function callGeneric(fnName: string, typeArgs: MType[], args: MExpr[]): MExpr {\n  return MECall(MEName(fnName), typeArgs, args);\n}\n\nexport function method(receiver: MExpr, methodName: string, args: MExpr[]): MExpr {\n  return MEMethod(receiver, methodName, args);\n}\n\n// dot(e, \"name\") -- field access `e.name`.\nexport function dot(e: MExpr, fieldName: string): MExpr {\n  return MEField(e, fieldName);\n}\n\nexport function index(e: MExpr, i: MExpr): MExpr {\n  return MEIndex(e, i);\n}\n\nexport function initField(fieldName: string, value: MExpr): MFieldInit {\n  return MFieldInit { name: fieldName, value: value };\n}\n\n// record(\"User\", [initField(\"id\", x)]) -- the record literal `User { id: x }`.\nexport function record(typeName: string, inits: MFieldInit[]): MExpr {\n  return MERecord(typeName, inits);\n}\n\nexport function arrayLit(items: MExpr[]): MExpr {\n  return MEArray(items);\n}\n\nexport function unary(op: MUnOp, e: MExpr): MExpr {\n  return MEUnary(op, e);\n}\n\nexport function binary(op: MBinOp, a: MExpr, b: MExpr): MExpr {\n  return MEBinary(op, a, b);\n}\n\nexport function neg(e: MExpr): MExpr {\n  return MEUnary(OpNeg, e);\n}\n\nexport function not(e: MExpr): MExpr {\n  return MEUnary(OpNot, e);\n}\n\nexport function add(a: MExpr, b: MExpr): MExpr {\n  return MEBinary(OpAdd, a, b);\n}\n\nexport function sub(a: MExpr, b: MExpr): MExpr {\n  return MEBinary(OpSub, a, b);\n}\n\nexport function mul(a: MExpr, b: MExpr): MExpr {\n  return MEBinary(OpMul, a, b);\n}\n\nexport function div(a: MExpr, b: MExpr): MExpr {\n  return MEBinary(OpDiv, a, b);\n}\n\nexport function rem(a: MExpr, b: MExpr): MExpr {\n  return MEBinary(OpRem, a, b);\n}\n\nexport function eq(a: MExpr, b: MExpr): MExpr {\n  return MEBinary(OpEq, a, b);\n}\n\nexport function ne(a: MExpr, b: MExpr): MExpr {\n  return MEBinary(OpNe, a, b);\n}\n\nexport function lt(a: MExpr, b: MExpr): MExpr {\n  return MEBinary(OpLt, a, b);\n}\n\nexport function le(a: MExpr, b: MExpr): MExpr {\n  return MEBinary(OpLe, a, b);\n}\n\nexport function gt(a: MExpr, b: MExpr): MExpr {\n  return MEBinary(OpGt, a, b);\n}\n\nexport function ge(a: MExpr, b: MExpr): MExpr {\n  return MEBinary(OpGe, a, b);\n}\n\nexport function andAlso(a: MExpr, b: MExpr): MExpr {\n  return MEBinary(OpAnd, a, b);\n}\n\nexport function orElse(a: MExpr, b: MExpr): MExpr {\n  return MEBinary(OpOr, a, b);\n}\n\n// tryOp(e) -- the postfix `e?`.\nexport function tryOp(e: MExpr): MExpr {\n  return METry(e);\n}\n\n// cond(c, a, b) -- the conditional expression `c ? a : b`.\nexport function cond(c: MExpr, a: MExpr, b: MExpr): MExpr {\n  return MECond(c, a, b);\n}\n\n// arm(p, v) -- `p => v`; armStmts(p, ss, v) -- `p => { ss; v }` (v may be None in a statement match).\nexport function arm(pattern: MPattern, value: MExpr): MArm {\n  return MArm { pattern: pattern, stmts: [], value: Some(value) };\n}\n\nexport function armStmts(pattern: MPattern, stmts: MStmt[], value: Option<MExpr>): MArm {\n  return MArm { pattern: pattern, stmts: stmts, value: value };\n}\n\nexport function matchExpr(scrutinee: MExpr, arms: MArm[]): MExpr {\n  return MEMatch(scrutinee, arms);\n}\n\n// ---- statement builders ---------------------------------------------------------------------------------------------\n\nexport function constS(n: string, value: MExpr): MStmt {\n  return MSConst(n, None, value);\n}\n\nexport function constT(n: string, ty: MType, value: MExpr): MStmt {\n  return MSConst(n, Some(ty), value);\n}\n\nexport function letS(n: string, value: MExpr): MStmt {\n  return MSLet(n, None, value);\n}\n\nexport function letT(n: string, ty: MType, value: MExpr): MStmt {\n  return MSLet(n, Some(ty), value);\n}\n\nexport function assign(target: MExpr, value: MExpr): MStmt {\n  return MSAssign(target, value);\n}\n\nexport function ret(value: MExpr): MStmt {\n  return MSReturn(Some(value));\n}\n\nexport function retVoid(): MStmt {\n  return MSReturn(None);\n}\n\nexport function exprS(e: MExpr): MStmt {\n  return MSExpr(e);\n}\n\nexport function ifS(c: MExpr, thenBody: MStmt[], elseBody: MStmt[]): MStmt {\n  return MSIf(c, thenBody, elseBody);\n}\n\nexport function whileS(c: MExpr, body: MStmt[]): MStmt {\n  return MSWhile(c, body);\n}\n\nexport function forOf(varName: string, iterable: MExpr, body: MStmt[]): MStmt {\n  return MSForOf(varName, iterable, body);\n}\n\nexport function matchS(scrutinee: MExpr, arms: MArm[]): MStmt {\n  return MSMatch(scrutinee, arms);\n}\n\n// ---- declaration builders -------------------------------------------------------------------------------------------\n\n// fn(\"encodeUser\", [param(\"u\", named(\"User\"))], named(\"Json\"), [ret(call(\"x\", [...]))]) -- a private, non-generic\n// function without a doc comment. Change it with exportDecl / withTypeParams / withDoc.\nexport function fn(fnName: string, params: MParam[], returns: MType, body: MStmt[]): MDecl {\n  return MDFn(MFnDecl {\n    name: fnName,\n    exported: false,\n    typeParams: [],\n    params: params,\n    returns: returns,\n    body: body,\n    doc: \"\",\n  });\n}\n\nexport function constant(n: string, ty: MType, value: MExpr): MDecl {\n  return MDConst(MConstDecl { name: n, exported: false, ty: ty, value: value, doc: \"\" });\n}\n\nexport function recordType(n: string, fields: MParam[]): MDecl {\n  return MDRecord(MRecordDecl {\n    name: n,\n    exported: false,\n    typeParams: [],\n    fields: fields,\n    doc: \"\",\n  });\n}\n\nexport function unionType(n: string, variants: MVariant[]): MDecl {\n  return MDUnion(MUnionDecl {\n    name: n,\n    exported: false,\n    typeParams: [],\n    variants: variants,\n    doc: \"\",\n  });\n}\n\nexport function classField(n: string, ty: MType, isExported: bool): MClassField {\n  return MClassField { name: n, ty: ty, exported: isExported };\n}\n\nexport function ctor(params: MParam[], body: MStmt[]): MCtorDecl {\n  return MCtorDecl { params: params, body: body };\n}\n\n// methodDecl: an `MFnDecl` for a class method (public when `isExported`).\nexport function methodDecl(\n  n: string,\n  isExported: bool,\n  params: MParam[],\n  returns: MType,\n  body: MStmt[],\n): MFnDecl {\n  return MFnDecl {\n    name: n,\n    exported: isExported,\n    typeParams: [],\n    params: params,\n    returns: returns,\n    body: body,\n    doc: \"\",\n  };\n}\n\nexport function classType(\n  n: string,\n  fields: MClassField[],\n  ctorDecl: Option<MCtorDecl>,\n  methods: MFnDecl[],\n): MDecl {\n  return MDClass(MClassDecl {\n    name: n,\n    exported: false,\n    typeParams: [],\n    fields: fields,\n    ctor: ctorDecl,\n    methods: methods,\n    doc: \"\",\n  });\n}\n\n// declName(d) -- the name of any declaration.\nexport function declName(d: MDecl): string {\n  return match (d) {\n    MDFn(f) => f.name,\n    MDConst(c) => c.name,\n    MDRecord(r) => r.name,\n    MDUnion(u) => u.name,\n    MDClass(c) => c.name,\n  };\n}\n\n// declExported(d) -- the export flag of any declaration.\nexport function declExported(d: MDecl): bool {\n  return match (d) {\n    MDFn(f) => f.exported,\n    MDConst(c) => c.exported,\n    MDRecord(r) => r.exported,\n    MDUnion(u) => u.exported,\n    MDClass(c) => c.exported,\n  };\n}\n\n// exportDecl(d, flag) -- `decl.exported(flag)` of ADR-0046: the same declaration with the export flag set. Exported\n// names are public and are checked for collisions (E0449); helper names should stay private.\nexport function exportDecl(d: MDecl, flag: bool): MDecl {\n  return match (d) {\n    MDFn(f) => MDFn(MFnDecl {\n      name: f.name,\n      exported: flag,\n      typeParams: f.typeParams,\n      params: f.params,\n      returns: f.returns,\n      body: f.body,\n      doc: f.doc,\n    }),\n    MDConst(c) => MDConst(MConstDecl {\n      name: c.name,\n      exported: flag,\n      ty: c.ty,\n      value: c.value,\n      doc: c.doc,\n    }),\n    MDRecord(r) => MDRecord(MRecordDecl {\n      name: r.name,\n      exported: flag,\n      typeParams: r.typeParams,\n      fields: r.fields,\n      doc: r.doc,\n    }),\n    MDUnion(u) => MDUnion(MUnionDecl {\n      name: u.name,\n      exported: flag,\n      typeParams: u.typeParams,\n      variants: u.variants,\n      doc: u.doc,\n    }),\n    MDClass(c) => MDClass(MClassDecl {\n      name: c.name,\n      exported: flag,\n      typeParams: c.typeParams,\n      fields: c.fields,\n      ctor: c.ctor,\n      methods: c.methods,\n      doc: c.doc,\n    }),\n  };\n}\n\n// withTypeParams(d, ps) -- the declaration with type parameters `ps` (a constant has none: returned unchanged).\nexport function withTypeParams(d: MDecl, ps: string[]): MDecl {\n  return match (d) {\n    MDFn(f) => MDFn(MFnDecl {\n      name: f.name,\n      exported: f.exported,\n      typeParams: ps,\n      params: f.params,\n      returns: f.returns,\n      body: f.body,\n      doc: f.doc,\n    }),\n    MDConst(c) => MDConst(c),\n    MDRecord(r) => MDRecord(MRecordDecl {\n      name: r.name,\n      exported: r.exported,\n      typeParams: ps,\n      fields: r.fields,\n      doc: r.doc,\n    }),\n    MDUnion(u) => MDUnion(MUnionDecl {\n      name: u.name,\n      exported: u.exported,\n      typeParams: ps,\n      variants: u.variants,\n      doc: u.doc,\n    }),\n    MDClass(c) => MDClass(MClassDecl {\n      name: c.name,\n      exported: c.exported,\n      typeParams: ps,\n      fields: c.fields,\n      ctor: c.ctor,\n      methods: c.methods,\n      doc: c.doc,\n    }),\n  };\n}\n\n// withDoc(d, text) -- the declaration with a doc comment (printed as `//` lines above it).\nexport function withDoc(d: MDecl, text: string): MDecl {\n  return match (d) {\n    MDFn(f) => MDFn(MFnDecl {\n      name: f.name,\n      exported: f.exported,\n      typeParams: f.typeParams,\n      params: f.params,\n      returns: f.returns,\n      body: f.body,\n      doc: text,\n    }),\n    MDConst(c) => MDConst(MConstDecl {\n      name: c.name,\n      exported: c.exported,\n      ty: c.ty,\n      value: c.value,\n      doc: text,\n    }),\n    MDRecord(r) => MDRecord(MRecordDecl {\n      name: r.name,\n      exported: r.exported,\n      typeParams: r.typeParams,\n      fields: r.fields,\n      doc: text,\n    }),\n    MDUnion(u) => MDUnion(MUnionDecl {\n      name: u.name,\n      exported: u.exported,\n      typeParams: u.typeParams,\n      variants: u.variants,\n      doc: text,\n    }),\n    MDClass(c) => MDClass(MClassDecl {\n      name: c.name,\n      exported: c.exported,\n      typeParams: c.typeParams,\n      fields: c.fields,\n      ctor: c.ctor,\n      methods: c.methods,\n      doc: text,\n    }),\n  };\n}\n\n// ---- output builders ------------------------------------------------------------------------------------------------\n\nexport function importFrom(names: string[], source: string): MImport {\n  return MImport { names: names, source: source };\n}\n\nexport function diagError(at: MRef, message: string): MDiagnostic {\n  return MDiagnostic { severity: MError, message: message, at: at };\n}\n\nexport function diagWarning(at: MRef, message: string): MDiagnostic {\n  return MDiagnostic { severity: MWarning, message: message, at: at };\n}\n\nexport function emptyOutput(): Output {\n  return Output { imports: [], decls: [], diagnostics: [] };\n}\n\n// output(decls) -- an Output with these declarations and nothing else.\nexport function output(decls: MDecl[]): Output {\n  return Output { imports: [], decls: decls, diagnostics: [] };\n}\n\n// withImports / withDiagnostics -- the same Output with the lists replaced.\nexport function withImports(o: Output, imports: MImport[]): Output {\n  return Output { imports: imports, decls: o.decls, diagnostics: o.diagnostics };\n}\n\nexport function withDiagnostics(o: Output, diagnostics: MDiagnostic[]): Output {\n  return Output { imports: o.imports, decls: o.decls, diagnostics: diagnostics };\n}\n\n// hasErrors(o) -- true when some diagnostic is an error (the compiler then discards the declarations). O(diagnostics).\nexport function hasErrors(o: Output): bool {\n  for (const d of o.diagnostics) {\n    const isErr = match (d.severity) {\n      MError => true,\n      MWarning => false,\n    };\n    if (isErr) {\n      return true;\n    }\n  }\n  return false;\n}\n" });
  out.push(SourceFile { path: "$stdlib/metajson.or", text: "// std:metajson -- the stable JSON encoding of `std:metacore`'s `Input` and `Output` (ADR-0046 \xc2\xa73, slice S3). Import\n// `std:meta`, which re-exports this module.\n//\n// UNSTABLE until ADR-0046 is fully implemented.\n//\n// The compiler's processor harness (S5) reads an encoded `Input` from stdin and writes an encoded `Output` to\n// stdout; the compiler side (S4) reads the `Output` back. Both directions use this module.\n//\n//   * Pure: builds on `std:json` (integers only; floats travel as text, see `MCFloat`). No grants, no I/O.\n//   * Deterministic and stable: object keys are written in a FIXED order (the order of the field lists in\n//     `std:metacore`; every union value is an object with the tag `\"k\"` first), arrays keep their order, nothing\n//     depends on time, paths or memory addresses. The same value always encodes to the same bytes (compact JSON of\n//     `std:json.stringify`). The envelope carries `\"format\"` and `\"version\"` (1).\n//   * Decoding is strict and TOTAL: wrong format/version, a missing key, a wrong kind of value, an unknown tag or\n//     nesting deeper than 200 (the `std:json` limit) give `Err(message)` with the path of the offending value (for\n//     example `.decls[0].fields[1].ty: unknown type kind \"x\"`). It never traps. Key order and unknown extra keys are\n//     accepted on input.\n//\n// Complexity: O(size of the value) time and allocation for encoding and decoding (plus the JSON parse).\n\nimport {\n  Json, JField, JNull, JBool, JNum, JStr, JArr, JObj, field, parse, stringify, get, formatError,\n} from \"std:json/legacy\";\nimport {\n  MRef, MConst, MCBool, MCInt, MCFloat, MCString, MCTag, MCArray, MCNone, MCSome, MType, MNamed,\n  MArray, MOption, MResult, MFn, MUnion, MVariant, MParam, MArg, MAnnotation, MContractKind,\n  MRequires, MEnsures, MInvariant, MDecreases, MRule, MContract, MDeclKind, MKRecord, MKUnion,\n  MKAlias, MKClass, MKInterface, MKFunction, MKConst, MFieldView, MMethodView, MDeclView, MShape,\n  MSRecord, MSUnion, MSAlias, MSOpaque, MTypeShape, Input, MUnOp, OpNeg, OpNot, OpBitNot, MBinOp,\n  OpAdd, OpSub, OpMul, OpDiv, OpRem, OpEq, OpNe, OpLt, OpLe, OpGt, OpGe, OpAnd, OpOr, OpBitAnd,\n  OpBitOr, OpBitXor, OpShl, OpShr, MPattern, MPWild, MPBind, MPVariant, MPLit, MExpr, MEInt,\n  MEFloat, MEString, MEBool, MEName, MECall, MEMethod, MEField, MEIndex, MERecord, MEArray, MEUnary,\n  MEBinary, MEMatch, METry, MECond, MFieldInit, MArm, MStmt, MSConst, MSLet, MSAssign, MSReturn,\n  MSExpr, MSIf, MSWhile, MSForOf, MSMatch, MFnDecl, MConstDecl, MRecordDecl, MUnionDecl,\n  MClassField, MCtorDecl, MClassDecl, MDecl, MDFn, MDConst, MDRecord, MDUnion, MDClass, MImport,\n  MSeverity, MError, MWarning, MDiagnostic, Output,\n} from \"std:metacore\";\n\nconst FORMAT_VERSION: int = 1;\nconst INPUT_FORMAT: string = \"orin.meta.input\";\nconst OUTPUT_FORMAT: string = \"orin.meta.output\";\n\n// ---- encoding helpers -----------------------------------------------------------------------------------------------\n\nfunction obj(fields: JField[]): Json {\n  return JObj(fields);\n}\n\n// A union value: {\"k\": kind, ...fields}.\nfunction tagged(kind: string, fields: JField[]): Json {\n  let all: JField[] = [field(\"k\", JStr(kind))];\n  for (const f of fields) {\n    all.push(f);\n  }\n  return JObj(all);\n}\n\nfunction list<T>(xs: T[], f: (x: T) => Json): Json {\n  let out: Json[] = [];\n  for (const x of xs) {\n    out.push(f(x));\n  }\n  return JArr(out);\n}\n\nfunction strs(xs: string[]): Json {\n  let out: Json[] = [];\n  for (const x of xs) {\n    out.push(JStr(x));\n  }\n  return JArr(out);\n}\n\nfunction opt<T>(o: Option<T>, f: (x: T) => Json): Json {\n  return match (o) {\n    Some(x) => f(x),\n    None => JNull,\n  };\n}\n\n// ---- encoding: input side -------------------------------------------------------------------------------------------\n\nfunction encRef(r: MRef): Json {\n  return JNum(r.id);\n}\n\nfunction encConst(c: MConst): Json {\n  return match (c) {\n    MCBool(b) => tagged(\"bool\", [field(\"v\", JBool(b))]),\n    MCInt(n) => tagged(\"int\", [field(\"v\", JNum(n))]),\n    MCFloat(s) => tagged(\"float\", [field(\"v\", JStr(s))]),\n    MCString(s) => tagged(\"string\", [field(\"v\", JStr(s))]),\n    MCTag(s) => tagged(\"tag\", [field(\"v\", JStr(s))]),\n    MCArray(xs) => tagged(\"array\", [field(\"v\", list(xs, x => encConst(x)))]),\n    MCNone => tagged(\"none\", []),\n    MCSome(x) => tagged(\"some\", [field(\"v\", encConst(x))]),\n  };\n}\n\nfunction encType(t: MType): Json {\n  return match (t) {\n    MNamed(n, args) => tagged(\n      \"named\",\n      [field(\"name\", JStr(n)), field(\"args\", list(args, a => encType(a)))],\n    ),\n    MArray(e) => tagged(\"array\", [field(\"elem\", encType(e))]),\n    MOption(e) => tagged(\"option\", [field(\"elem\", encType(e))]),\n    MResult(o, e) => tagged(\"result\", [field(\"ok\", encType(o)), field(\"err\", encType(e))]),\n    MFn(ps, r) => tagged(\n      \"fn\",\n      [field(\"params\", list(ps, p => encType(p))), field(\"returns\", encType(r))],\n    ),\n    MUnion(vs) => tagged(\"union\", [field(\"variants\", list(vs, v => encVariant(v)))]),\n  };\n}\n\nfunction encVariant(v: MVariant): Json {\n  return obj([field(\"name\", JStr(v.name)), field(\"payload\", list(v.payload, t => encType(t)))]);\n}\n\nfunction encParam(p: MParam): Json {\n  return obj([field(\"name\", JStr(p.name)), field(\"ty\", encType(p.ty))]);\n}\n\nfunction encArg(a: MArg): Json {\n  return obj([field(\"name\", JStr(a.name)), field(\"value\", encConst(a.value))]);\n}\n\nfunction encAnnotation(a: MAnnotation): Json {\n  return obj([\n    field(\"source\", JStr(a.source)),\n    field(\"name\", JStr(a.name)),\n    field(\"args\", list(a.args, x => encArg(x))),\n  ]);\n}\n\nfunction contractKindName(k: MContractKind): string {\n  return match (k) {\n    MRequires => \"requires\",\n    MEnsures => \"ensures\",\n    MInvariant => \"invariant\",\n    MDecreases => \"decreases\",\n    MRule => \"rule\",\n  };\n}\n\nfunction encContract(c: MContract): Json {\n  return obj([field(\"kind\", JStr(contractKindName(c.kind))), field(\"text\", JStr(c.text))]);\n}\n\nfunction declKindName(k: MDeclKind): string {\n  return match (k) {\n    MKRecord => \"record\",\n    MKUnion => \"union\",\n    MKAlias => \"alias\",\n    MKClass => \"class\",\n    MKInterface => \"interface\",\n    MKFunction => \"function\",\n    MKConst => \"const\",\n  };\n}\n\nfunction encFieldView(f: MFieldView): Json {\n  return obj([\n    field(\"ref\", encRef(f.ref)),\n    field(\"name\", JStr(f.name)),\n    field(\"ty\", encType(f.ty)),\n    field(\"exported\", JBool(f.exported)),\n    field(\"annotations\", list(f.annotations, a => encAnnotation(a))),\n  ]);\n}\n\nfunction encMethodView(m: MMethodView): Json {\n  return obj([\n    field(\"ref\", encRef(m.ref)),\n    field(\"name\", JStr(m.name)),\n    field(\"exported\", JBool(m.exported)),\n    field(\"typeParams\", strs(m.typeParams)),\n    field(\"params\", list(m.params, p => encParam(p))),\n    field(\"returns\", encType(m.returns)),\n    field(\"doc\", JStr(m.doc)),\n    field(\"annotations\", list(m.annotations, a => encAnnotation(a))),\n    field(\"contracts\", list(m.contracts, c => encContract(c))),\n  ]);\n}\n\nfunction encDeclView(d: MDeclView): Json {\n  return obj([\n    field(\"ref\", encRef(d.ref)),\n    field(\"kind\", JStr(declKindName(d.kind))),\n    field(\"name\", JStr(d.name)),\n    field(\"exported\", JBool(d.exported)),\n    field(\"typeParams\", strs(d.typeParams)),\n    field(\"doc\", JStr(d.doc)),\n    field(\"annotations\", list(d.annotations, a => encAnnotation(a))),\n    field(\"contracts\", list(d.contracts, c => encContract(c))),\n    field(\"fields\", list(d.fields, f => encFieldView(f))),\n    field(\"ctorParams\", list(d.ctorParams, p => encParam(p))),\n    field(\"methods\", list(d.methods, m => encMethodView(m))),\n    field(\"variants\", list(d.variants, v => encVariant(v))),\n    field(\"params\", list(d.params, p => encParam(p))),\n    field(\"ty\", opt(d.ty, t => encType(t))),\n  ]);\n}\n\nfunction encShape(s: MShape): Json {\n  return match (s) {\n    MSRecord(fs) => tagged(\"record\", [field(\"fields\", list(fs, f => encFieldView(f)))]),\n    MSUnion(vs) => tagged(\"union\", [field(\"variants\", list(vs, v => encVariant(v)))]),\n    MSAlias(t) => tagged(\"alias\", [field(\"ty\", encType(t))]),\n    MSOpaque => tagged(\"opaque\", []),\n  };\n}\n\nfunction encTypeShape(t: MTypeShape): Json {\n  return obj([\n    field(\"name\", JStr(t.name)),\n    field(\"source\", JStr(t.source)),\n    field(\"typeParams\", strs(t.typeParams)),\n    field(\"shape\", encShape(t.shape)),\n  ]);\n}\n\n// inputToJson(i: Input): Json -- the document of `encodeInput` as a `Json` value. O(size).\nexport function inputToJson(i: Input): Json {\n  return obj([\n    field(\"format\", JStr(INPUT_FORMAT)),\n    field(\"version\", JNum(FORMAT_VERSION)),\n    field(\"modulePath\", JStr(i.modulePath)),\n    field(\"annotation\", JStr(i.annotation)),\n    field(\"freshBase\", JNum(i.freshBase)),\n    field(\"decls\", list(i.decls, d => encDeclView(d))),\n    field(\"types\", list(i.types, t => encTypeShape(t))),\n  ]);\n}\n\n// encodeInput(i: Input): string -- compact, deterministic JSON text. O(size).\nexport function encodeInput(i: Input): string {\n  return stringify(inputToJson(i));\n}\n\n// ---- encoding: output side ------------------------------------------------------------------------------------------\n\nfunction unOpName(op: MUnOp): string {\n  return match (op) {\n    OpNeg => \"neg\",\n    OpNot => \"not\",\n    OpBitNot => \"bitnot\",\n  };\n}\n\nfunction binOpName(op: MBinOp): string {\n  return match (op) {\n    OpAdd => \"+\",\n    OpSub => \"-\",\n    OpMul => \"*\",\n    OpDiv => \"/\",\n    OpRem => \"%\",\n    OpEq => \"==\",\n    OpNe => \"!=\",\n    OpLt => \"<\",\n    OpLe => \"<=\",\n    OpGt => \">\",\n    OpGe => \">=\",\n    OpAnd => \"&&\",\n    OpOr => \"||\",\n    OpBitAnd => \"&\",\n    OpBitOr => \"|\",\n    OpBitXor => \"^\",\n    OpShl => \"<<\",\n    OpShr => \">>\",\n  };\n}\n\nfunction encPattern(p: MPattern): Json {\n  return match (p) {\n    MPWild => tagged(\"wild\", []),\n    MPBind(n) => tagged(\"bind\", [field(\"name\", JStr(n))]),\n    MPVariant(n, subs) => tagged(\n      \"variant\",\n      [field(\"name\", JStr(n)), field(\"subs\", list(subs, s => encPattern(s)))],\n    ),\n    MPLit(c) => tagged(\"lit\", [field(\"value\", encConst(c))]),\n  };\n}\n\nfunction encExpr(e: MExpr): Json {\n  return match (e) {\n    MEInt(n) => tagged(\"int\", [field(\"v\", JNum(n))]),\n    MEFloat(s) => tagged(\"float\", [field(\"v\", JStr(s))]),\n    MEString(s) => tagged(\"string\", [field(\"v\", JStr(s))]),\n    MEBool(b) => tagged(\"bool\", [field(\"v\", JBool(b))]),\n    MEName(n) => tagged(\"name\", [field(\"name\", JStr(n))]),\n    MECall(f, targs, args) => tagged(\n      \"call\",\n      [\n        field(\"callee\", encExpr(f)),\n        field(\"typeArgs\", list(targs, t => encType(t))),\n        field(\"args\", list(args, a => encExpr(a))),\n      ],\n    ),\n    MEMethod(r, n, args) => tagged(\n      \"method\",\n      [\n        field(\"recv\", encExpr(r)),\n        field(\"name\", JStr(n)),\n        field(\"args\", list(args, a => encExpr(a))),\n      ],\n    ),\n    MEField(r, n) => tagged(\"field\", [field(\"recv\", encExpr(r)), field(\"name\", JStr(n))]),\n    MEIndex(r, i) => tagged(\"index\", [field(\"recv\", encExpr(r)), field(\"index\", encExpr(i))]),\n    MERecord(n, inits) => tagged(\n      \"record\",\n      [field(\"type\", JStr(n)), field(\"fields\", list(inits, i => encInit(i)))],\n    ),\n    MEArray(xs) => tagged(\"array\", [field(\"items\", list(xs, x => encExpr(x)))]),\n    MEUnary(op, x) => tagged(\n      \"unary\",\n      [field(\"op\", JStr(unOpName(op))), field(\"operand\", encExpr(x))],\n    ),\n    MEBinary(op, a, b) => tagged(\n      \"binary\",\n      [field(\"op\", JStr(binOpName(op))), field(\"left\", encExpr(a)), field(\"right\", encExpr(b))],\n    ),\n    MEMatch(s, arms) => tagged(\n      \"match\",\n      [field(\"scrutinee\", encExpr(s)), field(\"arms\", list(arms, a => encArm(a)))],\n    ),\n    METry(x) => tagged(\"try\", [field(\"operand\", encExpr(x))]),\n    MECond(c, a, b) => tagged(\n      \"cond\",\n      [field(\"cond\", encExpr(c)), field(\"then\", encExpr(a)), field(\"else\", encExpr(b))],\n    ),\n  };\n}\n\nfunction encInit(i: MFieldInit): Json {\n  return obj([field(\"name\", JStr(i.name)), field(\"value\", encExpr(i.value))]);\n}\n\nfunction encArm(a: MArm): Json {\n  return obj([\n    field(\"pattern\", encPattern(a.pattern)),\n    field(\"stmts\", list(a.stmts, s => encStmt(s))),\n    field(\"value\", opt(a.value, v => encExpr(v))),\n  ]);\n}\n\nfunction encStmt(s: MStmt): Json {\n  return match (s) {\n    MSConst(n, t, v) => tagged(\n      \"const\",\n      [field(\"name\", JStr(n)), field(\"ty\", opt(t, x => encType(x))), field(\"value\", encExpr(v))],\n    ),\n    MSLet(n, t, v) => tagged(\n      \"let\",\n      [field(\"name\", JStr(n)), field(\"ty\", opt(t, x => encType(x))), field(\"value\", encExpr(v))],\n    ),\n    MSAssign(t, v) => tagged(\"assign\", [field(\"target\", encExpr(t)), field(\"value\", encExpr(v))]),\n    MSReturn(v) => tagged(\"return\", [field(\"value\", opt(v, x => encExpr(x)))]),\n    MSExpr(x) => tagged(\"expr\", [field(\"expr\", encExpr(x))]),\n    MSIf(c, a, b) => tagged(\n      \"if\",\n      [\n        field(\"cond\", encExpr(c)),\n        field(\"then\", list(a, x => encStmt(x))),\n        field(\"else\", list(b, x => encStmt(x))),\n      ],\n    ),\n    MSWhile(c, b) => tagged(\n      \"while\",\n      [field(\"cond\", encExpr(c)), field(\"body\", list(b, x => encStmt(x)))],\n    ),\n    MSForOf(n, it, b) => tagged(\n      \"forof\",\n      [field(\"var\", JStr(n)), field(\"iter\", encExpr(it)), field(\"body\", list(b, x => encStmt(x)))],\n    ),\n    MSMatch(x, arms) => tagged(\n      \"match\",\n      [field(\"scrutinee\", encExpr(x)), field(\"arms\", list(arms, a => encArm(a)))],\n    ),\n  };\n}\n\nfunction encFnDecl(f: MFnDecl): Json {\n  return obj([\n    field(\"name\", JStr(f.name)),\n    field(\"exported\", JBool(f.exported)),\n    field(\"typeParams\", strs(f.typeParams)),\n    field(\"params\", list(f.params, p => encParam(p))),\n    field(\"returns\", encType(f.returns)),\n    field(\"body\", list(f.body, s => encStmt(s))),\n    field(\"doc\", JStr(f.doc)),\n  ]);\n}\n\nfunction encClassField(f: MClassField): Json {\n  return obj([\n    field(\"name\", JStr(f.name)),\n    field(\"ty\", encType(f.ty)),\n    field(\"exported\", JBool(f.exported)),\n  ]);\n}\n\nfunction encCtor(c: MCtorDecl): Json {\n  return obj([\n    field(\"params\", list(c.params, p => encParam(p))),\n    field(\"body\", list(c.body, s => encStmt(s))),\n  ]);\n}\n\nfunction encConstDecl(c: MConstDecl): Json {\n  return obj([\n    field(\"name\", JStr(c.name)),\n    field(\"exported\", JBool(c.exported)),\n    field(\"ty\", encType(c.ty)),\n    field(\"value\", encExpr(c.value)),\n    field(\"doc\", JStr(c.doc)),\n  ]);\n}\n\nfunction encRecordDecl(r: MRecordDecl): Json {\n  return obj([\n    field(\"name\", JStr(r.name)),\n    field(\"exported\", JBool(r.exported)),\n    field(\"typeParams\", strs(r.typeParams)),\n    field(\"fields\", list(r.fields, p => encParam(p))),\n    field(\"doc\", JStr(r.doc)),\n  ]);\n}\n\nfunction encUnionDecl(u: MUnionDecl): Json {\n  return obj([\n    field(\"name\", JStr(u.name)),\n    field(\"exported\", JBool(u.exported)),\n    field(\"typeParams\", strs(u.typeParams)),\n    field(\"variants\", list(u.variants, v => encVariant(v))),\n    field(\"doc\", JStr(u.doc)),\n  ]);\n}\n\nfunction encClassDecl(c: MClassDecl): Json {\n  return obj([\n    field(\"name\", JStr(c.name)),\n    field(\"exported\", JBool(c.exported)),\n    field(\"typeParams\", strs(c.typeParams)),\n    field(\"fields\", list(c.fields, f => encClassField(f))),\n    field(\"ctor\", opt(c.ctor, k => encCtor(k))),\n    field(\"methods\", list(c.methods, m => encFnDecl(m))),\n    field(\"doc\", JStr(c.doc)),\n  ]);\n}\n\nfunction encDecl(d: MDecl): Json {\n  return match (d) {\n    MDFn(f) => tagged(\"fn\", [field(\"decl\", encFnDecl(f))]),\n    MDConst(c) => tagged(\"const\", [field(\"decl\", encConstDecl(c))]),\n    MDRecord(r) => tagged(\"record\", [field(\"decl\", encRecordDecl(r))]),\n    MDUnion(u) => tagged(\"union\", [field(\"decl\", encUnionDecl(u))]),\n    MDClass(c) => tagged(\"class\", [field(\"decl\", encClassDecl(c))]),\n  };\n}\n\nfunction encImport(i: MImport): Json {\n  return obj([field(\"names\", strs(i.names)), field(\"source\", JStr(i.source))]);\n}\n\nfunction encDiagnostic(d: MDiagnostic): Json {\n  const sev = match (d.severity) {\n    MError => \"error\",\n    MWarning => \"warning\",\n  };\n  return obj([\n    field(\"severity\", JStr(sev)),\n    field(\"message\", JStr(d.message)),\n    field(\"at\", encRef(d.at)),\n  ]);\n}\n\n// outputToJson(o: Output): Json / encodeOutput(o: Output): string -- like the input side. O(size).\nexport function outputToJson(o: Output): Json {\n  return obj([\n    field(\"format\", JStr(OUTPUT_FORMAT)),\n    field(\"version\", JNum(FORMAT_VERSION)),\n    field(\"imports\", list(o.imports, i => encImport(i))),\n    field(\"decls\", list(o.decls, d => encDecl(d))),\n    field(\"diagnostics\", list(o.diagnostics, d => encDiagnostic(d))),\n  ]);\n}\n\nexport function encodeOutput(o: Output): string {\n  return stringify(outputToJson(o));\n}\n\n// ---- decoding helpers -----------------------------------------------------------------------------------------------\n\nfunction at(path: string, msg: string): string {\n  return path == \"\" ? msg : path + \": \" + msg;\n}\n\nfunction member(j: Json, k: string, path: string): Result<Json, string> {\n  return match (j) {\n    JObj(_) => match (get(j, k)) {\n      Some(v) => Ok(v),\n      None => Err(at(path, \"missing key `\" + k + \"`\")),\n    },\n    _ => Err(at(path, \"expected an object\")),\n  };\n}\n\nfunction dStr(j: Json, k: string, path: string): Result<string, string> {\n  const v = member(j, k, path)?;\n  return match (v) {\n    JStr(s) => Ok(s),\n    _ => Err(at(path + \".\" + k, \"expected a string\")),\n  };\n}\n\nfunction dInt(j: Json, k: string, path: string): Result<int, string> {\n  const v = member(j, k, path)?;\n  return match (v) {\n    JNum(n) => Ok(n),\n    _ => Err(at(path + \".\" + k, \"expected an integer\")),\n  };\n}\n\nfunction dBool(j: Json, k: string, path: string): Result<bool, string> {\n  const v = member(j, k, path)?;\n  return match (v) {\n    JBool(b) => Ok(b),\n    _ => Err(at(path + \".\" + k, \"expected a boolean\")),\n  };\n}\n\n// The members of the array at key `k`, each decoded by `f` with the path `path.k[i]`.\nfunction dList<T>(\n  j: Json,\n  k: string,\n  path: string,\n  f: (x: Json, p: string) => Result<T, string>,\n): Result<T[], string> {\n  const v = member(j, k, path)?;\n  return match (v) {\n    JArr(items) => decodeItems(items, path + \".\" + k, f),\n    _ => Err(at(path + \".\" + k, \"expected an array\")),\n  };\n}\n\nfunction decodeItems<T>(\n  items: Json[],\n  path: string,\n  f: (x: Json, p: string) => Result<T, string>,\n): Result<T[], string> {\n  let out: T[] = [];\n  let i: usize = 0;\n  while (i < items.length) {\n    const v = f(items[i], path + \"[\" + i.toString() + \"]\")?;\n    out.push(v);\n    i += 1;\n  }\n  return Ok(out);\n}\n\nfunction decString(x: Json, p: string): Result<string, string> {\n  return match (x) {\n    JStr(s) => Ok(s),\n    _ => Err(at(p, \"expected a string\")),\n  };\n}\n\nfunction dStrs(j: Json, k: string, path: string): Result<string[], string> {\n  return dList(j, k, path, (x, p) => decString(x, p));\n}\n\n// An optional member: absent or null is None.\nfunction dOpt<T>(\n  j: Json,\n  k: string,\n  path: string,\n  f: (x: Json, p: string) => Result<T, string>,\n): Result<Option<T>, string> {\n  const v = member(j, k, path)?;\n  return match (v) {\n    JNull => Ok(None),\n    _ => {\n      const x = f(v, path + \".\" + k)?;\n      return Ok(Some(x));\n    },\n  };\n}\n\nfunction dKind(j: Json, path: string): Result<string, string> {\n  return dStr(j, \"k\", path);\n}\n\nfunction badKind(what: string, kind: string, path: string): string {\n  return at(path, \"unknown \" + what + \" kind \\\"\" + kind + \"\\\"\");\n}\n\n// ---- decoding: input side -------------------------------------------------------------------------------------------\n\nfunction decRef(j: Json, k: string, path: string): Result<MRef, string> {\n  const n = dInt(j, k, path)?;\n  return Ok(MRef { id: n });\n}\n\nfunction decConst(j: Json, path: string): Result<MConst, string> {\n  const k = dKind(j, path)?;\n  if (k == \"bool\") {\n    return Ok(MCBool(dBool(j, \"v\", path)?));\n  }\n  if (k == \"int\") {\n    return Ok(MCInt(dInt(j, \"v\", path)?));\n  }\n  if (k == \"float\") {\n    return Ok(MCFloat(dStr(j, \"v\", path)?));\n  }\n  if (k == \"string\") {\n    return Ok(MCString(dStr(j, \"v\", path)?));\n  }\n  if (k == \"tag\") {\n    return Ok(MCTag(dStr(j, \"v\", path)?));\n  }\n  if (k == \"array\") {\n    return Ok(MCArray(dList(j, \"v\", path, (x, p) => decConst(x, p))?));\n  }\n  if (k == \"none\") {\n    return Ok(MCNone);\n  }\n  if (k == \"some\") {\n    const v = member(j, \"v\", path)?;\n    return Ok(MCSome(decConst(v, path + \".v\")?));\n  }\n  return Err(badKind(\"constant\", k, path));\n}\n\nfunction dType(j: Json, k: string, path: string): Result<MType, string> {\n  return decType(member(j, k, path)?, path + \".\" + k);\n}\n\nfunction decType(j: Json, path: string): Result<MType, string> {\n  const k = dKind(j, path)?;\n  if (k == \"named\") {\n    const n = dStr(j, \"name\", path)?;\n    return Ok(MNamed(n, dList(j, \"args\", path, (x, p) => decType(x, p))?));\n  }\n  if (k == \"array\") {\n    return Ok(MArray(dType(j, \"elem\", path)?));\n  }\n  if (k == \"option\") {\n    return Ok(MOption(dType(j, \"elem\", path)?));\n  }\n  if (k == \"result\") {\n    const ok = dType(j, \"ok\", path)?;\n    return Ok(MResult(ok, dType(j, \"err\", path)?));\n  }\n  if (k == \"fn\") {\n    const ps = dList(j, \"params\", path, (x, p) => decType(x, p))?;\n    return Ok(MFn(ps, dType(j, \"returns\", path)?));\n  }\n  if (k == \"union\") {\n    return Ok(MUnion(dList(j, \"variants\", path, (x, p) => decVariant(x, p))?));\n  }\n  return Err(badKind(\"type\", k, path));\n}\n\nfunction decVariant(j: Json, path: string): Result<MVariant, string> {\n  const n = dStr(j, \"name\", path)?;\n  const payload = dList(j, \"payload\", path, (x, p) => decType(x, p))?;\n  return Ok(MVariant { name: n, payload: payload });\n}\n\nfunction decParam(j: Json, path: string): Result<MParam, string> {\n  const n = dStr(j, \"name\", path)?;\n  return Ok(MParam { name: n, ty: dType(j, \"ty\", path)? });\n}\n\nfunction decArg(j: Json, path: string): Result<MArg, string> {\n  const n = dStr(j, \"name\", path)?;\n  const v = decConst(member(j, \"value\", path)?, path + \".value\")?;\n  return Ok(MArg { name: n, value: v });\n}\n\nfunction decAnnotation(j: Json, path: string): Result<MAnnotation, string> {\n  const s = dStr(j, \"source\", path)?;\n  const n = dStr(j, \"name\", path)?;\n  const args = dList(j, \"args\", path, (x, p) => decArg(x, p))?;\n  return Ok(MAnnotation { source: s, name: n, args: args });\n}\n\nfunction decContract(j: Json, path: string): Result<MContract, string> {\n  const k = dStr(j, \"kind\", path)?;\n  const text = dStr(j, \"text\", path)?;\n  if (k == \"requires\") {\n    return Ok(MContract { kind: MRequires, text: text });\n  }\n  if (k == \"ensures\") {\n    return Ok(MContract { kind: MEnsures, text: text });\n  }\n  if (k == \"invariant\") {\n    return Ok(MContract { kind: MInvariant, text: text });\n  }\n  if (k == \"decreases\") {\n    return Ok(MContract { kind: MDecreases, text: text });\n  }\n  if (k == \"rule\") {\n    return Ok(MContract { kind: MRule, text: text });\n  }\n  return Err(at(path + \".kind\", \"unknown contract kind \\\"\" + k + \"\\\"\"));\n}\n\nfunction decDeclKind(k: string, path: string): Result<MDeclKind, string> {\n  if (k == \"record\") {\n    return Ok(MKRecord);\n  }\n  if (k == \"union\") {\n    return Ok(MKUnion);\n  }\n  if (k == \"alias\") {\n    return Ok(MKAlias);\n  }\n  if (k == \"class\") {\n    return Ok(MKClass);\n  }\n  if (k == \"interface\") {\n    return Ok(MKInterface);\n  }\n  if (k == \"function\") {\n    return Ok(MKFunction);\n  }\n  if (k == \"const\") {\n    return Ok(MKConst);\n  }\n  return Err(at(path + \".kind\", \"unknown declaration kind \\\"\" + k + \"\\\"\"));\n}\n\nfunction decFieldView(j: Json, path: string): Result<MFieldView, string> {\n  const r = decRef(j, \"ref\", path)?;\n  const n = dStr(j, \"name\", path)?;\n  const t = dType(j, \"ty\", path)?;\n  const e = dBool(j, \"exported\", path)?;\n  const anns = dList(j, \"annotations\", path, (x, p) => decAnnotation(x, p))?;\n  return Ok(MFieldView { ref: r, name: n, ty: t, exported: e, annotations: anns });\n}\n\nfunction decMethodView(j: Json, path: string): Result<MMethodView, string> {\n  const r = decRef(j, \"ref\", path)?;\n  const n = dStr(j, \"name\", path)?;\n  const e = dBool(j, \"exported\", path)?;\n  const tps = dStrs(j, \"typeParams\", path)?;\n  const ps = dList(j, \"params\", path, (x, p) => decParam(x, p))?;\n  const ret = dType(j, \"returns\", path)?;\n  const doc = dStr(j, \"doc\", path)?;\n  const anns = dList(j, \"annotations\", path, (x, p) => decAnnotation(x, p))?;\n  const cs = dList(j, \"contracts\", path, (x, p) => decContract(x, p))?;\n  return Ok(MMethodView {\n    ref: r,\n    name: n,\n    exported: e,\n    typeParams: tps,\n    params: ps,\n    returns: ret,\n    doc: doc,\n    annotations: anns,\n    contracts: cs,\n  });\n}\n\nfunction decDeclView(j: Json, path: string): Result<MDeclView, string> {\n  const r = decRef(j, \"ref\", path)?;\n  const kind = decDeclKind(dStr(j, \"kind\", path)?, path)?;\n  const n = dStr(j, \"name\", path)?;\n  const e = dBool(j, \"exported\", path)?;\n  const tps = dStrs(j, \"typeParams\", path)?;\n  const doc = dStr(j, \"doc\", path)?;\n  const anns = dList(j, \"annotations\", path, (x, p) => decAnnotation(x, p))?;\n  const cs = dList(j, \"contracts\", path, (x, p) => decContract(x, p))?;\n  const fs = dList(j, \"fields\", path, (x, p) => decFieldView(x, p))?;\n  const cps = dList(j, \"ctorParams\", path, (x, p) => decParam(x, p))?;\n  const ms = dList(j, \"methods\", path, (x, p) => decMethodView(x, p))?;\n  const vs = dList(j, \"variants\", path, (x, p) => decVariant(x, p))?;\n  const ps = dList(j, \"params\", path, (x, p) => decParam(x, p))?;\n  const t = dOpt(j, \"ty\", path, (x, p) => decType(x, p))?;\n  return Ok(MDeclView {\n    ref: r,\n    kind: kind,\n    name: n,\n    exported: e,\n    typeParams: tps,\n    doc: doc,\n    annotations: anns,\n    contracts: cs,\n    fields: fs,\n    ctorParams: cps,\n    methods: ms,\n    variants: vs,\n    params: ps,\n    ty: t,\n  });\n}\n\nfunction decShape(j: Json, path: string): Result<MShape, string> {\n  const k = dKind(j, path)?;\n  if (k == \"record\") {\n    return Ok(MSRecord(dList(j, \"fields\", path, (x, p) => decFieldView(x, p))?));\n  }\n  if (k == \"union\") {\n    return Ok(MSUnion(dList(j, \"variants\", path, (x, p) => decVariant(x, p))?));\n  }\n  if (k == \"alias\") {\n    return Ok(MSAlias(dType(j, \"ty\", path)?));\n  }\n  if (k == \"opaque\") {\n    return Ok(MSOpaque);\n  }\n  return Err(badKind(\"shape\", k, path));\n}\n\nfunction decTypeShape(j: Json, path: string): Result<MTypeShape, string> {\n  const n = dStr(j, \"name\", path)?;\n  const s = dStr(j, \"source\", path)?;\n  const tps = dStrs(j, \"typeParams\", path)?;\n  const shape = decShape(member(j, \"shape\", path)?, path + \".shape\")?;\n  return Ok(MTypeShape { name: n, source: s, typeParams: tps, shape: shape });\n}\n\nfunction checkEnvelope(j: Json, format: string): Result<bool, string> {\n  const f = dStr(j, \"format\", \"\")?;\n  if (f != format) {\n    return Err(\"format: expected \\\"\" + format + \"\\\", got \\\"\" + f + \"\\\"\");\n  }\n  const v = dInt(j, \"version\", \"\")?;\n  if (v != FORMAT_VERSION) {\n    return Err(\n      \"version: unsupported \" + v.toString() + \" (this std:meta reads \" + FORMAT_VERSION.toString()\n          + \")\",\n    );\n  }\n  return Ok(true);\n}\n\n// inputFromJson(j: Json): Result<Input, string> -- strict decoding of `inputToJson`; the message names the path of the\n// first problem. O(size).\nexport function inputFromJson(j: Json): Result<Input, string> {\n  checkEnvelope(j, INPUT_FORMAT)?;\n  const mp = dStr(j, \"modulePath\", \"\")?;\n  const an = dStr(j, \"annotation\", \"\")?;\n  const fb = dInt(j, \"freshBase\", \"\")?;\n  const ds = dList(j, \"decls\", \"\", (x, p) => decDeclView(x, p))?;\n  const ts = dList(j, \"types\", \"\", (x, p) => decTypeShape(x, p))?;\n  return Ok(Input { modulePath: mp, annotation: an, freshBase: fb, decls: ds, types: ts });\n}\n\n// decodeInput(text: string): Result<Input, string> -- parses the text with std:json (syntax errors are reported as\n// \"invalid JSON: line L, column C: ...\") and decodes it. Total: malformed input is an `Err`, never a trap. O(size).\nexport function decodeInput(text: string): Result<Input, string> {\n  const r = parse(text);\n  if (r.isErr()) {\n    return Err(\"invalid JSON: \" + formatError(r.unwrapErr()));\n  }\n  return inputFromJson(r.unwrap());\n}\n\n// ---- decoding: output side ------------------------------------------------------------------------------------------\n\nfunction decUnOp(s: string, path: string): Result<MUnOp, string> {\n  if (s == \"neg\") {\n    return Ok(OpNeg);\n  }\n  if (s == \"not\") {\n    return Ok(OpNot);\n  }\n  if (s == \"bitnot\") {\n    return Ok(OpBitNot);\n  }\n  return Err(at(path, \"unknown unary operator \\\"\" + s + \"\\\"\"));\n}\n\nfunction decBinOp(s: string, path: string): Result<MBinOp, string> {\n  if (s == \"+\") {\n    return Ok(OpAdd);\n  }\n  if (s == \"-\") {\n    return Ok(OpSub);\n  }\n  if (s == \"*\") {\n    return Ok(OpMul);\n  }\n  if (s == \"/\") {\n    return Ok(OpDiv);\n  }\n  if (s == \"%\") {\n    return Ok(OpRem);\n  }\n  if (s == \"==\") {\n    return Ok(OpEq);\n  }\n  if (s == \"!=\") {\n    return Ok(OpNe);\n  }\n  if (s == \"<\") {\n    return Ok(OpLt);\n  }\n  if (s == \"<=\") {\n    return Ok(OpLe);\n  }\n  if (s == \">\") {\n    return Ok(OpGt);\n  }\n  if (s == \">=\") {\n    return Ok(OpGe);\n  }\n  if (s == \"&&\") {\n    return Ok(OpAnd);\n  }\n  if (s == \"||\") {\n    return Ok(OpOr);\n  }\n  if (s == \"&\") {\n    return Ok(OpBitAnd);\n  }\n  if (s == \"|\") {\n    return Ok(OpBitOr);\n  }\n  if (s == \"^\") {\n    return Ok(OpBitXor);\n  }\n  if (s == \"<<\") {\n    return Ok(OpShl);\n  }\n  if (s == \">>\") {\n    return Ok(OpShr);\n  }\n  return Err(at(path, \"unknown binary operator \\\"\" + s + \"\\\"\"));\n}\n\nfunction decPattern(j: Json, path: string): Result<MPattern, string> {\n  const k = dKind(j, path)?;\n  if (k == \"wild\") {\n    return Ok(MPWild);\n  }\n  if (k == \"bind\") {\n    return Ok(MPBind(dStr(j, \"name\", path)?));\n  }\n  if (k == \"variant\") {\n    const n = dStr(j, \"name\", path)?;\n    const subs = dList(j, \"subs\", path, (x, p) => decPattern(x, p))?;\n    return Ok(MPVariant(n, subs));\n  }\n  if (k == \"lit\") {\n    return Ok(MPLit(decConst(member(j, \"value\", path)?, path + \".value\")?));\n  }\n  return Err(badKind(\"pattern\", k, path));\n}\n\nfunction dExpr(j: Json, k: string, path: string): Result<MExpr, string> {\n  return decExpr(member(j, k, path)?, path + \".\" + k);\n}\n\nfunction decExpr(j: Json, path: string): Result<MExpr, string> {\n  const k = dKind(j, path)?;\n  if (k == \"int\") {\n    return Ok(MEInt(dInt(j, \"v\", path)?));\n  }\n  if (k == \"float\") {\n    return Ok(MEFloat(dStr(j, \"v\", path)?));\n  }\n  if (k == \"string\") {\n    return Ok(MEString(dStr(j, \"v\", path)?));\n  }\n  if (k == \"bool\") {\n    return Ok(MEBool(dBool(j, \"v\", path)?));\n  }\n  if (k == \"name\") {\n    return Ok(MEName(dStr(j, \"name\", path)?));\n  }\n  if (k == \"call\") {\n    const f = dExpr(j, \"callee\", path)?;\n    const targs = dList(j, \"typeArgs\", path, (x, p) => decType(x, p))?;\n    const args = dList(j, \"args\", path, (x, p) => decExpr(x, p))?;\n    return Ok(MECall(f, targs, args));\n  }\n  if (k == \"method\") {\n    const r = dExpr(j, \"recv\", path)?;\n    const n = dStr(j, \"name\", path)?;\n    const args = dList(j, \"args\", path, (x, p) => decExpr(x, p))?;\n    return Ok(MEMethod(r, n, args));\n  }\n  if (k == \"field\") {\n    const r = dExpr(j, \"recv\", path)?;\n    return Ok(MEField(r, dStr(j, \"name\", path)?));\n  }\n  if (k == \"index\") {\n    const r = dExpr(j, \"recv\", path)?;\n    return Ok(MEIndex(r, dExpr(j, \"index\", path)?));\n  }\n  if (k == \"record\") {\n    const n = dStr(j, \"type\", path)?;\n    return Ok(MERecord(n, dList(j, \"fields\", path, (x, p) => decInit(x, p))?));\n  }\n  if (k == \"array\") {\n    return Ok(MEArray(dList(j, \"items\", path, (x, p) => decExpr(x, p))?));\n  }\n  if (k == \"unary\") {\n    const op = decUnOp(dStr(j, \"op\", path)?, path + \".op\")?;\n    return Ok(MEUnary(op, dExpr(j, \"operand\", path)?));\n  }\n  if (k == \"binary\") {\n    const op = decBinOp(dStr(j, \"op\", path)?, path + \".op\")?;\n    const a = dExpr(j, \"left\", path)?;\n    return Ok(MEBinary(op, a, dExpr(j, \"right\", path)?));\n  }\n  if (k == \"match\") {\n    const s = dExpr(j, \"scrutinee\", path)?;\n    return Ok(MEMatch(s, dList(j, \"arms\", path, (x, p) => decArm(x, p))?));\n  }\n  if (k == \"try\") {\n    return Ok(METry(dExpr(j, \"operand\", path)?));\n  }\n  if (k == \"cond\") {\n    const c = dExpr(j, \"cond\", path)?;\n    const a = dExpr(j, \"then\", path)?;\n    return Ok(MECond(c, a, dExpr(j, \"else\", path)?));\n  }\n  return Err(badKind(\"expression\", k, path));\n}\n\nfunction decInit(j: Json, path: string): Result<MFieldInit, string> {\n  const n = dStr(j, \"name\", path)?;\n  return Ok(MFieldInit { name: n, value: dExpr(j, \"value\", path)? });\n}\n\nfunction decArm(j: Json, path: string): Result<MArm, string> {\n  const p = decPattern(member(j, \"pattern\", path)?, path + \".pattern\")?;\n  const ss = dList(j, \"stmts\", path, (x, q) => decStmt(x, q))?;\n  const v = dOpt(j, \"value\", path, (x, q) => decExpr(x, q))?;\n  return Ok(MArm { pattern: p, stmts: ss, value: v });\n}\n\nfunction dBlock(j: Json, k: string, path: string): Result<MStmt[], string> {\n  return dList(j, k, path, (x, p) => decStmt(x, p));\n}\n\nfunction decStmt(j: Json, path: string): Result<MStmt, string> {\n  const k = dKind(j, path)?;\n  if (k == \"const\" || k == \"let\") {\n    const n = dStr(j, \"name\", path)?;\n    const t = dOpt(j, \"ty\", path, (x, p) => decType(x, p))?;\n    const v = dExpr(j, \"value\", path)?;\n    if (k == \"const\") {\n      return Ok(MSConst(n, t, v));\n    }\n    return Ok(MSLet(n, t, v));\n  }\n  if (k == \"assign\") {\n    const t = dExpr(j, \"target\", path)?;\n    return Ok(MSAssign(t, dExpr(j, \"value\", path)?));\n  }\n  if (k == \"return\") {\n    return Ok(MSReturn(dOpt(j, \"value\", path, (x, p) => decExpr(x, p))?));\n  }\n  if (k == \"expr\") {\n    return Ok(MSExpr(dExpr(j, \"expr\", path)?));\n  }\n  if (k == \"if\") {\n    const c = dExpr(j, \"cond\", path)?;\n    const a = dBlock(j, \"then\", path)?;\n    return Ok(MSIf(c, a, dBlock(j, \"else\", path)?));\n  }\n  if (k == \"while\") {\n    const c = dExpr(j, \"cond\", path)?;\n    return Ok(MSWhile(c, dBlock(j, \"body\", path)?));\n  }\n  if (k == \"forof\") {\n    const n = dStr(j, \"var\", path)?;\n    const it = dExpr(j, \"iter\", path)?;\n    return Ok(MSForOf(n, it, dBlock(j, \"body\", path)?));\n  }\n  if (k == \"match\") {\n    const s = dExpr(j, \"scrutinee\", path)?;\n    return Ok(MSMatch(s, dList(j, \"arms\", path, (x, p) => decArm(x, p))?));\n  }\n  return Err(badKind(\"statement\", k, path));\n}\n\nfunction decFnDecl(j: Json, path: string): Result<MFnDecl, string> {\n  const n = dStr(j, \"name\", path)?;\n  const e = dBool(j, \"exported\", path)?;\n  const tps = dStrs(j, \"typeParams\", path)?;\n  const ps = dList(j, \"params\", path, (x, p) => decParam(x, p))?;\n  const r = dType(j, \"returns\", path)?;\n  const body = dBlock(j, \"body\", path)?;\n  const doc = dStr(j, \"doc\", path)?;\n  return Ok(MFnDecl {\n    name: n,\n    exported: e,\n    typeParams: tps,\n    params: ps,\n    returns: r,\n    body: body,\n    doc: doc,\n  });\n}\n\nfunction decClassField(j: Json, path: string): Result<MClassField, string> {\n  const n = dStr(j, \"name\", path)?;\n  const t = dType(j, \"ty\", path)?;\n  return Ok(MClassField { name: n, ty: t, exported: dBool(j, \"exported\", path)? });\n}\n\nfunction decCtor(j: Json, path: string): Result<MCtorDecl, string> {\n  const ps = dList(j, \"params\", path, (x, p) => decParam(x, p))?;\n  return Ok(MCtorDecl { params: ps, body: dBlock(j, \"body\", path)? });\n}\n\nfunction decConstDecl(j: Json, path: string): Result<MConstDecl, string> {\n  const n = dStr(j, \"name\", path)?;\n  const e = dBool(j, \"exported\", path)?;\n  const t = dType(j, \"ty\", path)?;\n  const v = dExpr(j, \"value\", path)?;\n  const doc = dStr(j, \"doc\", path)?;\n  return Ok(MConstDecl { name: n, exported: e, ty: t, value: v, doc: doc });\n}\n\nfunction decRecordDecl(j: Json, path: string): Result<MRecordDecl, string> {\n  const n = dStr(j, \"name\", path)?;\n  const e = dBool(j, \"exported\", path)?;\n  const tps = dStrs(j, \"typeParams\", path)?;\n  const fs = dList(j, \"fields\", path, (x, q) => decParam(x, q))?;\n  const doc = dStr(j, \"doc\", path)?;\n  return Ok(MRecordDecl { name: n, exported: e, typeParams: tps, fields: fs, doc: doc });\n}\n\nfunction decUnionDecl(j: Json, path: string): Result<MUnionDecl, string> {\n  const n = dStr(j, \"name\", path)?;\n  const e = dBool(j, \"exported\", path)?;\n  const tps = dStrs(j, \"typeParams\", path)?;\n  const vs = dList(j, \"variants\", path, (x, q) => decVariant(x, q))?;\n  const doc = dStr(j, \"doc\", path)?;\n  return Ok(MUnionDecl { name: n, exported: e, typeParams: tps, variants: vs, doc: doc });\n}\n\nfunction decClassDecl(j: Json, path: string): Result<MClassDecl, string> {\n  const n = dStr(j, \"name\", path)?;\n  const e = dBool(j, \"exported\", path)?;\n  const tps = dStrs(j, \"typeParams\", path)?;\n  const fs = dList(j, \"fields\", path, (x, q) => decClassField(x, q))?;\n  const c = dOpt(j, \"ctor\", path, (x, q) => decCtor(x, q))?;\n  const ms = dList(j, \"methods\", path, (x, q) => decFnDecl(x, q))?;\n  const doc = dStr(j, \"doc\", path)?;\n  return Ok(MClassDecl {\n    name: n,\n    exported: e,\n    typeParams: tps,\n    fields: fs,\n    ctor: c,\n    methods: ms,\n    doc: doc,\n  });\n}\n\nfunction decDecl(j: Json, path: string): Result<MDecl, string> {\n  const k = dKind(j, path)?;\n  const body = member(j, \"decl\", path)?;\n  const p = path + \".decl\";\n  if (k == \"fn\") {\n    return Ok(MDFn(decFnDecl(body, p)?));\n  }\n  if (k == \"const\") {\n    return Ok(MDConst(decConstDecl(body, p)?));\n  }\n  if (k == \"record\") {\n    return Ok(MDRecord(decRecordDecl(body, p)?));\n  }\n  if (k == \"union\") {\n    return Ok(MDUnion(decUnionDecl(body, p)?));\n  }\n  if (k == \"class\") {\n    return Ok(MDClass(decClassDecl(body, p)?));\n  }\n  return Err(badKind(\"declaration\", k, path));\n}\n\nfunction decImport(j: Json, path: string): Result<MImport, string> {\n  const names = dStrs(j, \"names\", path)?;\n  return Ok(MImport { names: names, source: dStr(j, \"source\", path)? });\n}\n\nfunction decDiagnostic(j: Json, path: string): Result<MDiagnostic, string> {\n  const s = dStr(j, \"severity\", path)?;\n  const m = dStr(j, \"message\", path)?;\n  const r = decRef(j, \"at\", path)?;\n  if (s == \"error\") {\n    return Ok(MDiagnostic { severity: MError, message: m, at: r });\n  }\n  if (s == \"warning\") {\n    return Ok(MDiagnostic { severity: MWarning, message: m, at: r });\n  }\n  return Err(at(path + \".severity\", \"unknown severity \\\"\" + s + \"\\\"\"));\n}\n\n// outputFromJson / decodeOutput: like the input side. decodeOutput is what the compiler runs on the harness's stdout, so\n// a processor that wrote garbage is an `Err` with a path, not a crash. O(size).\nexport function outputFromJson(j: Json): Result<Output, string> {\n  checkEnvelope(j, OUTPUT_FORMAT)?;\n  const imports = dList(j, \"imports\", \"\", (x, p) => decImport(x, p))?;\n  const decls = dList(j, \"decls\", \"\", (x, p) => decDecl(x, p))?;\n  const diags = dList(j, \"diagnostics\", \"\", (x, p) => decDiagnostic(x, p))?;\n  return Ok(Output { imports: imports, decls: decls, diagnostics: diags });\n}\n\nexport function decodeOutput(text: string): Result<Output, string> {\n  const r = parse(text);\n  if (r.isErr()) {\n    return Err(\"invalid JSON: \" + formatError(r.unwrapErr()));\n  }\n  return outputFromJson(r.unwrap());\n}\n" });
  out.push(SourceFile { path: "$stdlib/net.or", text: "// std:net -- blocking TCP on the L0 network primitives (ADR-0033, ADR-0027, ADR-0025). UNSTABLE (ADR-0016).\n//\n// Authority. Every function that touches the network takes a handle as its first argument. The root `NetGrant` comes\n// from `main(host: Host)` through `useNet(host, net => ...)` (std:host). It is NARROWED, never widened:\n//   useListen(net, addr, port, l => ...)                       `l` may listen on `addr:port` only\n//   useConnect(net, hostPattern, portLo, portHi, c => ...)     `c` may connect / resolve only names matching the pattern\n// A host pattern is \"*\" (any), \"*.example.com\" (names below example.com) or an exact name or address, compared with the\n// text the program supplies (ASCII case-insensitive; see ADR-0033 for the limits). A request outside the scope is refused\n// with `Err(NetError)` (isDenied) by L0 before any system call. `ORIN_DENY=net` denies the whole family the same way.\n//\n// Resources. `Listener` and `Stream` are RESOURCE HANDLES (ADR-0025, like `File`): they exist only as the parameter of a\n// scope function (`withListener`, `withAccepted`, `withConnection`) and are closed when it returns, on every path; they\n// cannot be stored, copied, returned or captured by a closure (E0450-E0452 and the MIR verifier). Because a Stream\n// cannot be stored, state that belongs to one connection (the bytes read ahead, a parser) lives in a normal value\n// next to it: a `StreamReader`, an `http.RequestParser`.\n//\n// Time. Every call that can wait takes a `timeout: Duration` of std:time (clamped to 0 .. 3,600,000 ms); there is no\n// infinite wait. A timeout of `readUntil` / `readExact` / `sendAll` is a DEADLINE for the whole operation (a client that\n// sends one byte per `timeout - 1` ms does not extend it); `recv` / `send` / `accept` time out per call, and `connect`\n// bounds all the addresses of a name together. Every operation also has an ABSOLUTE form on a `Deadline` of std:time (an instant\n// on the monotonic clock, ADR-0017 Addendum B section 5), which several calls can share so that a whole exchange has one\n// deadline however many small reads and writes it takes: `recvUntil`, `sendUntil`, `sendAllUntil`, `readExactUntil`,\n// `readDelimitedUntil` of a `StreamReader`, `withAcceptedUntil`, `acceptDetachedUntil`, `withConnectionUntil`,\n// `useConnectionUntil`. A deadline that has passed still lets an operation that is ready complete once (a zero wait), never more.\n// Deadlines of your own are computed with `monotonicMillis(stream)`.\n//\n// Cancellation (ADR-0017 Addendum D). A task that is cancelled (`Scope.cancel()` / `CancelToken.cancel()` of std:task, also from\n// another task) stops waiting at once: a call blocked in accept, connect, recv or send returns `Err(NetError { kind: Cancelled })`\n// within milliseconds, and every later network call of that task\n// returns it without touching the socket (a pending connection or the bytes in the kernel stay where they are). Pure computation\n// is not interrupted: check `isCancelled()` of std:task. Name resolution is the exception: `getaddrinfo` runs to the OS\n// resolver's own end (see `resolve`), in `resolve` and in the lookup that `connect` does for a name; a literal address\n// is not looked up, and a cancelled task does not start a lookup.\n//\n// Blocking. One task serves one connection at a time. A server that serves many connections at once MOVES each accepted\n// connection into a task (ADR-0017 Addendum C): `spawnAccepted` starts a task for it; `acceptDetached` + a channel of\n// `Accepted` + `serveAccepted` feed a fixed pool of worker tasks (a bounded number of connections in service, the rest\n// wait in the channel and then in the kernel's backlog). A moved Stream leaves the accepting task and belongs to the\n// worker, which closes it; a slow client holds one worker up to the deadlines you set.\n//\n// Errors. Every failure is a `NetError { kind, code, offset }` (`NetErrorKind`: Denied, Closed, Timeout, Reset,\n// Cancelled, InvalidArgument, InvalidPeer, Os); `netErrorMessage(e)` is its text. Nothing here traps for an ordinary failure, except a\n// forged / stale / wrong-kind handle (the runtime traps: it is a bug, not a condition).\n//\n// Contract standard (ADR-0030): every class has an @Invariant, every public function states @Requires / @Ensures.\n\nimport { Bytes, fromArray, empty } from \"std:bytes\";\nimport { Scope, TaskHandle, spawn } from \"std:task\";\nimport { Deadline, Duration, MonotonicInstant } from \"std:time\";\nimport { MAX_MS, clampMs, waitUntilMs, portDigits, splitLines } from \"std:net/internal\";\nimport {\n  NetGrant, Listener, Stream, grantListen, grantConnect, grantRevoke, grantMove, grantAdoptStream, netListen, netAccept, netConnect, netStatus, netClose,\n  netPort, netNow, netRecv, netSend, netShutdown, netPeer, netResolve, netErrorText\n} from \"std:fsraw\";\n\nexport { NetGrant, Listener, Stream } from \"std:fsraw\";\n\n// ------------------------------------------------------------------------------------------------ errors\n\n// Why an operation of this module failed (rule 3.1.4: bare words describing the cause).\n//   Denied           refused by the grant's scope or by the host policy (`ORIN_DENY=net`)\n//   Closed           the peer closed the connection (L0 code 1001); from `recv` it is the end of the stream\n//   Timeout          nothing happened within the time given (1002)\n//   Cancelled        the cancellation token of the task's scope was set (1004); see \"Cancellation\" above\n//   Reset            the connection was reset or broke (1003)\n//   InvalidArgument  an argument was refused (EINVAL: a backlog of 0, an address that is not numeric, a port out of range)\n//   InvalidPeer      `parsePeer` was given text that is not `host:port` or `[ipv6]:port`\n//   Os               any other error of the operating system (ECONNREFUSED, EADDRINUSE, ENOENT for an unknown name ...);\n//                    `NetError.code` holds the errno\nexport type NetErrorKind = Denied | Closed | Timeout | Cancelled | Reset | InvalidArgument | InvalidPeer | Os;\n\n// An error of this module. `code` is the L0 code (1 permission denied, 1001 closed by the peer, 1002 timeout, 1003 reset, 1004 cancelled,\n// otherwise the errno of the OS) and 0 for an error that did not come from L0 (`InvalidPeer`). `offset` is the byte offset\n// into the text for `InvalidPeer` and 0 for every other kind. The text is `netErrorMessage(e)`.\nexport type NetError = { kind: NetErrorKind; code: int; offset: usize; };\n\nconst CODE_DENIED: int = 1;\nconst CODE_EOF: int = 1001;\nconst CODE_TIMEOUT: int = 1002;\nconst CODE_RESET: int = 1003;\nconst CODE_CANCELLED: int = 1004;\nconst CODE_INVALID: int = 22;\nconst CHUNK: usize = 65536;\n\n// kindOfCode(code): the kind of an L0 code. O(1).\nfunction kindOfCode(code: int): NetErrorKind {\n  if (code == CODE_DENIED) {\n    return Denied;\n  }\n  if (code == CODE_EOF) {\n    return Closed;\n  }\n  if (code == CODE_TIMEOUT) {\n    return Timeout;\n  }\n  if (code == CODE_RESET) {\n    return Reset;\n  }\n  if (code == CODE_CANCELLED) {\n    return Cancelled;\n  }\n  if (code == CODE_INVALID) {\n    return InvalidArgument;\n  }\n  return Os;\n}\n\n// netErrorFromCode(code): NetError -- the error of an L0 code, with its kind. O(1).\n@Ensures(result.code == code && result.offset == 0)\nexport function netErrorFromCode(code: int): NetError {\n  return NetError { kind: kindOfCode(code), code: code, offset: 0 };\n}\n\n// netErrorMessage(e): string -- a sentence for the error (the operating system's text for an L0 code). Never empty. O(1).\n@Ensures(result.length > 0)\nexport function netErrorMessage(e: NetError): string {\n  const text = match (e.kind) {\n    InvalidPeer => `invalid peer address at byte ${e.offset.toString()}`,\n    Cancelled => \"cancelled: the cancellation token of the task's scope was set\",\n    _ => netErrorText(e.code)\n  };\n  return text.length > 0 ? text : `network error ${e.code.toString()}`;\n}\n\n// isDenied(e): bool -- refused by the grant's scope or by the host policy (`e.kind` is Denied). O(1).\nexport function isDenied(e: NetError): bool {\n  return e.kind == Denied;\n}\n\n// isTimeout(e): bool -- nothing happened within the time given (Timeout). O(1).\nexport function isTimeout(e: NetError): bool {\n  return e.kind == Timeout;\n}\n\n// isReset(e): bool -- the connection was reset or broke (Reset). O(1).\nexport function isReset(e: NetError): bool {\n  return e.kind == Reset;\n}\n\n// isClosed(e): bool -- the peer closed the connection (Closed): from `recv` the end of the stream. O(1).\nexport function isClosed(e: NetError): bool {\n  return e.kind == Closed;\n}\n\n// isCancelled(e): bool -- the cancellation token of the task's scope was set (Cancelled). O(1).\nexport function isCancelled(e: NetError): bool {\n  return e.kind == Cancelled;\n}\n\n// ------------------------------------------------------------------------------------------------ peers\n\n// Peer = { host: string; port: int } -- the address of the other end of a stream: `host` is the numeric address, `port` its port.\nexport type Peer = { host: string; port: int; };\n\nfunction invalidPeer(offset: usize): NetError {\n  return NetError { kind: InvalidPeer, code: 0, offset: offset };\n}\n\nfunction isInvalidPeer(e: NetError): bool {\n  return match (e.kind) {\n    InvalidPeer => true,\n    _ => false\n  };\n}\n\n// parsePeer(text): Result<Peer, NetError> -- \"1.2.3.4:5\" or \"[::1]:5\" to a Peer (the brackets of an IPv6 literal are\n// dropped). Err(InvalidPeer) with the byte offset of the problem when there is no port, the port is not 0 .. 65535, the\n// host is empty, or an IPv6 literal is not in brackets. O(n).\n@Ensures(result.isOk() ==> result.unwrap().port >= 0 && result.unwrap().port <= 65535 && result.unwrap().host.length > 0)\n@Ensures(result.isErr() ==> isInvalidPeer(result.unwrapErr()))\nexport function parsePeer(text: string): Result<Peer, NetError> {\n  let i = text.length;\n  while (i > 0) {\n    i -= 1;\n    if (text.charCodeAt(i) == 58) {\n      const port = portDigits(text, i + 1);\n      if (port.isErr()) {\n        return Err(invalidPeer(port.unwrapErr()));\n      }\n      let h = text.substring(0, i);\n      if (h.length >= 2 && h.charCodeAt(0) == 91 && h.charCodeAt(h.length - 1) == 93) {\n        h = h.substring(1, h.length - 1);\n      } else if (h.indexOf(\":\").isSome()) {\n        return Err(invalidPeer(i));\n      }\n      if (h.length == 0) {\n        return Err(invalidPeer(0));\n      }\n      return Ok(Peer { host: h, port: port.unwrap() });\n    }\n  }\n  return Err(invalidPeer(text.length));\n}\n\n// ------------------------------------------------------------------------------------------------ narrowing\n\n// withListen<T>(net, addr, port, body): T -- runs body with a grant that can only listen on exactly `addr:port` (addr is\n// an address literal: \"0.0.0.0\", \"127.0.0.1\", \"::1\" ...; port 0 = any port the OS picks), and returns its result. If\n// `net` does not allow that, the grant reaches nothing (every listen is refused). The grant is revoked when body returns.\n// O(1).\nexport function withListen<T>(net: NetGrant, addr: string, port: int, body: (l: NetGrant) => T): T {\n  const g = grantListen(net, addr, port);\n  const r = body(g);\n  grantRevoke(g);\n  return r;\n}\n\n// useListen(net, addr, port, body): void -- `withListen` for a body that returns nothing.\nexport function useListen(net: NetGrant, addr: string, port: int, body: (l: NetGrant) => void): void {\n  const g = grantListen(net, addr, port);\n  body(g);\n  grantRevoke(g);\n}\n\n// withConnect<T>(net, hostPattern, portLo, portHi, body): T -- runs body with a grant that can only connect to / resolve\n// hosts matching `hostPattern` on ports portLo..portHi. A pattern or range outside `net`'s scope yields a grant that\n// reaches nothing. The grant is revoked when body returns. O(1).\nexport function withConnect<T>(net: NetGrant, hostPattern: string, portLo: int, portHi: int, body: (c: NetGrant) => T): T {\n  const g = grantConnect(net, hostPattern, portLo, portHi);\n  const r = body(g);\n  grantRevoke(g);\n  return r;\n}\n\n// useConnect(net, hostPattern, portLo, portHi, body): void -- `withConnect` for a body that returns nothing.\nexport function useConnect(net: NetGrant, hostPattern: string, portLo: int, portHi: int, body: (c: NetGrant) => void): void {\n  const g = grantConnect(net, hostPattern, portLo, portHi);\n  body(g);\n  grantRevoke(g);\n}\n\n// ------------------------------------------------------------------------------------------------ listeners\n\n// withListener<T>(net, addr, port, backlog, body): Result<T, NetError> -- binds a listener on addr:port (SO_REUSEADDR),\n// runs body(listener) and closes it. `Err` if `net` does not allow it (Denied), the port is in use (Os) or the arguments\n// are invalid (InvalidArgument); body is not called then. `port` 0 binds a free port, `portOf(listener)` tells which.\n// backlog 1..4096. The listener is created through a grant narrowed to exactly addr:port. O(1); one socket.\nexport function withListener<T>(net: NetGrant, addr: string, port: int, backlog: int, body: (ln: Listener) => T): Result<T, NetError> {\n  const g = grantListen(net, addr, port);\n  const ln = netListen(g, addr, port, backlog, 1);\n  const code = netStatus(ln);\n  if (code != 0) {\n    netClose(ln);\n    grantRevoke(g);\n    return Err(netErrorFromCode(code));\n  }\n  const r = body(ln);\n  netClose(ln);\n  grantRevoke(g);\n  return Ok(r);\n}\n\n// useListener(net, addr, port, backlog, body): Result<void, NetError> -- `withListener` for a body that returns nothing.\nexport function useListener(net: NetGrant, addr: string, port: int, backlog: int, body: (ln: Listener) => void): Result<void, NetError> {\n  const g = grantListen(net, addr, port);\n  const ln = netListen(g, addr, port, backlog, 1);\n  const code = netStatus(ln);\n  if (code != 0) {\n    netClose(ln);\n    grantRevoke(g);\n    return Err(netErrorFromCode(code));\n  }\n  body(ln);\n  netClose(ln);\n  grantRevoke(g);\n  return Ok();\n}\n\n// useListenerNet(net, addr, port, backlog, body): Result<void, NetError> -- `useListener` whose body also receives `net`\n// again as a parameter (a closure cannot capture a grant, so a body that must also connect, for example a loopback test,\n// gets it this way).\nexport function useListenerNet(\n  net: NetGrant, addr: string, port: int, backlog: int, body: (ln: Listener, net: NetGrant) => void\n): Result<void, NetError> {\n  const g = grantListen(net, addr, port);\n  const ln = netListen(g, addr, port, backlog, 1);\n  const code = netStatus(ln);\n  if (code != 0) {\n    netClose(ln);\n    grantRevoke(g);\n    return Err(netErrorFromCode(code));\n  }\n  body(ln, net);\n  netClose(ln);\n  grantRevoke(g);\n  return Ok();\n}\n\n// withListenerNet<T>(net, addr, port, backlog, body): Result<T, NetError> -- `useListenerNet` for a body that returns a value: body(listener,\n// net) with `net` passed through again (a closure cannot capture a grant), the listener closed afterwards. The way to get a value out\n// of a body that both listens and connects (a closure cannot modify a variable it captured).\nexport function withListenerNet<T>(\n  net: NetGrant, addr: string, port: int, backlog: int, body: (ln: Listener, net: NetGrant) => T\n): Result<T, NetError> {\n  const g = grantListen(net, addr, port);\n  const ln = netListen(g, addr, port, backlog, 1);\n  const code = netStatus(ln);\n  if (code != 0) {\n    netClose(ln);\n    grantRevoke(g);\n    return Err(netErrorFromCode(code));\n  }\n  const r = body(ln, net);\n  netClose(ln);\n  grantRevoke(g);\n  return Ok(r);\n}\n\n// portOf(ln): int -- the port the listener is bound to (the real one when it was asked for port 0). O(1).\n@Ensures(result >= 0 && result <= 65535)\nexport function portOf(ln: Listener): int {\n  return netPort(ln);\n}\n\n// withAccepted<T>(ln, timeout, body): Result<T, NetError> -- waits up to `timeout` for a connection, runs\n// body(stream, peer) and closes the stream (a graceful `close` after `shutdownWrite` is the body's business).\n// `Err(Timeout)` if none came (isTimeout: normal in a server loop), another Err on failure; body is not called then.\n// TCP_NODELAY is on. Waits up to `timeout`; one socket.\nexport function withAccepted<T>(ln: Listener, timeout: Duration, body: (s: Stream, peer: Peer) => T): Result<T, NetError> {\n  const s = netAccept(ln, clampMs(timeout.millis), 1);\n  const code = netStatus(s);\n  if (code != 0) {\n    netClose(s);\n    return Err(netErrorFromCode(code));\n  }\n  const peer = parsePeer(netPeer(s));\n  if (peer.isErr()) {\n    netClose(s);\n    return Err(peer.unwrapErr());\n  }\n  const r = body(s, peer.unwrap());\n  netClose(s);\n  return Ok(r);\n}\n\n// useAccepted(ln, timeout, body): Result<void, NetError> -- `withAccepted` for a body that returns nothing.\nexport function useAccepted(ln: Listener, timeout: Duration, body: (s: Stream, peer: Peer) => void): Result<void, NetError> {\n  const s = netAccept(ln, clampMs(timeout.millis), 1);\n  const code = netStatus(s);\n  if (code != 0) {\n    netClose(s);\n    return Err(netErrorFromCode(code));\n  }\n  const peer = parsePeer(netPeer(s));\n  if (peer.isErr()) {\n    netClose(s);\n    return Err(peer.unwrapErr());\n  }\n  body(s, peer.unwrap());\n  netClose(s);\n  return Ok();\n}\n\n// withAcceptedUntil<T>(ln, deadline, body): Result<T, NetError> -- `withAccepted` that waits until the absolute `deadline` (a single\n// wait is capped at one hour like every wait of this module: a later deadline behaves as one hour from now). The deadline of the\n// whole exchange is typically shared with the body's own `...Until` calls. Cancellable. Err(Timeout) if none came.\nexport function withAcceptedUntil<T>(ln: Listener, deadline: Deadline, body: (s: Stream, peer: Peer) => T): Result<T, NetError> {\n  const s = netAccept(ln, waitUntilMs(netNow(ln), deadline.at.millis), 1);\n  const code = netStatus(s);\n  if (code != 0) {\n    netClose(s);\n    return Err(netErrorFromCode(code));\n  }\n  const peer = parsePeer(netPeer(s));\n  if (peer.isErr()) {\n    netClose(s);\n    return Err(peer.unwrapErr());\n  }\n  const r = body(s, peer.unwrap());\n  netClose(s);\n  return Ok(r);\n}\n\n// ------------------------------------------------------------------------------------------------ concurrent servers\n\n// An accepted connection on its way to another task (ADR-0017 Addendum C): the Stream has left the accepting task's grant\n// table (`acceptDetached`) and waits as a one-shot token until a task adopts it (`serveAccepted`). It is a plain value, so\n// it can travel through a channel (`channel<Accepted>`) to a pool of workers. It is `@Sealed` (the token is private to this\n// module: only `acceptDetached` makes one); `peer` is readable. Exactly one `serveAccepted` / `dropAccepted`\n// per `Accepted`: a second one traps (\"invalid grant token\"), and a token nobody takes keeps its socket open until the\n// process ends, so a producer that cannot hand one over calls `dropAccepted`.\n@Sealed\nexport type Accepted = { _token: usize; peer: Peer; };\n\n// acceptDetached(ln, timeout): Result<Accepted, NetError> -- waits up to `timeout` for a connection and MOVES it out of this\n// task: Ok(Accepted), or `Err(Timeout)` (isTimeout: normal in a server loop) / another Err. TCP_NODELAY is on.\nexport function acceptDetached(ln: Listener, timeout: Duration): Result<Accepted, NetError> {\n  const s = netAccept(ln, clampMs(timeout.millis), 1);\n  const code = netStatus(s);\n  if (code != 0) {\n    netClose(s);\n    return Err(netErrorFromCode(code));\n  }\n  const peer = parsePeer(netPeer(s));\n  if (peer.isErr()) {\n    netClose(s);\n    return Err(peer.unwrapErr());\n  }\n  const tok = grantMove(s);\n  return Ok(Accepted { _token: tok, peer: peer.unwrap() });\n}\n\n// acceptDetachedUntil(ln, deadline): Result<Accepted, NetError> -- `acceptDetached` that waits until the absolute `deadline`. Cancellable.\nexport function acceptDetachedUntil(ln: Listener, deadline: Deadline): Result<Accepted, NetError> {\n  const s = netAccept(ln, waitUntilMs(netNow(ln), deadline.at.millis), 1);\n  const code = netStatus(s);\n  if (code != 0) {\n    netClose(s);\n    return Err(netErrorFromCode(code));\n  }\n  const peer = parsePeer(netPeer(s));\n  if (peer.isErr()) {\n    netClose(s);\n    return Err(peer.unwrapErr());\n  }\n  const tok = grantMove(s);\n  return Ok(Accepted { _token: tok, peer: peer.unwrap() });\n}\n\n// serveAccepted<T>(a, body): T -- in the task that serves it: adopts the connection, runs body(stream, peer) and closes the stream.\nexport function serveAccepted<T>(a: Accepted, body: (s: Stream, peer: Peer) => T): T {\n  const s = grantAdoptStream(a._token);\n  const r = body(s, a.peer);\n  netClose(s);\n  return r;\n}\n\n// serveAcceptedDo(a, body): void -- `serveAccepted` for a body that returns nothing.\nexport function serveAcceptedDo(a: Accepted, body: (s: Stream, peer: Peer) => void): void {\n  const s = grantAdoptStream(a._token);\n  body(s, a.peer);\n  netClose(s);\n}\n\n// dropAccepted(a): void -- closes a connection that will not be served (the pool is shutting down, the queue is full).\nexport function dropAccepted(a: Accepted): void {\n  const s = grantAdoptStream(a._token);\n  netClose(s);\n}\n\n// spawnAccepted<T>(sc, ln, timeout, body): Result<TaskHandle<T>, NetError> -- accepts one connection (as `acceptDetached`) and\n// starts a task of the scope `sc` that serves it: body(stream, peer), then the stream is closed. The task owns the connection; this task keeps the listener.\n// Unbounded: a task per connection; bound the number in flight yourself (see the example server) or use a worker pool.\nexport function spawnAccepted<T>(\n  sc: Scope, ln: Listener, timeout: Duration, body: (s: Stream, peer: Peer) => T\n): Result<TaskHandle<T>, NetError> {\n  const a = acceptDetached(ln, timeout);\n  return match (a) {\n    Ok(acc) => Ok(spawn(sc, () => serveAccepted(acc, body))),\n    Err(e) => Err(e)\n  };\n}\n\n// spawnAcceptedDo(sc, ln, timeout, body): Result<TaskHandle<bool>, NetError> -- `spawnAccepted` for a body that returns nothing;\n// join() then returns true.\nexport function spawnAcceptedDo(\n  sc: Scope, ln: Listener, timeout: Duration, body: (s: Stream, peer: Peer) => void\n): Result<TaskHandle<bool>, NetError> {\n  const a = acceptDetached(ln, timeout);\n  return match (a) {\n    Ok(acc) => Ok(spawn(sc, () => {\n      serveAcceptedDo(acc, body);\n      return true;\n    })),\n    Err(e) => Err(e)\n  };\n}\n\n// ------------------------------------------------------------------------------------------------ connections\n\n// withConnection<T>(net, host, port, timeout, body): Result<T, NetError> -- connects (a name is resolved by the OS\n// first: that lookup is not bounded by `timeout`), runs body(stream) and closes the stream. `Err` if refused (Denied),\n// unreachable (Os) or timed out (Timeout); body is not called then. Waits up to `timeout`; one socket.\nexport function withConnection<T>(net: NetGrant, host: string, port: int, timeout: Duration, body: (s: Stream) => T): Result<T, NetError> {\n  const s = netConnect(net, host, port, clampMs(timeout.millis), 1);\n  const code = netStatus(s);\n  if (code != 0) {\n    netClose(s);\n    return Err(netErrorFromCode(code));\n  }\n  const r = body(s);\n  netClose(s);\n  return Ok(r);\n}\n\n// useConnection(net, host, port, timeout, body): Result<void, NetError> -- `withConnection` for a body that returns nothing.\nexport function useConnection(net: NetGrant, host: string, port: int, timeout: Duration, body: (s: Stream) => void): Result<void, NetError> {\n  const s = netConnect(net, host, port, clampMs(timeout.millis), 1);\n  const code = netStatus(s);\n  if (code != 0) {\n    netClose(s);\n    return Err(netErrorFromCode(code));\n  }\n  body(s);\n  netClose(s);\n  return Ok();\n}\n\n// withConnectionUntil<T>(net, host, port, deadline, body): Result<T, NetError> -- `withConnection` whose connect ends at the absolute\n// `deadline` (all addresses of the name together; a wait is capped at one hour). The lookup of a NAME is not bounded by it and\n// cannot be cancelled (see `resolve`). Cancellable while it connects: Err(Cancelled).\nexport function withConnectionUntil<T>(net: NetGrant, host: string, port: int, deadline: Deadline, body: (s: Stream) => T): Result<T, NetError> {\n  const s = netConnect(net, host, port, waitUntilMs(netNow(net), deadline.at.millis), 1);\n  const code = netStatus(s);\n  if (code != 0) {\n    netClose(s);\n    return Err(netErrorFromCode(code));\n  }\n  const r = body(s);\n  netClose(s);\n  return Ok(r);\n}\n\n// useConnectionUntil(net, host, port, deadline, body): Result<void, NetError> -- `withConnectionUntil` for a body that returns nothing.\nexport function useConnectionUntil(net: NetGrant, host: string, port: int, deadline: Deadline, body: (s: Stream) => void): Result<void, NetError> {\n  const s = netConnect(net, host, port, waitUntilMs(netNow(net), deadline.at.millis), 1);\n  const code = netStatus(s);\n  if (code != 0) {\n    netClose(s);\n    return Err(netErrorFromCode(code));\n  }\n  body(s);\n  netClose(s);\n  return Ok();\n}\n\n// useConnectionBeside(net, host, port, timeout, ln, body): Result<void, NetError> -- `useConnection` whose body also\n// receives the listener `ln` again (a closure cannot capture a handle): a client and the server side of the same process,\n// for example a loopback test. The connection completes before `accept` (the kernel queues it, backlog permitting).\nexport function useConnectionBeside(\n  net: NetGrant, host: string, port: int, timeout: Duration, ln: Listener, body: (s: Stream, ln: Listener) => void\n): Result<void, NetError> {\n  const s = netConnect(net, host, port, clampMs(timeout.millis), 1);\n  const code = netStatus(s);\n  if (code != 0) {\n    netClose(s);\n    return Err(netErrorFromCode(code));\n  }\n  body(s, ln);\n  netClose(s);\n  return Ok();\n}\n\n// withConnectionBeside<T>(net, host, port, timeout, ln, body): Result<T, NetError> -- `useConnectionBeside` for a body that returns a value.\nexport function withConnectionBeside<T>(\n  net: NetGrant, host: string, port: int, timeout: Duration, ln: Listener, body: (s: Stream, ln: Listener) => T\n): Result<T, NetError> {\n  const s = netConnect(net, host, port, clampMs(timeout.millis), 1);\n  const code = netStatus(s);\n  if (code != 0) {\n    netClose(s);\n    return Err(netErrorFromCode(code));\n  }\n  const r = body(s, ln);\n  netClose(s);\n  return Ok(r);\n}\n\n// resolve(net, name): Result<string[], NetError> -- the numeric addresses of `name` (IPv4 and IPv6, no duplicates), or\n// Err (Denied when the grant's scope does not cover `name`, Os for an unknown name). LIMITATION: the lookup is the C library's\n// blocking `getaddrinfo`; it is bounded by no timeout and no deadline and cannot be interrupted by a cancellation (a task blocked\n// in it finishes the lookup first and returns `Cancelled` from its next network call; a task that is already cancelled does not\n// start one). A literal address needs no lookup. A server that must stay cancellable should resolve names in a task of its own and\n// not wait for it past the deadline (`joinUntil`), or connect to addresses. A resolver pool is not provided: the OS offers no\n// way to abandon a lookup. O(addresses).\nexport function resolve(net: NetGrant, name: string): Result<string[], NetError> {\n  const r = netResolve(net, name);\n  return match (r) {\n    Ok(text) => Ok(splitLines(text)),\n    Err(code) => Err(netErrorFromCode(code))\n  };\n}\n\n// ------------------------------------------------------------------------------------------------ stream operations\n\n// recv(s, maxBytes, timeout): Result<Bytes, NetError> -- waits up to `timeout` for bytes and returns 1..min(maxBytes, 65536) of\n// them. `Err` otherwise: kind Closed when the peer closed (the end of the stream: no more data ever), Timeout when nothing\n// arrived, Reset, Cancelled, or InvalidArgument for maxBytes 0. Never traps. One system call; the bytes are copied once from\n// the L0 buffer into the result.\n@Ensures(result.isOk() ==> result.unwrap().length() >= 1 && result.unwrap().length() <= maxBytes)\n@Ensures(maxBytes == 0 ==> result.isErr())\nexport function recv(s: Stream, maxBytes: usize, timeout: Duration): Result<Bytes, NetError> {\n  return recvMs(s, maxBytes, clampMs(timeout.millis));\n}\n\n// recv with the wait in milliseconds, already clamped.\n@Requires(ms >= 0 && ms <= MAX_MS)\n@Ensures(result.isOk() ==> result.unwrap().length() >= 1 && result.unwrap().length() <= maxBytes)\n@Ensures(maxBytes == 0 ==> result.isErr())\nfunction recvMs(s: Stream, maxBytes: usize, ms: int): Result<Bytes, NetError> {\n  if (maxBytes == 0) {\n    return Err(netErrorFromCode(CODE_INVALID));\n  }\n  const r = netRecv(s, maxBytes, ms);\n  return match (r) {\n    Ok(arr) => Ok(fromArray(arr)),\n    Err(code) => Err(netErrorFromCode(code))\n  };\n}\n\n// recvUntil(s, maxBytes, deadline): Result<Bytes, NetError> -- `recv` that waits until the absolute `deadline`: bytes that are\n// ready are returned even when it has passed (a zero wait), Err(Timeout) when none came by then. Unlike a wait of `recv`, it is\n// not cut at one hour. Cancellable: Err(Cancelled). maxBytes 0 is Err(InvalidArgument). Never traps.\n@Ensures(result.isOk() ==> result.unwrap().length() >= 1 && result.unwrap().length() <= maxBytes)\n@Ensures(maxBytes == 0 ==> result.isErr())\nexport function recvUntil(s: Stream, maxBytes: usize, deadline: Deadline): Result<Bytes, NetError> {\n  const end = deadline.at.millis;\n  while (true) {\n    const r = recvMs(s, maxBytes, waitUntilMs(netNow(s), end));\n    if (r.isOk() || r.unwrapErr().kind != Timeout || end - netNow(s) <= 0) {\n      return r;\n    }\n  }\n  return Err(netErrorFromCode(CODE_TIMEOUT));\n}\n\n// send(s, data, timeout): Result<usize, NetError> -- one attempt: waits up to `timeout` until the socket is writable and\n// hands the OS at most 65536 bytes of `data`; Ok(n) with 0 <= n <= min(length, 65536) (a partial write is normal), Err\n// otherwise (Timeout, Reset: the peer is gone). `sendAll` loops. Does not copy `data`.\nexport function send(s: Stream, data: Bytes, timeout: Duration): Result<usize, NetError> {\n  const start = data.storageStart();\n  return sendFrom(s, data.storage(), start, start + data.length(), clampMs(timeout.millis));\n}\n\n// One attempt to send arr[off, end) (the bytes of a `Bytes` read from its storage, without a copy); `ms` is already clamped.\n@Requires(off <= end && end <= arr.length)\nfunction sendFrom(s: Stream, arr: u8[], off: usize, end: usize, ms: int): Result<usize, NetError> {\n  const r = netSend(s, arr, off, end - off, ms);\n  return match (r) {\n    Ok(n) => Ok(n),\n    Err(code) => Err(netErrorFromCode(code))\n  };\n}\n\n// sendUntil(s, data, deadline): Result<usize, NetError> -- `send` that waits until the absolute `deadline` for the socket to be writable. Err(Timeout) when it\n// stayed full until then; Err(Cancelled) when cancelled. Not cut at one hour.\nexport function sendUntil(s: Stream, data: Bytes, deadline: Deadline): Result<usize, NetError> {\n  const start = data.storageStart();\n  const end = deadline.at.millis;\n  while (true) {\n    const r = sendFrom(s, data.storage(), start, start + data.length(), waitUntilMs(netNow(s), end));\n    if (r.isOk() || r.unwrapErr().kind != Timeout || end - netNow(s) <= 0) {\n      return r;\n    }\n  }\n  return Err(netErrorFromCode(CODE_TIMEOUT));\n}\n\n// sendAll(s, data, timeout): Result<void, NetError> -- sends all of `data`, resending the tail after partial writes;\n// `timeout` is a deadline for the whole call. Err(Timeout) if the peer does not read fast enough, Err(Reset) if it is\n// gone. O(length); `data` itself is not copied.\nexport function sendAll(s: Stream, data: Bytes, timeout: Duration): Result<void, NetError> {\n  return sendAllEnd(s, data, netNow(s) + clampMs(timeout.millis));\n}\n\n// sendAllUntil(s, data, deadline): Result<void, NetError> -- `sendAll` with an absolute deadline for the whole call (several calls can share one). The\n// check of the clock happens before every write, so a peer that reads one byte at a time cannot stretch it. Err(Timeout),\n// Err(Reset), Err(Cancelled) (also between two writes).\nexport function sendAllUntil(s: Stream, data: Bytes, deadline: Deadline): Result<void, NetError> {\n  return sendAllEnd(s, data, deadline.at.millis);\n}\n\nfunction sendAllEnd(s: Stream, data: Bytes, deadline: int): Result<void, NetError> {\n  const arr = data.storage();\n  const end = data.storageStart() + data.length();\n  let off = data.storageStart();\n  while (off < end) {\n    const left = deadline - netNow(s);\n    if (left <= 0) {\n      return Err(netErrorFromCode(CODE_TIMEOUT));\n    }\n    const r = sendFrom(s, arr, off, end, left > MAX_MS ? MAX_MS : left);\n    match (r) {\n      Ok(n) => {\n        if (n == 0) {\n          return Err(netErrorFromCode(CODE_RESET));\n        }\n        off += n;\n      },\n      Err(e) => {\n        if (e.kind != Timeout || deadline - netNow(s) <= 0) {\n          return Err(e);\n        }\n      }\n    }\n  }\n  return Ok();\n}\n\n// shutdownWrite(s): Result<void, NetError> -- half-close: sends FIN so the peer reads EOF while this side can still read.\n// The first step of a graceful close (then drain with `recv` for a bounded time, then let the scope close the stream); a\n// bare close with unread input makes the OS send RST, which can discard the response just written. O(1).\nexport function shutdownWrite(s: Stream): Result<void, NetError> {\n  const code = netShutdown(s, 1);\n  if (code != 0) {\n    return Err(netErrorFromCode(code));\n  }\n  return Ok();\n}\n\n// monotonicMillis(s): int -- a monotonic clock in milliseconds (arbitrary origin) for deadlines; it needs a live stream,\n// so a function that has no clock grant can still enforce a deadline on the connection it was given. Not the wall clock\n// of `time.nowMillis`. O(1).\n// Traps if the underlying monotonic clock fails: it never substitutes a timestamp or disables a deadline.\nexport function monotonicMillis(s: Stream): int {\n  return netNow(s);\n}\n\n// ------------------------------------------------------------------------------------------------ reading with a buffer\n\n// What `readExact` / `readUntil` produced when the read itself worked: Filled(bytes), FillClosed(the bytes read before the peer\n// closed: a short read, not an error because the bytes are data), FillLimit (the limit was reached without the delimiter; the\n// bytes stay buffered). A deadline that passed, a reset or a cancellation is the `Err(NetError)` of the call (Timeout: the bytes\n// read so far stay buffered).\nexport type Fill = Filled(Bytes) | FillClosed(Bytes) | FillLimit;\n\n// A read buffer for one stream: the bytes read ahead of what the caller consumed. A normal value (a Stream cannot be\n// stored). `cap` bounds the buffered bytes: no operation ever holds more, so a hostile peer cannot grow it.\n@Invariant(this.cap >= 1 && this.pending.length() <= this.cap)\nexport class StreamReader {\n  private pending: Bytes;\n  private cap: usize;\n\n  // new StreamReader(cap) -- an empty buffer that holds at most `cap` bytes (1 .. 268435456). Traps otherwise.\n  @Requires(cap >= 1 && cap <= 268435456)\n  constructor(cap: usize) {\n    this.pending = empty();\n    this.cap = cap;\n  }\n\n  // buffered(): Bytes -- the bytes read ahead and not yet consumed. O(1).\n  @Ensures(result.length() <= this.cap)\n  buffered(): Bytes {\n    return this.pending;\n  }\n\n  // capacity(): usize -- the most bytes the buffer holds. O(1).\n  @Ensures(result == this.cap)\n  capacity(): usize {\n    return this.cap;\n  }\n\n  // unread(data): void -- puts `data` back in front of the buffered bytes (for example the rest of a chunk a parser did\n  // not use). Traps if the buffer would exceed its capacity. O(length).\n  @Requires(data.length() + this.pending.length() <= this.cap)\n  @Ensures(this.buffered().length() == old(this.buffered().length()) + data.length())\n  unread(data: Bytes): void {\n    this.pending = data.concat(this.pending);\n  }\n\n  // take(n): Bytes -- removes and returns the first n buffered bytes. Traps if fewer than n are buffered. O(length).\n  @Requires(n <= this.pending.length())\n  @Ensures(result.length() == n)\n  @Ensures(this.pending.length() == old(this.pending.length()) - n)\n  take(n: usize): Bytes {\n    const head = this.pending.slice(0, n);\n    this.pending = this.pending.slice(n, this.pending.length());\n    return head;\n  }\n\n  // readSome(s, maxBytes, timeout): Result<Bytes, NetError> -- buffered bytes if there are any (at most maxBytes, no system\n  // call), else one `recv` (its errors, Closed at the end of the stream). Traps if maxBytes is 0.\n  @Requires(maxBytes >= 1)\n  readSome(s: Stream, maxBytes: usize, timeout: Duration): Result<Bytes, NetError> {\n    if (this.pending.length() > 0) {\n      const n = this.pending.length() < maxBytes ? this.pending.length() : maxBytes;\n      return Ok(this.take(n));\n    }\n    return recv(s, maxBytes < this.cap ? maxBytes : this.cap, timeout);\n  }\n\n  // readExact(s, n, timeout): Result<Fill, NetError> -- exactly n bytes (Ok(Filled)), or what arrived before the peer closed\n  // (Ok(FillClosed)); Err(Timeout) when the DEADLINE `timeout` (for the whole call) passed, Err(Reset) or Err(Cancelled). Never\n  // reads past n bytes: further bytes stay in the stream. Traps if n exceeds the capacity.\n  @Requires(n <= this.cap)\n  @Ensures(result.isOk() ==> match (result.unwrap()) { Filled(b) => b.length() == n, _ => true })\n  @Ensures(this.pending.length() <= this.cap)\n  readExact(s: Stream, n: usize, timeout: Duration): Result<Fill, NetError> {\n    return this.readExactUntil(s, n, Deadline { at: MonotonicInstant { millis: netNow(s) + clampMs(timeout.millis) } });\n  }\n\n  // readExactUntil(s, n, deadline): Result<Fill, NetError> -- `readExact` with an absolute deadline for the whole call, however many\n  // small reads it takes (a peer that sends one byte at a time cannot stretch it, and several calls can share one deadline).\n  @Requires(n <= this.cap)\n  @Ensures(result.isOk() ==> match (result.unwrap()) { Filled(b) => b.length() == n, _ => true })\n  @Ensures(this.pending.length() <= this.cap)\n  readExactUntil(s: Stream, n: usize, deadline: Deadline): Result<Fill, NetError> {\n    const end = deadline.at.millis;\n    while (this.pending.length() < n) {\n      const left = end - netNow(s);\n      if (left < 0) {\n        return Err(netErrorFromCode(CODE_TIMEOUT));\n      }\n      const want = n - this.pending.length();\n      const r = recvMs(s, want, clampMs(left));\n      match (r) {\n        Ok(b) => {\n          this.pending = this.pending.concat(b);\n        },\n        Err(e) => {\n          if (e.kind == Closed) {\n            return Ok(FillClosed(this.take(this.pending.length())));\n          }\n          if (e.kind != Timeout || end - netNow(s) <= 0) {\n            return Err(e);\n          }\n        }\n      }\n    }\n    return Ok(Filled(this.take(n)));\n  }\n\n  // readUntil(s, delim, limit, timeout): Result<Fill, NetError> -- the bytes up to and including the first occurrence of `delim`\n  // (Ok(Filled)), with at most `limit` bytes examined: Ok(FillLimit) if `limit` bytes contain no delimiter (the buffer then keeps\n  // them), Ok(FillClosed) (the bytes so far) if the peer closed first, Err(Timeout) at the DEADLINE `timeout` for the whole call,\n  // Err(Reset) or Err(Cancelled). Receives at most limit - buffered bytes each time, so at most `limit` bytes are buffered by\n  // the call. Traps if delim is empty, limit is shorter than delim or limit exceeds the capacity.\n  @Requires(delim.length() >= 1 && limit >= delim.length() && limit <= this.cap)\n  @Ensures(result.isOk() ==> match (result.unwrap()) { Filled(b) => b.length() <= limit && b.length() >= delim.length(), _ => true })\n  @Ensures(this.pending.length() <= this.cap)\n  readUntil(s: Stream, delim: Bytes, limit: usize, timeout: Duration): Result<Fill, NetError> {\n    return this.readDelimitedUntil(s, delim, limit, Deadline { at: MonotonicInstant { millis: netNow(s) + clampMs(timeout.millis) } });\n  }\n\n  // readDelimitedUntil(s, delim, limit, deadline): Result<Fill, NetError> -- `readUntil` with an absolute deadline for the whole call.\n  @Requires(delim.length() >= 1 && limit >= delim.length() && limit <= this.cap)\n  @Ensures(result.isOk() ==> match (result.unwrap()) { Filled(b) => b.length() <= limit && b.length() >= delim.length(), _ => true })\n  @Ensures(this.pending.length() <= this.cap)\n  readDelimitedUntil(s: Stream, delim: Bytes, limit: usize, deadline: Deadline): Result<Fill, NetError> {\n    const end = deadline.at.millis;\n    let begin: usize = 0;\n    while (true) {\n      const at = delimiterEnd(this.pending, delim, begin, limit);\n      match (at) {\n        Some(stop) => {\n          return Ok(Filled(this.take(stop)));\n        },\n        None => {}\n      }\n      if (this.pending.length() >= limit) {\n        return Ok(FillLimit);\n      }\n      begin = this.pending.length() >= delim.length() ? this.pending.length() - delim.length() + 1 : 0;\n      const left = end - netNow(s);\n      if (left < 0) {\n        return Err(netErrorFromCode(CODE_TIMEOUT));\n      }\n      const r = recvMs(s, limit - this.pending.length(), clampMs(left));\n      match (r) {\n        Ok(b) => {\n          this.pending = this.pending.concat(b);\n        },\n        Err(e) => {\n          if (e.kind == Closed) {\n            return Ok(FillClosed(this.take(this.pending.length())));\n          }\n          if (e.kind != Timeout || end - netNow(s) <= 0) {\n            return Err(e);\n          }\n        }\n      }\n    }\n    return Ok(FillLimit);\n  }\n}\n\n// delimiterEnd(hay, delim, begin, limit): Option<usize> -- the end index (exclusive) of the first occurrence of `delim` in\n// hay that starts at an index >= begin and ends at <= limit, or None. O(length * delim) worst case, O(length) typical.\n// Internal (ADR-0048 7.4): this is a Bytes search, which will become `Bytes.indexOfBytes(needle, from)` in std:bytes; this\n// local copy goes away then.\n@Ensures(result.isSome() ==> result.unwrap() >= delim.length() && result.unwrap() <= limit && result.unwrap() <= hay.length())\nfunction delimiterEnd(hay: Bytes, delim: Bytes, begin: usize, limit: usize): Option<usize> {\n  const n = hay.length() < limit ? hay.length() : limit;\n  const m = delim.length();\n  if (m == 0 || n < m) {\n    return None;\n  }\n  let i = begin;\n  while (i + m <= n) {\n    let k: usize = 0;\n    while (k < m && hay.at(i + k) == delim.at(k)) {\n      k += 1;\n    }\n    if (k == m) {\n      return Some(i + m);\n    }\n    i += 1;\n  }\n  return None;\n}\n" });
  out.push(SourceFile { path: "$stdlib/net_internal.or", text: "// std:net/internal -- helpers behind std:net (ADR-0048 rule 7.3). NOT API: user code does not import this module.\n//\n// Pure helpers without a handle: the wait clamp and the text scanners. They can change in any release.\n\n// The longest single wait of any call of std:net: one hour, in milliseconds.\nexport const MAX_MS: int = 3600000;\n\n// clampMs(ms): int -- `ms` limited to 0 .. MAX_MS. O(1).\n@Ensures(result >= 0 && result <= MAX_MS)\n@Ensures(ms >= 0 && ms <= MAX_MS ==> result == ms)\nexport function clampMs(ms: int): int {\n  if (ms < 0) {\n    return 0;\n  }\n  return ms > MAX_MS ? MAX_MS : ms;\n}\n\n// waitUntilMs(now, end): int -- the wait left at `now` until the absolute deadline `end` (both monotonic millis): 0 when it\n// has passed, at most one hour. O(1).\n@Ensures(result >= 0 && result <= MAX_MS)\nexport function waitUntilMs(now: int, end: int): int {\n  return clampMs(end - now);\n}\n\n// portDigits(text, start): Result<int, usize> -- the decimal port in text[start, end): 1 to 5 digits, 0 .. 65535. Err holds the\n// byte offset of the offending byte (`start` when it is empty or too large). O(length).\n@Ensures(result.isOk() ==> result.unwrap() >= 0 && result.unwrap() <= 65535)\nexport function portDigits(text: string, start: usize): Result<int, usize> {\n  if (start >= text.length) {\n    return Err(start);\n  }\n  let v: int = 0;\n  let i = start;\n  while (i < text.length) {\n    const c = text.charCodeAt(i);\n    if (c < 48 || c > 57) {\n      return Err(i);\n    }\n    v = v * 10 + (c - 48);\n    if (v > 65535) {\n      return Err(start);\n    }\n    i += 1;\n  }\n  return Ok(v);\n}\n\n// splitLines(text): string[] -- the non-empty lines of `text` (separated by LF). O(length).\nexport function splitLines(text: string): string[] {\n  let out: string[] = [];\n  let start: usize = 0;\n  let i: usize = 0;\n  while (i < text.length) {\n    if (text.charCodeAt(i) == 10) {\n      if (i > start) {\n        out.push(text.substring(start, i));\n      }\n      start = i + 1;\n    }\n    i += 1;\n  }\n  return out;\n}\n" });
  out.push(SourceFile { path: "$stdlib/ox.or", text: "// std:ox -- the types of an OX provider (ADR-0044 \xc2\xa73). Types only: no code, no platform calls.\n//\n// A file with markup selects its provider with `import ox from \"M\";`. The module `M` exports `function ox()` whose\n// body is a single `return` of a literal of type `Markup<R>` (the provider serialises markup to text, like std:html)\n// or `Components<R>` (the provider builds values, like a widget toolkit). The function is an ordinary, type-checked\n// Orin function and is never called: the compiler reads the literal and calls the functions it names directly.\n// `R` is the provider's result type; the compiler requires nothing of it.\n\n// One byte of static text or of a static attribute value and its encoding: `char` is a single-byte string.\n// Example: Escape { char: \"<\", encoded: \"&lt;\" }.\nexport type Escape = { char: string; encoded: string; };\n\n// A per-attribute override. An attribute `a` matches the rule when `a` is in `names` or starts with the non-empty\n// `prefix`, both compared ASCII case-insensitively. `convert: Some(f)` sends a computed string value through `f`\n// instead of `Markup.attr` (a URL sanitiser, say); `convert: None` makes a computed value an error (E0493): the\n// attribute may only be written statically (event handlers: their value is code).\nexport type AttrRule = { names: string[]; prefix: string; convert: Option<(value: string) => string>; };\n\n// A provider that serialises markup to text: the kind of std:html. Intrinsic elements (lower-case tags) are written\n// into one buffer, the result of a root is `wrap(buffer)`.\nexport type Markup<R> = {\n  // The finished text of a root becomes the result value (it is trusted: the compiler built it from encoded parts).\n  wrap: (markup: string) => R;\n  // An `R` child becomes its text.\n  embed: (value: R) => string;\n  // An `R[]` child becomes its text.\n  embedAll: (values: R[]) => string;\n  // A computed `string` child becomes its encoded text.\n  text: (value: string) => string;\n  // A computed `string` attribute value becomes its encoded text, unless a rule of `rules` applies.\n  attr: (value: string) => string;\n  // Per-attribute overrides; the first matching rule wins.\n  rules: AttrRule[];\n  // The encoding of static text and static attribute values, applied at compile time byte by byte.\n  escapes: Escape[];\n  // Elements without children and closing tag.\n  voidTags: string[];\n  // How a void tag ends: \">\" (HTML) or \"/>\" (XML).\n  voidEnd: string;\n  // Elements whose children are static text only, written unencoded (`<script>`, `<style>`).\n  rawTextTags: string[];\n  // A `bool` attribute is present or absent (HTML) rather than an error.\n  presenceAttrs: bool;\n};\n\n// A provider that builds values: an intrinsic tag `t` is the provider's exported function `t`, called like a\n// component (docs/ox.md). `R` is the type of the finished values (a widget, a DOM node, a string builder, ...).\nexport type Components<R> = {\n  // Several children where one `R` is expected, and `<>..</>`.\n  fragment: (items: R[]) => R;\n  // Text where an `R` is expected.\n  text: (value: string) => R;\n};\n" });
  out.push(SourceFile { path: "$stdlib/path.or", text: "// std:path -- lexical POSIX path utilities (spec 08, ADR-0016).\n//\n// Semantics (documented once, for every function):\n//   * Paths are byte strings with \"/\" as the only separator (POSIX). There is no Windows\n//     handling, no filesystem access, no symlink resolution and no current directory: every\n//     function is pure and lexical. Results follow Node's `path.posix` where Node has an\n//     equivalent function.\n//   * A path is absolute when it starts with \"/\".\n//   * Every function is total (never traps, never returns Result); odd input such as \"\" or\n//     \"///\" is handled as documented per function.\n//   * Complexity: all functions are O(n) in the total length of their input and allocate O(n).\n\n// Non-empty segments of `p` in order (no \".\" / \"..\" processing).\nfunction splitSegments(p: string): string[] {\n  let out: string[] = [];\n  for (const s of p.split(\"/\")) {\n    if (s.length > 0) {\n      out.push(s);\n    }\n  }\n  return out;\n}\n\n// isAbsolute(p: string): bool\n// True when `p` starts with \"/\". `isAbsolute(\"\")` is false.\nexport function isAbsolute(p: string): bool {\n  return p.length > 0 && p.charCodeAt(0) == 47;\n}\n\n// normalize(p: string): string\n// Resolves \".\" and \"..\" segments lexically and collapses repeated separators.\n//   * \"\" normalizes to \".\"; a relative path that reduces to nothing is \".\" (\"a/..\" -> \".\").\n//   * \"..\" that would climb above the root of an absolute path is dropped (\"/..\" -> \"/\");\n//     in a relative path leading \"..\" segments are kept (\"../a\", \"a/../..\" -> \"..\").\n//   * A trailing separator is preserved (\"a//b/\" -> \"a/b/\", \"./\" -> \"./\"); the root is \"/\".\n// Examples: normalize(\"/a/./b/../c\") == \"/a/c\"; normalize(\"a//b\") == \"a/b\".\nexport function normalize(p: string): string {\n  if (p.length == 0) {\n    return \".\";\n  }\n  const abs = isAbsolute(p);\n  const trailing = p.charCodeAt(p.length - 1) == 47;\n  let out: string[] = [];\n  for (const s of splitSegments(p)) {\n    if (s == \".\") {\n      continue;\n    }\n    if (s == \"..\") {\n      if (out.length > 0 && out[out.length - 1] != \"..\") {\n        out.pop();\n      } else if (!abs) {\n        out.push(\"..\");\n      }\n      continue;\n    }\n    out.push(s);\n  }\n  const body = out.join(\"/\");\n  if (abs) {\n    if (body.length == 0) {\n      return \"/\";\n    }\n    return trailing ? \"/\" + body + \"/\" : \"/\" + body;\n  }\n  if (body.length == 0) {\n    return trailing ? \"./\" : \".\";\n  }\n  return trailing ? body + \"/\" : body;\n}\n\n// joinAll(parts: string[]): string\n// Joins the non-empty `parts` with \"/\" and normalizes the result (see `normalize`). An empty\n// list, or a list of empty strings, gives \".\". Like Node, a later absolute part does NOT reset\n// the path: joinAll([\"a\", \"/b\"]) == \"a/b\" (use `resolveAgainst` to get reset semantics).\n// Examples: joinAll([\"/a\", \"b\", \"../c\"]) == \"/a/c\"; joinAll([\"a\", \"\", \"b/\"]) == \"a/b/\".\nexport function joinAll(parts: string[]): string {\n  let kept: string[] = [];\n  for (const q of parts) {\n    if (q.length > 0) {\n      kept.push(q);\n    }\n  }\n  if (kept.length == 0) {\n    return \".\";\n  }\n  return normalize(kept.join(\"/\"));\n}\n\n// join(base: string, part: string): string\n// `base` followed by `part`, normalized (see `normalize`); the two-argument form of `joinAll`. An empty side is\n// ignored and a later absolute `part` does NOT reset the path: join(\"a\", \"/b\") == \"a/b\".\n// Examples: join(\"/a\", \"b/../c\") == \"/a/c\"; join(\"\", \"x\") == \"x\"; join(\"\", \"\") == \".\".\nexport function join(base: string, part: string): string {\n  return joinAll([base, part]);\n}\n\n// resolveAgainst(base: string, p: string): string\n// `p` normalized when `p` is absolute, otherwise join(base, p). Pure: there is no implicit\n// current directory, so `base` must be supplied by the caller.\nexport function resolveAgainst(base: string, p: string): string {\n  if (isAbsolute(p)) {\n    return normalize(p);\n  }\n  return join(base, p);\n}\n\n// End offset (exclusive) of `p` after dropping trailing \"/\" characters; 0 when `p` is all \"/\".\nfunction endWithoutSlashes(p: string): usize {\n  let e = p.length;\n  while (e > 0 && p.charCodeAt(e - 1) == 47) {\n    e -= 1;\n  }\n  return e;\n}\n\n// Start offset of the last segment of p[0..e) (the position after the last \"/\" before e).\nfunction lastSegmentStart(p: string, e: usize): usize {\n  let i = e;\n  while (i > 0 && p.charCodeAt(i - 1) != 47) {\n    i -= 1;\n  }\n  return i;\n}\n\n// dirname(p: string): string\n// The directory part of `p`, ignoring trailing separators; the path is NOT normalized.\n//   dirname(\"/a/b/c\") == \"/a/b\"; dirname(\"/a/b/\") == \"/a\"; dirname(\"a\") == \".\"; dirname(\"\") == \".\";\n//   dirname(\"/a\") == \"/\"; dirname(\"/\") == \"/\"; dirname(\"a//b\") == \"a\"; dirname(\"a/./b\") == \"a/.\".\nexport function dirname(p: string): string {\n  const e = endWithoutSlashes(p);\n  if (e == 0) {\n    return p.length > 0 ? \"/\" : \".\";\n  }\n  const s = lastSegmentStart(p, e);\n  if (s == 0) {\n    return \".\";\n  }\n  const d = endWithoutSlashes(p.substring(0, s));\n  if (d == 0) {\n    return \"/\";\n  }\n  return p.substring(0, d);\n}\n\n// basename(p: string): string\n// The last segment of `p`, ignoring trailing separators. basename(\"/a/b.txt\") == \"b.txt\";\n// basename(\"a/b/\") == \"b\"; basename(\"/\") == \"\"; basename(\"\") == \"\".\nexport function basename(p: string): string {\n  const e = endWithoutSlashes(p);\n  if (e == 0) {\n    return \"\";\n  }\n  return p.substring(lastSegmentStart(p, e), e);\n}\n\n// extension(p: string): string\n// The extension of the basename including the leading dot, or \"\" when there is none (Node's\n// `extname`): extension(\"a/b.txt\") == \".txt\"; extension(\"a.tar.gz\") == \".gz\";\n// extension(\".bashrc\") == \"\"; extension(\"a.\") == \".\"; extension(\"a\") == \"\"; extension(\"..\") == \"\".\nexport function extension(p: string): string {\n  const b = basename(p);\n  let i = b.length;\n  while (i > 0) {\n    if (b.charCodeAt(i - 1) == 46) {\n      // i-1 is the last dot; a dot at offset 0 (\".bashrc\") or the name \"..\" has no extension.\n      if (i == 1 || b == \"..\") {\n        return \"\";\n      }\n      return b.substring(i - 1, b.length);\n    }\n    i -= 1;\n  }\n  return \"\";\n}\n\n// stem(p: string): string\n// The basename without its extension: stem(\"a/b.txt\") == \"b\"; stem(\".bashrc\") == \".bashrc\";\n// stem(\"a.tar.gz\") == \"a.tar\".\nexport function stem(p: string): string {\n  const b = basename(p);\n  const x = extension(p);\n  return b.substring(0, b.length - x.length);\n}\n\n// replaceExtension(p: string, ext: string): string\n// Replaces the extension of the basename of `p` by `ext` (which must include the dot, or be \"\"\n// to remove it). Trailing separators are dropped: replaceExtension(\"a/b.txt\", \".md\") == \"a/b.md\".\n// For \"\" or \"/\" (no basename) the result is `p + ext`.\nexport function replaceExtension(p: string, ext: string): string {\n  const e = endWithoutSlashes(p);\n  if (e == 0) {\n    return p + ext;\n  }\n  const x = extension(p);\n  return p.substring(0, e - x.length) + ext;\n}\n\n// withExtension(p: string, ext: string): string -- renamed `replaceExtension` (`with*` is reserved for scoped\n// resources, ADR-0048 section 1.2); this wrapper stays for one release.\n@Deprecated(\"use replaceExtension(p, ext)\")\nexport function withExtension(p: string, ext: string): string {\n  return replaceExtension(p, ext);\n}\n" });
  out.push(SourceFile { path: "$stdlib/seq.or", text: "// std:seq -- pure aggregates over arrays, for contracts and code (ADR-0036, ADR-0031 C11-C13).\n//\n// `range(lo, hi)` is the index array `[lo, lo + 1, .., hi - 1]` (empty when `hi <= lo`), so that a bounded\n// quantifier over indices is written with the array API: `range(0, xs.length).every(i => xs[i] > 0)` is \"for all\n// `i` in `0 .. xs.length`\", and `range(1, xs.length).every(i => xs[i - 1] <= xs[i])` says `xs` is sorted.\n// `sum(xs)` and `sumBy(xs, f)` add up the elements (or `f` of them): `sumBy(this.items, it => it.price * it.qty)`.\n//\n// These are ordinary, pure functions: contracts may call them (ADR-0031 A4; `sumBy` is pure relative to its\n// function argument, like `every`), and the contract-checked build runs them as written. `orin verify\n// --contracts` does not run them: it reads `range(a, b).every(..)` / `.some(..)` as a bounded quantifier over\n// the indices and `sum` / `sumBy` as the recursive sum `sum(xs, n) = sum(xs, n - 1) + f(xs[n - 1])` (docs/contracts.md,\n// \"Quantifiers and sums\"). The loop bodies below are the reference semantics: the runtime meaning is the one of\n// the code, the solver's is the same by construction (and tests/contracts/ checks they agree on examples).\n//\n// Overflow: `+` on `int` traps on overflow, so a sum that does not fit traps in the contract-checked build; the\n// verifier reasons over unbounded integers and assumes the paths that return did not overflow (A-INT).\n\n// range(lo, hi): usize[] -- the indices `lo`, `lo + 1`, .., `hi - 1`; no element when `hi <= lo`. Never fails; O(hi - lo)\n// time and allocation.\n@Ensures(result.length == (hi > lo ? hi - lo : 0))\nexport function range(lo: usize, hi: usize): usize[] {\n  let out: usize[] = [];\n  let i = lo;\n  @Invariant(out.length == (i > lo ? i - lo : 0))\n  while (i < hi) {\n    out.push(i);\n    i += 1;\n  }\n  return out;\n}\n\n// sum(xs): int -- the sum of the elements; 0 for the empty array. Traps if the sum overflows `int`. O(n), no allocation.\n@Ensures(xs.length == 0 ==> result == 0)\nexport function sum(xs: int[]): int {\n  let s: int = 0;\n  let i: usize = 0;\n  @Invariant(i == 0 ==> s == 0)\n  while (i < xs.length) {\n    s += xs[i];\n    i += 1;\n  }\n  return s;\n}\n\n// sumBy(xs, f): int -- the sum of `f(x)` over the elements; 0 for the empty array. Traps if the sum overflows `int`.\n// O(n) calls of `f`, no allocation.\n@Ensures(xs.length == 0 ==> result == 0)\nexport function sumBy<T>(xs: T[], f: (x: T) => int): int {\n  let s: int = 0;\n  for (const x of xs) {\n    s += f(x);\n  }\n  return s;\n}\n" });
  out.push(SourceFile { path: "$stdlib/task.or", text: "// std:task -- structured concurrency with isolated tasks (ADR-0017 stage 0; docs/concurrency.md).\n//\n// UNSTABLE until the concurrency freeze. The whole library is Orin. Only the primitives under it are C: the L0 thread and\n// monitor operations (runtime/platform/orin_platform.h) and the transfer / task-start functions of the temporary runtime interface\n// `orin_rt_*` (runtime/core/orin_runtime.c, to move to Orin in R3). Nothing in this file is trusted beyond what the compiler\n// checks: the scheduler bookkeeping (the scope's task table), the channel buffers, the join results and the panic\n// propagation are ordinary Orin with invariants and contracts.\n//\n// MODEL. A task is an operating-system thread with its own heap. A value that crosses from one task to another (a\n// captured variable of a task body, a result, a message) is MOVED when it is uniquely owned (every reference in it has\n// count 1: no copy is made) and deep-copied otherwise; to the program both are a value copy. Reference counts stay\n// non-atomic: no object is ever reachable from two tasks, so there is no shared mutable memory and no data race. The only\n// state tasks share is a MONITOR: a lock-protected array of integers owned by the L0 layer. std:task keeps the task table of a\n// scope in one and the buffer of a channel in one; a buffer holds transfer tokens, never values.\n//\n//   scope(s => {\n//     const a = s.spawn(() => work(1));\n//     const b = s.spawn(() => work(2));\n//     return a.join() + b.join();\n//   })\n//\n// * `scope(body)` runs `body(s)` and, before it returns, joins every task spawned in it whether or not the body joined it:\n//   no task outlives its scope. If a task that nobody joined panicked, the scope panics (traps) after all tasks have ended.\n// * `s.spawn(f)` starts `f` as a task; `h.join()` waits for it and returns its result. A panic (trap) in a task ends only\n//   that task; `join` (or the end of the scope) turns it into a trap of the joining task with the message\n//   `task panicked: <message>`. A panic is never lost silently. `spawn` is a method of the scope; `T` may be void.\n// * `channel<T>(capacity)` makes a bounded channel; `ch.tx.send(v)` blocks while it is full, `ch.rx.recv()` blocks while it\n//   is empty and returns `None` once the channel is closed and drained. `tx.close()` ends the stream, `rx.close()`\n//   cancels it (a blocked or later `send` returns false). Each end can be copied and used by any number of tasks. Close both\n//   ends to release the channel: after that any use of it traps.\n// * Resource handles are not values: a task body cannot capture one (E0483). A grant is delegated with `spawnFs`,\n//   `spawnProcess`, `spawnStdio` or `spawnClock`: the spawner derives a fresh grant with the same authority and MOVES it\n//   into the task (the task owns it and revokes it when it ends, also when it panics) and the body receives it as a\n//   parameter, like the body of a scope function of std:host. `spawnNet(s, net, body)` does the same for a NetGrant\n//   (with `scopeNet` to carry the grant into the scope); an accepted connection is moved into a task by std:net\n//   (`spawnAccepted`, or `acceptDetached` + a channel + `serveAccepted` for a bounded pool of workers; ADR-0017 Addendum C).\n// * `parallelMap(xs, f, parts)` maps `f` over `xs` in `parts` tasks and returns the results in order.\n//\n// * Timed and wakeable waits (ADR-0017 Addendum B, C1). Every timed call has an ABSOLUTE form on a `Deadline` of std:time (an\n//   instant on the monotonic clock, so retries and nested waits cannot stretch it) and a relative form that takes the\n//   `ClockGrant` to read \"now\" (a deadline is the only thing that needs authority; waiting for one does not):\n//   `rx.recvUntil(d)` / `rx.recvTimeout(clock, t)`, `tx.sendUntil(v, d)` / `tx.sendTimeout(clock, v, t)`,\n//   `h.joinUntil(d)` / `h.joinTimeout(clock, t)`, `select(rxs)` / `selectUntil(rxs, d)` / `selectTimeout(clock, rxs, t)`,\n//   `sleep(clock, t)` / `sleepUntil(d)`. A timed call returns `Result<_, TaskError>`: `Timeout` when the deadline passed\n//   first, `Closed` when the channel is closed and drained (all of them, for `select`), `ClockUnavailable` / `InvalidDuration`\n//   from the relative forms. A value that is there when the deadline passes is still delivered, never dropped.\n//\n// * Cancellation of network waits (ADR-0017 Addendum D, C3). Every scope owns a cancellation token (a wake source of L0); a task\n//   is bound to the token of the scope it was spawned in, a nested scope's token is a child of the token of the task that opened\n//   it. `s.cancel()` / `token.cancel()` sets the token (permanent, idempotent): every task of the scope blocked in a network wait\n//   of std:net (accept, connect, recv, send) wakes at once with `Err(Cancelled)`, and so does every later network call of a\n//   cancelled task, until the scope ends. `s.token()` is a copyable value a task may capture (a task cannot capture the Scope), and\n//   `isCancelled()` is the cooperative check for long computations. A token kept after its scope ended is stale and harmless:\n//   `cancel()` returns false and cannot cancel another scope that reuses the slot (generation-tagged handles). Waits on channels\n//   (`recv`, `send`, `join`, `select`, `sleep`) do NOT observe the token yet (they are woken by their deadline or by the channel,\n//   C2); a task that waits on a channel and on the network at once should use the deadline forms.\n//\n// Stage 0 has no `async` / `await`, no cancellation of channel waits other than `rx.close()` (scope cancellation is C2), no deadlock detection\n// (all tasks blocked is a hang) and no work stealing: a task is a thread, so thousands are fine, hundreds of thousands are not.\n// A panic in the BODY of a scope (not in a task) is not unwound: tasks still running keep running until the process ends.\n\nimport { Ledger, Ranges, ringCanPush, ringSlot, ringNextHead, ringIsDone, deadlineAfterMillis } from \"std:taskcore\";\nimport { Deadline, Duration, MonotonicInstant, monotonicNow } from \"std:time\";\nimport {\n  FsGrant, ProcessGrant, StdioGrant, ClockGrant, NetGrant, grantAdoptNet, grantRevoke, grantClone, grantMove, grantAdoptFs, grantAdoptProcess,\n  grantAdoptStdio, grantAdoptClock, monNew, monFree, monLock, monUnlock, monWait, monNotifyAll, monGet, monSet, monGrow,\n  transitPut, transitTake, transitDrop, taskSpawn, taskJoin, taskMessage, taskTrap, transferCount, monNotifyOne, parThreads, lendPut, monWaitUntil, taskWatch,\n  wakeOpen, wakeClose, wakeSignal, wakeBind, wakeBound, wakeCheck\n} from \"std:fsraw\";\n\n// ------------------------------------------------------------------------------------------------------ transfer\n\n// The unit of transfer: a one-field record. Building it consumes the value (the runtime then moves a uniquely owned graph\n// and copies a shared one); a task body, a result and a message all travel in one.\ntype Box<T> = { v: T; };\n\ntype Thunk = () => void;\n\n// putBox<T>(v): the transfer token of `v`. A token is taken exactly once, by takeBox or dropped by transitDrop.\n// The runtime publishes the box itself (no second box) when it is the only reference and its value moves; that needs\n// the box released here, before the token is handed to another task: it dies at the end of this function, and every\n// token travels through a monitor or a thread start afterwards. Keep the box a temporary of this function.\nfunction putBox<T>(v: T): usize {\n  return transitPut(Box<T> { v: v });\n}\n\nfunction takeBox<T>(tok: usize): T {\n  const b: Box<T> = transitTake(tok);\n  return b.v;\n}\n\nexport { Ring, Ledger, Ranges } from \"std:taskcore\";\n\n// movedCount(): how many values this task has sent by MOVE (no copy) since it started, and copiedCount(): by deep copy.\n// Only values that contain a reference (strings, arrays, records, ...) are counted; scalars cost nothing either way.\nexport function movedCount(): usize {\n  return transferCount(0);\n}\n\nexport function copiedCount(): usize {\n  return transferCount(1);\n}\n\n// ------------------------------------------------------------------------------------------------------ errors\n\n// Why a timed call returned no value (ADR-0048 section 3.1). Timeout = the deadline passed (outcome `Deadline` of std:taskcore),\n// Closed = the channel is closed and drained (outcome `Closed`), ClockUnavailable = the monotonic clock failed, InvalidDuration =\n// a negative timeout.\nexport type TaskErrorKind = Timeout | Closed | ClockUnavailable | InvalidDuration;\nexport type TaskError = { kind: TaskErrorKind; };\n\n// taskErrorMessage(e): a stable, nonempty explanation.\n@Ensures(result.length > 0)\nexport function taskErrorMessage(e: TaskError): string {\n  return match (e.kind) {\n    Timeout => \"the deadline passed\",\n    Closed => \"the channel is closed\",\n    ClockUnavailable => \"monotonic clock unavailable\",\n    InvalidDuration => \"a timeout must not be negative\"\n  };\n}\n\nfunction fail(kind: TaskErrorKind): TaskError {\n  return TaskError { kind: kind };\n}\n\n// The absolute deadline `timeout` after now (saturating: a huge timeout means practically never).\nfunction deadlineIn(clock: ClockGrant, timeout: Duration): Result<Deadline, TaskError> {\n  if (timeout.millis < 0) {\n    return Err(fail(InvalidDuration));\n  }\n  const now = monotonicNow(clock);\n  if (now.isErr()) {\n    return Err(fail(ClockUnavailable));\n  }\n  return Ok(Deadline { at: MonotonicInstant { millis: deadlineAfterMillis(now.unwrap().millis, timeout.millis) } });\n}\n\n// ------------------------------------------------------------------------------------------------------ channels\n\n// Monitor words of a channel: [0] capacity, [1] head, [2] len, [3] flags (1 = tx closed, 2 = rx closed), [4] number of\n// watchers (the wake monitors of `select` calls waiting on this channel), [5] room for watchers, [6 + i] the token in ring\n// slot i, [6 + capacity + k] watcher k.\nconst CH_HDR: usize = 6;\n\n// The channel functions work on the monitor's words as plain locals (cap, head, len, flags) with the arithmetic of\n// std:taskcore's `Ring` (`ringCanPush`, `ringSlot`, ...): a `Ring` object per send / receive was 40% of the allocations\n// of a channel benchmark. The words are loaded, changed and stored back inside one critical section, as before.\nfunction chTx(flags: usize): bool {\n  return flags % 2 == 1;\n}\n\nfunction chRx(flags: usize): bool {\n  return flags >= 2;\n}\n\n// A monitor has two condition queues: 0 = \"there is room\" (blocked senders), 1 = \"there is a value\" (blocked receivers). A\n// send wakes one receiver, a receive wakes one sender, a close wakes everybody.\nfunction wakeAll(m: usize): void {\n  monNotifyAll(m, 0);\n  monNotifyAll(m, 1);\n  pingWatchers(m);\n}\n\n// Wakes every `select` waiting on the channel (locked by the caller): bumps the ticket (word 0) of each watcher's monitor. Lock\n// order is channel, then watcher; a selector never holds its watcher monitor while it takes a channel.\nfunction pingWatchers(ch: usize): void {\n  const n = monGet(ch, 4);\n  const base = CH_HDR + monGet(ch, 0);\n  let k: usize = 0;\n  while (k < n) {\n    const w = monGet(ch, base + k);\n    monLock(w);\n    monSet(w, 0, monGet(w, 0) + 1);\n    monNotifyAll(w, 0);\n    monUnlock(w);\n    k += 1;\n  }\n}\n\n// Takes the oldest value (the channel is locked, len > 0) and returns its token; the caller unlocks and calls takeBox.\nfunction popLocked(ch: usize, cap: usize, head: usize, len: usize, flags: usize): usize {\n  const tok = monGet(ch, CH_HDR + head);\n  storeRing(ch, ringNextHead(cap, head), len - 1, flags);\n  monNotifyOne(ch, 0);\n  return tok;\n}\n\nfunction storeRing(m: usize, head: usize, len: usize, flags: usize): void {\n  monSet(m, 1, head);\n  monSet(m, 2, len);\n  monSet(m, 3, flags);\n}\n\n// The sending end of a channel. A copy refers to the same channel. A monitor handle is never 0: a forged `new Sender<T>(0)` is a\n// contract violation (and any other forged handle is refused by the platform layer at its first use).\n@Invariant(this.ch != 0)\nexport class Sender<T> {\n  ch: usize;\n\n  @Requires(ch != 0)\n  constructor(ch: usize) {\n    this.ch = ch;\n  }\n\n  // send(v): blocks while the channel is full; true when `v` was handed to the channel (moved if it is uniquely owned,\n  // copied otherwise); false when the channel is closed by either end, in which case `v` is dropped.\n  send(v: T): bool {\n    const tok = putBox<T>(v);\n    const ch = this.ch;\n    monLock(ch);\n    const cap = monGet(ch, 0);\n    let head = monGet(ch, 1);\n    let len = monGet(ch, 2);\n    let flags = monGet(ch, 3);\n    while (!ringCanPush(len, cap, chTx(flags), chRx(flags)) && flags == 0) {\n      monWait(ch, 0);\n      head = monGet(ch, 1);\n      len = monGet(ch, 2);\n      flags = monGet(ch, 3);\n    }\n    if (!ringCanPush(len, cap, chTx(flags), chRx(flags))) {\n      monUnlock(ch);\n      transitDrop(tok);\n      return false;\n    }\n    const slot = ringSlot(cap, head, len);\n    monSet(ch, CH_HDR + slot, tok);\n    storeRing(ch, head, len + 1, flags);\n    monNotifyOne(ch, 1);\n    pingWatchers(ch);\n    monUnlock(ch);\n    return true;\n  }\n\n  // sendUntil(v, deadline): send(v) that gives up when the absolute monotonic deadline passes while the channel is full:\n  // Err(Timeout), or Err(Closed) when it is closed by either end. `v` is dropped on an error. A free slot at the deadline\n  // still accepts it. Traps if the deadline is negative.\n  @Requires(deadline.at.millis >= 0)\n  sendUntil(v: T, deadline: Deadline): Result<void, TaskError> {\n    const tok = putBox(v);\n    const ch = this.ch;\n    const dl = deadline.at.millis.toUsize();\n    monLock(ch);\n    const cap = monGet(ch, 0);\n    let head = monGet(ch, 1);\n    let len = monGet(ch, 2);\n    let flags = monGet(ch, 3);\n    let late = false;\n    while (!ringCanPush(len, cap, chTx(flags), chRx(flags)) && flags == 0 && !late) {\n      late = monWaitUntil(ch, 0, dl) == 1;\n      head = monGet(ch, 1);\n      len = monGet(ch, 2);\n      flags = monGet(ch, 3);\n    }\n    if (!ringCanPush(len, cap, chTx(flags), chRx(flags))) {\n      monUnlock(ch);\n      transitDrop(tok);\n      return Err(fail(flags != 0 ? Closed : Timeout));\n    }\n    const slot = ringSlot(cap, head, len);\n    monSet(ch, CH_HDR + slot, tok);\n    storeRing(ch, head, len + 1, flags);\n    monNotifyOne(ch, 1);\n    pingWatchers(ch);\n    monUnlock(ch);\n    return Ok();\n  }\n\n  // sendTimeout(clock, v, timeout): sendUntil(v, now + timeout). Err(InvalidDuration) for a negative timeout.\n  sendTimeout(clock: ClockGrant, v: T, timeout: Duration): Result<void, TaskError> {\n    const d = deadlineIn(clock, timeout)?;\n    return this.sendUntil(v, d);\n  }\n\n  // close(): no more values will be sent; receivers drain what is buffered and then get None.\n  close(): void {\n    const ch = this.ch;\n    monLock(ch);\n    let flags = monGet(ch, 3);\n    if (!chTx(flags)) {\n      flags += 1;\n    }\n    monSet(ch, 3, flags);\n    wakeAll(ch);\n    const done = chTx(flags) && chRx(flags);\n    monUnlock(ch);\n    if (done) {\n      monFree(ch);\n    }\n  }\n}\n\n// The receiving end of a channel. A copy refers to the same channel (several receivers share the stream).\n@Invariant(this.ch != 0)\nexport class Receiver<T> {\n  ch: usize;\n\n  @Requires(ch != 0)\n  constructor(ch: usize) {\n    this.ch = ch;\n  }\n\n  // recv(): blocks while the channel is empty; Some(v) with the oldest value, or None once the channel is closed and\n  // drained (or cancelled by rx.close()).\n  recv(): Option<T> {\n    const ch = this.ch;\n    monLock(ch);\n    const cap = monGet(ch, 0);\n    let head = monGet(ch, 1);\n    let len = monGet(ch, 2);\n    let flags = monGet(ch, 3);\n    while (len == 0 && !ringIsDone(len, chTx(flags), chRx(flags))) {\n      monWait(ch, 1);\n      head = monGet(ch, 1);\n      len = monGet(ch, 2);\n      flags = monGet(ch, 3);\n    }\n    if (len == 0) {\n      monUnlock(ch);\n      return None;\n    }\n    const tok = monGet(ch, CH_HDR + head);\n    storeRing(ch, ringNextHead(cap, head), len - 1, flags);\n    monNotifyOne(ch, 0);\n    monUnlock(ch);\n    const v: T = takeBox(tok);\n    return Some(v);\n  }\n\n  // recvUntil(deadline): recv() that gives up when the absolute monotonic deadline passes while the channel is empty:\n  // Ok(value), Err(Timeout), or Err(Closed) once the channel is closed and drained. A value that is already there is\n  // returned even if the deadline has passed. Traps if the deadline is negative.\n  @Requires(deadline.at.millis >= 0)\n  recvUntil(deadline: Deadline): Result<T, TaskError> {\n    const ch = this.ch;\n    const dl = deadline.at.millis.toUsize();\n    monLock(ch);\n    const cap = monGet(ch, 0);\n    let head = monGet(ch, 1);\n    let len = monGet(ch, 2);\n    let flags = monGet(ch, 3);\n    let late = false;\n    while (len == 0 && !ringIsDone(len, chTx(flags), chRx(flags)) && !late) {\n      late = monWaitUntil(ch, 1, dl) == 1;\n      head = monGet(ch, 1);\n      len = monGet(ch, 2);\n      flags = monGet(ch, 3);\n    }\n    if (len == 0) {\n      monUnlock(ch);\n      return Err(fail(ringIsDone(len, chTx(flags), chRx(flags)) ? Closed : Timeout));\n    }\n    const tok = popLocked(ch, cap, head, len, flags);\n    monUnlock(ch);\n    const v: T = takeBox(tok);\n    return Ok(v);\n  }\n\n  // recvTimeout(clock, timeout): recvUntil(now + timeout). Err(InvalidDuration) for a negative timeout.\n  recvTimeout(clock: ClockGrant, timeout: Duration): Result<T, TaskError> {\n    const d = deadlineIn(clock, timeout)?;\n    return this.recvUntil(d);\n  }\n\n  // close(): this end is done: buffered values are dropped, a blocked or later send returns false.\n  close(): void {\n    const ch = this.ch;\n    monLock(ch);\n    const cap = monGet(ch, 0);\n    let head = monGet(ch, 1);\n    let len = monGet(ch, 2);\n    let flags = monGet(ch, 3);\n    let toks: usize[] = [];\n    while (len > 0) {\n      toks.push(monGet(ch, CH_HDR + head));\n      head = ringNextHead(cap, head);\n      len -= 1;\n    }\n    if (!chRx(flags)) {\n      flags += 2;\n    }\n    storeRing(ch, head, len, flags);\n    wakeAll(ch);\n    const done = chTx(flags) && chRx(flags);\n    monUnlock(ch);\n    for (const t of toks) {\n      transitDrop(t);\n    }\n    if (done) {\n      monFree(ch);\n    }\n  }\n}\n\n// The two ends of a channel.\nexport type Channel<T> = { tx: Sender<T>; rx: Receiver<T>; };\n\n// channel<T>(capacity): a bounded channel of at least one slot. A capacity of 0 (rendezvous) is not supported in stage 0:\n// E0482 for a constant, a trap otherwise (also without contract checking). Both ends refer to the same channel.\n@Requires(capacity >= 1)\n@Ensures(result.tx.ch == result.rx.ch)\nexport function channel<T>(capacity: usize): Channel<T> {\n  if (capacity == 0) {\n    taskTrap(\"channel capacity must be at least 1\");\n  }\n  const m = monNew(CH_HDR + capacity);\n  monLock(m);\n  monSet(m, 0, capacity);\n  monUnlock(m);\n  return Channel<T> { tx: new Sender<T>(m), rx: new Receiver<T>(m) };\n}\n\n// ------------------------------------------------------------------------------------------------------ select, sleep\n\n// The result of a `select`: which receiver (position in the array) delivered, and the value.\nexport type Selected<T> = { index: usize; value: T; };\n\n// Registers the wake monitor `w` of a select with the channel (and removes it again).\nfunction watch(ch: usize, w: usize): void {\n  monLock(ch);\n  const base = CH_HDR + monGet(ch, 0);\n  const n = monGet(ch, 4);\n  const room = monGet(ch, 5);\n  if (n == room) {\n    const grown = room == 0 ? 2 : room * 2;\n    monGrow(ch, base + grown);\n    monSet(ch, 5, grown);\n  }\n  monSet(ch, base + n, w);\n  monSet(ch, 4, n + 1);\n  monUnlock(ch);\n}\n\nfunction unwatch(ch: usize, w: usize): void {\n  monLock(ch);\n  const base = CH_HDR + monGet(ch, 0);\n  const n = monGet(ch, 4);\n  let k: usize = 0;\n  while (k < n) {\n    if (monGet(ch, base + k) == w) {\n      monSet(ch, base + k, monGet(ch, base + n - 1));\n      monSet(ch, 4, n - 1);\n      k = n;\n    } else {\n      k += 1;\n    }\n  }\n  monUnlock(ch);\n}\n\n// One monitor `w` (word 0 = a ticket) is registered with every channel; a send or close on any of them bumps the ticket and\n// notifies. The selector reads the ticket, scans the channels in order (the first with a value wins), and waits only while the\n// ticket is unchanged, so a send between the scan and the wait is never lost; it holds no monitor while it takes another. A\n// deadline `dl` < 0 means none.\nfunction selectCore<T>(rxs: Receiver<T>[], dl: int): Result<Selected<T>, TaskError> {\n  const n = rxs.length;\n  const w = monNew(1);\n  let k: usize = 0;\n  while (k < n) {\n    watch(rxs[k].ch, w);\n    k += 1;\n  }\n  let state = 0;\n  let index: usize = 0;\n  let tok: usize = 0;\n  let late = false;\n  while (state == 0) {\n    monLock(w);\n    const ticket = monGet(w, 0);\n    monUnlock(w);\n    let closed: usize = 0;\n    let j: usize = 0;\n    while (j < n && state == 0) {\n      const ch = rxs[j].ch;\n      monLock(ch);\n      const cap = monGet(ch, 0);\n      const head = monGet(ch, 1);\n      const len = monGet(ch, 2);\n      const flags = monGet(ch, 3);\n      if (len > 0) {\n        tok = popLocked(ch, cap, head, len, flags);\n        index = j;\n        state = 1;\n      } else if (ringIsDone(len, chTx(flags), chRx(flags))) {\n        closed += 1;\n      }\n      monUnlock(ch);\n      j += 1;\n    }\n    if (state == 0 && closed == n) {\n      state = 2;\n    } else if (state == 0 && late) {\n      state = 3;\n    } else if (state == 0) {\n      monLock(w);\n      while (monGet(w, 0) == ticket && !late) {\n        if (dl < 0) {\n          monWait(w, 0);\n        } else {\n          late = monWaitUntil(w, 0, dl.toUsize()) == 1;\n        }\n      }\n      monUnlock(w);\n    }\n  }\n  k = 0;\n  while (k < n) {\n    unwatch(rxs[k].ch, w);\n    k += 1;\n  }\n  monFree(w);\n  if (state == 1) {\n    const v: T = takeBox(tok);\n    return Ok(Selected<T> { index: index, value: v });\n  }\n  return Err(fail(state == 2 ? Closed : Timeout));\n}\n\n// select(rxs): waits until one of the receivers has a value and returns its position and the value (the first ready receiver in\n// array order wins a tie). Receivers that are closed and drained are skipped; Err(Closed) when all of them are. The receivers\n// must carry one value type (use a variant for different kinds). Traps on an empty array.\n@Requires(rxs.length >= 1)\nexport function select<T>(rxs: Receiver<T>[]): Result<Selected<T>, TaskError> {\n  return selectCore(rxs, -1);\n}\n\n// selectUntil(rxs, deadline): select that gives up with Err(Timeout) when the absolute monotonic deadline passes first. A value\n// that is already there is delivered even if the deadline has passed. Traps if the deadline is negative.\n@Requires(rxs.length >= 1 && deadline.at.millis >= 0)\nexport function selectUntil<T>(rxs: Receiver<T>[], deadline: Deadline): Result<Selected<T>, TaskError> {\n  return selectCore(rxs, deadline.at.millis);\n}\n\n// selectTimeout(clock, rxs, timeout): selectUntil(rxs, now + timeout). Err(InvalidDuration) for a negative timeout.\n@Requires(rxs.length >= 1)\nexport function selectTimeout<T>(clock: ClockGrant, rxs: Receiver<T>[], timeout: Duration): Result<Selected<T>, TaskError> {\n  const d = deadlineIn(clock, timeout)?;\n  return selectCore(rxs, d.at.millis);\n}\n\n// sleepUntil(deadline): blocks until the absolute monotonic deadline has passed (at least that long: never early; returns at once\n// when it has passed). Traps if the deadline is negative.\n@Requires(deadline.at.millis >= 0)\nexport function sleepUntil(deadline: Deadline): void {\n  const m = monNew(1);\n  monLock(m);\n  let late = false;\n  while (!late) {\n    late = monWaitUntil(m, 0, deadline.at.millis.toUsize()) == 1;\n  }\n  monUnlock(m);\n  monFree(m);\n}\n\n// sleep(clock, timeout): blocks for at least `timeout` on the monotonic clock. Err(InvalidDuration) for a negative timeout,\n// Err(ClockUnavailable) when the clock cannot be read.\nexport function sleep(clock: ClockGrant, timeout: Duration): Result<void, TaskError> {\n  const d = deadlineIn(clock, timeout)?;\n  sleepUntil(d);\n  return Ok();\n}\n\n// ------------------------------------------------------------------------------------------------------ scopes\n\nconst LG_HDR: usize = 5;\nconst LG_WAKE: usize = 4; // header word of the scope's cancellation token (0 = none: the table was full or the nesting too deep)\nconst LG_STRIDE: usize = 3;\nconst LG_FIRST: usize = 8;\n\nfunction loadLedger(m: usize): Ledger {\n  return new Ledger(monGet(m, 0), monGet(m, 1), monGet(m, 2) == 1);\n}\n\n// First word of the entry of task i.\nfunction entry(i: usize): usize {\n  return LG_HDR + LG_STRIDE * i;\n}\n\n// The cancellation token of the scope whose task table is `tab`; traps when it has none.\nfunction scopeWake(tab: usize): usize {\n  monLock(tab);\n  const w = monGet(tab, LG_WAKE);\n  monUnlock(tab);\n  if (w == 0) {\n    taskTrap(\"this scope has no cancellation token (token table full or scopes nested too deep)\");\n  }\n  return w;\n}\n\n// A cancellation token: a copyable value that cancels the scope it came from (`Scope.token()`), also from another task. It holds a\n// generation-tagged handle of L0: after the scope ended it is stale, `cancel()` then does nothing and `isCancelled()` is false.\n@Invariant(this.wake >= 0)\nexport class CancelToken {\n  private wake: usize;\n\n  constructor(wake: usize) {\n    this.wake = wake;\n  }\n\n  // cancel(): sets the token. Returns true when this call cancelled it, false when it was cancelled already or is stale. Waits of\n  // std:net observing the token (the scope's tasks, and the tasks of scopes nested in them) return `Err(Cancelled)`. O(1).\n  cancel(): bool {\n    return wakeSignal(this.wake) == 1;\n  }\n\n  // isCancelled(): the token or an ancestor scope's token is set. False for a stale token. O(depth).\n  isCancelled(): bool {\n    return wakeCheck(this.wake) == 1;\n  }\n}\n\n// isCancelled(): the calling task's own token, or an ancestor's, is set: it should stop at its next convenient point. A task that\n// is not inside any scope is never cancelled. O(depth).\nexport function isCancelled(): bool {\n  return wakeCheck(wakeBound()) == 1;\n}\n\n// A scope: the handle of a task table. `scope` makes one and passes it to its body; it is valid only until `scope` returns.\n@Invariant(this.tab != 0)\nexport class Scope {\n  tab: usize;\n\n  @Requires(tab != 0)\n  constructor(tab: usize) {\n    this.tab = tab;\n  }\n\n  // spawn<T>(f): starts `f` as a task of the scope and returns its handle; T may be void (ADR-0040). `f` and everything it\n  // captures move to the task (unique values) or are copied to it; the task cannot affect the spawner's values. A body that\n  // captures a resource handle is E0483, one that captures a `Scope` is E0481. Traps when the scope has ended or no thread\n  // can be started.\n  @Ensures(result.tab == this.tab)\n  spawn<T>(f: () => T): TaskHandle<T> {\n    const res = monNew(2);\n    monLock(this.tab);\n    const own = monGet(this.tab, LG_WAKE);\n    monUnlock(this.tab);\n    const wake = own != 0 ? own : wakeBound(); // a scope without a token of its own passes the spawner's on\n    const body: Thunk = () => runTask(f, wake, res);\n    const tok = putBox(body);\n    monLock(this.tab);\n    let lg = loadLedger(this.tab);\n    if (lg.closed) {\n      monUnlock(this.tab);\n      transitDrop(tok);\n      monFree(res);\n      taskTrap(\"spawn in a scope that has ended\");\n    }\n    const idx = lg.add();\n    const need = entry(idx) + LG_STRIDE;\n    const have = monGet(this.tab, 3);\n    if (need > have) {\n      monGrow(this.tab, have * 2);\n      monSet(this.tab, 3, have * 2);\n    }\n    monSet(this.tab, 0, lg.count);\n    monSet(this.tab, entry(idx), 0);\n    monSet(this.tab, entry(idx) + 1, res);\n    monSet(this.tab, entry(idx) + 2, 0);\n    monUnlock(this.tab);\n    const th = taskSpawn(tok);\n    monLock(this.tab);\n    monSet(this.tab, entry(idx), th);\n    monNotifyAll(this.tab, 0);\n    monUnlock(this.tab);\n    return new TaskHandle<T>(this.tab, idx, res);\n  }\n\n  // token(): the scope's cancellation token, to hand to tasks (`s.spawn(() => ... token.cancel() ...)`). Traps if the scope has\n  // none (the token table is full, or scopes are nested more than 32 deep).\n  token(): CancelToken {\n    return new CancelToken(scopeWake(this.tab));\n  }\n\n  // cancel(): `token().cancel()`.\n  cancel(): bool {\n    return wakeSignal(scopeWake(this.tab)) == 1;\n  }\n\n  // isCancelled(): the scope's token (or an ancestor's) is set.\n  isCancelled(): bool {\n    return wakeCheck(scopeWake(this.tab)) == 1;\n  }\n}\n\n// A started task. `join` may be called once; a second call, or a call after the scope has ended, traps.\n@Invariant(this.tab != 0 && this.res != 0)\nexport class TaskHandle<T> {\n  tab: usize;\n  idx: usize;\n  res: usize;\n\n  @Requires(tab != 0 && res != 0)\n  constructor(tab: usize, idx: usize, res: usize) {\n    this.tab = tab;\n    this.idx = idx;\n    this.res = res;\n  }\n\n  // join(): waits for the task and returns its result. If the task panicked, traps with `task panicked: <message>`.\n  join(): T {\n    monLock(this.tab);\n    const st = monGet(this.tab, entry(this.idx) + 2);\n    if (st != 0) {\n      monUnlock(this.tab);\n      taskTrap(\"task joined twice (or after the end of its scope)\");\n    }\n    monSet(this.tab, entry(this.idx) + 2, 1);\n    const th = monGet(this.tab, entry(this.idx));\n    monUnlock(this.tab);\n    const status = taskJoin(th);\n    if (status != 0) {\n      monFree(this.res);\n      taskTrap(\"task panicked: \" + taskMessage());\n    }\n    monLock(this.res);\n    const tok = monGet(this.res, 0);\n    monUnlock(this.res);\n    monFree(this.res);\n    return takeBox<T>(tok);\n  }\n\n  // joinUntil(deadline): waits for the task until the absolute monotonic deadline. Err(Timeout) if it has not ended by then (the\n  // handle stays valid: join or joinUntil it again); otherwise exactly `join()` (a panic of the task is a trap of the joiner).\n  // Traps if the deadline is negative, or the handle was joined before.\n  @Requires(deadline.at.millis >= 0)\n  joinUntil(deadline: Deadline): Result<T, TaskError> {\n    const dl = deadline.at.millis.toUsize();\n    monLock(this.res);\n    let late = false;\n    while (monGet(this.res, 1) == 0 && !late) {\n      late = monWaitUntil(this.res, 0, dl) == 1;\n    }\n    const ended = monGet(this.res, 1) != 0;\n    monUnlock(this.res);\n    if (!ended) {\n      return Err(fail(Timeout));\n    }\n    return Ok(this.join());\n  }\n\n  // joinTimeout(clock, timeout): joinUntil(now + timeout). Err(InvalidDuration) for a negative timeout.\n  joinTimeout(clock: ClockGrant, timeout: Duration): Result<T, TaskError> {\n    const d = deadlineIn(clock, timeout)?;\n    return this.joinUntil(d);\n  }\n}\n\n// tryJoin(h): `h.join()` that returns None instead of trapping when the task panicked (its message is then `taskMessage()`).\n// A second join still traps. (`join` keeps its own copy of these lines so that programs that do not use the fork/join pool\n// compile to the same code as before the pool was added.)\nfunction tryJoin<T>(h: TaskHandle<T>): Option<T> {\n  monLock(h.tab);\n  const st = monGet(h.tab, entry(h.idx) + 2);\n  if (st != 0) {\n    monUnlock(h.tab);\n    taskTrap(\"task joined twice (or after the end of its scope)\");\n  }\n  monSet(h.tab, entry(h.idx) + 2, 1);\n  const th = monGet(h.tab, entry(h.idx));\n  monUnlock(h.tab);\n  const status = taskJoin(th);\n  if (status != 0) {\n    monFree(h.res);\n    return None;\n  }\n  monLock(h.res);\n  const tok = monGet(h.res, 0);\n  monUnlock(h.res);\n  monFree(h.res);\n  const v: T = takeBox<T>(tok);\n  return Some(v);\n}\n\n// What a task does, as the runtime runs it: compute, publish the result in the result monitor. Result monitor words: [0] the token\n// of the result, [1] 1 once the task has ended (by return or trap; set by the runtime, taskWatch), which `joinUntil` waits for.\nfunction runTask<T>(f: () => T, wake: usize, res: usize): void {\n  wakeBind(wake);\n  taskWatch(res);\n  const r = f();\n  const tok = putBox<T>(r);\n  monLock(res);\n  monSet(res, 0, tok);\n  monUnlock(res);\n}\n\n// spawn(s, f): the function form of `s.spawn(f)`.\n@Deprecated(\"use s.spawn(f)\")\nexport function spawn<T>(s: Scope, f: () => T): TaskHandle<T> {\n  return s.spawn(f);\n}\n\n// spawnDo(s, f): spawn for a body that returns nothing; join() then returns true.\n@Deprecated(\"use s.spawn(f), which accepts a void body (TaskHandle<void>)\")\nexport function spawnDo(s: Scope, f: () => void): TaskHandle<bool> {\n  return s.spawn(() => {\n    f();\n    return true;\n  });\n}\n\n// Joins every task of the table that nobody joined, closes the table and returns \"\" or the message of the first panic.\nfunction drain(tab: usize): string {\n  let failure = \"\";\n  let more = true;\n  while (more) {\n    monLock(tab);\n    let lg = loadLedger(tab);\n    if (lg.isScanned()) {\n      lg.close();\n      monSet(tab, 2, 1);\n      monUnlock(tab);\n      more = false;\n    } else {\n      const e = entry(lg.cursor);\n      const claimed = monGet(tab, e + 2) != 0;\n      const th = monGet(tab, e);\n      if (claimed) {\n        lg.advance();\n        monSet(tab, 1, lg.cursor);\n        monUnlock(tab);\n      } else if (th == 0) {\n        monWait(tab, 0);\n        monUnlock(tab);\n      } else {\n        const res = monGet(tab, e + 1);\n        monSet(tab, e + 2, 1);\n        lg.advance();\n        monSet(tab, 1, lg.cursor);\n        monUnlock(tab);\n        const status = taskJoin(th);\n        if (status != 0) {\n          if (failure == \"\") {\n            failure = taskMessage();\n          }\n        } else {\n          monLock(res);\n          const tok = monGet(res, 0);\n          monUnlock(res);\n          transitDrop(tok);\n        }\n        monFree(res);\n      }\n    }\n  }\n  return failure;\n}\n\n// begin(): a new, empty task table.\n@Ensures(result != 0)\nfunction begin(): usize {\n  const tab = monNew(LG_FIRST * LG_STRIDE);\n  const w = wakeOpen(); // binds the new token to this thread: the body of the scope observes it too\n  monLock(tab);\n  monSet(tab, 3, LG_FIRST * LG_STRIDE);\n  monSet(tab, LG_WAKE, w);\n  monUnlock(tab);\n  return tab;\n}\n\n// finish(tab): joins every task of the table, frees it, and panics if a task nobody joined panicked.\nfunction finish(tab: usize): void {\n  const failure = drain(tab);\n  monLock(tab);\n  const w = monGet(tab, LG_WAKE);\n  monUnlock(tab);\n  if (w != 0) {\n    wakeClose(w); // every task has ended: nothing waits on the token any more; the thread is bound to the enclosing token again\n  }\n  monFree(tab);\n  if (failure != \"\") {\n    taskTrap(\"task panicked: \" + failure);\n  }\n}\n\n// scope(body): runs `body` with a new scope and returns its result after every task spawned in the scope has ended. See the\n// header comment for panics.\nexport function scope<R>(body: (s: Scope) => R): R {\n  const tab = begin();\n  const r = body(new Scope(tab));\n  finish(tab);\n  return r;\n}\n\n// scopeFs(fs, body), scopeProcess, scopeStdio, scopeClock: `scope` for a body that also uses a grant. A closure cannot\n// capture a grant (E0452), so the grant is passed through: the body gets it back as a second parameter (the same shape as\n// `withFileFs` of std:fs). Use it with the matching spawnFs / spawnProcess / spawnStdio / spawnClock.\nexport function scopeFs<R>(fs: FsGrant, body: (s: Scope, g: FsGrant) => R): R {\n  const tab = begin();\n  const r = body(new Scope(tab), fs);\n  finish(tab);\n  return r;\n}\n\nexport function scopeProcess<R>(proc: ProcessGrant, body: (s: Scope, g: ProcessGrant) => R): R {\n  const tab = begin();\n  const r = body(new Scope(tab), proc);\n  finish(tab);\n  return r;\n}\n\nexport function scopeStdio<R>(stdio: StdioGrant, body: (s: Scope, g: StdioGrant) => R): R {\n  const tab = begin();\n  const r = body(new Scope(tab), stdio);\n  finish(tab);\n  return r;\n}\n\nexport function scopeClock<R>(clock: ClockGrant, body: (s: Scope, g: ClockGrant) => R): R {\n  const tab = begin();\n  const r = body(new Scope(tab), clock);\n  finish(tab);\n  return r;\n}\n\n// scopeNet(net, body): `scope` for a body that also uses a NetGrant (ADR-0017 Addendum C), for spawnNet and for a server that\n// binds a listener inside the scope (`useListener(g, ..)`) and hands accepted connections to tasks.\nexport function scopeNet<R>(net: NetGrant, body: (s: Scope, g: NetGrant) => R): R {\n  const tab = begin();\n  const r = body(new Scope(tab), net);\n  finish(tab);\n  return r;\n}\n\n// scopeDo(body), scopeFsDo, ...: the old flavours for a body that returns nothing. `scope` and `scopeFs` ... accept a void\n// body now (ADR-0040); these wrappers stay one release.\n@Deprecated(\"use scope(body) with a void body\")\nexport function scopeDo(body: (s: Scope) => void): void {\n  scope(body);\n}\n\n@Deprecated(\"use scopeFs(fs, body) with a void body\")\nexport function scopeFsDo(fs: FsGrant, body: (s: Scope, g: FsGrant) => void): void {\n  scopeFs(fs, body);\n}\n\n@Deprecated(\"use scopeProcess(proc, body) with a void body\")\nexport function scopeProcessDo(proc: ProcessGrant, body: (s: Scope, g: ProcessGrant) => void): void {\n  scopeProcess(proc, body);\n}\n\n@Deprecated(\"use scopeStdio(stdio, body) with a void body\")\nexport function scopeStdioDo(stdio: StdioGrant, body: (s: Scope, g: StdioGrant) => void): void {\n  scopeStdio(stdio, body);\n}\n\n@Deprecated(\"use scopeNet(net, body) with a void body\")\nexport function scopeNetDo(net: NetGrant, body: (s: Scope, g: NetGrant) => void): void {\n  scopeNet(net, body);\n}\n\n@Deprecated(\"use scopeClock(clock, body) with a void body\")\nexport function scopeClockDo(clock: ClockGrant, body: (s: Scope, g: ClockGrant) => void): void {\n  scopeClock(clock, body);\n}\n\n// ------------------------------------------------------------------------------------------------------ delegating grants\n//\n// A grant is a resource handle (ADR-0025, ADR-0027): it is only ever a parameter, never a captured or sent value. To give\n// authority to a task, the spawner DERIVES a grant of the same family (never more authority than its own: same scope, same\n// flags), MOVES it into the task, and the task's wrapper adopts it, passes it to the body as a parameter and revokes it\n// when the body returns (the runtime also revokes it if the task panics). The compiler checks both halves: the derived handle\n// is moved exactly once on every path of the spawner (the MIR verifier's closer rule), and the adopted one is revoked\n// exactly once on every path of the task wrapper. The spawner's own grant is untouched.\n\nfunction runFs<T>(tok: usize, body: (g: FsGrant) => T): T {\n  const g = grantAdoptFs(tok);\n  const r = body(g);\n  grantRevoke(g);\n  return r;\n}\n\nfunction runProcess<T>(tok: usize, body: (g: ProcessGrant) => T): T {\n  const g = grantAdoptProcess(tok);\n  const r = body(g);\n  grantRevoke(g);\n  return r;\n}\n\nfunction runStdio<T>(tok: usize, body: (g: StdioGrant) => T): T {\n  const g = grantAdoptStdio(tok);\n  const r = body(g);\n  grantRevoke(g);\n  return r;\n}\n\nfunction runClock<T>(tok: usize, body: (g: ClockGrant) => T): T {\n  const g = grantAdoptClock(tok);\n  const r = body(g);\n  grantRevoke(g);\n  return r;\n}\n\nfunction runNet<T>(tok: usize, body: (g: NetGrant) => T): T {\n  const g = grantAdoptNet(tok);\n  const r = body(g);\n  grantRevoke(g);\n  return r;\n}\n\n// spawnFs(s, fs, body): a task whose body gets a file-system grant of the authority of `fs`, owned by the task.\nexport function spawnFs<T>(s: Scope, fs: FsGrant, body: (g: FsGrant) => T): TaskHandle<T> {\n  const c = grantClone(fs);\n  const tok = grantMove(c);\n  return s.spawn(() => runFs(tok, body));\n}\n\nexport function spawnProcess<T>(s: Scope, proc: ProcessGrant, body: (g: ProcessGrant) => T): TaskHandle<T> {\n  const c = grantClone(proc);\n  const tok = grantMove(c);\n  return s.spawn(() => runProcess(tok, body));\n}\n\nexport function spawnStdio<T>(s: Scope, stdio: StdioGrant, body: (g: StdioGrant) => T): TaskHandle<T> {\n  const c = grantClone(stdio);\n  const tok = grantMove(c);\n  return s.spawn(() => runStdio(tok, body));\n}\n\nexport function spawnClock<T>(s: Scope, clock: ClockGrant, body: (g: ClockGrant) => T): TaskHandle<T> {\n  const c = grantClone(clock);\n  const tok = grantMove(c);\n  return s.spawn(() => runClock(tok, body));\n}\n\n// spawnNet(s, net, body): a task whose body gets a network grant of the authority of `net` (the same scope: listen address,\n// connect pattern and ports, and the ORIN_DENY policy), owned by the task. A task that needs more than one connection\n// binds, accepts and connects through it; a task that serves ONE accepted connection is started with `spawnAccepted` of\n// std:net, which moves the connection itself.\nexport function spawnNet<T>(s: Scope, net: NetGrant, body: (g: NetGrant) => T): TaskHandle<T> {\n  const c = grantClone(net);\n  const tok = grantMove(c);\n  return s.spawn(() => runNet(tok, body));\n}\n\n// ------------------------------------------------------------------------------------------------------ parallelMap\n\n// parallelMap(xs, f, parts): `xs.map(f)` computed by `parts` tasks, each mapping one contiguous chunk; the result is in\n// order. `f` is copied to every task, each chunk moves or is copied to its task. parts = 0 or 1 maps in the calling task.\n@Ensures(result.length == xs.length)\nexport function parallelMap<A, B>(xs: A[], f: (x: A) => B, parts: usize): B[] {\n  if (parts <= 1 || xs.length <= 1) {\n    return xs.map(f);\n  }\n  const n = parts < xs.length ? parts : xs.length;\n  const size = (xs.length + n - 1) / n;\n  return scope(s => {\n    let hs: TaskHandle<B[]>[] = [];\n    let lo: usize = 0;\n    while (lo < xs.length) {\n      const hi = lo + size < xs.length ? lo + size : xs.length;\n      const chunk = xs.slice(lo, hi);\n      hs.push(s.spawn(() => chunk.map(f)));\n      lo = hi;\n    }\n    let out: B[] = [];\n    for (const h of hs) {\n      out = out.concat(h.join());\n    }\n    return out;\n  });\n}\n\n// ------------------------------------------------------------------------------------------------------ fork/join pool\n//\n// The pool behind `parallel()` on an array `xs` (ADR-0039, docs/std.md \"Parallel pipelines\"); usable directly too. A computation is split\n// into `chunks` numbered pieces; `body(k)` computes piece k. With `workers` >= 2 the pool starts that many worker tasks for\n// the call (a pool lives for one call: structured, like `scope`). Worker w starts with the contiguous range of pieces\n// w * chunks / workers .. (w + 1) * chunks / workers - 1 and takes them from the front; when its range is empty it STEALS the\n// back half of the largest range left (std:taskcore `Ranges`, kept in one monitor). Results are put back in piece order,\n// so the result never depends on the number of workers or on who computed what. With `workers` <= 1 the pieces run in\n// order on the calling task. A panic in a piece cancels the pieces nobody has started, waits for the workers that are\n// still running and then traps the caller with the piece's own message (so a parallel pipeline traps like the sequential\n// one). `body` is copied to every worker like any task body: what it captures moves or is copied (`parallel()` lends\n// its input array instead, see \"lending\" in runtime/core/orin_runtime.c).\n\n// A finished piece: its number and its result.\ntype Done<R> = { k: usize; r: R; };\n\n// Monitor words of a pool: [0] chunks, [1] cut, [2] workers, then lo / hi of every worker.\nconst POOL_HDR: usize = 3;\n\nfunction loadRanges(m: usize): Ranges {\n  const n = monGet(m, 2);\n  let lo: usize[] = [];\n  let hi: usize[] = [];\n  let w: usize = 0;\n  while (w < n) {\n    lo.push(monGet(m, POOL_HDR + 2 * w));\n    hi.push(monGet(m, POOL_HDR + 2 * w + 1));\n    w += 1;\n  }\n  return new Ranges(lo, hi, monGet(m, 1), monGet(m, 0));\n}\n\nfunction storeRanges(m: usize, r: Ranges): void {\n  monSet(m, 0, r.chunks);\n  monSet(m, 1, r.cut);\n  monSet(m, 2, r.lo.length);\n  let w: usize = 0;\n  while (w < r.lo.length) {\n    monSet(m, POOL_HDR + 2 * w, r.lo[w]);\n    monSet(m, POOL_HDR + 2 * w + 1, r.hi[w]);\n    w += 1;\n  }\n}\n\n// The loop of worker w: claim a piece, compute it, repeat; with `until`, a piece whose result is a hit cancels every piece\n// after it.\nfunction poolWork<R>(m: usize, w: usize, body: (k: usize) => R, until: bool, hit: (r: R) => bool): Done<R>[] {\n  let out: Done<R>[] = [];\n  let more = true;\n  while (more) {\n    monLock(m);\n    let rs = loadRanges(m);\n    const c = rs.claim(w);\n    storeRanges(m, rs);\n    monUnlock(m);\n    match (c) {\n      Some(k) => {\n        const r = body(k);\n        if (until && hit(r)) {\n          monLock(m);\n          let rs2 = loadRanges(m);\n          rs2.cancelAfter(k);\n          storeRanges(m, rs2);\n          monUnlock(m);\n        }\n        out.push(Done<R> { k: k, r: r });\n      },\n      None => {\n        more = false;\n      }\n    }\n  }\n  return out;\n}\n\n// Runs the pieces on `nw` >= 2 worker tasks; the finished pieces in no particular order.\nfunction runPool<R>(chunks: usize, nw: usize, body: (k: usize) => R, until: bool, hit: (r: R) => bool): Done<R>[] {\n  const m = monNew(POOL_HDR + 2 * nw);\n  let lo: usize[] = [];\n  let hi: usize[] = [];\n  let w: usize = 0;\n  while (w < nw) {\n    lo.push(chunks * w / nw);\n    hi.push(chunks * (w + 1) / nw);\n    w += 1;\n  }\n  monLock(m);\n  storeRanges(m, new Ranges(lo, hi, chunks, chunks));\n  monUnlock(m);\n  const tab = begin();\n  const s = new Scope(tab);\n  let hs: TaskHandle<Done<R>[]>[] = [];\n  w = 0;\n  while (w < nw) {\n    const me = w;\n    hs.push(s.spawn(() => poolWork(m, me, body, until, hit)));\n    w += 1;\n  }\n  let all: Done<R>[] = [];\n  let failure = \"\";\n  let failed = false;\n  for (const h of hs) {\n    match (tryJoin(h)) {\n      Some(ds) => {\n        for (const d of ds) {\n          all.push(d);\n        }\n      },\n      None => {\n        if (!failed) {\n          failed = true;\n          failure = taskMessage();\n          monLock(m);\n          let rs = loadRanges(m);\n          rs.cancelAll();\n          storeRanges(m, rs);\n          monUnlock(m);\n        }\n      }\n    }\n  }\n  finish(tab);\n  monFree(m);\n  if (failed) {\n    taskTrap(failure);\n  }\n  return all;\n}\n\n// The results of `chunks` pieces in piece order (every piece ran exactly once: the unwrap checks it).\nfunction inOrder<R>(chunks: usize, ds: Done<R>[]): Option<R>[] {\n  let slots: Option<R>[] = [];\n  while (slots.length < chunks) {\n    slots.push(None);\n  }\n  for (const d of ds) {\n    slots[d.k] = Some(d.r);\n  }\n  return slots;\n}\n\n// parallelism(): how many worker threads a parallel computation uses: the environment variable ORIN_THREADS when it is a\n// number from 1 to 1024, else the number of processors online. Results of `forkJoin` and `parallel()` never depend on it.\n@Ensures(result >= 1)\nexport function parallelism(): usize {\n  const t = parThreads();\n  return t >= 1 ? t : 1;\n}\n\n// forkJoin(chunks, workers, body): [body(0), body(1), ..., body(chunks - 1)], computed by `workers` worker tasks (work\n// stealing) when workers >= 2, else in order by the calling task.\n@Ensures(result.length == chunks)\nexport function forkJoin<R>(chunks: usize, workers: usize, body: (k: usize) => R): R[] {\n  if (workers <= 1 || chunks <= 1) {\n    let out: R[] = [];\n    while (out.length < chunks) {\n      out.push(body(out.length));\n    }\n    return out;\n  }\n  const nw = workers < chunks ? workers : chunks;\n  const slots = inOrder(chunks, runPool(chunks, nw, body, false, (r: R) => false));\n  return slots.map(o => o.unwrap());\n}\n\n// The record a lend is made from (two slots: see runtime/core/orin_runtime.c \"lending\").\ntype Lent<A> = { v: A; spare: usize; };\n\n// forkJoinLent(lent, chunks, workers, body): forkJoin, with `lent` LENT to the worker tasks (ADR-0039 section 4, ADR-0049\n// row 13a) instead of copied. `body` reaches the lent value through its captures; the lent graph is pinned while the pool\n// runs (counts frozen: nothing in it is freed or changed in place) and shared by every worker without a copy, so a\n// capture of the lent value costs nothing per worker. The other captures of `body` are copied to every worker as in\n// forkJoin and must stay small. Results are built by the workers and travel back by move or copy; a result never refers\n// into the lent graph (a transfer by a worker copies pinned objects). The lent value is released again before the call\n// returns, also for the calling task, which only spawns and joins while it is lent (the owner's obligation of lending).\n// With workers <= 1 or chunks <= 1 nothing is lent and `body` runs in order on the calling task. `lent` can be any value\n// but a handle (E0480).\n@Ensures(result.length == chunks)\nexport function forkJoinLent<A, R>(lent: A, chunks: usize, workers: usize, body: (k: usize) => R): R[] {\n  if (workers <= 1 || chunks <= 1) {\n    return forkJoin(chunks, 1, body);\n  }\n  const tok = lendPut(Lent<A> { v: lent, spare: 0 });\n  const r = forkJoin(chunks, workers, body);\n  transitDrop(tok);\n  return r;\n}\n\n// forkJoinUntil(chunks, workers, body, hit): [body(0), ..., body(j)] where j is the first piece whose result is a hit (all\n// pieces when none is). Pieces after a hit are cancelled; the pieces before the first hit always run, so the result is the\n// same as computing the pieces one by one and stopping at the first hit.\n@Ensures(result.length <= chunks)\nexport function forkJoinUntil<R>(chunks: usize, workers: usize, body: (k: usize) => R, hit: (r: R) => bool): R[] {\n  let out: R[] = [];\n  if (workers <= 1 || chunks <= 1) {\n    let k: usize = 0;\n    while (k < chunks) {\n      const r = body(k);\n      const h = hit(r);\n      out.push(r);\n      k = h ? chunks : k + 1;\n    }\n    return out;\n  }\n  const nw = workers < chunks ? workers : chunks;\n  const slots = inOrder(chunks, runPool(chunks, nw, body, true, hit));\n  let k: usize = 0;\n  while (k < chunks) {\n    const r = slots[k].unwrap();\n    const h = hit(r);\n    out.push(r);\n    k = h ? chunks : k + 1;\n  }\n  return out;\n}\n" });
  out.push(SourceFile { path: "$stdlib/taskcore.or", text: "// std:taskcore -- the pure bookkeeping of std:task (ADR-0017 stage 0): the state machine of one channel buffer (`Ring`) and of one\n// scope's task table (`Ledger`). No I/O, no threads, no primitives: `std:task` loads one of them from a monitor, changes it and stores\n// it back inside one critical section, so the invariants below hold whenever a lock is released, and they can be tested and mutated\n// (tools/mutation.sh std) without a single thread. Part of the std:task implementation; import `std:task` for the API.\n\n// The ring arithmetic on plain numbers: `Ring` is built on these, and std:task calls them directly on locals loaded from the\n// channel's monitor (a `Ring` object per send / receive was 40% of the allocations of a channel benchmark), so the tests and\n// the mutants of `Ring` below cover the code the channels run.\n\n// A send would not block and would be accepted.\nexport function ringCanPush(len: usize, cap: usize, txClosed: bool, rxClosed: bool): bool {\n  return !txClosed && !rxClosed && len < cap;\n}\n\n// The slot of the next value to write (requires len < cap).\nexport function ringSlot(cap: usize, head: usize, len: usize): usize {\n  return (head + len) % cap;\n}\n\n// The head after one pop (requires cap >= 1).\nexport function ringNextHead(cap: usize, head: usize): usize {\n  return (head + 1) % cap;\n}\n\n// No value will ever be received (cancelled by the receiver, or closed by the sender and drained).\nexport function ringIsDone(len: usize, txClosed: bool, rxClosed: bool): bool {\n  return rxClosed || (txClosed && len == 0);\n}\n\n// The bookkeeping of one channel buffer, a bounded ring of `cap` slots. Pure: the channel functions load it from the\n// channel's monitor, change it and store it back inside one critical section, so the invariants hold whenever the\n// lock is released (they are checked after every method under --check-contracts, and `orin test` does).\n@Invariant(this.cap >= 1)\n@Invariant(this.head < this.cap)\n@Invariant(this.len <= this.cap)\nexport class Ring {\n  cap: usize;\n  head: usize;\n  len: usize;\n  txClosed: bool;\n  rxClosed: bool;\n\n  @Requires(cap >= 1 && head < cap && len <= cap)\n  constructor(cap: usize, head: usize, len: usize, txClosed: bool, rxClosed: bool) {\n    this.cap = cap;\n    this.head = head;\n    this.len = len;\n    this.txClosed = txClosed;\n    this.rxClosed = rxClosed;\n  }\n\n  // canPush(): a send would not block and would be accepted.\n  @Ensures(result == (!this.txClosed && !this.rxClosed && this.len < this.cap))\n  canPush(): bool {\n    return ringCanPush(this.len, this.cap, this.txClosed, this.rxClosed);\n  }\n\n  // canPop(): there is a value to receive.\n  @Ensures(result == (this.len > 0))\n  canPop(): bool {\n    return this.len > 0;\n  }\n\n  // isDone(): no value will ever be received (cancelled by the receiver, or closed by the sender and drained).\n  @Ensures(result == (this.rxClosed || (this.txClosed && this.len == 0)))\n  isDone(): bool {\n    return ringIsDone(this.len, this.txClosed, this.rxClosed);\n  }\n\n  // push(): the slot to write the next value into; the ring now holds one more value.\n  @Requires(this.len < this.cap)\n  @Ensures(result < this.cap)\n  @Ensures(this.len == old(this.len) + 1)\n  @Ensures(this.head == old(this.head))\n  push(): usize {\n    const slot = ringSlot(this.cap, this.head, this.len);\n    this.len += 1;\n    return slot;\n  }\n\n  // pop(): the slot to read the oldest value from; the ring now holds one value less.\n  @Requires(this.len > 0)\n  @Ensures(result < this.cap)\n  @Ensures(result == old(this.head))\n  @Ensures(this.len + 1 == old(this.len))\n  pop(): usize {\n    const slot = this.head;\n    this.head = ringNextHead(this.cap, this.head);\n    this.len -= 1;\n    return slot;\n  }\n\n  // closeTx(): no more sends (what is buffered can still be received).\n  @Ensures(this.txClosed && this.len == old(this.len))\n  closeTx(): void {\n    this.txClosed = true;\n  }\n\n  // closeRx(): no more receives; senders are refused from now on.\n  @Ensures(this.rxClosed && this.len == old(this.len))\n  closeRx(): void {\n    this.rxClosed = true;\n  }\n\n  // released(): both ends have closed, so the channel's monitor can be freed.\n  @Ensures(result == (this.txClosed && this.rxClosed))\n  released(): bool {\n    return this.txClosed && this.rxClosed;\n  }\n}\n\n// The task table of a scope, as the scope's monitor holds it: [0] number of tasks spawned, [1] scan cursor (every entry below\n// it has been claimed), [2] closed flag, [3] size of the monitor in words, then three words per task: its thread handle\n// (0 until spawn has started the thread), its result monitor, and a state word (0 = nobody has joined it yet, 1 = claimed\n// by a join or by the scope's exit).\n@Invariant(this.cursor <= this.count)\nexport class Ledger {\n  count: usize;\n  cursor: usize;\n  closed: bool;\n\n  @Requires(cursor <= count)\n  constructor(count: usize, cursor: usize, closed: bool) {\n    this.count = count;\n    this.cursor = cursor;\n    this.closed = closed;\n  }\n\n  // add(): the index of a new task.\n  @Requires(!this.closed)\n  @Ensures(result == old(this.count) && this.count == old(this.count) + 1)\n  add(): usize {\n    const i = this.count;\n    this.count += 1;\n    return i;\n  }\n\n  // advance(): the scan has passed one more entry.\n  @Requires(this.cursor < this.count)\n  @Ensures(this.cursor == old(this.cursor) + 1)\n  advance(): void {\n    this.cursor += 1;\n  }\n\n  // isScanned(): the scan has passed every task.\n  @Ensures(result == (this.cursor == this.count))\n  isScanned(): bool {\n    return this.cursor == this.count;\n  }\n\n  // close(): no task can be added any more; legal only when the scan has passed every task.\n  @Requires(this.cursor == this.count)\n  @Ensures(this.closed)\n  close(): void {\n    this.closed = true;\n  }\n}\n\n// The chunk ranges of a fork/join pool (std:task `forkJoin`, ADR-0039): worker w owns the chunks lo[w] .. hi[w] - 1 and takes\n// them from the front; a worker whose range is empty steals the back half of the largest range of another worker. Chunks at\n// or after `cut` are cancelled (`forkJoinUntil`: everything to the right of the leftmost hit found so far). Pure: the pool\n// keeps the words in its monitor and loads, changes and stores them inside one critical section.\n@Invariant(this.lo.length == this.hi.length && this.lo.length >= 1)\n@Invariant(this.cut <= this.chunks)\n@Invariant(rangesOk(this.lo, this.hi, this.chunks))\nexport class Ranges {\n  lo: usize[];\n  hi: usize[];\n  cut: usize;\n  chunks: usize;\n\n  @Requires(lo.length == hi.length && lo.length >= 1 && cut <= chunks && rangesOk(lo, hi, chunks))\n  constructor(lo: usize[], hi: usize[], cut: usize, chunks: usize) {\n    this.lo = lo;\n    this.hi = hi;\n    this.cut = cut;\n    this.chunks = chunks;\n  }\n\n  // claim(w): the next chunk for worker w: its own next one, else one stolen from the back of the largest other range\n  // (counting only chunks before the cut). None when no chunk before the cut is left to anybody.\n  @Requires(w < this.lo.length)\n  @Ensures(result.isSome() ==> result.unwrap() < this.cut && result.unwrap() < this.chunks)\n  @Ensures(result.isSome() ==> this.lo[w] == result.unwrap() + 1)\n  @Ensures(this.cut == old(this.cut))\n  claim(w: usize): Option<usize> {\n    if (this.lo[w] >= this.hi[w] || this.lo[w] >= this.cut) {\n      const n = this.lo.length;\n      let best = n;\n      let most: usize = 0;\n      let v: usize = 0;\n      while (v < n) {\n        const top = this.hi[v] < this.cut ? this.hi[v] : this.cut;\n        if (v != w && top > this.lo[v] && top - this.lo[v] > most) {\n          best = v;\n          most = top - this.lo[v];\n        }\n        v += 1;\n      }\n      if (best == n) {\n        return None;\n      }\n      // the victim keeps the front half, the thief takes the back half (all of it when one chunk is left)\n      const mid = this.lo[best] + most / 2;\n      this.lo[w] = mid;\n      this.hi[w] = this.hi[best];\n      this.hi[best] = mid;\n    }\n    const k = this.lo[w];\n    this.lo[w] = k + 1;\n    return Some(k);\n  }\n\n  // cancelAfter(k): chunk k produced a hit, so no chunk after it needs to run.\n  @Ensures(this.cut <= old(this.cut) && this.cut <= k + 1)\n  cancelAfter(k: usize): void {\n    if (k + 1 < this.cut) {\n      this.cut = k + 1;\n    }\n  }\n\n  // cancelAll(): a worker failed; nothing more needs to run.\n  @Ensures(this.cut == 0)\n  cancelAll(): void {\n    this.cut = 0;\n  }\n}\n\n// Every range is inside 0 .. chunks and no chunk belongs to two ranges (so no chunk can run twice).\nexport function rangesOk(lo: usize[], hi: usize[], chunks: usize): bool {\n  if (lo.length != hi.length) {\n    return false;\n  }\n  let i: usize = 0;\n  while (i < lo.length) {\n    if (lo[i] > hi[i] || hi[i] > chunks) {\n      return false;\n    }\n    let j: usize = i + 1;\n    while (j < lo.length) {\n      const overlap = lo[i] < hi[i] && lo[j] < hi[j] && lo[i] < hi[j] && lo[j] < hi[i];\n      if (overlap) {\n        return false;\n      }\n      j += 1;\n    }\n    i += 1;\n  }\n  return true;\n}\n\n// ---- structured cancellation and outcomes (ADR-0017 Addendum B, Gate 1 / C0) -------------------------------------------------\n// Pure state machines, written against ADR-0048 naming. Nothing here blocks or reads a clock: std:task (C1+) loads a word from a\n// monitor, applies one of these functions and stores the result back inside one critical section. Instants are the `millis` of a\n// `MonotonicInstant` (std:time); NO_DEADLINE is -1. Everything is monotone: a cancellation cause, once set, never changes.\n\n// Cancellation causes (a token's state word). 0 = live. The first cause wins and is never replaced.\nexport function causeLive(): usize { return 0; }\nexport function causeCancelled(): usize { return 1; }  // cancel() on this token, on an ancestor, or a trapped sibling\nexport function causeDeadline(): usize { return 2; }   // the absolute monotonic deadline passed\n\n// Task outcomes. 0 = still running. A settled outcome is the order of severity: Completed < Closed < Cancelled < Deadline < Error.\nexport function outcomePending(): usize { return 0; }\nexport function outcomeCompleted(): usize { return 1; }  // the task body returned\nexport function outcomeClosed(): usize { return 2; }     // a channel end it waited on was closed and drained\nexport function outcomeCancelled(): usize { return 3; }  // it stopped at a checkpoint because its token was cancelled\nexport function outcomeDeadline(): usize { return 4; }   // it stopped because its deadline passed\nexport function outcomeError(): usize { return 5; }      // it trapped\n\nexport function isOutcome(o: usize): bool { return o <= 5; }\nexport function isSettled(o: usize): bool { return o >= 1 && o <= 5; }\n\n// The cause that survives when `cur` is already set and `next` arrives (first cause wins).\n@Requires(cur <= 2 && next <= 2)\n@Ensures(result <= 2)\n@Ensures(cur != 0 ==> result == cur)\n@Ensures(cur == 0 ==> result == next)\nexport function causeMerge(cur: usize, next: usize): usize {\n  return cur != 0 ? cur : next;\n}\n\n// A child token observes its parent: it keeps its own cause, else takes the parent's (cancellation flows down, never up).\n@Requires(child <= 2 && parent <= 2)\n@Ensures(child != 0 ==> result == child)\n@Ensures(child == 0 ==> result == parent)\nexport function causeInherit(child: usize, parent: usize): usize {\n  return causeMerge(child, parent);\n}\n\n// The combined outcome of two settled outcomes (a scope's outcome over its children): the more severe one.\n@Requires(isSettled(a) && isSettled(b))\n@Ensures(isSettled(result))\n@Ensures(result == a || result == b)\n@Ensures(result >= a && result >= b)\nexport function outcomeJoin(a: usize, b: usize): usize {\n  return a >= b ? a : b;\n}\n\n// The outcome a cancelled token imposes on a task that stops at a checkpoint (requires a set cause).\n@Requires(cause == 1 || cause == 2)\n@Ensures(result == 3 || result == 4)\n@Ensures((cause == 1) == (result == 3))\nexport function outcomeOfCause(cause: usize): usize {\n  return cause == 2 ? 4 : 3;\n}\n\n// What a blocking call (recv, send, join, sleep ...) returns at a checkpoint, from what it can see under the lock:\n// `ready` = the operation can complete now, `closed` = the object it waits on is closed and drained, `cause` = the token's cause.\n// Precedence: completing beats closed beats cancelled, so a value that is already there is never dropped. 0 = keep waiting.\n@Requires(cause <= 2)\n@Ensures(ready ==> result == 1)\n@Ensures(!ready && closed ==> result == 2)\n@Ensures(!ready && !closed && cause == 0 ==> result == 0)\n@Ensures(!ready && !closed && cause != 0 ==> result == outcomeOfCause(cause))\n@Ensures(result <= 4)\nexport function checkpointOutcome(ready: bool, closed: bool, cause: usize): usize {\n  if (ready) {\n    return 1;\n  }\n  if (closed) {\n    return 2;\n  }\n  if (cause == 0) {\n    return 0;\n  }\n  return outcomeOfCause(cause);\n}\n\n// ---- absolute monotonic deadlines (millis; -1 = none) ----\n\nexport function noDeadline(): int { return -1; }\n\nexport function deadlineOk(d: int): bool { return d >= -1; }\n\n// The tighter of two deadlines (a child never outlives its parent's deadline; none is the loosest).\n@Requires(deadlineOk(a) && deadlineOk(b))\n@Ensures(deadlineOk(result))\n@Ensures(a == -1 ==> result == b)\n@Ensures(b == -1 ==> result == a)\n@Ensures(a >= 0 && b >= 0 ==> result <= a && result <= b && (result == a || result == b))\nexport function deadlineMin(a: int, b: int): int {\n  if (a < 0) {\n    return b;\n  }\n  if (b < 0) {\n    return a;\n  }\n  return a < b ? a : b;\n}\n\n// start + delay on millis, saturating at the largest i64 instead of overflowing (so a huge timeout means \"practically never\").\n@Requires(start >= 0 && delay >= 0)\n@Ensures(result >= start)\n@Ensures(delay <= 9223372036854775807 - start ==> result == start + delay)\n@Ensures(delay > 9223372036854775807 - start ==> result == 9223372036854775807)\nexport function deadlineAfterMillis(start: int, delay: int): int {\n  if (delay > 9223372036854775807 - start) {\n    return 9223372036854775807;\n  }\n  return start + delay;\n}\n\n// The deadline has passed at `now` (equality counts as passed, as std:time `isExpired`).\n@Requires(deadlineOk(d) && now >= 0)\n@Ensures(d == -1 ==> !result)\n@Ensures(d >= 0 ==> result == (now >= d))\nexport function deadlineExpired(d: int, now: int): bool {\n  return d >= 0 && now >= d;\n}\n\n// How long a timed wait may block at `now`: 0 when expired, the distance otherwise; -1 = no deadline, wait without a time limit.\n@Requires(deadlineOk(d) && now >= 0)\n@Ensures(d == -1 ==> result == -1)\n@Ensures(d >= 0 ==> result >= 0)\n@Ensures(d >= 0 && now >= d ==> result == 0)\n@Ensures(d >= 0 && now < d ==> result == d - now)\nexport function waitBudget(d: int, now: int): int {\n  if (d < 0) {\n    return -1;\n  }\n  if (now >= d) {\n    return 0;\n  }\n  return d - now;\n}\n\n// The state of one cancellation token: its cause and its absolute monotonic deadline. Monotone: the cause is set once, the\n// deadline can only move earlier. Tokens form a tree; a child reads its parent's cause with `observe`.\n@Invariant(this.cause <= 2)\n@Invariant(deadlineOk(this.deadline))\nexport class CancelState {\n  cause: usize;\n  deadline: int;\n\n  @Requires(cause <= 2 && deadlineOk(deadline))\n  constructor(cause: usize, deadline: int) {\n    this.cause = cause;\n    this.deadline = deadline;\n  }\n\n  // isCancelled(): some cause is set (a task must stop at its next checkpoint).\n  @Ensures(result == (this.cause != 0))\n  isCancelled(): bool {\n    return this.cause != 0;\n  }\n\n  // cancel(): explicit cancellation; has no effect when a cause is already set.\n  @Ensures(this.cause != 0)\n  @Ensures(old(this.cause) != 0 ==> this.cause == old(this.cause))\n  @Ensures(old(this.cause) == 0 ==> this.cause == 1)\n  @Ensures(this.deadline == old(this.deadline))\n  cancel(): void {\n    this.cause = causeMerge(this.cause, 1);\n  }\n\n  // limit(d): the token may not outlive deadline d (the tighter deadline wins).\n  @Requires(deadlineOk(d))\n  @Ensures(this.cause == old(this.cause))\n  @Ensures(this.deadline == deadlineMin(old(this.deadline), d))\n  limit(d: int): void {\n    this.deadline = deadlineMin(this.deadline, d);\n  }\n\n  // observe(parentCause, now): fold in the parent's cause and the clock; returns whether the token is cancelled afterwards.\n  // A parent cause wins over a deadline that expires at the same observation (the parent was cancelled first).\n  @Requires(parentCause <= 2 && now >= 0)\n  @Ensures(old(this.cause) != 0 ==> this.cause == old(this.cause))\n  @Ensures(old(this.cause) == 0 && parentCause != 0 ==> this.cause == parentCause)\n  @Ensures(old(this.cause) == 0 && parentCause == 0 && deadlineExpired(this.deadline, now) ==> this.cause == 2)\n  @Ensures(result == (this.cause != 0))\n  observe(parentCause: usize, now: int): bool {\n    this.cause = causeInherit(this.cause, parentCause);\n    if (this.cause == 0 && deadlineExpired(this.deadline, now)) {\n      this.cause = 2;\n    }\n    return this.cause != 0;\n  }\n\n  // budget(now): the time a timed wait may block; 0 when the token is already cancelled; -1 = unlimited.\n  @Requires(now >= 0)\n  @Ensures(this.cause != 0 ==> result == 0)\n  @Ensures(this.cause == 0 ==> result == waitBudget(this.deadline, now))\n  budget(now: int): int {\n    if (this.cause != 0) {\n      return 0;\n    }\n    return waitBudget(this.deadline, now);\n  }\n}\n\n// The exactly-once result slot of one task: it starts pending, `settle` records the outcome once, `take` hands the result token to\n// the joiner once (token ownership: the slot gives it up, the joiner owns it afterwards). Pure counterpart of the result monitor.\n@Invariant(isOutcome(this.outcome))\n@Invariant(!this.taken || this.outcome != 0)\nexport class TaskCell {\n  outcome: usize;\n  taken: bool;\n\n  constructor() {\n    this.outcome = 0;\n    this.taken = false;\n  }\n\n  // isDone(): the outcome has been recorded.\n  @Ensures(result == (this.outcome != 0))\n  isDone(): bool {\n    return this.outcome != 0;\n  }\n\n  // settle(o): record the outcome; legal exactly once.\n  @Requires(this.outcome == 0 && isSettled(o))\n  @Ensures(this.outcome == o && !this.taken)\n  settle(o: usize): void {\n    this.outcome = o;\n  }\n\n  // canTake(): the joiner may take the result now.\n  @Ensures(result == (this.outcome != 0 && !this.taken))\n  canTake(): bool {\n    return this.outcome != 0 && !this.taken;\n  }\n\n  // take(): the outcome, handed over once (a second take is a bug and traps, as \"join twice\" does).\n  @Requires(this.outcome != 0 && !this.taken)\n  @Ensures(result == this.outcome && this.taken)\n  take(): usize {\n    this.taken = true;\n    return this.outcome;\n  }\n}\n\n// The cancellation bookkeeping of one scope: its token, how many tasks are still running, and the outcome over the finished ones.\n// A child that traps cancels the scope (siblings stop at their next checkpoint); the scope is done when no task is running.\n@Invariant(this.finished <= this.spawned)\n@Invariant(this.cause <= 2)\n@Invariant(this.worst <= 5)\n@Invariant(this.finished == 0 ==> this.worst == 0)\n@Invariant(this.finished > 0 ==> this.worst != 0)\nexport class CancelScope {\n  spawned: usize;\n  finished: usize;\n  cause: usize;\n  worst: usize;\n\n  @Requires(cause <= 2)\n  constructor(cause: usize) {\n    this.spawned = 0;\n    this.finished = 0;\n    this.cause = cause;\n    this.worst = 0;\n  }\n\n  // spawn(): a new task; a cancelled scope still accepts it, and the task stops at its first checkpoint.\n  @Ensures(this.spawned == old(this.spawned) + 1)\n  @Ensures(this.cause == old(this.cause))\n  spawn(): void {\n    this.spawned += 1;\n  }\n\n  // cancel(): the scope token is cancelled by its owner or its parent (the first cause stays).\n  @Requires(cause == 1 || cause == 2)\n  @Ensures(this.cause == causeMerge(old(this.cause), cause))\n  cancel(cause: usize): void {\n    this.cause = causeMerge(this.cause, cause);\n  }\n\n  // settle(o): one task finished with outcome o. A trap cancels the rest of the scope.\n  @Requires(this.finished < this.spawned && isSettled(o))\n  @Ensures(this.finished == old(this.finished) + 1)\n  @Ensures(o == 5 ==> this.cause != 0)\n  @Ensures(o != 5 ==> this.cause == old(this.cause))\n  @Ensures(this.worst >= o)\n  settle(o: usize): void {\n    this.worst = this.finished == 0 ? o : outcomeJoin(this.worst, o);\n    this.finished += 1;\n    if (o == 5) {\n      this.cause = causeMerge(this.cause, 1);\n    }\n  }\n\n  // isDone(): no task is running any more, so the scope may return.\n  @Ensures(result == (this.finished == this.spawned))\n  isDone(): bool {\n    return this.finished == this.spawned;\n  }\n\n  // running(): tasks that have not finished.\n  @Ensures(result == this.spawned - this.finished)\n  running(): usize {\n    return this.spawned - this.finished;\n  }\n}\n" });
  out.push(SourceFile { path: "$stdlib/test.or", text: "// std:test -- assertions for `@Test` functions (ADR-0024, docs/testing.md).\n//\n// A failed assertion TRAPS: it writes `trap: <message>` to stderr and exits with status 101, exactly\n// like any other trap (array bounds, `unwrap` of `None`, a violated contract). `orin test` runs\n// every test in its own process, so one failing test never stops the others. The functions work in\n// ordinary programs too (they are not tied to `orin test`).\n//\n//   * Every function is total apart from the trap it exists for; none returns a value.\n//   * `msg` describes what was being checked (\"\" is allowed); it is part of the trap message.\n//   * Orin has no generic equality, so there is one function per type: `assertEq` (int),\n//     `assertEqUsize`, `assertEqString`, `assertEqBool`, `assertNear` (float with a tolerance).\n//   * Complexity: O(1) (string equality: O(n)); no allocation unless the assertion fails.\n\nimport { exit } from \"std:process\";\n\n// fail(msg: string): void\n// Traps with `msg` unconditionally (a test that reached a place it must not reach).\nexport function fail(msg: string): void {\n  console.error(\"trap: \" + msg);\n  exit(101);\n}\n\n// assert(cond: bool, msg: string): void\n// Traps with \"assertion failed: <msg>\" when `cond` is false.\nexport function assert(cond: bool, msg: string): void {\n  if (!cond) {\n    fail(\"assertion failed: \" + msg);\n  }\n}\n\nfunction label(msg: string): string {\n  return msg.length > 0 ? msg + \": \" : \"\";\n}\n\n// assertEq(actual: int, expected: int, msg: string): void\n// Traps with \"assertEq failed: <msg>: expected <expected>, got <actual>\" when the ints differ.\nexport function assertEq(actual: int, expected: int, msg: string): void {\n  if (actual != expected) {\n    fail(\"assertEq failed: \" + label(msg) + \"expected \" + expected.toString() + \", got \" + actual.toString());\n  }\n}\n\n// assertEqual<T extends Eq>(actual: T, expected: T, msg: string): void\n// Like `assertEq` for any type with the built-in `Eq` instance (ADR-0034): records, unions, `Option`, arrays, strings, classes with\n// `equals`. The values are not shown (there is no generic `toString`), so say what was compared in `msg`. Traps with\n// \"assertEq failed: <msg>: values differ\".\nexport function assertEqual<T extends Eq>(actual: T, expected: T, msg: string): void {\n  if (actual != expected) {\n    fail(\"assertEq failed: \" + label(msg) + \"values differ\");\n  }\n}\n\n// assertEqUsize(actual: usize, expected: usize, msg: string): void\n// Like `assertEq` for `usize` (lengths, indices).\nexport function assertEqUsize(actual: usize, expected: usize, msg: string): void {\n  if (actual != expected) {\n    fail(\"assertEq failed: \" + label(msg) + \"expected \" + expected.toString() + \", got \" + actual.toString());\n  }\n}\n\n// assertEqString(actual: string, expected: string, msg: string): void\n// Like `assertEq` for strings; the values are shown in double quotes.\nexport function assertEqString(actual: string, expected: string, msg: string): void {\n  if (actual != expected) {\n    fail(\"assertEq failed: \" + label(msg) + \"expected \\\"\" + expected + \"\\\", got \\\"\" + actual + \"\\\"\");\n  }\n}\n\n// assertEqBool(actual: bool, expected: bool, msg: string): void\n// Like `assertEq` for bools.\nexport function assertEqBool(actual: bool, expected: bool, msg: string): void {\n  if (actual != expected) {\n    fail(\"assertEq failed: \" + label(msg) + \"expected \" + expected.toString() + \", got \" + actual.toString());\n  }\n}\n\n// assertNear(actual: float, expected: float, tolerance: float, msg: string): void\n// Traps unless |actual - expected| <= tolerance (a NaN on either side always fails).\nexport function assertNear(actual: float, expected: float, tolerance: float, msg: string): void {\n  const d = actual > expected ? actual - expected : expected - actual;\n  if (!(d <= tolerance)) {\n    fail(\"assertNear failed: \" + label(msg) + \"expected \" + expected.toString() + \" +/- \" + tolerance.toString() + \", got \" + actual.toString());\n  }\n}\n" });
  out.push(SourceFile { path: "$stdlib/text.or", text: "// std:text -- pure text-layout utilities for compilers, diagnostics, documentation and CLIs.\n//\n// Orin strings are byte strings (see std:utf8). All indices below count bytes, never\n// Unicode code points. Whitespace in this module means ASCII SP, TAB or CR.\n// UTF-8 data is preserved byte-for-byte; Unicode segmentation belongs in std:utf8.\n// No platform calls, no additional trusted code, no runtime reflection.\n// Every function is total (never traps) and O(n) in the size of its input and output.\n// Names follow ADR-0048: a predicate is `is*`, a function returning a new string never changes its argument. The\n// module is usually imported as a namespace (`import * as text`): `text.dedent(s)`.\n\n// isBlankLine(line): bool -- true when `line` consists only of ASCII SP, TAB and CR (the empty line included). Never\n// fails; O(line.length).\nexport function isBlankLine(line: string): bool {\n  let i: usize = 0;\n  while (i < line.length) {\n    const c = line.charCodeAt(i);\n    if (c != 32 && c != 9 && c != 13) {\n      return false;\n    }\n    i += 1;\n  }\n  return true;\n}\n\n// leadingIndent(line): string -- the leading run of ASCII SP / TAB of `line` (the indentation itself, not its width).\n// Never fails; O(line.length).\n@Ensures(result.length <= line.length && line.startsWith(result))\nexport function leadingIndent(line: string): string {\n  let i: usize = 0;\n  while (i < line.length) {\n    const c = line.charCodeAt(i);\n    if (c != 32 && c != 9) {\n      break;\n    }\n    i += 1;\n  }\n  return line.substring(0, i);\n}\n\n// The longest common prefix of `a` and `b`, byte by byte.\n@Ensures(a.startsWith(result) && b.startsWith(result))\nfunction commonPrefix(a: string, b: string): string {\n  let i: usize = 0;\n  while (i < a.length && i < b.length && a.charCodeAt(i) == b.charCodeAt(i)) {\n    i += 1;\n  }\n  return a.substring(0, i);\n}\n\n// trimBlankLines(text): string -- removes outer whitespace-only lines, retaining internal blank lines.\n// An empty or whitespace-only input produces \"\". The line break after the last kept line is removed.\n@Ensures(result.length <= text.length)\n@Ensures(result.length == 0 || !isBlankLine(result.split(\"\\n\")[0]))\n@Ensures(result.length == 0 || !isBlankLine(result.split(\"\\n\")[result.split(\"\\n\").length - 1]))\nexport function trimBlankLines(text: string): string {\n  const lines = text.split(\"\\n\");\n  let first: usize = 0;\n  while (first < lines.length && isBlankLine(lines[first])) {\n    first += 1;\n  }\n  let last = lines.length;\n  while (last > first && isBlankLine(lines[last - 1])) {\n    last -= 1;\n  }\n  return lines.slice(first, last).join(\"\\n\");\n}\n\n// dedent(text): string -- removes the longest common indentation *prefix* (the same sequence of SP / TAB bytes, as in\n// Python's textwrap.dedent) from every nonblank line. A tab and a space never match, so \"\\tfoo\\n  bar\"\n// has no common indentation and is returned unchanged. Blank lines become empty; the number of lines,\n// and therefore a trailing newline, is preserved.\n@Ensures(result.length <= text.length)\n@Ensures(result.split(\"\\n\").length == text.split(\"\\n\").length)\nexport function dedent(text: string): string {\n  const lines = text.split(\"\\n\");\n  let common = \"\";\n  let found = false;\n  for (const line of lines) {\n    if (!isBlankLine(line)) {\n      const ind = leadingIndent(line);\n      common = found ? commonPrefix(common, ind) : ind;\n      found = true;\n    }\n  }\n  if (!found) {\n    return text;\n  }\n  return lines.map(line => isBlankLine(line) ? \"\" : line.substring(common.length, line.length)).join(\"\\n\");\n}\n\n// indentLines(text, prefix): string -- prefixes each non-empty line with `prefix`; empty lines (and so a trailing newline) stay\n// empty. The prefix may be any byte string. O(n + number_of_lines * prefix.length).\n@Ensures(result.length >= text.length)\n@Ensures(prefix.length == 0 ==> result == text)\n@Ensures(result.split(\"\\n\").length == text.split(\"\\n\").length)\nexport function indentLines(text: string, prefix: string): string {\n  if (text.length == 0 || prefix.length == 0) {\n    return text;\n  }\n  return text.split(\"\\n\").map(line => line.length == 0 ? \"\" : prefix + line).join(\"\\n\");\n}\n\n// normalizeNewlines(text): string -- converts CRLF and a lone CR to LF without touching other bytes.\n// This is deliberately not a Unicode normalization operation.\n@Ensures(result.length <= text.length)\n@Ensures(result.indexOf(\"\\r\").isNone())\n@Ensures(text.indexOf(\"\\r\").isNone() ==> result == text)\nexport function normalizeNewlines(text: string): string {\n  let parts: string[] = [];\n  let start: usize = 0;\n  let i: usize = 0;\n  while (i < text.length) {\n    if (text.charCodeAt(i) == 13) {\n      parts.push(text.substring(start, i));\n      parts.push(\"\\n\");\n      if (i + 1 < text.length && text.charCodeAt(i + 1) == 10) {\n        i += 1;\n      }\n      i += 1;\n      start = i;\n    } else {\n      i += 1;\n    }\n  }\n  if (start == 0) {\n    return text;\n  }\n  parts.push(text.substring(start, text.length));\n  return parts.join(\"\");\n}\n" });
  out.push(SourceFile { path: "$stdlib/time.or", text: "// std:time -- wall clock, durations with explicit units and UTC calendar conversion (spec 08).\n//\n// Runtime reads are `nowMillis` (wall clock) and `monotonicNow` (fallible monotonic clock, both through the clock grant of\n// `std:host`); arithmetic\n// and calendar helpers are pure Orin. All quantities are `int` milliseconds\n// unless the name says otherwise (\"explicit units\": there is no unit-less number in this API).\n//   * Calendar functions use the proleptic Gregorian calendar in UTC; there are no time zones,\n//     no leap seconds. Wall-clock instants are milliseconds since 1970-01-01T00:00:00Z (negative before).\n//   * Arithmetic on ints traps on overflow like everywhere in Orin; values here stay far from\n//     the limits for any date in years -292000000 .. 292000000.\n//\n// Names (ADR-0048): `fromMillis` / `toInstant` convert between an instant and its calendar fields, `format*` render\n// text, `durationBetween` / `instantAfter` / `addDuration` do the arithmetic. The wall clock is `nowMillis`, the monotonic\n// clock `monotonicNow` (other modules name their own monotonic readings `monotonicMillis`).\n//\n// `sleep` and the timed waits live in std:task (C1: they take a Deadline or a Duration from here). TODO: fractional seconds (`seconds(1.5)`),\n// time zones / locale formatting.\n\n// nowMillis(clock: ClockGrant): int\n// Wall-clock time in milliseconds since the Unix epoch (CLOCK_REALTIME). Not monotonic: the system\n// clock may jump. Needs the clock grant (ADR-0027: `useClock(host, clock => ...)` of std:host). Cannot fail. O(1), no allocation.\nexport { nowMillis, ClockGrant } from \"std:clock\";\nimport { monotonicMillis, ClockGrant } from \"std:clock\";\n\n// A span of time in whole milliseconds (may be negative: a difference of two instants).\nexport type Duration = { millis: int; };\n\n// ---- durations ----------------------------------------------------------------------------\n\n// milliseconds(n: int): Duration -- n milliseconds as a Duration. O(1).\nexport function milliseconds(n: int): Duration {\n  return Duration { millis: n };\n}\n\n// seconds(n: int): Duration -- n seconds (n * 1000 ms). Traps on overflow. O(1).\nexport function seconds(n: int): Duration {\n  return Duration { millis: n * 1000 };\n}\n\n// minutes(n: int): Duration -- n minutes (n * 60000 ms). Traps on overflow. O(1).\nexport function minutes(n: int): Duration {\n  return Duration { millis: n * 60000 };\n}\n\n// hours(n: int): Duration -- n hours (n * 3600000 ms). Traps on overflow. O(1).\nexport function hours(n: int): Duration {\n  return Duration { millis: n * 3600000 };\n}\n\n// days(n: int): Duration -- n days (n * 86400000 ms). Traps on overflow. O(1).\nexport function days(n: int): Duration {\n  return Duration { millis: n * 86400000 };\n}\n\n// toMillis(d: Duration): int -- the span in milliseconds. O(1).\nexport function toMillis(d: Duration): int {\n  return d.millis;\n}\n\n// toSeconds(d: Duration): int -- whole seconds, truncated toward zero (1999 ms -> 1). O(1).\nexport function toSeconds(d: Duration): int {\n  return d.millis / 1000;\n}\n\n// addDuration(a: Duration, b: Duration): Duration -- the sum of two spans. Traps on overflow. O(1).\nexport function addDuration(a: Duration, b: Duration): Duration {\n  return Duration { millis: a.millis + b.millis };\n}\n\n// durationBetween(startMillis: int, endMillis: int): Duration -- endMillis - startMillis for two wall-clock instants\n// (milliseconds since the epoch); negative when the end is before the start. Traps on overflow. O(1).\nexport function durationBetween(startMillis: int, endMillis: int): Duration {\n  return Duration { millis: endMillis - startMillis };\n}\n\n// instantAfter(instantMillis: int, d: Duration): int -- the wall-clock instant `d` after `instantMillis` (before it when\n// `d` is negative). Traps on overflow. O(1).\nexport function instantAfter(instantMillis: int, d: Duration): int {\n  return instantMillis + d.millis;\n}\n\n// between(start, end) -- renamed `durationBetween` (a module-level export named `between` is too generic, ADR-0048\n// rule 1.3); this wrapper stays for one release.\n@Deprecated(\"use durationBetween(startMillis, endMillis)\")\nexport function between(start: int, end: int): Duration {\n  return durationBetween(start, end);\n}\n\n// plus(instant, d) -- renamed `instantAfter`; this wrapper stays for one release.\n@Deprecated(\"use instantAfter(instantMillis, d)\")\nexport function plus(instant: int, d: Duration): int {\n  return instantAfter(instant, d);\n}\n\n// formatDuration(d: Duration): string\n// Human-readable \"1d 2h 3m 4s 5ms\" with zero components omitted, \"0ms\" for zero and a leading\n// \"-\" for negative spans: formatDuration(milliseconds(3723005)) == \"1h 2m 3s 5ms\". O(1).\nexport function formatDuration(d: Duration): string {\n  if (d.millis == 0) {\n    return \"0ms\";\n  }\n  const neg = d.millis < 0;\n  let rest = neg ? 0 - d.millis : d.millis;\n  let parts: string[] = [];\n  const dd = rest / 86400000;\n  rest = rest % 86400000;\n  const hh = rest / 3600000;\n  rest = rest % 3600000;\n  const mm = rest / 60000;\n  rest = rest % 60000;\n  const ss = rest / 1000;\n  const ms = rest % 1000;\n  if (dd > 0) {\n    parts.push(dd.toString() + \"d\");\n  }\n  if (hh > 0) {\n    parts.push(hh.toString() + \"h\");\n  }\n  if (mm > 0) {\n    parts.push(mm.toString() + \"m\");\n  }\n  if (ss > 0) {\n    parts.push(ss.toString() + \"s\");\n  }\n  if (ms > 0) {\n    parts.push(ms.toString() + \"ms\");\n  }\n  const body = parts.join(\" \");\n  return neg ? \"-\" + body : body;\n}\n\n// ---- calendar (UTC) -----------------------------------------------------------------------\n\n// Broken-down UTC time. month 1..12, day 1..31, hour 0..23, minute 0..59, second 0..59,\n// millisecond 0..999, weekday 0 = Sunday .. 6 = Saturday.\nexport type DateTime = {\n  year: int; month: int; day: int;\n  hour: int; minute: int; second: int; millisecond: int;\n  weekday: int;\n};\n\nfunction floorDiv(a: int, b: int): int {\n  const q = a / b;\n  if (a % b != 0 && (a < 0) != (b < 0)) {\n    return q - 1;\n  }\n  return q;\n}\n\n// Days since 1970-01-01 of the civil date y-m-d (Howard Hinnant's days_from_civil).\nfunction daysFromCivil(y0: int, m: int, d: int): int {\n  const y = m <= 2 ? y0 - 1 : y0;\n  const era = floorDiv(y, 400);\n  const yoe = y - era * 400;\n  const mp = m > 2 ? m - 3 : m + 9;\n  const doy = (153 * mp + 2) / 5 + d - 1;\n  const doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;\n  return era * 146097 + doe - 719468;\n}\n\n// fromMillis(instant: int): DateTime -- UTC calendar fields of an instant. Total, O(1).\nexport function fromMillis(instant: int): DateTime {\n  const dayNum = floorDiv(instant, 86400000);\n  const msOfDay = instant - dayNum * 86400000;\n  const z = dayNum + 719468;\n  const era = floorDiv(z, 146097);\n  const doe = z - era * 146097;\n  const yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;\n  const doy = doe - (365 * yoe + yoe / 4 - yoe / 100);\n  const mp = (5 * doy + 2) / 153;\n  const d = doy - (153 * mp + 2) / 5 + 1;\n  const m = mp < 10 ? mp + 3 : mp - 9;\n  const y = yoe + era * 400 + (m <= 2 ? 1 : 0);\n  let wd = (dayNum + 4) % 7;\n  if (wd < 0) {\n    wd += 7;\n  }\n  return DateTime {\n    year: y, month: m, day: d,\n    hour: msOfDay / 3600000, minute: (msOfDay / 60000) % 60,\n    second: (msOfDay / 1000) % 60, millisecond: msOfDay % 1000,\n    weekday: wd\n  };\n}\n\n// isLeapYear(year: int): bool -- Gregorian rule. O(1).\nexport function isLeapYear(year: int): bool {\n  return (year % 4 == 0 && year % 100 != 0) || year % 400 == 0;\n}\n\n// daysInMonth(year: int, month: int): Option<int> -- None unless month is 1..12. O(1).\nexport function daysInMonth(year: int, month: int): Option<int> {\n  if (month < 1 || month > 12) {\n    return None;\n  }\n  if (month == 2) {\n    return Some(isLeapYear(year) ? 29 : 28);\n  }\n  if (month == 4 || month == 6 || month == 9 || month == 11) {\n    return Some(30);\n  }\n  return Some(31);\n}\n\n// toInstant(dt: DateTime): Option<int>\n// The instant of a UTC date-time, or None when a field is out of range (month 1..12, day within\n// the month, hour 0..23, minute/second 0..59, millisecond 0..999). `weekday` is ignored. O(1).\nexport function toInstant(dt: DateTime): Option<int> {\n  const dim = daysInMonth(dt.year, dt.month);\n  if (dim.isNone()) {\n    return None;\n  }\n  if (dt.day < 1 || dt.day > dim.unwrap()) {\n    return None;\n  }\n  if (dt.hour < 0 || dt.hour > 23 || dt.minute < 0 || dt.minute > 59\n      || dt.second < 0 || dt.second > 59 || dt.millisecond < 0 || dt.millisecond > 999) {\n    return None;\n  }\n  const dayNum = daysFromCivil(dt.year, dt.month, dt.day);\n  return Some(dayNum * 86400000 + dt.hour * 3600000 + dt.minute * 60000 + dt.second * 1000 + dt.millisecond);\n}\n\nfunction pad(n: int, width: usize): string {\n  let s = n.toString();\n  while (s.length < width) {\n    s = \"0\" + s;\n  }\n  return s;\n}\n\n// formatIso(instant: int): string\n// ISO 8601 / RFC 3339 UTC: \"2024-02-29T13:04:05.006Z\" (year padded to at least 4 digits; years\n// before 0 or after 9999 are printed with their sign / extra digits). O(1).\nexport function formatIso(instant: int): string {\n  const t = fromMillis(instant);\n  const ys = t.year < 0 ? \"-\" + pad(0 - t.year, 4) : pad(t.year, 4);\n  return ys + \"-\" + pad(t.month, 2) + \"-\" + pad(t.day, 2) + \"T\" + pad(t.hour, 2) + \":\"\n    + pad(t.minute, 2) + \":\" + pad(t.second, 2) + \".\" + pad(t.millisecond, 3) + \"Z\";\n}\n\n// ---- monotonic clock and pure deadline arithmetic (UNSTABLE, ADR-0027) ----------------------\n// Separate record types prevent accidental use of wall-clock ints in deadline helpers. Explicitly\n// constructed records must have nonnegative millis; helpers return errors for invalid records.\n// Values are process-local observations, not Unix times or persistable/cross-boot timestamps.\nexport type MonotonicInstant = { millis: int; };\nexport type Deadline = { at: MonotonicInstant; };\nexport type TimeErrorKind =\n  ClockUnavailable\n  | InvalidInstant\n  | NegativeDuration\n  | TimeOverflow\n  | ReversedInstants;\nexport type TimeError = { kind: TimeErrorKind; };\n\n// monotonicNow(clock): a fallible monotonic millisecond observation. Clock grant required; denied,\n// wrong-family or revoked grants trap like nowMillis. Clock failures return Err(ClockUnavailable).\n// O(1) time and allocation; no wall-clock fallback, sleep or scheduler semantics.\n@Ensures(result.isOk() ==> result.unwrap().millis >= 0)\nexport function monotonicNow(clock: ClockGrant): Result<MonotonicInstant, TimeError> {\n  const now = monotonicMillis(clock);\n  if (now.isNone()) {\n    return Err(TimeError { kind: ClockUnavailable });\n  }\n  return Ok(MonotonicInstant { millis: now.unwrap() });\n}\n\n// elapsed(start, end): end - start as a Duration. Err on a negative record or reversed observations.\n// Nonnegative ordered i64 timestamps cannot overflow on subtraction. Pure; O(1) time/allocation.\n@Ensures(result.isOk() ==> result.unwrap().millis >= 0)\nexport function elapsed(\n  start: MonotonicInstant,\n  end: MonotonicInstant,\n): Result<Duration, TimeError> {\n  if (start.millis < 0 || end.millis < 0) {\n    return Err(TimeError { kind: InvalidInstant });\n  }\n  if (end.millis < start.millis) {\n    return Err(TimeError { kind: ReversedInstants });\n  }\n  return Ok(Duration { millis: end.millis - start.millis });\n}\n\n// deadlineAfter(start, delay): start + delay. Zero expires at start; negative delays and overflowing\n// additions are errors, not traps. Validate before arithmetic. Pure; O(1) time/allocation.\n@Ensures(result.isOk() ==> result.unwrap().at.millis >= start.millis)\nexport function deadlineAfter(\n  start: MonotonicInstant,\n  delay: Duration,\n): Result<Deadline, TimeError> {\n  if (start.millis < 0) {\n    return Err(TimeError { kind: InvalidInstant });\n  }\n  if (delay.millis < 0) {\n    return Err(TimeError { kind: NegativeDuration });\n  }\n  if (delay.millis > 9223372036854775807 - start.millis) {\n    return Err(TimeError { kind: TimeOverflow });\n  }\n  return Ok(Deadline { at: MonotonicInstant { millis: start.millis + delay.millis } });\n}\n\n// remaining(deadline, now): max(deadline - now, 0); equality is expired. Err on negative records.\n// The comparison precedes subtraction, so expired deadlines cannot underflow. Pure; O(1) time/allocation.\n@Ensures(result.isOk() ==> result.unwrap().millis >= 0)\nexport function remaining(deadline: Deadline, now: MonotonicInstant): Result<Duration, TimeError> {\n  if (deadline.at.millis < 0 || now.millis < 0) {\n    return Err(TimeError { kind: InvalidInstant });\n  }\n  if (now.millis >= deadline.at.millis) {\n    return Ok(Duration { millis: 0 });\n  }\n  return Ok(Duration { millis: deadline.at.millis - now.millis });\n}\n\n// isExpired(deadline, now): now >= deadline; Err on negative records. Pure; O(1) time/allocation.\nexport function isExpired(deadline: Deadline, now: MonotonicInstant): Result<bool, TimeError> {\n  if (deadline.at.millis < 0 || now.millis < 0) {\n    return Err(TimeError { kind: InvalidInstant });\n  }\n  return Ok(now.millis >= deadline.at.millis);\n}\n\n// timeErrorMessage(error): stable nonempty explanation. O(1), returns constant string storage.\n@Ensures(result.length > 0)\nexport function timeErrorMessage(error: TimeError): string {\n  return match (error.kind) {\n    ClockUnavailable => \"monotonic clock unavailable\",\n    InvalidInstant => \"monotonic milliseconds must be nonnegative\",\n    NegativeDuration => \"deadline delay must be nonnegative\",\n    TimeOverflow => \"monotonic deadline overflow\",\n    ReversedInstants => \"monotonic observations are reversed\",\n  };\n}\n" });
  out.push(SourceFile { path: "$stdlib/url.or", text: "// std:url: byte-oriented percent components and strict UTF-8 query pairs.\n// See docs/std-url.md for the wire format, offsets, allocation and complexity.\nimport { Bytes, ByteBuilder, fromString } from \"std:bytes\";\nimport { validate } from \"std:utf8\";\n\nexport type UrlErrorKind = TruncatedEscape | InvalidHex | InvalidUtf8;\n// offset is always a byte offset in the original input, including for UTF-8 errors.\nexport type UrlError = { kind: UrlErrorKind; offset: usize; };\nexport type QueryPair = { key: string; value: string; };\n\n// How a space is written in a component (ADR-0048 rule 2.5; replaces the opposite-polarity `spaceAsPlus` /\n// `plusAsSpace` booleans). PlusAsSpace is the form-style (`application/x-www-form-urlencoded`) mode: encoding writes\n// ASCII space as `+` and decoding reads a raw `+` as a space. PercentSpace is the ordinary component mode: space is\n// `%20` and a raw `+` is an ordinary byte. A literal `+` is always encoded as `%2B` and `%2B` always decodes to `+`.\nexport type FormSpace = PlusAsSpace | PercentSpace;\n\nfunction plusMode(space: FormSpace): bool {\n  return match (space) {\n    PlusAsSpace => true,\n    PercentSpace => false,\n  };\n}\n\n// urlErrorMessage(e): string -- diagnostic text, \"<cause> at byte <offset>\". Never fails; O(1), allocates the message.\n@Ensures(result.length > 0)\nexport function urlErrorMessage(e: UrlError): string {\n  const why = match (e.kind) {\n    TruncatedEscape => \"truncated percent escape\",\n    InvalidHex => \"invalid percent escape\",\n    InvalidUtf8 => \"invalid UTF-8\",\n  };\n  return `${why} at byte ${e.offset.toString()}`;\n}\n\nfunction unreserved(c: int): bool {\n  return c >= 65 && c <= 90\n      || c >= 97 && c <= 122\n      || c >= 48 && c <= 57\n      || c == 45\n      || c == 46\n      || c == 95\n      || c == 126;\n}\n\n@Ensures(result >= -1 && result <= 15)\nfunction hexValue(c: int): int {\n  if (c >= 48 && c <= 57) {\n    return c - 48;\n  }\n  if (c >= 65 && c <= 70) {\n    return c - 55;\n  }\n  if (c >= 97 && c <= 102) {\n    return c - 87;\n  }\n  return -1;\n}\n\n// percentEncode(s, space): string -- only ALPHA / DIGIT / \"-._~\" pass through, every other byte becomes upper-case %HH;\n// with PlusAsSpace an ASCII space becomes `+`. Strings hold bytes: no validation, normalization or Unicode conversion\n// occurs here. Never fails (no errors, no traps); O(s.length) time and allocation.\n@Ensures(result.length >= s.length && result.length <= s.length * 3)\nexport function percentEncode(s: string, space: FormSpace): string {\n  const spaceAsPlus = plusMode(space);\n  let out = new ByteBuilder();\n  let i: usize = 0;\n  while (i < s.length) {\n    const c = s.charCodeAt(i);\n    if (unreserved(c)) {\n      out.appendU8(c.toU8());\n    } else if (spaceAsPlus && c == 32) {\n      out.appendU8(43);\n    } else {\n      out.appendU8(37);\n      out.appendU8(\"0123456789ABCDEF\".charCodeAt((c / 16).toUsize()).toU8());\n      out.appendU8(\"0123456789ABCDEF\".charCodeAt((c % 16).toUsize()).toU8());\n    }\n    i += 1;\n  }\n  return out.build().toRawString();\n}\n\n// percentEncodeBytes(b, space): string -- `percentEncode` of an arbitrary Bytes view, including NUL and invalid UTF-8.\n// Never fails; O(b.length()) time and allocation (including a temporary raw string).\n@Ensures(result.length >= b.length() && result.length <= b.length() * 3)\nexport function percentEncodeBytes(b: Bytes, space: FormSpace): string {\n  return percentEncode(b.toRawString(), space);\n}\n\n// Internal: decode a range without copying the encoded substring. Every '%' must have two hex digits.\n@Requires(start <= end && end <= s.length)\n@Ensures(result.isOk() ==> result.unwrap().length <= end - start)\n@Ensures(result.isErr() ==> result.unwrapErr().offset >= start && result.unwrapErr().offset < end)\nfunction decodeRange(\n  s: string,\n  start: usize,\n  end: usize,\n  plusAsSpace: bool,\n  text: bool,\n): Result<string, UrlError> {\n  let out = new ByteBuilder();\n  let i = start;\n  while (i < end) {\n    const c = s.charCodeAt(i);\n    if (c == 37) {\n      if (end - i < 3) {\n        return Err(UrlError { kind: TruncatedEscape, offset: i });\n      }\n      const hi = hexValue(s.charCodeAt(i + 1));\n      const lo = hexValue(s.charCodeAt(i + 2));\n      if (hi < 0 || lo < 0) {\n        return Err(UrlError { kind: InvalidHex, offset: i });\n      }\n      out.appendU8((hi * 16 + lo).toU8());\n      i += 3;\n    } else {\n      out.appendU8((plusAsSpace && c == 43 ? 32 : c).toU8());\n      i += 1;\n    }\n  }\n  const decoded = out.build().toRawString();\n  if (text) {\n    const valid = validate(decoded);\n    if (valid.isErr()) {\n      // Translate the decoded sequence start back to the encoded source in one extra scan.\n      const target = valid.unwrapErr().offset;\n      let source = start;\n      let pos: usize = 0;\n      while (pos < target) {\n        source += s.charCodeAt(source) == 37 ? 3 : 1;\n        pos += 1;\n      }\n      return Err(UrlError { kind: InvalidUtf8, offset: source });\n    }\n  }\n  return Ok(decoded);\n}\n\n// percentDecodeBytes(s, space): Result<Bytes, UrlError> -- byte decoder: raw non-'%' bytes pass through, arbitrary\n// decoded bytes are accepted; with PlusAsSpace a raw `+` reads as a space. Err(TruncatedEscape | InvalidHex) on a\n// malformed escape, offset at the '%'. Never traps; O(n) time and allocation.\n@Ensures(result.isOk() ==> result.unwrap().length() <= s.length)\n@Ensures(result.isErr() ==> result.unwrapErr().offset < s.length)\nexport function percentDecodeBytes(s: string, space: FormSpace): Result<Bytes, UrlError> {\n  const r = decodeRange(s, 0, s.length, plusMode(space), false);\n  if (r.isErr()) {\n    return Err(r.unwrapErr());\n  }\n  return Ok(fromString(r.unwrap()));\n}\n\n// percentDecode(s, space): Result<string, UrlError> -- text decoder: rejects invalid UTF-8; a raw '+' stays literal\n// unless PlusAsSpace is given. Err(TruncatedEscape | InvalidHex | InvalidUtf8) with the offset in the original input.\n// Never traps; O(n) time and allocation.\n@Ensures(result.isOk() ==> result.unwrap().length <= s.length)\n@Ensures(result.isErr() ==> result.unwrapErr().offset < s.length)\nexport function percentDecode(s: string, space: FormSpace): Result<string, UrlError> {\n  return decodeRange(s, 0, s.length, plusMode(space), true);\n}\n\n// parseQuery(s, space): Result<QueryPair[], UrlError> -- query body only (no leading '?'). Split on '&', then the first\n// '=', before decoding. Empty fields are skipped; a bare key has value \"\"; empty keys and duplicates survive.\n// Err(TruncatedEscape | InvalidHex | InvalidUtf8) with the absolute offset in `s`; no partial result. Never traps;\n// O(n) time and allocation.\n@Ensures(s.length == 0 ==> result.isOk() && result.unwrap().length == 0)\n@Ensures(result.isErr() ==> result.unwrapErr().offset < s.length)\nexport function parseQuery(s: string, space: FormSpace): Result<QueryPair[], UrlError> {\n  const plusAsSpace = plusMode(space);\n  let pairs: QueryPair[] = [];\n  let start: usize = 0;\n  while (start < s.length) {\n    let end = start;\n    while (end < s.length && s.charCodeAt(end) != 38) {\n      end += 1;\n    }\n    if (end > start) {\n      let eq = start;\n      while (eq < end && s.charCodeAt(eq) != 61) {\n        eq += 1;\n      }\n      const key = decodeRange(s, start, eq, plusAsSpace, true);\n      if (key.isErr()) {\n        return Err(key.unwrapErr());\n      }\n      let value = \"\";\n      if (eq < end) {\n        const v = decodeRange(s, eq + 1, end, plusAsSpace, true);\n        if (v.isErr()) {\n          return Err(v.unwrapErr());\n        }\n        value = v.unwrap();\n      }\n      pairs.push(QueryPair { key: key.unwrap(), value: value });\n    }\n    start = end + 1;\n  }\n  return Ok(pairs);\n}\n\n// Why a query could not be written: the key or the value of a pair is not valid UTF-8.\nexport type QueryEncodeErrorKind = InvalidKeyUtf8 | InvalidValueUtf8;\n// pairIndex is the zero-based index of the offending pair; offset is the byte offset of the invalid sequence\n// WITHIN that key or value (which of the two is `kind`).\nexport type QueryEncodeError = { kind: QueryEncodeErrorKind; pairIndex: usize; offset: usize; };\n\n// queryEncodeErrorMessage(e): string -- diagnostic text, \"<cause> in pair <index> at byte <offset>\". Never fails;\n// O(1), allocates the message.\n@Ensures(result.length > 0)\nexport function queryEncodeErrorMessage(e: QueryEncodeError): string {\n  const why = match (e.kind) {\n    InvalidKeyUtf8 => \"invalid UTF-8 in key\",\n    InvalidValueUtf8 => \"invalid UTF-8 in value\",\n  };\n  return `${why} in pair ${e.pairIndex.toString()} at byte ${e.offset.toString()}`;\n}\n\n// stringifyQuery(pairs, space): Result<string, QueryEncodeError> -- ordered key=value fields joined by '&', with no\n// leading question mark; every pair emits key=value in input order. Err(InvalidKeyUtf8 | InvalidValueUtf8) for a key\n// or value that is not valid UTF-8, no partial result. Never traps; O(total bytes + pair count) time and allocation.\n@Ensures(pairs.length == 0 ==> result.isOk() && result.unwrap().length == 0)\n@Ensures(result.isErr() ==> result.unwrapErr().pairIndex < pairs.length)\nexport function stringifyQuery(\n  pairs: QueryPair[],\n  space: FormSpace,\n): Result<string, QueryEncodeError> {\n  let out = new ByteBuilder();\n  let i: usize = 0;\n  while (i < pairs.length) {\n    const p = pairs[i];\n    const key = validate(p.key);\n    if (key.isErr()) {\n      return Err(QueryEncodeError {\n        kind: InvalidKeyUtf8,\n        pairIndex: i,\n        offset: key.unwrapErr().offset,\n      });\n    }\n    const value = validate(p.value);\n    if (value.isErr()) {\n      return Err(QueryEncodeError {\n        kind: InvalidValueUtf8,\n        pairIndex: i,\n        offset: value.unwrapErr().offset,\n      });\n    }\n    if (i > 0) {\n      out.appendU8(38);\n    }\n    out.appendString(percentEncode(p.key, space));\n    out.appendU8(61);\n    out.appendString(percentEncode(p.value, space));\n    i += 1;\n  }\n  return Ok(out.build().toRawString());\n}\n" });
  out.push(SourceFile { path: "$stdlib/utf8.or", text: "// std:utf8 -- validated UTF-8 decoding and encoding, code point iteration and `Utf8String`, a string with the\n// invariant \"always valid UTF-8\" (ADR-0030 \xc2\xa73, layer \"bytes and text\"). Pure safe Orin.\n//\n// Background. Orin strings are byte strings (`length`, `charCodeAt` and `substring` count bytes) that are\n// *expected* to hold UTF-8 but nothing in the language enforces it. This module turns the expectation into a\n// type: a `Utf8String` can only be built from bytes that passed `validate`, so every function that takes one\n// may rely on well-formedness (RFC 3629 / Unicode Table 3-7):\n//\n//   U+0000..U+007F    00..7F\n//   U+0080..U+07FF    C2..DF 80..BF\n//   U+0800..U+0FFF    E0 A0..BF 80..BF         (E0 80..9F is an overlong form)\n//   U+1000..U+CFFF    E1..EC 80..BF 80..BF\n//   U+D000..U+D7FF    ED 80..9F 80..BF         (ED A0..BF is a surrogate, U+D800..U+DFFF)\n//   U+E000..U+FFFF    EE..EF 80..BF 80..BF\n//   U+10000..U+3FFFF  F0 90..BF 80..BF 80..BF  (F0 80..8F is an overlong form)\n//   U+40000..U+FFFFF  F1..F3 80..BF 80..BF 80..BF\n//   U+100000..U+10FFFF F4 80..8F 80..BF 80..BF (F4 90..BF is above U+10FFFF)\n//\n// Rejected, with the error kind: a continuation byte (80..BF) as first byte, or F8..FF (`InvalidLead`); C0, C1\n// and the overlong forms above (`Overlong`); surrogates (`Surrogate`); F5..F7 and F4 90..BF (`TooLarge`);\n// a sequence cut off by the end of input (`TruncatedSequence`); a missing continuation byte\n// (`InvalidContinuation`). Noncharacters (U+FFFE, U+FFFF, U+FDD0..) are valid scalar values and accepted.\n//\n// Error position. `Utf8Error.offset` is the byte offset where the first invalid sequence starts, i.e. the\n// length of the longest valid prefix, and `length` the number of bytes of the maximal invalid prefix at that\n// point (1..3; for a truncated sequence the bytes left). Everything before `offset` is valid UTF-8.\n//\n// Names (ADR-0048 sections 1 and 1.2). The module is the codec, so its verbs are bare: `validate(s)` checks a string,\n// `decode(bytes)` makes a `Utf8String` from bytes, `encode(s)` turns one into bytes; `isValid(s)` is the predicate for\n// contracts. `Utf8String.tryFrom(text)` is the `Result` twin of `new Utf8String(text)`. Old names (`checkUtf8`,\n// `isValidUtf8`, `validateString`, `utf8Len`) stay one release as deprecated wrappers.\n//\n// Contract standard (ADR-0030 \xc2\xa73): `Utf8String` and `CodePointCursor` carry invariants checked after every\n// public method (`orin test`, `--check-contracts`); the constructor of `Utf8String` *always* validates, so the\n// invariant also holds in builds without contract checking. Helpers used in contracts are loops, not closures.\n//\n// Complexity: n = byte length. `validate`, `decode`, `isValid` (one table-driven pass, no allocation), `codePointCount`, `codePoints`, `concat`, `trySlice`,\n// `fromCodePoints` O(n); `encodeCodePoint`, `encodedLength`, `codePointAt`, `isCharBoundary`, `byteLength` O(1);\n// `CodePointCursor.next` O(1); constructing a `Utf8String` validates, O(n).\n\nimport { Bytes, ByteBuilder, fromString } from \"std:bytes\";\n\n// ---------------------------------------------------------------------------------------------- errors\n\nexport type Utf8ErrorKind = InvalidLead | TruncatedSequence | InvalidContinuation | Overlong | Surrogate | TooLarge;\n\n// Why a byte sequence is not UTF-8: InvalidLead: a continuation byte or F8..FF where a sequence must start;\n// TruncatedSequence: the input ends inside a sequence; InvalidContinuation: a byte that is not 80..BF inside a\n// sequence; Overlong: C0, C1 or an overlong form; Surrogate: an encoded U+D800..U+DFFF; TooLarge: above U+10FFFF.\n// offset: byte offset of the first invalid sequence (the length of the longest valid prefix).\n// length: bytes of the maximal invalid prefix there (1..3). kind: why it is invalid.\nexport type Utf8Error = { kind: Utf8ErrorKind; offset: usize; length: usize; };\n\n// utf8ErrorMessage(e): string -- \"invalid UTF-8 at byte 3: overlong encoding\". Never fails; O(1), allocates the message.\n@Ensures(result.length > 0)\nexport function utf8ErrorMessage(e: Utf8Error): string {\n  const why = match (e.kind) {\n    InvalidLead => \"invalid leading byte\",\n    TruncatedSequence => \"truncated sequence\",\n    InvalidContinuation => \"invalid continuation byte\",\n    Overlong => \"overlong encoding\",\n    Surrogate => \"encoded surrogate\",\n    TooLarge => \"code point above U+10FFFF\"\n  };\n  return `invalid UTF-8 at byte ${e.offset.toString()}: ${why}`;\n}\n\n// ------------------------------------------------------------------------------------ scalar values\n\n// isScalarValue(cp): bool -- cp is a Unicode scalar value: 0..0xD7FF or 0xE000..0x10FFFF. Never fails. O(1).\n@Ensures(result ==> cp >= 0 && cp <= 1114111)\n@Ensures(cp >= 55296 && cp <= 57343 ==> !result)\nexport function isScalarValue(cp: int): bool {\n  return (cp >= 0 && cp < 55296) || (cp >= 57344 && cp <= 1114111);\n}\n\n// encodedLength(cp): int -- number of UTF-8 bytes of a scalar value (1..4). Traps unless cp is a scalar value. O(1).\n@Requires(isScalarValue(cp))\n@Ensures(result >= 1 && result <= 4)\n@Ensures((result == 1) == (cp < 128))\n@Ensures((result == 4) == (cp >= 65536))\nexport function encodedLength(cp: int): int {\n  if (cp < 128) {\n    return 1;\n  }\n  if (cp < 2048) {\n    return 2;\n  }\n  if (cp < 65536) {\n    return 3;\n  }\n  return 4;\n}\n\n@Deprecated(\"use encodedLength(cp) (ADR-0048)\")\n@Requires(isScalarValue(cp))\nexport function utf8Len(cp: int): int {\n  return encodedLength(cp);\n}\n\n// encodeCodePoint(cp): Option<string> -- the UTF-8 bytes of a scalar value as a string; None for surrogates, values\n// above U+10FFFF and negative values. Never traps. O(1).\n@Ensures(result.isSome() == isScalarValue(cp))\n@Ensures(result.isSome() ==> result.unwrap().length.toInt() == encodedLength(cp))\n@Ensures(result.isSome() ==> isValid(result.unwrap()) && decodeAt(result.unwrap(), 0) == cp)\nexport function encodeCodePoint(cp: int): Option<string> {\n  if (!isScalarValue(cp)) {\n    return None;\n  }\n  if (cp < 128) {\n    return Some(String.fromCharCode(cp));\n  }\n  if (cp < 2048) {\n    return Some(String.fromCharCode(192 + cp / 64) + String.fromCharCode(128 + cp % 64));\n  }\n  if (cp < 65536) {\n    return Some(String.fromCharCode(224 + cp / 4096) + String.fromCharCode(128 + (cp / 64) % 64)\n      + String.fromCharCode(128 + cp % 64));\n  }\n  return Some(String.fromCharCode(240 + cp / 262144) + String.fromCharCode(128 + (cp / 4096) % 64)\n    + String.fromCharCode(128 + (cp / 64) % 64) + String.fromCharCode(128 + cp % 64));\n}\n\n// ------------------------------------------------------------------------------------------ scanning\n\nfunction isCont(c: int): bool {\n  return c >= 128 && c <= 191;\n}\n\n// Result of looking at one sequence: `kind` is None for a valid sequence of `len` bytes, else the error.\ntype Seq = { len: usize; kind: Option<Utf8ErrorKind>; };\n\nfunction okSeq(len: usize): Seq {\n  return Seq { len: len, kind: None };\n}\n\nfunction badSeq(len: usize, k: Utf8ErrorKind): Seq {\n  return Seq { len: len, kind: Some(k) };\n}\n\n// Looks at the sequence starting at byte i of s (i < s.length).\n@Requires(i < s.length)\n@Ensures(result.len >= 1 && result.len <= 4 && i + result.len <= s.length)\nfunction scanSeq(s: string, i: usize): Seq {\n  const n = s.length;\n  const c = s.charCodeAt(i);\n  if (c < 128) {\n    return okSeq(1);\n  }\n  if (c < 192) {\n    return badSeq(1, InvalidLead);\n  }\n  if (c < 194) {\n    return badSeq(1, Overlong);\n  }\n  if (c >= 245) {\n    if (c < 248) {\n      return badSeq(1, TooLarge);\n    }\n    return badSeq(1, InvalidLead);\n  }\n  let need: usize = 1;\n  let lo2 = 128;\n  let hi2 = 191;\n  if (c >= 240) {\n    need = 3;\n    if (c == 240) {\n      lo2 = 144;\n    }\n    if (c == 244) {\n      hi2 = 143;\n    }\n  } else if (c >= 224) {\n    need = 2;\n    if (c == 224) {\n      lo2 = 160;\n    }\n    if (c == 237) {\n      hi2 = 159;\n    }\n  }\n  if (i + 1 >= n) {\n    return badSeq(1, TruncatedSequence);\n  }\n  const b2 = s.charCodeAt(i + 1);\n  if (!isCont(b2)) {\n    return badSeq(1, InvalidContinuation);\n  }\n  if (b2 < lo2 || b2 > hi2) {\n    if (c == 237) {\n      return badSeq(1, Surrogate);\n    }\n    if (c == 244) {\n      return badSeq(1, TooLarge);\n    }\n    return badSeq(1, Overlong);\n  }\n  let k: usize = 2;\n  while (k <= need) {\n    if (i + k >= n) {\n      return badSeq(k, TruncatedSequence);\n    }\n    if (!isCont(s.charCodeAt(i + k))) {\n      return badSeq(k, InvalidContinuation);\n    }\n    k += 1;\n  }\n  return okSeq(need + 1);\n}\n\n// The validator is table-driven (Bjoern Hoehrmann's UTF-8 DFA, 12 byte classes x 9 states, accepting state 0,\n// rejecting state 12; the tables are string constants because Orin has no constant arrays). Runs of ASCII bytes\n// are skipped without table lookups. `scanSeq` (above) is only used on the error path, to classify the first bad\n// sequence; the tests check the DFA against it on every 1- and 2-byte input and on boundary-heavy 3- and 4-byte\n// inputs. Class table: 256 entries indexed by the byte; transition table: next = NEXT[state + class].\nconst UTF8_CLASS: string = \"\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x01\\x01\\x01\\x01\\x01\\x01\\x01\\x01\\x01\\x01\\x01\\x01\\x01\\x01\\x01\\x01\\x09\\x09\\x09\\x09\\x09\\x09\\x09\\x09\\x09\\x09\\x09\\x09\\x09\\x09\\x09\\x09\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x07\\x08\\x08\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x02\\x0a\\x03\\x03\\x03\\x03\\x03\\x03\\x03\\x03\\x03\\x03\\x03\\x03\\x04\\x03\\x03\\x0b\\x06\\x06\\x06\\x05\\x08\\x08\\x08\\x08\\x08\\x08\\x08\\x08\\x08\\x08\\x08\";\nconst UTF8_NEXT: string = \"\\x00\\x0c\\x18\\x24\\x3c\\x60\\x54\\x0c\\x0c\\x0c\\x30\\x48\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x00\\x0c\\x0c\\x0c\\x0c\\x0c\\x00\\x0c\\x00\\x0c\\x0c\\x0c\\x18\\x0c\\x0c\\x0c\\x0c\\x0c\\x18\\x0c\\x18\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x18\\x0c\\x0c\\x0c\\x0c\\x0c\\x18\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x18\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x24\\x0c\\x24\\x0c\\x0c\\x0c\\x24\\x0c\\x0c\\x0c\\x0c\\x0c\\x24\\x0c\\x24\\x0c\\x0c\\x0c\\x24\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\\x0c\";\n\n// validPrefix(s): usize -- the length of the longest prefix of s that is valid UTF-8 and ends on a sequence boundary:\n// s.length when s is valid, else the offset of the first invalid (or cut-off) sequence. One pass, O(n), no\n// allocation. The spec decoder `scanSeq` agrees at the returned offset (checked by the contract).\n@Ensures(result <= s.length)\n@Ensures(result < s.length ==> scanSeq(s, result).kind.isSome())\nfunction validPrefix(s: string): usize {\n  const n = s.length;\n  let i: usize = 0;\n  while (i < n) {\n    if (s.charCodeAt(i) < 128) {\n      i += 1;\n      while (i < n && s.charCodeAt(i) < 128) {\n        i += 1;\n      }\n    } else {\n      const start = i;\n      let st = 0;\n      while (i < n) {\n        st = UTF8_NEXT.charCodeAt((st + UTF8_CLASS.charCodeAt(s.charCodeAt(i).toUsize())).toUsize());\n        i += 1;\n        if (st <= 12) {\n          break;\n        }\n      }\n      if (st != 0) {\n        return start;\n      }\n    }\n  }\n  return n;\n}\n\n// validate(s): Result<void, Utf8Error> -- Ok when the bytes of `s` are well-formed UTF-8, else the first error\n// (kind, offset of the first invalid sequence, length of the invalid prefix there). Never traps; O(n), no allocation\n// unless it fails.\n@Ensures(result.isErr() ==> result.unwrapErr().offset < s.length)\n@Ensures(result.isErr() ==> result.unwrapErr().offset + result.unwrapErr().length <= s.length)\n@Ensures(s.length == 0 ==> result.isOk())\nexport function validate(s: string): Result<void, Utf8Error> {\n  const p = validPrefix(s);\n  if (p == s.length) {\n    return Ok();\n  }\n  const q = scanSeq(s, p);\n  return Err(Utf8Error { kind: q.kind.unwrap(), offset: p, length: q.len });\n}\n\n@Deprecated(\"use validate(s) (ADR-0048)\")\n@Ensures(s.length == 0 ==> result.isOk())\nexport function checkUtf8(s: string): Result<void, Utf8Error> {\n  return validate(s);\n}\n\n// isValid(s): bool -- are the bytes of `s` well-formed UTF-8? The predicate form of `validate`, usable in contracts.\n// Never fails. O(n), no allocation.\n@Ensures(s.length == 0 ==> result)\nexport function isValid(s: string): bool {\n  return validPrefix(s) == s.length;\n}\n\n@Deprecated(\"use isValid(s) (ADR-0048)\")\n@Ensures(s.length == 0 ==> result)\nexport function isValidUtf8(s: string): bool {\n  return isValid(s);\n}\n\n// Number of code points of a string that is valid UTF-8 (not re-checked: that would make callers quadratic): the bytes that are not continuation bytes. O(n).\n@Ensures(result <= s.length)\n@Ensures((result == 0) == (s.length == 0))\nfunction countCodePoints(s: string): usize {\n  let n: usize = 0;\n  let i: usize = 0;\n  while (i < s.length) {\n    if (!isCont(s.charCodeAt(i))) {\n      n += 1;\n    }\n    i += 1;\n  }\n  return n;\n}\n\n// The code point of the sequence starting at byte i of s, which must be valid UTF-8 (not re-checked, see above).\n@Requires(i < s.length && !isCont(s.charCodeAt(i)))\n@Ensures(isScalarValue(result))\nfunction decodeAt(s: string, i: usize): int {\n  const c = s.charCodeAt(i);\n  if (c < 128) {\n    return c;\n  }\n  if (c < 224) {\n    return (c - 192) * 64 + (s.charCodeAt(i + 1) - 128);\n  }\n  if (c < 240) {\n    return (c - 224) * 4096 + (s.charCodeAt(i + 1) - 128) * 64 + (s.charCodeAt(i + 2) - 128);\n  }\n  return (c - 240) * 262144 + (s.charCodeAt(i + 1) - 128) * 4096 + (s.charCodeAt(i + 2) - 128) * 64\n    + (s.charCodeAt(i + 3) - 128);\n}\n\n// ------------------------------------------------------------------------------------------ Utf8String\n\n// A string that is valid UTF-8 by construction. Value semantics like every class: a copy is independent and\n// there is no mutating method, so the invariant cannot be broken after construction.\n@Invariant(isValid(this.text))\nexport class Utf8String {\n  private text: string;\n\n  // new Utf8String(text): wraps a string that is already valid UTF-8. Traps (unwrap of an Err) on invalid\n  // input, in every build: use `Utf8String.tryFrom(text)` or `decode(bytes)` to get a Result. O(n).\n  @Requires(isValid(text))\n  constructor(text: string) {\n    this.text = checked(text);\n  }\n\n  // Utf8String.tryFrom(text): Result<Utf8String, Utf8Error> -- `text` as a Utf8String, or the first error; the\n  // `Result` twin of the constructor (ADR-0048 rule 3.3). Never traps; O(n).\n  @Ensures(result.isOk() == isValid(text))\n  @Ensures(result.isOk() ==> result.unwrap().asString() == text)\n  @Ensures(result.isErr() ==> result.unwrapErr().offset < text.length)\n  static tryFrom(text: string): Result<Utf8String, Utf8Error> {\n    const r = validate(text);\n    if (r.isErr()) {\n      return Err(r.unwrapErr());\n    }\n    return Ok(new Utf8String(text));\n  }\n\n  // asString(): string -- the text (valid UTF-8). O(1).\n  @Ensures(isValid(result))\n  asString(): string {\n    return this.text;\n  }\n\n  // byteLength(): usize -- number of bytes. O(1).\n  @Ensures(result == this.text.length)\n  byteLength(): usize {\n    return this.text.length;\n  }\n\n  // isEmpty(): bool -- no bytes (and no code points). O(1).\n  @Ensures(result == (this.byteLength() == 0))\n  isEmpty(): bool {\n    return this.text.length == 0;\n  }\n\n  // toBytes(): Bytes -- the UTF-8 encoding as `Bytes`. O(n).\n  @Ensures(result.length() == this.text.length)\n  toBytes(): Bytes {\n    return fromString(this.text);\n  }\n\n  // codePointCount(): usize -- number of code points. Between byteLength()/4 and byteLength(). O(n).\n  @Ensures(result <= this.text.length)\n  @Ensures(result * 4 >= this.text.length)\n  codePointCount(): usize {\n    return countCodePoints(this.text);\n  }\n\n  // isCharBoundary(i): bool -- i is 0, byteLength(), or the index of the first byte of a code point. O(1).\n  @Ensures(i > this.text.length ==> !result)\n  @Ensures(i == 0 || i == this.text.length ==> result)\n  isCharBoundary(i: usize): bool {\n    if (i > this.text.length) {\n      return false;\n    }\n    if (i == this.text.length) {\n      return true;\n    }\n    return !isCont(this.text.charCodeAt(i));\n  }\n\n  // codePointAt(i): Option<int> -- the code point starting at byte i; None unless i is a boundary before the end. O(1).\n  @Ensures(result.isSome() == (i < this.text.length && this.isCharBoundary(i)))\n  @Ensures(result.isSome() ==> isScalarValue(result.unwrap()))\n  codePointAt(i: usize): Option<int> {\n    if (i >= this.text.length || isCont(this.text.charCodeAt(i))) {\n      return None;\n    }\n    return Some(decodeAt(this.text, i));\n  }\n\n  // codePoints(): int[] -- all code points in order. O(n).\n  @Ensures(result.length == this.codePointCount())\n  codePoints(): int[] {\n    let out: int[] = [];\n    let i: usize = 0;\n    while (i < this.text.length) {\n      const c = decodeAt(this.text, i);\n      out.push(c);\n      i += encodedLength(c).toUsize();\n    }\n    return out;\n  }\n\n  // concat(other): Utf8String -- this followed by other; concatenation of valid UTF-8 is valid. O(n + m).\n  @Ensures(result.byteLength() == this.text.length + other.byteLength())\n  @Ensures(result.codePointCount() == this.codePointCount() + other.codePointCount())\n  concat(other: Utf8String): Utf8String {\n    return new Utf8String(this.text + other.asString());\n  }\n\n  // trySlice(lo, hi): Option<Utf8String> -- the bytes [lo, hi) as a Utf8String; None unless lo <= hi <= byteLength() and both ends\n  // are code point boundaries (so the result is valid by construction). O(hi - lo).\n  @Ensures(result.isSome() == (lo <= hi && this.isCharBoundary(lo) && this.isCharBoundary(hi)))\n  @Ensures(result.isSome() ==> result.unwrap().byteLength() == hi - lo)\n  trySlice(lo: usize, hi: usize): Option<Utf8String> {\n    if (lo > hi || !this.isCharBoundary(lo) || !this.isCharBoundary(hi)) {\n      return None;\n    }\n    return Some(new Utf8String(this.text.substring(lo, hi)));\n  }\n}\n\n// Returns s when it is valid UTF-8 and traps otherwise (the guard of the `Utf8String` constructor).\n@Requires(isValid(s))\n@Ensures(result == s)\nfunction checked(s: string): string {\n  validate(s).unwrap();\n  return s;\n}\n\n@Deprecated(\"use Utf8String.tryFrom(text) (ADR-0048)\")\n@Ensures(result.isOk() == isValid(s))\nexport function validateString(s: string): Result<Utf8String, Utf8Error> {\n  return Utf8String.tryFrom(s);\n}\n\n// decode(b): Result<Utf8String, Utf8Error> -- the text of the UTF-8 bytes `b`, rejecting overlong forms, surrogates\n// and values above U+10FFFF, with the offset of the first problem. Never traps; O(n).\n@Ensures(result.isOk() ==> result.unwrap().byteLength() == b.length())\n@Ensures(result.isErr() ==> result.unwrapErr().offset < b.length())\nexport function decode(b: Bytes): Result<Utf8String, Utf8Error> {\n  return Utf8String.tryFrom(b.toRawString());\n}\n\n// encode(s): Bytes -- the UTF-8 bytes of a Utf8String (`s.toBytes()`). Never fails. O(n).\n@Ensures(result.length() == s.byteLength())\nexport function encode(s: Utf8String): Bytes {\n  return s.toBytes();\n}\n\n// fromCodePoints(cps): Option<Utf8String> -- the string made of the code points; None if any is not a scalar value. O(n).\n@Ensures(result.isSome() ==> result.unwrap().codePointCount() == cps.length)\n@Ensures(cps.length == 0 ==> result.isSome() && result.unwrap().isEmpty())\nexport function fromCodePoints(cps: int[]): Option<Utf8String> {\n  let parts: string[] = [];\n  let i: usize = 0;\n  while (i < cps.length) {\n    const e = encodeCodePoint(cps[i]);\n    if (e.isNone()) {\n      return None;\n    }\n    parts.push(e.unwrap());\n    i += 1;\n  }\n  return Some(new Utf8String(parts.join(\"\")));\n}\n\n// --------------------------------------------------------------------------------------------- cursor\n\n// Iterates the code points of a Utf8String. The cursor always sits on a code point boundary.\n@Invariant(this.pos <= this.src.byteLength() && this.src.isCharBoundary(this.pos))\nexport class CodePointCursor {\n  private src: Utf8String;\n  private pos: usize = 0;\n\n  constructor(src: Utf8String) {\n    this.src = src;\n  }\n\n  // position(): usize -- byte offset of the next code point. O(1).\n  @Ensures(result <= this.src.byteLength())\n  position(): usize {\n    return this.pos;\n  }\n\n  // hasNext(): bool -- a code point is left. O(1).\n  @Ensures(result == (this.pos < this.src.byteLength()))\n  hasNext(): bool {\n    return this.pos < this.src.byteLength();\n  }\n\n  // next(): Option<int> -- the next code point and advance past it; None at the end. O(1).\n  @Ensures(result.isSome() == old(this.hasNext()))\n  @Ensures(result.isSome() ==> isScalarValue(result.unwrap()))\n  @Ensures(result.isSome() ==> this.position() == old(this.position()) + encodedLength(result.unwrap()).toUsize())\n  @Ensures(result.isNone() ==> this.position() == old(this.position()))\n  next(): Option<int> {\n    const c = this.src.codePointAt(this.pos);\n    if (c.isNone()) {\n      return None;\n    }\n    this.pos += encodedLength(c.unwrap()).toUsize();\n    return c;\n  }\n}\n" });
  return out;
}
