export function embeddedStdlibFiles(): SourceFile[] {
  let out: SourceFile[] = [];
  out.push(SourceFile { path: "$stdlib/bytes.or", text: "// std:bytes -- immutable byte sequences, a byte builder and a bounds-checked byte reader (ADR-0030 \xc2\xa73,\n// layer \"bytes and text\"). Pure safe Orin: no C, no new built-ins.\n//\n// Representation. A byte is a `u8`. `Bytes` is a view `data[start .. start + len)` of a `u8[]`; arrays are\n// copy-on-write values, so a `Bytes` never changes and `slice` is O(1) (the storage is shared, nothing is\n// copied until somebody mutates it, and nobody can: the fields are private and `Bytes` has no mutating\n// method). The runtime stores a `u8` array element in 8 bytes (ADR-0022); strings are the compact form and\n// `toRawString` / `fromString` convert byte for byte in O(n).\n//\n// Contract standard (ADR-0030 \xc2\xa73). Every class carries an `@Invariant` that the checked build\n// (`orin test`, `--check-contracts`) verifies after every public method; every public method states\n// `@Requires` / `@Ensures`; helpers used in contracts are loops, not closures, and never call themselves.\n// Reads never trap: `ByteReader` returns `Err(BytesError)` when fewer bytes remain than requested, and the\n// cursor is left where it was.\n//\n// Names follow ADR-0048 section 1: `length()` for the element count of a sequence, `get(i)` the checked read and\n// `at(i)` the contract read, `fromX(..)` build a `Bytes` (call them as `bytes.fromString(s)` after `import * as bytes`),\n// `toX()` copies out. Hex has one home, `std:encoding` (`hexEncode` / `hexDecode` / `hexDecodeText`); `Bytes.toHex()`\n// stays as the implementation `hexEncode` calls, `bytesFromHex` is a deprecated leftover (std:bytes cannot import\n// std:encoding: that would be an import cycle).\n//\n// Complexity: n = number of bytes involved. `length`, `get`, `at`, `slice`, `trySlice` O(1); `concat`, `equals`,\n// `startsWith`, `indexOf`, `indexOfBytes`, `toArray`, `toRawString`, `toHex` O(n); `ByteBuilder.append*` amortised O(1) per byte;\n// `ByteReader.read*` O(1) per byte read (`readExact` O(n): it copies nothing, it slices).\n\n// ---------------------------------------------------------------------------------------------- Bytes\n\n// The one helper a contract of this module needs (`allBytes`, for `fromInts`) lives in `std:bytes/internal` (ADR-0048\n// rule 7.3): it is not API.\nimport { allBytes } from \"std:bytes/internal\";\n\n// An immutable sequence of bytes: the view data[start .. start + len).\n@Invariant(this.start + this.len <= this.data.length)\nexport class Bytes {\n  private data: u8[];\n  private start: usize;\n  private len: usize;\n\n  // new Bytes(data, start, len): the view of `len` bytes of `data` from `start`. Most code uses\n  // `fromArray` / `fromString` / `empty` instead.\n  @Requires(start + len <= data.length)\n  constructor(data: u8[], start: usize, len: usize) {\n    this.data = data;\n    this.start = start;\n    this.len = len;\n  }\n\n  // length(): usize -- number of bytes. O(1).\n  @Ensures(result == this.len)\n  length(): usize {\n    return this.len;\n  }\n\n  // isEmpty(): bool -- true when there are no bytes. O(1).\n  @Ensures(result == (this.length() == 0))\n  isEmpty(): bool {\n    return this.len == 0;\n  }\n\n  // get(i): Option<u8> -- the byte at index i, or None when i >= length(). Never traps. O(1).\n  @Ensures(result.isSome() == (i < this.len))\n  get(i: usize): Option<u8> {\n    if (i >= this.len) {\n      return None;\n    }\n    return Some(this.data[this.start + i]);\n  }\n\n  // at(i): u8 -- the byte at index i. Precondition i < length(). O(1).\n  @Requires(i < this.len)\n  at(i: usize): u8 {\n    return this.data[this.start + i];\n  }\n\n  // slice(lo, hi): Bytes -- the bytes [lo, hi). Shares storage with the receiver. O(1).\n  @Requires(lo <= hi && hi <= this.len)\n  @Ensures(result.length() == hi - lo)\n  @Ensures(hi > lo ==> result.at(0) == this.at(lo) && result.at(hi - lo - 1) == this.at(hi - 1))\n  slice(lo: usize, hi: usize): Bytes {\n    return new Bytes(this.data, this.start + lo, hi - lo);\n  }\n\n  // trySlice(lo, hi): Option<Bytes> -- `slice` that answers None instead of requiring lo <= hi <= length(). O(1).\n  @Ensures(result.isSome() == (lo <= hi && hi <= this.len))\n  @Ensures(result.isSome() ==> result.unwrap().length() == hi - lo)\n  trySlice(lo: usize, hi: usize): Option<Bytes> {\n    if (lo > hi || hi > this.len) {\n      return None;\n    }\n    return Some(this.slice(lo, hi));\n  }\n\n  // concat(other): Bytes -- this followed by other. O(length() + other.length()).\n  @Ensures(result.length() == this.len + other.length())\n  @Ensures(this.len > 0 ==> result.at(0) == this.at(0))\n  @Ensures(other.length() > 0 ==> result.at(this.len) == other.at(0))\n  @Ensures(other.length() > 0 ==> result.at(this.len + other.length() - 1) == other.at(other.length() - 1))\n  concat(other: Bytes): Bytes {\n    let out: u8[] = [];\n    let i: usize = 0;\n    while (i < this.len) {\n      out.push(this.data[this.start + i]);\n      i += 1;\n    }\n    let j: usize = 0;\n    while (j < other.length()) {\n      out.push(other.at(j));\n      j += 1;\n    }\n    return new Bytes(out, 0, out.length);\n  }\n\n  // equals(other): bool -- same length and same bytes. O(n).\n  @Ensures(result ==> this.len == other.length())\n  @Ensures(this.len != other.length() ==> !result)\n  equals(other: Bytes): bool {\n    if (this.len != other.length()) {\n      return false;\n    }\n    let i: usize = 0;\n    while (i < this.len) {\n      if (this.data[this.start + i] != other.at(i)) {\n        return false;\n      }\n      i += 1;\n    }\n    return true;\n  }\n\n  // startsWith(prefix): bool -- the first prefix.length() bytes equal `prefix`. O(prefix.length()).\n  @Ensures(result ==> prefix.length() <= this.len)\n  @Ensures(prefix.length() == 0 ==> result)\n  startsWith(prefix: Bytes): bool {\n    if (prefix.length() > this.len) {\n      return false;\n    }\n    let i: usize = 0;\n    while (i < prefix.length()) {\n      if (this.data[this.start + i] != prefix.at(i)) {\n        return false;\n      }\n      i += 1;\n    }\n    return true;\n  }\n\n  // indexOf(b): Option<usize> -- the first index holding byte b, or None. Never traps. O(n).\n  @Ensures(result.isSome() ==> result.unwrap() < this.len && this.at(result.unwrap()) == b)\n  indexOf(b: u8): Option<usize> {\n    let i: usize = 0;\n    while (i < this.len) {\n      if (this.data[this.start + i] == b) {\n        return Some(i);\n      }\n      i += 1;\n    }\n    return None;\n  }\n\n  // includes(b): bool -- is byte b present? Never traps. O(n).\n  @Ensures(result == this.indexOf(b).isSome())\n  includes(b: u8): bool {\n    return this.indexOf(b).isSome();\n  }\n\n  // indexOfBytes(needle, begin): Option<usize> -- the first index i >= begin where the bytes of `needle` occur, or None.\n  // An empty needle matches at `begin` when begin <= length(). None when begin > length() or the needle does not fit.\n  // Never traps. O(length() * needle.length()) worst case, O(length()) typical.\n  @Ensures(result.isSome() ==> result.unwrap() >= begin && result.unwrap() + needle.length() <= this.len)\n  @Ensures(needle.length() == 0 ==> result.isSome() == (begin <= this.len))\n  indexOfBytes(needle: Bytes, begin: usize): Option<usize> {\n    const m = needle.length();\n    if (begin > this.len || m > this.len - begin) {\n      return None;\n    }\n    let i = begin;\n    while (i + m <= this.len) {\n      let k: usize = 0;\n      while (k < m && this.data[this.start + i + k] == needle.at(k)) {\n        k += 1;\n      }\n      if (k == m) {\n        return Some(i);\n      }\n      i += 1;\n    }\n    return None;\n  }\n\n  // toArray(): u8[] -- a copy of the bytes. O(n).\n  @Ensures(result.length == this.len)\n  toArray(): u8[] {\n    return this.data.slice(this.start, this.start + this.len);\n  }\n\n  // storage(): u8[] -- the array the view reads, without a copy: byte i of the view is `storage()[storageStart() + i]`. For\n  // byte loops that would otherwise call `at` per byte (a call and a reference count each) or copy with `toArray`.\n  // Arrays are values, so the caller cannot change the view through it. O(1).\n  @Ensures(result.length >= this.start + this.len)\n  @Ensures(this.len > 0 ==> result[this.start] == this.at(0) && result[this.start + this.len - 1] == this.at(this.len - 1))\n  storage(): u8[] {\n    return this.data;\n  }\n\n  // storageStart(): usize -- the index in `storage()` of the first byte of the view. O(1).\n  @Ensures(result == this.start && result + this.len <= this.storage().length)\n  storageStart(): usize {\n    return this.start;\n  }\n\n  // toRawString(): string -- the same bytes as a string. No validation: the string holds arbitrary bytes (use\n  // `std:utf8` to get text). Inverse of `bytesFromString`. O(n).\n  @Ensures(result.length == this.len)\n  toRawString(): string {\n    return bytesToString(this.data, this.start, this.len);\n  }\n\n  // toHex(): string -- lower-case hexadecimal, two digits per byte; `std:encoding.hexEncode` calls this. Never fails. O(n).\n  @Ensures(result.length == 2 * this.len)\n  toHex(): string {\n    const digits = \"0123456789abcdef\";\n    let out: u8[] = [];\n    let i: usize = 0;\n    while (i < this.len) {\n      const b = this.data[this.start + i].toInt();\n      out.push(digits.charCodeAt((b / 16).toUsize()).toU8());\n      out.push(digits.charCodeAt((b % 16).toUsize()).toU8());\n      i += 1;\n    }\n    return bytesToString(out, 0, out.length);\n  }\n}\n\n// The value of a hexadecimal digit character code, or -1.\n@Ensures(result >= -1 && result < 16)\nfunction hexValue(c: int): int {\n  if (c >= 48 && c <= 57) {\n    return c - 48;\n  }\n  if (c >= 97 && c <= 102) {\n    return c - 87;\n  }\n  if (c >= 65 && c <= 70) {\n    return c - 55;\n  }\n  return -1;\n}\n\n// empty(): Bytes -- no bytes. Never fails. O(1).\n@Ensures(result.length() == 0)\nexport function empty(): Bytes {\n  return new Bytes([], 0, 0);\n}\n\n@Deprecated(\"use empty() (ADR-0048)\")\nexport function emptyBytes(): Bytes {\n  return empty();\n}\n\n// fromArray(xs): Bytes -- the bytes of `xs` (the array is shared, not copied). Never fails. O(1).\n@Ensures(result.length() == xs.length)\nexport function fromArray(xs: u8[]): Bytes {\n  return new Bytes(xs, 0, xs.length);\n}\n\n@Deprecated(\"use fromArray(xs) (ADR-0048)\")\nexport function bytesFromArray(xs: u8[]): Bytes {\n  return fromArray(xs);\n}\n\n// fromInts(xs): Bytes -- bytes from integers. Traps unless every element lies in 0..255. O(n).\n@Requires(allBytes(xs))\n@Ensures(result.length() == xs.length)\nexport function fromInts(xs: int[]): Bytes {\n  let out: u8[] = [];\n  let i: usize = 0;\n  while (i < xs.length) {\n    out.push(xs[i].toU8());\n    i += 1;\n  }\n  return new Bytes(out, 0, out.length);\n}\n\n@Deprecated(\"use fromInts(xs) (ADR-0048)\")\n@Requires(allBytes(xs))\nexport function bytesFromInts(xs: int[]): Bytes {\n  return fromInts(xs);\n}\n\n// fromString(s): Bytes -- the bytes of a string, one per string byte (no encoding step). Never fails. O(n).\n@Ensures(result.length() == s.length)\nexport function fromString(s: string): Bytes {\n  const out = stringToBytes(s);\n  return new Bytes(out, 0, out.length);\n}\n\n@Deprecated(\"use fromString(s) (ADR-0048)\")\nexport function bytesFromString(s: string): Bytes {\n  return fromString(s);\n}\n\n// bytesFromHex(s): Option<Bytes> -- DEPRECATED, use `std:encoding.hexDecodeText(s)`, which reports why a text is not hex.\n// Decodes pairs of hex digits (either case); None for an odd length or a non-hex character. O(n). Kept with its own\n// code for one release because std:bytes cannot import std:encoding (import cycle).\n@Deprecated(\"use hexDecodeText(s) of std:encoding, which returns a Result (ADR-0048)\")\n@Ensures(result.isSome() ==> result.unwrap().length() * 2 == s.length)\n@Ensures(s.length % 2 == 1 ==> result.isNone())\nexport function bytesFromHex(s: string): Option<Bytes> {\n  if (s.length % 2 == 1) {\n    return None;\n  }\n  let out: u8[] = [];\n  let i: usize = 0;\n  while (i < s.length) {\n    const hi = hexValue(s.charCodeAt(i));\n    const lo = hexValue(s.charCodeAt(i + 1));\n    if (hi < 0 || lo < 0) {\n      return None;\n    }\n    out.push((hi * 16 + lo).toU8());\n    i += 2;\n  }\n  return Some(new Bytes(out, 0, out.length));\n}\n\n// ----------------------------------------------------------------------------------------- ByteBuilder\n\n// Strings up to this length are appended by `ByteBuilder.appendString` byte by byte; longer ones in one block.\nconst SHORT_STRING: usize = 64;\n\n// A growable byte buffer. `cap` (read by `capacity()`) is bookkeeping for `reserve` (the runtime has no array reserve: the array\n// still grows geometrically on `push`); the invariant ties it to the length.\n@Invariant(this.cap >= this.data.length)\nexport class ByteBuilder {\n  private data: u8[] = [];\n  private cap: usize = 0;\n\n  // length(): usize -- number of bytes appended so far. O(1).\n  @Ensures(result == this.data.length)\n  length(): usize {\n    return this.data.length;\n  }\n\n  // isEmpty(): bool -- no byte appended yet. O(1).\n  @Ensures(result == (this.length() == 0))\n  isEmpty(): bool {\n    return this.data.length == 0;\n  }\n\n  // capacity(): usize -- the number of bytes that fit without a reservation being exceeded; never below length(). O(1).\n  @Ensures(result == this.cap)\n  capacity(): usize {\n    return this.cap;\n  }\n\n  @Deprecated(\"use capacity() (ADR-0048)\")\n  @Ensures(result == this.cap)\n  reserved(): usize {\n    return this.cap;\n  }\n\n  // byteAt(i): u8 -- the byte at index i. Precondition i < length(). O(1).\n  @Requires(i < this.data.length)\n  byteAt(i: usize): u8 {\n    return this.data[i];\n  }\n\n  // reserve(extra): void -- room for `extra` more bytes. The contents do not change. O(1).\n  @Ensures(this.length() == old(this.length()))\n  @Ensures(this.capacity() >= this.length() + extra)\n  reserve(extra: usize): void {\n    if (this.cap < this.data.length + extra) {\n      this.cap = this.data.length + extra;\n    }\n  }\n\n  private grew(): void {\n    if (this.cap < this.data.length) {\n      this.cap = this.data.length;\n    }\n  }\n\n  // appendU8(v): void -- one byte. Amortised O(1).\n  @Ensures(this.length() == old(this.length()) + 1)\n  @Ensures(this.byteAt(this.length() - 1) == v)\n  appendU8(v: u8): void {\n    this.data.push(v);\n    this.grew();\n  }\n\n  // appendU16Be(v): void -- two bytes, most significant first. O(1).\n  @Ensures(this.length() == old(this.length()) + 2)\n  @Ensures(this.byteAt(this.length() - 2).toInt() == v.toInt() / 256)\n  @Ensures(this.byteAt(this.length() - 1).toInt() == v.toInt() % 256)\n  appendU16Be(v: u16): void {\n    const n = v.toInt();\n    this.data.push((n / 256).toU8());\n    this.data.push((n % 256).toU8());\n    this.grew();\n  }\n\n  // appendU16Le(v): void -- two bytes, least significant first. O(1).\n  @Ensures(this.length() == old(this.length()) + 2)\n  @Ensures(this.byteAt(this.length() - 2).toInt() == v.toInt() % 256)\n  @Ensures(this.byteAt(this.length() - 1).toInt() == v.toInt() / 256)\n  appendU16Le(v: u16): void {\n    const n = v.toInt();\n    this.data.push((n % 256).toU8());\n    this.data.push((n / 256).toU8());\n    this.grew();\n  }\n\n  // appendU32Be(v): void -- four bytes, most significant first. O(1).\n  @Ensures(this.length() == old(this.length()) + 4)\n  @Ensures(this.byteAt(this.length() - 4).toInt() == v.toInt() / 16777216)\n  @Ensures(this.byteAt(this.length() - 1).toInt() == v.toInt() % 256)\n  appendU32Be(v: u32): void {\n    const n = v.toInt();\n    this.data.push((n / 16777216).toU8());\n    this.data.push(((n / 65536) % 256).toU8());\n    this.data.push(((n / 256) % 256).toU8());\n    this.data.push((n % 256).toU8());\n    this.grew();\n  }\n\n  // appendU32Le(v): void -- four bytes, least significant first. O(1).\n  @Ensures(this.length() == old(this.length()) + 4)\n  @Ensures(this.byteAt(this.length() - 4).toInt() == v.toInt() % 256)\n  @Ensures(this.byteAt(this.length() - 1).toInt() == v.toInt() / 16777216)\n  appendU32Le(v: u32): void {\n    const n = v.toInt();\n    this.data.push((n % 256).toU8());\n    this.data.push(((n / 256) % 256).toU8());\n    this.data.push(((n / 65536) % 256).toU8());\n    this.data.push((n / 16777216).toU8());\n    this.grew();\n  }\n\n  @Deprecated(\"use appendU16Be(v) (ADR-0048)\")\n  appendU16be(v: u16): void {\n    this.appendU16Be(v);\n  }\n\n  @Deprecated(\"use appendU16Le(v) (ADR-0048)\")\n  appendU16le(v: u16): void {\n    this.appendU16Le(v);\n  }\n\n  @Deprecated(\"use appendU32Be(v) (ADR-0048)\")\n  appendU32be(v: u32): void {\n    this.appendU32Be(v);\n  }\n\n  @Deprecated(\"use appendU32Le(v) (ADR-0048)\")\n  appendU32le(v: u32): void {\n    this.appendU32Le(v);\n  }\n\n  // appendBytes(b): void -- all bytes of `b`. O(b.length()). A view of a whole array is appended in one step (the buffer is\n  // extended in place); a partial view is copied from its storage in a plain loop: no call and no reference count per\n  // byte, no temporary array.\n  @Ensures(this.length() == old(this.length()) + b.length())\n  @Ensures(b.length() > 0 ==> this.byteAt(this.length() - b.length()) == b.at(0))\n  @Ensures(b.length() > 0 ==> this.byteAt(this.length() - 1) == b.at(b.length() - 1))\n  appendBytes(b: Bytes): void {\n    const src = b.storage();\n    const s0 = b.storageStart();\n    const n = b.length();\n    if (s0 == 0 && n == src.length) {\n      this.data = this.data.concat(src);\n    } else {\n      let i: usize = 0;\n      while (i < n) {\n        this.data.push(src[s0 + i]);\n        i += 1;\n      }\n    }\n    this.grew();\n  }\n\n  // appendString(s): void -- the bytes of `s` (no encoding step). O(s.length). A short string is appended byte by byte (no\n  // temporary array); a long one through one temporary array and an in-place extension.\n  @Ensures(this.length() == old(this.length()) + s.length)\n  @Ensures(s.length > 0 ==> this.byteAt(this.length() - s.length).toInt() == s.charCodeAt(0))\n  @Ensures(s.length > 0 ==> this.byteAt(this.length() - 1).toInt() == s.charCodeAt(s.length - 1))\n  appendString(s: string): void {\n    if (s.length <= SHORT_STRING) {\n      let i: usize = 0;\n      while (i < s.length) {\n        this.data.push(s.charCodeAt(i).toU8());\n        i += 1;\n      }\n    } else {\n      this.data = this.data.concat(stringToBytes(s));\n    }\n    this.grew();\n  }\n\n  // clear(): void -- remove all bytes; the reservation stays. O(1).\n  @Ensures(this.length() == 0)\n  @Ensures(this.capacity() == old(this.capacity()))\n  clear(): void {\n    this.data = [];\n  }\n\n  // build(): Bytes -- the bytes appended so far as an immutable `Bytes`; the builder stays usable. O(1) (shares storage).\n  @Ensures(result.length() == this.data.length)\n  build(): Bytes {\n    return new Bytes(this.data, 0, this.data.length);\n  }\n}\n\n// ----------------------------------------------------------------------------------------- ByteReader\n\n// Why a read failed (ADR-0048 rule 3.1): at byte `offset` the reader needed `needed` bytes but only `remaining` were\n// left. Running off the end is the only failure of std:bytes, so the record has no `kind` field (a one-variant\n// `BytesErrorKind` is not expressible: a union needs two variants).\nexport type BytesError = { offset: usize; needed: usize; remaining: usize; };\n\n// bytesErrorMessage(e): string -- \"unexpected end of input at byte 3: needed 4 bytes, 1 remaining\". Never fails; O(1),\n// allocates the message.\n@Ensures(result.length > 0)\nexport function bytesErrorMessage(e: BytesError): string {\n  return `unexpected end of input at byte ${e.offset.toString()}: needed ${e.needed.toString()} bytes, ${e.remaining.toString()} remaining`;\n}\n\n// ReadError: the old name of `BytesError` (a type alias cannot carry a @Deprecated; the field `position` is now `offset`).\nexport type ReadError = BytesError;\n\n@Deprecated(\"use bytesErrorMessage(e) (ADR-0048)\")\nexport function readErrorMessage(e: BytesError): string {\n  return bytesErrorMessage(e);\n}\n\n// A cursor over a `Bytes`. Invariant: the cursor never passes the end, so `remaining()` cannot underflow and\n// every successful read is in bounds. A failed read changes nothing.\n@Invariant(this.pos <= this.src.length())\nexport class ByteReader {\n  private src: Bytes;\n  private pos: usize = 0;\n\n  constructor(src: Bytes) {\n    this.src = src;\n  }\n\n  // position(): usize -- index of the next byte to read. O(1).\n  @Ensures(result <= this.src.length())\n  position(): usize {\n    return this.pos;\n  }\n\n  // remaining(): usize -- number of unread bytes. O(1).\n  @Ensures(result + this.pos == this.src.length())\n  remaining(): usize {\n    return this.src.length() - this.pos;\n  }\n\n  // isAtEnd(): bool -- no unread bytes. O(1).\n  @Ensures(result == (this.remaining() == 0))\n  isAtEnd(): bool {\n    return this.pos == this.src.length();\n  }\n\n  // peekAt(offset): Option<u8> -- the unread byte `offset` positions ahead (0 = next), without moving. None past the end. O(1).\n  @Ensures(result.isSome() == (offset < this.remaining()))\n  peekAt(offset: usize): Option<u8> {\n    return this.src.get(this.pos + offset);\n  }\n\n  private shortRead(n: usize): BytesError {\n    return BytesError { offset: this.pos, needed: n, remaining: this.src.length() - this.pos };\n  }\n\n  // readU8(): Result<u8, BytesError> -- the next byte. Err when no byte is left (cursor unchanged). O(1).\n  @Ensures(result.isOk() == (old(this.remaining()) >= 1))\n  @Ensures(result.isOk() ==> this.position() == old(this.position()) + 1)\n  @Ensures(result.isErr() ==> this.position() == old(this.position()))\n  @Ensures(result.isOk() ==> result.unwrap() == old(this.peekAt(0).unwrapOr(0)))\n  @Ensures(result.isErr() ==> result.unwrapErr().needed == 1 && result.unwrapErr().remaining == old(this.remaining()))\n  readU8(): Result<u8, BytesError> {\n    if (this.src.length() - this.pos < 1) {\n      return Err(this.shortRead(1));\n    }\n    const v = this.src.at(this.pos);\n    this.pos += 1;\n    return Ok(v);\n  }\n\n  // readU16Be(): Result<u16, BytesError> -- the next two bytes as a big-endian u16. Err when fewer than 2 remain (cursor unchanged). O(1).\n  @Ensures(result.isOk() == (old(this.remaining()) >= 2))\n  @Ensures(result.isOk() ==> this.position() == old(this.position()) + 2)\n  @Ensures(result.isErr() ==> this.position() == old(this.position()))\n  @Ensures(result.isOk() ==> result.unwrap().toInt() == old(this.peekAt(0).unwrapOr(0)).toInt() * 256 + old(this.peekAt(1).unwrapOr(0)).toInt())\n  readU16Be(): Result<u16, BytesError> {\n    if (this.src.length() - this.pos < 2) {\n      return Err(this.shortRead(2));\n    }\n    const a = this.src.at(this.pos).toInt();\n    const b = this.src.at(this.pos + 1).toInt();\n    this.pos += 2;\n    return Ok((a * 256 + b).toU16());\n  }\n\n  // readU16Le(): Result<u16, BytesError> -- the next two bytes as a little-endian u16. Err when fewer than 2 remain (cursor unchanged). O(1).\n  @Ensures(result.isOk() == (old(this.remaining()) >= 2))\n  @Ensures(result.isOk() ==> this.position() == old(this.position()) + 2)\n  @Ensures(result.isErr() ==> this.position() == old(this.position()))\n  @Ensures(result.isOk() ==> result.unwrap().toInt() == old(this.peekAt(1).unwrapOr(0)).toInt() * 256 + old(this.peekAt(0).unwrapOr(0)).toInt())\n  readU16Le(): Result<u16, BytesError> {\n    if (this.src.length() - this.pos < 2) {\n      return Err(this.shortRead(2));\n    }\n    const a = this.src.at(this.pos).toInt();\n    const b = this.src.at(this.pos + 1).toInt();\n    this.pos += 2;\n    return Ok((b * 256 + a).toU16());\n  }\n\n  // readU32Be(): Result<u32, BytesError> -- the next four bytes as a big-endian u32. Err when fewer than 4 remain (cursor unchanged). O(1).\n  @Ensures(result.isOk() == (old(this.remaining()) >= 4))\n  @Ensures(result.isOk() ==> this.position() == old(this.position()) + 4)\n  @Ensures(result.isErr() ==> this.position() == old(this.position()))\n  @Ensures(result.isOk() ==> result.unwrap().toInt() / 16777216 == old(this.peekAt(0).unwrapOr(0)).toInt())\n  @Ensures(result.isOk() ==> result.unwrap().toInt() % 256 == old(this.peekAt(3).unwrapOr(0)).toInt())\n  readU32Be(): Result<u32, BytesError> {\n    if (this.src.length() - this.pos < 4) {\n      return Err(this.shortRead(4));\n    }\n    const a = this.src.at(this.pos).toInt();\n    const b = this.src.at(this.pos + 1).toInt();\n    const c = this.src.at(this.pos + 2).toInt();\n    const d = this.src.at(this.pos + 3).toInt();\n    this.pos += 4;\n    return Ok((((a * 256 + b) * 256 + c) * 256 + d).toU32());\n  }\n\n  // readU32Le(): Result<u32, BytesError> -- the next four bytes as a little-endian u32. Err when fewer than 4 remain (cursor unchanged). O(1).\n  @Ensures(result.isOk() == (old(this.remaining()) >= 4))\n  @Ensures(result.isOk() ==> this.position() == old(this.position()) + 4)\n  @Ensures(result.isErr() ==> this.position() == old(this.position()))\n  @Ensures(result.isOk() ==> result.unwrap().toInt() / 16777216 == old(this.peekAt(3).unwrapOr(0)).toInt())\n  @Ensures(result.isOk() ==> result.unwrap().toInt() % 256 == old(this.peekAt(0).unwrapOr(0)).toInt())\n  readU32Le(): Result<u32, BytesError> {\n    if (this.src.length() - this.pos < 4) {\n      return Err(this.shortRead(4));\n    }\n    const a = this.src.at(this.pos).toInt();\n    const b = this.src.at(this.pos + 1).toInt();\n    const c = this.src.at(this.pos + 2).toInt();\n    const d = this.src.at(this.pos + 3).toInt();\n    this.pos += 4;\n    return Ok((((d * 256 + c) * 256 + b) * 256 + a).toU32());\n  }\n\n  @Deprecated(\"use readU16Be() (ADR-0048)\")\n  readU16be(): Result<u16, BytesError> {\n    return this.readU16Be();\n  }\n\n  @Deprecated(\"use readU16Le() (ADR-0048)\")\n  readU16le(): Result<u16, BytesError> {\n    return this.readU16Le();\n  }\n\n  @Deprecated(\"use readU32Be() (ADR-0048)\")\n  readU32be(): Result<u32, BytesError> {\n    return this.readU32Be();\n  }\n\n  @Deprecated(\"use readU32Le() (ADR-0048)\")\n  readU32le(): Result<u32, BytesError> {\n    return this.readU32Le();\n  }\n\n  // readExact(n): Result<Bytes, BytesError> -- the next n bytes (a slice sharing storage, no copy). Err when fewer than n remain (cursor\n  // unchanged). O(1).\n  @Ensures(result.isOk() == (old(this.remaining()) >= n))\n  @Ensures(result.isOk() ==> result.unwrap().length() == n && this.position() == old(this.position()) + n)\n  @Ensures(result.isErr() ==> this.position() == old(this.position()))\n  readExact(n: usize): Result<Bytes, BytesError> {\n    if (this.src.length() - this.pos < n) {\n      return Err(this.shortRead(n));\n    }\n    const out = this.src.slice(this.pos, this.pos + n);\n    this.pos += n;\n    return Ok(out);\n  }\n\n  // skip(n): Result<void, BytesError> -- advance n bytes. Err when fewer than n remain (cursor unchanged). O(1).\n  @Ensures(result.isOk() == (old(this.remaining()) >= n))\n  @Ensures(result.isOk() ==> this.position() == old(this.position()) + n)\n  @Ensures(result.isErr() ==> this.position() == old(this.position()))\n  skip(n: usize): Result<void, BytesError> {\n    if (this.src.length() - this.pos < n) {\n      return Err(this.shortRead(n));\n    }\n    this.pos += n;\n    return Ok();\n  }\n\n  // takeRest(): Bytes -- all unread bytes as a slice (no copy); the cursor moves to the end. Never fails. O(1).\n  @Ensures(this.isAtEnd() && result.length() == old(this.remaining()))\n  takeRest(): Bytes {\n    const out = this.src.slice(this.pos, this.src.length());\n    this.pos = this.src.length();\n    return out;\n  }\n\n  @Deprecated(\"use takeRest(), which says that the cursor moves (ADR-0048)\")\n  @Ensures(this.isAtEnd() && result.length() == old(this.remaining()))\n  rest(): Bytes {\n    return this.takeRest();\n  }\n}\n" });
  out.push(SourceFile { path: "$stdlib/bytes_internal.or", text: "// std:bytes/internal -- helpers behind std:bytes (ADR-0048 rule 7.3). NOT API: user code does not import this module.\n//\n// A contract has to be able to call a function, and the language has no visibility between \"private to the file\" and\n// \"exported\", so the helper is exported from here. It can change in any release.\n\n// allBytes(xs): bool -- is every element of `xs` a valid byte (0..255)? Loop-based so that contracts can use it. Never\n// fails; O(n).\nexport function allBytes(xs: int[]): bool {\n  let i: usize = 0;\n  while (i < xs.length) {\n    if (xs[i] < 0 || xs[i] > 255) {\n      return false;\n    }\n    i += 1;\n  }\n  return true;\n}\n" });
  out.push(SourceFile { path: "$stdlib/collections.or", text: "// std:collections -- sets, a ring-buffer deque, sorted maps and a priority queue (ADR-0030 \xc2\xa73, layer\n// \"collections\"). Pure safe Orin on top of arrays and `Map`; no C, no new built-ins.\n//\n// What is generic and what is not (docs/std.md \"Limitations of this layer\"):\n//   * ADR-0034 (slice 2) adds the generic containers `Set<T extends Hash>`, `OrderedMap<K extends Ord, V>` and `MinHeap<T extends Ord>`.\n//     They have the algorithms of the specialised ones (`IntSet` / `StringSet`, `SortedMap<V>` / `SortedStringMap<V>`,\n//     `PriorityQueue<T>`), which stay unchanged: the generic names differ because `SortedMap` and `PriorityQueue` were taken.\n//     Their contracts state equality of keys / elements (\"after `add(x)` the set contains a value equal to x\").\n//   * A contract cannot call a function value (E0416), so a comparator closure could not appear in the heap\n//     invariant. `PriorityQueue<T>` therefore orders by an explicit `int` priority given to `push`; `MinHeap<T>` orders by `Ord`.\n//   * A type parameter has one bound, so the value `V` of a map is unbounded and the contracts cannot say \"the value that comes\n//     back is the one that was put in\"; the tests check that with `assertEqual` and against a naive reference model.\n//\n// Names (ADR-0048 section 1.1): `size()` / `isEmpty()` / `clear()` on every class; `has(k)` membership; `get(k)` the\n// checked read (`Option`); `set(k, v)` associates (sorted maps; `put` is a deprecated wrapper); `add(x)` for sets;\n// `remove(k)` returns `Option<V>` on maps and `bool` (was it present) on sets; `keys()` / `values()` / `entries()` copy\n// a keyed container out, `toArray()` a linear one; `first()` / `last()` the ends of an ordered map (`front` / `back` on\n// the `Deque`, whose two ends are both mutable). Import as a namespace: `import * as collections from \"std:collections\"`.\n//\n// Contract standard (ADR-0030 \xc2\xa73): every class has `@Invariant`s that `--check-contracts` / `orin test` verify\n// after every public method, and every public method states `@Requires` / `@Ensures`. Helpers that contracts call\n// are loops (no closures, no recursion). All classes are values with copy-on-write storage like every class.\n//\n// Complexity summary (n = size, t = B-tree minimum degree, default choice 16):\n//   IntSet / StringSet        has, add, remove expected O(1) (the prelude's open-addressing hash map); union O(n + m),\n//                             intersection O(min(n, m)), difference and isSubsetOf O(n)\n//   Deque<T>                  pushFront/pushBack/popFront/popBack/get/front/back amortised O(1); toArray O(n)\n//   Set<T>                    as IntSet (hash map of the element's Hash instance)\n//   SortedMap / SortedStringMap / OrderedMap<K, V>  B-tree in an arena: has/get/set/remove/floorKey/ceilKey/firstKey/lastKey/first/last/\n//                             popFirst/popLast all O(t log_t n) = O(log n); keys/values/entries O(n); size O(1)\n//   PriorityQueue<T> / MinHeap<T>  4-ary heap: push, pop O(log n); peek, minPriority, size O(1)\n// Each choice was compared with the simpler alternative it replaces (numbers in docs/std.md): B-tree vs sorted\n// array 31 ms vs 1782 ms for 20,000 random inserts + lookups + removals; 4-ary struct-of-arrays heap vs boxed binary\n// heap 122 ms vs 300 ms; table-driven UTF-8 validator vs per-sequence decoder 5 ms vs 82 ms per MB; plain-slot ring\n// vs `Option` slots 84 ms vs 128 ms.\n\n// ---------------------------------------------------------------------------------------------- helpers\n\n// The helpers that exist only to state contracts (`allTrue`, `isStrictlyIncreasing*`, the B-tree shape and order checks,\n// `isMinHeap4`, ...) live in `std:collections/internal` (ADR-0048 rule 7.3). They are not API.\nimport {\n  allTrue, isStrictlyIncreasing, isStrictlyIncreasingStrings, isStrictlyIncreasingOrd, compareBytewise, leavesBefore,\n  leavesBeforeOrd, isMinHeap4, isMinHeap4Ord, seqsBelow, OrdNode, lowerBoundOrd, btreeOrdShapeOk, btreeOrdOrderOk,\n  btreeOrdKeyCount, btreeOrdHeight, btreeMinKeysOrd, btreeOrdKeys, btreeOrdVals,\n  IntNode, StringNode, lowerBoundInt, lowerBoundString, btreeIntShapeOk, btreeIntOrderOk, btreeIntKeyCount, btreeIntHeight,\n  btreeMinKeysInt, btreeIntKeys, btreeIntVals, btreeStringShapeOk, btreeStringOrderOk, btreeStringKeyCount,\n  btreeStringHeight, btreeMinKeysString, btreeStringKeys, btreeStringVals,\n} from \"std:collections/internal\";\n\n// compareStrings(a, b): int -- -1, 0 or 1; byte-wise lexicographic order (shorter prefix first), the order of\n// `SortedStringMap`. Never fails. O(min(a.length, b.length)).\n@Ensures(result >= -1 && result <= 1)\n@Ensures((result == 0) == (a == b))\nexport function compareStrings(a: string, b: string): int {\n  return compareBytewise(a, b);\n}\n\n// ------------------------------------------------------------------------------------------ IntSet\n\n// A set of ints on top of `Map<int, bool>`. Invariants: the map's size matches its key list and every stored flag\n// is true (a key is a member exactly when it is in the map).\n@Invariant(this.items.size == this.items.keys().length)\n@Invariant(allTrue(this.items.values()))\nexport class IntSet {\n  private items: Map<int, bool> = new Map<int, bool>();\n\n  // size(): usize -- number of members. O(1).\n  @Ensures(result == this.items.keys().length)\n  size(): usize {\n    return this.items.size;\n  }\n\n  // isEmpty(): bool -- no members. O(1).\n  @Ensures(result == (this.size() == 0))\n  isEmpty(): bool {\n    return this.items.size == 0;\n  }\n\n  // has(x): bool -- is x a member? Expected O(1).\n  @Ensures(result ==> this.size() > 0)\n  has(x: int): bool {\n    return this.items.has(x);\n  }\n\n  // add(x): bool -- insert x; true when it was not a member (the size grows by 1), false when it already was. Expected O(1).\n  @Ensures(this.has(x))\n  @Ensures(result == !old(this.has(x)))\n  @Ensures(result ==> this.size() == old(this.size()) + 1)\n  @Ensures(!result ==> this.size() == old(this.size()))\n  add(x: int): bool {\n    if (this.items.has(x)) {\n      return false;\n    }\n    this.items.set(x, true);\n    return true;\n  }\n\n  // remove(x): bool -- delete x; true when it was a member (the size shrinks by 1). Expected O(1).\n  @Ensures(!this.has(x))\n  @Ensures(result == old(this.has(x)))\n  @Ensures(result ==> this.size() == old(this.size()) - 1)\n  @Ensures(!result ==> this.size() == old(this.size()))\n  remove(x: int): bool {\n    if (!this.items.has(x)) {\n      return false;\n    }\n    this.items.delete(x);\n    return true;\n  }\n\n  // clear(): void -- remove all members. O(1).\n  @Ensures(this.size() == 0)\n  clear(): void {\n    this.items = new Map<int, bool>();\n  }\n\n  // toArray(): int[] -- the members in insertion order (not sorted). O(n).\n  @Ensures(result.length == this.size())\n  toArray(): int[] {\n    return this.items.keys();\n  }\n\n  // isSubsetOf(other): bool -- every member of this is a member of other. O(n).\n  @Ensures(result ==> this.size() <= other.size())\n  @Ensures(this.size() == 0 ==> result)\n  isSubsetOf(other: IntSet): bool {\n    if (this.items.size > other.size()) {\n      return false;\n    }\n    const xs = this.items.keys();\n    let i: usize = 0;\n    while (i < xs.length) {\n      if (!other.has(xs[i])) {\n        return false;\n      }\n      i += 1;\n    }\n    return true;\n  }\n\n  // union(other): IntSet -- the members of either. O(n + m).\n  @Ensures(this.isSubsetOf(result) && other.isSubsetOf(result))\n  @Ensures(result.size() >= this.size() && result.size() <= this.size() + other.size())\n  union(other: IntSet): IntSet {\n    // start from the larger set (a copy-on-write value copy) and insert only the smaller one's members\n    let out = this;\n    let small = other;\n    if (other.size() > this.items.size) {\n      out = other;\n      small = this;\n    }\n    const xs = small.toArray();\n    let i: usize = 0;\n    while (i < xs.length) {\n      out.add(xs[i]);\n      i += 1;\n    }\n    return out;\n  }\n\n  // intersection(other): IntSet -- the members of both. O(n).\n  @Ensures(result.isSubsetOf(this) && result.isSubsetOf(other))\n  @Ensures(result.size() <= this.size() && result.size() <= other.size())\n  intersection(other: IntSet): IntSet {\n    // walk the smaller set and probe the larger one\n    let out = new IntSet();\n    const walk = this.items.size <= other.size() ? this : other;\n    const probe = this.items.size <= other.size() ? other : this;\n    const xs = walk.toArray();\n    let i: usize = 0;\n    while (i < xs.length) {\n      if (probe.has(xs[i])) {\n        out.add(xs[i]);\n      }\n      i += 1;\n    }\n    return out;\n  }\n\n  // difference(other): IntSet -- the members of this that are not in other. O(n).\n  @Ensures(result.isSubsetOf(this))\n  @Ensures(result.intersection(other).isEmpty())\n  @Ensures(result.size() + this.intersection(other).size() == this.size())\n  difference(other: IntSet): IntSet {\n    let out = new IntSet();\n    const xs = this.items.keys();\n    let i: usize = 0;\n    while (i < xs.length) {\n      if (!other.has(xs[i])) {\n        out.add(xs[i]);\n      }\n      i += 1;\n    }\n    return out;\n  }\n}\n\n// ------------------------------------------------------------------------------------------ Set<T>\n\n// The generic set (ADR-0034, slice 2): any `Hash` element type, i.e. the integers, `bool`, `string`, records, unions, `Option`,\n// `Result` and arrays of those (derived), and classes with `hash` / `equals` (explicit). `Set<int>` and `Set<string>` do what\n// `IntSet` / `StringSet` do, with the same algorithm (a `Map<T, bool>`, expected O(1)), and unlike them the contracts state value\n// equality: after `add(x)` the set contains a value equal to x. Invariants as for `IntSet`.\n@Invariant(this.items.size == this.items.keys().length)\n@Invariant(allTrue(this.items.values()))\nexport class Set<T extends Hash> {\n  private items: Map<T, bool> = new Map<T, bool>();\n\n  // size(): usize -- number of members. O(1).\n  @Ensures(result == this.items.keys().length)\n  size(): usize {\n    return this.items.size;\n  }\n\n  // isEmpty(): bool -- no members. O(1).\n  @Ensures(result == (this.size() == 0))\n  isEmpty(): bool {\n    return this.items.size == 0;\n  }\n\n  // has(x): bool -- is a value equal to x a member? Expected O(1).\n  @Ensures(result ==> this.size() > 0)\n  has(x: T): bool {\n    return this.items.has(x);\n  }\n\n  // add(x): bool -- insert x; true when no equal value was a member (the size grows by 1), false when one already was. Expected O(1).\n  @Ensures(this.has(x))\n  @Ensures(result == !old(this.has(x)))\n  @Ensures(result ==> this.size() == old(this.size()) + 1)\n  @Ensures(!result ==> this.size() == old(this.size()))\n  add(x: T): bool {\n    if (this.items.has(x)) {\n      return false;\n    }\n    this.items.set(x, true);\n    return true;\n  }\n\n  // remove(x): bool -- delete the member equal to x; true when there was one (the size shrinks by 1). Expected O(1).\n  @Ensures(!this.has(x))\n  @Ensures(result == old(this.has(x)))\n  @Ensures(result ==> this.size() == old(this.size()) - 1)\n  @Ensures(!result ==> this.size() == old(this.size()))\n  remove(x: T): bool {\n    if (!this.items.has(x)) {\n      return false;\n    }\n    this.items.delete(x);\n    return true;\n  }\n\n  // clear(): void -- remove all members. O(1).\n  @Ensures(this.size() == 0)\n  clear(): void {\n    this.items = new Map<T, bool>();\n  }\n\n  // toArray(): T[] -- the members in insertion order (not sorted). O(n).\n  @Ensures(result.length == this.size())\n  @Ensures(this.size() > 0 ==> this.has(result[0]))\n  toArray(): T[] {\n    return this.items.keys();\n  }\n\n  // isSubsetOf(other): bool -- every member of this is a member of other. O(n).\n  @Ensures(result ==> this.size() <= other.size())\n  @Ensures(this.size() == 0 ==> result)\n  isSubsetOf(other: Set<T>): bool {\n    if (this.items.size > other.size()) {\n      return false;\n    }\n    const xs = this.items.keys();\n    let i: usize = 0;\n    while (i < xs.length) {\n      if (!other.has(xs[i])) {\n        return false;\n      }\n      i += 1;\n    }\n    return true;\n  }\n\n  // union(other): Set<T> -- the members of either. O(n + m).\n  @Ensures(this.isSubsetOf(result) && other.isSubsetOf(result))\n  @Ensures(result.size() >= this.size() && result.size() <= this.size() + other.size())\n  union(other: Set<T>): Set<T> {\n    // start from the larger set (a copy-on-write value copy) and insert only the smaller one's members\n    let out = this;\n    let small = other;\n    if (other.size() > this.items.size) {\n      out = other;\n      small = this;\n    }\n    const xs = small.toArray();\n    let i: usize = 0;\n    while (i < xs.length) {\n      out.add(xs[i]);\n      i += 1;\n    }\n    return out;\n  }\n\n  // intersection(other): Set<T> -- the members of both. O(min(n, m)).\n  @Ensures(result.isSubsetOf(this) && result.isSubsetOf(other))\n  @Ensures(result.size() <= this.size() && result.size() <= other.size())\n  intersection(other: Set<T>): Set<T> {\n    // walk the smaller set and probe the larger one\n    let out = new Set<T>();\n    const walk = this.items.size <= other.size() ? this : other;\n    const probe = this.items.size <= other.size() ? other : this;\n    const xs = walk.toArray();\n    let i: usize = 0;\n    while (i < xs.length) {\n      if (probe.has(xs[i])) {\n        out.add(xs[i]);\n      }\n      i += 1;\n    }\n    return out;\n  }\n\n  // difference(other): Set<T> -- the members of this that are not in other. O(n).\n  @Ensures(result.isSubsetOf(this))\n  @Ensures(result.intersection(other).isEmpty())\n  @Ensures(result.size() + this.intersection(other).size() == this.size())\n  difference(other: Set<T>): Set<T> {\n    let out = new Set<T>();\n    const xs = this.items.keys();\n    let i: usize = 0;\n    while (i < xs.length) {\n      if (!other.has(xs[i])) {\n        out.add(xs[i]);\n      }\n      i += 1;\n    }\n    return out;\n  }\n}\n\n// --------------------------------------------------------------------------------------- StringSet\n\n// A set of strings on top of `Map<string, bool>`; same invariants as `IntSet`.\n@Invariant(this.items.size == this.items.keys().length)\n@Invariant(allTrue(this.items.values()))\nexport class StringSet {\n  private items: Map<string, bool> = new Map<string, bool>();\n\n  // size(): usize -- number of members. O(1).\n  @Ensures(result == this.items.keys().length)\n  size(): usize {\n    return this.items.size;\n  }\n\n  // isEmpty(): bool -- no members. O(1).\n  @Ensures(result == (this.size() == 0))\n  isEmpty(): bool {\n    return this.items.size == 0;\n  }\n\n  // has(x): bool -- is x a member? Expected O(1 + |x|).\n  @Ensures(result ==> this.size() > 0)\n  has(x: string): bool {\n    return this.items.has(x);\n  }\n\n  // add(x): bool -- insert x; true when it was not a member (the size grows by 1). Expected O(1 + |x|).\n  @Ensures(this.has(x))\n  @Ensures(result == !old(this.has(x)))\n  @Ensures(result ==> this.size() == old(this.size()) + 1)\n  @Ensures(!result ==> this.size() == old(this.size()))\n  add(x: string): bool {\n    if (this.items.has(x)) {\n      return false;\n    }\n    this.items.set(x, true);\n    return true;\n  }\n\n  // remove(x): bool -- delete x; true when it was a member (the size shrinks by 1). Expected O(1 + |x|).\n  @Ensures(!this.has(x))\n  @Ensures(result == old(this.has(x)))\n  @Ensures(result ==> this.size() == old(this.size()) - 1)\n  @Ensures(!result ==> this.size() == old(this.size()))\n  remove(x: string): bool {\n    if (!this.items.has(x)) {\n      return false;\n    }\n    this.items.delete(x);\n    return true;\n  }\n\n  // clear(): void -- remove all members. O(1).\n  @Ensures(this.size() == 0)\n  clear(): void {\n    this.items = new Map<string, bool>();\n  }\n\n  // toArray(): string[] -- the members in insertion order (not sorted). O(n).\n  @Ensures(result.length == this.size())\n  toArray(): string[] {\n    return this.items.keys();\n  }\n\n  // isSubsetOf(other): bool -- every member of this is a member of other. O(n).\n  @Ensures(result ==> this.size() <= other.size())\n  @Ensures(this.size() == 0 ==> result)\n  isSubsetOf(other: StringSet): bool {\n    if (this.items.size > other.size()) {\n      return false;\n    }\n    const xs = this.items.keys();\n    let i: usize = 0;\n    while (i < xs.length) {\n      if (!other.has(xs[i])) {\n        return false;\n      }\n      i += 1;\n    }\n    return true;\n  }\n\n  // union(other): StringSet -- the members of either. O(n + m).\n  @Ensures(this.isSubsetOf(result) && other.isSubsetOf(result))\n  @Ensures(result.size() >= this.size() && result.size() <= this.size() + other.size())\n  union(other: StringSet): StringSet {\n    // start from the larger set (a copy-on-write value copy) and insert only the smaller one's members\n    let out = this;\n    let small = other;\n    if (other.size() > this.items.size) {\n      out = other;\n      small = this;\n    }\n    const xs = small.toArray();\n    let i: usize = 0;\n    while (i < xs.length) {\n      out.add(xs[i]);\n      i += 1;\n    }\n    return out;\n  }\n\n  // intersection(other): StringSet -- the members of both. O(n).\n  @Ensures(result.isSubsetOf(this) && result.isSubsetOf(other))\n  @Ensures(result.size() <= this.size() && result.size() <= other.size())\n  intersection(other: StringSet): StringSet {\n    // walk the smaller set and probe the larger one\n    let out = new StringSet();\n    const walk = this.items.size <= other.size() ? this : other;\n    const probe = this.items.size <= other.size() ? other : this;\n    const xs = walk.toArray();\n    let i: usize = 0;\n    while (i < xs.length) {\n      if (probe.has(xs[i])) {\n        out.add(xs[i]);\n      }\n      i += 1;\n    }\n    return out;\n  }\n\n  // difference(other): StringSet -- the members of this that are not in other. O(n).\n  @Ensures(result.isSubsetOf(this))\n  @Ensures(result.intersection(other).isEmpty())\n  @Ensures(result.size() + this.intersection(other).size() == this.size())\n  difference(other: StringSet): StringSet {\n    let out = new StringSet();\n    const xs = this.items.keys();\n    let i: usize = 0;\n    while (i < xs.length) {\n      if (!other.has(xs[i])) {\n        out.add(xs[i]);\n      }\n      i += 1;\n    }\n    return out;\n  }\n}\n\n// --------------------------------------------------------------------------------------------- Deque\n\n// A double-ended queue on a ring buffer: `buf` has `capacity` slots (0 until the first push, then 4, 8, 16, ...),\n// the element number i from the front lives in slot (head + i) mod capacity, and the ring is unrolled into a\n// buffer of twice the size when it is full. Index arithmetic wraps by one conditional subtraction (no division).\n// The language has no uninitialised slot and no default value of a type parameter, so slots that are not live hold\n// `filler`, a copy of the first element ever pushed (a popped slot is overwritten with it, so at most that one\n// value is kept alive beyond its time). Earlier versions used `Option<T>` slots, which boxes every element and made\n// the invariant \"exactly the live slots are Some\" statable; measured on 500,000 push/pop rounds, plain slots take\n// 84 ms against 128 ms. What the invariants can still state without equality on T is the index discipline:\n// `len <= capacity`, `head` in range, and a filler exists exactly when there is storage.\n@Invariant(this.len <= this.buf.length)\n@Invariant(this.buf.length == 0 ? this.head == 0 : this.head < this.buf.length)\n@Invariant(this.filler.isSome() == (this.buf.length > 0))\nexport class Deque<T> {\n  private buf: T[] = [];\n  private head: usize = 0;\n  private len: usize = 0;\n  private filler: Option<T> = None;\n\n  // size(): usize -- number of elements. O(1).\n  @Ensures(result == this.len)\n  size(): usize {\n    return this.len;\n  }\n\n  // isEmpty(): bool -- no elements. O(1).\n  @Ensures(result == (this.size() == 0))\n  isEmpty(): bool {\n    return this.len == 0;\n  }\n\n  // capacity(): usize -- number of slots of the ring (0 until the first push; then 4, 8, 16, ...). O(1).\n  @Ensures(result == this.buf.length)\n  capacity(): usize {\n    return this.buf.length;\n  }\n\n  // Slot of the element number i from the front (i <= len; i = len is the slot after the back).\n  // A private method does not assume the class invariant, so `head < buf.length` is stated here; it holds at\n  // every call (found by `orin verify --contracts`, ADR-0031 B).\n  @Requires(this.buf.length > 0 && this.head < this.buf.length && i <= this.len)\n  @Ensures(result < this.buf.length)\n  private slot(i: usize): usize {\n    const idx = this.head + i;\n    if (idx >= this.buf.length) {\n      return idx - this.buf.length;\n    }\n    return idx;\n  }\n\n  // Doubles the ring (4 slots at first) when it is full, unrolling it so that head becomes 0. O(n).\n  private grow(x: T): void {\n    if (this.filler.isNone()) {\n      this.filler = Some(x);\n    }\n    const cap = this.buf.length;\n    if (this.len < cap) {\n      return;\n    }\n    const ncap: usize = cap == 0 ? 4 : cap * 2;\n    const fill = this.filler.unwrap();\n    let nb: T[] = [];\n    let i: usize = 0;\n    while (i < this.len) {\n      nb.push(this.buf[this.slot(i)]);\n      i += 1;\n    }\n    while (nb.length < ncap) {\n      nb.push(fill);\n    }\n    this.buf = nb;\n    this.head = 0;\n  }\n\n  // pushBack(x): void -- append x. Amortised O(1).\n  @Ensures(this.size() == old(this.size()) + 1)\n  @Ensures(this.back().isSome() && this.get(this.size() - 1).isSome())\n  @Ensures(old(this.isEmpty()) ==> this.front().isSome())\n  @Ensures(this.capacity() >= old(this.capacity()))\n  pushBack(x: T): void {\n    this.grow(x);\n    this.buf[this.slot(this.len)] = x;\n    this.len += 1;\n  }\n\n  // pushFront(x): void --