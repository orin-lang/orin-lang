;\n    }\n    return Some(this.buf[this.slot(this.len - 1)]);\n  }\n\n  // get(i): Option<T> -- the i-th element from the front, None when i >= size(). O(1).\n  @Ensures(result.isSome() == (i < this.size()))\n  get(i: usize): Option<T> {\n    if (i >= this.len) {\n      return None;\n    }\n    return Some(this.buf[this.slot(i)]);\n  }\n\n  // clear(): void -- remove all elements and release the storage. O(1).\n  @Ensures(this.size() == 0 && this.capacity() == 0)\n  clear(): void {\n    this.buf = [];\n    this.head = 0;\n    this.len = 0;\n    this.filler = None;\n  }\n\n  // toArray(): T[] -- the elements front to back. O(n).\n  @Ensures(result.length == this.size())\n  toArray(): T[] {\n    let out: T[] = [];\n    let i: usize = 0;\n    while (i < this.len) {\n      out.push(this.buf[this.slot(i)]);\n      i += 1;\n    }\n    return out;\n  }\n}\n\n// BEGIN GENERATED by tools/gen_sorted_map.py from tools/sorted_map.tmpl: do not edit, run the script\n// ------------------------------------------------------------------------------------------ SortedMap\n\n// An entry of `SortedMap`: what `first`, `last`, `popFirst`, `popLast` return and `entries` lists.\nexport type SortedEntry<V> = { key: int; value: V; };\n\n// An ordered map from int keys to values of type V: a B-tree of minimum degree t (every node but the root holds\n// t-1 .. 2t-1 keys, all leaves at the same depth) whose nodes live in an arena (`nodes`) and refer to each other\n// by index, so the structure is a plain value (copy-on-write arrays, no pointers, no parent links). `free` lists\n// the arena slots of merged-away nodes for reuse. Insertion splits full nodes on the way down and deletion makes\n// every node it enters hold at least t keys (borrow from a sibling or merge), so both run in one root-to-leaf pass.\n//\n// Invariants (`@Invariant`, checked after every public method by `orin test` / `--check-contracts`): the arena is a\n// valid B-tree of degree t (shape, occupancy, equal leaf depth, no dangling or shared ids, consistent free list),\n// keys are ordered (sorted within nodes and bounded by the separators above them) and the stored count equals the\n// number of keys. Complexity: has/get/set/remove/floorKey/ceilKey/firstKey/lastKey/first/last/popFirst/popLast O(t log_t n)\n// (a binary search of O(log t) in each of O(log_t n) nodes, plus O(t) to shift keys inside one node per level on\n// updates); size/isEmpty O(1); keys/values/entries O(n); `height()` <= 1 + log_t((n+1)/2). Use t = 16 unless you\n// have measured otherwise; `minDegree` 2 gives the smallest nodes and deepest trees (useful for tests).\n@Invariant(this.t >= 2)\n@Invariant(btreeIntShapeOk(this.nodes, this.root, this.t, this.free))\n@Invariant(btreeIntOrderOk(this.nodes, this.root))\n@Invariant(btreeIntKeyCount(this.nodes, this.root) == this.count)\nexport class SortedMap<V> {\n  private t: usize;\n  private nodes: IntNode<V>[] = [IntNode<V> { keys: [], vals: [], kids: [] }];\n  private root: usize = 0;\n  private free: usize[] = [];\n  private count: usize = 0;\n\n  // new SortedMap<V>(minDegree): an empty map; every node but the root keeps minDegree-1 .. 2*minDegree-1 keys.\n  @Requires(minDegree >= 2)\n  constructor(minDegree: usize) {\n    this.t = minDegree;\n  }\n\n  // size(): usize -- number of entries. O(1).\n  @Ensures(result == this.count)\n  size(): usize {\n    return this.count;\n  }\n\n  // isEmpty(): bool -- no entries. O(1).\n  @Ensures(result == (this.size() == 0))\n  isEmpty(): bool {\n    return this.count == 0;\n  }\n\n  // height(): usize -- number of levels of the tree (1 for the root leaf). It is logarithmic: a tree with this many levels\n  // holds at least 2 t^(h-1) - 1 keys, so n keys need at most about log_t(n/2) + 1 levels. O(height).\n  @Ensures(result >= 1)\n  @Ensures(this.count > 0 ==> btreeMinKeysInt(result, this.t) <= this.count)\n  height(): usize {\n    return btreeIntHeight(this.nodes, this.root);\n  }\n\n  // has(k): bool -- is there an entry for k? O(t log_t n).\n  @Ensures(result ==> this.size() > 0)\n  has(k: int): bool {\n    let x = this.root;\n    while (true) {\n      const i = lowerBoundInt(this.nodes[x].keys, k);\n      if (i < this.nodes[x].keys.length && (this.nodes[x].keys[i] == k)) {\n        return true;\n      }\n      if (this.nodes[x].kids.length == 0) {\n        return false;\n      }\n      x = this.nodes[x].kids[i];\n    }\n    return false;\n  }\n\n  // get(k): Option<V> -- the value for k, None when absent. O(t log_t n).\n  @Ensures(result.isSome() == this.has(k))\n  get(k: int): Option<V> {\n    let x = this.root;\n    while (true) {\n      const i = lowerBoundInt(this.nodes[x].keys, k);\n      if (i < this.nodes[x].keys.length && (this.nodes[x].keys[i] == k)) {\n        return Some(this.nodes[x].vals[i]);\n      }\n      if (this.nodes[x].kids.length == 0) {\n        return None;\n      }\n      x = this.nodes[x].kids[i];\n    }\n    return None;\n  }\n\n  // A fresh arena slot (reusing a freed one) holding the given node contents.\n  private alloc(keys: int[], vals: V[], kids: usize[]): usize {\n    if (this.free.length > 0) {\n      const id = this.free.pop().unwrap();\n      this.nodes[id] = IntNode<V> { keys: keys, vals: vals, kids: kids };\n      return id;\n    }\n    this.nodes.push(IntNode<V> { keys: keys, vals: vals, kids: kids });\n    return this.nodes.length - 1;\n  }\n\n  // Empties an arena slot and puts it on the free list.\n  private release(id: usize): void {\n    this.nodes[id] = IntNode<V> { keys: [], vals: [], kids: [] };\n    this.free.push(id);\n  }\n\n  private insertKey(id: usize, pos: usize, k: int, v: V): void {\n    this.nodes[id].keys.push(k);\n    this.nodes[id].vals.push(v);\n    let j = this.nodes[id].keys.length - 1;\n    while (j > pos) {\n      this.nodes[id].keys[j] = this.nodes[id].keys[j - 1];\n      this.nodes[id].vals[j] = this.nodes[id].vals[j - 1];\n      j -= 1;\n    }\n    this.nodes[id].keys[pos] = k;\n    this.nodes[id].vals[pos] = v;\n  }\n\n  private removeKey(id: usize, pos: usize): void {\n    let j = pos;\n    while (j + 1 < this.nodes[id].keys.length) {\n      this.nodes[id].keys[j] = this.nodes[id].keys[j + 1];\n      this.nodes[id].vals[j] = this.nodes[id].vals[j + 1];\n      j += 1;\n    }\n    this.nodes[id].keys.pop();\n    this.nodes[id].vals.pop();\n  }\n\n  private insertKid(id: usize, pos: usize, kid: usize): void {\n    this.nodes[id].kids.push(kid);\n    let j = this.nodes[id].kids.length - 1;\n    while (j > pos) {\n      this.nodes[id].kids[j] = this.nodes[id].kids[j - 1];\n      j -= 1;\n    }\n    this.nodes[id].kids[pos] = kid;\n  }\n\n  private removeKid(id: usize, pos: usize): void {\n    let j = pos;\n    while (j + 1 < this.nodes[id].kids.length) {\n      this.nodes[id].kids[j] = this.nodes[id].kids[j + 1];\n      j += 1;\n    }\n    this.nodes[id].kids.pop();\n  }\n\n  // Splits the full child number i of node x around its median key, which moves up into x.\n  private splitChild(x: usize, i: usize): void {\n    const t = this.t;\n    const y = this.nodes[x].kids[i];\n    const yk = this.nodes[y].keys;\n    const yv = this.nodes[y].vals;\n    const yc = this.nodes[y].kids;\n    const med = yk[t - 1];\n    const medv = yv[t - 1];\n    let zc: usize[] = [];\n    if (yc.length > 0) {\n      zc = yc.slice(t, yc.length);\n      this.nodes[y].kids = yc.slice(0, t);\n    }\n    const z = this.alloc(yk.slice(t, yk.length), yv.slice(t, yv.length), zc);\n    this.nodes[y].keys = yk.slice(0, t - 1);\n    this.nodes[y].vals = yv.slice(0, t - 1);\n    this.insertKey(x, i, med, medv);\n    this.insertKid(x, i + 1, z);\n  }\n\n  // set(k, v): bool -- associate k with v; true when k was new (the size grows by 1), false when an existing value was\n  // replaced. Never traps. One root-to-leaf pass that splits full nodes on the way down. O(t log_t n).\n  @Ensures(this.has(k) && this.get(k).isSome())\n  @Ensures(this.floorKey(k).isSome() && (this.floorKey(k).unwrap() == k))\n  @Ensures(result == !old(this.has(k)))\n  @Ensures(result ==> this.size() == old(this.size()) + 1)\n  @Ensures(!result ==> this.size() == old(this.size()))\n  set(k: int, v: V): bool {\n    const maxKeys = 2 * this.t - 1;\n    if (this.nodes[this.root].keys.length == maxKeys) {\n      const nr = this.alloc([], [], [this.root]);\n      this.root = nr;\n      this.splitChild(nr, 0);\n    }\n    let x = this.root;\n    while (true) {\n      const i = lowerBoundInt(this.nodes[x].keys, k);\n      if (i < this.nodes[x].keys.length && (this.nodes[x].keys[i] == k)) {\n        this.nodes[x].vals[i] = v;\n        return false;\n      }\n      if (this.nodes[x].kids.length == 0) {\n        this.insertKey(x, i, k, v);\n        this.count += 1;\n        return true;\n      }\n      let ci = i;\n      if (this.nodes[this.nodes[x].kids[i]].keys.length == maxKeys) {\n        this.splitChild(x, i);\n        const m = this.nodes[x].keys[i];\n        if ((k == m)) {\n          this.nodes[x].vals[i] = v;\n          return false;\n        }\n        if ((k > m)) {\n          ci = i + 1;\n        }\n      }\n      x = this.nodes[x].kids[ci];\n    }\n    return false;\n  }\n\n  @Deprecated(\"use set(k, v) (ADR-0048)\")\n  @Ensures(this.has(k) && this.get(k).isSome())\n  @Ensures(result == !old(this.has(k)))\n  put(k: int, v: V): bool {\n    return this.set(k, v);\n  }\n\n  // Child number ci of x has t-1 keys: give it one more from a sibling (rotation through x) or merge it with a\n  // sibling. Returns the id of the child to descend into afterwards. May shrink the root.\n  private fill(x: usize, ci: usize): usize {\n    const t = this.t;\n    const len = this.nodes[x].keys.length;\n    const c = this.nodes[x].kids[ci];\n    if (ci > 0 && this.nodes[this.nodes[x].kids[ci - 1]].keys.length >= t) {\n      const l = this.nodes[x].kids[ci - 1];\n      const ll = this.nodes[l].keys.length;\n      this.insertKey(c, 0, this.nodes[x].keys[ci - 1], this.nodes[x].vals[ci - 1]);\n      this.nodes[x].keys[ci - 1] = this.nodes[l].keys[ll - 1];\n      this.nodes[x].vals[ci - 1] = this.nodes[l].vals[ll - 1];\n      if (this.nodes[l].kids.length > 0) {\n        this.insertKid(c, 0, this.nodes[l].kids[this.nodes[l].kids.length - 1]);\n        this.nodes[l].kids.pop();\n      }\n      this.nodes[l].keys.pop();\n      this.nodes[l].vals.pop();\n      return c;\n    }\n    if (ci < len && this.nodes[this.nodes[x].kids[ci + 1]].keys.length >= t) {\n      const r = this.nodes[x].kids[ci + 1];\n      this.insertKey(c, this.nodes[c].keys.length, this.nodes[x].keys[ci], this.nodes[x].vals[ci]);\n      this.nodes[x].keys[ci] = this.nodes[r].keys[0];\n      this.nodes[x].vals[ci] = this.nodes[r].vals[0];\n      this.removeKey(r, 0);\n      if (this.nodes[r].kids.length > 0) {\n        this.nodes[c].kids.push(this.nodes[r].kids[0]);\n        this.removeKid(r, 0);\n      }\n      return c;\n    }\n    if (ci < len) {\n      this.mergeChildren(x, ci);\n      return c;\n    }\n    const left = this.nodes[x].kids[ci - 1];\n    this.mergeChildren(x, ci - 1);\n    return left;\n  }\n\n  // Merges child i+1 of x and the separator key i into child i; releases child i+1. If x was the root and ends up\n  // without keys, its only child becomes the root.\n  private mergeChildren(x: usize, i: usize): void {\n    const y = this.nodes[x].kids[i];\n    const z = this.nodes[x].kids[i + 1];\n    this.nodes[y].keys.push(this.nodes[x].keys[i]);\n    this.nodes[y].vals.push(this.nodes[x].vals[i]);\n    let a: usize = 0;\n    while (a < this.nodes[z].keys.length) {\n      this.nodes[y].keys.push(this.nodes[z].keys[a]);\n      this.nodes[y].vals.push(this.nodes[z].vals[a]);\n      a += 1;\n    }\n    let b: usize = 0;\n    while (b < this.nodes[z].kids.length) {\n      this.nodes[y].kids.push(this.nodes[z].kids[b]);\n      b += 1;\n    }\n    this.removeKey(x, i);\n    this.removeKid(x, i + 1);\n    this.release(z);\n    if (x == this.root && this.nodes[x].keys.length == 0) {\n      this.root = y;\n      this.release(x);\n    }\n  }\n\n  // remove(k): Option<V> -- delete the entry for k and return its value, None when absent. One root-to-leaf pass (CLRS\n  // top-down deletion): a node is only entered when it has at least t keys, so removing from a leaf never\n  // underflows. A key in an inner node is replaced by its predecessor or successor (or the children are merged) and\n  // that key is deleted further down. O(t log_t n).\n  @Ensures(!this.has(k))\n  @Ensures(result.isSome() == old(this.has(k)))\n  @Ensures(result.isSome() ==> this.size() == old(this.size()) - 1)\n  @Ensures(result.isNone() ==> this.size() == old(this.size()))\n  remove(k: int): Option<V> {\n    const t = this.t;\n    let x = this.root;\n    let target = k;\n    let removed: Option<V> = None;\n    let saved = false;\n    while (true) {\n      const len = this.nodes[x].keys.length;\n      const i = lowerBoundInt(this.nodes[x].keys, target);\n      const isLeaf = this.nodes[x].kids.length == 0;\n      if (i < len && (this.nodes[x].keys[i] == target)) {\n        if (isLeaf) {\n          if (!saved) {\n            removed = Some(this.nodes[x].vals[i]);\n          }\n          this.removeKey(x, i);\n          this.count -= 1;\n          return removed;\n        }\n        if (!saved) {\n          removed = Some(this.nodes[x].vals[i]);\n          saved = true;\n        }\n        const y = this.nodes[x].kids[i];\n        const z = this.nodes[x].kids[i + 1];\n        if (this.nodes[y].keys.length >= t) {\n          let w = y;\n          while (this.nodes[w].kids.length > 0) {\n            w = this.nodes[w].kids[this.nodes[w].kids.length - 1];\n          }\n          const last = this.nodes[w].keys.length - 1;\n          this.nodes[x].keys[i] = this.nodes[w].keys[last];\n          this.nodes[x].vals[i] = this.nodes[w].vals[last];\n          target = this.nodes[w].keys[last];\n          x = y;\n        } else if (this.nodes[z].keys.length >= t) {\n          let w = z;\n          while (this.nodes[w].kids.length > 0) {\n            w = this.nodes[w].kids[0];\n          }\n          this.nodes[x].keys[i] = this.nodes[w].keys[0];\n          this.nodes[x].vals[i] = this.nodes[w].vals[0];\n          target = this.nodes[w].keys[0];\n          x = z;\n        } else {\n          this.mergeChildren(x, i);\n          x = y;\n        }\n      } else {\n        if (isLeaf) {\n          return removed;\n        }\n        const c = this.nodes[x].kids[i];\n        if (this.nodes[c].keys.length < t) {\n          x = this.fill(x, i);\n        } else {\n          x = c;\n        }\n      }\n    }\n    return removed;\n  }\n\n  // firstKey(): Option<int> -- the smallest key, None when empty. O(height).\n  @Ensures(result.isSome() == (this.size() > 0))\n  @Ensures(result.isSome() ==> this.has(result.unwrap()))\n  firstKey(): Option<int> {\n    if (this.count == 0) {\n      return None;\n    }\n    let x = this.root;\n    while (this.nodes[x].kids.length > 0) {\n      x = this.nodes[x].kids[0];\n    }\n    return Some(this.nodes[x].keys[0]);\n  }\n\n  // lastKey(): Option<int> -- the largest key, None when empty. O(height).\n  @Ensures(result.isSome() == (this.size() > 0))\n  @Ensures(result.isSome() ==> this.has(result.unwrap()))\n  lastKey(): Option<int> {\n    if (this.count == 0) {\n      return None;\n    }\n    let x = this.root;\n    while (this.nodes[x].kids.length > 0) {\n      x = this.nodes[x].kids[this.nodes[x].kids.length - 1];\n    }\n    return Some(this.nodes[x].keys[this.nodes[x].keys.length - 1]);\n  }\n\n  // floorKey(k): Option<int> -- the greatest key <= k, None when there is none. One descent. O(t log_t n).\n  @Ensures(result.isSome() ==> (result.unwrap() <= k) && this.has(result.unwrap()))\n  @Ensures(result.isNone() ==> this.firstKey().isNone() || (this.firstKey().unwrap() > k))\n  floorKey(k: int): Option<int> {\n    let best: Option<int> = None;\n    let x = this.root;\n    while (true) {\n      const i = lowerBoundInt(this.nodes[x].keys, k);\n      if (i < this.nodes[x].keys.length && (this.nodes[x].keys[i] == k)) {\n        return Some(k);\n      }\n      if (i > 0) {\n        best = Some(this.nodes[x].keys[i - 1]);\n      }\n      if (this.nodes[x].kids.length == 0) {\n        return best;\n      }\n      x = this.nodes[x].kids[i];\n    }\n    return best;\n  }\n\n  // ceilKey(k): Option<int> -- the smallest key >= k, None when there is none. One descent. O(t log_t n).\n  @Ensures(result.isSome() ==> (result.unwrap() >= k) && this.has(result.unwrap()))\n  @Ensures(result.isNone() ==> this.lastKey().isNone() || (this.lastKey().unwrap() < k))\n  ceilKey(k: int): Option<int> {\n    let best: Option<int> = None;\n    let x = this.root;\n    while (true) {\n      const i = lowerBoundInt(this.nodes[x].keys, k);\n      if (i < this.nodes[x].keys.length) {\n        if ((this.nodes[x].keys[i] == k)) {\n          return Some(k);\n        }\n        best = Some(this.nodes[x].keys[i]);\n      }\n      if (this.nodes[x].kids.length == 0) {\n        return best;\n      }\n      x = this.nodes[x].kids[i];\n    }\n    return best;\n  }\n\n  // first(): Option<SortedEntry<V>> -- the entry with the smallest key, None when empty; nothing is removed. O(height).\n  @Ensures(result.isSome() == (this.size() > 0))\n  @Ensures(result.isSome() ==> (result.unwrap().key == this.firstKey().unwrap()))\n  first(): Option<SortedEntry<V>> {\n    const f = this.firstKey();\n    if (f.isNone()) {\n      return None;\n    }\n    return Some(SortedEntry<V> { key: f.unwrap(), value: this.get(f.unwrap()).unwrap() });\n  }\n\n  // last(): Option<SortedEntry<V>> -- the entry with the largest key, None when empty; nothing is removed. O(height).\n  @Ensures(result.isSome() == (this.size() > 0))\n  @Ensures(result.isSome() ==> (result.unwrap().key == this.lastKey().unwrap()))\n  last(): Option<SortedEntry<V>> {\n    const l = this.lastKey();\n    if (l.isNone()) {\n      return None;\n    }\n    return Some(SortedEntry<V> { key: l.unwrap(), value: this.get(l.unwrap()).unwrap() });\n  }\n\n  // popFirst(): Option<SortedEntry<V>> -- remove the entry with the smallest key and return it, None when empty. O(t log_t n).\n  @Ensures(result.isSome() == (old(this.size()) > 0))\n  @Ensures(result.isSome() ==> this.size() == old(this.size()) - 1 && !this.has(result.unwrap().key))\n  @Ensures(result.isSome() ==> (result.unwrap().key == old(this.firstKey()).unwrap()))\n  @Ensures(result.isSome() && this.size() > 0 ==> (this.firstKey().unwrap() > result.unwrap().key))\n  popFirst(): Option<SortedEntry<V>> {\n    const f = this.firstKey();\n    if (f.isNone()) {\n      return None;\n    }\n    const v = this.remove(f.unwrap()).unwrap();\n    return Some(SortedEntry<V> { key: f.unwrap(), value: v });\n  }\n\n  // popLast(): Option<SortedEntry<V>> -- remove the entry with the largest key and return it, None when empty. O(t log_t n).\n  @Ensures(result.isSome() == (old(this.size()) > 0))\n  @Ensures(result.isSome() ==> this.size() == old(this.size()) - 1 && !this.has(result.unwrap().key))\n  @Ensures(result.isSome() ==> (result.unwrap().key == old(this.lastKey()).unwrap()))\n  @Ensures(result.isSome() && this.size() > 0 ==> (this.lastKey().unwrap() < result.unwrap().key))\n  popLast(): Option<SortedEntry<V>> {\n    const l = this.lastKey();\n    if (l.isNone()) {\n      return None;\n    }\n    const v = this.remove(l.unwrap()).unwrap();\n    return Some(SortedEntry<V> { key: l.unwrap(), value: v });\n  }\n\n  // keys(): int[] -- all keys in increasing order. Never fails. O(n).\n  @Ensures(result.length == this.size() && isStrictlyIncreasing(result))\n  keys(): int[] {\n    return btreeIntKeys(this.nodes, this.root);\n  }\n\n  // values(): V[] -- all values in key order. Never fails. O(n).\n  @Ensures(result.length == this.size())\n  values(): V[] {\n    return btreeIntVals(this.nodes, this.root);\n  }\n\n  // entries(): SortedEntry<V>[] -- all entries in increasing key order. Never fails. O(n).\n  @Ensures(result.length == this.size())\n  entries(): SortedEntry<V>[] {\n    const ks = btreeIntKeys(this.nodes, this.root);\n    const vs = btreeIntVals(this.nodes, this.root);\n    let out: SortedEntry<V>[] = [];\n    let i: usize = 0;\n    while (i < ks.length) {\n      out.push(SortedEntry<V> { key: ks[i], value: vs[i] });\n      i += 1;\n    }\n    return out;\n  }\n\n  @Deprecated(\"use keys() (ADR-0048)\")\n  @Ensures(result.length == this.size() && isStrictlyIncreasing(result))\n  keyArray(): int[] {\n    return this.keys();\n  }\n\n  @Deprecated(\"use values() (ADR-0048)\")\n  @Ensures(result.length == this.size())\n  valueArray(): V[] {\n    return this.values();\n  }\n\n  // clear(): void -- remove all entries. O(1).\n  @Ensures(this.size() == 0)\n  clear(): void {\n    this.nodes = [IntNode<V> { keys: [], vals: [], kids: [] }];\n    this.root = 0;\n    this.free = [];\n    this.count = 0;\n  }\n}\n\n// ------------------------------------------------------------------------------------------ SortedStringMap\n\n// An entry of `SortedStringMap`: what `first`, `last`, `popFirst`, `popLast` return and `entries` lists.\nexport type SortedStringEntry<V> = { key: string; value: V; };\n\n// An ordered map from string keys to values of type V: a B-tree of minimum degree t (every node but the root holds\n// t-1 .. 2t-1 keys, all leaves at the same depth) whose nodes live in an arena (`nodes`) and refer to each other\n// by index, so the structure is a plain value (copy-on-write arrays, no pointers, no parent links). `free` lists\n// the arena slots of merged-away nodes for reuse. Insertion splits full nodes on the way down and deletion makes\n// every node it enters hold at least t keys (borrow from a sibling or merge), so both run in one root-to-leaf pass.\n//\n// Invariants (`@Invariant`, checked after every public method by `orin test` / `--check-contracts`): the arena is a\n// valid B-tree of degree t (shape, occupancy, equal leaf depth, no dangling or shared ids, consistent free list),\n// keys are ordered (sorted within nodes and bounded by the separators above them) and the stored count equals the\n// number of keys. Complexity: has/get/set/remove/floorKey/ceilKey/firstKey/lastKey/first/last/popFirst/popLast O(t log_t n)\n// (a binary search of O(log t) in each of O(log_t n) nodes, plus O(t) to shift keys inside one node per level on\n// updates); size/isEmpty O(1); keys/values/entries O(n); `height()` <= 1 + log_t((n+1)/2). Use t = 16 unless you\n// have measured otherwise; `minDegree` 2 gives the smallest nodes and deepest trees (useful for tests).\n@Invariant(this.t >= 2)\n@Invariant(btreeStringShapeOk(this.nodes, this.root, this.t, this.free))\n@Invariant(btreeStringOrderOk(this.nodes, this.root))\n@Invariant(btreeStringKeyCount(this.nodes, this.root) == this.count)\nexport class SortedStringMap<V> {\n  private t: usize;\n  private nodes: StringNode<V>[] = [StringNode<V> { keys: [], vals: [], kids: [] }];\n  private root: usize = 0;\n  private free: usize[] = [];\n  private count: usize = 0;\n\n  // new SortedStringMap<V>(minDegree): an empty map; every node but the root keeps minDegree-1 .. 2*minDegree-1 keys.\n  @Requires(minDegree >= 2)\n  constructor(minDegree: usize) {\n    this.t = minDegree;\n  }\n\n  // size(): usize -- number of entries. O(1).\n  @Ensures(result == this.count)\n  size(): usize {\n    return this.count;\n  }\n\n  // isEmpty(): bool -- no entries. O(1).\n  @Ensures(result == (this.size() == 0))\n  isEmpty(): bool {\n    return this.count == 0;\n  }\n\n  // height(): usize -- number of levels of the tree (1 for the root leaf). It is logarithmic: a tree with this many levels\n  // holds at least 2 t^(h-1) - 1 keys, so n keys need at most about log_t(n/2) + 1 levels. O(height).\n  @Ensures(result >= 1)\n  @Ensures(this.count > 0 ==> btreeMinKeysString(result, this.t) <= this.count)\n  height(): usize {\n    return btreeStringHeight(this.nodes, this.root);\n  }\n\n  // has(k): bool -- is there an entry for k? O(t log_t n).\n  @Ensures(result ==> this.size() > 0)\n  has(k: string): bool {\n    let x = this.root;\n    while (true) {\n      const i = lowerBoundString(this.nodes[x].keys, k);\n      if (i < this.nodes[x].keys.length && (compareBytewise(this.nodes[x].keys[i], k) == 0)) {\n        return true;\n      }\n      if (this.nodes[x].kids.length == 0) {\n        return false;\n      }\n      x = this.nodes[x].kids[i];\n    }\n    return false;\n  }\n\n  // get(k): Option<V> -- the value for k, None when absent. O(t log_t n).\n  @Ensures(result.isSome() == this.has(k))\n  get(k: string): Option<V> {\n    let x = this.root;\n    while (true) {\n      const i = lowerBoundString(this.nodes[x].keys, k);\n      if (i < this.nodes[x].keys.length && (compareBytewise(this.nodes[x].keys[i], k) == 0)) {\n        return Some(this.nodes[x].vals[i]);\n      }\n      if (this.nodes[x].kids.length == 0) {\n        return None;\n      }\n      x = this.nodes[x].kids[i];\n    }\n    return None;\n  }\n\n  // A fresh arena slot (reusing a freed one) holding the given node contents.\n  private alloc(keys: string[], vals: V[], kids: usize[]): usize {\n    if (this.free.length > 0) {\n      const id = this.free.pop().unwrap();\n      this.nodes[id] = StringNode<V> { keys: keys, vals: vals, kids: kids };\n      return id;\n    }\n    this.nodes.push(StringNode<V> { keys: keys, vals: vals, kids: kids });\n    return this.nodes.length - 1;\n  }\n\n  // Empties an arena slot and puts it on the free list.\n  private release(id: usize): void {\n    this.nodes[id] = StringNode<V> { keys: [], vals: [], kids: [] };\n    this.free.push(id);\n  }\n\n  private insertKey(id: usize, pos: usize, k: string, v: V): void {\n    this.nodes[id].keys.push(k);\n    this.nodes[id].vals.push(v);\n    let j = this.nodes[id].keys.length - 1;\n    while (j > pos) {\n      this.nodes[id].keys[j] = this.nodes[id].keys[j - 1];\n      this.nodes[id].vals[j] = this.nodes[id].vals[j - 1];\n      j -= 1;\n    }\n    this.nodes[id].keys[pos] = k;\n    this.nodes[id].vals[pos] = v;\n  }\n\n  private removeKey(id: usize, pos: usize): void {\n    let j = pos;\n    while (j + 1 < this.nodes[id].keys.length) {\n      this.nodes[id].keys[j] = this.nodes[id].keys[j + 1];\n      this.nodes[id].vals[j] = this.nodes[id].vals[j + 1];\n      j += 1;\n    }\n    this.nodes[id].keys.pop();\n    this.nodes[id].vals.pop();\n  }\n\n  private insertKid(id: usize, pos: usize, kid: usize): void {\n    this.nodes[id].kids.push(kid);\n    let j = this.nodes[id].kids.length - 1;\n    while (j > pos) {\n      this.nodes[id].kids[j] = this.nodes[id].kids[j - 1];\n      j -= 1;\n    }\n    this.nodes[id].kids[pos] = kid;\n  }\n\n  private removeKid(id: usize, pos: usize): void {\n    let j = pos;\n    while (j + 1 < this.nodes[id].kids.length) {\n      this.nodes[id].kids[j] = this.nodes[id].kids[j + 1];\n      j += 1;\n    }\n    this.nodes[id].kids.pop();\n  }\n\n  // Splits the full child number i of node x around its median key, which moves up into x.\n  private splitChild(x: usize, i: usize): void {\n    const t = this.t;\n    const y = this.nodes[x].kids[i];\n    const yk = this.nodes[y].keys;\n    const yv = this.nodes[y].vals;\n    const yc = this.nodes[y].kids;\n    const med = yk[t - 1];\n    const medv = yv[t - 1];\n    let zc: usize[] = [];\n    if (yc.length > 0) {\n      zc = yc.slice(t, yc.length);\n      this.nodes[y].kids = yc.slice(0, t);\n    }\n    const z = this.alloc(yk.slice(t, yk.length), yv.slice(t, yv.length), zc);\n    this.nodes[y].keys = yk.slice(0, t - 1);\n    this.nodes[y].vals = yv.slice(0, t - 1);\n    this.insertKey(x, i, med, medv);\n    this.insertKid(x, i + 1, z);\n  }\n\n  // set(k, v): bool -- associate k with v; true when k was new (the size grows by 1), false when an existing value was\n  // replaced. Never traps. One root-to-leaf pass that splits full nodes on the way down. O(t log_t n).\n  @Ensures(this.has(k) && this.get(k).isSome())\n  @Ensures(this.floorKey(k).isSome() && (compareBytewise(this.floorKey(k).unwrap(), k) == 0))\n  @Ensures(result == !old(this.has(k)))\n  @Ensures(result ==> this.size() == old(this.size()) + 1)\n  @Ensures(!result ==> this.size() == old(this.size()))\n  set(k: string, v: V): bool {\n    const maxKeys = 2 * this.t - 1;\n    if (this.nodes[this.root].keys.length == maxKeys) {\n      const nr = this.alloc([], [], [this.root]);\n      this.root = nr;\n      this.splitChild(nr, 0);\n    }\n    let x = this.root;\n    while (true) {\n      const i = lowerBoundString(this.nodes[x].keys, k);\n      if (i < this.nodes[x].keys.length && (compareBytewise(this.nodes[x].keys[i], k) == 0)) {\n        this.nodes[x].vals[i] = v;\n        return false;\n      }\n      if (this.nodes[x].kids.length == 0) {\n        this.insertKey(x, i, k, v);\n        this.count += 1;\n        return true;\n      }\n      let ci = i;\n      if (this.nodes[this.nodes[x].kids[i]].keys.length == maxKeys) {\n        this.splitChild(x, i);\n        const m = this.nodes[x].keys[i];\n        if ((compareBytewise(k, m) == 0)) {\n          this.nodes[x].vals[i] = v;\n          return false;\n        }\n        if ((compareBytewise(k, m) > 0)) {\n          ci = i + 1;\n        }\n      }\n      x = this.nodes[x].kids[ci];\n    }\n    return false;\n  }\n\n  @Deprecated(\"use set(k, v) (ADR-0048)\")\n  @Ensures(this.has(k) && this.get(k).isSome())\n  @Ensures(result == !old(this.has(k)))\n  put(k: string, v: V): bool {\n    return this.set(k, v);\n  }\n\n  // Child number ci of x has t-1 keys: give it one more from a sibling (rotation through x) or merge it with a\n  // sibling. Returns the id of the child to descend into afterwards. May shrink the root.\n  private fill(x: usize, ci: usize): usize {\n    const t = this.t;\n    const len = this.nodes[x].keys.length;\n    const c = this.nodes[x].kids[ci];\n    if (ci > 0 && this.nodes[this.nodes[x].kids[ci - 1]].keys.length >= t) {\n      const l = this.nodes[x].kids[ci - 1];\n      const ll = this.nodes[l].keys.length;\n      this.insertKey(c, 0, this.nodes[x].keys[ci - 1], this.nodes[x].vals[ci - 1]);\n      this.nodes[x].keys[ci - 1] = this.nodes[l].keys[ll - 1];\n      this.nodes[x].vals[ci - 1] = this.nodes[l].vals[ll - 1];\n      if (this.nodes[l].kids.length > 0) {\n        this.insertKid(c, 0, this.nodes[l].kids[this.nodes[l].kids.length - 1]);\n        this.nodes[l].kids.pop();\n      }\n      this.nodes[l].keys.pop();\n      this.nodes[l].vals.pop();\n      return c;\n    }\n    if (ci < len && this.nodes[this.nodes[x].kids[ci + 1]].keys.length >= t) {\n      const r = this.nodes[x].kids[ci + 1];\n      this.insertKey(c, this.nodes[c].keys.length, this.nodes[x].keys[ci], this.nodes[x].vals[ci]);\n      this.nodes[x].keys[ci] = this.nodes[r].keys[0];\n      this.nodes[x].vals[ci] = this.nodes[r].vals[0];\n      this.removeKey(r, 0);\n      if (this.nodes[r].kids.length > 0) {\n        this.nodes[c].kids.push(this.nodes[r].kids[0]);\n        this.removeKid(r, 0);\n      }\n      return c;\n    }\n    if (ci < len) {\n      this.mergeChildren(x, ci);\n      return c;\n    }\n    const left = this.nodes[x].kids[ci - 1];\n    this.mergeChildren(x, ci - 1);\n    return left;\n  }\n\n  // Merges child i+1 of x and the separator key i into child i; releases child i+1. If x was the root and ends up\n  // without keys, its only child becomes the root.\n  private mergeChildren(x: usize, i: usize): void {\n    const y = this.nodes[x].kids[i];\n    const z = this.nodes[x].kids[i + 1];\n    this.nodes[y].keys.push(this.nodes[x].keys[i]);\n    this.nodes[y].vals.push(this.nodes[x].vals[i]);\n    let a: usize = 0;\n    while (a < this.nodes[z].keys.length) {\n      this.nodes[y].keys.push(this.nodes[z].keys[a]);\n      this.nodes[y].vals.push(this.nodes[z].vals[a]);\n      a += 1;\n    }\n    let b: usize = 0;\n    while (b < this.nodes[z].kids.length) {\n      this.nodes[y].kids.push(this.nodes[z].kids[b]);\n      b += 1;\n    }\n    this.removeKey(x, i);\n    this.removeKid(x, i + 1);\n    this.release(z);\n    if (x == this.root && this.nodes[x].keys.length == 0) {\n      this.root = y;\n      this.release(x);\n    }\n  }\n\n  // remove(k): Option<V> -- delete the entry for k and return its value, None when absent. One root-to-leaf pass (CLRS\n  // top-down deletion): a node is only entered when it has at least t keys, so removing from a leaf never\n  // underflows. A key in an inner node is replaced by its predecessor or successor (or the children are merged) and\n  // that key is deleted further down. O(t log_t n).\n  @Ensures(!this.has(k))\n  @Ensures(result.isSome() == old(this.has(k)))\n  @Ensures(result.isSome() ==> this.size() == old(this.size()) - 1)\n  @Ensures(result.isNone() ==> this.size() == old(this.size()))\n  remove(k: string): Option<V> {\n    const t = this.t;\n    let x = this.root;\n    let target = k;\n    let removed: Option<V> = None;\n    let saved = false;\n    while (true) {\n      const len = this.nodes[x].keys.length;\n      const i = lowerBoundString(this.nodes[x].keys, target);\n      const isLeaf = this.nodes[x].kids.length == 0;\n      if (i < len && (compareBytewise(this.nodes[x].keys[i], target) == 0)) {\n        if (isLeaf) {\n          if (!saved) {\n            removed = Some(this.nodes[x].vals[i]);\n          }\n          this.removeKey(x, i);\n          this.count -= 1;\n          return removed;\n        }\n        if (!saved) {\n          removed = Some(this.nodes[x].vals[i]);\n          saved = true;\n        }\n        const y = this.nodes[x].kids[i];\n        const z = this.nodes[x].kids[i + 1];\n        if (this.nodes[y].keys.length >= t) {\n          let w = y;\n          while (this.nodes[w].kids.length > 0) {\n            w = this.nodes[w].kids[this.nodes[w].kids.length - 1];\n          }\n          const last = this.nodes[w].keys.length - 1;\n          this.nodes[x].keys[i] = this.nodes[w].keys[last];\n          this.nodes[x].vals[i] = this.nodes[w].vals[last];\n          target = this.nodes[w].keys[last];\n          x = y;\n        } else if (this.nodes[z].keys.length >= t) {\n          let w = z;\n          while (this.nodes[w].kids.length > 0) {\n            w = this.nodes[w].kids[0];\n          }\n          this.nodes[x].keys[i] = this.nodes[w].keys[0];\n          this.nodes[x].vals[i] = this.nodes[w].vals[0];\n          target = this.nodes[w].keys[0];\n          x = z;\n        } else {\n          this.mergeChildren(x, i);\n          x = y;\n        }\n      } else {\n        if (isLeaf) {\n          return removed;\n        }\n        const c = this.nodes[x].kids[i];\n        if (this.nodes[c].keys.length < t) {\n          x = this.fill(x, i);\n        } else {\n          x = c;\n        }\n      }\n    }\n    return removed;\n  }\n\n  // firstKey(): Option<string> -- the smallest key, None when empty. O(height).\n  @Ensures(result.isSome() == (this.size() > 0))\n  @Ensures(result.isSome() ==> this.has(result.unwrap()))\n  firstKey(): Option<string> {\n    if (this.count == 0) {\n      return None;\n    }\n    let x = this.root;\n    while (this.nodes[x].kids.length > 0) {\n      x = this.nodes[x].kids[0];\n    }\n    return Some(this.nodes[x].keys[0]);\n  }\n\n  // lastKey(): Option<string> -- the largest key, None when empty. O(height).\n  @Ensures(result.isSome() == (this.size() > 0))\n  @Ensures(result.isSome() ==> this.has(result.unwrap()))\n  lastKey(): Option<string> {\n    if (this.count == 0) {\n      return None;\n    }\n    let x = this.root;\n    while (this.nodes[x].kids.length > 0) {\n      x = this.nodes[x].kids[this.nodes[x].kids.length - 1];\n    }\n    return Some(this.nodes[x].keys[this.nodes[x].keys.length - 1]);\n  }\n\n  // floorKey(k): Option<string> -- the greatest key <= k, None when there is none. One descent. O(t log_t n).\n  @Ensures(result.isSome() ==> (compareBytewise(result.unwrap(), k) <= 0) && this.has(result.unwrap()))\n  @Ensures(result.isNone() ==> this.firstKey().isNone() || (compareBytewise(this.firstKey().unwrap(), k) > 0))\n  floorKey(k: string): Option<string> {\n    let best: Option<string> = None;\n    let x = this.root;\n    while (true) {\n      const i = lowerBoundString(this.nodes[x].keys, k);\n      if (i < this.nodes[x].keys.length && (compareBytewise(this.nodes[x].keys[i], k) == 0)) {\n        return Some(k);\n      }\n      if (i > 0) {\n        best = Some(this.nodes[x].keys[i - 1]);\n      }\n      if (this.nodes[x].kids.length == 0) {\n        return best;\n      }\n      x = this.nodes[x].kids[i];\n    }\n    return best;\n  }\n\n  // ceilKey(k): Option<string> -- the smallest key >= k, None when there is none. One descent. O(t log_t n).\n  @Ensures(result.isSome() ==> (compareBytewise(result.unwrap(), k) >= 0) && this.has(result.unwrap()))\n  @Ensures(result.isNone() ==> this.lastKey().isNone() || (compareBytewise(this.lastKey().unwrap(), k) < 0))\n  ceilKey(k: string): Option<string> {\n    let best: Option<string> = None;\n    let x = this.root;\n    while (true) {\n      const i = lowerBoundString(this.nodes[x].keys, k);\n      if (i < this.nodes[x].keys.length) {\n        if ((compareBytewise(this.nodes[x].keys[i], k) == 0)) {\n          return Some(k);\n        }\n        best = Some(this.nodes[x].keys[i]);\n      }\n      if (this.nodes[x].kids.length == 0) {\n        return best;\n      }\n      x = this.nodes[x].kids[i];\n    }\n    return best;\n  }\n\n  // first(): Option<SortedStringEntry<V>> -- the entry with the smallest key, None when empty; nothing is removed. O(height).\n  @Ensures(result.isSome() == (this.size() > 0))\n  @Ensures(result.isSome() ==> (compareBytewise(result.unwrap().key, this.firstKey().unwrap()) == 0))\n  first(): Option<SortedStringEntry<V>> {\n    const f = this.firstKey();\n    if (f.isNone()) {\n      return None;\n    }\n    return Some(SortedStringEntry<V> { key: f.unwrap(), value: this.get(f.unwrap()).unwrap() });\n  }\n\n  // last(): Option<SortedStringEntry<V>> -- the entry with the largest key, None when empty; nothing is removed. O(height).\n  @Ensures(result.isSome() == (this.size() > 0))\n  @Ensures(result.isSome() ==> (compareBytewise(result.unwrap().key, this.lastKey().unwrap()) == 0))\n  last(): Option<SortedStringEntry<V>> {\n    const l = this.lastKey();\n    if (l.isNone()) {\n      return None;\n    }\n    return Some(SortedStringEntry<V> { key: l.unwrap(), value: this.get(l.unwrap()).unwrap() });\n  }\n\n  // popFirst(): Option<SortedStringEntry<V>> -- remove the entry with the smallest key and return it, None when empty. O(t log_t n).\n  @Ensures(result.isSome() == (old(this.size()) > 0))\n  @Ensures(result.isSome() ==> this.size() == old(this.size()) - 1 && !this.has(result.unwrap().key))\n  @Ensures(result.isSome() ==> (compareBytewise(result.unwrap().key, old(this.firstKey()).unwrap()) == 0))\n  @Ensures(result.isSome() && this.size() > 0 ==> (compareBytewise(this.firstKey().unwrap(), result.unwrap().key) > 0))\n  popFirst(): Option<SortedStringEntry<V>> {\n    const f = this.firstKey();\n    if (f.isNone()) {\n      return None;\n    }\n    const v = this.remove(f.unwrap()).unwrap();\n    return Some(SortedStringEntry<V> { key: f.unwrap(), value: v });\n  }\n\n  // popLast(): Option<SortedStringEntry<V>> -- remove the entry with the largest key and return it, None when empty. O(t log_t n).\n  @Ensures(result.isSome() == (old(this.size()) > 0))\n  @Ensures(result.isSome() ==> this.size() == old(this.size()) - 1 && !this.has(result.unwrap().key))\n  @Ensures(result.isSome() ==> (compareBytewise(result.unwrap().key, old(this.lastKey()).unwrap()) == 0))\n  @Ensures(result.isSome() && this.size() > 0 ==> (compareBytewise(this.lastKey().unwrap(), result.unwrap().key) < 0))\n  popLast(): Option<SortedStringEntry<V>> {\n    const l = this.lastKey();\n    if (l.isNone()) {\n      return None;\n    }\n    const v = this.remove(l.unwrap()).unwrap();\n    return Some(SortedStringEntry<V> { key: l.unwrap(), value: v });\n  }\n\n  // keys(): string[] -- all keys in increasing order. Never fails. O(n).\n  @Ensures(result.length == this.size() && isStrictlyIncreasingStrings(result))\n  keys(): string[] {\n    return btreeStringKeys(this.nodes, this.root);\n  }\n\n  // values(): V[] -- all values in key order. Never fails. O(n).\n  @Ensures(result.length == this.size())\n  values(): V[] {\n    return btreeStringVals(this.nodes, this.root);\n  }\n\n  // entries(): SortedStringEntry<V>[] -- all entries in increasing key order. Never fails. O(n).\n  @Ensures(result.length == this.size())\n  entries(): SortedStringEntry<V>[] {\n    const ks = btreeStringKeys(this.nodes, this.root);\n    const vs = btreeStringVals(this.nodes, this.root);\n    let out: SortedStringEntry<V>[] = [];\n    let i: usize = 0;\n    while (i < ks.length) {\n      out.push(SortedStringEntry<V> { key: ks[i], value: vs[i] });\n      i += 1;\n    }\n    return out;\n  }\n\n  @Deprecated(\"use keys() (ADR-0048)\")\n  @Ensures(result.length == this.size() && isStrictlyIncreasingStrings(result))\n  keyArray(): string[] {\n    return this.keys();\n  }\n\n  @Deprecated(\"use values() (ADR-0048)\")\n  @Ensures(result.length == this.size())\n  valueArray(): V[] {\n    return this.values();\n  }\n\n  // clear(): void -- remove all entries. O(1).\n  @Ensures(this.size() == 0)\n  clear(): void {\n    this.nodes = [StringNode<V> { keys: [], vals: [], kids: [] }];\n    this.root = 0;\n    this.free = [];\n    this.count = 0;\n  }\n}\n\n// ------------------------------------------------------------------------------------------ OrderedMap\n\n// An entry of `OrderedMap`: what `first`, `last`, `popFirst`, `popLast` return and `entries` lists.\nexport type OrderedEntry<K, V> = { key: K; value: V; };\n\n// An ordered map from K keys to values of type V: a B-tree of minimum degree t (every node but the root holds\n// t-1 .. 2t-1 keys, all leaves at the same depth) whose nodes live in an arena (`nodes`) and refer to each other\n// by index, so the structure is a plain value (copy-on-write arrays, no pointers, no parent links). `free` lists\n// the arena slots of merged-away nodes for reuse. Insertion splits full nodes on the way down and deletion makes\n// every node it enters hold at least t keys (borrow from a sibling or merge), so both run in one root-to-leaf pass.\n//\n// Invariants (`@Invariant`, checked after every public method by `orin test` / `--check-contracts`): the arena is a\n// valid B-tree of degree t (shape, occupancy, equal leaf depth, no dangling or shared ids, consistent free list),\n// keys are ordered (sorted within nodes and bounded by the separators above them) and the stored count equals the\n// number of keys. Complexity: has/get/set/remove/floorKey/ceilKey/firstKey/lastKey/first/last/popFirst/popLast O(t log_t n)\n// (a binary search of O(log t) in each of O(log_t n) nodes, plus O(t) to shift keys inside one node per level on\n// updates); size/isEmpty O(1); keys/values/entries O(n); `height()` <= 1 + log_t((n+1)/2). Use t = 16 unless you\n// have measured otherwise; `minDegree` 2 gives the smallest nodes and deepest trees (useful for tests).\n@Invariant(this.t >= 2)\n@Invariant(btreeOrdShapeOk(this.nodes, this.root, this.t, this.free))\n@Invariant(btreeOrdOrderOk(this.nodes, this.root))\n@Invariant(btreeOrdKeyCount(this.nodes, this.root) == this.count)\nexport class OrderedMap<K extends Ord, V> {\n  private t: usize;\n  private nodes: OrdNode<K, V>[] = [OrdNode<K, V> { keys: [], vals: [], kids: [] }];\n  private root: usize = 0;\n  private free: usize[] = [];\n  private count: usize = 0;\n\n  // new OrderedMap<K, V>(minDegree): an empty map; every node but the root keeps minDegree-1 .. 2*minDegree-1 keys.\n  @Requires(minDegree >= 2)\n  constructor(minDegree: usize) {\n    this.t = minDegree;\n  }\n\n  // size(): usize -- number of entries. O(1).\n  @Ensures(result == this.count)\n  size(): usize {\n    return this.count;\n  }\n\n  // isEmpty(): bool -- no entries. O(1).\n  @Ensures(result == (this.size() == 0))\n  isEmpty(): bool {\n    return this.count == 0;\n  }\n\n  // height(): usize -- number of levels of the tree (1 for the root leaf). It is logarithmic: a tree with this many levels\n  // holds at least 2 t^(h-1) - 1 keys, so n keys need at most about log_t(n/2) + 1 levels. O(height).\n  @Ensures(result >= 1)\n  @Ensures(this.count > 0 ==> btreeMinKeysOrd(result, this.t) <= this.count)\n  height(): usize {\n    return btreeOrdHeight(this.nodes, this.root);\n  }\n\n  // has(k): bool -- is there an entry for k? O(t log_t n).\n  @Ensures(result ==> this.size() > 0)\n  has(k: K): bool {\n    let x = this.root;\n    while (true) {\n      const i = lowerBoundOrd(this.nodes[x].keys, k);\n      if (i < this.nodes[x].keys.length && (this.nodes[x].keys[i] == k)) {\n        return true;\n      }\n      if (this.nodes[x].kids.length == 0) {\n        return false;\n      }\n      x = this.nodes[x].kids[i];\n    }\n    return false;\n  }\n\n  // get(k): Option<V> -- the value for k, None when absent. O(t log_t n).\n  @Ensures(result.isSome() == this.has(k))\n  get(k: K): Option<V> {\n    let x = this.root;\n    while (true) {\n      const i = lowerBoundOrd(this.nodes[x].keys, k);\n      if (i < this.nodes[x].keys.length && (this.nodes[x].keys[i] == k)) {\n        return Some(this.nodes[x].vals[i]);\n      }\n      if (this.nodes[x].kids.length == 0) {\n        return None;\n      }\n      x = this.nodes[x].kids[i];\n    }\n    return None;\n  }\n\n  // A fresh arena slot (reusing a freed one) holding the given node contents.\n  private alloc(keys: K[], vals: V[], kids: usize[]): usize {\n    if (this.free.length > 0) {\n      const id = this.free.pop().unwrap();\n      this.nodes[id] = OrdNode<K, V> { keys: keys, vals: vals, kids: kids };\n      return id;\n    }\n    this.nodes.push(OrdNode<K, V> { keys: keys, vals: vals, kids: kids });\n    return this.nodes.length - 1;\n  }\n\n  // Empties an arena slot and puts it on the free list.\n  private release(id: usize): void {\n    this.nodes[id] = OrdNode<K, V> { keys: [], vals: [], kids: [] };\n    this.free.push(id);\n  }\n\n  private insertKey(id: usize, pos: usize, k: K, v: V): void {\n    this.nodes[id].keys.push(k);\n    this.nodes[id].vals.push(v);\n    let j = this.nodes[id].keys.length - 1;\n    while (j > pos) {\n      this.nodes[id].keys[j] = this.nodes[id].keys[j - 1];\n      this.nodes[id].vals[j] = this.nodes[id].vals[j - 1];\n      j -= 1;\n    }\n    this.nodes[id].keys[pos] = k;\n    this.nodes[id].vals[pos] = v;\n  }\n\n  private removeKey(id: usize, pos: usize): void {\n    let j = pos;\n    while (j + 1 < this.nodes[id].keys.length) {\n      this.nodes[id].keys[j] = this.nodes[id].keys[j + 1];\n      this.nodes[id].vals[j] = this.nodes[id].vals[j + 1];\n      j += 1;\n    }\n    this.nodes[id].keys.pop();\n    this.nodes[id].vals.pop();\n  }\n\n  private insertKid(id: usize, pos: usize, kid: usize): void {\n    this.nodes[id].kids.push(kid);\n    let j = this.nodes[id].kids.length - 1;\n    while (j > pos) {\n      this.nodes[id].kids[j] = this.nodes[id].kids[j - 1];\n      j -= 1;\n    }\n    this.nodes[id].kids[pos] = kid;\n  }\n\n  private removeKid(id: usize, pos: usize): void {\n    let j = pos;\n    while (j + 1 < this.nodes[id].kids.length) {\n      this.nodes[id].kids[j] = this.nodes[id].kids[j + 1];\n      j += 1;\n    }\n    this.nodes[id].kids.pop();\n  }\n\n  // Splits the full child number i of node x around its median key, which moves up into x.\n  private splitChild(x: usize, i: usize): void {\n    const t = this.t;\n    const y = this.nodes[x].kids[i];\n    const yk = this.nodes[y].keys;\n    const yv = this.nodes[y].vals;\n    const yc = this.nodes[y].kids;\n    const med = yk[t - 1];\n    const medv = yv[t - 1];\n    let zc: usize[] = [];\n    if (yc.length > 0) {\n      zc = yc.slice(t, yc.length);\n      this.nodes[y].kids = yc.slice(0, t);\n    }\n    const z = this.alloc(yk.slice(t, yk.length), yv.slice(t, yv.length), zc);\n    this.nodes[y].keys = yk.slice(0, t - 1);\n    this.nodes[y].vals = yv.slice(0, t - 1);\n    this.insertKey(x, i, med, medv);\n    this.insertKid(x, i + 1, z);\n  }\n\n  // set(k, v): bool -- associate k with v; true when k was new (the size grows by 1), false when an existing value was\n  // replaced. Never traps. One root-to-leaf pass that splits full nodes on the way down. O(t log_t n).\n  @Ensures(this.has(k) && this.get(k).isSome())\n  @Ensures(this.floorKey(k).isSome() && (this.floorKey(k).unwrap() == k))\n  @Ensures(result == !old(this.has(k)))\n  @Ensures(result ==> this.size() == old(this.size()) + 1)\n  @Ensures(!result ==> this.size() == old(this.size()))\n  set(k: K, v: V): bool {\n    const maxKeys = 2 * this.t - 1;\n    if (this.nodes[this.root].keys.length == maxKeys) {\n      const nr = this.alloc([], [], [this.root]);\n      this.root = nr;\n      this.splitChild(nr, 0);\n    }\n    let x = this.root;\n    while (true) {\n      const i = lowerBoundOrd(this.nodes[x].keys, k);\n      if (i < this.nodes[x].keys.length && (this.nodes[x].keys[i] == k)) {\n        this.nodes[x].vals[i] = v;\n        return false;\n      }\n      if (this.nodes[x].kids.length == 0) {\n        this.insertKey(x, i, k, v);\n        this.count += 1;\n        return true;\n      }\n      let ci = i;\n      if (this.nodes[this.nodes[x].kids[i]].keys.length == maxKeys) {\n        this.splitChild(x, i);\n        const m = this.nodes[x].keys[i];\n        if ((k == m)) {\n          this.nodes[x].vals[i] = v;\n          return false;\n        }\n        if ((k > m)) {\n          ci = i + 1;\n        }\n      }\n      x = this.nodes[x].kids[ci];\n    }\n    return false;\n  }\n\n  // Child number ci of x has t-1 keys: give it one more from a sibling (rotation through x) or merge it with a\n  // sibling. Returns the id of the child to descend into afterwards. May shrink the root.\n  private fill(x: usize, ci: usize): usize {\n    const t = this.t;\n    const len = this.nodes[x].keys.length;\n    const c = this.nodes[x].kids[ci];\n    if (ci > 0 && this.nodes[this.nodes[x].kids[ci - 1]].keys.length >= t) {\n      const l = this.nodes[x].kids[ci - 1];\n      const ll = this.nodes[l].keys.length;\n      this.insertKey(c, 0, this.nodes[x].keys[ci - 1], this.nodes[x].vals[ci - 1]);\n      this.nodes[x].keys[ci - 1] = this.nodes[l].keys[ll - 1];\n      this.nodes[x].vals[ci - 1] = this.nodes[l].vals[ll - 1];\n      if (this.nodes[l].kids.length > 0) {\n        this.insertKid(c, 0, this.nodes[l].kids[this.nodes[l].kids.length - 1]);\n        this.nodes[l].kids.pop();\n      }\n      this.nodes[l].keys.pop();\n      this.nodes[l].vals.pop();\n      return c;\n    }\n    if (ci < len && this.nodes[this.nodes[x].kids[ci + 1]].keys.length >= t) {\n      const r = this.nodes[x].kids[ci + 1];\n      this.insertKey(c, this.nodes[c].keys.length, this.nodes[x].keys[ci], this.nodes[x].vals[ci]);\n      this.nodes[x].keys[ci] = this.nodes[r].keys[0];\n      this.nodes[x].vals[ci] = this.nodes[r].vals[0];\n      this.removeKey(r, 0);\n      if (this.nodes[r].kids.length > 0) {\n        this.nodes[c].kids.push(this.nodes[r].kids[0]);\n        this.removeKid(r, 0);\n      }\n      return c;\n    }\n    if (ci < len) {\n      this.mergeChildren(x, ci);\n      return c;\n    }\n    const left = this.nodes[x].kids[ci - 1];\n    this.mergeChildren(x, ci - 1);\n    return left;\n  }\n\n  // Merges child i+1 of x and the separator key i into child i; releases child i+1. If x was the root and ends up\n  // without keys, its only child becomes the root.\n  private mergeChildren(x: usize, i: usize): void {\n    const y = this.nodes[x].kids[i];\n    const z = this.nodes[x].kids[i + 1];\n    this.nodes[y].keys.push(this.nodes[x].keys[i]);\n    this.nodes[y].vals.push(this.nodes[x].vals[i]);\n    let a: usize = 0;\n    while (a < this.nodes[z].keys.length) {\n      this.nodes[y].keys.push(this.nodes[z].keys[a]);\n      this.nodes[y].vals.push(this.nodes[z].vals[a]);\n      a += 1;\n    }\n    let b: usize = 0;\n    while (b < this.nodes[z].kids.length) {\n      this.nodes[y].kids.push(this.nodes[z].kids[b]);\n      b += 1;\n    }\n    this.removeKey(x, i);\n    this.removeKid(x, i + 1);\n    this.release(z);\n    if (x == this.root && this.nodes[x].keys.length == 0) {\n      this.root = y;\n      this.release(x);\n    }\n  }\n\n  // remove(k): Option<V> -- delete the entry for k and return its value, None when absent. One root-to-leaf pass (CLRS\n  // top-down deletion): a node is only entered when it has at least t keys, so removing from a leaf never\n  // underflows. A key in an inner node is replaced by its predecessor or successor (or the children are merged) and\n  // that key is deleted further down. O(t log_t n).\n  @Ensures(!this.has(k))\n  @Ensures(result.isSome() == old(this.has(k)))\n  @Ensures(result.isSome() ==> this.size() == old(this.size()) - 1)\n  @Ensures(result.isNone() ==> this.size() == old(this.size()))\n  remove(k: K): Option<V> {\n    const t = this.t;\n    let x = this.root;\n    let target = k;\n    let removed: Option<V> = None;\n    let saved = false;\n    while (true) {\n      const len = this.nodes[x].keys.length;\n      const i = lowerBoundOrd(this.nodes[x].keys, target);\n      const isLeaf = this.nodes[x].kids.length == 0;\n      if (i < len && (this.nodes[x].keys[i] == target)) {\n        if (isLeaf) {\n          if (!saved) {\n            removed = Some(this.nodes[x].vals[i]);\n          }\n          this.removeKey(x, i);\n          this.count -= 1;\n          return removed;\n        }\n        if (!saved) {\n          removed = Some(this.nodes[x].vals[i]);\n          saved = true;\n        }\n        const y = this.nodes[x].kids[i];\n        const z = this.nodes[x].kids[i + 1];\n        if (this.nodes[y].keys.length >= t) {\n          let w = y;\n          while (this.nodes[w].kids.length > 0) {\n            w = this.nodes[w].kids[this.nodes[w].kids.length - 1];\n          }\n          const last = this.nodes[w].keys.length - 1;\n          this.nodes[x].keys[i] = this.nodes[w].keys[last];\n          this.nodes[x].vals[i] = this.nodes[w].vals[last];\n          target = this.nodes[w].keys[last];\n          x = y;\n        } else if (this.nodes[z].keys.length >= t) {\n          let w = z;\n          while (this.nodes[w].kids.length > 0) {\n            w = this.nodes[w].kids[0];\n          }\n          this.nodes[x].keys[i] = this.nodes[w].keys[0];\n          this.nodes[x].vals[i] = this.nodes[w].vals[0];\n          target = this.nodes[w].keys[0];\n          x = z;\n        } else {\n          this.mergeChildren(x, i);\n          x = y;\n        }\n      } else {\n        if (isLeaf) {\n          return removed;\n        }\n        const c = this.nodes[x].kids[i];\n        if (this.nodes[c].keys.length < t) {\n          x = this.fill(x, i);\n        } else {\n          x = c;\n        }\n      }\n    }\n    return removed;\n  }\n\n  // firstKey(): Option<K> -- the smallest key, None when empty. O(height).\n  @Ensures(result.isSome() == (this.size() > 0))\n  @Ensures(result.isSome() ==> this.has(result.unwrap()))\n  firstKey(): Option<K> {\n    if (this.count == 0) {\n      return None;\n    }\n    let x = this.root;\n    while (this.nodes[x].kids.length > 0) {\n      x = this.nodes[x].kids[0];\n    }\n    return Some(this.nodes[x].keys[0]);\n  }\n\n  // lastKey(): Option<K> -- the largest key, None when empty. O(height).\n  @Ensures(result.isSome() == (this.size() > 0))\n  @Ensures(result.isSome() ==> this.has(result.unwrap()))\n  lastKey(): Option<K> {\n    if (this.count == 0) {\n      return None;\n    }\n    let x = this.root;\n    while (this.nodes[x].kids.length > 0) {\n      x = this.nodes[x].kids[this.nodes[x].kids.length - 1];\n    }\n    return Some(this.nodes[x].keys[this.nodes[x].keys.length - 1]);\n  }\n\n  // floorKey(k): Option<K> -- the greatest key <= k, None when there is none. One descent. O(t log_t n).\n  @Ensures(result.isSome() ==> (result.unwrap() <= k) && this.has(result.unwrap()))\n  @Ensures(result.isNone() ==> this.firstKey().isNone() || (this.firstKey().unwrap() > k))\n  floorKey(k: K): Option<K> {\n    let best: Option<K> = None;\n    let x = this.root;\n    while (true) {\n      const i = lowerBoundOrd(this.nodes[x].keys, k);\n      if (i < this.nodes[x].keys.length && (this.nodes[x].keys[i] == k)) {\n        return Some(k);\n      }\n      if (i > 0) {\n        best = Some(this.nodes[x].keys[i - 1]);\n      }\n      if (this.nodes[x].kids.length == 0) {\n        return best;\n      }\n      x = this.nodes[x].kids[i];\n    }\n    return best;\n  }\n\n  // ceilKey(k): Option<K> -- the smallest key >= k, None when there is none. One descent. O(t log_t n).\n  @Ensures(result.isSome() ==> (result.unwrap() >= k) && this.has(result.unwrap()))\n  @Ensures(result.isNone() ==> this.lastKey().isNone() || (this.lastKey().unwrap() < k))\n  ceilKey(k: K): Option<K> {\n    let best: Option<K> = None;\n    let x = this.root;\n    while (true) {\n      const i = lowerBoundOrd(this.nodes[x].keys, k);\n      if (i < this.nodes[x].keys.length) {\n        if ((this.nodes[x].keys[i] == k)) {\n          return Some(k);\n        }\n        best = Some(this.nodes[x].keys[i]);\n      }\n      if (this.nodes[x].kids.length == 0) {\n        return best;\n      }\n      x = this.nodes[x].kids[i];\n    }\n    return best;\n  }\n\n  // first(): Option<OrderedEntry<K, V>> -- the entry with the smallest key, None when empty; nothing is removed. O(height).\n  @Ensures(result.isSome() == (this.size() > 0))\n  @Ensures(result.isSome() ==> (result.unwrap().key == this.firstKey().unwrap()))\n  first(): Option<OrderedEntry<K, V>> {\n    const f = this.firstKey();\n    if (f.isNone()) {\n      return None;\n    }\n    return Some(OrderedEntry<K, V> { key: f.unwrap(), value: this.get(f.unwrap()).unwrap() });\n  }\n\n  // last(): Option<OrderedEntry<K, V>> -- the entry with the largest key, None when empty; nothing is removed. O(height).\n  @Ensures(result.isSome() == (this.size() > 0))\n  @Ensures(result.isSome() ==> (result.unwrap().key == this.lastKey().unwrap()))\n  last(): Option<OrderedEntry<K, V>> {\n    const l = this.lastKey();\n    if (l.isNone()) {\n      return None;\n    }\n    return Some(OrderedEntry<K, V> { key: l.unwrap(), value: this.get(l.unwrap()).unwrap() });\n  }\n\n  // popFirst(): Option<OrderedEntry<K, V>> -- remove the entry with the smallest key and return it, None when empty. O(t log_t n).\n  @Ensures(result.isSome() == (old(this.size()) > 0))\n  @Ensures(result.isSome() ==> this.size() == old(this.size()) - 1 && !this.has(result.unwrap().key))\n  @Ensures(result.isSome() ==> (result.unwrap().key == old(this.firstKey()).unwrap()))\n  @Ensures(result.isSome() && this.size() > 0 ==> (this.firstKey().unwrap() > result.unwrap().key))\n  popFirst(): Option<OrderedEntry<K, V>> {\n    const f = this.firstKey();\n    if (f.isNone()) {\n      return None;\n    }\n    const v = this.remove(f.unwrap()).unwrap();\n    return Some(OrderedEntry<K, V> { key: f.unwrap(), value: v });\n  }\n\n  // popLast(): Option<OrderedEntry<K, V>> -- remove the entry with the largest key and return it, None when empty. O(t log_t n).\n  @Ensures(result.isSome() == (old(this.size()) > 0))\n  @Ensures(result.isSome() ==> this.size() == old(this.size()) - 1 && !this.has(result.unwrap().key))\n  @Ensures(result.isSome() ==> (result.unwrap().key == old(this.lastKey()).unwrap()))\n  @Ensures(result.isSome() && this.size() > 0 ==> (this.lastKey().unwrap() < result.unwrap().key))\n  popLast(): Option<OrderedEntry<K, V>> {\n    const l = this.lastKey();\n    if (l.isNone()) {\n      return None;\n    }\n    const v = this.remove(l.unwrap()).unwrap();\n    return Some(OrderedEntry<K, V> { key: l.unwrap(), value: v });\n  }\n\n  // keys(): K[] -- all keys in increasing order. Never fails. O(n).\n  @Ensures(result.length == this.size() && isStrictlyIncreasingOrd(result))\n  keys(): K[] {\n    return btreeOrdKeys(this.nodes, this.root);\n  }\n\n  // values(): V[] -- all values in key order. Never fails. O(n).\n  @Ensures(result.length == this.size())\n  values(): V[] {\n    return btreeOrdVals(this.nodes, this.root);\n  }\n\n  // entries(): OrderedEntry<K, V>[] -- all entries in increasing key order. Never fails. O(n).\n  @Ensures(result.length == this.size())\n  entries(): OrderedEntry<K, V>[] {\n    const ks = btreeOrdKeys(this.nodes, this.root);\n    const vs = btreeOrdVals(this.nodes, this.root);\n    let out: OrderedEntry<K, V>[] = [];\n    let i: usize = 0;\n    while (i < ks.length) {\n      out.push(OrderedEntry<K, V> { key: ks[i], value: vs[i] });\n      i += 1;\n    }\n    return out;\n  }\n\n  // clear(): void -- remove all entries. O(1).\n  @Ensures(this.size() == 0)\n  clear(): void {\n    this.nodes = [OrdNode<K, V> { keys: [], vals: [], kids: [] }];\n    this.root = 0;\n    this.free = [];\n    this.count = 0;\n  }\n}\n\n// END GENERATED\n\n// ------------------------------------------------------------------------------------- PriorityQueue\n\n// What `pop` and `peek` return.\nexport type PqEntry<T> = { priority: int; value: T; };\n\n// PQEntry: the old spelling of `PqEntry` (ADR-0048 rule 1.1: acronyms are written as words); remove next release.\nexport type PQEntry<T> = PqEntry<T>;\n\nfunction minInt(a: int, b: int): int {\n  return a < b ? a : b;\n}\n\n// A min-priority queue on a 4-ary implicit heap. `push(priority, value)` adds a value; `pop` returns the entry\n// with the smallest priority, and among equal priorities the one pushed first. Storage is three parallel arrays\n// (priorities, insertion numbers, values: no per-entry allocation, and the comparison keys are contiguous), and\n// sifting moves a \"hole\" instead of swapping (one write per level instead of two). Measured on 200,000 random\n// pushes + pops: 4-ary 122 ms, binary with the same layout 164 ms, 8-ary 137 ms, the earlier binary heap of boxed\n// nodes with swaps 300 ms. Invariants: the three arrays have the same length, they form a heap (an entry leaves\n// strictly before its children) and every insertion number is below the counter `nextSeq`, which never decreases,\n// so insertion numbers are unique and the order is total.\n@Invariant(this.prios.length == this.seqs.length && this.prios.length == this.vals.length)\n@Invariant(isMinHeap4(this.prios, this.seqs))\n@Invariant(seqsBelow(this.seqs, this.nextSeq))\n@Invariant(this.nextSeq >= 0)\nexport class PriorityQueue<T> {\n  private prios: int[] = [];\n  private seqs: int[] = [];\n  private vals: T[] = [];\n  private nextSeq: int = 0;\n\n  // size(): usize -- number of queued entries. O(1).\n  @Ensures(result == this.prios.length)\n  size(): usize {\n    return this.prios.length;\n  }\n\n  // isEmpty(): bool -- nothing queued. O(1).\n  @Ensures(result == (this.size() == 0))\n  isEmpty(): bool {\n    return this.prios.length == 0;\n  }\n\n  // minPriority(): Option<int> -- the smallest priority queued, None when empty. O(1).\n  @Ensures(result.isSome() == (this.size() > 0))\n  minPriority(): Option<int> {\n    if (this.prios.length == 0) {\n      return None;\n    }\n    return Some(this.prios[0]);\n  }\n\n  // allAtLeast(p): bool -- every queued priority is >= p. O(n).\n  @Ensures(this.size() == 0 ==> result)\n  @Ensures(result && this.size() > 0 ==> this.minPriority().unwrap() >= p)\n  allAtLeast(p: int): bool {\n    let i: usize = 0;\n    while (i < this.prios.length) {\n      if (this.prios[i] < p) {\n        return false;\n      }\n      i += 1;\n    }\n    return true;\n  }\n\n  // peek(): Option<PqEntry<T>> -- the entry `pop` would return, without removing it; None when empty. O(1).\n  @Ensures(result.isSome() == (this.size() > 0))\n  @Ensures(result.isSome() ==> result.unwrap().priority == this.minPriority().unwrap())\n  peek(): Option<PqEntry<T>> {\n    if (this.prios.length == 0) {\n      return None;\n    }\n    return Some(PqEntry<T> { priority: this.prios[0], value: this.vals[0] });\n  }\n\n  // push(priority, value): void -- queue a value. O(log_4 n) comparisons, no allocation besides array growth.\n  @Ensures(this.size() == old(this.size()) + 1)\n  @Ensures(this.minPriority().unwrap() == minInt(priority, old(this.minPriority().unwrapOr(priority))))\n  @Ensures(this.allAtLeast(minInt(priority, old(this.minPriority().unwrapOr(priority)))))\n  push(priority: int, value: T): void {\n    const s = this.nextSeq;\n    this.nextSeq += 1;\n    let i = this.prios.length;\n    this.prios.push(priority);\n    this.seqs.push(s);\n    this.vals.push(value);\n    while (i > 0) {\n      const par = (i - 1) / 4;\n      if (!leavesBefore(priority, s, this.prios[par], this.seqs[par])) {\n        break;\n      }\n      this.prios[i] = this.prios[par];\n      this.seqs[i] = this.seqs[par];\n      this.vals[i] = this.vals[par];\n      i = par;\n    }\n    this.prios[i] = priority;\n    this.seqs[i] = s;\n    this.vals[i] = value;\n  }\n\n  // pop(): Option<PqEntry<T>> -- remove and return the entry with the smallest priority (the earliest pushed among equals); None when\n  // empty. The returned priority is <= every priority still queued. O(log_4 n) levels, up to 4 comparisons each.\n  @Ensures(result.isSome() == (old(this.size()) > 0))\n  @Ensures(result.isSome() ==> this.size() == old(this.size()) - 1)\n  @Ensures(result.isSome() ==> result.unwrap().priority == old(this.minPriority().unwrapOr(0)))\n  @Ensures(result.isSome() ==> this.allAtLeast(result.unwrap().priority))\n  @Ensures(result.isNone() ==> this.size() == 0)\n  pop(): Option<PqEntry<T>> {\n    if (this.prios.length == 0) {\n      return None;\n    }\n    const top = PqEntry<T> { priority: this.prios[0], value: this.vals[0] };\n    const lp = this.prios.pop().unwrap();\n    const ls = this.seqs.pop().unwrap();\n    const lv = this.vals.pop().unwrap();\n    const n = this.prios.length;\n    if (n > 0) {\n      let i: usize = 0;\n      while (true) {\n        const c = 4 * i + 1;\n        if (c >= n) {\n          break;\n        }\n        const end = c + 4 < n ? c + 4 : n;\n        let m = c;\n        let k = c + 1;\n        while (k < end) {\n          if (leavesBefore(this.prios[k], this.seqs[k], this.prios[m], this.seqs[m])) {\n            m = k;\n          }\n          k += 1;\n        }\n        if (!leavesBefore(this.prios[m], this.seqs[m], lp, ls)) {\n          break;\n        }\n        this.prios[i] = this.prios[m];\n        this.seqs[i] = this.seqs[m];\n        this.vals[i] = this.vals[m];\n        i = m;\n      }\n      this.prios[i] = lp;\n      this.seqs[i] = ls;\n      this.vals[i] = lv;\n    }\n    return Some(top);\n  }\n\n  // clear(): void -- drop all entries. O(1).\n  @Ensures(this.size() == 0)\n  clear(): void {\n    this.prios = [];\n    this.seqs = [];\n    this.vals = [];\n  }\n}\n\n// ------------------------------------------------------------------------------------------ MinHeap<T>\n\n// A min-priority queue of values ordered by their own `Ord` instance (ADR-0034, slice 2): `pop` returns the smallest value, and\n// among equal values the one pushed first. The same 4-ary implicit heap as `PriorityQueue<T>` (sifting a hole, parallel arrays),\n// with the value itself as the key instead of a separate `int` priority. Invariants: the arrays have the same length, they form\n// a heap and every insertion number is below the counter `nextSeq`. Contracts state value equality: `pop` returns exactly the\n// value `peek` showed, and it is `<=` every value still queued.\n@Invariant(this.vals.length == this.seqs.length)\n@Invariant(isMinHeap4Ord(this.vals, this.seqs))\n@Invariant(seqsBelow(this.seqs, this.nextSeq))\n@Invariant(this.nextSeq >= 0)\nexport class MinHeap<T extends Ord> {\n  private vals: T[] = [];\n  private seqs: int[] = [];\n  private nextSeq: int = 0;\n\n  // size(): usize -- number of queued values. O(1).\n  @Ensures(result == this.vals.length)\n  size(): usize {\n    return this.vals.length;\n  }\n\n  // isEmpty(): bool -- nothing queued. O(1).\n  @Ensures(result == (this.size() == 0))\n  isEmpty(): bool {\n    return this.vals.length == 0;\n  }\n\n  // peek(): Option<T> -- the value `pop` would return, None when empty. O(1).\n  @Ensures(result.isSome() == (this.size() > 0))\n  peek(): Option<T> {\n    if (this.vals.length == 0) {\n      return None;\n    }\n    return Some(this.vals[0]);\n  }\n\n  // allAtLeast(x): bool -- every queued value is >= x. O(n).\n  @Ensures(this.size() == 0 ==> result)\n  @Ensures(result && this.size() > 0 ==> this.peek().unwrap() >= x)\n  allAtLeast(x: T): bool {\n    let i: usize = 0;\n    while (i < this.vals.length) {\n      if (this.vals[i] < x) {\n        return false;\n      }\n      i += 1;\n    }\n    return true;\n  }\n\n  // push(x): void -- queue a value. O(log_4 n) comparisons, no allocation besides array growth.\n  @Ensures(this.size() == old(this.size()) + 1)\n  @Ensures(this.peek().unwrap() <= x)\n  @Ensures(this.peek().unwrap() == x || this.peek().unwrap() == old(this.peek()).unwrap())\n  @Ensures(this.allAtLeast(this.peek().unwrap()))\n  push(x: T): void {\n    const s = this.nextSeq;\n    this.nextSeq += 1;\n    let i = this.vals.length;\n    this.vals.push(x);\n    this.seqs.push(s);\n    while (i > 0) {\n      const par = (i - 1) / 4;\n      if (!leavesBeforeOrd(x, s, this.vals[par], this.seqs[par])) {\n        break;\n      }\n      this.vals[i] = this.vals[par];\n      this.seqs[i] = this.seqs[par];\n      i = par;\n    }\n    this.vals[i] = x;\n    this.seqs[i] = s;\n  }\n\n  // pop(): Option<T> -- remove and return the smallest value (the earliest pushed among equals); None when empty. The result is equal to the\n  // value `peek` showed and is <= every value still queued. O(log_4 n) levels, up to 4 comparisons each.\n  @Ensures(result.isSome() == (old(this.size()) > 0))\n  @Ensures(result.isSome() ==> this.size() == old(this.size()) - 1)\n  @Ensures(result.isSome() ==> result.unwrap() == old(this.peek()).unwrap())\n  @Ensures(result.isSome() ==> this.allAtLeast(result.unwrap()))\n  @Ensures(result.isNone() ==> this.size() == 0)\n  pop(): Option<T> {\n    if (this.vals.length == 0) {\n      return None;\n    }\n    const top = this.vals[0];\n    const lv = this.vals.pop().unwrap();\n    const ls = this.seqs.pop().unwrap();\n    const n = this.vals.length;\n    if (n > 0) {\n      let i: usize = 0;\n      while (true) {\n        const c = 4 * i + 1;\n        if (c >= n) {\n          break;\n        }\n        const end = c + 4 < n ? c + 4 : n;\n        let m = c;\n        let k = c + 1;\n        while (k < end) {\n          if (leavesBeforeOrd(this.vals[k], this.seqs[k], this.vals[m], this.seqs[m])) {\n            m = k;\n          }\n          k += 1;\n        }\n        if (!leavesBeforeOrd(this.vals[m], this.seqs[m], lv, ls)) {\n          break;\n        }\n        this.vals[i] = this.vals[m];\n        this.seqs[i] = this.seqs[m];\n        i = m;\n      }\n      this.vals[i] = lv;\n      this.seqs[i] = ls;\n    }\n    return Some(top);\n  }\n\n  // clear(): void -- drop all values. O(1).\n  @Ensures(this.size() == 0)\n  clear(): void {\n    this.vals = [];\n    this.seqs = [];\n  }\n}\n" });
  out.push(SourceFile { path: "$stdlib/collections_internal.or", text: "// std:collections/internal -- the helper functions and node types behind std:collections (ADR-0048 rule 7.3). NOT API.\n//\n// Everything here exists because a contract has to be able to call it: the loop-based predicates the class invariants of\n// `IntSet`, `Set`, `SortedMap`, `SortedStringMap`, `OrderedMap`, `PriorityQueue` and `MinHeap` are made of (no closures, no recursion: ADR-0030 section 3),\n// and the B-tree shape, order and counting checks the sorted maps assert after every public method. The language has no\n// visibility between \"private to the file\" and \"exported\", so they are exported from this module, which user code does not\n// import; the loader may warn about such an import once ADR-0047's library layout is in place. Names and signatures here\n// can change in any release. The B-tree helpers are generated from tools/sorted_map.tmpl by tools/gen_sorted_map.py.\n//\n// What `std:collections` is made of is documented in docs/std.md.\n\n// allTrue(xs): bool -- every element is true. Loop-based (contracts cannot use `every`).\nexport function allTrue(xs: bool[]): bool {\n  let i: usize = 0;\n  while (i < xs.length) {\n    if (!xs[i]) {\n      return false;\n    }\n    i += 1;\n  }\n  return true;\n}\n\n// isStrictlyIncreasing(xs): bool -- xs[0] < xs[1] < ... (so sorted and without duplicates).\nexport function isStrictlyIncreasing(xs: int[]): bool {\n  let i: usize = 1;\n  while (i < xs.length) {\n    if (xs[i - 1] >= xs[i]) {\n      return false;\n    }\n    i += 1;\n  }\n  return true;\n}\n\n// compareBytewise(a, b): int -- -1, 0 or 1; byte-wise lexicographic order (shorter prefix first), the order of\n// `SortedStringMap` (the public spelling is `std:collections.compareStrings`). O(min(a.length, b.length)).\n@Ensures(result >= -1 && result <= 1)\n@Ensures((result == 0) == (a.length == b.length && !differsAt(a, b)))\nexport function compareBytewise(a: string, b: string): int {\n  const n = a.length < b.length ? a.length : b.length;\n  let i: usize = 0;\n  while (i < n) {\n    const x = a.charCodeAt(i);\n    const y = b.charCodeAt(i);\n    if (x < y) {\n      return -1;\n    }\n    if (x > y) {\n      return 1;\n    }\n    i += 1;\n  }\n  if (a.length < b.length) {\n    return -1;\n  }\n  if (a.length > b.length) {\n    return 1;\n  }\n  return 0;\n}\n\n// Does some byte inside the common length differ?\nfunction differsAt(a: string, b: string): bool {\n  const n = a.length < b.length ? a.length : b.length;\n  let i: usize = 0;\n  while (i < n) {\n    if (a.charCodeAt(i) != b.charCodeAt(i)) {\n      return true;\n    }\n    i += 1;\n  }\n  return false;\n}\n\n// isStrictlyIncreasingStrings(xs): bool -- compareBytewise(xs[i-1], xs[i]) < 0 for all i.\nexport function isStrictlyIncreasingStrings(xs: string[]): bool {\n  let i: usize = 1;\n  while (i < xs.length) {\n    if (compareBytewise(xs[i - 1], xs[i]) >= 0) {\n      return false;\n    }\n    i += 1;\n  }\n  return true;\n}\n\n\n// ---------------------------------------------------------------------------------------------- priority queue\n\n// Does the entry (p1, s1) leave before (p2, s2)? Lower priority first; equal priorities by insertion number.\nexport function leavesBefore(p1: int, s1: int, p2: int, s2: int): bool {\n  return p1 < p2 || (p1 == p2 && s1 < s2);\n}\n\n// isMinHeap4(prios, seqs): bool -- every entry leaves strictly before its up to four children (children of i are\n// 4i+1 .. 4i+4, parent of i is (i-1)/4). Loop-based.\nexport function isMinHeap4(prios: int[], seqs: int[]): bool {\n  if (prios.length != seqs.length) {\n    return false;\n  }\n  let i: usize = 1;\n  while (i < prios.length) {\n    const p = (i - 1) / 4;\n    if (!leavesBefore(prios[p], seqs[p], prios[i], seqs[i])) {\n      return false;\n    }\n    i += 1;\n  }\n  return true;\n}\n\n// Are all insertion numbers in 0..bound-1?\nexport function seqsBelow(seqs: int[], bound: int): bool {\n  let i: usize = 0;\n  while (i < seqs.length) {\n    if (seqs[i] < 0 || seqs[i] >= bound) {\n      return false;\n    }\n    i += 1;\n  }\n  return true;\n}\n\n// isStrictlyIncreasingOrd(xs): bool -- xs[0] < xs[1] < ... under the key type's `Ord` order (the generic `isStrictlyIncreasing`,\n// the invariant helper of `OrderedMap`). Loop-based.\nexport function isStrictlyIncreasingOrd<T extends Ord>(xs: T[]): bool {\n  let i: usize = 1;\n  while (i < xs.length) {\n    if (xs[i - 1] >= xs[i]) {\n      return false;\n    }\n    i += 1;\n  }\n  return true;\n}\n\n// leavesBeforeOrd(a, s1, b, s2): bool -- does the entry (a, s1) leave before (b, s2)? Smaller value first; equal values by\n// insertion number (the generic `leavesBefore`, for `MinHeap`).\nexport function leavesBeforeOrd<T extends Ord>(a: T, s1: int, b: T, s2: int): bool {\n  return a < b || (a == b && s1 < s2);\n}\n\n// isMinHeap4Ord(vals, seqs): bool -- every entry leaves strictly before its up to four children (the generic `isMinHeap4`).\nexport function isMinHeap4Ord<T extends Ord>(vals: T[], seqs: int[]): bool {\n  if (vals.length != seqs.length) {\n    return false;\n  }\n  let i: usize = 1;\n  while (i < vals.length) {\n    const p = (i - 1) / 4;\n    if (!leavesBeforeOrd(vals[p], seqs[p], vals[i], seqs[i])) {\n      return false;\n    }\n    i += 1;\n  }\n  return true;\n}\n\n// BEGIN GENERATED by tools/gen_sorted_map.py from tools/sorted_map.tmpl: do not edit, run the script\n// ------------------------------------------------------------------------------------------ SortedMap\n\n// One node of the B-tree: `keys` sorted, `vals` parallel to them, `kids` empty for a leaf, else keys.length + 1\n// child ids (indices into the arena `nodes` of the map).\nexport type IntNode<V> = { keys: int[]; vals: V[]; kids: usize[]; };\n\n// The first index whose key is >= k (keys.length when there is none). Binary search, O(log keys.length).\n@Ensures(result <= keys.length)\n@Ensures(result < keys.length ==> (keys[result] >= k))\n@Ensures(result > 0 ==> (keys[result - 1] < k))\nexport function lowerBoundInt(keys: int[], k: int): usize {\n  let lo: usize = 0;\n  let hi: usize = keys.length;\n  while (lo < hi) {\n    const mid = lo + (hi - lo) / 2;\n    if ((keys[mid] < k)) {\n      lo = mid + 1;\n    } else {\n      hi = mid;\n    }\n  }\n  return lo;\n}\n\n// Is `nodes` a well-formed B-tree arena of minimum degree t rooted at `root`, with free list `free`? Checked\n// iteratively with an explicit stack: every node id is in range and reached exactly once (no dangling or shared\n// ids, no cycles), keys and values have the same length, a leaf has no children and an inner node has one more\n// child than keys (and at least one key), every non-root node holds t-1 .. 2t-1 keys and the root at most 2t-1,\n// all leaves have the same depth, the free list holds distinct ids of unreachable nodes, and every arena slot is\n// either reachable or free.\nexport function btreeIntShapeOk<V>(nodes: IntNode<V>[], root: usize, t: usize, free: usize[]): bool {\n  const n = nodes.length;\n  if (t < 2 || root >= n) {\n    return false;\n  }\n  let seen: bool[] = [];\n  let i: usize = 0;\n  while (i < n) {\n    seen.push(false);\n    i += 1;\n  }\n  i = 0;\n  while (i < free.length) {\n    if (free[i] >= n || seen[free[i]]) {\n      return false;\n    }\n    seen[free[i]] = true;\n    i += 1;\n  }\n  let ids: usize[] = [root];\n  let depths: usize[] = [0];\n  let leafDepth: int = -1;\n  let reachable: usize = 0;\n  while (ids.length > 0) {\n    const id = ids.pop().unwrap();\n    const d = depths.pop().unwrap();\n    if (seen[id]) {\n      return false;\n    }\n    seen[id] = true;\n    reachable += 1;\n    const kc = nodes[id].keys.length;\n    if (nodes[id].vals.length != kc || kc > 2 * t - 1) {\n      return false;\n    }\n    if (id != root && kc < t - 1) {\n      return false;\n    }\n    const kk = nodes[id].kids.length;\n    if (kk == 0) {\n      if (leafDepth < 0) {\n        leafDepth = d.toInt();\n     