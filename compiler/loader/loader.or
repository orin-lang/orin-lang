// Module loader: reads files, parses them, resolves imports, enforces module boundaries (E0302),
// acyclicity of files (E0303) and the module rules of a package (E0501, E0502, E0303).
//
// The units come out in dependency order: a depth-first walk in import order, a unit being
// completed (and numbered) after all its imports, the entry last. File paths are normalized
// lexically (see path.or), not canonicalized.

import { Module, Item, ImportDecl, Ident, plainImport, parseRecovering, MAX_SYNTAX_ERRORS } from "../syntax";
import {
  Span, SourceMap, SourceFile, Diagnostic, diag, span, allRenderable, allWellFormed,
} from "../diag";
import { Manifest } from "../package";
import {
  ImportTarget, StdModule, Unit, LoadedProgram, LoadOutcome, failedLoad, importOf, isWellFormed,
  isValidOutcome, isTopological, allUnitsWellFormed, targetBelow,
} from "./program";
import { normalizePath, isNormalized, allNormalized, allDistinct, dirname, joinPath } from "./path";
import { PreludeRoot, noPreludeRoots, rootsWellFormed, countEntries } from "./prelude";
import { Sources } from "./sources";
import { FsGrant } from "std:fs";
import { ImportResolver } from "./resolve";
import { ModuleGraph } from "./modgraph";
import { SrcRoot, findManifest, readManifest, manifestEntry } from "./modules";

export type LoadResult = { program: LoadedProgram; sm: SourceMap; };

// The prelude of parallel array pipelines (the array method `parallel()`, ADR-0039): part of the `$array` root, loaded
// only for a file whose text contains a dot followed by `parallel(` (a comment or a string that does too only costs the
// loading of that unit). The sources compiled into the compiler avoid that spelling, so the compiler does not load it.
const PARALLEL_PRELUDE: string = "$array/parallel.or";

// Does the file `path` with source `text` need the parallel prelude?
@Ensures(result ==> path != PARALLEL_PRELUDE)
export function usesParallel(path: string, text: string): bool {
  return path != PARALLEL_PRELUDE && text.includes("." + "parallel(");
}

// True when unit `i` of `units` is the one `done` records for its path, for every unit: the index
// map and the unit list describe the same set of files.
@Ensures(units.length == 0 ==> result)
function unitsIndexed(units: Unit[], done: Map<string, usize>): bool {
  let i: usize = 0;
  while (i < units.length) {
    const at = done.get(units[i].path);
    if (at.isNone() || at.unwrap() != i) {
      return false;
    }
    i += 1;
  }
  return true;
}

// True when none of the files in `open` has been completed (`done`): a file is either being loaded
// or finished, never both (this is what lets a re-entered open file be reported as a cycle).
@Ensures(open.length == 0 ==> result)
function noneDone(open: string[], done: Map<string, usize>): bool {
  for (const p of open) {
    if (done.has(p)) {
      return false;
    }
  }
  return true;
}

// True when the entry unit of `p` starts with one unit import per prelude root that has an entry
// file, in root order, each naming that root's entry file (the loader prepends them to the entry's
// own items, so the prelude units sort before everything the program imports).
function importsPreludeRoots(p: LoadedProgram, roots: PreludeRoot[]): bool {
  if (p.entry >= p.units.length) {
    return false;
  }
  const imps = p.units[p.entry].imports;
  let k: usize = 0;
  for (const r of roots) {
    if (r.entry != "") {
      if (k >= imps.length) {
        return false;
      }
      const ok = match (imps[k]) {
        ImportUnit(u) => u < p.units.length && p.units[u].path == normalizePath(r.entry),
        ImportStd(_) => false,
      };
      if (!ok) {
        return false;
      }
      k += 1;
    }
  }
  return true;
}

// The text of the first overlay file whose normalized path is `path` (the one `Sources` serves).
function firstOverlayText(overlay: SourceFile[], path: string): Option<string> {
  for (const f of overlay) {
    if (normalizePath(f.path) == path) {
      return Some(f.text);
    }
  }
  return None;
}

// True when every loaded unit whose path is in the overlay has the text of the first such overlay
// file: unsaved editor buffers shadow the disk, and the first of several duplicates wins.
function overlayRespected(overlay: SourceFile[], o: LoadOutcome): bool {
  if (o.program.isNone()) {
    return true;
  }
  for (const u of o.program.unwrap().units) {
    const t = firstOverlayText(overlay, u.path);
    if (t.isSome() && o.sm.files[u.file].text != t.unwrap()) {
      return false;
    }
  }
  return true;
}

// One load of a program. `files` and `units` are filled while walking the import graph; after a
// failed `run`, `files` holds every file read so far (the entry first, then in discovery order).
//
// The invariants hold after every `run` (also a failed one, which leaves `stack` non-empty): the
// units are in dependency order with unique, normalized paths; `done` indexes exactly the units;
// `stack` holds distinct files that are not completed; without a manifest no module edge exists.
@Invariant(this.units.length == this.done.size)
@Invariant(this.done.size + this.stack.length <= this.files.length)
@Invariant(unitsIndexed(this.units, this.done))
@Invariant(isTopological(this.units) && allUnitsWellFormed(this.units))
@Invariant(allNormalized(this.stack) && allDistinct(this.stack) && noneDone(this.stack, this.done))
@Invariant(this.manifest.isNone() ==> this.graph.edgeCount() == 0)
@Invariant(this.moreSyntaxErrors.length < MAX_SYNTAX_ERRORS)
class Loader {
  files: SourceFile[] = [];
  // After a failed `run` whose error is a syntax error: the further syntax errors of that file (error recovery; the
  // first one is the `Err` of `run`). No other file is parsed after it, so no checker ever sees that file.
  moreSyntaxErrors: Diagnostic[] = [];
  private units: Unit[] = [];
  private done: Map<string, usize> = new Map<string, usize>(); // file path -> index in `units`
  private stack: string[] = []; // files being loaded (their imports are not complete yet)
  private graph: ModuleGraph;
  private src: Sources;
  private roots: PreludeRoot[];
  private resolver: ImportResolver; // knows the entry file's directory; unit names are relative to it
  private tree: SrcRoot; // module ids are relative to its root
  private manifest: Option<Manifest>;

  @Requires(isNormalized(base) && isNormalized(srcRoot))
  constructor(
    src: Sources,
    roots: PreludeRoot[],
    base: string,
    srcRoot: string,
    manifest: Option<Manifest>,
  ) {
    this.src = src;
    this.roots = roots;
    this.resolver = new ImportResolver(src, base);
    this.tree = new SrcRoot(src, srcRoot);
    this.graph = new ModuleGraph(manifest);
    this.manifest = manifest;
  }

  // Loads the entry file and everything it imports; the entry is the last unit.
  @Requires(isNormalized(entry))
  @Ensures(result.isOk() ==> this.stack.length == 0 && this.files.length == this.units.length)
  @Ensures(result.isOk() ==> isWellFormed(result.unwrap(), SourceMap { files: this.files }))
  @Ensures(result.isOk() ==> result.unwrap().manifest.isSome() == this.manifest.isSome())
  @Ensures(result.isOk() ==> importsPreludeRoots(result.unwrap(), this.roots))
  @Ensures(result.isOk() ==> this.graph.acyclic())
  @Ensures(result.isErr()
      ==> this.files.length > 0 && isRenderableErr(this.files, result.unwrapErr()))
  @Ensures(result.isErr() ==> allRenderable(SourceMap { files: this.files }, this.moreSyntaxErrors))
  @Ensures(result.isOk() ==> this.moreSyntaxErrors.length == 0)
  run(fs: FsGrant, entry: string, entryDisplay: string): Result<LoadedProgram, Diagnostic> {
    this.visit(fs, entry, entryDisplay)?;
    this.checkModuleCycles()?;
    return Ok(LoadedProgram {
      units: this.units,
      entry: this.units.length - 1,
      manifest: this.manifest,
    });
  }

  // Opens, parses and completes the unit of file `path` (`display` is how diagnostics name it);
  // returns its index in `units`.
  @Requires(isNormalized(path) && !this.done.has(path))
  @Ensures(result.isOk()
      ==> result.unwrap() < this.units.length && this.units[result.unwrap()].path == path)
  @Ensures(result.isOk()
      ==> this.done.has(path) && this.files[this.units[result.unwrap()].file].path == display)
  private visit(fs: FsGrant, path: string, display: string): Result<usize, Diagnostic> {
    const text = this.src.read(fs, path);
    if (text.isErr()) {
      this.files.push(SourceFile { path: display, text: "" });
      return Err(
        diag(
          "E0301",
          span(this.files.length - 1, 0, 0),
          `cannot read \`${path}\`: ${text.unwrapErr()}`,
        ),
      );
    }
    const file = this.files.length;
    this.files.push(SourceFile { path: display, text: text.unwrap() });
    const pr = parseRecovering(file, text.unwrap());
    if (pr.isErr()) {
      const ds = pr.unwrapErr();
      this.moreSyntaxErrors = ds.slice(1, ds.length);
      return Err(ds[0]);
    }
    const parsed = pr.unwrap();
    // The entry file also gets the implicit imports of the prelude roots, in front of its own items. A file that calls
    // the array method `parallel()` also imports the parallel-pipeline prelude (ADR-0039), which is loaded only for such programs.
    const noItems: Item[] = [];
    const par = usesParallel(path, text.unwrap()) ? [this.parallelImport(file)] : noItems;
    const ast = file == 0
        ? Module { file: parsed.file, items: this.preludeImports(file).concat(par).concat(parsed.items) }
        : Module { file: parsed.file, items: par.concat(parsed.items) };
    this.stack.push(path);
    let imports: ImportTarget[] = [];
    for (const item of ast.items) {
      const decl = importOf(item);
      if (decl.isSome()) {
        imports.push(this.importTarget(fs, path, decl.unwrap())?);
      }
    }
    this.stack.pop();
    const index = this.units.length;
    this.units.push(Unit {
      file: file,
      path: path,
      name: this.resolver.nameOf(path),
      module: this.tree.moduleOf(fs, path),
      ast: ast,
      imports: imports,
    });
    this.done.set(path, index);
    return Ok(index);
  }

  // `import {} from "<entry>"` for every prelude root that has an entry file (library roots such as
  // std:path are served from memory and imported on demand).
  @Requires(file == 0)
  @Ensures(result.length == countEntries(this.roots))
  private preludeImports(file: usize): Item[] {
    const sp = span(file, 0, 0);
    const none: Ident[] = [];
    return this.roots
        .filter(r => r.entry != "")
        .map(r => IImport(plainImport(none, r.entry, sp, sp, false)));
  }

  // `import {} from "$array/parallel.or"`: the prelude of the array method `parallel()` (ADR-0039).
  private parallelImport(file: usize): Item {
    const sp = span(file, 0, 0);
    const none: Ident[] = [];
    return IImport(plainImport(none, PARALLEL_PRELUDE, sp, sp, false));
  }

  @Requires(isNormalized(importer))
  @Ensures(result.isOk() ==> targetBelow(result.unwrap(), this.units.length))
  private importTarget(
    fs: FsGrant,
    importer: string,
    decl: ImportDecl,
  ): Result<ImportTarget, Diagnostic> {
    if (isGenSpecifier(decl.path)) {
      return this.companionTarget(fs, importer, decl);
    }
    const res = this.resolver.resolve(fs, importer, decl.path, decl.pathSpan)?;
    if (res.std.isSome()) {
      return Ok(ImportStd(res.std.unwrap()));
    }
    this.recordModuleEdge(fs, importer, res.path, decl.pathSpan)?;
    const finished = this.done.get(res.path);
    if (finished.isSome()) {
      return Ok(ImportUnit(finished.unwrap()));
    }
    const open = this.stack.indexOf(res.path);
    if (open.isSome()) {
      // Import cycle: the stack from the file being re-entered, then that file again.
      const chain = this.stack
          .slice(open.unwrap(), this.stack.length)
          .concat([res.path])
          .map(p => this.resolver.nameOf(p));
      return Err(diag("E0303", decl.pathSpan, `import cycle: ${chain.join(" -> ")}`));
    }
    return Ok(ImportUnit(this.visit(fs, res.path, res.path)?));
  }

  // `import { .. } from "./m.gen"` (ADR-0046 S4): the specifier names the companion module of the source module `./m`.
  // The companion does not exist on disk; the loader loads the source module (a missing one is E0301 as usual) and adds a
  // placeholder unit right after it: an empty module whose path is the source path with `.gen` instead of `.or`. The
  // expansion pipeline (compiler/expand) fills the placeholder before the program is checked. Importing the companion
  // of a module that is still being loaded closes a cycle: a module that is imported (directly or transitively) by the
  // source module cannot import its companion (E0521).
  @Requires(isNormalized(importer) && isGenSpecifier(decl.path))
  @Ensures(result.isOk() ==> targetBelow(result.unwrap(), this.units.length))
  private companionTarget(
    fs: FsGrant,
    importer: string,
    decl: ImportDecl,
  ): Result<ImportTarget, Diagnostic> {
    const spec = decl.path.substring(0, decl.path.length - GEN_SUFFIX.length);
    const res = this.resolver.resolve(fs, importer, spec, decl.pathSpan)?;
    this.recordModuleEdge(fs, importer, res.path, decl.pathSpan)?;
    const gen = companionPath(res.path);
    const finished = this.done.get(gen);
    if (finished.isSome()) {
      return Ok(ImportUnit(finished.unwrap()));
    }
    const open = this.stack.indexOf(res.path);
    if (open.isSome()) {
      const chain = this.stack
          .slice(open.unwrap(), this.stack.length)
          .concat([gen])
          .map(p => this.resolver.nameOf(p));
      return Err(
        diag(
          "E0521",
          decl.pathSpan,
          `generated module \`${decl.path}\` is imported while its source module is still being loaded: ${chain.join(" -> ")}; a module that uses processor annotations must not import a \`.gen\` module, directly or transitively`,
        ),
      );
    }
    if (!this.done.has(res.path)) {
      this.visit(fs, res.path, res.path)?;
    }
    const file = this.files.length;
    this.files.push(SourceFile { path: gen, text: "" });
    const index = this.units.length;
    this.units.push(
      Unit {
        file: file,
        path: gen,
        name: this.resolver.nameOf(gen),
        module: this.tree.moduleOf(fs, res.path),
        ast: Module { file: file, items: [] },
        imports: [],
      },
    );
    this.done.set(gen, index);
    return Ok(ImportUnit(index));
  }

  // In a package, an import between two different modules must be allowed by the manifest (E0501);
  // allowed edges are collected for the cycle check (see ModuleGraph).
  @Requires(isNormalized(importer) && isNormalized(target))
  @Ensures(this.manifest.isNone()
      ==> result.isOk() && this.graph.edgeCount() == old(this.graph.edgeCount()))
  private recordModuleEdge(
    fs: FsGrant,
    importer: string,
    target: string,
    at: Span,
  ): Result<void, Diagnostic> {
    if (this.manifest.isNone()) {
      return Ok();
    }
    return this.graph.add(this.tree.moduleOf(fs, importer), this.tree.moduleOf(fs, target), at);
  }

  // The module graph of a package must be acyclic (E0303), reported at the import that closes the cycle.
  private checkModuleCycles(): Result<void, Diagnostic> {
    return this.graph.checkCycles();
  }
}

// The suffix of the import specifier of a companion module (ADR-0046 S4): `"./models.gen"`.
const GEN_SUFFIX: string = ".gen";

// True when the import specifier `p` names a companion module: a relative path that ends in `.gen`.
export function isGenSpecifier(p: string): bool {
  return p.startsWith(".") && p.endsWith(GEN_SUFFIX) && p.length > GEN_SUFFIX.length + 1;
}

// The virtual path of the companion of the source file `path` (normalized, ends in `.or`): `.gen` instead of `.or`.
@Requires(path.endsWith(".or"))
@Ensures(result.endsWith(GEN_SUFFIX))
export function companionPath(path: string): string {
  return path.substring(0, path.length - 3) + GEN_SUFFIX;
}

// True when the single diagnostic `d` of a failed load can be rendered against the files read so far.
function isRenderableErr(files: SourceFile[], d: Diagnostic): bool {
  return allRenderable(SourceMap { files: files }, [d]);
}

// Loads the program rooted at `entryPath`, which may also be a package directory (orin.toml) or a
// file inside one. File contents come from `overlay` (unsaved editor buffers, spec 18 §2) when a
// path matches (compared after `normalizePath`), otherwise from disk; an overlay file also counts as
// existing for import resolution. Every prelude root's files are served from memory and each root's
// entry file is imported (with no names) by the program's entry file, so the prelude units come
// first in `units` (before the entry's own dependencies) and are checked, lowered and emitted with
// the program. (The entry file keeps file id 0; prelude files get the next ids.)
@Requires(rootsWellFormed(roots))
@Ensures(isValidOutcome(result))
@Ensures(result.sm.files.length > 0 && allWellFormed(result.diags))
@Ensures(overlayRespected(overlay, result))
@Ensures(result.program.isSome() ==> importsPreludeRoots(result.program.unwrap(), roots))
export function loadWithRoots(
  fs: FsGrant,
  entryPath: string,
  overlay: SourceFile[],
  roots: PreludeRoot[],
): LoadOutcome {
  const src = new Sources(roots.reduce((all, r) => all.concat(r.files), overlay));
  let entry = normalizePath(entryPath);
  let entryDisplay = entryPath;
  let srcRoot = dirname(entry);
  let manifest: Option<Manifest> = None;
  const tomlPath = findManifest(fs, src, entry);
  if (tomlPath.isSome()) {
    const read = readManifest(fs, src, tomlPath.unwrap());
    if (read.isErr()) {
      return read.unwrapErr();
    }
    const m = read.unwrap();
    const packageEntry = manifestEntry(tomlPath.unwrap(), m);
    srcRoot = dirname(packageEntry);
    if (joinPath(entry, "orin.toml") == tomlPath.unwrap()) {
      // `entryPath` named the package directory: start at the package's entry file.
      entry = packageEntry;
      entryDisplay = packageEntry;
    }
    manifest = Some(m);
  }
  let loader = new Loader(src, roots, dirname(entry), srcRoot, manifest);
  const r = loader.run(fs, entry, entryDisplay);
  if (r.isErr()) {
    return failedLoad(loader.files, [r.unwrapErr()].concat(loader.moreSyntaxErrors));
  }
  return LoadOutcome {
    sm: SourceMap { files: loader.files },
    program: Some(r.unwrap()),
    diags: [],
  };
}

// Like loadWithRoots with the roots every compilation has (the array API and the Orin std modules).
@Ensures(isValidOutcome(result) && result.sm.files.length > 0 && allWellFormed(result.diags))
export function loadWithOverlay(
  fs: FsGrant,
  entryPath: string,
  overlay: SourceFile[],
): LoadOutcome {
  return loadWithRoots(fs, entryPath, overlay, noPreludeRoots());
}

@Ensures(isValidOutcome(result) && result.sm.files.length > 0 && allWellFormed(result.diags))
export function loadAll(fs: FsGrant, entryPath: string): LoadOutcome {
  return loadWithOverlay(fs, entryPath, []);
}

@Ensures(result.isOk() ==> isWellFormed(result.unwrap().program, result.unwrap().sm))
@Ensures(result.isErr() ==> result.unwrapErr().length > 0 && allWellFormed(result.unwrapErr()))
export function load(fs: FsGrant, entryPath: string): Result<LoadResult, Diagnostic[]> {
  const o = loadAll(fs, entryPath);
  return match (o.program) {
    Some(p) => Ok(LoadResult { program: p, sm: o.sm }),
    None => Err(o.diags),
  };
}
