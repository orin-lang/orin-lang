// Packages (orin.toml, spec 04): finding and reading the manifest, and module ids.

import { SourceFile, Span, Diagnostic, Diagnostics, diag, span, allRenderable } from "../diag";
import { Manifest, parseManifest } from "../package";
import { LoadOutcome, failedLoad } from "./program";
import { Sources } from "./sources";
import { FsGrant } from "std:fs";
import { isNormalized, isAbs, dirname, joinPath, relativeTo, isInside } from "./path";

// The src root of a load (the directory of the entry file, or of the package's entry file) and the
// files below it: answers which module a file belongs to. Module ids are directories relative to
// the root ("." is the root module).
@Invariant(isNormalized(this.root))
export class SrcRoot {
  private src: Sources;
  private root: string;

  @Requires(isNormalized(root))
  constructor(src: Sources, root: string) {
    this.src = src;
    this.root = root;
  }

  // Module id of file `p`: the directory (relative to the src root, "." for the root itself) of
  // the nearest enclosing directory that contains a `module.or`; "" for prelude units and files
  // outside the root.
  @Requires(isNormalized(p))
  @Ensures(result == "" || isNormalized(result) && !isAbs(result))
  @Ensures(p.startsWith("$") || !isInside(this.root, p) ==> result == "")
  @Ensures(isInside(this.root, p) && !p.startsWith("$") ==> result != "")
  moduleOf(fs: FsGrant, p: string): string {
    if (p.startsWith("$") || !isInside(this.root, p)) {
      return "";
    }
    let d = dirname(p);
    while (d != this.root && isInside(this.root, d)) {
      if (this.src.exists(fs, joinPath(d, "module.or"))) {
        return relativeTo(this.root, d);
      }
      const parent = dirname(d);
      if (parent == d) {
        break;
      }
      d = parent;
    }
    return ".";
  }

  // True when module id `mod` ("." or a directory with a `module.or`) exists under the root.
  @Ensures(mod == "." ==> result)
  hasModule(fs: FsGrant, mod: string): bool {
    return mod == "." || this.src.exists(fs, joinPath(this.root, mod + "/module.or"));
  }

  // E0502 for every module name in the manifest that has no `module.or` (the manifest is file 0).
  // Every diagnostic lies in file 0 and the result is empty exactly when all names exist.
  @Ensures(allWellFormedIn(result, 0))
  unknownModules(fs: FsGrant, m: Manifest): Diagnostic[] {
    let out = new Diagnostics();
    for (const r of m.rules) {
      if (!this.hasModule(fs, r.module)) {
        out.add(unknownModule(r.span, `[modules.${r.module}]`, r.module, this.root));
      }
      let i: usize = 0;
      @Invariant(i <= r.allowed.length)
      while (i < r.allowed.length) {
        if (!this.hasModule(fs, r.allowed[i])) {
          out.add(
            unknownModule(
              r.allowedSpans[i],
              `allowed_dependencies of [modules.${r.module}]`,
              r.allowed[i],
              this.root,
            ),
          );
        }
        i += 1;
      }
    }
    return out.toArray();
  }
}

// True when every diagnostic of `ds` is an E0502 in file `file`.
function allWellFormedIn(ds: Diagnostic[], file: usize): bool {
  for (const d of ds) {
    if (d.code != "E0502" || d.span.file != file || d.span.start > d.span.end) {
      return false;
    }
  }
  return true;
}

// The orin.toml governing `entry`: `entry/orin.toml` when `entry` is a package directory,
// otherwise the nearest one in an ancestor directory of the entry file.
@Requires(isNormalized(entry))
@Ensures(result.isSome() ==> isNormalized(result.unwrap()) && result.unwrap().endsWith("orin.toml"))
@Ensures(result.isSome() ==> isAbs(result.unwrap()) == isAbs(entry))
export function findManifest(fs: FsGrant, src: Sources, entry: string): Option<string> {
  const inDir = joinPath(entry, "orin.toml");
  if (src.exists(fs, inDir)) {
    return Some(inDir);
  }
  let d = dirname(entry);
  while (true) {
    const c = joinPath(d, "orin.toml");
    if (src.exists(fs, c)) {
      return Some(c);
    }
    const parent = dirname(d);
    if (parent == d) {
      return None;
    }
    d = parent;
  }
}

@Requires(sp.start <= sp.end)
@Ensures(result.code == "E0502" && result.span.file == 0)
function unknownModule(sp: Span, what: string, mod: string, root: string): Diagnostic {
  const wanted = mod == "." ? "module.or" : `${mod}/module.or`;
  return diag(
    "E0502",
    span(0, sp.start, sp.end),
    `unknown module \`${mod}\` in ${what}: no \`${wanted}\` under the src root \`${root}\``,
  );
}

// The package entry file named by `m` (relative to the directory of the manifest at `tomlPath`).
@Requires(isNormalized(tomlPath))
@Ensures(isNormalized(result))
@Ensures(!isAbs(m.entry) && !m.entry.includes("..") ==> isInside(dirname(tomlPath), result))
export function manifestEntry(tomlPath: string, m: Manifest): string {
  return joinPath(dirname(tomlPath), m.entry);
}

// Reads and validates the manifest; the error is a complete failed outcome (with the manifest as its
// only file) so that the diagnostics can be rendered.
@Requires(isNormalized(tomlPath))
@Ensures(result.isErr()
    ==> result.unwrapErr().program.isNone() && result.unwrapErr().diags.length > 0)
@Ensures(result.isErr()
    ==> result.unwrapErr().sm.files.length == 1 && result.unwrapErr().sm.files[0].path == tomlPath)
@Ensures(result.isErr() ==> allRenderable(result.unwrapErr().sm, result.unwrapErr().diags))
export function readManifest(
  fs: FsGrant,
  src: Sources,
  tomlPath: string,
): Result<Manifest, LoadOutcome> {
  const rt = src.read(fs, tomlPath);
  if (rt.isErr()) {
    const unreadable = diag(
      "E0301",
      span(0, 0, 0),
      `cannot read \`${tomlPath}\`: ${rt.unwrapErr()}`,
    );
    return Err(failedLoad([SourceFile { path: tomlPath, text: "" }], [unreadable]));
  }
  const files = [SourceFile { path: tomlPath, text: rt.unwrap() }];
  const mr = parseManifest(0, rt.unwrap());
  if (mr.isErr()) {
    return Err(failedLoad(files, [mr.unwrapErr()]));
  }
  const m = mr.unwrap();
  const unknown = new SrcRoot(src, dirname(manifestEntry(tomlPath, m))).unknownModules(fs, m);
  if (unknown.length > 0) {
    return Err(failedLoad(files, unknown));
  }
  return Ok(Manifest { ...m, source: files[0] });
}
