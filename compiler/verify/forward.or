// Rule F1, load forwarding (docs/mir.md v2.4, ADR-0038 lever 2, T4). `d = IForward(s, o, key)` claims that the scalar local
// `s` holds the current value of slot `key` of the object `o`. The claim is accepted when a backward scan of the SAME block,
// over at most WINDOW instructions, finds an instruction that put that value in `s` before anything could have changed it:
//   the source:   the first instruction that touches the slot (o, key) is a load into s (IGetField, IArrayGet / IArrayGetU, or an
//                 IForward that was itself checked) or a store of s (ISetField / IArraySet / IArraySetU with the value `OLocal(s)`);
//   no change:    on the way back there is no definition of s, o or the key local, no write that may hit the slot (the same
//                 slot, or an index that is not provably different), no instruction that grows, shrinks or consumes `o`, and
//                 no instruction that gives `o` to anyone else (calls and builtins included).
// `IMakeUnique(o)` does not end the scan: a shallow copy keeps every slot. A call that does not mention `o` does not end it
// either: a live reference to `o` excludes an in-place write by the callee (an in-place write needs rc == 1; docs/tcb.md).
// Anything this scan does not know about and that mentions `o` ends it. Fail closed: no source found is "not justified".

import { MProgram, MFunction, Instr, Operand, instrLocals } from "../mir";
import { WINDOW, PASS, SOURCE, STOP, isLocal, fieldKey, sameKey, differ, defines, keyDefined } from "./scan";

// A load of slot `at` of the object into `d`: the source when it is our slot and our local, unless the load overwrites
// its own index local (`i = arrayget o[i]`: after it, `o[i]` names another element).
function load(d: usize, s: usize, key: Operand, at: Operand): int {
  if (differ(key, at)) {
    return PASS;
  }
  return sameKey(key, at) && d == s && !isLocal(at, d) ? SOURCE : STOP;
}

// A store of `v` into slot `at` of the object: the source when it is our slot and stores our local.
function store(s: usize, key: Operand, at: Operand, v: Operand): int {
  if (differ(key, at)) {
    return PASS;
  }
  return sameKey(key, at) && isLocal(v, s) ? SOURCE : STOP;
}

// A write (take, put) or an unknown store into slot `at`: harmless only when it is a different slot.
function write(key: Operand, at: Operand): int {
  return differ(key, at) ? PASS : STOP;
}

// The verdict on one instruction of the scan, for the claim (s, o, key).
function verdict(ins: Instr, s: usize, o: usize, key: Operand): int {
  match (ins) {
    IGetField(d, x, k) => {
      if (isLocal(x, o)) {
        return load(d, s, key, fieldKey(k));
      }
    },
    IGetFieldU(d, x, k) => {
      if (isLocal(x, o)) {
        return load(d, s, key, fieldKey(k));
      }
    },
    IArrayGet(d, x, i) => {
      if (isLocal(x, o)) {
        return load(d, s, key, i);
      }
    },
    IArrayGetU(d, x, i) => {
      if (isLocal(x, o)) {
        return load(d, s, key, i);
      }
    },
    IForward(d, _, x, i) => {
      if (isLocal(x, o)) {
        return load(d, s, key, i);
      }
    },
    ISetField(x, k, v) => {
      if (x == o) {
        return store(s, key, fieldKey(k), v);
      }
    },
    ISetFieldU(x, k, v) => {
      if (x == o) {
        return store(s, key, fieldKey(k), v);
      }
    },
    IArraySet(x, i, v) => {
      if (x == o) {
        return store(s, key, i, v);
      }
    },
    IArraySetU(x, i, v) => {
      if (x == o) {
        return store(s, key, i, v);
      }
    },
    ITakeField(_, x, k) => {
      if (x == o) {
        return write(key, fieldKey(k));
      }
    },
    IPutField(x, k, _) => {
      if (x == o) {
        return write(key, fieldKey(k));
      }
    },
    IArrayTake(_, x, i) => {
      if (x == o) {
        return write(key, i);
      }
    },
    IArrayPut(x, i, _) => {
      if (x == o) {
        return write(key, i);
      }
    },
    IMakeUnique(x) => {
      if (x == o) {
        return PASS;
      }
    },
    IShapeCheck(x, _) => {
      if (x == o) {
        return PASS;
      }
    },
    ITag(_, x) => {
      if (isLocal(x, o)) {
        return PASS;
      }
    },
    IBorrow(_, x) => {
      if (x == o) {
        return PASS;
      }
    },
    IDup(_, x) => {
      if (isLocal(x, o)) {
        return PASS;
      }
    },
    _ => {},
  }
  // everything else: harmless unless it mentions `o` (a call or builtin that receives it, a push / pop / extend, a move,
  // a release, a consuming constructor ...)
  return instrLocals(ins).includes(o) ? STOP : PASS;
}

// Rule F1: is `IForward(_, s, OLocal(o) , key)` at position `at` of block `blk` of `f` justified?
export function forwardJustified(
  p: MProgram,
  f: MFunction,
  blk: usize,
  at: usize,
  s: usize,
  x: Operand,
  key: Operand,
): bool {
  match (x) {
    OLocal(o) => {
      const instrs = f.blocks[blk].instrs;
      let i = at;
      let n: usize = 0;
      while (i > 0 && n < WINDOW) {
        i -= 1;
        n += 1;
        const ins = instrs[i];
        const v = verdict(ins, s, o, key);
        if (v == SOURCE) {
          return true;
        }
        if (v == STOP || defines(p, ins, s) || defines(p, ins, o) || keyDefined(p, ins, key)) {
          return false;
        }
      }
      return false;
    },
    _ => {
      return false;
    },
  }
}
