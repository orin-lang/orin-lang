// Abstract domain of the OIM ownership verifier (docs/mir.md, "Abstract ownership state"): one packed local state (`int`, see `mk`) per local plus a
// set of open holes, held by the class `State`. The join is a semilattice join (commutative, idempotent, an upper bound
// in the order `lsLeq`), so the fixpoint iteration in verify.or terminates: in-states only ever grow, and the lattice is
// finite.

import { MFunction, noSpan, hasSpan, spanAt } from "../mir";
import { Span } from "../diag";

// `span` is the source position of the offending instruction (block `block`, instruction `instr`; `instr` equal to the
// block's instruction count is the terminator) as recorded by the lowering (docs/mir.md v2.0); `noSpan()` when the MIR
// has no source positions (hand-written MIR) or the issue is not about one instruction.
export type VerifyIssue = {
  func: string;
  block: usize;
  instr: usize;
  message: string;
  span: Span;
};

// The span of instruction `i` of block `b` of `f`, or `noSpan()` when that position does not exist.
@Ensures(!(b < f.blocks.length && i <= f.blocks[b].instrs.length) ==> !hasSpan(result))
export function issueSpan(f: MFunction, b: usize, i: usize): Span {
  if (b < f.blocks.length && i <= f.blocks[b].instrs.length) {
    return spanAt(f.blocks[b], i);
  }
  return noSpan();
}

// Two spans are the same position.
export function sameSpan(a: Span, b: Span): bool {
  return a.file == b.file && a.start == b.start && a.end == b.end;
}

// Kinds of local state. Imm = immortal reference (OStr copy, INullary): readable, consumable,
// releasable, never a leak. Init = initialised scalar. MaybeLeak / MaybeDead are the poisoned
// results of a join that disagrees (MaybeLeak: some path still owns a reference); any use of a
// poisoned local is an error, a redefinition silently repairs it.
export const KDead: int = 0;
export const KOwned: int = 1;
export const KUnique: int = 2;
export const KImm: int = 3;
export const KBorrowed: int = 4;
export const KParam: int = 5;
export const KInit: int = 6;
export const KMaybeLeak: int = 7;
export const KMaybeDead: int = 8;
// Resource handles (v1.8, ADR-0025). KOpen: this function opened the file and must close it exactly once on every
// path before it returns. A handle that is a parameter is KParam (borrowed for the whole call, never closed here).
// KMaybeOpen is the poisoned join of an open and a not-open handle (an error to use, close or return with).
export const KOpen: int = 9;
export const KMaybeOpen: int = 10;

// One of the eleven kinds above.
@Ensures(result == (k >= KDead && k <= KMaybeOpen))
export function isKind(k: int): bool {
  return k >= KDead && k <= KMaybeOpen;
}

// A local in this state may be read: neither dead nor poisoned by a join.
@Ensures(result == (k == KOwned || k == KUnique || k == KImm || k == KBorrowed || k == KParam || k == KInit || k == KOpen))
export function isLive(k: int): bool {
  return k == KOwned
      || k == KUnique
      || k == KImm
      || k == KBorrowed
      || k == KParam
      || k == KInit
      || k == KOpen;
}

// The state of one local, packed into one int: `kind + 16 * src` (`mk`, `lsKind`, `lsSrc`). `src` is meaningful only
// for KBorrowed (the root local the alias depends on); otherwise 0. Arrays of these (`State.ls`) are scalar arrays: a
// record per local would be one heap object per entry (4.1M of them, and 74 % of all reference-count operations, in a
// self-compile) and every copy of the array would retain each entry.
@Ensures(result == (p >= 0 && isKind(p % 16) && (p % 16 == KBorrowed || p / 16 == 0)))
export function isLs(p: int): bool {
  return p >= 0 && isKind(p % 16) && (p % 16 == KBorrowed || p / 16 == 0);
}

@Requires(isKind(k) && (k == KBorrowed || src == 0))
@Requires(src <= 576460752303423488)
@Ensures(isLs(result) && lsKind(result) == k && lsSrc(result) == src)
export function mk(k: int, src: usize): int {
  return src.toInt() * 16 + k;
}

// The kind of a packed local state.
@Requires(isLs(p))
@Ensures(isKind(result))
@Ensures(result == p % 16)
export function lsKind(p: int): int {
  return p % 16;
}

// The root of a packed local state (0 unless it is KBorrowed).
@Requires(isLs(p))
@Ensures(result == (p / 16).toUsize())
export function lsSrc(p: int): usize {
  return (p / 16).toUsize();
}

@Ensures(result == (k == KOwned || k == KUnique || k == KImm))
export function ownedLike(k: int): bool {
  return k == KOwned || k == KUnique || k == KImm;
}

// A local in this state may still hold a counted reference (Imm is immortal: not a leak).
@Ensures(result == (k == KOwned || k == KUnique || k == KMaybeLeak))
export function leaky(k: int): bool {
  return k == KOwned || k == KUnique || k == KMaybeLeak;
}

@Requires(isKind(k))
export function kindName(k: int): string {
  if (k == KDead) {
    return "Dead";
  }
  if (k == KOwned) {
    return "Owned";
  }
  if (k == KUnique) {
    return "Unique";
  }
  if (k == KImm) {
    return "Imm";
  }
  if (k == KBorrowed) {
    return "Borrowed";
  }
  if (k == KParam) {
    return "Param";
  }
  if (k == KInit) {
    return "Init";
  }
  if (k == KMaybeLeak) {
    return "MaybeDead(owned on some path)";
  }
  if (k == KOpen) {
    return "Open";
  }
  if (k == KMaybeOpen) {
    return "MaybeOpen";
  }
  return "MaybeDead";
}

@Ensures(result == (a == b))
export function lsEq(a: int, b: int): bool {
  return a == b;
}

// The order of the per-local lattice, stated independently of `joinLs`: equal states; Unique and Imm below Owned; the
// states that hold no counted reference below MaybeDead; everything that is not a handle below MaybeLeak; everything
// below MaybeOpen (the top).
@Requires(isLs(a) && isLs(b))
export function lsLeq(a: int, b: int): bool {
  const ak = lsKind(a);
  const bk = lsKind(b);
  if (a == b || bk == KMaybeOpen) {
    return true;
  }
  if (bk == KMaybeLeak) {
    return ak != KOpen && ak != KMaybeOpen;
  }
  if (bk == KOwned) {
    return ak == KUnique || ak == KImm;
  }
  if (bk == KMaybeDead) {
    return ak == KDead || ak == KImm || ak == KBorrowed || ak == KParam || ak == KInit;
  }
  return false;
}

// Join of two per-local states. Owned-like states join to Owned (Unique/Imm information is
// lost); identical states are kept; anything else is poisoned.
@Requires(isLs(a) && isLs(b))
@Ensures(isLs(result))
@Ensures(lsEq(result, joinLs(b, a)))
@Ensures(lsEq(a, b) ==> lsEq(result, a))
@Ensures(lsLeq(a, result) && lsLeq(b, result))
@Ensures(lsKind(result) == KBorrowed ==> lsEq(a, b))
export function joinLs(a: int, b: int): int {
  if (a == b) {
    return a;
  }
  const ak = lsKind(a);
  const bk = lsKind(b);
  if (ownedLike(ak) && ownedLike(bk)) {
    return mk(KOwned, 0);
  }
  if (ak == KOpen || ak == KMaybeOpen || bk == KOpen || bk == KMaybeOpen) {
    return mk(KMaybeOpen, 0);
  }
  if (leaky(ak) || leaky(bk)) {
    return mk(KMaybeLeak, 0);
  }
  return mk(KMaybeDead, 0);
}

// ---------------------------------------------------------------- holes

// A taken slot of local `obj`. Field slots and constant array indices are (sym=false, idx=slot);
// an array index held in a usize local l is the symbolic key (sym=true, idx=l).
export type HoleEntry = { obj: usize; sym: bool; idx: usize; };

// The slot part of a hole: a field slot / constant index, or a symbolic index local.
export type HoleKey = { sym: bool; idx: usize; };

export function holeEq(a: HoleEntry, b: HoleEntry): bool {
  return a.obj == b.obj && a.sym == b.sym && a.idx == b.idx;
}

export function holeIn(h: HoleEntry, hs: HoleEntry[]): bool {
  return hs.some(x => holeEq(x, h));
}

// Equal as sets when neither has repeated entries (a repeated hole is only created by a `take` that is reported as an
// error).
@Ensures(result ==> a.length == b.length)
export function holesEq(a: HoleEntry[], b: HoleEntry[]): bool {
  return a.length == b.length && a.every(h => holeIn(h, b));
}

// Every hole names a local below `n`, and so does every symbolic index.
@Ensures(hs.length == 0 ==> result)
export function holesInRange(hs: HoleEntry[], n: usize): bool {
  return hs.every(h => h.obj < n && (!h.sym || h.idx < n));
}

// Some slot of `x` is taken.
export function holeAnyIn(hs: HoleEntry[], x: usize): bool {
  return hs.some(h => h.obj == x);
}

// Exactly the slot `k` of `x` is taken.
export function holeHasIn(hs: HoleEntry[], x: usize, k: HoleKey): bool {
  return hs.some(h => h.obj == x && h.sym == k.sym && h.idx == k.idx);
}

// Slot `k` of `x` may be taken: an equal key, or either key is symbolic (conservative).
@Ensures(holeHasIn(hs, x, k) ==> result)
export function holeMayIn(hs: HoleEntry[], x: usize, k: HoleKey): bool {
  return hs.some(h => h.obj == x && (h.sym || k.sym || h.idx == k.idx));
}

// Borrows are flat: a borrowed local depends on another local that is not itself borrowed. `rootOf` (rules.or) and the
// single `killBorrows(x)` per release rely on it.
@Requires(ls.every(p => isLs(p)))
export function borrowsFlatIn(ls: int[]): bool {
  let i: usize = 0;
  @Invariant(i <= ls.length)
  while (i < ls.length) {
    const s = ls[i];
    if (lsKind(s) == KBorrowed) {
      const r = lsSrc(s);
      if (r >= ls.length || r == i || lsKind(ls[r]) == KBorrowed) {
        return false;
      }
    }
    i += 1;
  }
  return true;
}

// ---------------------------------------------------------------- the state at one program point

// The abstract state at one program point, a value of the lattice: `ls[l]` is the state of local `l` (one entry per
// local of the function) and `holes` the slots that are taken. Every hole names a local of the function. Borrows are flat
// (`borrowsFlat`); the transfer functions keep this (rules.or). The fixpoint stores one per block and joins them; the
// transfer functions work on the two arrays directly (class `Transfer`), because a mutating method called on a
// class-typed field copies the object and its arrays (docs/rewrite.md, step 3b).
@Invariant(this.ls.every(p => isLs(p)))
@Invariant(holesInRange(this.holes, this.ls.length))
export class State {
  ls: int[];
  holes: HoleEntry[];

  constructor(ls: int[], holes: HoleEntry[]) {
    this.ls = ls;
    this.holes = holes;
  }

  // Number of locals.
  @Ensures(result == this.ls.length)
  size(): usize {
    return this.ls.length;
  }

  @Requires(l < this.ls.length)
  kind(l: usize): int {
    return lsKind(this.ls[l]);
  }

  // The root of a borrowed local (0 for any other state).
  @Requires(l < this.ls.length)
  srcOf(l: usize): usize {
    return lsSrc(this.ls[l]);
  }

  // Some slot of `x` is taken.
  holeAny(x: usize): bool {
    return holeAnyIn(this.holes, x);
  }

  // Exactly the slot `k` of `x` is taken.
  holeHas(x: usize, k: HoleKey): bool {
    return holeHasIn(this.holes, x, k);
  }

  // Slot `k` of `x` may be taken.
  holeMay(x: usize, k: HoleKey): bool {
    return holeMayIn(this.holes, x, k);
  }

  // Below `o` in the lattice: every local's state is below its state in `o`, and every hole of this is a hole of `o`.
  leq(o: State): bool {
    if (o.ls.length != this.ls.length) {
      return false;
    }
    let i: usize = 0;
    while (i < this.ls.length) {
      if (!lsLeq(this.ls[i], o.ls[i])) {
        return false;
      }
      i += 1;
    }
    return this.holes.every(h => holeIn(h, o.holes));
  }

  // A borrowed local depends on another local that is not itself borrowed.
  borrowsFlat(): bool {
    return borrowsFlatIn(this.ls);
  }

  // The join of two states of the same function: per local `joinLs`, the hole sets united (the mismatch itself is
  // reported per edge by verify.or). An upper bound of both.
  @Requires(o.ls.length == this.ls.length)
  @Ensures(result.ls.length == this.ls.length)
  @Ensures(this.leq(result) && o.leq(result))
  @Ensures(result.holes.length <= this.holes.length + o.holes.length)
  join(o: State): State {
    let ls: int[] = [];
    let i: usize = 0;
    while (i < this.ls.length) {
      ls.push(joinLs(this.ls[i], o.ls[i]));
      i += 1;
    }
    let holes = this.holes;
    for (const h of o.holes) {
      if (!holeIn(h, holes)) {
        holes.push(h);
      }
    }
    return new State(ls, holes);
  }

  // The join with `o`, or None when it equals this state: nothing is allocated in that (common) case. The fixpoint's
  // update step (from the performance branch's `joinChanged`, verdicts unchanged).
  @Requires(o.ls.length == this.ls.length)
  @Ensures(result.isNone() == this.join(o).equals(this))
  @Ensures(result.isSome() ==> result.unwrap().equals(this.join(o)))
  joinIfChanged(o: State): Option<State> {
    let changed = false;
    let i: usize = 0;
    while (i < this.ls.length && !changed) {
      if (joinLs(this.ls[i], o.ls[i]) != this.ls[i]) {
        changed = true;
      }
      i += 1;
    }
    if (!changed) {
      changed = !o.holes.every(h => holeIn(h, this.holes));
    }
    if (!changed) {
      return None;
    }
    return Some(this.join(o));
  }

  // The same state (the fixpoint's termination test).
  @Requires(o.ls.length == this.ls.length)
  @Ensures(result ==> this.leq(o))
  equals(o: State): bool {
    let i: usize = 0;
    while (i < this.ls.length) {
      if (this.ls[i] != o.ls[i]) {
        return false;
      }
      i += 1;
    }
    return holesEq(this.holes, o.holes);
  }
}

// `st`, or the state of `n` dead locals when there is none (a block that is not reached): lets a caller replay a block
// with one `Transfer` and skip it when `st` was `None`.
@Requires(st.isSome() ==> (st.unwrap().ls.length == n && st.unwrap().holes.length == 0))
@Ensures(result.ls.length == n && result.holes.length == 0)
export function stateOrDead(st: Option<State>, n: usize): State {
  match (st) {
    Some(s) => {
      return s;
    },
    None => {
      let ls: int[] = [];
      let i: usize = 0;
      while (i < n) {
        ls.push(mk(KDead, 0));
        i += 1;
      }
      return new State(ls, []);
    },
  }
}
