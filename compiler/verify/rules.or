// Transfer functions of the ownership verifier: one rule per MIR instruction / terminator, a direct transcription of
// docs/mir.md, as the methods of class `Transfer` (the state of one run through a block: position, abstract state,
// issues found). Input is well-formed (wf.or). Errors and warnings are appended; after an error the state is updated as
// if the rule had succeeded where that is meaningful, so one mistake does not cascade.

import { MProgram, MFunction, Operand, Instr, Terminator, dstOf } from "../mir";
import { Builtin, taskOpOpensFrom, taskOpAdopts, taskOpMoves } from "../hir";
import {
  VerifyIssue, issueSpan, sameSpan, State, HoleEntry, HoleKey, mk, isKind, ownedLike, leaky,
  isLive, lsEq, lsKind, lsSrc, holeAnyIn, holeHasIn, holeMayIn, holesInRange, borrowsFlatIn, kindName, KDead,
  KOwned, KUnique, KImm, KBorrowed, KParam, KInit, KMaybeLeak, KMaybeDead, KOpen, KMaybeOpen,
} from "./state";
import { CRef, CHandle, localClass, wfInstr, wfTerm, opLocalOk } from "./wf";
import { forwardJustified } from "./forward";

// One step of the replay used by the optimiser (compiler/opt/calls.or): the position, the state before the
// instruction and the issues so far. `step` runs one instruction on it.
export type Cx = {
  prog: MProgram;
  f: MFunction;
  blk: usize;
  ins: usize;
  st: State;
  errs: VerifyIssue[];
  warns: VerifyIssue[];
};

// ------------------------------------------------------------------ contract helpers

// The issues `is[start..]` all name instruction `ins` of block `b` of `f` (function, position and its span).
export function issuesAt(
  is: VerifyIssue[],
  start: usize,
  f: MFunction,
  b: usize,
  ins: usize,
): bool {
  const sp = issueSpan(f, b, ins);
  return is
      .slice(start, is.length)
      .every(e => e.func == f.name && e.block == b && e.instr == ins && sameSpan(e.span, sp));
}

// Only a defining instruction revives a local: every local that was not live before (dead or poisoned) and is not one
// of the locals the instruction defines (`defs`) is in exactly the same state after.
export function noRevival(before: int[], after: int[], defs: usize[]): bool {
  if (before.length != after.length) {
    return false;
  }
  let i: usize = 0;
  while (i < before.length) {
    if (!isLive(lsKind(before[i])) && !lsEq(before[i], after[i]) && !defs.includes(i)) {
      return false;
    }
    i += 1;
  }
  return true;
}

// The locals instruction `ins` defines: its destination, and for a call of an in/out function (v1.10) the in/out
// argument, which receives the callee's final receiver.
export function defsOf(p: MProgram, ins: Instr): usize[] {
  let out: usize[] = match (dstOf(ins)) {
    Some(d) => [d],
    None => [],
  };
  match (ins) {
    ICall(_, g, args) => {
      if (g < p.functions.length && p.functions[g].inout && args.length > 0) {
        match (args[0]) {
          OLocal(x) => {
            out.push(x);
          },
          _ => {},
        }
      }
    },
    _ => {},
  }
  return out;
}

// No alias is rooted at a Dead or scalar local: every way a local dies invalidates its aliases first, and a scalar is
// never a root. `def` relies on it to skip the alias scan.
export function rootsLive(ls: int[]): bool {
  return ls.every(
    s => lsKind(s) != KBorrowed
        || lsSrc(s) >= ls.length
        || lsKind(ls[lsSrc(s)]) != KDead && lsKind(ls[lsSrc(s)]) != KInit,
  );
}

function slotKey(i: usize): HoleKey {
  return HoleKey { sym: false, idx: i };
}

function holeKey(o: Operand): HoleKey {
  return match (o) {
    OLocal(l) => HoleKey { sym: true, idx: l },
    OUsize(n) => HoleKey { sym: false, idx: n >= 0 ? n.toUsize() : 0 },
    _ => HoleKey { sym: false, idx: 0 },
  };
}

// ------------------------------------------------------------------ the transfer state

// The state of one run through block `blk` of `f`: the instruction `ins` it is at (the block's instruction count is the
// terminator), the abstract state (`ls`, one entry per local of `f`, and the open `holes`; `state()` is it as a `State`)
// and the issues found so far. The state arrays are fields of the class itself, not a `State` field: a mutating method
// called on a class-typed field copies that object and its arrays on every call (measured: twice as many copies as the
// old record code and +20 % self-compile time), while a write to `this.ls[l]` is done in place.
@Invariant(this.ls.length == this.f.locals.length)
@Invariant(holesInRange(this.holes, this.ls.length))
@Invariant(this.blk < this.f.blocks.length && this.ins <= this.f.blocks[this.blk].instrs.length)
export class Transfer {
  prog: MProgram;
  f: MFunction;
  blk: usize;
  ins: usize;
  ls: int[];
  holes: HoleEntry[];
  errs: VerifyIssue[];
  warns: VerifyIssue[];

  constructor(
    prog: MProgram,
    f: MFunction,
    blk: usize,
    ins: usize,
    st: State,
    errs: VerifyIssue[],
    warns: VerifyIssue[],
  ) {
    this.prog = prog;
    this.f = f;
    this.blk = blk;
    this.ins = ins;
    this.ls = st.ls;
    this.holes = st.holes;
    this.errs = errs;
    this.warns = warns;
  }

  // Restarts the replay at the beginning of block `b` from the state (`ls`, `holes`): the entries of `ls` are copied
  // into this run's own array (one buffer serves every block run of a fixpoint, instead of an array shared with the
  // in-state that the first write would copy), the issues found so far are kept.
  @Requires(b < this.f.blocks.length && ls.length == this.ls.length && holesInRange(holes, ls.length))
  @Ensures(this.ins == 0 && this.blk == b && this.ls.length == old(this.ls.length))
  load(b: usize, ls: int[], holes: HoleEntry[]): void {
    this.blk = b;
    this.ins = 0;
    let i: usize = 0;
    @Invariant(i <= ls.length && this.ls.length == ls.length)
    while (i < ls.length) {
      this.ls[i] = ls[i];
      i += 1;
    }
    this.holes = holes;
  }

  // The abstract state after the instructions run so far.
  @Ensures(result.ls.length == this.ls.length)
  state(): State {
    return new State(this.ls, this.holes);
  }

  // Runs the whole block from the state it holds: every instruction, then the terminator. Borrows stay flat.
  @Requires(borrowsFlatIn(this.ls) && rootsLive(this.ls))
  @Ensures(borrowsFlatIn(this.ls) && rootsLive(this.ls))
  @Ensures(this.ins == this.f.blocks[this.blk].instrs.length)
  @Ensures(this.errs.length >= old(this.errs.length) && this.warns.length >= old(this.warns.length))
  run(): void {
    const blk = this.f.blocks[this.blk];
    let i: usize = 0;
    while (i < blk.instrs.length) {
      this.ins = i;
      this.step(blk.instrs[i]);
      i += 1;
    }
    this.ins = blk.instrs.length;
    this.term(blk.term);
  }

  // The rule of instruction `ins` (the one at position `this.ins`). Issues are reported at this position; no local that
  // is dead or poisoned comes back to life unless the instruction defines it.
  @Requires(this.ins < this.f.blocks[this.blk].instrs.length)
  @Requires(wfInstr(this.prog, this.f, ins) == "")
  @Ensures(this.ins == old(this.ins))
  @Ensures(noRevival(old(this.ls), this.ls, defsOf(this.prog, ins)))
  @Ensures(this.errs.length >= old(this.errs.length) && this.warns.length >= old(this.warns.length))
  @Ensures(issuesAt(this.errs, old(this.errs.length), this.f, this.blk, this.ins))
  @Ensures(issuesAt(this.warns, old(this.warns.length), this.f, this.blk, this.ins))
  step(ins: Instr): void {
    this.instr(ins);
  }

  // The rule of the block's terminator `t`. A return leaves no handle open and no hole (errors) and warns about every
  // local that may still own a reference.
  @Requires(this.ins == this.f.blocks[this.blk].instrs.length)
  @Requires(wfTerm(this.prog, this.f, t) == "")
  @Ensures(this.ins == old(this.ins))
  @Ensures(noRevival(old(this.ls), this.ls, []))
  @Ensures(issuesAt(this.errs, old(this.errs.length), this.f, this.blk, this.ins))
  @Ensures(issuesAt(this.warns, old(this.warns.length), this.f, this.blk, this.ins))
  term(t: Terminator): void {
    match (t) {
      TGoto(_) => {},
      TBranch(o, _, _) => {
        this.readOp(o);
      },
      TSwitch(o, _, _) => {
        this.readOp(o);
      },
      TReturn(r) => {
        if (this.f.uniqueOut) {
          this.uniqueReturn(r);
        }
        match (r) {
          Some(o) => {
            this.consume(o);
          },
          None => {},
        }
        if (this.f.inout) {
          // v1.10: local 0 is handed back to the caller, so it must hold an owned receiver here
          if (ownedLike(this.kindOf(0))) {
            this.consume(OLocal(0));
          } else {
            this.err(
              "inout parameter " + this.nm(0)
                  + " must hold the updated receiver at return, but it is "
                  + kindName(this.kindOf(0)),
            );
          }
        }
        let i: usize = 0;
        while (i < this.ls.length) {
          const k = lsKind(this.ls[i]);
          if (leaky(k)) {
            this.warn("leak: " + this.nm(i) + " may still own a reference at return");
          }
          if (k == KOpen || k == KMaybeOpen) {
            this.err(
              "resource handle " + this.nm(i)
                  + " is not closed on this path: every opened file must be closed before the function returns",
            );
          }
          i += 1;
        }
        for (const h of this.holes) {
          this.err("return with an open hole in " + this.nm(h.obj));
        }
      },
      TTrap(_) => {},
    }
  }

  // `kindName` for a kind that is known to be one (the contract of `kindName`), a placeholder otherwise.
  private kindText(k: int): string {
    return isKind(k) ? kindName(k) : "?";
  }

  // Rule U3 (v2.7): a `unique-out` function hands back a Unique value at this return: local 0 for an inout function, the
  // returned local otherwise. Checked before the return consumes it.
  private uniqueReturn(r: Option<Operand>): void {
    if (this.f.inout) {
      if (this.kindOf(0) != KUnique) {
        this.err(
          "unique-out function returns its receiver " + this.nm(0) + " as " + this.kindText(this.kindOf(0))
              + ", not Unique (rule U3)",
        );
      }
      return;
    }
    let ok = false;
    match (r) {
      Some(o) => {
        match (o) {
          OLocal(l) => {
            ok = true;
            if (this.kindOf(l) != KUnique) {
              this.err(
                "unique-out function returns " + this.nm(l) + " as " + this.kindText(this.kindOf(l)) + ", not Unique (rule U3)",
              );
            }
          },
          _ => {},
        }
      },
      None => {},
    }
    if (!ok) {
      this.err("unique-out function returns a value that is not a local, so it is not Unique (rule U3)");
    }
  }

  // ---------------------------------------------------------------- the state arrays

  // Local `l` is now in state (k, src). A borrow is rooted at another local.
  @Requires(l < this.ls.length && isKind(k))
  @Requires(k == KBorrowed ? src < this.ls.length && src != l : src == 0)
  private set(l: usize, k: int, src: usize): void {
    this.ls[l] = mk(k, src);
  }

  // Every `Borrowed(x)` alias dies (x is released, moved, consumed, mutated or redefined). Nothing else changes.
  @Requires(x < this.ls.length)
  @Ensures(this.ls.length == old(this.ls.length))
  @Ensures(this.ls.every(s => !(lsKind(s) == KBorrowed && lsSrc(s) == x)))
  private killBorrows(x: usize): void {
    let i: usize = 0;
    while (i < this.ls.length) {
      const s = this.ls[i];
      if (lsKind(s) == KBorrowed && lsSrc(s) == x) {
        this.ls[i] = mk(KDead, 0);
      }
      i += 1;
    }
  }

  @Requires(x < this.ls.length && (!k.sym || k.idx < this.ls.length))
  @Ensures(this.holes.length == old(this.holes.length) + 1 && holeHasIn(this.holes, x, k))
  private addHole(x: usize, k: HoleKey): void {
    this.holes.push(HoleEntry { obj: x, sym: k.sym, idx: k.idx });
  }

  @Ensures(!holeHasIn(this.holes, x, k) && this.holes.length <= old(this.holes.length))
  private removeHole(x: usize, k: HoleKey): void {
    this.holes = this.holes.filter(h => !(h.obj == x && h.sym == k.sym && h.idx == k.idx));
  }

  @Ensures(!holeAnyIn(this.holes, x) && this.holes.length <= old(this.holes.length))
  private dropHolesOf(x: usize): void {
    this.holes = this.holes.filter(h => h.obj != x);
  }

  // ---------------------------------------------------------------- reporting and basics

  private err(msg: string): void {
    this.errs.push(VerifyIssue {
      func: this.f.name,
      block: this.blk,
      instr: this.ins,
      message: msg,
      span: issueSpan(this.f, this.blk, this.ins),
    });
  }

  private warn(msg: string): void {
    this.warns.push(VerifyIssue {
      func: this.f.name,
      block: this.blk,
      instr: this.ins,
      message: msg,
      span: issueSpan(this.f, this.blk, this.ins),
    });
  }

  private nm(l: usize): string {
    return "`" + this.f.locals[l].name + "`";
  }

  private kindOf(l: usize): int {
    return lsKind(this.ls[l]);
  }

  @Requires(l < this.f.locals.length)
  private isRefLocal(l: usize): bool {
    return localClass(this.f, l) == CRef;
  }

  // ---------------------------------------------------------------- reads, kills, definitions

  // "read x requires x not Dead" (also rejects poisoned join results).
  private readLocal(l: usize): void {
    const k = this.kindOf(l);
    if (k == KDead) {
      this.err(
        "use of " + this.nm(l) + " which is dead (uninitialised, moved, released or invalidated)",
      );
    } else if (k == KMaybeDead || k == KMaybeLeak) {
      this.err("use of " + this.nm(l) + " which is dead or inconsistent on some incoming path");
    } else if (k == KMaybeOpen) {
      this.err(
        "use of resource handle " + this.nm(l)
            + " which is open on some incoming paths and closed (or never opened) on others",
      );
    }
  }

  // Whole-object use of a local: live, and no slot may be missing.
  private readWhole(l: usize): void {
    this.readLocal(l);
    if (this.isRefLocal(l) && holeAnyIn(this.holes, l)) {
      this.err("whole-object use of " + this.nm(l) + " while a slot is taken (open hole)");
    }
  }

  private readOp(o: Operand): void {
    match (o) {
      OLocal(l) => {
        this.readWhole(l);
      },
      _ => {},
    }
  }

  private readAll(os: Operand[]): void {
    for (const o of os) {
      this.readOp(o);
    }
  }

  // An Owned/Unique/Imm local is fine (whole-object use); anything else is the matching error.
  private needOwned(l: usize, what: string): void {
    const k = this.kindOf(l);
    if (ownedLike(k)) {
      this.readWhole(l);
    } else if (k == KParam) {
      this.err(
        what + " of parameter " + this.nm(l)
            + " (borrowed parameters are borrowed for the whole call)",
      );
    } else if (k == KBorrowed) {
      this.err(what + " of borrowed " + this.nm(l));
    } else {
      this.readLocal(l);
    }
  }

  private needUnique(l: usize, what: string): void {
    const k = this.kindOf(l);
    if (k == KUnique) {
      return;
    }
    if (k == KDead || k == KMaybeDead || k == KMaybeLeak) {
      this.readLocal(l);
    } else {
      this.err(what + " requires " + this.nm(l) + " to be Unique, but it is " + kindName(k));
    }
  }

  // Owned-like local ceases to exist (released or consumed): Dead, borrows invalidated.
  @Requires(l < this.ls.length)
  private kill(l: usize): void {
    this.killBorrows(l);
    this.set(l, KDead, 0);
  }

  // Consume an operand (ref slots of IStructNew, stored values, pushed values, returned values).
  // Scalars are merely read; OStr is immortal.
  @Requires(opLocalOk(this.f, o))
  private consume(o: Operand): void {
    match (o) {
      OLocal(l) => {
        if (!this.isRefLocal(l)) {
          this.readLocal(l);
          return;
        }
        const k = this.kindOf(l);
        const before = this.errs.length;
        this.needOwned(l, "consuming");
        if (ownedLike(k) && this.errs.length == before) {
          this.kill(l);
        }
      },
      _ => {},
    }
  }

  private consumeAll(os: Operand[]): void {
    for (const o of os) {
      this.consume(o);
    }
  }

  // Define local d (every destination goes through here).
  private def(d: usize, k: int, src: usize): void {
    if (d < this.f.paramCount && !(this.f.inout && d == 0)) {
      this.err("write to parameter " + this.nm(d));
      return;
    }
    if (leaky(this.kindOf(d))) {
      this.warn("leak: " + this.nm(d) + " is overwritten while it may still own a reference");
    }
    if (holeAnyIn(this.holes, d)) {
      this.err(this.nm(d) + " is overwritten while a slot is taken (open hole)");
      this.dropHolesOf(d);
    }
    if (this.holes.length > 0) {
      for (const h of this.holes) {
        if (h.sym && h.idx == d) {
          this.err("index local " + this.nm(d) + " is overwritten while it names an open hole");
        }
      }
    }
    // No alias is rooted at a Dead or scalar local (`rootsLive`, a precondition of `run`): every way a local dies runs
    // `killBorrows` first, and a scalar is never a root. Defining one has nothing to invalidate, so the scan over all
    // locals (the verifier's hottest loop) is skipped.
    const kd = this.kindOf(d);
    if (kd != KDead && kd != KInit) {
      this.killBorrows(d);
    }
    this.set(d, k, src);
  }

  // Destination of a result: Owned for references, initialised for scalars.
  @Requires(d < this.f.locals.length)
  private defResult(d: usize, uniq: bool): void {
    this.def(d, this.isRefLocal(d) ? (uniq ? KUnique : KOwned) : KInit, 0);
  }

  // Root a new borrow of local l depends on: l itself, or l's own root (borrows are flat).
  private rootOf(l: usize): usize {
    const s = this.ls[l];
    return lsKind(s) == KBorrowed ? lsSrc(s) : l;
  }

  // d becomes Borrowed(root). A borrow rooted at its own destination would leave d aliasing an
  // object whose only owner was d's old value (found by the Lean soundness proof; docs/formal.md).
  private defBorrow(d: usize, root: usize): void {
    if (root == d) {
      this.err("borrow into " + this.nm(d) + " rooted at " + this.nm(d) + " itself");
      return;
    }
    this.def(d, KBorrowed, root);
  }

  // A Unique object that is aliased (borrowed whole, duplicated, passed to a call that may
  // return it) is no longer provably unique.
  private demote(l: usize): void {
    if (this.kindOf(l) == KUnique) {
      this.set(l, KOwned, 0);
    }
  }

  private demoteOp(o: Operand): void {
    match (o) {
      OLocal(l) => {
        this.demote(l);
      },
      _ => {},
    }
  }

  // Result of a field/element read: borrowed from the root of `o` (references) or a scalar.
  @Requires(d < this.f.locals.length)
  private defProjection(d: usize, o: Operand): void {
    if (!this.isRefLocal(d)) {
      this.def(d, KInit, 0);
      return;
    }
    match (o) {
      OLocal(l) => {
        this.defBorrow(d, this.rootOf(l));
      },
      _ => {
        this.def(d, KOwned, 0);
      },
    }
  }

  // ---------------------------------------------------------------- calls

  // ICall / IBuiltin: arguments are borrowed for the call; the result is Owned. A reference
  // result may alias an argument, so a Unique argument is demoted (docs/mir.md notes).
  private call(dst: Option<usize>, args: Operand[]): void {
    this.callOwned(dst, args, [], false);
  }

  // v1.2: `owned[i]` (when i < owned.length) marks an operand in an owned-parameter position: it is
  // consumed (Owned/Unique/Imm -> Dead, OStr allowed; Borrowed/Param is an error). Borrowed
  // positions may not alias a consumed operand (the callee could release it while reading the
  // alias). Unique-demotion applies to borrowed positions only.
  private callOwned(dst: Option<usize>, args: Operand[], owned: bool[], uniq: bool): void {
    this.readAll(args);
    let i: usize = 0;
    while (i < args.length) {
      if (i < owned.length && owned[i]) {
        match (args[i]) {
          OLocal(x) => {
            let j: usize = 0;
            while (j < args.length) {
              if (j != i && !(j < owned.length && owned[j])) {
                match (args[j]) {
                  OLocal(y) => {
                    if (y == x || this.kindOf(y) == KBorrowed && lsSrc(this.ls[y]) == x) {
                      this.err(
                        "borrowed argument " + this.nm(y) + " aliases consumed argument "
                            + this.nm(x),
                      );
                    }
                  },
                  _ => {},
                }
              }
              j += 1;
            }
          },
          _ => {},
        }
      }
      i += 1;
    }
    i = 0;
    while (i < args.length) {
      if (i < owned.length && owned[i]) {
        this.consume(args[i]);
      }
      i += 1;
    }
    match (dst) {
      None => {},
      Some(d) => {
        if (this.isRefLocal(d)) {
          i = 0;
          while (i < args.length) {
            if (!(i < owned.length && owned[i])) {
              this.demoteOp(args[i]);
            }
            i += 1;
          }
        }
        this.defResult(d, uniq);
      },
    }
  }

  // ---------------------------------------------------------------- slots and holes

  // Reading slot k of object operand o (IGetField / IArrayGet).
  private project(d: usize, o: Operand, k: HoleKey): void {
    match (o) {
      OLocal(l) => {
        this.readLocal(l);
        if (holeMayIn(this.holes, l, k)) {
          this.err("read of a slot of " + this.nm(l) + " that is (or may be) taken");
        }
      },
      _ => {},
    }
    this.defProjection(d, o);
  }

  // ISetField / IArraySet.
  private store(x: usize, k: HoleKey, v: Operand, what: string): void {
    this.needUnique(x, what);
    if (holeMayIn(this.holes, x, k)) {
      this.err(
        what + " into a slot of " + this.nm(x)
            + " that is (or may be) taken; use the put instruction",
      );
    }
    this.consume(v);
    this.killBorrows(x);
  }

  // ITakeField / IArrayTake.
  private take(d: usize, x: usize, k: HoleKey, what: string): void {
    this.needUnique(x, what);
    if (holeMayIn(this.holes, x, k)) {
      this.err(what + " of a slot of " + this.nm(x) + " that is (or may be) already taken");
    }
    this.killBorrows(x);
    this.addHole(x, k);
    this.def(d, KOwned, 0);
  }

  // IPutField / IArrayPut.
  private put(x: usize, k: HoleKey, s: usize, what: string): void {
    this.needUnique(x, what);
    if (!holeHasIn(this.holes, x, k)) {
      this.err(what + " into a slot of " + this.nm(x) + " that is not a taken slot");
    }
    this.consume(OLocal(s));
    this.removeHole(x, k);
    this.killBorrows(x);
  }

  // IArrayPush / IArrayPop / IStrAppend: x must be owned (not Param/Borrowed); the runtime may
  // reallocate or mutate it, so borrows die and Unique is not kept.
  private mutateOwned(x: usize, what: string): void {
    this.needOwned(x, what);
    this.killBorrows(x);
    if (ownedLike(this.kindOf(x))) {
      this.set(x, KOwned, 0);
    }
  }

  // ---------------------------------------------------------------- resource handles (v1.8, ADR-0025)
  // Lifecycle of a handle local: Dead --BFileOpen--> Open --BFileClose--> Dead. A parameter handle is Param
  // (borrowed): it can be used but not closed. Uses (call arguments, file builtins) need Open or Param.
  // A function must not return while a handle is Open (error, not a warning) and must not overwrite one.

  private openHandle(d: usize, args: Operand[]): void {
    this.readAll(args);
    const k = this.kindOf(d);
    if (k == KOpen || k == KMaybeOpen) {
      this.err(
        "resource handle " + this.nm(d)
            + " is overwritten while it is (or may be) still open: it would never be closed",
      );
    }
    this.def(d, KOpen, 0);
  }

  private closeHandle(dst: Option<usize>, args: Operand[]): void {
    match (args[0]) {
      OLocal(h) => {
        const k = this.kindOf(h);
        if (k == KOpen) {
          this.set(h, KDead, 0);
        } else if (k == KParam) {
          this.err(
            "close of parameter " + this.nm(h)
                + ": a handle is closed only by the scope that opened it",
          );
        } else if (k == KMaybeOpen) {
          this.err(
            "close of " + this.nm(h)
                + " which is not open on some incoming paths (it could be closed twice)",
          );
        } else {
          this.err(
            "close of " + this.nm(h) + " which is not open (already closed, or never opened)",
          );
        }
      },
      _ => {},
    }
    match (dst) {
      None => {},
      Some(d) => {
        this.defResult(d, false);
      },
    }
  }

  // BFileOpen / BGrant*: the destination becomes an Open handle (the authorising first argument is only read: it must
  // be Open or Param).
  private opener(dst: Option<usize>, args: Operand[]): void {
    match (dst) {
      Some(d) => {
        this.openHandle(d, args);
      },
      None => {},
    }
  }

  private builtin(dst: Option<usize>, b: Builtin, args: Operand[]): void {
    match (b) {
      BFileOpen => {
        this.opener(dst, args);
      },
      BGrantFs => {
        this.opener(dst, args);
      },
      BGrantProcess => {
        this.opener(dst, args);
      },
      BGrantStdio => {
        this.opener(dst, args);
      },
      BGrantClock => {
        this.opener(dst, args);
      },
      BGrantUnder => {
        this.opener(dst, args);
      },
      BGrantReadOnly => {
        this.opener(dst, args);
      },
      BGrantArgsOnly => {
        this.opener(dst, args);
      },
      BGrantNet => {
        this.opener(dst, args);
      },
      BGrantListen => {
        this.opener(dst, args);
      },
      BGrantConnect => {
        this.opener(dst, args);
      },
      BNetListen => {
        this.opener(dst, args);
      },
      BNetAccept => {
        this.opener(dst, args);
      },
      BNetConnect => {
        this.opener(dst, args);
      },
      BNetClose => {
        this.readAll(args);
        this.closeHandle(dst, args);
      },
      BTask(k) => {
        // ADR-0017: grantClone derives a handle from a parent (an opener); grantAdopt* makes one from a token (an opener
        // with no authorising handle); grantMove ends one and returns its token (a closer: the handle is moved into a
        // task exactly once on every path, and is dead afterwards).
        if (taskOpOpensFrom(k) || taskOpAdopts(k)) {
          this.opener(dst, args);
        } else if (taskOpMoves(k)) {
          this.readAll(args);
          this.closeHandle(dst, args);
        } else {
          this.call(dst, args);
        }
      },
      BFileClose => {
        this.readAll(args);
        this.closeHandle(dst, args);
      },
      BGrantRevoke => {
        this.readAll(args);
        this.closeHandle(dst, args);
      },
      _ => {
        this.call(dst, args);
      },
    }
  }

  // ---------------------------------------------------------------- instruction rules

  private instr(ins: Instr): void {
    match (ins) {
      ICopy(d, o) => {
        this.readOp(o);
        this.def(d, this.isRefLocal(d) ? KImm : KInit, 0);
      },
      IMove(d, s) => {
        const k = this.kindOf(s);
        this.consume(OLocal(s));
        this.def(d, ownedLike(k) ? k : KOwned, 0);
      },
      IBorrow(d, s) => {
        this.readWhole(s);
        const r = this.rootOf(s);
        this.demote(s);
        this.defBorrow(d, r);
      },
      IDup(d, o) => {
        this.readOp(o);
        this.demoteOp(o);
        this.def(d, KOwned, 0);
      },
      IRelease(x) => {
        const k = this.kindOf(x);
        this.needOwned(x, "release");
        if (ownedLike(k)) {
          this.kill(x);
        }
      },
      IUnary(d, _, o) => {
        this.readOp(o);
        this.def(d, KInit, 0);
      },
      IBinary(d, _, a, b) => {
        this.readOp(a);
        this.readOp(b);
        this.def(d, KInit, 0);
      },
      ICall(dst, fi, args) => {
        // in locals: an argument read from `this.prog` would make the call duplicate the whole receiver
        const po = this.prog.functions[fi].paramOwned;
        const io = this.prog.functions[fi].inout;
        const uin = this.prog.functions[fi].uniqueIn;
        const uout = this.prog.functions[fi].uniqueOut;
        if (uin) {
          // rule U4 (v2.7): the callee starts with a Unique receiver and does not test it, so it must be Unique here
          match (args[0]) {
            OLocal(x) => {
              this.needUnique(x, "call of the unique-in function " + this.prog.functions[fi].name);
            },
            _ => {},
          }
        }
        // rule U5 (v2.7): the result of a `unique-out` function is the only reference to it
        this.callOwned(dst, args, po, uout && !io);
        if (io) {
          // v1.10: argument 0 was consumed; it now holds the callee's final receiver (Owned: the callee may have kept
          // an alias, so uniqueness is not known). Writing a parameter is an error except the in/out parameter of an
          // inout caller (`def`).
          // The callee can keep a counted reference to any borrowed argument in the receiver it hands back, whatever the
          // type of its result (`push(items, item)`), so no borrowed argument stays Unique across an in/out call. For a
          // reference result `callOwned` has demoted them already.
          let k: usize = 1;
          while (k < args.length) {
            if (!(k < po.length && po[k])) {
              this.demoteOp(args[k]);
            }
            k += 1;
          }
          match (args[0]) {
            OLocal(x) => {
              // rule U5 (v2.7): a `unique-out` callee hands back a Unique receiver (U3 checked it in the callee)
              this.def(x, uout ? KUnique : KOwned, 0);
            },
            _ => {},
          }
        }
      },
      IBuiltin(dst, b, args) => {
        this.builtin(dst, b, args);
      },
      IStrAppend(x, y) => {
        this.readOp(y);
        match (y) {
          OLocal(l) => {
            if (this.kindOf(l) == KBorrowed && lsSrc(this.ls[l]) == x) {
              this.err(
                "IStrAppend: " + this.nm(l) + " is borrowed from the string being appended to",
              );
            }
          },
          _ => {},
        }
        this.mutateOwned(x, "IStrAppend");
      },
      IStrPrepend(x, y) => {
        this.readOp(y);
        match (y) {
          OLocal(l) => {
            if (this.kindOf(l) == KBorrowed && lsSrc(this.ls[l]) == x) {
              this.err(
                "IStrPrepend: " + this.nm(l) + " is borrowed from the string being prepended to",
              );
            }
          },
          _ => {},
        }
        this.mutateOwned(x, "IStrPrepend");
      },
      IStrAppendSub(x, y, a, b) => {
        this.readOp(y);
        this.readOp(a);
        this.readOp(b);
        match (y) {
          OLocal(l) => {
            if (this.kindOf(l) == KBorrowed && lsSrc(this.ls[l]) == x) {
              this.err(
                "IStrAppendSub: " + this.nm(l) + " is borrowed from the string being appended to",
              );
            }
          },
          _ => {},
        }
        this.mutateOwned(x, "IStrAppendSub");
      },
      IStrAppendNum(x, y, _) => {
        this.readOp(y);
        this.mutateOwned(x, "IStrAppendNum");
      },
      IArrayExtend(x, y) => {
        this.readOp(y);
        match (y) {
          OLocal(l) => {
            if (this.kindOf(l) == KBorrowed && lsSrc(this.ls[l]) == x) {
              this.err(
                "IArrayExtend: " + this.nm(l) + " is borrowed from the array being extended",
              );
            }
          },
          _ => {},
        }
        this.mutateOwned(x, "IArrayExtend");
      },
      IStructNew(d, _, slots) => {
        // v2.2: an unboxed aggregate is a scalar (its slots are scalars, only read): Init, no ownership
        this.consumeAll(slots);
        this.def(d, this.isRefLocal(d) ? KUnique : KInit, 0);
      },
      INullary(d, _) => {
        this.def(d, this.isRefLocal(d) ? KImm : KInit, 0);
      },

      ITag(d, o) => {
        match (o) {
          OLocal(l) => {
            this.readLocal(l);
          },
          _ => {},
        }
        this.def(d, KInit, 0);
      },
      IGetField(d, o, i) => {
        this.project(d, o, slotKey(i));
      },
      ISetField(x, i, v) => {
        this.store(x, slotKey(i), v, "ISetField");
      },
      IShapeCheck(x, _) => {
        // v2.8, rule U6: a plain read of x that traps on a wrong shape
        this.readLocal(x);
      },
      IGetFieldU(d, o, i) => {
        // v2.8, rule U6 (fieldcheck.or): whether the omitted check is justified is decided per function in verify.or
        // (`fieldFacts`); here the access is an ordinary read
        this.project(d, o, slotKey(i));
      },
      ISetFieldU(x, i, v) => {
        this.store(x, slotKey(i), v, "ISetFieldU");
      },
      ITakeField(d, x, i) => {
        this.take(d, x, slotKey(i), "ITakeField");
      },
      IPutField(x, i, s) => {
        this.put(x, slotKey(i), s, "IPutField");
      },
      IMakeUnique(x) => {
        const k = this.kindOf(x);
        this.needOwned(x, "IMakeUnique");
        this.killBorrows(x);
        if (ownedLike(k)) {
          this.set(x, KUnique, 0);
        }
      },
      IArrayNew(d, _, elems) => {
        this.consumeAll(elems);
        this.def(d, KUnique, 0);
      },
      IArrayGet(d, a, i) => {
        this.readOp(i);
        this.project(d, a, holeKey(i));
      },
      IArraySet(x, i, v) => {
        this.readOp(i);
        this.store(x, holeKey(i), v, "IArraySet");
      },
      IArrayGetU(d, a, i) => {
        // v2.6, rule U1 (unchecked.or, range.or): whether the omitted checks are justified is decided per function in
        // verify.or (`accessFacts`); here the access is an ordinary read
        this.readOp(i);
        this.project(d, a, holeKey(i));
      },
      IArraySetU(x, i, v) => {
        this.readOp(i);
        this.store(x, holeKey(i), v, "IArraySetU");
      },
      IArrayTake(d, x, i) => {
        this.readOp(i);
        this.take(d, x, holeKey(i), "IArrayTake");
      },
      IArrayPut(x, i, s) => {
        this.readOp(i);
        this.put(x, holeKey(i), s, "IArrayPut");
      },
      IArrayPush(x, v) => {
        this.consume(v);
        this.mutateOwned(x, "IArrayPush");
      },
      IArrayPop(d, x) => {
        this.mutateOwned(x, "IArrayPop");
        this.defResult(d, false);
      },
      IForward(d, s, o, k) => {
        // v2.4, rule F1 (forward.or): `s` holds the current value of slot `k` of `o`; `d` is a plain copy of it
        this.readLocal(s);
        this.readOp(k);
        match (o) {
          OLocal(l) => {
            this.readLocal(l);
            if (holeMayIn(this.holes, l, holeKey(k))) {
              this.err("read of a slot of " + this.nm(l) + " that is (or may be) taken");
            }
          },
          _ => {},
        }
        if (!forwardJustified(this.prog, this.f, this.blk, this.ins, s, o, k)) {
          this.err(
            "unjustified forward: no load or store of the same slot reaches it unchanged within the block",
          );
        }
        this.def(d, KInit, 0);
      },
      IClosure(d, _, caps) => {
        this.consumeAll(caps);
        this.def(d, KUnique, 0);
      },
      ICallIndirect(dst, c, args) => {
        this.call(dst, [c].concat(args));
      },
      IIface(d, _, v) => {
        this.consume(v);
        this.def(d, KUnique, 0);
      },
      ICallVirtual(dst, c, _, args) => {
        this.call(dst, [c].concat(args));
      },
    }
  }
}

// One instruction on a replay context (the optimiser's interface, compiler/opt/calls.or): the context after `ins`.
@Requires(cx.blk < cx.f.blocks.length && cx.ins < cx.f.blocks[cx.blk].instrs.length)
@Requires(cx.st.ls.length == cx.f.locals.length)
@Ensures(result.blk == cx.blk && result.ins == cx.ins && result.st.ls.length == cx.st.ls.length)
@Ensures(result.errs.length >= cx.errs.length && result.warns.length >= cx.warns.length)
export function step(cx: Cx, ins: Instr): Cx {
  let t = new Transfer(cx.prog, cx.f, cx.blk, cx.ins, cx.st, cx.errs, cx.warns);
  t.step(ins);
  return Cx {
    prog: t.prog,
    f: t.f,
    blk: t.blk,
    ins: t.ins,
    st: t.state(),
    errs: t.errs,
    warns: t.warns,
  };
}
