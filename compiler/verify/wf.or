// Well-formedness of MIR (docs/mir.md "Execution model"): index ranges and operand classes. The
// ownership rules in rules.or assume every function passed this check, so they never index out
// of range. Each check returns an error message, or "" when the item is well-formed. The check is the
// verifier's own (it does not trust the producer of the MIR); its `@Ensures` tie it to the shared structural
// predicates of compiler/mir (`instrInRange`, `termInRange`, `paramsWellFormed`, `spansAligned`), so the two
// formulations cannot drift apart.

import {
  MProgram, MFunction, MType, Operand, Instr, Terminator, SwitchCase, dstOf, instrInRange,
  termInRange, paramsWellFormed, spansAligned, AGG_MAX, slotWords, readsVariant, readsPayload,
} from "../mir";

import { UnOp, BinOp, Builtin, taskOpOpensFrom, taskOpAdopts, taskOpMoves } from "../hir";

// Operand/local classes.
export const CInt: int = 0;
export const CUsize: int = 1;
export const CBool: int = 2;
export const CRef: int = 3;
export const CVoid: int = 4;
export const CFloat: int = 5;
export const CHandle: int = 6; // resource handle (v1.8, ADR-0025)
// Unboxed aggregates (v2.2, ADR-0038 step 1): MAgg(n) has class CAgg0 + n, so every class comparison (copies, call
// arguments and results, returns) also compares the width.
export const CAgg0: int = 10;

// A class of an unboxed aggregate (any width, also one wider than AGG_MAX: `wfFunction` rejects that local).
@Ensures(result == (c >= CAgg0))
export function isAggClass(c: int): bool {
  return c >= CAgg0;
}

// A plain scalar class: what an aggregate word holds (no reference, no handle, not void, not an aggregate).
@Ensures(result == (c == CInt || c == CUsize || c == CBool || c == CFloat))
export function isWordClass(c: int): bool {
  return c == CInt || c == CUsize || c == CBool || c == CFloat;
}

@Ensures(result >= CInt && result <= CHandle || isAggClass(result))
@Ensures(match (t) {
  MAgg(n) => result == CAgg0 + n.toInt(),
  _ => result >= CInt && result < CAgg0,
})
export function tyClass(t: MType): int {
  return match (t) {
    MInt => 0,
    MUsize => 1,
    MBool => 2,
    MFloat => 5,
    MHandle => 6,
    MRef => 3,
    MVoid => 4,
    MAgg(n) => CAgg0 + n.toInt(),
  };
}

// Class of a local; callers have checked the index.
@Requires(l < f.locals.length)
@Ensures(result == tyClass(f.locals[l].ty))
export function localClass(f: MFunction, l: usize): int {
  return tyClass(f.locals[l].ty);
}

// Class of a well-formed operand.
@Requires(opLocalOk(f, o))
export function opClass(f: MFunction, o: Operand): int {
  return match (o) {
    OLocal(l) => localClass(f, l),
    OInt(_) => 0,
    OUsize(_) => 1,
    OBool(_) => 2,
    OFloat(_) => 5,
    OStr(_) => 3,
  };
}

// A local operand names a local of `f`.
@Ensures(match (o) {
  OLocal(l) => result == (l < f.locals.length),
  _ => result,
})
export function opLocalOk(f: MFunction, o: Operand): bool {
  return match (o) {
    OLocal(l) => l < f.locals.length,
    _ => true,
  };
}

@Ensures(result ==> opLocalOk(f, o))
function opOk(p: MProgram, f: MFunction, o: Operand): bool {
  return match (o) {
    OLocal(l) => l < f.locals.length,
    OInt(_) => true,
    OUsize(_) => true, // the 64-bit pattern: a negative int is a value above 2^63-1 (u64 literals, ADR-0022)
    OBool(_) => true,
    OFloat(t) => t.length > 0,
    OStr(i) => i < p.strings.length,
  };
}

function isLocal(o: Operand, l: usize): bool {
  return match (o) {
    OLocal(m) => m == l,
    _ => false,
  };
}

// Operand of class handle (a resource handle may only be an argument of a call, see handleMsg).
function isHandleOp(f: MFunction, o: Operand): bool {
  return match (o) {
    OLocal(l) => l < f.locals.length && localClass(f, l) == CHandle,
    _ => false,
  };
}

// None of `os` is a resource handle (a handle is never stored, captured or boxed).
function noHandles(f: MFunction, os: Operand[]): bool {
  return !os.some(o => isHandleOp(f, o));
}

function opsOk(p: MProgram, f: MFunction, os: Operand[]): bool {
  return os.every(o => opOk(p, f, o));
}

// local `l` is in range and has class `c`
function isCls(f: MFunction, l: usize, c: int): bool {
  return l < f.locals.length && localClass(f, l) == c;
}

// operand is well-formed and has class `c`
function opIs(p: MProgram, f: MFunction, o: Operand, c: int): bool {
  return opOk(p, f, o) && opClass(f, o) == c;
}

function constsOk(p: MProgram, f: MFunction, os: Operand[], isRef: bool): bool {
  return os.every(
    o => opOk(p, f, o)
        && opClass(f, o) == CRef == isRef
        && opClass(f, o) != CHandle
        && !isAggClass(opClass(f, o)),
  );
}

// Operand that is a *local* of class ref (OStr is not an object that can be indexed/mutated).
function refLocalOp(f: MFunction, o: Operand): bool {
  return match (o) {
    OLocal(l) => isCls(f, l, CRef),
    _ => false,
  };
}

// ---- unboxed aggregates (v2.2): the structural rules (the verifier treats an aggregate as a scalar: `Init`) ----

// Local `l` is in range and an unboxed aggregate.
@Ensures(result == (l < f.locals.length && isAggClass(localClass(f, l))))
function isAggLocal(f: MFunction, l: usize): bool {
  return l < f.locals.length && isAggClass(localClass(f, l));
}

// Operand that is a local holding an unboxed aggregate.
function aggLocalOp(f: MFunction, o: Operand): bool {
  return match (o) {
    OLocal(l) => isAggLocal(f, l),
    _ => false,
  };
}

// The payload width n of aggregate local `l` (class CAgg0 + n).
@Requires(isAggLocal(f, l))
function aggWidth(f: MFunction, l: usize): usize {
  return (localClass(f, l) - CAgg0).toUsize();
}

// None of `os` is an unboxed aggregate (a slot, an element, a capture, a boxed value or an argument through a function
// value holds one 64-bit word or a reference: an aggregate is never stored on the heap).
function noAggs(f: MFunction, os: Operand[]): bool {
  return !os.some(o => aggLocalOp(f, o));
}

// The words that the slots of an aggregate built from `slots` take (a scalar one word, an MAgg(m) m + 1).
@Requires(slots.every(o => opLocalOk(f, o)))
function slotsWords(f: MFunction, slots: Operand[]): usize {
  let n: usize = 0;
  let i: usize = 0;
  @Invariant(i <= slots.length)
  while (i < slots.length) {
    n += match (slots[i]) {
      OLocal(l) => slotWords(f.locals[l].ty),
      _ => 1,
    };
    i += 1;
  }
  return n;
}

// IStructNew into an aggregate: every slot a plain scalar or an aggregate (no reference, no handle, no string constant),
// and all of them fit into the payload.
@Requires(isAggLocal(f, d))
function aggNewMsg(p: MProgram, f: MFunction, d: usize, slots: Operand[]): string {
  if (!opsOk(p, f, slots)) {
    return "IStructNew: bad slot operand";
  }
  if (!slots.every(o => isWordClass(opClass(f, o)) || isAggClass(opClass(f, o)))) {
    return "IStructNew of an unboxed aggregate: a slot is a reference or a handle";
  }
  return slotsWords(f, slots) <= aggWidth(f, d)
      ? ""
      : "IStructNew of an unboxed aggregate: the slots do not fit into its words";
}

// IGetField from an aggregate: the destination is a plain scalar (one word) or an aggregate (its words), and the words
// read lie inside the payload (`k` is a word offset).
@Requires(isAggLocal(f, o) && d < f.locals.length)
function aggGetMsg(f: MFunction, d: usize, o: usize, k: usize): string {
  const c = localClass(f, d);
  if (!isWordClass(c) && !isAggClass(c)) {
    return "IGetField of an unboxed aggregate: the destination must be a scalar or an aggregate";
  }
  return k + slotWords(f.locals[d].ty) <= aggWidth(f, o)
      ? ""
      : "IGetField of an unboxed aggregate: word offset out of range";
}

// An aggregate is only argument 0 of an Option / Result builtin, whose result is then a plain scalar; no builtin defines
// an aggregate.
function aggBuiltinMsg(f: MFunction, dst: Option<usize>, b: Builtin, args: Operand[]): string {
  const dAgg = match (dst) {
    Some(d) => isAggLocal(f, d),
    None => false,
  };
  if (dAgg) {
    return "IBuiltin: no builtin returns an unboxed aggregate";
  }
  if (noAggs(f, args)) {
    return "";
  }
  if (!readsVariant(b) || !noAggs(f, args.slice(1, args.length))) {
    return "IBuiltin: an unboxed aggregate is only argument 0 of an Option / Result builtin";
  }
  const l = match (args[0]) {
    OLocal(x) => x,
    _ => 0,
  };
  if (readsPayload(b) && aggWidth(f, l) == 0) {
    return "IBuiltin: unwrapping an unboxed aggregate without payload words";
  }
  return match (dst) {
    Some(d) => isWordClass(localClass(f, d))
        ? ""
        : "IBuiltin: the payload of an unboxed aggregate is a plain scalar",
    None => "",
  };
}

// A call through a function value never takes or returns an aggregate (it has no signature both sides could agree on).
function aggDst(f: MFunction, dst: Option<usize>): bool {
  return match (dst) {
    Some(d) => isAggLocal(f, d),
    None => false,
  };
}

@Requires(d < f.locals.length && opLocalOk(f, a) && opLocalOk(f, b))
function binOk(f: MFunction, op: BinOp, d: usize, a: Operand, b: Operand): bool {
  const ca = opClass(f, a);
  const cb = opClass(f, b);
  const cd = localClass(f, d);
  return match (op) {
    OpAdd => ca == cb && (ca == CInt || ca == CUsize || ca == CFloat) && cd == ca,
    OpSub => ca == cb && (ca == CInt || ca == CUsize || ca == CFloat) && cd == ca,
    OpMul => ca == cb && (ca == CInt || ca == CUsize || ca == CFloat) && cd == ca,
    OpDiv => ca == cb && (ca == CInt || ca == CUsize || ca == CFloat) && cd == ca,
    OpRem => ca == cb && (ca == CInt || ca == CUsize) && cd == ca,
    OpEq => ca == cb && ca != CHandle && !isAggClass(ca) && cd == CBool,
    OpNe => ca == cb && ca != CHandle && !isAggClass(ca) && cd == CBool,

    OpLt => ca == cb && (ca == CInt || ca == CUsize || ca == CFloat) && cd == CBool,
    OpLe => ca == cb && (ca == CInt || ca == CUsize || ca == CFloat) && cd == CBool,
    OpGt => ca == cb && (ca == CInt || ca == CUsize || ca == CFloat) && cd == CBool,
    OpGe => ca == cb && (ca == CInt || ca == CUsize || ca == CFloat) && cd == CBool,
    OpAnd => ca == CBool && cb == CBool && cd == CBool,
    OpOr => ca == CBool && cb == CBool && cd == CBool,
  };
}

@Requires(d < f.locals.length && opLocalOk(f, a))
function unOk(f: MFunction, op: UnOp, d: usize, a: Operand): bool {
  const c = match (op) {
    UnNot => CBool,
    UnNeg => opClass(f, a) == CFloat ? CFloat : CInt,
  };
  return opClass(f, a) == c && localClass(f, d) == c;
}

@Ensures(result == "" ==> fi < p.functions.length && args.length == p.functions[fi].paramCount)
function callMsg(
  p: MProgram,
  f: MFunction,
  dst: Option<usize>,
  fi: usize,
  args: Operand[],
): string {
  if (fi >= p.functions.length) {
    return "ICall: function index out of range";
  }
  const g = p.functions[fi];
  if (args.length != g.paramCount) {
    return "ICall: wrong number of arguments for " + g.name;
  }
  if (!opsOk(p, f, args)) {
    return "ICall: bad operand";
  }
  // The callee's own well-formedness is checked when it is verified, which may be later: its parameters must be
  // locals before their classes can be compared (an ill-formed callee used to make the verifier index out of range).
  if (g.paramCount > g.locals.length) {
    return "ICall: callee " + g.name + " has more parameters than locals";
  }
  let i: usize = 0;
  while (i < args.length) {
    if (opClass(f, args[i]) != localClass(g, i)) {
      return "ICall: argument " + i.toString() + " has the wrong class";
    }
    i += 1;
  }
  if (g.inout) {
    // v1.10: the call consumes argument 0 and redefines that local with the callee's final receiver
    match (args[0]) {
      OLocal(x) => {
        match (dst) {
          Some(d) => {
            if (d == x) {
              return "ICall of an inout function: the destination must not be the in/out argument";
            }
          },
          None => {},
        }
      },
      _ => {
        return "ICall of an inout function: argument 0 must be a local (it receives the updated value)";
      },
    }
  }
  const rc = tyClass(g.ret);
  return match (dst) {
    None => "",
    Some(d) => {
      if (d >= f.locals.length) {
        return "ICall: destination out of range";
      }
      if (rc == CVoid || localClass(f, d) != rc) {
        return "ICall: destination class does not match the callee's return type";
      }
      return "";
    },
  };
}

// IClosure: the lifted function takes the environment record first (a reference) and has only
// borrowed parameters (an indirect call cannot honour owned-parameter modes).
@Ensures(result == "" ==> fi < p.functions.length && p.functions[fi].paramOwned.every(o => !o))
function closureMsg(p: MProgram, f: MFunction, d: usize, fi: usize, caps: Operand[]): string {
  if (!isCls(f, d, CRef)) {
    return "IClosure: the destination must be a reference local";
  }
  if (fi >= p.functions.length) {
    return "IClosure: function index out of range";
  }
  const g = p.functions[fi];
  if (g.paramCount == 0 || g.locals.length == 0 || tyClass(g.locals[0].ty) != CRef) {
    return "IClosure: the lifted function must take the environment record as its first parameter";
  }
  if (g.paramOwned.some(o => o)) {
    return "IClosure: the lifted function " + g.name + " must have only borrowed parameters";
  }
  if (!noHandles(f, caps)) {
    return "IClosure: a resource handle cannot be captured";
  }
  if (!noAggs(f, caps)) {
    return "IClosure: an unboxed aggregate cannot be captured";
  }

  return opsOk(p, f, caps) ? "" : "IClosure: bad capture operand";
}

function optDstOk(f: MFunction, dst: Option<usize>): bool {
  return match (dst) {
    None => true,
    Some(d) => d < f.locals.length,
  };
}

// Both locals in range and of class ref, and distinct.
function refPair(f: MFunction, a: usize, b: usize): bool {
  return isCls(f, a, CRef) && isCls(f, b, CRef) && a != b;
}

// `v` (a consumed/stored operand) must be well-formed and not the object being written; a slot never holds a handle or
// an unboxed aggregate.
function valueOk(p: MProgram, f: MFunction, x: usize, v: Operand): bool {
  return opOk(p, f, v) && !isLocal(v, x) && !isHandleOp(f, v) && !aggLocalOp(f, v);
}

// ---- resource handles (v1.8, ADR-0025): the structural half of the rules (the dataflow half is in rules.or) ----

// Builtins that take a handle as their first argument: the file builtins (but not the one that creates files out of
// a path: that is an opener below) and the std I/O builtins, which take the capability grant that authorises them
// (ADR-0027: a grant is a handle, so a grant can be neither duplicated nor stored nor returned, exactly like a file).
function takesHandle(b: Builtin): bool {
  return match (b) {
    BFsReadFile => true,
    BFsWriteFile => true,
    BFsExists => true,
    BFsListDir => true,
    BProcessArgs => true,
    BIoReadBytes => true,
    BIoReadLine => true,
    BIoWriteStdout => true,
    BIoShell => true,
    BIoShellTimeout => true,
    BTimeNowMillis => true,
    BTimeMonotonicMillis => true,
    BGrantRevoke => true,
    BTask(k) => taskOpMoves(k),
    BNetStatus => true,
    BNetClose => true,
    BNetPort => true,
    BNetNow => true,
    BNetRecv => true,
    BNetSend => true,
    BNetShutdown => true,
    BNetPeer => true,
    BNetResolve => true,
    BFileIsOpen => true,
    BFileOpenError => true,
    BFileClose => true,
    BFileReadLine => true,
    BFileRead => true,
    BFileReadAll => true,
    BFileWrite => true,
    BFileWriteLine => true,
    BFileFlush => true,
    _ => false,
  };
}

// The builtins that define a handle: they take the authorising grant as first argument (BFileOpen: the file grant;
// BGrantFs..: the Host; BGrantUnder..: the parent grant) and nothing else that is a handle.
function isOpenB(b: Builtin): bool {
  return match (b) {
    BFileOpen => true,
    BGrantFs => true,
    BGrantProcess => true,
    BGrantStdio => true,
    BGrantClock => true,
    BGrantUnder => true,
    BGrantReadOnly => true,
    BGrantArgsOnly => true,
    BGrantNet => true,
    BGrantListen => true,
    BGrantConnect => true,
    BNetListen => true,
    BNetAccept => true,
    BNetConnect => true,
    BTask(k) => taskOpOpensFrom(k),
    _ => false,
  };
}

// The builtins that define a handle from a one-shot token instead of from another handle (ADR-0017: a grant moved into a
// task is adopted there): no argument is a handle, the destination is.
function isAdoptB(b: Builtin): bool {
  return match (b) {
    BTask(k) => taskOpAdopts(k),
    _ => false,
  };
}

// First violated handle rule of `ins` ("" if none). Runs after the other structural checks, so every index is in range.
//   * a handle local is defined only by IBuiltin(Some(h), <opener>, ..) (BFileOpen, BGrant*): never by a copy, move, borrow, call result,
//     field/element read, arithmetic ...;
//   * BFileOpen defines exactly a handle; the other file builtins take a handle as first argument and non-handles
//     after it; no other builtin sees a handle (no conversion, comparison or printing of one);
//   * handles are not compared (IBinary), not stored/captured/boxed (the slot/value checks above), not returned.
function handleMsg(f: MFunction, ins: Instr): string {
  match (dstOf(ins)) {
    Some(d) => {
      if (localClass(f, d) == CHandle) {
        match (ins) {
          IBuiltin(_dst, b, _args) => {
            if (!isOpenB(b) && !isAdoptB(b)) {
              return "IBuiltin: only BFileOpen, the BGrant* builtins and the task grant primitives (clone, adopt) may define a resource handle";
            }
          },
          _ => {
            return "a resource handle is defined only by BFileOpen / BGrant* (it cannot be copied, moved, borrowed, read from a field or returned by a call)";
          },
        }
      }
    },
    None => {},
  }
  match (ins) {
    IBuiltin(dst, b, args) => {
      if (isAdoptB(b)) {
        if (!noHandles(f, args)) {
          return "grant adoption: its argument is a token, not a handle";
        }
        match (dst) {
          Some(d) => {
            return localClass(f, d) == CHandle
                ? ""
                : "grant adoption: the destination must be a handle local";
          },
          None => {
            return "grant adoption: the handle must be bound to a local (it would never be revoked)";
          },
        }
      }
      if (isOpenB(b)) {
        if (args.length == 0 || !isHandleOp(f, args[0])) {
          return "handle-opening builtin: the first argument must be the authorising resource handle (a grant)";
        }
        if (!noHandles(f, args.slice(1, args.length))) {
          return "handle-opening builtin: only the first argument can be a resource handle";
        }
        match (dst) {
          Some(d) => {
            return localClass(f, d) == CHandle
                ? ""
                : "handle-opening builtin: the destination must be a handle local";
          },
          None => {
            return "handle-opening builtin: the handle must be bound to a local (it would never be closed)";
          },
        }
      }
      if (takesHandle(b)) {
        if (args.length == 0 || !isHandleOp(f, args[0])) {
          return "file builtin: the first argument must be a resource handle";
        }
        return noHandles(f, args.slice(1, args.length))
            ? ""
            : "file builtin: only the first argument can be a resource handle";
      }
      return noHandles(f, args)
          ? ""
          : "a resource handle can only be passed to calls and file builtins";
    },
    _ => {
      return "";
    },
  }
}

// A resource handle is defined only by an opener builtin (BFileOpen, BGrant*, the net openers, grantClone) or by a
// grant adoption (ADR-0017).
export function handleDefOk(f: MFunction, ins: Instr): bool {
  return match (dstOf(ins)) {
    Some(d) => d >= f.locals.length || localClass(f, d) != CHandle || isOpener(ins),
    None => true,
  };
}

function isOpener(ins: Instr): bool {
  return match (ins) {
    IBuiltin(_dst, b, _args) => isOpenB(b) || isAdoptB(b),
    _ => false,
  };
}

// The first structural error of instruction `ins` of `f` ("" if none). A well-formed instruction mentions only locals,
// strings, functions and vtables that exist (`instrInRange`), and only an opener defines a handle.
@Requires(paramsWellFormed(f))
@Ensures(result == "" ==> instrInRange(p, f.locals.length, ins))
@Ensures(result == "" ==> handleDefOk(f, ins))
export function wfInstr(p: MProgram, f: MFunction, ins: Instr): string {
  const base = wfInstrBase(p, f, ins);
  if (base != "") {
    return base;
  }
  return handleMsg(f, ins);
}

function wfInstrBase(p: MProgram, f: MFunction, ins: Instr): string {
  return match (ins) {
    ICopy(d, o) => {
      if (d >= f.locals.length || !opOk(p, f, o)) {
        return "ICopy: bad local or operand";
      }
      if (opClass(f, o) != localClass(f, d)) {
        return "ICopy: operand and destination classes differ";
      }
      if (localClass(f, d) == CHandle) {
        return "ICopy of a resource handle (handles are never copied)";
      }
      if (localClass(f, d) == CRef && !isStr(o)) {
        return "ICopy of a reference local (use IMove/IDup/IBorrow)";
      }
      return "";
    },
    IMove(d, s) => refPair(f, d, s) ? "" : "IMove: needs two distinct reference locals",
    IBorrow(d, s) => refPair(f, d, s) ? "" : "IBorrow: needs two distinct reference locals",
    IDup(d, o) => isCls(f, d, CRef) && opIs(p, f, o, CRef)
        ? ""
        : "IDup: needs a reference destination and operand",
    IRelease(x) => isCls(f, x, CRef) ? "" : "IRelease: needs a reference local",
    IUnary(d, op, o) => d < f.locals.length && opOk(p, f, o) && unOk(f, op, d, o)
        ? ""
        : "IUnary: operand class mismatch",
    IBinary(d, op, a, b) => {
      if (d < f.locals.length && opOk(p, f, a) && opOk(p, f, b) && binOk(f, op, d, a, b)) {
        return "";
      }
      return "IBinary: operand class mismatch";
    },
    ICall(dst, fi, args) => callMsg(p, f, dst, fi, args),
    IBuiltin(dst, b, args) => optDstOk(f, dst) && opsOk(p, f, args)
        ? aggBuiltinMsg(f, dst, b, args)
        : "IBuiltin: bad local or operand",

    IStrAppend(x, y) => {
      if (!isCls(f, x, CRef) || !opIs(p, f, y, CRef)) {
        return "IStrAppend: needs reference operands";
      }
      return isLocal(y, x) ? "IStrAppend: appending a string to itself" : "";
    },
    IStrPrepend(x, y) => {
      if (!isCls(f, x, CRef) || !opIs(p, f, y, CRef)) {
        return "IStrPrepend: needs reference operands";
      }
      return isLocal(y, x) ? "IStrPrepend: prepending a string to itself" : "";
    },
    IStrAppendSub(x, y, a, b) => {
      if (!isCls(f, x, CRef) || !opIs(p, f, y, CRef) || !opIs(p, f, a, CUsize) || !opIs(p, f, b, CUsize)) {
        return "IStrAppendSub: needs a reference destination, a string and two usize bounds";
      }
      return isLocal(y, x) ? "IStrAppendSub: appending a substring of the string to itself" : "";
    },
    IStrAppendNum(x, y, uns) => {
      if (!isCls(f, x, CRef) || !opIs(p, f, y, uns ? CUsize : CInt)) {
        return "IStrAppendNum: needs a reference destination and an int (usize when unsigned) operand";
      }
      return "";
    },
    IArrayExtend(x, y) => {
      if (!isCls(f, x, CRef) || !refLocalOp(f, y)) {
        return "IArrayExtend: needs reference locals";
      }
      return isLocal(y, x) ? "IArrayExtend: extending an array by itself" : "";
    },
    IStructNew(d, _, slots) => {
      if (isAggLocal(f, d)) {
        return aggNewMsg(p, f, d, slots);
      }
      if (isCls(f, d, CRef) && !noHandles(f, slots)) {
        return "IStructNew: a resource handle cannot be stored";
      }
      if (isCls(f, d, CRef) && opsOk(p, f, slots) && !noAggs(f, slots)) {
        return "IStructNew: an unboxed aggregate cannot be stored in a heap slot";
      }
      return isCls(f, d, CRef) && opsOk(p, f, slots)
          ? ""
          : "IStructNew: bad destination or slot operand";
    },
    INullary(d, _) => isCls(f, d, CRef) || isAggLocal(f, d)
        ? ""
        : "INullary: destination must be a reference or aggregate local",
    ITag(d, o) => isCls(f, d, CInt) && opOk(p, f, o) && (opClass(f, o) == CRef || aggLocalOp(f, o))
        ? ""
        : "ITag: needs an int destination and a reference or aggregate operand",
    IGetField(d, o, k) => {
      if (d >= f.locals.length) {
        return "IGetField: bad destination or object";
      }
      match (o) {
        OLocal(l) => {
          if (isAggLocal(f, l)) {
            return aggGetMsg(f, d, l, k);
          }
        },
        _ => {},
      }
      if (isAggLocal(f, d)) {
        return "IGetField: an aggregate is read only from an aggregate";
      }
      return refLocalOp(f, o) ? "" : "IGetField: bad destination or object";
    },

    ISetField(x, _, v) => isCls(f, x, CRef) && valueOk(p, f, x, v)
        ? ""
        : "ISetField: bad object or value",
    ITakeField(d, x, _) => refPair(f, d, x)
        ? ""
        : "ITakeField: needs two distinct reference locals",
    IPutField(x, _, s) => refPair(f, x, s) ? "" : "IPutField: needs two distinct reference locals",
    IMakeUnique(x) => isCls(f, x, CRef) ? "" : "IMakeUnique: needs a reference local",
    IArrayNew(d, isRef, elems) => isCls(f, d, CRef) && constsOk(p, f, elems, isRef)
        ? ""
        : "IArrayNew: bad destination or element class",
    IArrayGet(d, a, i) => d < f.locals.length
        && !isAggLocal(f, d)
        && refLocalOp(f, a)
        && opIs(p, f, i, CUsize)
        ? ""
        : "IArrayGet: bad destination, array or index",
    IArraySet(x, i, v) => isCls(f, x, CRef) && opIs(p, f, i, CUsize) && valueOk(p, f, x, v)
        ? ""
        : "IArraySet: bad array, index or value",
    IShapeCheck(x, _) => isCls(f, x, CRef) ? "" : "IShapeCheck: needs a reference local",
    IGetFieldU(d, o, _) => d < f.locals.length && !isAggLocal(f, d) && refLocalOp(f, o)
        ? ""
        : "IGetFieldU: bad destination or object",
    ISetFieldU(x, _, v) => isCls(f, x, CRef) && valueOk(p, f, x, v)
        ? ""
        : "ISetFieldU: bad object or value",
    IArrayGetU(d, a, i) => d < f.locals.length
        && !isAggLocal(f, d)
        && refLocalOp(f, a)
        && opIs(p, f, i, CUsize)
        ? ""
        : "IArrayGetU: bad destination, array or index",
    IArraySetU(x, i, v) => isCls(f, x, CRef) && opIs(p, f, i, CUsize) && valueOk(p, f, x, v)
        ? ""
        : "IArraySetU: bad array, index or value",
    IArrayTake(d, x, i) => refPair(f, d, x) && opIs(p, f, i, CUsize)
        ? ""
        : "IArrayTake: bad destination, array or index",
    IArrayPut(x, i, s) => refPair(f, x, s) && opIs(p, f, i, CUsize)
        ? ""
        : "IArrayPut: bad array, index or source",
    IArrayPush(x, v) => isCls(f, x, CRef) && valueOk(p, f, x, v)
        ? ""
        : "IArrayPush: bad array or value",
    IArrayPop(d, x) => refPair(f, d, x) || isCls(f, x, CRef) && isCls(f, d, CAgg0 + 1)
        ? ""
        : "IArrayPop: needs two distinct reference locals (or an agg1 destination)",

    IForward(d, s, o, k) => {
      if (d >= f.locals.length || s >= f.locals.length || !isWordClass(localClass(f, d))
          || localClass(f, d) != localClass(f, s)) {
        return "IForward: destination and source must be scalars of one class";
      }
      return refLocalOp(f, o) && opIs(p, f, k, CUsize) ? "" : "IForward: bad object or key";
    },
    IClosure(d, fi, caps) => closureMsg(p, f, d, fi, caps),
    ICallIndirect(dst, c, args) => {
      if (!optDstOk(f, dst) || !opsOk(p, f, args) || !noAggs(f, args) || aggDst(f, dst)) {
        return "ICallIndirect: bad destination or argument";
      }
      return refLocalOp(f, c) ? "" : "ICallIndirect: the callee must be a reference local";
    },
    IIface(d, vt, v) => {
      if (!isCls(f, d, CRef)) {
        return "IIface: the destination must be a reference local";
      }
      if (vt >= p.vtables.length) {
        return "IIface: vtable index out of range";
      }
      return opIs(p, f, v, CRef) ? "" : "IIface: the boxed value must be a reference operand";
    },
    ICallVirtual(dst, c, _, args) => {
      if (!optDstOk(f, dst) || !opsOk(p, f, args) || !noAggs(f, args) || aggDst(f, dst)) {
        return "ICallVirtual: bad destination or argument";
      }
      return refLocalOp(f, c) ? "" : "ICallVirtual: the interface value must be a reference local";
    },
  };
}

function isStr(o: Operand): bool {
  return match (o) {
    OStr(_) => true,
    _ => false,
  };
}

function targetOk(f: MFunction, t: usize): bool {
  return t < f.blocks.length;
}

function casesOk(f: MFunction, cs: SwitchCase[]): bool {
  return cs.every(c => targetOk(f, c.target));
}

// The first structural error of terminator `t` of `f` ("" if none): a well-formed terminator branches only to blocks
// of `f` and reads only locals and strings that exist (`termInRange`).
@Ensures(result == "" ==> termInRange(p, f, t))
export function wfTerm(p: MProgram, f: MFunction, t: Terminator): string {
  return match (t) {
    TGoto(b) => targetOk(f, b) ? "" : "TGoto: block index out of range",
    TBranch(o, a, b) => {
      if (!targetOk(f, a) || !targetOk(f, b)) {
        return "TBranch: block index out of range";
      }
      return opIs(p, f, o, CBool) ? "" : "TBranch: condition must be a bool operand";
    },
    TSwitch(o, cs, d) => {
      if (!targetOk(f, d) || !casesOk(f, cs)) {
        return "TSwitch: block index out of range";
      }
      return opIs(p, f, o, CInt) ? "" : "TSwitch: scrutinee must be an int operand";
    },
    TReturn(r) => {
      const rc = tyClass(f.ret);
      return match (r) {
        None => rc == CVoid ? "" : "TReturn without a value in a non-void function",
        Some(o) => {
          if (rc == CVoid) {
            return "TReturn with a value in a void function";
          }
          return opIs(p, f, o, rc) ? "" : "TReturn: value class does not match the return type";
        },
      };
    },
    TTrap(_) => "",
  };
}

// Function-level checks (first error, "" if fine). A function that passes has a consistent parameter table, an entry
// block and one span per instruction (the spans are where the issues are reported: a block with fewer spans than
// instructions is rejected here instead of failing the report).
@Ensures(result == "" ==> paramsWellFormed(f) && f.blocks.length > 0 && spansAligned(f.blocks))
@Ensures(result == "" ==> f.locals.every(l => tyClass(l.ty) != CVoid))
export function wfFunction(f: MFunction): string {
  if (f.paramCount > f.locals.length) {
    return "paramCount exceeds the number of locals";
  }
  if (f.paramOwned.length != f.paramCount) {
    return "paramOwned length differs from paramCount";
  }
  let i: usize = 0;
  while (i < f.paramCount) {
    if (f.paramOwned[i] && tyClass(f.locals[i].ty) != CRef) {
      return "owned parameter `" + f.locals[i].name + "` is not a reference";
    }
    i += 1;
  }
  if (f.inout && (f.paramCount == 0 || !f.paramOwned[0])) {
    return "inout function: parameter 0 must be an owned reference parameter (v1.10)";
  }
  if (f.uniqueIn && !f.inout) {
    return "unique-in function: only an inout function has a receiver (rule U2, v2.7)";
  }
  if (f.uniqueOut && !f.inout && tyClass(f.ret) != CRef) {
    return "unique-out function: it must be inout or return a reference (rule U3, v2.7)";
  }
  if (tyClass(f.ret) == CHandle) {
    return "function returns a resource handle (a handle cannot be returned)";
  }
  if (f.blocks.length == 0) {
    return "function has no blocks";
  }
  match (f.locals.find(l => tyClass(l.ty) == CVoid)) {
    Some(l) => {
      return "local `" + l.name + "` has type void";
    },
    None => {},
  }
  match (f.locals.find(l => tyClass(l.ty) > CAgg0 + AGG_MAX.toInt())) {
    Some(l) => {
      return "local `" + l.name + "` is an unboxed aggregate wider than four words";
    },
    None => {},
  }
  if (tyClass(f.ret) > CAgg0 + AGG_MAX.toInt()) {
    return "the result is an unboxed aggregate wider than four words";
  }
  if (!spansAligned(f.blocks)) {
    return "a block has a different number of source spans and instructions";
  }
  return "";
}
