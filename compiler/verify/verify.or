// OIM ownership verifier driver (docs/mir.md). Per function: well-formedness (wf.or), then a
// forward worklist dataflow over the CFG to a fixpoint (class `Fixpoint`; transfer functions in rules.or, joins in
// state.or), then one reporting pass over the stable block in-states.
//
// Termination: in[b] is only ever replaced by join(in[b], out) and re-queued when that differs
// from in[b]; the join is monotone and the lattice (5 kinds + poison per local, Borrowed sources
// drawn from the finite set of locals, hole sets over a finite universe) has finite height, so
// every in[b] changes finitely often. This holds even if a transfer function is not monotone.

import {
  MProgram, MFunction, MBlock, noSpan, hasSpan, succCount, succAt,
  isWellFormedFunction,
  isWellFormedProgram,
} from "../mir";
import {
  VerifyIssue, issueSpan, sameSpan, State, HoleEntry, mk, joinLs, holeIn, holesEq, KDead, KOwned, KUnique, KParam,
  KInit,
} from "./state";
import { CRef, CHandle, localClass, wfInstr, wfTerm, wfFunction } from "./wf";
import { Transfer } from "./rules";
import { accessFacts } from "./unchecked";
import { fieldFacts } from "./fieldcheck";
import { mapChunksLent } from "../util";

export type VerifyReport = { errors: VerifyIssue[]; warnings: VerifyIssue[]; };

// ------------------------------------------------------------------ issues

function issue(f: MFunction, b: usize, i: usize, msg: string): VerifyIssue {
  return VerifyIssue { func: f.name, block: b, instr: i, message: msg, span: issueSpan(f, b, i) };
}

// Issue `e` of function `f` names an existing block and instruction (the terminator counts as instruction
// `instrs.length`) and carries that position's span, or it is about the whole function (position 0/0, no span).
export function issuePlaced(f: MFunction, e: VerifyIssue): bool {
  if (e.func != f.name) {
    return false;
  }
  if (e.block < f.blocks.length && e.instr <= f.blocks[e.block].instrs.length) {
    return sameSpan(e.span, issueSpan(f, e.block, e.instr));
  }
  return e.block == 0 && e.instr == 0 && !hasSpan(e.span);
}

// Every issue of a report on `p` names something that exists: a function of `p` (placed as `issuePlaced` says), a
// vtable of `p`, or the program itself (`main`).
export function reportPlaced(p: MProgram, es: VerifyIssue[]): bool {
  return es.every(
    e => e.func == "<program>"
        || p.vtables.some(v => v.name == e.func)
        || p.functions.some(f => issuePlaced(f, e)),
  );
}

// The queue flags of a fresh fixpoint over `n` blocks: only the entry block is queued (and, the same shape, reached).
@Requires(n > 0)
@Ensures(result.length == n && result[0] && result.filter(q => q).length == 1)
function entryQueued(n: usize): bool[] {
  let out: bool[] = [true];
  let i: usize = 1;
  while (i < n) {
    out.push(false);
    i += 1;
  }
  return out;
}

// ------------------------------------------------------------------ the fixpoint

// Parameters are Param (references) or initialised scalars; everything else starts Dead.
@Requires(isWellFormedFunction(p, f))
@Ensures(result.ls.length == f.locals.length && result.holes.length == 0 && result.borrowsFlat())
function entryState(p: MProgram, f: MFunction): State {
  let ls: int[] = [];
  let i: usize = 0;
  while (i < f.locals.length) {
    if (i < f.paramCount) {
      if (localClass(f, i) == CHandle) {
        ls.push(mk(KParam, 0)); // a handle parameter is borrowed for the whole call
      } else if (localClass(f, i) != CRef) {
        ls.push(mk(KInit, 0));
      } else {
        // rule U2 (v2.7): the receiver of a `unique-in` function is Unique on entry (every call site proves it, rule U4)
        ls.push(mk(f.paramOwned[i] ? (i == 0 && f.uniqueIn ? KUnique : KOwned) : KParam, 0));
      }
    } else {
      ls.push(mk(KDead, 0));
    }
    i += 1;
  }
  return new State(ls, []);
}

// The in-states: the entry state for block 0, nothing for the others yet.
@Requires(isWellFormedFunction(p, f))
@Ensures(result.length == f.blocks.length && result[0].isSome())
function initialIns(p: MProgram, f: MFunction): Option<State>[] {
  let ins: Option<State>[] = [Some(entryState(p, f))];
  let i: usize = 1;
  while (i < f.blocks.length) {
    ins.push(None);
    i += 1;
  }
  return ins;
}

// The local states of the in-states `ins` (`ins[0]` is reached), one array per block: empty for a block not reached yet.
@Requires(ins.length > 0 && ins[0].isSome())
@Ensures(result.length == ins.length)
function insLs(ins: Option<State>[]): int[][] {
  let out: int[][] = [ins[0].unwrap().ls];
  let i: usize = 1;
  @Invariant(i <= ins.length && out.length == i)
  while (i < ins.length) {
    out.push([]);
    i += 1;
  }
  return out;
}

// The hole sets of the in-states `ins`, like `insLs`.
@Requires(ins.length > 0 && ins[0].isSome())
@Ensures(result.length == ins.length)
function insHoles(ins: Option<State>[]): HoleEntry[][] {
  let out: HoleEntry[][] = [ins[0].unwrap().holes];
  let i: usize = 1;
  @Invariant(i <= ins.length && out.length == i)
  while (i < ins.length) {
    out.push([]);
    i += 1;
  }
  return out;
}

// Run block b from `st`; the result's state is the state after the terminator.
function runBlock(p: MProgram, f: MFunction, b: usize, st: State): Transfer {
  let t = new Transfer(p, f, b, 0, st, [], []);
  t.run();
  return t;
}

// Every in-state has one entry per local (`n`).
export function statesSized(ins: Option<State>[], n: usize): bool {
  return ins.every(s => s.isNone() || s.unwrap().ls.length == n);
}

// The reached blocks are closed under the successor relation: a successor of a block that has an in-state has one.
export function reachClosed(f: MFunction, ins: Option<State>[]): bool {
  let b: usize = 0;
  while (b < f.blocks.length) {
    if (ins[b].isSome()) {
      const t = f.blocks[b].term;
      let k: usize = 0;
      while (k < succCount(t)) {
        if (ins[succAt(t, k)].isNone()) {
          return false;
        }
        k += 1;
      }
    }
    b += 1;
  }
  return true;
}

// The forward dataflow of one well-formed function: the in-state of block `b` is `lsIn[b]` / `holesIn[b]` while `b` has
// been reached (`reached[b]`; nothing yet otherwise); the worklist `work` holds the blocks whose in-state changed since
// they were last run, each at most once (`queued[b]` iff `b` is in `work`), last in first out. Only block ids get in
// (`add` requires one), so the worklist is never longer than the block list. `ins` is the same in-states as `State`
// values (None while `b` has not been reached), built once when `run` is done: the iteration itself allocates no state
// per block run. One `Transfer` replays every block (`load` resets it), its out-state is joined into the successors'
// in-states in place, and a new array is cut only when a block is reached for the first time. The worklist and the state
// arrays are part of this class rather than classes of their own because a mutating method called on a class-typed
// field copies the object and its arrays on every call (step 3b, measured).
@Invariant(this.ins.length == this.f.blocks.length)
@Invariant(this.ins.length > 0 && this.ins[0].isSome())
@Invariant(this.queued.length == this.ins.length)
@Invariant(this.lsIn.length == this.ins.length && this.holesIn.length == this.ins.length)
@Invariant(this.reached.length == this.ins.length && this.reached[0])
@Invariant(this.work.length <= this.queued.length)
@Invariant(this.none.length == 0)
export class Fixpoint {
  private prog: MProgram;
  private f: MFunction;
  ins: Option<State>[];
  private lsIn: int[][];
  private holesIn: HoleEntry[][];
  private reached: bool[];
  private work: usize[];
  private queued: bool[];
  // An empty issue list shared by every block run of the fixpoint, which discards what it reports (the reporting pass
  // keeps its own): a block run takes it by reference instead of allocating two fresh empty lists, and an issue
  // pushed to it (only for MIR that fails the verifier) copies it first, so it stays empty.
  private none: VerifyIssue[];

  constructor(prog: MProgram, f: MFunction) {
    this.prog = prog;
    this.f = f;
    this.ins = initialIns(prog, f);
    this.lsIn = insLs(initialIns(prog, f));
    this.holesIn = insHoles(initialIns(prog, f));
    this.reached = entryQueued(f.blocks.length);
    this.work = [0];
    this.queued = entryQueued(f.blocks.length);
    this.none = [];
  }

  // Number of blocks waiting to be run.
  pending(): usize {
    return this.work.length;
  }

  // Queues block `b` unless it is queued already.
  @Requires(b < this.queued.length)
  @Ensures(this.queued[b] && this.queued.length == old(this.queued.length))
  @Ensures(old(this.queued[b]) ==> this.work.length == old(this.work.length))
  @Ensures(!old(this.queued[b]) ==> this.work.length == old(this.work.length) + 1)
  private add(b: usize): void {
    if (!this.queued[b]) {
      this.queued[b] = true;
      this.work.push(b);
    }
  }

  // The most recently queued block; it is no longer queued.
  // The queued ids are block ids (`add` requires one), which the class invariants cannot say about the elements of `work`.
  @Requires(this.work.length > 0 && this.work[this.work.length - 1] < this.queued.length)
  @Ensures(result < this.queued.length && !this.queued[result])
  @Ensures(this.work.length + 1 == old(this.work.length))
  private take(): usize {
    const b = this.work.pop().unwrap();
    this.queued[b] = false;
    return b;
  }

  // The transfer functions' replay of every block of this fixpoint: it holds the entry state until the first `load`;
  // its issues are discarded.
  private runner(): Transfer {
    return new Transfer(
      this.prog,
      this.f,
      0,
      0,
      new State(this.lsIn[0], this.holesIn[0]),
      this.none,
      this.none,
    );
  }

  // Joining the out-state (`ls`, `holes`) into the in-state of the reached block `s` would change it.
  @Requires(s < this.reached.length && this.reached[s] && ls.length == this.lsIn[s].length)
  private joinChanges(s: usize, ls: int[], holes: HoleEntry[]): bool {
    let i: usize = 0;
    while (i < ls.length) {
      if (joinLs(this.lsIn[s][i], ls[i]) != this.lsIn[s][i]) {
        return true;
      }
      i += 1;
    }
    return !holes.every(h => holeIn(h, this.holesIn[s]));
  }

  // Joins the out-state (`ls`, `holes`) into the in-state of the reached block `s` in place (`State.join`: per local
  // `joinLs`, the holes of the out-state that are not there yet appended); true when that changed it.
  @Requires(s < this.reached.length && this.reached[s] && ls.length == this.lsIn[s].length)
  @Ensures(this.lsIn[s].length == old(this.lsIn[s].length))
  private joinInto(s: usize, ls: int[], holes: HoleEntry[]): bool {
    let changed = false;
    let i: usize = 0;
    while (i < ls.length) {
      const j = joinLs(this.lsIn[s][i], ls[i]);
      if (j != this.lsIn[s][i]) {
        this.lsIn[s][i] = j;
        changed = true;
      }
      i += 1;
    }
    for (const h of holes) {
      if (!holeIn(h, this.holesIn[s])) {
        this.holesIn[s].push(h);
        changed = true;
      }
    }
    return changed;
  }

  // Iterates to the fixpoint. Afterwards the worklist is empty, every reached block's successors are reached, and the
  // in-states are stable: running any reached block and joining its out-state into a successor's in-state changes
  // nothing (a block that was forgotten in the worklist would show here).
  @Requires(isWellFormedFunction(this.prog, this.f) && wfFunction(this.f) == "")
  @Ensures(this.work.length == 0 && this.queued.every(q => !q))
  @Ensures(statesSized(this.ins, this.f.locals.length))
  @Ensures(reachClosed(this.f, this.ins))
  @Ensures(this.isStable())
  run(): void {
    let t = this.runner();
    while (this.work.length > 0) {
      const b = this.take();
      t.load(b, this.lsIn[b], this.holesIn[b]);
      t.run();
      const term = this.f.blocks[b].term;
      let k: usize = 0;
      while (k < succCount(term)) {
        const s = succAt(term, k);
        if (!this.reached[s]) {
          this.reached[s] = true;
          this.lsIn[s] = t.ls;
          this.holesIn[s] = t.holes;
          this.add(s);
        } else if (this.joinInto(s, t.ls, t.holes)) {
          this.add(s);
        }
        k += 1;
      }
    }
    let b: usize = 0;
    while (b < this.ins.length) {
      if (this.reached[b]) {
        this.ins[b] = Some(new State(this.lsIn[b], this.holesIn[b]));
      }
      b += 1;
    }
  }

  // No reached block's out-state adds anything to the in-state of a successor.
  isStable(): bool {
    let t = this.runner();
    let b: usize = 0;
    while (b < this.ins.length) {
      if (this.reached[b]) {
        t.load(b, this.lsIn[b], this.holesIn[b]);
        t.run();
        const term = this.f.blocks[b].term;
        let k: usize = 0;
        while (k < succCount(term)) {
          const s = succAt(term, k);
          if (!this.reached[s] || this.joinChanges(s, t.ls, t.holes)) {
            return false;
          }
          k += 1;
        }
      }
      b += 1;
    }
    return true;
  }
}

// ------------------------------------------------------------------ verification

// Structural errors of function f (empty if well-formed). No errors means `f` is well-formed in the sense of the
// shared MIR predicate (`isWellFormedFunction`, compiler/mir): the verifier's own check is at least as strict.
@Ensures(result.length == 0 ==> isWellFormedFunction(p, f))
@Ensures(result.every(e => issuePlaced(f, e)))
function wellFormed(p: MProgram, f: MFunction): VerifyIssue[] {
  let out: VerifyIssue[] = [];
  const m = wfFunction(f);
  if (m != "") {
    out.push(VerifyIssue { func: f.name, block: 0, instr: 0, message: m, span: noSpan() });
    return out;
  }
  let b: usize = 0;
  while (b < f.blocks.length) {
    const blk: MBlock = f.blocks[b];
    let i: usize = 0;
    while (i < blk.instrs.length) {
      const e = wfInstr(p, f, blk.instrs[i]);
      if (e != "") {
        out.push(issue(f, b, i, e));
      }
      i += 1;
    }
    const t = wfTerm(p, f, blk.term);
    if (t != "") {
      out.push(issue(f, b, blk.instrs.length, t));
    }
    b += 1;
  }
  return out;
}

// The report of one function: its structural errors, or else the ownership errors and leak warnings of every reached
// block (an unreachable block is only checked for well-formedness). Every issue names a position of `f`.
@Ensures(result.errors.length == 0 ==> isWellFormedFunction(p, f))
@Ensures(result.errors.every(e => issuePlaced(f, e))
    && result.warnings.every(w => issuePlaced(f, w)))
function verifyFunction(p: MProgram, f: MFunction): VerifyReport {
  let rep = VerifyReport { errors: wellFormed(p, f), warnings: [] };
  if (rep.errors.length > 0) {
    return rep;
  }
  let fx = new Fixpoint(p, f);
  fx.run();
  const ins = fx.ins;
  let b: usize = 0;
  while (b < f.blocks.length) {
    match (ins[b]) {
      None => {},
      Some(st) => {
        const t = runBlock(p, f, b, st);
        // appended in a loop: `concat` would copy the report once per block
        for (const e of t.errs) {
          rep.errors.push(e);
        }
        for (const w of t.warns) {
          rep.warnings.push(w);
        }
        // Join rule: hole sets must agree on every edge into a block.
        const term = f.blocks[b].term;
        let k: usize = 0;
        while (k < succCount(term)) {
          const s = succAt(term, k);
          if (!holesEq(t.holes, ins[s].unwrap().holes)) {
            rep.errors.push(
              issue(
                f,
                b,
                f.blocks[b].instrs.length,
                "hole sets differ at the join into block " + s.toString(),
              ),
            );
          }
          k += 1;
        }
      },
    }
    b += 1;
  }
  // Rule U1: every unchecked array access needs a fact (a dominating access, or interval facts; unchecked.or, range.or)
  let seen: bool[] = [];
  for (const st of ins) {
    seen.push(st.isSome());
  }
  const facts = accessFacts(p, f, seen);
  let q: usize = 0;
  while (q < facts.length) {
    if (facts[q + 2] == 0) {
      rep.errors.push(
        issue(
          f,
          facts[q],
          facts[q + 1],
          "unchecked array access without a dominating check or a range fact: no earlier access of the same array and index"
              + " reaches it unchanged within the block, and the intervals do not show that the index is below the array length",
        ),
      );
    }
    q += 3;
  }
  // Rule U6: every unchecked struct slot access needs an earlier checked access of the same struct local (fieldcheck.or)
  for (const x of fieldFacts(p, f, seen)) {
    if (!x.ok) {
      rep.errors.push(
        issue(
          f,
          x.block,
          x.instr,
          "unchecked struct slot access without a dominating check: no earlier access of the same struct local with a slot"
              + " at least as high reaches it within the block",
        ),
      );
    }
  }
  return rep;
}

// A vtable entry (v1.5) takes the boxed value as its first parameter (a reference) and has only borrowed parameters;
// "" when it does.
function vtableMsg(prog: MProgram, g: usize): string {
  if (g >= prog.functions.length) {
    return "vtable entry: function index out of range";
  }
  const h = prog.functions[g];
  if (h.paramCount == 0 || h.locals.length == 0 || localClass(h, 0) != CRef) {
    return "vtable entry " + h.name
        + " must take the boxed value (a reference) as its first parameter";
  }
  if (h.paramOwned.some(o => o)) {
    return "vtable entry " + h.name + " must have only borrowed parameters";
  }
  return "";
}

// The reports of the functions lo..hi-1 of `prog`, in order.
function verifyRange(prog: MProgram, lo: usize, hi: usize): VerifyReport[] {
  let out: VerifyReport[] = [];
  let i = lo;
  while (i < hi) {
    out.push(verifyFunction(prog, prog.functions[i]));
    i += 1;
  }
  return out;
}

// Verifies every function of `prog`. No error means the program is well-formed (`isWellFormedProgram`, compiler/mir)
// and every function follows the ownership discipline of docs/mir.md. Every issue names something that exists.
@Ensures(result.errors.length == 0 ==> isWellFormedProgram(prog))
@Ensures(reportPlaced(prog, result.errors) && reportPlaced(prog, result.warnings))
export function verify(prog: MProgram): VerifyReport {
  let rep = VerifyReport { errors: [], warnings: [] };
  if (prog.main >= prog.functions.length) {
    rep.errors.push(VerifyIssue {
      func: "<program>",
      block: 0,
      instr: 0,
      message: "main function index out of range",
      span: noSpan(),
    });
  }
  if (prog.main < prog.functions.length && prog.functions[prog.main].uniqueIn) {
    rep.errors.push(VerifyIssue {
      func: prog.functions[prog.main].name,
      block: 0,
      instr: 0,
      message: "main is called by the runtime and cannot be a unique-in function (rule U2)",
      span: noSpan(),
    });
  }
  for (const v of prog.vtables) {
    for (const g of v.funcs) {
      const msg = vtableMsg(prog, g);
      if (msg != "") {
        rep.errors.push(VerifyIssue {
          func: v.name,
          block: 0,
          instr: 0,
          message: msg,
          span: noSpan(),
        });
      }
    }
  }
  // Pieces of 64 consecutive functions, verified on the task pool with `prog` lent (ADR-0049 row 14); the pieces come
  // back in index order, so the issues are appended function by function as the sequential loop did. `prog` is not used
  // after the call but by the contracts.
  const n = prog.functions.length;
  const pieces = mapChunksLent(prog, n, 64, (lo: usize, hi: usize) => verifyRange(prog, lo, hi));
  for (const reports of pieces) {
    for (const r of reports) {
      for (const e of r.errors) {
        rep.errors.push(e);
      }
      for (const w of r.warnings) {
        rep.warnings.push(w);
      }
    }
  }
  return rep;
}

// Abstract in-state of every block of a well-formed function (None = unreachable). Used by the
// optimiser (compiler/opt) to query ownership kinds; replay a block with `step` from rules.or.
@Requires(isWellFormedFunction(p, f) && wfFunction(f) == "")
@Ensures(result.length == f.blocks.length && result[0].isSome())
@Ensures(statesSized(result, f.locals.length))
export function blockInStates(p: MProgram, f: MFunction): Option<State>[] {
  let fx = new Fixpoint(p, f);
  fx.run();
  return fx.ins;
}
