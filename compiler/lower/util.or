// Lowering helpers (pure): type mapping, effect analysis, string-literal table.

import {
  Type, Program, HBlock, HStmt, Place, HExpr, HArm, FieldInitH, intKindOf, kindUnsigned64,
} from "../hir";
import { MType } from "../mir";

@Ensures(match (t) {
  TyInt => !result,
  TyUsize => !result,
  TyBool => !result,
  TyFloat => !result,
  TyF32 => !result,
  TyFile => !result,
  TyVoid => !result,
  TyString => result,
  _ => true,
})
export function isRefTy(t: Type): bool {
  return match (t) {
    TyInt => false,
    TyUsize => false,
    TyIntK(_) => false,
    TyBool => false,
    TyFloat => false,
    TyF32 => false,
    TyFile => false,
    TyGrant(_) => false,
    TyVoid => false,
    _ => true,
  };
}

@Ensures(match (t) {
  TyFile => result,
  TyInt => !result,
  TyString => !result,
  TyVoid => !result,
  _ => true,
})
export function isHandleTy(t: Type): bool {
  return match (t) {
    TyFile => true,
    TyGrant(_) => true,
    _ => false,
  };
}

@Ensures(match (t) {
  TyVoid => result,
  TyInt => !result,
  TyString => !result,
  TyFile => !result,
  _ => true,
})
export function isVoidTy(t: Type): bool {
  return match (t) {
    TyVoid => true,
    _ => false,
  };
}

// Types held in an MUsize: usize and u64 (every other integer type is an MInt, ADR-0022).
export function isUsizeTy(t: Type): bool {
  const k = intKindOf(t);
  return k >= 0 && kindUnsigned64(k);
}

export function isF32Ty(t: Type): bool {
  return match (t) {
    TyF32 => true,
    _ => false,
  };
}

export function isStringTy(t: Type): bool {
  return match (t) {
    TyString => true,
    _ => false,
  };
}

// The MIR class of a type: references are exactly the heap types, `void` and the handles map to themselves.
@Ensures(isRefTy(t) == mtyIsRef(result))
@Ensures(isVoidTy(t) == mtyIsVoid(result))
@Ensures(isHandleTy(t) == mtyIsHandle(result))
export function mty(t: Type): MType {
  return match (t) {
    TyInt => MInt,
    TyUsize => MUsize,
    TyIntK(k) => kindUnsigned64(k.toInt()) ? MUsize : MInt,
    TyBool => MBool,
    TyFloat => MFloat,
    TyF32 => MFloat,
    TyFile => MHandle,
    TyGrant(_) => MHandle,
    TyVoid => MVoid,
    _ => MRef,
  };
}

// ---------------------------------------------------------------- MIR types

function mtyRank(t: MType): int {
  return match (t) {
    MInt => 0,
    MUsize => 1,
    MBool => 2,
    MFloat => 3,
    MHandle => 4,
    MRef => 5,
    MVoid => 6,
    MAgg(n) => 10 + n.toInt(),
  };
}

export function mtyEq(a: MType, b: MType): bool {
  return mtyRank(a) == mtyRank(b);
}

@Ensures(match (t) {
  MRef => result,
  _ => !result,
})
export function mtyIsRef(t: MType): bool {
  return match (t) {
    MRef => true,
    _ => false,
  };
}

@Ensures(match (t) {
  MVoid => result,
  _ => !result,
})
export function mtyIsVoid(t: MType): bool {
  return match (t) {
    MVoid => true,
    _ => false,
  };
}

@Ensures(match (t) {
  MHandle => result,
  _ => !result,
})
export function mtyIsHandle(t: MType): bool {
  return match (t) {
    MHandle => true,
    _ => false,
  };
}

// ---------------------------------------------------------------- effects

// A simple expression (a constant, a local, a field of one) cannot change a local.
@Ensures(result ==> !hasEffects(e))
export function isSimple(e: HExpr): bool {
  return match (e.kind) {
    XInt(_) => true,
    XFloat(_) => true,
    XBool(_) => true,
    XStr(_) => true,
    XLocal(_) => true,
    XField(b, _, _) => isSimple(b),
    _ => false,
  };
}

export function anyEffects(xs: HExpr[]): bool {
  for (const x of xs) {
    if (hasEffects(x)) {
      return true;
    }
  }
  return false;
}

export function armHasEffects(a: HArm): bool {
  if (a.body.stmts.length != 0) {
    return true;
  }
  return match (a.value) {
    Some(v) => hasEffects(v),
    None => false,
  };
}

export function armsHaveEffects(arms: HArm[]): bool {
  for (const a of arms) {
    if (armHasEffects(a)) {
      return true;
    }
  }
  return false;
}

// May evaluating `e` change the value of a local?
export function hasEffects(e: HExpr): bool {
  return match (e.kind) {
    XInt(_) => false,
    XFloat(_) => false,
    XBool(_) => false,
    XStr(_) => false,
    XLocal(_) => false,
    XUnary(_, x) => hasEffects(x),
    XBinary(_, a, b) => hasEffects(a) || hasEffects(b),
    XCall(_, args) => anyEffects(args),
    XBuiltin(_, args) => anyEffects(args),
    XMutMethod(_, _, _) => true,
    XField(b, _, _) => hasEffects(b),
    XIndex(b, i) => hasEffects(b) || hasEffects(i),
    XRecord(_, sp, fields) => recordHasEffects(sp, fields),
    XVariant(_, payload) => anyEffects(payload),
    XArray(xs) => anyEffects(xs),
    XTry(x) => hasEffects(x),
    XCond(c, a, b) => hasEffects(c) || hasEffects(a) || hasEffects(b),
    XMatch(s, arms) => hasEffects(s) || armsHaveEffects(arms),
    XClosure(_, caps) => anyEffects(caps),
    XCallIndirect(f, args) => hasEffects(f) || anyEffects(args),
    XIface(_, v) => hasEffects(v),
    XCallVirtual(r, _, args) => hasEffects(r) || anyEffects(args),
  };
}

function recordHasEffects(sp: Option<HExpr>, fields: FieldInitH[]): bool {
  const spe = match (sp) {
    Some(x) => hasEffects(x),
    None => false,
  };
  if (spe) {
    return true;
  }
  for (const f of fields) {
    if (hasEffects(f.value)) {
      return true;
    }
  }
  return false;
}

// ---------------------------------------------------------------- string literals

// `pre`: function id (or -1) of the prelude implementation of each moved built-in, indexed by
// `preludeSlot` (prelude.or); empty when the program has no prelude (--c-builtins).
export type Lits = { strs: string[]; buckets: usize[][]; pre: int[]; };

@Ensures(result < 1021)
function litBucket(s: string): usize {
  let h: usize = 7;
  let i: usize = 0;
  while (i < s.length && i < 12) {
    h = (h * 31 + s.charCodeAt(i).toUsize()) % 1021;
    i += 1;
  }
  return (h + s.length) % 1021;
}

@Ensures(result.buckets.length == 1021)
function newLits(): Lits {
  let b: usize[][] = [];
  const empty: usize[] = [];
  let i: usize = 0;
  @Invariant(i <= 1021 && b.length == i)
  while (i < 1021) {
    b.push(empty);
    i += 1;
  }
  const strs: string[] = [];
  const pre: int[] = [];
  return Lits { strs: strs, buckets: b, pre: pre };
}

@Ensures(result.isSome() ==> result.unwrap() < l.strs.length && l.strs[result.unwrap()] == s)
function findLit(l: Lits, s: string): Option<usize> {
  const bucket = l.buckets[litBucket(s)];
  for (const id of bucket) {
    if (l.strs[id] == s) {
      return Some(id);
    }
  }
  return None;
}

// The index of a literal in the string table. Every literal of the program was collected (`collectLits`), so a missing one
// is a lowering bug; the old code answered 0 and silently used another string.
@Requires(findLit(l, s).isSome())
@Ensures(result < l.strs.length && l.strs[result] == s)
export function litId(l: Lits, s: string): usize {
  return match (findLit(l, s)) {
    Some(i) => i,
    None => 0,
  };
}

function lexprs(xs: HExpr[]): string[] {
  let out: string[] = [];
  for (const x of xs) {
    for (const s of lexpr(x)) {
      out.push(s);
    }
  }
  return out;
}

function lblock(b: HBlock): string[] {
  let out: string[] = [];
  for (const s of b.stmts) {
    for (const t of lstmt(s)) {
      out.push(t);
    }
  }
  return out;
}

function lplace(p: Place): string[] {
  let out: string[] = [];
  for (const el of p.path) {
    match (el) {
      PIndex(ix) => {
        for (const s of lexpr(ix)) {
          out.push(s);
        }
      },
      PField(_, _) => {},
    }
  }
  return out;
}

function lopt(o: Option<HExpr>): string[] {
  return match (o) {
    Some(x) => lexpr(x),
    None => [],
  };
}

function lstmt(s: HStmt): string[] {
  return match (s) {
    HLet(_, e) => lexpr(e),
    HAssign(p, _, e) => lplace(p).concat(lexpr(e)),
    HExprStmt(e) => lexpr(e),
    HIf(c, t, el) => lexpr(c).concat(lblock(t)).concat(lblockOpt(el)),
    HWhile(c, b) => lexpr(c).concat(lblock(b)),
    HForOf(_, it, b) => lexpr(it).concat(lblock(b)),
    HBreak => [],
    HContinue => [],
    HReturn(e) => lopt(e),
    HBlockStmt(b) => lblock(b),
  };
}

function lblockOpt(b: Option<HBlock>): string[] {
  return match (b) {
    Some(x) => lblock(x),
    None => [],
  };
}

function larm(a: HArm): string[] {
  const pat: string[] = match (a.pattern) {
    HPStr(s) => [s],
    _ => [],
  };
  return pat.concat(lblock(a.body)).concat(lopt(a.value));
}

function lexpr(e: HExpr): string[] {
  return match (e.kind) {
    XInt(_) => [],
    XFloat(_) => [],
    XBool(_) => [],
    XStr(s) => [s],
    XLocal(_) => [],
    XUnary(_, x) => lexpr(x),
    XBinary(_, a, b) => lexpr(a).concat(lexpr(b)),
    XCall(_, args) => lexprs(args),
    XBuiltin(_, args) => lexprs(args),
    XMutMethod(_, p, args) => lplace(p).concat(lexprs(args)),
    XField(b, _, _) => lexpr(b),
    XIndex(b, i) => lexpr(b).concat(lexpr(i)),
    XRecord(_, sp, fields) => lopt(sp).concat(lfields(fields)),
    XVariant(_, payload) => lexprs(payload),
    XArray(xs) => lexprs(xs),
    XTry(x) => lexpr(x),
    XCond(c, a, b) => lexpr(c).concat(lexpr(a)).concat(lexpr(b)),
    XMatch(s, arms) => lexpr(s).concat(larms(arms)),
    XClosure(_, caps) => lexprs(caps),
    XCallIndirect(f, args) => lexpr(f).concat(lexprs(args)),
    XIface(_, v) => lexpr(v),
    XCallVirtual(r, _, args) => lexpr(r).concat(lexprs(args)),
  };
}

function lfields(fs: FieldInitH[]): string[] {
  let out: string[] = [];
  for (const f of fs) {
    for (const s of lexpr(f.value)) {
      out.push(s);
    }
  }
  return out;
}

function larms(arms: HArm[]): string[] {
  let out: string[] = [];
  for (const a of arms) {
    for (const s of larm(a)) {
      out.push(s);
    }
  }
  return out;
}

// The string table of a program: its literals, deduplicated, in first-use order; every bucket entry indexes the table.
@Ensures(result.buckets.length == 1021 && result.pre.length == 0)
export function collectLits(prog: Program): Lits {
  let lits = newLits();
  @Invariant(lits.buckets.length == 1021)
  for (const f of prog.functions) {
    @Invariant(lits.buckets.length == 1021)
    for (const s of lblock(f.body)) {
      if (findLit(lits, s).isNone()) {
        const id = lits.strs.length;
        lits.strs.push(s);
        lits.buckets[litBucket(s)].push(id);
      }
    }
  }
  return lits;
}

// `n.toString()` of an int or usize, and so `${n}` of a template (ADR-0038 addendum 2026-10-16): the number being
// converted. The lowering appends its digits (IStrAppendNum) instead of building a temporary string.
export function numTextArg(e: HExpr): Option<HExpr> {
  return match (e.kind) {
    XBuiltin(b, args) => match (b) {
      BIntToString => Some(args[0]),
      BUsizeToString => Some(args[0]),
      _ => None,
    },
    _ => None,
  };
}

export function numTextUnsigned(e: HExpr): bool {
  return match (e.kind) {
    XBuiltin(b, _) => match (b) {
      BUsizeToString => true,
      _ => false,
    },
    _ => false,
  };
}
