// Pair-return elimination (stage 5 of the MIR optimiser; docs/mir.md v1.10 "In/out receiver").
//
// A mutating method with a result returns a freshly built two-slot record `{ self, value }` (ADR-0009): the
// callee allocates it, the caller reads both slots and releases it. For a method called in a loop that is one
// allocation, one retain and one release (plus the free) per call, for a value that never escapes.
//
// A function f is a *pair function* when its first parameter is an owned reference and every `return` returns
// a record built in the same block, `r = struct tag0 {a, v}; [releases]; return r`, whose first slot `a` is a
// reference local. The pass turns f into an `inout` function: it returns `v` directly and hands `a` back
// through parameter 0 (`l0 = move a` before the return), see docs/mir.md. Every call site
//
//     d = call f(x, args)                 =>      v = call f(x, args)        -- x now holds the updated receiver
//                                                 d = struct tag0 {x, v}     -- only if d escapes
//
// and, because the destructuring that follows is almost always `getfield d.0; dup; ..; getfield d.1; ..;
// release d` inside one block, the record is not built at all (scalar replacement): `getfield d.0` becomes a
// borrow of x, `getfield d.1` a borrow or copy of v, `release d` releases x and v, and `t = getfield d.0;
// u = dup t` becomes `u = move x`. The record may be moved to other locals first (`l4 = move d`), and its
// release may be in another block (the end of the scope of an `if (m.put(..))` condition, ADR-0038 census) when
// the receiver was moved out by `u = move x`: that release then only releases v (a reference) or nothing. If d is
// used in any other way (stored, passed, returned, read in another block, or a component is reassigned while d is
// live) the record is rebuilt at the call, exactly as before.

// Functions that are closure targets or vtable entries, and `main`, keep their signature.
//
// The result is checked by the verifier like any other MIR (the inout rules are in docs/mir.md).

import { MProgram, MFunction, MBlock, MLocal, MType, Instr, Operand, Terminator } from "../mir";
import { Span } from "../diag";
import { Locals, mtyEq } from "../lower";
import { State, Transfer, lsKind, blockInStates, KDead } from "../verify";
import { Counts, countsOf, UseBuf, instrDef, isRefTy } from "./analysis";
import { BlockSink, RewritePlan, withBody, indices } from "./rewrite";
import { fnWellFormed, progWellFormed, passKept, sameSignature } from "./wellformed";

// A distinct code per type (MType has no equality of its own).
function tyCode(t: MType): int {
  return match (t) {
    MInt => 0,
    MUsize => 1,
    MBool => 2,
    MFloat => 3,
    MHandle => 4,
    MRef => 5,
    MVoid => 6,
    MAgg(n) => 10 + n.toInt(),
  };
}

function operandTy(f: MFunction, o: Operand): MType {
  return match (o) {
    OLocal(l) => f.locals[l].ty,
    OInt(_) => MInt,
    OUsize(_) => MUsize,
    OBool(_) => MBool,
    OFloat(_) => MFloat,
    OStr(_) => MRef,
  };
}

@Ensures(match (o) {
  OLocal(m) => result == (m == l),
  _ => !result,
})
function isLocalOp(o: Operand, l: usize): bool {
  return match (o) {
    OLocal(m) => m == l,
    _ => false,
  };
}

// ---------------------------------------------------------------- the callee side

// One `return` of a pair function: the record is built by instruction `at` of block `block`.
export type RetSite = { block: usize; at: usize; a: usize; v: Operand; };

export type PairShape = { ok: bool; ty: MType; sites: RetSite[]; };

function noShape(): PairShape {
  return PairShape { ok: false, ty: MVoid, sites: [] };
}

// Every `return` of f is a site of the shape and every site is a `return` block whose instruction `at` builds the two-slot
// record with a reference local first. Catches a return the conversion would miss (the caller would read the record
// as the value) and a site that points at the wrong instruction (the record would be kept and leak, or a different
// instruction would be removed).
export function sitesCoverReturns(f: MFunction, sh: PairShape): bool {
  let b: usize = 0;
  while (b < f.blocks.length) {
    const blk = f.blocks[b];
    const isRet = match (blk.term) {
      TReturn(_) => true,
      _ => false,
    };
    const k = b;
    const n = sh.sites.filter(st => st.block == k).length;
    if (isRet ? n != 1 : n != 0) {
      return false;
    }
    b += 1;
  }
  return sh.sites.every(
    st => st.block < f.blocks.length
        && st.at < f.blocks[st.block].instrs.length
        && match (f.blocks[st.block].instrs[st.at]) {
          IStructNew(_, tag, slots) => tag == 0 && slots.length == 2 && isLocalOp(slots[0], st.a),
          _ => false,
        },
  );
}

// The pair shape of f (or not ok). `pinned`: f is called through a function value.
@Requires(fi < p.functions.length && pinned.length == p.functions.length)
@Ensures(!result.ok || sitesCoverReturns(p.functions[fi], result))
function pairShape(p: MProgram, fi: usize, pinned: bool[]): PairShape {
  const f = p.functions[fi];
  if (pinned[fi]
      || fi == p.main
      || f.inout
      || f.paramCount == 0
      || !f.paramOwned[0]
      || !isRefTy(f.locals[0].ty)
      || !isRefTy(f.ret)) {
    return noShape();
  }
  const cnt = countsOf(f);
  let sites: RetSite[] = [];
  let ty: MType = MVoid;
  let have = false;
  let states: Option<State>[] = [];
  let haveStates = false;
  let b: usize = 0;
  while (b < f.blocks.length) {
    const blk = f.blocks[b];
    match (blk.term) {
      TReturn(ro) => {
        match (ro) {
          Some(o) => {
            match (o) {
              OLocal(r) => {
                // the last definition of r in the block must be the record
                let at: usize = blk.instrs.length;
                let k: usize = 0;
                while (k < blk.instrs.length) {
                  match (instrDef(blk.instrs[k])) {
                    Some(d) => {
                      if (d == r) {
                        at = k;
                      }
                    },
                    None => {},
                  }
                  k += 1;
                }
                if (at == blk.instrs.length || cnt.uses[r] != 1 || cnt.defs[r] != 1) {
                  return noShape();
                }
                match (blk.instrs[at]) {
                  IStructNew(_, tag, slots) => {
                    if (tag != 0 || slots.length != 2) {
                      return noShape();
                    }
                    match (slots[0]) {
                      OLocal(a) => {
                        if (!isRefTy(f.locals[a].ty)) {
                          return noShape();
                        }
                        const vt = operandTy(f, slots[1]);
                        if (tyCode(vt) == 4 || tyCode(vt) == 6) {
                          return noShape();
                        }
                        if (have && tyCode(vt) != tyCode(ty)) {
                          return noShape();
                        }
                        ty = vt;
                        have = true;
                        // only releases of other locals may follow the record
                        let m = at + 1;
                        while (m < blk.instrs.length) {
                          match (blk.instrs[m]) {
                            IRelease(z) => {
                              if (z == r || z == a || isLocalOp(slots[1], z)) {
                                return noShape();
                              }
                            },
                            _ => {
                              return noShape();
                            },
                          }
                          m += 1;
                        }
                        if (a != 0) {
                          // parameter 0 must be dead where the record is built: it receives the new receiver
                          if (!haveStates) {
                            states = blockInStates(p, f);
                            haveStates = true;
                          }
                          match (states[b]) {
                            Some(st0) => {
                              let rp = new Transfer(p, f, b, 0, st0, [], []);
                              let j: usize = 0;
                              while (j < at) {
                                rp.ins = j;
                                rp.step(blk.instrs[j]);
                                j += 1;
                              }
                              if (lsKind(rp.ls[0]) != KDead) {
                                return noShape();
                              }
                            },
                            None => {},
                          }
                        }
                        sites.push(RetSite { block: b, at: at, a: a, v: slots[1] });
                      },
                      _ => {
                        return noShape();
                      },
                    }
                  },
                  _ => {
                    return noShape();
                  },
                }
              },
              _ => {
                return noShape();
              },
            }
          },
          None => {
            return noShape();
          },
        }
      },
      _ => {},
    }
    b += 1;
  }
  if (!have) {
    return noShape();
  }
  return PairShape { ok: true, ty: ty, sites: sites };
}

// f as an inout function returning the second slot.
@Requires(sh.ok && sitesCoverReturns(f, sh))
@Ensures(convertedOk(f, result) && mtyEq(result.ret, sh.ty))
function convertCallee(f: MFunction, sh: PairShape): MFunction {
  let blocks: MBlock[] = [];
  let b: usize = 0;
  while (b < f.blocks.length) {
    const blk = f.blocks[b];
    let site: Option<RetSite> = None;
    for (const s of sh.sites) {
      if (s.block == b) {
        site = Some(s);
      }
    }
    match (site) {
      None => {
        blocks.push(blk);
      },
      Some(s) => {
        let out: Instr[] = [];
        let sps: Span[] = [];
        let k: usize = 0;
        while (k < blk.instrs.length) {
          if (k != s.at) {
            out.push(blk.instrs[k]);
            sps.push(blk.spans[k]);
          }
          k += 1;
        }
        if (s.a != 0) {
          out.push(IMove(0, s.a));
          sps.push(blk.spans[s.at]);
        }
        blocks.push(MBlock {
          instrs: out,
          spans: sps,
          term: TReturn(Some(s.v)),
          termSpan: blk.termSpan,
        });
      },
    }
    b += 1;
  }
  return MFunction {
    name: f.name,
    paramCount: f.paramCount,
    paramOwned: f.paramOwned,
    inout: true,
    uniqueIn: false,
    uniqueOut: false,
    locals: f.locals,
    ret: sh.ty,
    blocks: blocks,
  };
}

// ---------------------------------------------------------------- the call sites

// Replacement plan for the instructions after a call whose record `d` is destructured in the same block. `remote` are the
// aliases of the record released in other blocks; each such release becomes `remoteRep` (a release of v, or nothing).
@Invariant(!this.ok || this.hit.length == this.rep.length)
type Sra = { ok: bool; hit: bool[]; rep: Instr[][]; remote: usize[]; remoteRep: Instr[]; };

// The locals that hold the record of an in/out call while it is destructured: the call's destination first, then the
// locals it is moved to, each with the number of its uses seen so far in the call's block (`counted`, of which
// `released` are releases). The plan holds only when every alias is used exactly by the instructions that the plan
// rewrites: the counted uses in the block plus the releases in other blocks (`complete`).
@Invariant(this.alias.length == this.counted.length && this.alias.length == this.released.length)
@Invariant(this.alias.length >= 1)
class RecordAliases {
  private alias: usize[];
  private counted: usize[];
  private released: usize[];

  constructor(d: usize) {
    this.alias = [d];
    this.counted = [0];
    this.released = [0];
  }

  // The aliases, the call's destination first.
  all(): usize[] {
    return this.alias;
  }

  // Counts a release of the alias `a` in the call's block.
  @Requires(this.has(a))
  @Ensures(this.alias.length == old(this.alias.length))
  release(a: usize): void {
    this.use(a);
    let k: usize = 0;
    while (this.alias[k] != a) {
      k += 1;
    }
    this.released[k] += 1;
  }

  // Some alias is released in another block (`relTotal[l]`: the releases of local l in the whole function).
  remote(relTotal: usize[]): bool {
    let k: usize = 0;
    while (k < this.alias.length) {
      if (relTotal[this.alias[k]] > this.released[k]) {
        return true;
      }
      k += 1;
    }
    return false;
  }

  has(l: usize): bool {
    return this.alias.includes(l);
  }

  // Counts a use of the alias `a`.
  @Requires(this.has(a))
  @Ensures(this.alias.length == old(this.alias.length))
  use(a: usize): void {
    let k: usize = 0;
    while (this.alias[k] != a) {
      k += 1;
    }
    this.counted[k] += 1;
  }

  // `a2 = move a`: a2 is an alias too.
  @Requires(!this.has(a2))
  @Ensures(this.has(a2) && this.alias.length == old(this.alias.length) + 1)
  add(a2: usize): void {
    this.alias.push(a2);
    this.counted.push(0);
    this.released.push(0);
  }

  // Every alias is used exactly as often as counted in the block plus its releases in other blocks (no use the plan
  // does not rewrite).
  complete(cnt: Counts, relTotal: usize[]): bool {
    let k: usize = 0;
    while (k < this.alias.length) {
      const a = this.alias[k];
      if (relTotal[a] < this.released[k]
          || cnt.uses[a] != this.counted[k] + relTotal[a] - this.released[k]) {
        return false;
      }
      k += 1;
    }
    return true;
  }
}

// The number of `release l` instructions of every local l of f.
@Ensures(result.length == f.locals.length)
export function releaseTotals(f: MFunction): usize[] {
  let out: usize[] = f.locals.map(l => 0);
  for (const blk of f.blocks) {
    for (const ins of blk.instrs) {
      match (ins) {
        IRelease(x) => {
          if (x < out.length) {
            out[x] += 1;
          }
        },
        _ => {},
      }
    }
  }
  return out;
}

// The plan of a scalar replacement touches only instructions after the call `i`.
function laterOnly(r: Sra, i: usize): bool {
  let k: usize = 0;
  while (k <= i && k < r.hit.length) {
    if (r.hit[k]) {
      return false;
    }
    k += 1;
  }
  return true;
}

function noSra(): Sra {
  return Sra { ok: false, hit: [], rep: [], remote: [], remoteRep: [] };
}

// Plan the scalar replacement of the record `d` built by the call at index `i` of `blk`; x and v are the
// locals that hold its two components after the call (v is a reference iff vRef; v is a fresh local, defined only by
// the call). `relTotal[l]`: the releases of local l in the whole function.
@Requires(i < blk.instrs.length && d < cnt.uses.length && relTotal.length == cnt.uses.length)
@Ensures(!result.ok || result.hit.length == blk.instrs.length && laterOnly(result, i))
@Ensures(!result.ok || result.remoteRep.length <= 1)
function planSra(
  blk: MBlock,
  cnt: Counts,
  relTotal: usize[],
  i: usize,
  d: usize,
  x: usize,
  v: usize,
  vRef: bool,
): Sra {
  const n = blk.instrs.length;
  let hit: bool[] = [];
  let rep: Instr[][] = [];
  let k: usize = 0;
  while (k < n) {
    hit.push(false);
    rep.push([]);
    k += 1;
  }
  if (cnt.defs[d] != 1) {
    return noSra();
  }
  let ra = new RecordAliases(d);
  let ub = new UseBuf();
  let clobbered = false;
  let gets0: usize[] = [];
  let gets1: usize[] = [];
  let releases: usize[] = [];
  let j = i + 1;
  while (j < n) {
    const ins = blk.instrs[j];
    let handled = false;
    match (ins) {
      IGetField(t, o, slot) => {
        match (o) {
          OLocal(a) => {
            if (ra.has(a)) {
              handled = true;
              if (clobbered || slot > 1 || t == x || t == v || ra.has(t)) {
                return noSra();
              }
              ra.use(a);
              if (slot == 0) {
                gets0.push(j);
              } else {
                gets1.push(j);
              }
              hit[j] = true;
            }
          },
          _ => {},
        }
      },
      IRelease(a) => {
        if (ra.has(a)) {
          handled = true;
          if (clobbered) {
            return noSra();
          }
          ra.release(a);
          releases.push(j);
          hit[j] = true;
        }
      },

      IMove(a2, a) => {
        if (ra.has(a)) {
          handled = true;
          if (clobbered || cnt.defs[a2] != 1 || a2 == x || a2 == v || ra.has(a2)) {
            return noSra();
          }
          ra.use(a);
          ra.add(a2);
          hit[j] = true;
        }
      },
      _ => {},
    }
    if (!handled) {
      ub.ofInstr(ins);
      let q: usize = 0;
      while (q < ub.n) {
        if (ra.has(ub.xs[q])) {
          return noSra();
        }
        q += 1;
      }
      match (instrDef(ins)) {
        Some(df) => {
          if (ra.has(df)) {
            return noSra();
          }
          if (df == x || df == v) {
            clobbered = true;
          }
        },
        None => {},
      }
    }
    j += 1;
  }
  ub.ofTerm(blk.term);
  let q: usize = 0;
  while (q < ub.n) {
    if (ra.has(ub.xs[q])) {
      return noSra();
    }
    q += 1;
  }
  if (!ra.complete(cnt, relTotal)) {
    return noSra();
  }

  // last use of a component by `t = getfield d.k; u = dup t` is a move of the component
  let movedX = false;
  let movedV = false;
  if (gets0.length == 1) {
    const g = gets0[0];
    match (blk.instrs[g]) {
      IGetField(t, _, _) => {
        if (g + 1 < n && cnt.uses[t] == 1) {
          match (blk.instrs[g + 1]) {
            IDup(u, o) => {
              if (isLocalOp(o, t) && u != x) {
                rep[g] = [];
                hit[g + 1] = true;
                rep[g + 1] = [IMove(u, x)];
                movedX = true;
              }
            },
            _ => {},
          }
        }
      },
      _ => {},
    }
  }
  if (vRef && gets1.length == 1) {
    const g = gets1[0];
    match (blk.instrs[g]) {
      IGetField(t, _, _) => {
        if (g + 1 < n && cnt.uses[t] == 1) {
          match (blk.instrs[g + 1]) {
            IDup(u, o) => {
              if (isLocalOp(o, t) && u != v && !hit[g + 1]) {
                rep[g] = [];
                hit[g + 1] = true;
                rep[g + 1] = [IMove(u, v)];
                movedV = true;
              }
            },
            _ => {},
          }
        }
      },
      _ => {},
    }
  }
  for (const g of gets0) {
    if (!movedX) {
      match (blk.instrs[g]) {
        IGetField(t, _, _) => {
          rep[g] = [IBorrow(t, x)];
        },
        _ => {},
      }
    }
  }
  for (const g of gets1) {
    if (!movedV) {
      match (blk.instrs[g]) {
        IGetField(t, _, _) => {
          rep[g] = vRef ? [IBorrow(t, v)] : [ICopy(t, OLocal(v))];
        },
        _ => {},
      }
    }
  }
  for (const r of releases) {
    let rs: Instr[] = [];
    if (!movedX) {
      rs.push(IRelease(x));
    }
    if (vRef && !movedV) {
      rs.push(IRelease(v));
    }
    rep[r] = rs;
  }
  if (!ra.remote(relTotal)) {
    return Sra { ok: true, hit: hit, rep: rep, remote: [], remoteRep: [] };
  }
  // A release in another block: only when the receiver was moved out (x may be redefined before that release; v is
  // fresh, so releasing it there releases exactly what the record's release did).
  if (!movedX) {
    return noSra();
  }
  const rr: Instr[] = vRef && !movedV ? [IRelease(v)] : [];
  return Sra { ok: true, hit: hit, rep: rep, remote: ra.all(), remoteRep: rr };
}

// Does f call a function that `conv` converts?
function callsConverted(conv: Option<MType>[], f: MFunction): bool {
  return f.blocks.some(
    blk => blk.instrs.some(
      ins => match (ins) {
        ICall(_, g, _) => conv[g].isSome(),
        _ => false,
      },
    ),
  );
}

// One call of a converted function, as planned before the function is rewritten: the call at instruction `at` of block
// `block`, the local `x` that passes the receiver (`direct`: the argument's own local, else a fresh one the argument is
// moved or copied into), the fresh local `v` of the value, and the scalar replacement of its record (`plan.ok`) or not.
type PairCall = { block: usize; at: usize; x: usize; direct: bool; v: usize; plan: Sra; };

// The planned calls of a function and its locals table with the fresh locals they need.
type Planned = { sites: PairCall[]; locals: MLocal[]; };

// The calls of converted functions in f, in block and instruction order, with the fresh locals they need appended to the
// locals of f (in the order of one pass over the blocks).
@Requires(conv.length == p.functions.length)
@Ensures(result.sites.every(
  s => s.block < f.blocks.length && s.at < f.blocks[s.block].instrs.length,
))
@Ensures(result.locals.length >= f.locals.length)
function planCalls(
  p: MProgram,
  conv: Option<MType>[],
  f: MFunction,
  cnt: Counts,
  relTotal: usize[],
): Planned {
  let locals = new Locals(f.locals);
  let out: PairCall[] = [];
  let b: usize = 0;
  while (b < f.blocks.length) {
    const blk = f.blocks[b];
    let i: usize = 0;
    while (i < blk.instrs.length) {
      match (blk.instrs[i]) {
        ICall(dst, g, args) => {
          if (g < conv.length && conv[g].isSome()) {
            const vty = conv[g].unwrap();
            // the in/out argument: a local of its own (the call redefines it)
            let x: usize = 0;
            let direct = false;
            match (args[0]) {
              OLocal(x0) => {
                const isDst = match (dst) {
                  Some(dd) => dd == x0,
                  None => false,
                };
                if (x0 >= f.paramCount && !isDst) {
                  x = x0;
                  direct = true;
                }
              },
              _ => {},
            }
            if (!direct) {
              x = locals.fresh(MRef);
            }
            const v = locals.fresh(vty);
            const plan = match (dst) {
              Some(d) => planSra(blk, cnt, relTotal, i, d, x, v, isRefTy(vty)),
              None => noSra(),
            };
            out.push(PairCall { block: b, at: i, x: x, direct: direct, v: v, plan: plan });
          }
        },
        _ => {},
      }
      i += 1;
    }
    b += 1;
  }
  return Planned { sites: out, locals: locals.table() };
}

// Rewrite the calls of converted functions in f. `conv[g]`: the type of the value function g now returns. The calls are
// the same calls in the same order (the record they returned is built after the call, or not at all). First every call
// is planned (`planCalls`): a plan may remove a release in another block, which can come before the call's block.
@Requires(conv.length == p.functions.length && fnWellFormed(p, f))
@Ensures(passKept(f, result) && result.blocks.length == f.blocks.length)
function rewriteCalls(p: MProgram, conv: Option<MType>[], f: MFunction): MFunction {
  if (!callsConverted(conv, f)) {
    return f;
  }
  const cnt = countsOf(f);
  const relTotal = releaseTotals(f);
  const planned = planCalls(p, conv, f, cnt, relTotal);
  const sites = planned.sites;
  // releases of record aliases in other blocks, and what each becomes
  let remote: bool[] = f.locals.map(l => false);
  let remoteRep: Instr[][] = f.locals.map(l => []);
  for (const s of sites) {
    if (s.plan.ok) {
      for (const a of s.plan.remote) {
        remote[a] = true;
        remoteRep[a] = s.plan.remoteRep;
      }
    }
  }
  let blocks: MBlock[] = [];
  let si: usize = 0;
  let b: usize = 0;
  while (b < f.blocks.length) {
    const blk = f.blocks[b];
    const n = blk.instrs.length;
    // replacements of later instructions of the block, planned at the call whose record they destructure
    let later = new RewritePlan(n);
    let out = new BlockSink();
    let i: usize = 0;
    while (i < n) {
      const cs = blk.spans[i];
      if (later.touched(i)) {
        out.emitAll(later.replacement(i), cs);
      } else if (si < sites.length && sites[si].block == b && sites[si].at == i) {
        const s = sites[si];
        si += 1;
        match (blk.instrs[i]) {
          ICall(dst, g, args) => {
            const vRef = isRefTy(conv[g].unwrap());
            if (!s.direct) {
              match (args[0]) {
                OLocal(x0) => {
                  out.emit(IMove(s.x, x0), cs);
                },
                _ => {
                  out.emit(ICopy(s.x, args[0]), cs);
                },
              }
            }
            out.emit(ICall(Some(s.v), g, [OLocal(s.x)].concat(args.slice(1, args.length))), cs);
            match (dst) {
              None => {
                out.emit(IRelease(s.x), cs);
                if (vRef) {
                  out.emit(IRelease(s.v), cs);
                }
              },
              Some(d) => {
                if (s.plan.ok) {
                  let j = i + 1;
                  while (j < n) {
                    if (s.plan.hit[j]) {
                      later.replace(j, s.plan.rep[j]);
                    }
                    j += 1;
                  }
                } else {
                  out.emit(IStructNew(d, 0, [OLocal(s.x), OLocal(s.v)]), cs);
                }
              },
            }
          },
          _ => {
            out.emit(blk.instrs[i], cs);
          },
        }
      } else {
        const rel = match (blk.instrs[i]) {
          IRelease(a) => a < remote.length && remote[a],
          _ => false,
        };
        if (rel) {
          match (blk.instrs[i]) {
            IRelease(a) => {
              out.emitAll(remoteRep[a], cs);
            },
            _ => {},
          }
        } else {
          out.emit(blk.instrs[i], cs);
        }
      }
      i += 1;
    }
    blocks.push(out.finish(blk.term, blk.termSpan));
    b += 1;
  }
  return withBody(f, planned.locals, blocks);
}

// A converted function: in/out now, and its result is the value (the second slot) of the record it returned.
export function convertedOk(before: MFunction, after: MFunction): bool {
  return after.inout
      && !before.inout
      && after.name == before.name
      && after.paramCount == before.paramCount
      && after.blocks.length == before.blocks.length
      && isRefTy(before.ret);
}

// The functions are the same functions (names, order, `main`, strings, vtables); only pair functions that are not
// pinned (closure targets, vtable entries) and not `main` become in/out; every other signature is kept.
export function pairsKept(p: MProgram, r: MProgram, pinned: bool[]): bool {
  if (r.functions.length != p.functions.length
      || r.main != p.main
      || r.strings.length != p.strings.length) {
    return false;
  }
  let i: usize = 0;
  while (i < p.functions.length) {
    const a = p.functions[i];
    const b = r.functions[i];
    const kept = sameSignature(a, b);
    if (!kept && (pinned[i] || i == p.main || !convertedOk(a, b))) {
      return false;
    }
    i += 1;
  }
  return true;
}

// Stage 5. The shapes of all functions are found first (a program-wide step in function order); then every function is
// rewritten on its own: the callee side of a pair function, then its calls of converted functions.
@Requires(pinned.length == p.functions.length && progWellFormed(p))
@Ensures(pairsKept(p, result, pinned) && progWellFormed(result))
export function pairReturns(p: MProgram, pinned: bool[]): MProgram {
  const shapes = indices(p.functions.length).map(fi => pairShape(p, fi, pinned));
  if (!shapes.some(sh => sh.ok)) {
    return p;
  }
  const conv: Option<MType>[] = shapes.map(sh => sh.ok ? Some(sh.ty) : None);
  const fns = indices(p.functions.length).map(
    fi => rewriteCalls(
      p,
      conv,
      shapes[fi].ok ? convertCallee(p.functions[fi], shapes[fi]) : p.functions[fi],
    ),
  );
  return MProgram {
    functions: fns,
    strings: p.strings,
    main: p.main,
    vtables: p.vtables,
    inlineFns: p.inlineFns,
  };
}
