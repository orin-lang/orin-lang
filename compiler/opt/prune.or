// Dead-function elimination for prelude code (spec 19 R1). The implicit preludes
// (compiler/loader/prelude.or) add every function of their units to the program; those whose names
// start with `$` are dropped here unless they are reachable from `main` or from a function of the
// program itself. User functions are never dropped (so the verifier and the C output keep covering
// all of them). The same holds for lifted closure functions (`f$closure0`, the wrappers of function
// values): they are generated, and the only ones nobody creates are those of contract clauses, which
// are erased (ADR-0031 A4: closures in clauses must leave no trace in the output, ADR-0012).
// Remaining functions keep their relative order; calls and `main` are renumbered.
//
// The MIR constructs that name a function are `ICall` and `IClosure` (ICallIndirect calls through a
// value and names none). A new instruction that refers to a function MUST be added to `callees` and
// `renumber` below.

import { MProgram, MFunction, MBlock, Instr, MVTable, rtIds, rtImplied, rtAlways, rtWrappersOn } from "../mir";
import { withBody } from "./rewrite";
import { progWellFormed } from "./wellformed";

function isPrelude(f: MFunction): bool {
  return f.name.startsWith("$") || f.name.includes("$closure");
}

// Functions called by `f` (with repeats).
function callees(f: MFunction): usize[] {
  let out: usize[] = [];
  for (const b of f.blocks) {
    for (const ins of b.instrs) {
      match (ins) {
        ICall(_, g, _) => {
          out.push(g);
        },
        IClosure(_, g, _) => {
          out.push(g);
        },
        _ => {},
      }
    }
  }
  return out;
}

function renumberInstr(ins: Instr, idx: usize[]): Instr {
  return match (ins) {
    ICall(d, g, a) => ICall(d, idx[g], a),
    IClosure(d, g, caps) => IClosure(d, idx[g], caps),
    _ => ins,
  };
}

// `f` with every function index `g` replaced by `idx[g]`.
@Ensures(result.blocks.length == f.blocks.length && result.name == f.name)
function renumber(f: MFunction, idx: usize[]): MFunction {
  const blocks = f.blocks.map(
    b => MBlock {
      instrs: b.instrs.map(ins => renumberInstr(ins, idx)),
      spans: b.spans,
      term: b.term,
      termSpan: b.termSpan,
    },
  );
  return withBody(f, f.locals, blocks);
}

// `r` keeps every function of `p` that is not prelude code (and `main`), in the same order, and has no other functions:
// its names are a subsequence of `p`'s. Catches a pruning that drops a user function (the verifier and the output would
// silently stop covering it) or reorders the functions (the symbols `orin_fn_<i>_..` would change).
export function prunedOk(p: MProgram, r: MProgram): bool {
  if (r.functions.length > p.functions.length || r.main >= r.functions.length) {
    return false;
  }
  if (r.functions[r.main].name != p.functions[p.main].name
      || r.vtables.length != p.vtables.length) {
    return false;
  }
  let j: usize = 0;
  for (const f of p.functions) {
    if (j < r.functions.length && r.functions[j].name == f.name) {
      j += 1;
    } else if (!isPrelude(f)) {
      return false;
    }
  }
  return j == r.functions.length;
}

@Requires(progWellFormed(p))
@Ensures(progWellFormed(result) && prunedOk(p, result))
export function pruneProgram(p: MProgram): MProgram {
  let live: bool[] = [];
  let work: usize[] = [];
  let anyDead = false;
  let i: usize = 0;
  while (i < p.functions.length) {
    const keep = !isPrelude(p.functions[i]) || i == p.main;
    live.push(keep);
    if (keep) {
      work.push(i);
    }
    i += 1;
  }
  // Vtable entries are called through `ICallVirtual`, so they are roots.
  for (const v of p.vtables) {
    for (const g of v.funcs) {
      if (!live[g]) {
        live[g] = true;
        work.push(g);
      }
    }
  }
  // The L1 entries the backends call by name (mir/rt.or): the ones the C shells and the inline helpers call always, the others
  // where an instruction implies them.
  const rt = rtIds(p);
  for (const e of rtAlways(rtWrappersOn(p))) {
    if (rt[e] >= 0 && !live[rt[e].toUsize()]) {
      live[rt[e].toUsize()] = true;
      work.push(rt[e].toUsize());
    }
  }
  while (work.length > 0) {
    const k = work.pop().unwrap();
    for (const g of callees(p.functions[k])) {
      if (!live[g]) {
        live[g] = true;
        work.push(g);
      }
    }
    for (const e of rtImplied(p.functions[k])) {
      if (rt[e] >= 0 && !live[rt[e].toUsize()]) {
        live[rt[e].toUsize()] = true;
        work.push(rt[e].toUsize());
      }
    }
  }
  let idx: usize[] = [];
  let n: usize = 0;
  i = 0;
  while (i < live.length) {
    idx.push(n);
    if (live[i]) {
      n += 1;
    } else {
      anyDead = true;
    }
    i += 1;
  }
  if (!anyDead) {
    return p;
  }
  let fns: MFunction[] = [];
  i = 0;
  while (i < p.functions.length) {
    if (live[i]) {
      fns.push(renumber(p.functions[i], idx));
    }
    i += 1;
  }
  const vts = p.vtables.map(v => MVTable { name: v.name, funcs: v.funcs.map(g => idx[g]) });
  return MProgram {
    functions: fns,
    strings: p.strings,
    main: idx[p.main],
    vtables: vts,
    inlineFns: p.inlineFns,
  };
}
