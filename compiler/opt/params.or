// Owned-parameter inference and the callee-side rewrite (ADR-0010).
//
// A reference parameter p of f is *owned* when some use of p is its last use and consumes a counted reference:
// `IDup(d, p)` (the callee would retain the parameter to store, return or mutate it) or an argument of a call whose
// parameter is itself owned. For an owned p:
//   - the consuming last use takes the reference (IDup -> IMove, call operand consumed);
//   - on every other path the reference is released right after the last use of p (or of anything borrowed from p), on
//     the edge into a block where p is no longer live, or at entry if p is never used.
// Liveness is alias-aware (a use of a borrowed projection of p counts as a use of p), which keeps the release after
// every use of an alias that the verifier would otherwise see dead.

import {
  MProgram, MFunction, MLocal, MBlock, MType, Operand, Instr, Terminator, SwitchCase, spanAt,
} from "../mir";
import { Span } from "../diag";
import { Locals } from "../lower";
import {
  instrUses, succCount, succAt, ancestors, affects, usesAffecting, termUsesAffecting, entryHasPredecessor,
  isRefTy,
} from "./analysis";
import { BlockSink, withBody } from "./rewrite";
import { ReadCall, ReadInfo, readInfo, callsOf, isReadCopy } from "./borrow";
import { fnShapeOk, fnWellFormed, passKept, onlyEdgeBlocksAdded, releaseCount } from "./wellformed";

// Liveness of one parameter: one flag per block on entry and on exit.
@Invariant(this.liveIn.length == this.liveOut.length)
export type PLive = { liveIn: bool[]; liveOut: bool[]; };

@Ensures(match (o) {
  OLocal(m) => result == (m == l),
  _ => !result,
})
function isLocalOp(o: Operand, l: usize): bool {
  return match (o) {
    OLocal(m) => m == l,
    _ => false,
  };
}

// The liveness equations hold: a block is live-out iff a successor is live-in, and live-in iff it is live-out or uses
// p (`usedIn`).
export function livenessSolved(f: MFunction, lv: PLive, usedIn: bool[]): bool {
  let b: usize = 0;
  while (b < f.blocks.length) {
    let out = false;
    let k: usize = 0;
    while (k < succCount(f.blocks[b].term)) {
      if (lv.liveIn[succAt(f.blocks[b].term, k)]) {
        out = true;
      }
      k += 1;
    }
    if (lv.liveOut[b] != out || lv.liveIn[b] != (out || usedIn[b])) {
      return false;
    }
    b += 1;
  }
  return true;
}

// Does block b use p (an alias of p counts)?
function blockUses(f: MFunction, anc: usize[][], b: usize, p: usize): bool {
  // a loop, not `some`: called per block and parameter, on the hot path of the inference
  if (termUsesAffecting(anc, f.blocks[b].term, p)) {
    return true;
  }
  for (const ins of f.blocks[b].instrs) {
    if (usesAffecting(anc, ins, p)) {
      return true;
    }
  }
  return false;
}

// Backward liveness of parameter p (no kills: parameters are never redefined).
@Requires(fnShapeOk(f) && anc.length == f.locals.length && p < f.paramCount)
@Ensures(result.liveIn.length == f.blocks.length)
@Ensures(livenessSolved(f, result, usedFlags(f, anc, p)))
export function paramLiveness(f: MFunction, anc: usize[][], p: usize): PLive {
  const nb = f.blocks.length;
  const usedIn = usedFlags(f, anc, p);
  let liveIn: bool[] = usedIn;
  let liveOut: bool[] = [];
  let u: usize = 0;
  @Invariant(u <= usedIn.length && liveOut.length == u)
  while (u < usedIn.length) {
    liveOut.push(false);
    u += 1;
  }
  let changed = true;
  @Invariant(liveIn.length == nb && liveOut.length == nb)
  while (changed) {
    changed = false;
    let b = nb;
    @Invariant(b <= nb && liveIn.length == nb && liveOut.length == nb)
    while (b > 0) {
      b -= 1;
      let out = false;
      let k: usize = 0;
      while (k < succCount(f.blocks[b].term)) {
        if (liveIn[succAt(f.blocks[b].term, k)]) {
          out = true;
        }
        k += 1;
      }
      if (out != liveOut[b]) {
        liveOut[b] = out;
        changed = true;
      }
      if (out && !liveIn[b]) {
        liveIn[b] = true;
        changed = true;
      }
    }
  }
  return PLive { liveIn: liveIn, liveOut: liveOut };
}

// One flag per block: the block uses p.
@Ensures(result.length == f.blocks.length)
export function usedFlags(f: MFunction, anc: usize[][], p: usize): bool[] {
  let out: bool[] = [];
  let b: usize = 0;
  @Invariant(b <= f.blocks.length && out.length == b)
  while (b < f.blocks.length) {
    out.push(blockUses(f, anc, b, p));
    b += 1;
  }
  return out;
}

// la[i] = p is live after instruction i of the block.
@Ensures(result.length == blk.instrs.length)
function liveAfter(blk: MBlock, anc: usize[][], p: usize, out: bool): bool[] {
  let live = out || termUsesAffecting(anc, blk.term, p);
  let la: bool[] = [];
  let z: usize = 0;
  @Invariant(z <= blk.instrs.length && la.length == z)
  while (z < blk.instrs.length) {
    la.push(false);
    z += 1;
  }
  let i = blk.instrs.length;
  @Invariant(i <= blk.instrs.length && la.length == blk.instrs.length)
  while (i > 0) {
    i -= 1;
    la[i] = live;
    if (!live && usesAffecting(anc, blk.instrs[i], p)) {
      live = true;
    }
  }
  return la;
}

// p occurs exactly once among the call arguments and nothing else passed to the call may be borrowed from p (the callee
// could release its owned argument while reading the alias).
function cleanCall(anc: usize[][], args: Operand[], p: usize): bool {
  let n: usize = 0;
  for (const a of args) {
    match (a) {
      OLocal(l) => {
        if (l == p) {
          n += 1;
        } else if (affects(anc, l, p)) {
          return false;
        }
      },
      _ => {},
    }
  }
  return n == 1;
}

export type CallSite = { callee: usize; pos: usize; };

// Where parameter p of f is consumed at its last use. Not `ok`: p can never be owned (it is not a reference, the entry
// block is a loop head, or a terminator uses it), and then nothing was collected. `via`: p is copied at its last use into
// a local that is only read (borrow.or); that does not consume p, unless the copy is passed to a parameter that is owned
// (a position in `via`).
@Invariant(this.ok || !this.dup && this.calls.length == 0 && this.via.length == 0)
export type PSites = { ok: bool; dup: bool; calls: CallSite[]; via: ReadCall[]; };

@Requires(fnShapeOk(f) && p < f.paramCount)
@Ensures(result.calls.every(c => passesAt(f, c, p)))
export function scanSites(f: MFunction, p: usize): PSites {
  let r = PSites { ok: false, dup: false, calls: [], via: [] };
  if (!isRefTy(f.locals[p].ty) || entryHasPredecessor(f)) {
    return r;
  }
  const anc = ancestors(f);
  if (f.blocks.some(blk => termUsesAffecting(anc, blk.term, p))) {
    return r;
  }
  r.ok = true;
  let info: Option<ReadInfo> = None;
  const lv = paramLiveness(f, anc, p);
  let b: usize = 0;
  while (b < f.blocks.length) {
    const blk = f.blocks[b];
    const la = liveAfter(blk, anc, p, lv.liveOut[b]);
    let i: usize = 0;
    while (i < blk.instrs.length) {
      if (!la[i]) {
        match (blk.instrs[i]) {
          IDup(d, o) => {
            if (isLocalOp(o, p)) {
              // the facts about the copies are collected once, at the first copy of a parameter
              if (info.isNone()) {
                info = Some(readInfo(f));
              }
              if (isReadCopy(f, info.unwrap(), blk.instrs[i])) {
                r.via = r.via.concat(callsOf(info.unwrap(), d));
              } else {
                r.dup = true;
              }
            }
          },
          ICall(_, g, args) => {
            if (cleanCall(anc, args, p)) {
              let j: usize = 0;
              while (j < args.length) {
                if (isLocalOp(args[j], p)) {
                  r.calls.push(CallSite { callee: g, pos: j });
                }
                j += 1;
              }
            }
          },
          _ => {},
        }
      }
      i += 1;
    }
    b += 1;
  }
  return r;
}

// f has a call of `c.callee` with p as argument `c.pos` (a recorded site is a real one: a wrong position would make the
// inference own the wrong parameter of the callee).
export function passesAt(f: MFunction, c: CallSite, p: usize): bool {
  return f.blocks.some(
    blk => blk.instrs.some(
      ins => match (ins) {
        ICall(_, g, args) => g == c.callee && c.pos < args.length && isLocalOp(args[c.pos], p),
        _ => false,
      },
    ),
  );
}

// Is `b` the edge block `release p; goto t` with t below `n`?
function isEdgeBlock(b: MBlock, p: usize, n: usize): bool {
  return b.instrs.length == 1
      && match (b.instrs[0]) {
        IRelease(x) => x == p,
        _ => false,
      }
      && match (b.term) {
        TGoto(t) => t < n,
        _ => false,
      };
}

function edgeBlocksOk(bs: MBlock[], p: usize, n: usize): bool {
  return bs.every(b => isEdgeBlock(b, p, n));
}

type RU = { pre: Instr[]; main: Instr; consumed: bool; };

// Rewrite one instruction that uses p. `dead`: p is not live after it. `tmp`: index the first temporary local would get
// (one per element of `pre`).
@Ensures(!result.consumed || dead)
@Ensures(result.pre.length <= instrUses(ins).length)
function rewriteUse(
  prog: MProgram,
  anc: usize[][],
  ins: Instr,
  p: usize,
  dead: bool,
  tmp: usize,
): RU {
  return match (ins) {
    IDup(d, o) => {
      if (dead && isLocalOp(o, p)) {
        return RU { pre: [], main: IMove(d, p), consumed: true };
      }
      return RU { pre: [], main: ins, consumed: false };
    },
    ICall(dst, g, args) => {
      const owned = prog.functions[g].paramOwned;
      const clean = cleanCall(anc, args, p);
      let pre: Instr[] = [];
      let nargs: Operand[] = [];
      let consumed = false;
      let j: usize = 0;
      while (j < args.length) {
        const a = args[j];
        if (isLocalOp(a, p) && j < owned.length && owned[j]) {
          if (dead && clean) {
            nargs.push(a);
            consumed = true;
          } else {
            const t = tmp + pre.length;
            pre.push(IDup(t, a));
            nargs.push(OLocal(t));
          }
        } else {
          nargs.push(a);
        }
        j += 1;
      }
      return RU { pre: pre, main: ICall(dst, g, nargs), consumed: consumed };
    },
    _ => RU { pre: [], main: ins, consumed: false },
  };
}

// The block that releases `p` on the edge out of `blk` towards `target`; its code has the position of `blk`'s terminator.
function edgeBlock(blk: MBlock, p: usize, target: usize): MBlock {
  return MBlock {
    instrs: [IRelease(p)],
    spans: [blk.termSpan],
    term: TGoto(target),
    termSpan: blk.termSpan,
  };
}

// The edge blocks a function gains, appended after its `base` blocks (block ids `base`, `base + 1`, ...): each releases
// the parameter `p` and continues at one of the old blocks.
@Invariant(edgeBlocksOk(this.blocks, this.p, this.base))
class EdgeBlocks {
  private base: usize;
  private p: usize;
  private blocks: MBlock[];

  constructor(base: usize, p: usize) {
    this.base = base;
    this.p = p;
    this.blocks = [];
  }

  // The target to use for the edge `src -> t`: t itself when p is live there, else a new edge block that releases p and
  // continues at t.
  @Requires(p == this.p && t < this.base)
  @Ensures(live ==> result == t)
  @Ensures(!live
      ==> result == this.base + this.blocks.length - 1
          && this.blocks.length == old(this.blocks.length) + 1)
  target(src: MBlock, p: usize, t: usize, live: bool): usize {
    if (live) {
      return t;
    }
    this.blocks.push(edgeBlock(src, p, t));
    return this.base + this.blocks.length - 1;
  }

  all(): MBlock[] {
    return this.blocks;
  }
}

// Make parameter p (already flagged owned in prog) own its reference in f's body: the consuming last use takes it, every
// other path releases it. The old blocks keep their ids; the only blocks added are edge releases of p.
@Requires(fnWellFormed(prog, f) && p < f.paramCount && isRefTy(f.locals[p].ty))
@Ensures(passKept(f, result) && fnWellFormed(prog, result))
@Ensures(onlyEdgeBlocksAdded(f, result, p))
@Ensures(releaseCount(result) >= releaseCount(f))
export function rewriteParam(prog: MProgram, f: MFunction, p: usize): MFunction {
  const anc = ancestors(f);
  const lv = paramLiveness(f, anc, p);
  const nb = f.blocks.length;
  let locals = new Locals(f.locals);
  let blocks: MBlock[] = [];
  let extra = new EdgeBlocks(nb, p);
  let b: usize = 0;
  while (b < nb) {
    const blk = f.blocks[b];
    const la = liveAfter(blk, anc, p, lv.liveOut[b]);
    let out = new BlockSink();
    if (b == 0 && !lv.liveIn[0]) {
      out.emit(IRelease(p), spanAt(blk, 0));
    }
    let i: usize = 0;
    while (i < blk.instrs.length) {
      const ins = blk.instrs[i];
      const here = blk.spans[i];
      if (!usesAffecting(anc, ins, p)) {
        out.emit(ins, here);
      } else {
        const dead = !la[i];
        const ru = rewriteUse(prog, anc, ins, p, dead, locals.count());
        for (const pi of ru.pre) {
          locals.fresh(MRef);
          out.emit(pi, here);
        }
        out.emit(ru.main, here);
        if (dead && !ru.consumed) {
          out.emit(IRelease(p), here);
        }
      }
      i += 1;
    }
    // Edges from a block where p is live into a block where it is not: release on the edge.
    let term = blk.term;
    if (lv.liveOut[b]) {
      match (blk.term) {
        TBranch(c, x, y) => {
          const nx = extra.target(blk, p, x, lv.liveIn[x]);
          const ny = extra.target(blk, p, y, lv.liveIn[y]);
          term = TBranch(c, nx, ny);
        },
        TSwitch(o, cs, d) => {
          let ncs: SwitchCase[] = [];
          for (const k of cs) {
            ncs.push(SwitchCase {
              value: k.value,
              target: extra.target(blk, p, k.target, lv.liveIn[k.target]),
            });
          }
          const nd = extra.target(blk, p, d, lv.liveIn[d]);
          term = TSwitch(o, ncs, nd);
        },
        _ => {},
      }
    }
    blocks.push(out.finish(term, blk.termSpan));
    b += 1;
  }
  return withBody(f, locals.table(), blocks.concat(extra.all()));
}
