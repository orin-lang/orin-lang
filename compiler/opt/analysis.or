// Shared analyses for the MIR optimiser: operand/local use and definition sets, the alias
// ("ancestor") relation between borrowed locals and the locals they borrow from, successors.

import { MType, MFunction, Operand, Instr, Terminator, SwitchCase } from "../mir";
import { blocksLocalsBelow, instrLocals, termLocals, succCount, succAt } from "../mir";

// The successors are the MIR's (compiler/mir/wellformed.or): one table for the verifier, the lowering and the passes.
export { successors, succCount, succAt } from "../mir";

// The locals read (or mutated through) by instructions and terminators, including IRelease, one instruction at a time
// into a buffer that is reused: `ofInstr` / `ofTerm` leave them in `xs[0..n)`. The passes call it for every instruction of
// every function, so the callers walk the buffer by index (a `for` over `xs` would hold it and the next fill would copy it).
@Invariant(this.n <= this.xs.length)
export class UseBuf {
  xs: usize[];
  n: usize;

  constructor() {
    this.xs = [];
    this.n = 0;
  }

  private put(l: usize): void {
    if (this.n < this.xs.length) {
      this.xs[this.n] = l;
    } else {
      this.xs.push(l);
    }
    this.n += 1;
  }

  // The locals instruction `i` reads, in `xs[0..n)`.
  ofInstr(i: Instr): void {
    this.n = 0;
    match (i) {
      ICopy(_, o) => {
        match (o) {
          OLocal(l) => {
            this.put(l);
          },
          _ => {},
        }
      },
      IMove(_, s) => {
        this.put(s);
      },
      IBorrow(_, s) => {
        this.put(s);
      },
      IDup(_, o) => {
        match (o) {
          OLocal(l) => {
            this.put(l);
          },
          _ => {},
        }
      },
      IRelease(x) => {
        this.put(x);
      },
      IUnary(_, _, o) => {
        match (o) {
          OLocal(l) => {
            this.put(l);
          },
          _ => {},
        }
      },
      IBinary(_, _, a, b) => {
        match (a) {
          OLocal(l) => {
            this.put(l);
          },
          _ => {},
        }
        match (b) {
          OLocal(l) => {
            this.put(l);
          },
          _ => {},
        }
      },
      ICall(_, _, args) => {
        for (const e of args) {
          match (e) {
            OLocal(l) => {
              this.put(l);
            },
            _ => {},
          }
        }
      },
      IBuiltin(_, _, args) => {
        for (const e of args) {
          match (e) {
            OLocal(l) => {
              this.put(l);
            },
            _ => {},
          }
        }
      },
      IStrAppend(x, y) => {
        this.put(x);
        match (y) {
          OLocal(l) => {
            this.put(l);
          },
          _ => {},
        }
      },
      IStrPrepend(x, y) => {
        this.put(x);
        match (y) {
          OLocal(l) => {
            this.put(l);
          },
          _ => {},
        }
      },
      IStrAppendSub(x, y, a, b) => {
        this.put(x);
        for (const e of [y, a, b]) {
          match (e) {
            OLocal(l) => {
              this.put(l);
            },
            _ => {},
          }
        }
      },
      IStrAppendNum(x, y, _) => {
        this.put(x);
        match (y) {
          OLocal(l) => {
            this.put(l);
          },
          _ => {},
        }
      },
      IArrayExtend(x, y) => {
        this.put(x);
        match (y) {
          OLocal(l) => {
            this.put(l);
          },
          _ => {},
        }
      },
      IStructNew(_, _, s) => {
        for (const e of s) {
          match (e) {
            OLocal(l) => {
              this.put(l);
            },
            _ => {},
          }
        }
      },
      INullary(_, _) => {},
      ITag(_, o) => {
        match (o) {
          OLocal(l) => {
            this.put(l);
          },
          _ => {},
        }
      },
      IGetField(_, o, _) => {
        match (o) {
          OLocal(l) => {
            this.put(l);
          },
          _ => {},
        }
      },
      IShapeCheck(x, _) => {
        this.put(x);
      },
      IGetFieldU(_, o, _) => {
        match (o) {
          OLocal(l) => {
            this.put(l);
          },
          _ => {},
        }
      },
      ISetField(x, _, v) => {
        this.put(x);
        match (v) {
          OLocal(l) => {
            this.put(l);
          },
          _ => {},
        }
      },
      ISetFieldU(x, _, v) => {
        this.put(x);
        match (v) {
          OLocal(l) => {
            this.put(l);
          },
          _ => {},
        }
      },
      ITakeField(_, x, _) => {
        this.put(x);
      },
      IPutField(x, _, s) => {
        this.put(x);
        this.put(s);
      },
      IMakeUnique(x) => {
        this.put(x);
      },
      IArrayNew(_, _, es) => {
        for (const e of es) {
          match (e) {
            OLocal(l) => {
              this.put(l);
            },
            _ => {},
          }
        }
      },
      IArrayGet(_, a, k) => {
        match (a) {
          OLocal(l) => {
            this.put(l);
          },
          _ => {},
        }
        match (k) {
          OLocal(l) => {
            this.put(l);
          },
          _ => {},
        }
      },
      IArrayGetU(_, a, k) => {
        match (a) {
          OLocal(l) => {
            this.put(l);
          },
          _ => {},
        }
        match (k) {
          OLocal(l) => {
            this.put(l);
          },
          _ => {},
        }
      },
      IArraySet(x, k, v) => {
        this.put(x);
        match (k) {
          OLocal(l) => {
            this.put(l);
          },
          _ => {},
        }
        match (v) {
          OLocal(l) => {
            this.put(l);
          },
          _ => {},
        }
      },
      IArraySetU(x, k, v) => {
        this.put(x);
        match (k) {
          OLocal(l) => {
            this.put(l);
          },
          _ => {},
        }
        match (v) {
          OLocal(l) => {
            this.put(l);
          },
          _ => {},
        }
      },
      IArrayTake(_, x, k) => {
        this.put(x);
        match (k) {
          OLocal(l) => {
            this.put(l);
          },
          _ => {},
        }
      },
      IArrayPut(x, k, s) => {
        this.put(x);
        this.put(s);
        match (k) {
          OLocal(l) => {
            this.put(l);
          },
          _ => {},
        }
      },
      IArrayPush(x, v) => {
        this.put(x);
        match (v) {
          OLocal(l) => {
            this.put(l);
          },
          _ => {},
        }
      },
      IArrayPop(_, x) => {
        this.put(x);
      },
      IForward(_, s, o, k) => {
        this.put(s);
        match (o) {
          OLocal(l) => {
            this.put(l);
          },
          _ => {},
        }
        match (k) {
          OLocal(l) => {
            this.put(l);
          },
          _ => {},
        }
      },
      IClosure(_, _, caps) => {
        for (const e of caps) {
          match (e) {
            OLocal(l) => {
              this.put(l);
            },
            _ => {},
          }
        }
      },
      ICallIndirect(_, f, args) => {
        match (f) {
          OLocal(l) => {
            this.put(l);
          },
          _ => {},
        }
        for (const e of args) {
          match (e) {
            OLocal(l) => {
              this.put(l);
            },
            _ => {},
          }
        }
      },
      IIface(_, _, v) => {
        match (v) {
          OLocal(l) => {
            this.put(l);
          },
          _ => {},
        }
      },
      ICallVirtual(_, r, _, args) => {
        match (r) {
          OLocal(l) => {
            this.put(l);
          },
          _ => {},
        }
        for (const e of args) {
          match (e) {
            OLocal(l) => {
              this.put(l);
            },
            _ => {},
          }
        }
      },
    }
  }

  // The locals terminator `t` reads, in `xs[0..n)`.
  ofTerm(t: Terminator): void {
    this.n = 0;
    match (t) {
      TBranch(o, _, _) => {
        this.op(o);
      },
      TSwitch(o, _, _) => {
        this.op(o);
      },
      TReturn(r) => {
        match (r) {
          Some(o) => {
            this.op(o);
          },
          None => {},
        }
      },
      _ => {},
    }
  }

  private op(o: Operand): void {
    match (o) {
      OLocal(l) => {
        this.put(l);
      },
      _ => {},
    }
  }

  // The locals in `xs[0..n)` as a list.
  list(): usize[] {
    return this.xs.slice(0, this.n);
  }
}

// Locals read (or mutated through) by an instruction, including IRelease.
export function instrUses(i: Instr): usize[] {
  let u = new UseBuf();
  u.ofInstr(i);
  return u.list();
}

// The local an instruction (re)defines, if any.
export function instrDef(i: Instr): Option<usize> {
  return match (i) {
    ICopy(d, _) => Some(d),
    IMove(d, _) => Some(d),
    IBorrow(d, _) => Some(d),
    IDup(d, _) => Some(d),
    IUnary(d, _, _) => Some(d),
    IBinary(d, _, _, _) => Some(d),
    ICall(d, _, _) => d,
    IBuiltin(d, _, _) => d,
    IStructNew(d, _, _) => Some(d),
    INullary(d, _) => Some(d),
    ITag(d, _) => Some(d),
    IGetField(d, _, _) => Some(d),
    IGetFieldU(d, _, _) => Some(d),
    ITakeField(d, _, _) => Some(d),
    IArrayNew(d, _, _) => Some(d),
    IArrayGet(d, _, _) => Some(d),
    IArrayGetU(d, _, _) => Some(d),
    IArrayTake(d, _, _) => Some(d),
    IArrayPop(d, _) => Some(d),
    IForward(d, _, _, _) => Some(d),
    IClosure(d, _, _) => Some(d),
    ICallIndirect(d, _, _) => d,
    IIface(d, _, _) => Some(d),
    ICallVirtual(d, _, _, _) => d,
    _ => None,
  };
}

export function termUses(t: Terminator): usize[] {
  let u = new UseBuf();
  u.ofTerm(t);
  return u.list();
}

@Ensures(match (t) {
  MRef => result,
  _ => !result,
})
export function isRefTy(t: MType): bool {
  return match (t) {
    MRef => true,
    _ => false,
  };
}

// A loop (not `includes`): `affects` calls it for every use of every instruction a pass scans.
export function contains(xs: usize[], x: usize): bool {
  for (const y of xs) {
    if (y == x) {
      return true;
    }
  }
  return false;
}

// Source local of a borrowed projection `d = obj`, when d is a reference and obj a local.
function edgeSrc(f: MFunction, d: usize, o: Operand): Option<usize> {
  return match (o) {
    OLocal(l) => isRefTy(f.locals[d].ty) ? Some(l) : None,
    _ => None,
  };
}

// A borrow edge: `d` is a borrowed projection of `src`.
export type Edge = { d: usize; src: usize; };

// The borrow edges of f, in block and instruction order: IBorrow, and IGetField / IArrayGet into a reference local.
export function borrowEdges(f: MFunction): Edge[] {
  let out: Edge[] = [];
  for (const blk of f.blocks) {
    for (const ins of blk.instrs) {
      match (ins) {
        IBorrow(d, s) => {
          out.push(Edge { d: d, src: s });
        },
        IGetField(d, o, _) => {
          match (edgeSrc(f, d, o)) {
            Some(l) => {
              out.push(Edge { d: d, src: l });
            },
            None => {},
          }
        },
        IGetFieldU(d, o, _) => {
          match (edgeSrc(f, d, o)) {
            Some(l) => {
              out.push(Edge { d: d, src: l });
            },
            None => {},
          }
        },
        IArrayGet(d, o, _) => {
          match (edgeSrc(f, d, o)) {
            Some(l) => {
              out.push(Edge { d: d, src: l });
            },
            None => {},
          }
        },
        IArrayGetU(d, o, _) => {
          match (edgeSrc(f, d, o)) {
            Some(l) => {
              out.push(Edge { d: d, src: l });
            },
            None => {},
          }
        },
        _ => {},
      }
    }
  }
  return out;
}

// `anc` is closed under the borrow edges of f: for every edge d <- s, s is an ancestor of d and so is every ancestor of
// s; one entry per local, every entry a local. (A missing ancestor would let a pass move a release over a use of an
// alias: a use after free the verifier then rejects, or worse, an alias the optimiser no longer sees.)
export function ancestorsClosed(f: MFunction, anc: usize[][]): bool {
  const n = f.locals.length;
  return anc.length == n
      && anc.every(a => a.every(l => l < n))
      && borrowEdges(f).every(
        e => anc[e.d].includes(e.src) && anc[e.src].every(a => anc[e.d].includes(a)),
      );
}

// anc[d] = every local d may (transitively) be a borrowed projection of: sources of IBorrow / IGetField / IArrayGet
// into a reference local, closed under the relation. Flow-insensitive, so it over-approximates (a reused local counts
// as derived everywhere), which is the safe side.
@Requires(blocksLocalsBelow(f.blocks, f.locals.length) && tablesAgree(f))
@Ensures(ancestorsClosed(f, result))
export function ancestors(f: MFunction): usize[][] {
  // the edges as two parallel index arrays (not `borrowEdges`' records): this runs once per parameter and pass
  // every local starts with the one shared empty list; pushing into an entry copies it (copy on write), so only the
  // locals that are borrowed projections get an array of their own
  const none: usize[] = [];
  let anc: usize[][] = [];
  let k: usize = 0;
  while (k < f.locals.length) {
    anc.push(none);
    k += 1;
  }
  let ed: usize[] = [];
  let eo: usize[] = [];
  for (const blk of f.blocks) {
    for (const ins of blk.instrs) {
      match (ins) {
        IBorrow(d, s) => {
          ed.push(d);
          eo.push(s);
        },
        IGetField(d, o, _) => {
          match (edgeSrc(f, d, o)) {
            Some(l) => {
              ed.push(d);
              eo.push(l);
            },
            None => {},
          }
        },
        IGetFieldU(d, o, _) => {
          match (edgeSrc(f, d, o)) {
            Some(l) => {
              ed.push(d);
              eo.push(l);
            },
            None => {},
          }
        },
        IArrayGet(d, o, _) => {
          match (edgeSrc(f, d, o)) {
            Some(l) => {
              ed.push(d);
              eo.push(l);
            },
            None => {},
          }
        },
        IArrayGetU(d, o, _) => {
          match (edgeSrc(f, d, o)) {
            Some(l) => {
              ed.push(d);
              eo.push(l);
            },
            None => {},
          }
        },
        _ => {},
      }
    }
  }
  let changed = true;
  while (changed) {
    changed = false;
    let e: usize = 0;
    while (e < ed.length) {
      const d = ed[e];
      const o = eo[e];
      if (!contains(anc[d], o)) {
        anc[d].push(o);
        changed = true;
      }
      // by index: o may be d itself, whose list grows only by elements it does not hold yet
      let j: usize = 0;
      while (j < anc[o].length) {
        const a = anc[o][j];
        if (!contains(anc[d], a)) {
          anc[d].push(a);
          changed = true;
        }
        j += 1;
      }
      e += 1;
    }
  }
  return anc;
}

// Does a use of local u count as a use of x (u is x or may be borrowed from x)?
export function affects(anc: usize[][], u: usize, x: usize): bool {
  return u == x || contains(anc[u], x);
}

// Does the operand use x or something borrowed from x?
function opAffects(anc: usize[][], o: Operand, x: usize): bool {
  return match (o) {
    OLocal(l) => affects(anc, l, x),
    _ => false,
  };
}

function opsAffect(anc: usize[][], os: Operand[], x: usize): bool {
  for (const o of os) {
    if (opAffects(anc, o, x)) {
      return true;
    }
  }
  return false;
}

// Does the instruction use x or something borrowed from x? The same table as `instrUses` (`usesAffectingAgrees` in the
// optimiser tests checks they agree), without building the use list: the passes call this for every instruction they scan.
export function usesAffecting(anc: usize[][], ins: Instr, x: usize): bool {
  return match (ins) {
    ICopy(_, o) => opAffects(anc, o, x),
    IMove(_, s) => affects(anc, s, x),
    IBorrow(_, s) => affects(anc, s, x),
    IDup(_, o) => opAffects(anc, o, x),
    IRelease(y) => affects(anc, y, x),
    IUnary(_, _, o) => opAffects(anc, o, x),
    IBinary(_, _, a, b) => opAffects(anc, a, x) || opAffects(anc, b, x),
    ICall(_, _, args) => opsAffect(anc, args, x),
    IBuiltin(_, _, args) => opsAffect(anc, args, x),
    IStrAppend(y, z) => affects(anc, y, x) || opAffects(anc, z, x),
    IStrPrepend(y, z) => affects(anc, y, x) || opAffects(anc, z, x),
    IStrAppendSub(x0, y, a, b) => affects(anc, x0, x) || opsAffect(anc, [y, a, b], x),
    IStrAppendNum(y, z, _) => affects(anc, y, x) || opAffects(anc, z, x),
    IArrayExtend(y, z) => affects(anc, y, x) || opAffects(anc, z, x),
    IStructNew(_, _, s) => opsAffect(anc, s, x),
    INullary(_, _) => false,
    ITag(_, o) => opAffects(anc, o, x),
    IGetField(_, o, _) => opAffects(anc, o, x),
    IShapeCheck(y, _) => affects(anc, y, x),
    IGetFieldU(_, o, _) => opAffects(anc, o, x),
    ISetField(y, _, v) => affects(anc, y, x) || opAffects(anc, v, x),
    ISetFieldU(y, _, v) => affects(anc, y, x) || opAffects(anc, v, x),
    ITakeField(_, y, _) => affects(anc, y, x),
    IPutField(y, _, s) => affects(anc, y, x) || affects(anc, s, x),
    IMakeUnique(y) => affects(anc, y, x),
    IArrayNew(_, _, es) => opsAffect(anc, es, x),
    IArrayGet(_, a, k) => opAffects(anc, a, x) || opAffects(anc, k, x),
    IArrayGetU(_, a, k) => opAffects(anc, a, x) || opAffects(anc, k, x),
    IArraySet(y, k, v) => affects(anc, y, x) || opAffects(anc, k, x) || opAffects(anc, v, x),
    IArraySetU(y, k, v) => affects(anc, y, x) || opAffects(anc, k, x) || opAffects(anc, v, x),
    IArrayTake(_, y, k) => affects(anc, y, x) || opAffects(anc, k, x),
    IArrayPut(y, k, s) => affects(anc, y, x) || affects(anc, s, x) || opAffects(anc, k, x),
    IArrayPush(y, v) => affects(anc, y, x) || opAffects(anc, v, x),
    IArrayPop(_, y) => affects(anc, y, x),
    IForward(_, s, o, k) => affects(anc, s, x) || opAffects(anc, o, x) || opAffects(anc, k, x),
    IClosure(_, _, caps) => opsAffect(anc, caps, x),
    ICallIndirect(_, g, args) => opAffects(anc, g, x) || opsAffect(anc, args, x),
    IIface(_, _, v) => opAffects(anc, v, x),
    ICallVirtual(_, r, _, args) => opAffects(anc, r, x) || opsAffect(anc, args, x),
  };
}

export function termUsesAffecting(anc: usize[][], t: Terminator, x: usize): bool {
  return match (t) {
    TBranch(o, _, _) => opAffects(anc, o, x),
    TSwitch(o, _, _) => opAffects(anc, o, x),
    TReturn(r) => match (r) {
      Some(o) => opAffects(anc, o, x),
      None => false,
    },
    _ => false,
  };
}

// The optimiser's use / definition tables agree with the shared, independent table of the locals an instruction
// mentions (`instrLocals`, `termLocals` in mir/wellformed.or) on every instruction of f: what `instrUses` /
// `instrDef` / `termUses` name is mentioned, and every mentioned local is used or defined. Catches an instruction kind
// added to one table and not the other: a use the optimiser does not see is a release it may move across that use.
export function tablesAgree(f: MFunction): bool {
  return f.blocks.every(
    b => b.instrs.every(i => sameSet(instrUses(i).concat(optList(instrDef(i))), instrLocals(i)))
        && sameSet(termUses(b.term), termLocals(b.term)),
  );
}

function optList(d: Option<usize>): usize[] {
  return match (d) {
    Some(x) => [x],
    None => [],
  };
}

// The same locals, ignoring order and repeats.
function sameSet(a: usize[], b: usize[]): bool {
  return a.every(x => b.includes(x)) && b.every(x => a.includes(x));
}

// Static use / definition counts of every local of f (instruction operands and terminators).
@Invariant(this.uses.length == this.defs.length)
export type Counts = { uses: usize[]; defs: usize[]; };

@Ensures(result.uses.length == f.locals.length && result.defs.length == f.locals.length)
export function countsOf(f: MFunction): Counts {
  let uses: usize[] = [];
  let defs: usize[] = [];
  for (const _l of f.locals) {
    uses.push(0);
    defs.push(0);
  }
  let ub = new UseBuf();
  for (const blk of f.blocks) {
    for (const ins of blk.instrs) {
      ub.ofInstr(ins);
      let k: usize = 0;
      while (k < ub.n) {
        uses[ub.xs[k]] += 1;
        k += 1;
      }
      match (instrDef(ins)) {
        Some(d) => {
          defs[d] += 1;
        },
        None => {},
      }
    }
    ub.ofTerm(blk.term);
    let k: usize = 0;
    while (k < ub.n) {
      uses[ub.xs[k]] += 1;
      k += 1;
    }
  }
  return Counts { uses: uses, defs: defs };
}

// Is block 0 the target of some terminator?
export function entryHasPredecessor(f: MFunction): bool {
  for (const blk of f.blocks) {
    let k: usize = 0;
    while (k < succCount(blk.term)) {
      if (succAt(blk.term, k) == 0) {
        return true;
      }
      k += 1;
    }
  }
  return false;
}
