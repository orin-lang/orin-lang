// Redundant `makeunique` removal (ADR-0038 addendum, lever 2, step T1). `makeunique x` on a local that is certainly
// `Unique` at that point is the identity at run time (the `rc == 1` path), so it is deleted.
//
// The fact is a forward must-analysis that is at most as permissive as the ownership verifier (rules.or), so every local
// it calls Unique the verifier also calls `Unique`; the result is re-verified like the output of every pass, and a wrongly
// deleted `makeunique` makes a later store fail with "requires ... to be Unique". (The verifier's own fixpoint would give
// the facts directly, but it costs a second full verification of the program: +18 % on the self-compile, against the
// design's gate of +1 %. This analysis follows only the locals it needs, in time linear in the instructions.)
//
// The state is the set U of locals that are Unique on every path. It mirrors the verifier's transfer as follows:
//   - `structnew` / `arraynew` of a reference local, a closure and an interface value define a Unique local (rules.or IStructNew,
//     IArrayNew, IClosure, IIface), `makeunique x`
//     makes x Unique (IMakeUnique);
//   - an instruction that names a local in U in any other way takes it out of U: a copy, move, dup, borrow (demote), a
//     call argument (the verifier demotes it for a reference result and consumes it in an owned position), a release,
//     a push, an append, a redefinition (rules.or `def`, `demote`, `consume`, `mutateOwned`);
//   - `d = move s` makes d Unique when s is (IMove keeps the kind);
//   - the exceptions are the forms the verifier leaves Unique: a store, take or put on x (`needUnique`), a read of a
//     field or element of x (`project`), provided the instruction names x nowhere else, and an argument of a call in a
//     borrowed position when the call has no reference result (`callOwned` demotes only for a reference result);
//   - a join is the intersection (the verifier's join of Unique with anything else is not Unique).
//   - v2.7 (T5, uniqflags.or): the result of a call of a `unique-out` function is Unique (rule U5), and so is the receiver
//     an in/out call of such a function hands back; the receiver of a `unique-in` function is Unique at its entry (rule U2);
// An instruction that does not name a local cannot change its kind, so nothing else is tracked.

import { MProgram, MFunction, MBlock, Instr, Operand } from "../mir";
import { successors } from "../mir";
import { RewritePlan, withBody } from "./rewrite";
import { passKept, fnShapeOk, fnWellFormed, instrCount } from "./wellformed";
import { instrUses, instrDef, isRefTy, UseBuf } from "./analysis";

function isMakeUnique(i: Instr): bool {
  return match (i) {
    IMakeUnique(_) => true,
    _ => false,
  };
}

// The number of `makeunique` instructions of `f`.
export function makeUniqueCount(f: MFunction): usize {
  return f.blocks.reduce((n: usize, b: MBlock) => n + b.instrs.filter(isMakeUnique).length, 0);
}

function isLocal(o: Operand, x: usize): bool {
  return match (o) {
    OLocal(l) => l == x,
    _ => false,
  };
}

// The object local that `ins` leaves Unique when it is, if the instruction names it nowhere else: a store, take or put
// on the object, or a read of one of its fields or elements.
function keptObject(ins: Instr): Option<usize> {
  return match (ins) {
    ISetField(x, _, v) => isLocal(v, x) ? None : Some(x),
    IArraySet(x, i, v) => isLocal(i, x) || isLocal(v, x) ? None : Some(x),
    ITakeField(d, x, _) => d == x ? None : Some(x),
    IArrayTake(d, x, i) => d == x || isLocal(i, x) ? None : Some(x),
    IPutField(x, _, s) => s == x ? None : Some(x),
    IArrayPut(x, i, s) => s == x || isLocal(i, x) ? None : Some(x),
    IGetField(d, o, _) => match (o) {
      OLocal(x) => d == x ? None : Some(x),
      _ => None,
    },
    IArrayGet(d, a, i) => match (a) {
      OLocal(x) => d == x || isLocal(i, x) ? None : Some(x),
      _ => None,
    },
    IForward(d, _, o, i) => match (o) {
      OLocal(x) => d == x || isLocal(i, x) ? None : Some(x),
      _ => None,
    },
    _ => None,
  };
}

// The locals a call or length builtin leaves Unique when they are: arguments in borrowed positions of a call without a reference result,
// that appear in no owned position (an in/out call redefines its receiver, so it keeps nothing).
function callKept(prog: MProgram, f: MFunction, ins: Instr): usize[] {
  return match (ins) {
    ICall(dst, g, args) => {
      const callee = prog.functions[g];
      const refResult = match (dst) {
        Some(d) => isRefTy(f.locals[d].ty),
        None => false,
      };
      if (refResult || callee.inout) {
        return [];
      }
      let out: usize[] = [];
      let i: usize = 0;
      while (i < args.length) {
        match (args[i]) {
          OLocal(x) => {
            if (!ownedAt(callee.paramOwned, i) && !ownedAnywhere(callee.paramOwned, args, x)) {
              out.push(x);
            }
          },
          _ => {},
        }
        i += 1;
      }
      return out;
    },
    IBuiltin(dst, b, args) => match (b) {
      // the array length is a plain call to the verifier (`call`): no argument is consumed, and a scalar result demotes nothing
      BArrLength => {
        let out: usize[] = [];
        match (dst) {
          Some(d) => {
            if (!isRefTy(f.locals[d].ty)) {
              for (const a of args) {
                match (a) {
                  OLocal(x) => {
                    out.push(x);
                  },
                  _ => {},
                }
              }
            }
          },
          None => {},
        }
        return out;
      },
      _ => [],
    },
    _ => [],
  };
}

function ownedAt(owned: bool[], i: usize): bool {
  return i < owned.length && owned[i];
}

// Is x an argument in an owned position?
function ownedAnywhere(owned: bool[], args: Operand[], x: usize): bool {
  let i: usize = 0;
  while (i < args.length) {
    if (ownedAt(owned, i) && isLocal(args[i], x)) {
      return true;
    }
    i += 1;
  }
  return false;
}

// Does `ins` define a fresh Unique reference local?
function freshDef(f: MFunction, ins: Instr): Option<usize> {
  return match (ins) {
    IStructNew(d, _, _) => isRefTy(f.locals[d].ty) ? Some(d) : None,
    IArrayNew(d, _, _) => Some(d),
    IClosure(d, _, _) => Some(d),
    IIface(d, _, _) => Some(d),
    _ => None,
  };
}

// The set U of locals that are certainly Unique, one flag per local.
export class UniqueSet {
  u: bool[];
  private buf: UseBuf;

  constructor(u: bool[]) {
    this.u = u;
    this.buf = new UseBuf();
  }

  // Can `ins` change U? Only an instruction that creates or keeps a Unique object, or that names a local of U or defines one.
  private inert(ins: Instr): bool {
    const special = match (ins) {
      ICall(_, _, _) => true,
      IMakeUnique(_) => true,
      IMove(_, _) => true,
      IStructNew(_, _, _) => true,
      IArrayNew(_, _, _) => true,
      IClosure(_, _, _) => true,
      IIface(_, _, _) => true,
      _ => false,
    };
    if (special) {
      return false;
    }
    match (instrDef(ins)) {
      Some(d) => {
        if (this.u[d]) {
          return false;
        }
      },
      None => {},
    }
    this.buf.ofInstr(ins);
    let k: usize = 0;
    while (k < this.buf.n) {
      if (this.u[this.buf.xs[k]]) {
        return false;
      }
      k += 1;
    }
    return true;
  }

  // U after `ins`, updated in place.
  step(prog: MProgram, f: MFunction, ins: Instr): void {
    if (this.inert(ins)) {
      return;
    }
    const keep = keptObject(ins);
    const kept = callKept(prog, f, ins);
    const moved = match (ins) {
      IMove(d, s) => d != s && this.u[s],
      _ => false,
    };
    for (const l of instrUses(ins)) {
      if ((keep.isNone() || keep.unwrap() != l) && !kept.includes(l)) {
        this.u[l] = false;
      }
    }
    match (instrDef(ins)) {
      Some(d) => {
        this.u[d] = false;
      },
      None => {},
    }
    match (freshDef(f, ins)) {
      Some(d) => {
        this.u[d] = true;
      },
      None => {},
    }
    match (ins) {
      IMakeUnique(x) => {
        this.u[x] = true;
      },
      IMove(d, _) => {
        if (moved) {
          this.u[d] = true;
        }
      },
      ICall(dst, g, args) => {
        const callee = prog.functions[g];
        if (callee.uniqueOut) {
          if (callee.inout) {
            match (args[0]) {
              OLocal(x) => {
                this.u[x] = true;
              },
              _ => {},
            }
          } else {
            match (dst) {
              Some(d) => {
                this.u[d] = true;
              },
              None => {},
            }
          }
        }
      },
      _ => {},
    }
  }
}

// The set U at the entry of every block (None: not reached), by a worklist to the greatest fixpoint.
@Requires(fnShapeOk(f))
@Ensures(result.length == f.blocks.length)
export function uniqueEntry(prog: MProgram, f: MFunction): Option<bool[]>[] {
  let ins: Option<bool[]>[] = f.blocks.map(b => None);
  let entry = f.locals.map(l => false);
  if (f.uniqueIn) {
    entry[0] = true; // rule U2: the receiver of a unique-in function
  }
  ins[0] = Some(entry);
  let work: usize[] = [0];
  while (work.length > 0) {
    const b = work.pop().unwrap();
    let st = new UniqueSet(ins[b].unwrap());
    for (const i of f.blocks[b].instrs) {
      st.step(prog, f, i);
    }
    const u = st.u;
    for (const s of successors(f.blocks[b].term)) {
      match (ins[s]) {
        None => {
          ins[s] = Some(u);
          work.push(s);
        },
        Some(old) => {
          let changed = false;
          let k: usize = 0;
          let meet = old;
          while (k < meet.length) {
            if (meet[k] && !u[k]) {
              meet[k] = false;
              changed = true;
            }
            k += 1;
          }
          if (changed) {
            ins[s] = Some(meet);
            work.push(s);
          }
        },
      }
    }
  }
  return ins;
}

// `blk` without the `makeunique` of a local that is certainly Unique, entered with the set `entry`.
function dropInBlock(prog: MProgram, f: MFunction, blk: MBlock, entry: bool[]): MBlock {
  let plan = new RewritePlan(blk.instrs.length);
  let st = new UniqueSet(entry);
  let i: usize = 0;
  while (i < blk.instrs.length) {
    const ins = blk.instrs[i];
    match (ins) {
      IMakeUnique(x) => {
        if (st.u[x]) {
          plan.remove(i);
        }
      },
      _ => {},
    }
    st.step(prog, f, ins);
    i += 1;
  }
  return plan.apply(blk);
}

// `f` without the `makeunique` instructions whose operand is certainly Unique.
@Requires(fnWellFormed(prog, f))
@Ensures(passKept(f, result) && result.blocks.length == f.blocks.length)
@Ensures(makeUniqueCount(result) <= makeUniqueCount(f) && instrCount(result) <= instrCount(f))
export function dropUniqueChecks(prog: MProgram, f: MFunction): MFunction {
  if (makeUniqueCount(f) == 0) {
    return f;
  }
  const states = uniqueEntry(prog, f);
  let blocks: MBlock[] = [];
  let b: usize = 0;
  while (b < f.blocks.length) {
    match (states[b]) {
      Some(u) => {
        blocks.push(dropInBlock(prog, f, f.blocks[b], u));
      },
      None => {
        blocks.push(f.blocks[b]);
      },
    }
    b += 1;
  }
  return withBody(f, f.locals, blocks);
}

// Every function of `p` through `dropUniqueChecks`.
export function dropUniqueProgram(p: MProgram): MProgram {
  return MProgram {
    functions: p.functions.map(f => dropUniqueChecks(p, f)),
    strings: p.strings,
    main: p.main,
    vtables: p.vtables,
    inlineFns: p.inlineFns,
  };
}
