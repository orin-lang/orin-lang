// The expression checker: literals, names, operators, member and index access, records, calls (generic
// inference, built-ins, methods, constructors, the array API and `Map`), places, and arrow functions.
// Port of `FnCx` (bootstrap/src/checker/mod.rs).
//
// `ExprChecker` owns the context of the function body being checked (`FnCtx`). Its methods return the
// typed HIR of the expression or a diagnostic (the first error aborts the body); everything they learn
// (new locals, hoisted statements, generic instances) is left in `fx`. A check that fails may leave `fx`
// half changed, so a trial check that is allowed to fail (`methodCall`, argument inference) snapshots
// `fx` first (values are copy-on-write, so that is cheap) and restores it.
//
// Constructs that contain statements (a `match` with block arms, an arrow function with a block
// body) are checked by the statement checker (stmt.or), which depends on this file; the cycle is
// closed by the interface `BlockHost`, which the statement checker implements.

import { Span, Diagnostic, diag, spanTo } from "../diag";
import {
  Ident, Block, Expr, ExprKind, FieldInit, MatchArm, TypeExpr, TFn, ArrowParam, ArrowBody, UnaryOp,
  BinaryOp, DRecord, DUnion, OxElement, OxAttr, OxChild, OxValue, oxIsComponent, Param, TypeExprKind,
} from "../syntax";
import {
  Type, HBlock, HStmt, Place, PlaceElem, HExpr, HExprKind, FieldInitH, Builtin, MutBuiltin, UnOp, HArm, HPattern,
  BinOp, grantTypeName, kindType, platOpCount, fnAddrEntries,
} from "../hir";
import {
  ClassInfo, MethodInfo, ValEnt, Inst, mapOrigin, parOrigin, mapGenType, isMapKeyType, EntRecord, EntUnion,
  EntAlias, EntGen, EntIface, EntBuiltin, typeEq, isBool, isString, isVoid, isIntish, isFloatTy,
  isArrayTy, isIface, isSignedInt, isFn, showType, mismatch, globalVal, findType, findVal, originOf,
  boundsOf, ifaceMethodIndex, IfaceSig, typeInRange, isWellFormedEnv, CmOld, CmEnsures, sameContractMode, inContract,
  isEnsuresMode, isOldMode, isClassMode, isStaticMode, isMutRetMode, isUnit, isRecordKind, isNamespaceName, nsShadowErr, nsValueErr,
} from "./env";
import { checkBounds, internVtable } from "./ifaces";
import {
  classOfRec, classOfGeneric, findMethod, fieldIsPrivate, recordImplements, mapKeyError,
} from "./classes";
import { cmpOperator, cmpMethodKind, cmpMethodApplies, cmpMethodExpr, opCmpKind, isCompositeTy } from "./cmpexpr";
import { eqFunc, hashFunc } from "./derive";
import { FnCtx, newClosureCtx } from "./fnctx";
import { builtinSig, methodSig, grantNeeded } from "./builtins";
import { hasResource } from "./resources";
import {
  convMethodKind, convExpr, arithMethodMode, arithExpr, bitMethodMode, bitExpr, parseFnKind, parseExpr,
} from "./ints";
import {
  TScope, resolveType, resolveSig, aliasType, instType, instFunc, indexOfName,
} from "./types";
import {
  mk, noExprs, nopExpr, isNop, isArithOp, untypedInt, toBinOp, intishHint, hintOf, expIsF32,
  isFloatHint, intLitValue, expFn, fieldIndex, fieldDeclIndex, missingNames, recordHasFnField,
  paramNameList, selfTypeExpr, tailTypes, noPre, intLiteral, bigIntLiteral, negIntLiteral,
  negBigLiteral, interpolated, negOperandErr, logicOperandErr, impliesOperandErr, binaryType,
  extendPath, purePlace, noField, unresolvedName, condHoistErr, thisErr, capturedErr, mapKeyErr,
  testGuard, isArrayApi, isParScalar, parFnName, elemSuffix, mapReadFn, isOptionTy, isResultTy, isRecordTy, isUnionTy,
} from "./ops";
import { liftClosure, wrapperOf } from "./lift";
import { Inference, grantMissingErr, grantMismatchErr } from "./call";
import { localsBound, placeBound } from "./hirok";
import {
  OxOut, OxProvider, OxMarkup, OxComponents, isOxMarkup, oxProvider, sealedErr, oxEncodeStatic, oxIsVoid, oxIsRawText, oxRuleFor,
  isTagName, isAttrName, asciiLower, oxOutNew, oxOutStatic, oxOutDyn, oxOutFinish,
} from "./ox";

export type BlockOut = { fx: FnCtx; block: HBlock; div: bool; };

// OX (ADR-0044): one child converted for a slot (`splice`: an array to concatenate in), and a temporary of a
// component call evaluated in source order (`ref` names it, `lets` are all temporaries so far).
type OxItem = { value: HExpr; splice: bool; };
type OxTemp = { ref: Expr; lets: HStmt[]; };
type OxPiece = { presence: bool; piece: HExpr; };
// The parameters of a called function or method as a component call sees them: names, whether each may be left out
// (`Option<T>`) and the types when known (for evaluating attribute values in order).
type OxSig = { names: string[]; opt: bool[]; tys: Option<Type[]>; };

function oxSigOfParams(ps: Param[], tys: Option<Type[]>): OxSig {
  return OxSig { names: ps.map(p => p.name.name), opt: ps.map(p => isOptionTe(p.ty)), tys: tys };
}

function oxIndexOf(names: string[], name: string): int {
  let i: usize = 0;
  while (i < names.length) {
    if (names[i] == name) {
      return i.toInt();
    }
    i += 1;
  }
  return -1;
}

// The dotted text of a member tag's receiver path (`ui`, `this`, `a.b`).
function oxPathText(e: Expr): string {
  return match (e.kind) {
    EIdent(id) => id.name,
    EThis => "this",
    EMember(b, n) => oxPathText(b) + "." + n.name,
    _ => "?",
  };
}

// A parameter written as `Option<..>` (it may be left out of a markup call).
function isOptionTe(te: TypeExpr): bool {
  return match (te.kind) {
    TNamed(n, args) => n.name == "Option" && args.length == 1,
    _ => false,
  };
}

// Entry `k` of attribute `j` (names are lower-cased) is overridden when the same name occurs later: after it in the
// same spread, or in a later attribute.
function oxOverridden(names: string[][], j: usize, k: usize): bool {
  const n = names[j][k];
  let i = k + 1;
  while (i < names[j].length) {
    if (names[j][i] == n) {
      return true;
    }
    i += 1;
  }
  let a = j + 1;
  while (a < names.length) {
    if (names[a].some(x => x == n)) {
      return true;
    }
    a += 1;
  }
  return false;
}

// `lets` evaluated, then `value`: `match (true) { _ => { lets; value } }`.
function oxBlock(lets: HStmt[], value: HExpr, span: Span): HExpr {
  const arm = HArm { pattern: HPWildcard, body: HBlock { stmts: lets }, value: Some(value) };
  return mk(XMatch(mk(XBool(true), TyBool, span), [arm]), value.ty, span);
}

// An attribute value whose evaluation has no effect, so its order does not matter: a literal, a name, a function.
function oxTrivial(x: Expr): bool {
  return match (x.kind) {
    EInt(_) => true,
    EFloat(_) => true,
    EStr(_) => true,
    EBool(_) => true,
    EIdent(_) => true,
    EArrow(_, _, _) => true,
    _ => false,
  };
}

// The fragment `<>kids</>` (a slot's content, checked against the parameter type).
function oxFragmentOf(kids: OxChild[], span: Span): Expr {
  const noAttrs: OxAttr[] = [];
  return Expr { kind: EOx(OxElement { recv: None, name: None, attrs: noAttrs, children: kids, selfClosing: false, span: span }), span: span };
}
export type StmtOut = { fx: FnCtx; stmt: HStmt; div: bool; };
export type MatchOut = { fx: FnCtx; expr: HExpr; div: bool; };

// What the expression checker needs from the statement checker. Each call takes the context, which the
// statement checker uses and returns updated (it is the same context, threaded through).
export interface BlockHost {
  block(fx: FnCtx, b: Block): Result<BlockOut, Diagnostic>;
  stmtExpr(fx: FnCtx, e: Expr): Result<StmtOut, Diagnostic>;
  matchExpr(
    fx: FnCtx,
    span: Span,
    scrut: Expr,
    arms: MatchArm[],
    exp: Option<Type>,
    stmtPos: bool,
  ): Result<MatchOut, Diagnostic>;
}

// A checked assignable place: its root local and path, whether the root was declared with `let`.
export type PlaceInfo = { place: Place; mutable: bool; rootName: string; };

type InferOut = { tys: Type[]; args: HExpr[]; };
type MethSig = { fid: usize; params: Type[]; ret: Type; srcRet: Type; retRec: usize; };
type GenMeth = { ms: MethSig; args: HExpr[]; };

// Explicit type arguments on something that is not a generic method (ADR-0040).
function notGenericMethod(name: Ident): Diagnostic {
  return diag("E0400", name.span, "`" + name.name + "` is not a generic method and takes no type arguments");
}
type Pair = { l: HExpr; r: HExpr; };

// The environment the context works on stays well-formed (the instance table fits its tables, every
// function-value wrapper is a lifted function): checking only ever grows it.
@Invariant(isWellFormedEnv(this.fx.env))
export class ExprChecker {
  fx: FnCtx;
  private host: BlockHost;

  constructor(fx: FnCtx, host: BlockHost) {
    this.fx = fx;
    this.host = host;
  }

  // ===========================================================================
  // Entry points (the statement checker calls these)
  // ===========================================================================

  // Checks `e` against the expected type `exp` (a hint: integer literals adopt it, arrow functions
  // take their parameter types from it). The node's type is well-formed and every local it mentions
  // exists. A successful check leaves the scopes, loops and contract mode as they were.
  @Ensures(result.isOk() ==> typeInRange(this.fx.env, result.unwrap().ty))
  @Ensures(result.isOk() ==> localsBound(result.unwrap(), this.fx.locals.length))
  @Ensures(result.isOk() ==> this.fx.scope.depth() == old(this.fx.scope.depth()))
  @Ensures(result.isOk()
      ==> this.fx.loops.length == old(this.fx.loops.length)
          && sameContractMode(this.fx.cmode, old(this.fx.cmode)))
  @Ensures(result.isOk() ==> this.fx.pre.length >= old(this.fx.pre.length))
  @Ensures(this.fx.locals.length >= old(this.fx.locals.length))
  check(e: Expr, exp: Option<Type>): Result<HExpr, Diagnostic> {
    return this.ex(e, exp);
  }

  // Checks `e` against the type `ty`: the result has exactly that type (a class value converts to an
  // interface type it implements, the one implicit conversion, ADR-0019).
  @Requires(typeInRange(this.fx.env, ty))
  @Ensures(result.isOk() ==> typeEq(result.unwrap().ty, ty))
  @Ensures(result.isOk() ==> localsBound(result.unwrap(), this.fx.locals.length))
  @Ensures(result.isOk() ==> this.fx.scope.depth() == old(this.fx.scope.depth()))
  expect(e: Expr, ty: Type): Result<HExpr, Diagnostic> {
    return this.ep(e, ty);
  }

  // Resolves a written type in the type parameters of the function being checked.
  @Ensures(result.isOk() ==> typeInRange(this.fx.env, result.unwrap()))
  resolve(te: TypeExpr, voidOk: bool): Result<Type, Diagnostic> {
    const sc = new TScope(this.fx.unit, this.fx.tpNames, this.fx.tpTys, 0);
    const r = resolveType(this.fx.env, sc, te, voidOk)?;
    this.fx.adopt(r.env);
    return Ok(r.ty);
  }

  // The assignable place `e` denotes (a local, `this`, a field or an element of one).
  @Ensures(result.isOk() ==> placeBound(result.unwrap().place, this.fx.locals.length))
  @Ensures(result.isOk() ==> typeInRange(this.fx.env, result.unwrap().place.ty))
  place(e: Expr): Result<PlaceInfo, Diagnostic> {
    return this.placeOf(e);
  }

  // The local `this` as an expression.
  @Ensures(localsBound(result, this.fx.locals.length) || this.fx.locals.length == 0)
  thisRead(span: Span): HExpr {
    const l = this.fx.thisLocal();
    return mk(XLocal(l), this.fx.locals[l].ty, span);
  }

  // ===========================================================================
  // Expressions
  // ===========================================================================

  @Ensures(result.isOk() ==> typeInRange(this.fx.env, result.unwrap().ty))
  private ex(e: Expr, exp: Option<Type>): Result<HExpr, Diagnostic> {
    const span = e.span;
    match (e.kind) {
      EInt(n) => {
        return intLiteral(this.fx.env, n, exp, span);
      },
      EBigInt(n) => {
        return bigIntLiteral(this.fx.env, n, exp, span);
      },
      ETemplate(parts, xs) => {
        return this.template(span, parts, xs);
      },
      EFloat(t) => {
        return Ok(mk(XFloat(t), expIsF32(exp) ? TyF32 : TyFloat, span));
      },
      EStr(s) => {
        return Ok(mk(XStr(s), TyString, span));
      },
      EBool(b) => {
        return Ok(mk(XBool(b), TyBool, span));
      },
      EIdent(id) => {
        return this.ident(id, exp, span);
      },
      EUnary(op, x) => {
        return this.unary(span, op, x, exp);
      },
      EBinary(op, l, r) => {
        return this.binary(span, op, l, r, exp);
      },
      ECall(callee, args) => {
        return this.call(span, callee, args, exp);
      },
      EMember(base, name) => {
        return this.member(span, base, name);
      },
      EIndex(base, idx) => {
        return this.index(span, base, idx);
      },
      ETry(x) => {
        if (inContract(this.fx.cmode)) {
          return Err(diag("E0415", span, "`?` is not allowed in a contract expression"));
        }
        return this.tryExpr(span, x);
      },
      ECond(c, t, f) => {
        return this.cond(span, c, t, f, exp);
      },
      EArray(elems) => {
        return this.array(span, elems, exp);
      },
      ERecord(name, spread, fields) => {
        return this.record(span, name, None, spread, fields, exp);
      },
      ERecordT(name, targs, spread, fields) => {
        return this.record(span, name, Some(targs), spread, fields, exp);
      },
      ETyApp(_, _) => {
        return Err(
          diag("E0400", span, "type arguments are only allowed on a call or a record literal"),
        );
      },
      EMethodT(_, _, _) => {
        return Err(diag("E0400", span, "type arguments of a method are only allowed on a call"));
      },
      EMatch(s, arms) => {
        const r = this.host.matchExpr(this.fx, span, s, arms, exp, false)?;
        this.fx = r.fx;
        return Ok(r.expr);
      },
      ENew(name, targs, args) => {
        return this.newExpr(span, name, targs, args, exp);
      },
      EThis => {
        return this.thisExpr(span);
      },
      EArrow(ps, rte, body) => {
        return this.arrowExp(span, ps, rte, body, exp);
      },
      EOx(el) => {
        return this.ox(el, exp);
      },
    }
  }

  // Checks `e` against `ty`; a value of a class type converts to an interface type it implements.
  @Ensures(result.isOk() ==> typeEq(result.unwrap().ty, ty))
  private ep(e: Expr, ty: Type): Result<HExpr, Diagnostic> {
    const r = this.ex(e, Some(ty))?;
    if (!typeEq(r.ty, ty)) {
      return this.coerce(r, e.span, ty);
    }
    return Ok(r);
  }

  // The one implicit conversion of the language (ADR-0019): a value of a class type converts to an
  // interface type the class declares with `implements`. Anything else is a type mismatch.
  @Ensures(result.isOk() ==> typeEq(result.unwrap().ty, ty) && isIface(ty))
  private coerce(r: HExpr, span: Span, ty: Type): Result<HExpr, Diagnostic> {
    match (ty) {
      TyIface(i) => {
        return this.toIface(r, span, i);
      },
      _ => {
        return Err(mismatch(this.fx.env, span, ty, r.ty));
      },
    }
  }

  @Requires(i < this.fx.env.ifaces.length)
  @Ensures(result.isOk() ==> typeEq(result.unwrap().ty, TyIface(i)))
  private toIface(r: HExpr, span: Span, i: usize): Result<HExpr, Diagnostic> {
    const env = this.fx.env;
    match (r.ty) {
      TyRecord(rec) => {
        const co = classOfRec(env, rec);
        if (co.isSome()) {
          if (!recordImplements(env, rec, i)) {
            return Err(
              diag(
                "E0417",
                span,
                "class `" + env.classes[co.unwrap()].name + "` does not implement interface `"
                    + env.ifaces[i].name + "`; declare `class " + env.classes[co.unwrap()].name
                    + " implements " + env.ifaces[i].decl.name.name + "` (conformance is nominal)",
              ),
            );
          }
          if (env.classes[co.unwrap()].gid >= 0 && (this.fx.abs || this.fx.probe)) {
            // instance of a generic class in an abstract check / probe: no instances are created (HIR discarded)
            return Ok(mk(XIface(0, r), TyIface(i), span));
          }
          const vo = internVtable(env, co.unwrap(), rec, i, this.fx.depth, span)?;
          this.fx.adopt(vo.env);
          return Ok(mk(XIface(vo.id, r), TyIface(i), span));
        }
        if (recordImplements(env, rec, i)) {
          // the opaque type of a bounded type parameter (abstract check; the HIR is discarded)
          return Ok(mk(XIface(0, r), TyIface(i), span));
        }
      },
      _ => {},
    }
    return Err(mismatch(env, span, TyIface(i), r.ty));
  }

  // `s.m(args)` on an interface value, or on a value of a type parameter bounded by the interface
  // (abstract check): a call through the vtable (ADR-0019).
  @Requires(i < this.fx.env.ifaces.length)
  private ifaceCall(
    b: HExpr,
    span: Span,
    i: usize,
    name: Ident,
    args: Expr[],
  ): Result<HExpr, Diagnostic> {
    const info = this.fx.env.ifaces[i];
    const so = ifaceMethodIndex(info, name.name);
    if (so.isNone()) {
      return Err(
        diag("E0405", name.span, "no method `" + name.name + "` on interface `" + info.name + "`"),
      );
    }
    const slot = so.unwrap();
    const m = info.methods[slot];
    const a = this.argsExpect(span, "method `" + name.name + "`", args, m.params)?;
    return Ok(mk(XCallVirtual(b, slot, a), m.ret, span));
  }

  // A template literal: the parts and the interpolated values are concatenated left to right with `+` on strings,
  // which the lowering turns into appends onto one fresh buffer (linear, no repeated copying).
  @Ensures(result.isOk() ==> isString(result.unwrap().ty))
  private template(span: Span, parts: string[], xs: Expr[]): Result<HExpr, Diagnostic> {
    let acc: Option<HExpr> = None;
    let i: usize = 0;
    while (i < parts.length) {
      if (parts[i].length > 0) {
        const piece = mk(XStr(parts[i]), TyString, span);
        acc = match (acc) {
          Some(a) => Some(mk(XBinary(OpAdd, a, piece), TyString, span)),
          None => Some(piece),
        };
      }
      if (i < xs.length) {
        const r = this.ex(xs[i], None)?;
        const h = interpolated(this.fx.env, r, xs[i].span)?;
        acc = match (acc) {
          Some(a) => Some(mk(XBinary(OpAdd, a, h), TyString, span)),
          None => Some(h),
        };
      }
      i += 1;
    }
    return match (acc) {
      Some(a) => Ok(a),
      None => Ok(mk(XStr(""), TyString, span)),
    };
  }

  // ---------------------------------------------------------------------------
  // OX markup (ADR-0043, ADR-0044; the provider, its rules and the output buffer are in ox.or)
  // ---------------------------------------------------------------------------

  // A markup expression: a component call, a fragment (typed by the expected type, ADR-0044 §4.2), or an intrinsic
  // element of the file's provider (a `Markup` provider renders it into one fused buffer; a `Components` provider
  // calls its function of that name).
  private ox(el: OxElement, exp: Option<Type>): Result<HExpr, Diagnostic> {
    const p = oxProvider(this.fx.env, this.fx.unit, el.span)?;
    if (oxIsComponent(el)) {
      return this.oxComponent(p, el);
    }
    if (el.name.isNone()) {
      return this.oxFragment(p, el.children, exp, el.span);
    }
    if (!isOxMarkup(p.kind)) {
      return this.oxProviderElement(p, el);
    }
    const o = this.oxEmit(p, el, oxOutNew())?;
    return Ok(this.oxWrap(p, oxOutFinish(o, el.span), el.span));
  }

  private oxWrap(p: OxProvider, s: HExpr, span: Span): HExpr {
    return mk(XCall(p.wrap, [s]), p.result, span);
  }

  private oxModule(p: OxProvider): string {
    return this.fx.env.units[p.unit].name;
  }

  // Appends the rendering of `el` to `o` (a `Markup` provider): a component as its value (`oxDynChild`), an intrinsic
  // element as its tags with the attributes and children in between (nested elements inline, in the same buffer), a
  // fragment as its children.
  private oxEmit(p: OxProvider, el: OxElement, o0: OxOut): Result<OxOut, Diagnostic> {
    if (oxIsComponent(el)) {
      const c = this.oxComponent(p, el)?;
      return this.oxDynChild(p, c, el.span, o0);
    }
    if (el.name.isNone()) {
      return this.oxChildren(p, el.children, false, o0);
    }
    const tag = el.name.unwrap();
    if (!isTagName(tag.name)) {
      return Err(
        diag(
          "E0494",
          tag.span,
          "`" + tag.name + "` is not an element name (a lower-case letter, then letters, digits, `-` and `_`); a component name starts with an upper-case letter",
        ),
      );
    }
    let o = oxOutStatic(o0, "<" + tag.name);
    o = this.oxAttrs(p, el.attrs, o)?;
    if (oxIsVoid(p, tag.name)) {
      if (el.children.length > 0) {
        return Err(
          diag("E0494", tag.span, "`<" + tag.name + ">` is a void element of `" + this.oxModule(p) + "` and cannot have children"),
        );
      }
      return Ok(oxOutStatic(o, p.voidEnd));
    }
    o = oxOutStatic(o, ">");
    o = this.oxChildren(p, el.children, oxIsRawText(p, tag.name), o)?;
    return Ok(oxOutStatic(o, "</" + tag.name + ">"));
  }

  // The attributes of an intrinsic element. Without a spread, one after the other. With spreads (ADR-0044 §4.3): each
  // `{...r}` evaluates `r` once into a temporary, then every field `f` is the attribute `f={tmp.f}` at that position.
  // When a name occurs more than once (ASCII case-insensitively), the one written later wins; the others are still
  // evaluated, in source order, and their text is dropped.
  private oxAttrs(p: OxProvider, attrs: OxAttr[], o0: OxOut): Result<OxOut, Diagnostic> {
    let o = o0;
    let spread = false;
    for (const a of attrs) {
      match (a.value) {
        JVSpread(_) => {
          spread = true;
        },
        _ => {},
      }
    }
    if (!spread) {
      for (const a of attrs) {
        o = this.oxAttr(p, a, o)?;
      }
      return Ok(o);
    }
    const env = this.fx.env;
    // Pass 1: the lower-cased attribute names of each entry (a spread contributes its fields), and for each spread
    // its temporary and record.
    let names: string[][] = [];
    let temps: OxTemp[] = [];
    let recs: usize[] = [];
    for (const a of attrs) {
      let ns: string[] = [];
      match (a.value) {
        JVSpread(x) => {
          const v = this.ex(x, None)?;
          const rid = match (v.ty) {
            TyRecord(r) => r,
            _ => env.records.length,
          };
          if (rid >= env.records.length) {
            return Err(
              diag("E0492", x.span, "a spread `{...}` needs a record value, found `" + showType(env, v.ty) + "`"),
            );
          }
          temps.push(this.oxTemp(v, a.span, [])?);
          recs.push(rid);
          for (const f of env.records[rid].fields) {
            ns.push(asciiLower(f.name));
          }
        },
        _ => {
          temps.push(OxTemp { ref: Expr { kind: EBool(true), span: a.span }, lets: [] });
          recs.push(0);
          ns.push(asciiLower(a.name.name));
        },
      }
      names.push(ns);
    }
    // Pass 2: in source order.
    let j: usize = 0;
    while (j < attrs.length) {
      const a = attrs[j];
      match (a.value) {
        JVSpread(x) => {
          let s = oxOutNew();
          let k: usize = 0;
          for (const f of env.records[recs[j]].fields) {
            const fa = OxAttr {
              name: Ident { name: f.name, span: x.span },
              value: JVExpr(Expr { kind: EMember(temps[j].ref, Ident { name: f.name, span: x.span }), span: x.span }),
              span: x.span,
            };
            if (oxOverridden(names, j, k)) {
              this.oxAttr(p, fa, oxOutNew())?;
            } else {
              s = this.oxAttr(p, fa, s)?;
            }
            k += 1;
          }
          o = oxOutDyn(o, oxBlock(temps[j].lets, oxOutFinish(s, x.span), x.span), x.span);
        },
        _ => {
          if (oxOverridden(names, j, 0)) {
            const d = this.oxAttr(p, a, oxOutNew())?;
            if (d.parts.length > 0) {
              const id = this.fx.newTemp("$ox", TyString);
              const lets = [HLet(id, oxOutFinish(d, a.span))];
              o = oxOutDyn(o, oxBlock(lets, mk(XStr(""), TyString, a.span), a.span), a.span);
            }
          } else {
            o = this.oxAttr(p, a, o)?;
          }
        },
      }
      j += 1;
    }
    return Ok(o);
  }

  // One attribute of an intrinsic element: ` name` (a bare name, or a `bool` that is true, if the provider has presence
  // attributes), ` name="value"` with the value encoded (at compile time for a literal, by the provider's `attr` or the
  // matching rule's `convert` otherwise).
  private oxAttr(p: OxProvider, a: OxAttr, o: OxOut): Result<OxOut, Diagnostic> {
    const name = a.name.name;
    if (!isAttrName(name)) {
      return Err(diag("E0494", a.name.span, "`" + name + "` is not an attribute name"));
    }
    match (a.value) {
      JVTrue => {
        return this.oxPresent(p, name, a.span, o);
      },
      JVStr(v) => {
        return Ok(oxOutStatic(o, " " + name + "=\"" + oxEncodeStatic(p, v) + "\""));
      },
      JVSpread(_) => {
        return Ok(o);
      },
      JVExpr(x) => {
        match (x.kind) {
          EStr(v) => {
            return Ok(oxOutStatic(o, " " + name + "=\"" + oxEncodeStatic(p, v) + "\""));
          },
          _ => {},
        }
        const lits = this.oxLiteralChoice(p, x, false)?;
        if (lits.isSome()) {
          const o2 = oxOutStatic(o, " " + name + "=\"");
          return Ok(oxOutStatic(oxOutDyn(o2, lits.unwrap(), x.span), "\""));
        }
        const rule = oxRuleFor(p, name);
        let conv = p.attr;
        if (rule.isSome()) {
          match (rule.unwrap().convert) {
            Some(f) => {
              conv = f;
            },
            None => {
              return Err(
                diag(
                  "E0493",
                  x.span,
                  "the attribute `" + name + "` only takes a written value, not a computed one (a rule of the OX provider `"
                      + this.oxModule(p) + "`); write a string literal",
                ),
              );
            },
          }
        }
        const v = this.ex(x, None)?;
        if (isOptionTy(v.ty)) {
          return this.oxAttrOption(p, name, v, conv, x.span, o);
        }
        const pc = this.oxAttrPiece(p, name, v, conv, x.span)?;
        if (pc.presence) {
          return Ok(oxOutDyn(o, pc.piece, x.span));
        }
        const o2 = oxOutStatic(o, " " + name + "=\"");
        return Ok(oxOutStatic(oxOutDyn(o2, pc.piece, x.span), "\""));
      },
    }
  }

  // The computed value `v` of attribute `name`: a `bool` is the presence text (` name` or nothing), a string goes
  // through `conv`, a number is decimal text; anything else is E0492.
  private oxAttrPiece(p: OxProvider, name: string, v: HExpr, conv: usize, span: Span): Result<OxPiece, Diagnostic> {
    if (isBool(v.ty)) {
      if (!p.presence) {
        return Err(this.oxNoPresence(p, name, span));
      }
      const on = mk(XStr(" " + name), TyString, span);
      const off = mk(XStr(""), TyString, span);
      return Ok(OxPiece { presence: true, piece: mk(XCond(v, on, off), TyString, span) });
    }
    if (isString(v.ty)) {
      return Ok(OxPiece { presence: false, piece: mk(XCall(conv, [v]), TyString, span) });
    }
    if (isIntish(v.ty) || isFloatTy(v.ty)) {
      return Ok(OxPiece { presence: false, piece: interpolated(this.fx.env, v, span)? });
    }
    return Err(
      diag(
        "E0492",
        span,
        "the attribute `" + name + "` must be a `string`, a number" + (p.presence ? ", a `bool`" : "")
            + " or an `Option` of one of these, found `" + showType(this.fx.env, v.ty) + "`",
      ),
    );
  }

  // `a={opt}` with `opt: Option<T>`: nothing for `None`, the attribute for `Some(v)` as if written `a={v}`. One
  // dynamic piece: `opt` is evaluated once into a temporary.
  private oxAttrOption(p: OxProvider, name: string, v: HExpr, conv: usize, span: Span, o: OxOut): Result<OxOut, Diagnostic> {
    const inner = match (v.ty) {
      TyOption(e) => e,
      _ => v.ty,
    };
    const id = this.fx.newTemp("$ox", v.ty);
    const ref = mk(XLocal(id), v.ty, span);
    const some = mk(XBuiltin(BOptUnwrap, [ref]), inner, span);
    const pc = this.oxAttrPiece(p, name, some, conv, span)?;
    let text = pc.piece;
    if (!pc.presence) {
      const pre = mk(XStr(" " + name + "=\""), TyString, span);
      text = mk(
        XBinary(OpAdd, mk(XBinary(OpAdd, pre, pc.piece), TyString, span), mk(XStr("\""), TyString, span)),
        TyString,
        span,
      );
    }
    const test = mk(XBuiltin(BOptIsSome, [ref]), TyBool, span);
    const value = mk(XCond(test, text, mk(XStr(""), TyString, span)), TyString, span);
    return Ok(oxOutDyn(o, oxBlock([HLet(id, v)], value, span), span));
  }

  private oxPresent(p: OxProvider, name: string, span: Span, o: OxOut): Result<OxOut, Diagnostic> {
    if (!p.presence) {
      return Err(this.oxNoPresence(p, name, span));
    }
    return Ok(oxOutStatic(o, " " + name));
  }

  private oxNoPresence(p: OxProvider, name: string, span: Span): Diagnostic {
    return diag(
      "E0492",
      span,
      "the OX provider `" + this.oxModule(p) + "` has no presence attributes: give `" + name + "` a value (`" + name
          + "=\"..\"`)",
    );
  }

  // The children of an intrinsic element or fragment into the buffer. `raw`: a raw-text element of the provider, whose
  // content is written unencoded and therefore must be static.
  private oxChildren(p: OxProvider, kids: OxChild[], raw: bool, o0: OxOut): Result<OxOut, Diagnostic> {
    let o = o0;
    for (const k of kids) {
      match (k) {
        JText(t, sp) => {
          if (raw && t.includes("</")) {
            return Err(diag("E0493", sp, "the text of a raw-text element cannot contain `</`"));
          }
          o = oxOutStatic(o, raw ? t : oxEncodeStatic(p, t));
        },
        JElem(sub) => {
          if (raw) {
            return Err(this.oxRawErr(p, sub.span));
          }
          o = this.oxEmit(p, sub, o)?;
        },
        JExpr(x) => {
          o = this.oxChildExpr(p, x, raw, o)?;
        },
        JSlot(n, _, _) => {
          return Err(this.oxSlotPlace(n));
        },
      }
    }
    return Ok(o);
  }

  private oxRawErr(p: OxProvider, span: Span): Diagnostic {
    return diag(
      "E0493",
      span,
      "a raw-text element of `" + this.oxModule(p) + "` (" + p.rawTextTags.join(", ")
          + ") can only contain static text (its content is not encoded)",
    );
  }

  private oxSlotPlace(n: Ident): Diagnostic {
    return diag("E0491", n.span, "a named slot `<:" + n.name + ">` can only appear directly inside a component");
  }

  // A `{x}` child in the buffer: a string literal (or a choice of literals) is encoded at compile time, anything else
  // is a dynamic child (`oxDynChild`).
  private oxChildExpr(p: OxProvider, x: Expr, raw: bool, o: OxOut): Result<OxOut, Diagnostic> {
    match (x.kind) {
      EStr(v) => {
        if (raw && v.includes("</")) {
          return Err(diag("E0493", x.span, "the text of a raw-text element cannot contain `</`"));
        }
        return Ok(oxOutStatic(o, raw ? v : oxEncodeStatic(p, v)));
      },
      _ => {},
    }
    const lits = this.oxLiteralChoice(p, x, raw)?;
    if (lits.isSome()) {
      return Ok(oxOutDyn(o, lits.unwrap(), x.span));
    }
    if (raw) {
      return Err(this.oxRawErr(p, x.span));
    }
    const v = this.ex(x, None)?;
    return this.oxDynChild(p, v, x.span, o);
  }

  // A computed child in the buffer: a `string` through the provider's `text`, an R / R[] through `embed` / `embedAll`,
  // a number as its decimal text.
  private oxDynChild(p: OxProvider, v: HExpr, span: Span, o: OxOut): Result<OxOut, Diagnostic> {
    if (isString(v.ty)) {
      return Ok(oxOutDyn(o, mk(XCall(p.text, [v]), TyString, span), span));
    }
    if (typeEq(v.ty, p.result)) {
      return Ok(oxOutDyn(o, mk(XCall(p.embed, [v]), TyString, span), span));
    }
    if (typeEq(v.ty, TyArray(p.result))) {
      return Ok(oxOutDyn(o, mk(XCall(p.embedAll, [v]), TyString, span), span));
    }
    if (isIntish(v.ty) || isFloatTy(v.ty)) {
      return Ok(oxOutDyn(o, interpolated(this.fx.env, v, span)?, span));
    }
    const r = showType(this.fx.env, p.result);
    return Err(
      diag(
        "E0492",
        span,
        "a child here must be a `string`, `" + r + "`, `" + r + "[]` or a number, found `"
            + showType(this.fx.env, v.ty) + "`" + (isBool(v.ty) ? " (write `c ? <x /> : <></>`)" : ""),
      ),
    );
  }

  // `c ? "a" : "b"` with string literals in both branches (nested choices too): the choice between the two texts
  // encoded at compile time (`raw`: unencoded), so no encoding happens at run time. None for any other expression.
  private oxLiteralChoice(p: OxProvider, x: Expr, raw: bool): Result<Option<HExpr>, Diagnostic> {
    match (x.kind) {
      EStr(v) => {
        if (raw && v.includes("</")) {
          return Err(diag("E0493", x.span, "the text of a raw-text element cannot contain `</`"));
        }
        return Ok(Some(mk(XStr(raw ? v : oxEncodeStatic(p, v)), TyString, x.span)));
      },
      ECond(c, a, b) => {
        const ha = this.oxLiteralChoice(p, a, raw)?;
        const hb = this.oxLiteralChoice(p, b, raw)?;
        if (ha.isNone() || hb.isNone()) {
          return Ok(None);
        }
        const hc = this.ep(c, TyBool)?;
        return Ok(Some(mk(XCond(hc, ha.unwrap(), hb.unwrap()), TyString, x.span)));
      },
      _ => {
        return Ok(None);
      },
    }
  }

  // ---- fragments and slots: typed by the expected type (ADR-0044 §4.2) ----

  // The children `kids` as a value of the expected type `exp` (the provider's R when there is none).
  private oxFragment(p: OxProvider, kids: OxChild[], exp: Option<Type>, span: Span): Result<HExpr, Diagnostic> {
    const t = match (exp) {
      Some(x) => x,
      None => p.result,
    };
    if (typeEq(t, p.result)) {
      if (isOxMarkup(p.kind)) {
        const o = this.oxChildren(p, kids, false, oxOutNew())?;
        return Ok(this.oxWrap(p, oxOutFinish(o, span), span));
      }
      const items = this.oxItems(p, kids, p.result)?;
      if (items.length == 1 && !items[0].splice) {
        return Ok(items[0].value);
      }
      return Ok(mk(XCall(p.fragment, [this.oxArray(items, p.result, span)]), p.result, span));
    }
    match (t) {
      TyArray(e) => {
        return Ok(this.oxArray(this.oxItems(p, kids, e)?, e, span));
      },
      TyOption(e) => {
        if (kids.length == 0) {
          return Ok(mk(XVariant(1, noExprs()), t, span));
        }
        if (kids.length > 1) {
          return Err(this.oxCountErr(t, kids.length, span));
        }
        const one = this.oxItem(p, kids[0], e)?;
        if (one.splice) {
          return Err(this.oxCountErr(t, 2, one.value.span));
        }
        return Ok(mk(XVariant(0, [one.value]), t, span));
      },
      TyString => {
        return this.oxString(kids, span);
      },
      _ => {},
    }
    if (kids.length != 1) {
      return Err(this.oxCountErr(t, kids.length, span));
    }
    const one = this.oxItem(p, kids[0], t)?;
    if (one.splice) {
      return Err(this.oxCountErr(t, 2, one.value.span));
    }
    return Ok(one.value);
  }

  private oxCountErr(t: Type, n: usize, span: Span): Diagnostic {
    const ts = showType(this.fx.env, t);
    const want = isOptionTy(t) ? "at most one child" : "exactly one child";
    return diag(
      "E0491",
      span,
      "a slot of type `" + ts + "` takes " + want + ", found " + (n == 0 ? "none" : n.toString())
          + " (a list of children needs an array type)",
    );
  }

  // Text, string and number children as one string (a `string` slot: not encoded, it is a string, not markup).
  private oxString(kids: OxChild[], span: Span): Result<HExpr, Diagnostic> {
    let o = oxOutNew();
    for (const k of kids) {
      match (k) {
        JText(t, _) => {
          o = oxOutStatic(o, t);
        },
        JExpr(x) => {
          match (x.kind) {
            EStr(v) => {
              o = oxOutStatic(o, v);
            },
            _ => {
              const v = this.ex(x, None)?;
              if (isString(v.ty)) {
                o = oxOutDyn(o, v, x.span);
              } else if (isIntish(v.ty) || isFloatTy(v.ty)) {
                o = oxOutDyn(o, interpolated(this.fx.env, v, x.span)?, x.span);
              } else {
                return Err(
                  diag("E0492", x.span, "a `string` slot takes text, strings and numbers, found `" + showType(this.fx.env, v.ty) + "`"),
                );
              }
            },
          }
        },
        JElem(sub) => {
          return Err(diag("E0492", sub.span, "a `string` slot takes text, strings and numbers, not elements"));
        },
        JSlot(n, _, _) => {
          return Err(this.oxSlotPlace(n));
        },
      }
    }
    return Ok(oxOutFinish(o, span));
  }

  // Each child converted to `e`; an `{x}` of type `e[]` is marked to be spliced in.
  private oxItems(p: OxProvider, kids: OxChild[], e: Type): Result<OxItem[], Diagnostic> {
    let out: OxItem[] = [];
    for (const k of kids) {
      out.push(this.oxItem(p, k, e)?);
    }
    return Ok(out);
  }

  // One child as a value of type `e` (or of `e[]`, to splice): an element checked against `e`, text or a `string`
  // converted by the provider when `e` is its R.
  private oxItem(p: OxProvider, k: OxChild, e: Type): Result<OxItem, Diagnostic> {
    match (k) {
      JText(t, sp) => {
        return Ok(OxItem { value: this.oxFromText(p, mk(XStr(t), TyString, sp), true, e, sp)?, splice: false });
      },
      JSlot(n, _, _) => {
        return Err(this.oxSlotPlace(n));
      },
      JElem(sub) => {
        const v = this.ox(sub, Some(e))?;
        return this.oxFit(p, v, e, sub.span);
      },
      JExpr(x) => {
        const hint = match (x.kind) {
          EArray(_) => TyArray(e),
          _ => e,
        };
        const v = this.ex(x, Some(hint))?;
        return this.oxFit(p, v, e, x.span);
      },
    }
  }

  private oxFit(p: OxProvider, v: HExpr, e: Type, span: Span): Result<OxItem, Diagnostic> {
    if (typeEq(v.ty, e)) {
      return Ok(OxItem { value: v, splice: false });
    }
    if (typeEq(v.ty, TyArray(e))) {
      return Ok(OxItem { value: v, splice: true });
    }
    if (isString(v.ty)) {
      return Ok(OxItem { value: this.oxFromText(p, v, false, e, span)?, splice: false });
    }
    return Err(
      diag(
        "E0492",
        span,
        "expected a child of type `" + showType(this.fx.env, e) + "`, found `" + showType(this.fx.env, v.ty) + "`",
      ),
    );
  }

  // A string `s` (`literal`: written text) where a value of type `e` is expected.
  private oxFromText(p: OxProvider, s: HExpr, literal: bool, e: Type, span: Span): Result<HExpr, Diagnostic> {
    if (isString(e)) {
      return Ok(s);
    }
    if (typeEq(e, p.result)) {
      if (!isOxMarkup(p.kind)) {
        return Ok(mk(XCall(p.ctext, [s]), p.result, span));
      }
      const enc = match (s.kind) {
        XStr(t) => mk(XStr(oxEncodeStatic(p, t)), TyString, span),
        _ => mk(XCall(p.text, [s]), TyString, span),
      };
      return Ok(this.oxWrap(p, enc, span));
    }
    return Err(
      diag(
        "E0492",
        span,
        (literal ? "text" : "a `string`") + " cannot be a `" + showType(this.fx.env, e) + "` here",
      ),
    );
  }

  // The items as one array of `e`: runs of single items become array literals, spliced arrays are concatenated.
  private oxArray(items: OxItem[], e: Type, span: Span): HExpr {
    const at = TyArray(e);
    let acc: Option<HExpr> = None;
    let run: HExpr[] = [];
    for (const it of items) {
      if (it.splice) {
        if (run.length > 0) {
          acc = Some(this.oxConcat(acc, mk(XArray(run), at, span), at, span));
          run = [];
        }
        acc = Some(this.oxConcat(acc, it.value, at, span));
      } else {
        run.push(it.value);
      }
    }
    if (run.length > 0 || acc.isNone()) {
      acc = Some(this.oxConcat(acc, mk(XArray(run), at, span), at, span));
    }
    return acc.unwrap();
  }

  private oxConcat(acc: Option<HExpr>, next: HExpr, at: Type, span: Span): HExpr {
    return match (acc) {
      Some(a) => mk(XBuiltin(BArrConcat, [a, next]), at, span),
      None => next,
    };
  }

  // ---- components and provider elements ----

  // `<Card title={t} count={3}>children</Card>`: a call of the function `Card` (ADR-0044 §4.1).
  private oxComponent(p: OxProvider, el: OxElement): Result<HExpr, Diagnostic> {
    const tag = el.name.unwrap();
    if (el.recv.isSome()) {
      return this.oxMember(p, el);
    }
    if (this.fx.lookupVar(tag.name).isSome()) {
      return Err(
        diag("E0491", tag.span, "the component `" + tag.name + "` must be a function declared with `function`"),
      );
    }
    const g = globalVal(this.fx.env, this.fx.unit, tag.name);
    if (g.isNone()) {
      return Err(diag("E0491", tag.span, "unknown component `" + tag.name + "` (no function of that name in scope)"));
    }
    return match (g.unwrap()) {
      VFunc(fid) => this.oxCall(p, el, "component `" + tag.name + "`", Some(fid), None, this.oxSigOfFunc(fid)),
      VGFunc(gi) => this.oxCall(
        p, el, "component `" + tag.name + "`", None, Some(gi),
        oxSigOfParams(this.fx.env.gfuncs[gi].decl.params, None),
      ),
      _ => Err(diag("E0491", tag.span, "the component `" + tag.name + "` must be a function declared with `function`")),
    };
  }

  // `<label value="x" />` with a `Components` provider: a call of the provider's exported function `label`.
  private oxProviderElement(p: OxProvider, el: OxElement): Result<HExpr, Diagnostic> {
    const tag = el.name.unwrap();
    const g = globalVal(this.fx.env, p.unit, tag.name);
    let fid = this.fx.env.funcs.length;
    if (g.isSome()) {
      match (g.unwrap()) {
        VFunc(f) => {
          fid = f;
        },
        _ => {},
      }
    }
    if (fid >= this.fx.env.funcs.length || this.fx.env.funcs[fid].unit != p.unit || !this.fx.env.funcs[fid].decl.exported) {
      return Err(
        diag(
          "E0491",
          tag.span,
          "the OX provider `" + this.oxModule(p) + "` has no element `" + tag.name + "` (no exported, non-generic function of that name)",
        ),
      );
    }
    return this.oxCall(p, el, "element `" + tag.name + "`", Some(fid), None, this.oxSigOfFunc(fid));
  }

  private oxSigOfFunc(fid: usize): OxSig {
    const f = this.fx.env.funcs[fid];
    return oxSigOfParams(f.decl.params, Some(f.params));
  }

  // `<ui.Card title="x">..</ui.Card>`: a call of the method `Card` of the value `ui` (ADR-0044 §4.5), with the
  // component rules; the method's parameters give the attribute names. The receiver is a pure path (names, `this`,
  // field reads), so it is the same value whenever it is read: the final call reads it once, like `ui.Card(..)`.
  private oxMember(p: OxProvider, el: OxElement): Result<HExpr, Diagnostic> {
    const tag = el.name.unwrap();
    const recv = el.recv.unwrap();
    const shown = oxPathText(recv) + "." + tag.name;
    const env = this.fx.env;
    // `<Theme.Button>` where `Theme` names a class (not a value): its static method, resolved as `Theme.Button(..)` is
    const sc = this.oxStaticClass(recv);
    if (sc.isSome()) {
      const ci = env.classes[sc.unwrap()];
      const mo = findMethod(ci, tag.name);
      if (mo.isNone()) {
        return Err(diag("E0491", tag.span, "no static method `" + tag.name + "` on class `" + ci.name + "`"));
      }
      const mi = ci.methods[mo.unwrap()];
      if (!mi.isStatic) {
        return Err(
          diag(
            "E0491",
            tag.span,
            "`" + shown + "` is an instance method; a member tag on a class name calls a static method",
          ),
        );
      }
      if (mi.ownTps > 0) {
        return Err(diag("E0491", tag.span, "`" + shown + "` is a generic method; a member tag cannot call a generic method (ADR-0040)"));
      }
      // a static method is a plain function, also in a generic class (as in `staticCall`)
      const f = env.funcs[mi.fid];
      return this.oxCall(p, el, "static method `" + shown + "`", None, None, oxSigOfParams(f.decl.params, Some(f.params)));
    }
    const saved = this.fx;
    const b = this.ex(recv, None)?;
    this.fx = saved;
    const notMethod = diag(
      "E0491",
      tag.span,
      "`" + shown + "` is not a method; a member tag calls a method, whose parameters give the attribute names",
    );
    const noMethod = diag(
      "E0491",
      tag.span,
      "no method `" + tag.name + "` on `" + oxPathText(recv) + "` (type `" + showType(env, b.ty) + "`)",
    );
    let sig: Option<OxSig> = None;
    match (b.ty) {
      TyRecord(r) => {
        const co = classOfRec(env, r);
        let isMethod = false;
        if (co.isSome()) {
          const ci = env.classes[co.unwrap()];
          const mo = findMethod(ci, tag.name);
          if (mo.isSome()) {
            isMethod = true;
            const mi = ci.methods[mo.unwrap()];
            if (mi.ownTps > 0) {
              return Err(diag("E0491", tag.span, "`" + shown + "` is a generic method; a member tag cannot call a generic method (ADR-0040)"));
            }
            const ps = !mi.gen ? env.funcs[mi.fid].decl.params : env.gfuncs[mi.fid].decl.params;
            const own = mi.isStatic ? ps : ps.slice(1, ps.length);
            const tys: Option<Type[]> = !mi.gen && !mi.isStatic ? Some(tailTypes(env.funcs[mi.fid].params)) : None;
            sig = Some(oxSigOfParams(own, tys));
          }
        }
        if (!isMethod) {
          const bds = boundsOf(env, r);
          if (bds.length > 0) {
            // the first bound that declares the member (a conflict between bounds is reported at the declaration, E0477)
            let found: Option<IfaceSig> = None;
            for (const bi of bds) {
              const so = ifaceMethodIndex(env.ifaces[bi], tag.name);
              if (so.isSome() && found.isNone()) {
                found = Some(env.ifaces[bi].methods[so.unwrap()]);
              }
            }
            if (found.isNone()) {
              return Err(noMethod);
            }
            sig = Some(this.oxSigOfIface(found.unwrap()));
          } else if (recordHasFnField(env.records[r].fields, tag.name)) {
            return Err(notMethod);
          } else {
            return Err(noMethod);
          }
        }
      },
      TyIface(i) => {
        const info = env.ifaces[i];
        const so = ifaceMethodIndex(info, tag.name);
        if (so.isNone()) {
          return Err(noMethod);
        }
        sig = Some(this.oxSigOfIface(info.methods[so.unwrap()]));
      },
      _ => {
        return Err(noMethod);
      },
    }
    return this.oxCall(p, el, "method `" + shown + "`", None, None, sig.unwrap());
  }

  // The class a member tag's receiver names when it is a bare type name and no value of that name is in scope (the
  // rule of `callMember` for `T.m(..)`).
  private oxStaticClass(recv: Expr): Option<usize> {
    const bid = match (recv.kind) {
      EIdent(id) => id,
      _ => {
        return None;
      },
    };
    if (this.fx.isVisibleVar(bid.name) || globalVal(this.fx.env, this.fx.unit, bid.name).isSome()) {
      return None;
    }
    const te = findType(this.fx.env.units[this.fx.unit].scope, bid.name);
    if (te.isNone()) {
      return None;
    }
    return match (te.unwrap()) {
      EntRecord(r) => classOfRec(this.fx.env, r),
      EntGen(g) => classOfGeneric(this.fx.env, g),
      _ => None,
    };
  }

  private oxSigOfIface(m: IfaceSig): OxSig {
    return OxSig {
      names: m.paramNames,
      opt: m.params.map(t => isOptionTy(t)),
      tys: Some(m.params),
    };
  }

  // The call of function `fid` (or generic function `gi`) for element `el`: attributes, spreads and slots fill the
  // parameters by name; values are evaluated in source order (into temporaries when that differs from the parameter
  // order), each exactly once.
  private oxCall(
    p: OxProvider,
    el: OxElement,
    what: string,
    fid: Option<usize>,
    gi: Option<usize>,
    sig: OxSig,
  ): Result<HExpr, Diagnostic> {
    const tag = el.name.unwrap();
    const env = this.fx.env;
    const params = sig.names;
    const ptys = sig.tys;
    // The slots: the named ones, then the default slot (`children`) with the remaining children.
    let slotNames: Ident[] = [];
    let slotKids: OxChild[][] = [];
    let slotSpans: Span[] = [];
    let kids: OxChild[] = [];
    for (const k of el.children) {
      match (k) {
        JSlot(n, ks, sp) => {
          if (slotNames.some(x => x.name == n.name)) {
            return Err(diag("E0491", n.span, "the slot `" + n.name + "` is given twice"));
          }
          slotNames.push(n);
          slotKids.push(ks);
          slotSpans.push(sp);
        },
        _ => {
          kids.push(k);
        },
      }
    }
    if (kids.length > 0) {
      slotNames.push(Ident { name: "children", span: el.span });
      slotKids.push(kids);
      slotSpans.push(el.span);
    }
    for (const n of slotNames) {
      if (oxIndexOf(params, n.name) < 0) {
        if (n.name == "children") {
          return Err(diag("E0491", tag.span, "the " + what + " takes no children (it has no parameter `children`)"));
        }
        return Err(diag("E0491", n.span, "the " + what + " has no parameter `" + n.name + "` for this slot"));
      }
    }
    // Source-order sequence: attributes in order, then the slots. Ordered mode when a spread is present or the
    // parameter order of the sequence is not increasing.
    let ordered = false;
    let last = -1;
    for (const a of el.attrs) {
      match (a.value) {
        JVSpread(_) => {
          ordered = true;
        },
        _ => {
          const pi = oxIndexOf(params, a.name.name);
          if (pi < 0) {
            return Err(diag("E0491", a.name.span, "the " + what + " has no parameter `" + a.name.name + "`"));
          }
          if (pi <= last) {
            ordered = true;
          }
          last = pi;
        },
      }
    }
    let si: usize = 0;
    while (si < slotNames.length) {
      const pi = oxIndexOf(params, slotNames[si].name);
      if (pi <= last) {
        ordered = true;
      }
      last = pi;
      si += 1;
    }
    // The argument of each parameter (None: not given).
    let args: Option<Expr>[] = [];
    for (const _ of params) {
      args.push(None);
    }
    let lets: HStmt[] = [];
    for (const a of el.attrs) {
      match (a.value) {
        JVSpread(x) => {
          const v = this.ex(x, None)?;
          const rid = match (v.ty) {
            TyRecord(r) => r,
            _ => env.records.length,
          };
          if (rid >= env.records.length) {
            return Err(
              diag("E0491", x.span, "a spread `{...}` needs a record value, found `" + showType(env, v.ty) + "`"),
            );
          }
          const tmp = this.oxTemp(v, a.span, lets)?;
          lets = tmp.lets;
          for (const f of this.fx.env.records[rid].fields) {
            const pi = oxIndexOf(params, f.name);
            if (pi < 0) {
              return Err(
                diag("E0491", x.span, "the " + what + " has no parameter `" + f.name + "` (a field of the spread record)"),
              );
            }
            args[pi.toUsize()] = Some(
              Expr { kind: EMember(tmp.ref, Ident { name: f.name, span: x.span }), span: x.span },
            );
          }
        },
        _ => {
          const pi = oxIndexOf(params, a.name.name).toUsize();
          let x = match (a.value) {
            JVStr(v) => Expr { kind: EStr(v), span: a.span },
            JVExpr(e) => e,
            JVTrue => Expr { kind: EBool(true), span: a.span },
            JVSpread(e) => e,
          };
          if (ordered && !oxTrivial(x)) {
            const v = this.ex(x, this.oxParamTy(ptys, pi))?;
            const tmp = this.oxTemp(v, x.span, lets)?;
            lets = tmp.lets;
            x = tmp.ref;
          }
          args[pi] = Some(x);
        },
      }
    }
    si = 0;
    while (si < slotNames.length) {
      const n = slotNames[si];
      const pi = oxIndexOf(params, n.name).toUsize();
      if (args[pi].isSome() && n.name != "children") {
        return Err(diag("E0491", n.span, "`" + n.name + "` is given both as an attribute and as a slot"));
      }
      if (args[pi].isSome()) {
        return Err(diag("E0491", tag.span, "pass the children of the " + what + " between its tags, not as an attribute"));
      }
      const frag = oxFragmentOf(slotKids[si], slotSpans[si]);
      if (ordered) {
        const v = this.oxFragment(p, slotKids[si], this.oxParamTy(ptys, pi), slotSpans[si])?;
        const tmp = this.oxTemp(v, slotSpans[si], lets)?;
        lets = tmp.lets;
        args[pi] = Some(tmp.ref);
      } else {
        args[pi] = Some(frag);
      }
      si += 1;
    }
    // Parameters left out: `children` is the empty fragment, an `Option` is `None`, anything else is missing.
    let all: Expr[] = [];
    let i: usize = 0;
    while (i < params.length) {
      if (args[i].isNone()) {
        const pn = params[i];
        if (pn != "children" && !sig.opt[i]) {
          return Err(diag("E0491", tag.span, "the " + what + " needs the attribute `" + pn + "`"));
        }
        args[i] = Some(oxFragmentOf([], el.span));
      }
      all.push(args[i].unwrap());
      i += 1;
    }
    let call = mk(XInt(0), TyInt, el.span);
    if (el.recv.isSome()) {
      // a method: the checker's own method call, so visibility, static and mutating methods behave as in `a.b.C(..)`
      const callee = Expr { kind: EMember(el.recv.unwrap(), tag), span: spanTo(el.recv.unwrap().span, tag.span) };
      call = this.ex(Expr { kind: ECall(callee, all), span: el.span }, None)?;
    } else if (fid.isSome()) {
      const f = this.fx.env.funcs[fid.unwrap()];
      const tg = testGuard(f, el.span);
      if (tg.isSome()) {
        return Err(tg.unwrap());
      }
      const a = this.argsExpect(el.span, what, all, f.params)?;
      call = mk(XCall(fid.unwrap(), a), f.ret, el.span);
    } else {
      call = this.callGeneric(el.span, gi.unwrap(), tag, None, all, None)?;
    }
    if (lets.length == 0) {
      return Ok(call);
    }
    // Evaluate the temporaries, then the call: `match (true) { _ => { lets; call } }`.
    const arm = HArm { pattern: HPWildcard, body: HBlock { stmts: lets }, value: Some(call) };
    return Ok(mk(XMatch(mk(XBool(true), TyBool, el.span), [arm]), call.ty, el.span));
  }

  private oxParamTy(ptys: Option<Type[]>, pi: usize): Option<Type> {
    return match (ptys) {
      Some(ts) => Some(ts[pi]),
      None => None,
    };
  }

  // A temporary holding `v`, visible to the argument expressions under a name no program can write.
  private oxTemp(v: HExpr, span: Span, lets0: HStmt[]): Result<OxTemp, Diagnostic> {
    const id = this.fx.newTemp("$ox", v.ty);
    let lets = lets0;
    lets.push(HLet(id, v));
    const name = Ident { name: this.fx.locals[id].name, span: span };
    this.fx.declare(name, id)?;
    return Ok(OxTemp { ref: Expr { kind: EIdent(name), span: span }, lets: lets });
  }

  @Ensures(result.isOk() ==> isFn(result.unwrap().ty))
  private arrowExp(
    span: Span,
    ps: ArrowParam[],
    rte: Option<TypeExpr>,
    body: ArrowBody,
    exp: Option<Type>,
  ): Result<HExpr, Diagnostic> {
    const noP: Option<Type[]> = None;
    const noR: Option<Type> = None;
    match (exp) {
      Some(t) => {
        match (t) {
          TyFn(eps, er) => {
            return this.arrow(span, ps, rte, body, Some(eps), Some(er));
          },
          _ => {},
        }
      },
      None => {},
    }
    return this.arrow(span, ps, rte, body, noP, noR);
  }

  // ---------------------------------------------------------------------------
  // Names
  // ---------------------------------------------------------------------------

  private ident(id: Ident, exp: Option<Type>, span: Span): Result<HExpr, Diagnostic> {
    const lv = this.fx.lookupVar(id.name);
    if (lv.isSome()) {
      const l = lv.unwrap();
      return Ok(mk(XLocal(l), this.fx.locals[l].ty, span));
    }
    const g = globalVal(this.fx.env, this.fx.unit, id.name);
    if (g.isSome()) {
      return this.identVal(g.unwrap(), id, span, exp);
    }
    if (id.name == "None") {
      return this.noneLit(exp, span);
    }
    if (id.name == "Some" || id.name == "Ok" || id.name == "Err") {
      return Err(diag("E0404", span, "`" + id.name + "` must be called with arguments"));
    }
    return Err(this.unresolved(id));
  }

  @Ensures(result.isOk() ==> isFn(result.unwrap().ty))
  private funcValueOf(
    ent: ValEnt,
    id: Ident,
    span: Span,
    exp: Option<Type>,
  ): Result<HExpr, Diagnostic> {
    const noP: Option<Type[]> = None;
    const noR: Option<Type> = None;
    match (expFn(exp)) {
      Some(t) => {
        match (t) {
          TyFn(eps, er) => {
            return this.funcValue(span, ent, id, Some(eps), Some(er));
          },
          _ => {},
        }
      },
      None => {},
    }
    return this.funcValue(span, ent, id, noP, noR);
  }

  private identVal(
    ent: ValEnt,
    id: Ident,
    span: Span,
    exp: Option<Type>,
  ): Result<HExpr, Diagnostic> {
    match (ent) {
      VConst(i) => {
        const c = this.fx.env.consts[i];
        const kind: HExprKind = match (c.lit) {
          LitInt(n) => XInt(n),
          LitStr(s) => XStr(s),
          LitBool(b) => XBool(b),
          LitFloat(t) => XFloat(t),
        };
        return Ok(mk(kind, c.ty, span));
      },
      VVariant(u, tag) => {
        const def = this.fx.env.unions[u].variants[tag];
        if (def.payload.length > 0) {
          return Err(
            diag(
              "E0404",
              span,
              "variant `" + def.name + "` expects " + def.payload.length.toString()
                  + " argument(s)",
            ),
          );
        }
        return Ok(mk(XVariant(tag, noExprs()), TyUnion(u), span));
      },
      VGVariant(g, tag) => {
        return this.genericVariant(span, g, tag, None, [], exp);
      },
      VGFunc(_) => {
        return this.funcValueOf(ent, id, span, exp);
      },
      VFunc(_) => {
        return this.funcValueOf(ent, id, span, exp);
      },
      VStd(_) => {
        return Err(diag("E0400", span, "function `" + id.name + "` cannot be used as a value"));
      },
      VNamespace(_) => {
        return Err(nsValueErr(id));
      },
    }
  }

  @Ensures(result.isOk() ==> isOptionTy(result.unwrap().ty))
  private noneLit(exp: Option<Type>, span: Span): Result<HExpr, Diagnostic> {
    match (exp) {
      Some(t) => {
        match (t) {
          TyOption(inner) => {
            return Ok(mk(XVariant(1, noExprs()), TyOption(inner), span));
          },
          _ => {
            return Err(
              diag("E0400", span, "expected `" + showType(this.fx.env, t) + "`, found an `Option`"),
            );
          },
        }
      },
      None => {
        return Err(diag("E0407", span, "cannot infer the type of `None`; add a type annotation"));
      },
    }
  }

  private thisExpr(span: Span): Result<HExpr, Diagnostic> {
    const lv = this.fx.lookupVar("this");
    if (lv.isNone()) {
      return Err(thisErr(this.fx.fmode, span));
    }
    const l = lv.unwrap();
    return Ok(mk(XLocal(l), this.fx.locals[l].ty, span));
  }

  // ---------------------------------------------------------------------------
  // Operators
  // ---------------------------------------------------------------------------

  private unary(
    span: Span,
    op: UnaryOp,
    inner: Expr,
    exp: Option<Type>,
  ): Result<HExpr, Diagnostic> {
    match (op) {
      UNeg => {
        return this.neg(span, inner, exp);
      },
      UNot => {
        const o = this.ex(inner, None)?;
        if (!isBool(o.ty)) {
          return Err(
            diag("E0410", span, "`!` requires `bool`, found `" + showType(this.fx.env, o.ty) + "`"),
          );
        }
        return Ok(mk(XUnary(UnNot, o), TyBool, span));
      },
    }
  }

  @Ensures(result.isOk() ==> isSignedInt(result.unwrap().ty) || isFloatTy(result.unwrap().ty))
  private neg(span: Span, inner: Expr, exp: Option<Type>): Result<HExpr, Diagnostic> {
    const lit = intLitValue(inner);
    if (lit.isSome()) {
      return negIntLiteral(this.fx.env, lit.unwrap(), exp, span);
    }
    match (inner.kind) {
      EBigInt(n) => {
        return negBigLiteral(this.fx.env, n, exp, span);
      },
      _ => {},
    }
    match (inner.kind) {
      EFloat(t) => {
        return Ok(mk(XFloat("-" + t), expIsF32(exp) ? TyF32 : TyFloat, span));
      },
      _ => {},
    }
    const o = this.ex(inner, untypedInt(inner) && isFloatHint(exp) ? exp : None)?;
    const ne = negOperandErr(this.fx.env, o.ty, span);
    if (ne.isSome()) {
      return Err(ne.unwrap());
    }
    return Ok(mk(XUnary(UnNeg, o), o.ty, span));
  }

  // The operands of a binary operator; an untyped literal side takes the type of the other.
  private operands(lhs: Expr, rhs: Expr, hint: Option<Type>, cmp: bool): Result<Pair, Diagnostic> {
    if (untypedInt(lhs) && !untypedInt(rhs)) {
      const r = this.ex(rhs, hint)?;
      const l = this.ex(lhs, hintOf(r.ty))?;
      return Ok(Pair { l: l, r: r });
    }
    const l = this.ex(lhs, hint)?;
    let h: Option<Type> = untypedInt(rhs) ? hintOf(l.ty) : None;
    if (cmp && h.isNone() && isCompositeTy(l.ty)) {
      h = Some(l.ty);   // `xs == []`, `o == None`, `l == Cons(1, Nil)` (ADR-0034): the right side takes the type of the left
    }
    const r = this.ex(rhs, h)?;
    return Ok(Pair { l: l, r: r });
  }

  @Ensures(result.isOk() && !isArithOp(op) ==> isBool(result.unwrap().ty))
  private binary(
    span: Span,
    op: BinaryOp,
    lhs: Expr,
    rhs: Expr,
    exp: Option<Type>,
  ): Result<HExpr, Diagnostic> {
    const hop = toBinOp(op);
    const isImpl = match (op) {
      BImplies => true,
      _ => false,
    };
    if (isImpl) {
      // `a ==> b` (ADR-0012) is `!a || b` (short-circuit); only valid inside contract expressions.
      if (!inContract(this.fx.cmode)) {
        return Err(
          diag(
            "E0415",
            span,
            "`==>` is only allowed inside contract expressions (@Requires, @Ensures, @Invariant, @Decreases)",
          ),
        );
      }
      const l = this.ex(lhs, None)?;
      const r = this.ex(rhs, None)?;
      const ie = impliesOperandErr(this.fx.env, l.ty, r.ty, span);
      if (ie.isSome()) {
        return Err(ie.unwrap());
      }
      return Ok(mk(XBinary(OpOr, mk(XUnary(UnNot, l), TyBool, lhs.span), r), TyBool, span));
    }
    const isLogic = match (op) {
      BAnd => true,
      BOr => true,
      _ => false,
    };
    if (isLogic) {
      const l = this.ex(lhs, None)?;
      const npre = this.fx.pre.length;
      const r = this.ex(rhs, None)?;
      if (this.fx.pre.length > npre) {
        return Err(condHoistErr(rhs.span));
      }
      const le = logicOperandErr(this.fx.env, l.ty, r.ty, span);
      if (le.isSome()) {
        return Err(le.unwrap());
      }
      return Ok(mk(XBinary(hop, l, r), TyBool, span));
    }
    const hint: Option<Type> = isArithOp(op) ? intishHint(exp) : None;
    const p = this.operands(lhs, rhs, hint, opCmpKind(op) > 0)?;
    const cmpo = cmpOperator(this.fx, op, p.l, p.r, span)?;
    if (cmpo.isSome()) {
      this.fx.adopt(cmpo.unwrap().env);
      return Ok(cmpo.unwrap().e);
    }
    const rt = binaryType(this.fx.env, op, p.l.ty, p.r.ty, span)?;
    return Ok(mk(XBinary(hop, p.l, p.r), rt, span));
  }

  // `t` is a Map instance and the code being checked is not the Map prelude itself (which owns the fields).
  private outsideMapPrelude(t: Type): bool {
    return !isUnit(this.fx.env.mapUnit, this.fx.unit) && mapOrigin(this.fx.env, t).isSome();
  }

  private member(span: Span, base: Expr, name: Ident): Result<HExpr, Diagnostic> {
    const b = this.ex(base, None)?;
    const t = b.ty;
    if (name.name == "length") {
      if (isString(t)) {
        return Ok(mk(XBuiltin(BStrLength, [b]), TyUsize, span));
      }
      if (isArrayTy(t)) {
        return Ok(mk(XBuiltin(BArrLength, [b]), TyUsize, span));
      }
    }
    match (t) {
      TyRecord(r) => {
        const def = this.fx.env.records[r];
        const io = fieldIndex(def.fields, name.name);
        if (io.isNone() || name.name != "size" && this.outsideMapPrelude(t)) {
          return Err(
            diag(
              "E0405",
              name.span,
              "no field `" + name.name + "` on type `" + showType(this.fx.env, t) + "`",
            ),
          );
        }
        const i = io.unwrap();
        this.fieldAccess(r, name)?;
        return Ok(mk(XField(b, r, i), def.fields[i].ty, span));
      },
      _ => {
        return Err(noField(this.fx.env, name, t));
      },
    }
  }

  private index(span: Span, base: Expr, index: Expr): Result<HExpr, Diagnostic> {
    const b = this.ex(base, None)?;
    match (b.ty) {
      TyArray(t) => {
        const i = this.ep(index, TyUsize)?;
        return Ok(mk(XIndex(b, i), t, span));
      },
      _ => {
        return Err(
          diag("E0400", span, "cannot index into type `" + showType(this.fx.env, b.ty) + "`"),
        );
      },
    }
  }

  @Ensures(result.isOk() ==> isResultTy(this.fx.ret))
  private tryExpr(span: Span, inner: Expr): Result<HExpr, Diagnostic> {
    const o = this.ex(inner, None)?;
    match (o.ty) {
      TyResult(t, et) => {
        match (this.fx.ret) {
          TyResult(_, e2) => {
            if (!typeEq(e2, et)) {
              return Err(
                diag(
                  "E0406",
                  span,
                  "error type `" + showType(this.fx.env, et)
                      + "` does not match the function's error type `" + showType(this.fx.env, e2)
                      + "`",
                ),
              );
            }
          },
          _ => {
            return Err(
              diag(
                "E0406",
                span,
                "`?` used in a function returning `" + showType(this.fx.env, this.fx.ret)
                    + "`, not a `Result`",
              ),
            );
          },
        }
        if (isMutRetMode(this.fx.fmode)) {
          return this.tryInMutating(o, span, t, et);
        }
        return Ok(mk(XTry(o), t, span));
      },
      _ => {
        return Err(
          diag(
            "E0406",
            span,
            "`?` requires a `Result`, found `" + showType(this.fx.env, o.ty) + "`",
          ),
        );
      },
    }
  }

  // `x?` in a mutating method with a result (ADR-0009: the lowered function returns a `$ret` record
  // { self, value }): an early `Err` return must carry the receiver too, so the check is hoisted like a
  // mutating call, in front of the statement that contains the expression:
  //   const $t = x; if ($t.isErr()) { return $ret { self: this, value: Err($t.unwrapErr()) }; }  ... $t.unwrap()
  @Ensures(result.isOk() ==> this.fx.pre.length == old(this.fx.pre.length) + 2)
  private tryInMutating(o: HExpr, span: Span, t: Type, et: Type): Result<HExpr, Diagnostic> {
    const id = this.fx.newTemp("$t", o.ty);
    this.fx.hoist(HLet(id, o));
    const tmp = mk(XLocal(id), o.ty, span);
    const rid = match (this.fx.lret) {
      TyRecord(x) => x,
      _ => 0,
    };
    const errV = mk(XVariant(1, [mk(XBuiltin(BResUnwrapErr, [tmp]), et, span)]), this.fx.ret, span);
    const wrapped = mk(
      XRecord(
        rid,
        None,
        [FieldInitH { index: 0, value: this.thisRead(span) }, FieldInitH { index: 1, value: errV }],
      ),
      this.fx.lret,
      span,
    );
    const isErr = mk(XBuiltin(BResIsErr, [tmp]), TyBool, span);
    this.fx.hoist(HIf(isErr, HBlock { stmts: [HReturn(Some(wrapped))] }, None));
    if (isVoid(t)) {
      return Ok(nopExpr(span));
    }
    return Ok(mk(XBuiltin(BResUnwrap, [tmp]), t, span));
  }

  @Ensures(result.isOk() ==> this.fx.pre.length == old(this.fx.pre.length))
  private cond(
    span: Span,
    cond: Expr,
    thenE: Expr,
    elsE: Expr,
    exp: Option<Type>,
  ): Result<HExpr, Diagnostic> {
    const c = this.ep(cond, TyBool)?;
    const npre = this.fx.pre.length;
    // An interface-typed context converts each branch (ADR-0019).
    match (exp) {
      Some(et) => {
        if (isIface(et)) {
          const tr = this.ep(thenE, et)?;
          const fr = this.ep(elsE, et)?;
          if (this.fx.pre.length > npre) {
            return Err(condHoistErr(span));
          }
          return Ok(mk(XCond(c, tr, fr), et, span));
        }
      },
      None => {},
    }
    let t: HExpr = mk(XBool(false), TyBool, span);
    let f: HExpr = mk(XBool(false), TyBool, span);
    if (untypedInt(thenE) && !untypedInt(elsE)) {
      const fr = this.ex(elsE, exp)?;
      const tr = this.ex(thenE, hintOf(fr.ty))?;
      t = tr;
      f = fr;
    } else {
      const tr = this.ex(thenE, exp)?;
      const h = untypedInt(elsE) && isIntish(tr.ty) ? Some(tr.ty) : exp;
      const fr = this.ex(elsE, h)?;
      t = tr;
      f = fr;
    }
    if (this.fx.pre.length > npre) {
      return Err(condHoistErr(span));
    }
    if (!typeEq(t.ty, f.ty)) {
      return Err(
        diag(
          "E0400",
          elsE.span,
          "branches of conditional have different types `" + showType(this.fx.env, t.ty) + "` and `"
              + showType(this.fx.env, f.ty) + "`",
        ),
      );
    }
    return Ok(mk(XCond(c, t, f), t.ty, span));
  }

  @Ensures(result.isOk() ==> isArrayTy(result.unwrap().ty))
  private array(span: Span, elems: Expr[], exp: Option<Type>): Result<HExpr, Diagnostic> {
    let pre: Option<HExpr>[] = noPre(elems.length);
    let elemTy: Type = TyInt;
    let fromExp = false;
    match (exp) {
      Some(t) => {
        match (t) {
          TyArray(et) => {
            elemTy = et;
            fromExp = true;
          },
          _ => {},
        }
      },
      None => {},
    }
    if (!fromExp) {
      if (elems.length == 0) {
        return Err(
          diag("E0407", span, "cannot infer the element type of `[]`; add a type annotation"),
        );
      }
      let k: usize = 0;
      let found = false;
      while (k < elems.length && !found) {
        if (!untypedInt(elems[k])) {
          found = true;
        } else {
          k += 1;
        }
      }
      if (found) {
        const he = this.ex(elems[k], None)?;
        elemTy = he.ty;
        pre[k] = Some(he);
      } else {
        // only untyped literals: the first one decides (`int`, or `float` for a float literal)
        const he = this.ex(elems[0], None)?;
        elemTy = he.ty;
        pre[0] = Some(he);
      }
    }
    if (isVoid(elemTy) && !this.fx.inst && elems.length > 0) {
      return Err(diag("E0400", span, "array elements cannot be `void`"));
    }
    let out: HExpr[] = [];
    let i: usize = 0;
    for (const e of elems) {
      match (pre[i]) {
        Some(he) => {
          out.push(he);
        },
        None => {
          const r = this.ep(e, elemTy)?;
          out.push(r);
        },
      }
      i += 1;
    }
    return Ok(mk(XArray(out), TyArray(elemTy), span));
  }

  // ---------------------------------------------------------------------------
  // Records
  // ---------------------------------------------------------------------------

  @Ensures(result.isOk() ==> isRecordTy(result.unwrap().ty))
  private record(
    span: Span,
    name: Ident,
    targs: Option<TypeExpr[]>,
    spread: Option<Expr>,
    fields: FieldInit[],
    exp: Option<Type>,
  ): Result<HExpr, Diagnostic> {
    if (indexOfName(this.fx.tpNames, name.name).isSome()) {
      return Err(
        diag("E0400", name.span, "`" + name.name + "` is a type parameter, not a record type"),
      );
    }
    const found = findType(this.fx.env.units[this.fx.unit].scope, name.name);
    if (found.isNone()) {
      return Err(diag("E0300", name.span, "unknown type `" + name.name + "`"));
    }
    let t: Type = TyVoid;
    match (found.unwrap()) {
      EntGen(g) => {
        const gco = classOfGeneric(this.fx.env, g);
        if (gco.isSome() && !this.fx.inClass(gco.unwrap())) {
          return Err(
            diag(
              "E0408",
              name.span,
              "class `" + name.name
                  + "` cannot be built with a record literal outside its own body; use `new "
                  + name.name + "(..)`",
            ),
          );
        }
        return this.genericRecord(span, g, name, targs, spread, fields, exp);
      },
      EntRecord(r) => {
        t = TyRecord(r);
      },
      EntUnion(u) => {
        t = TyUnion(u);
      },
      EntAlias(i) => {
        const none: int[] = [];
        const r = aliasType(this.fx.env, i, none)?;
        this.fx.adopt(r.env);
        t = r.ty;
      },
      EntIface(_) => {
        return Err(
          diag("E0400", name.span, "`" + name.name + "` is an interface, not a record type"),
        );
      },
      EntBuiltin(_) => {
        return Err(
          diag(
            "E0400",
            name.span,
            "`" + name.name + "` is a built-in resource type, not a record type",
          ),
        );
      },
    }
    if (targs.isSome()) {
      return Err(diag("E0400", name.span, "type `" + name.name + "` is not generic"));
    }
    const rid = match (t) {
      TyRecord(r) => r,
      _ => {
        return Err(
          diag(
            "E0400",
            name.span,
            "`" + name.name + "` is not a record type (it is `" + showType(this.fx.env, t) + "`)",
          ),
        );
      },
    };
    const co = classOfRec(this.fx.env, rid);
    if (co.isSome() && !this.fx.inClass(co.unwrap())) {
      return Err(
        diag(
          "E0408",
          name.span,
          "class `" + name.name
              + "` cannot be built with a record literal outside its own body; use `new "
              + name.name + "(..)`",
        ),
      );
    }
    const sealed = sealedErr(this.fx.env, rid, this.fx.unit, name.span);
    if (sealed.isSome()) {
      return Err(sealed.unwrap());
    }
    return this.recordOf(span, rid, spread, fields);
  }

  // Record literal of a generic record type: the instance comes from the spread, the explicit type
  // arguments, the expected type or the field values (in that order of authority).
  @Ensures(result.isOk() ==> isRecordTy(result.unwrap().ty))
  private genericRecord(
    span: Span,
    g: usize,
    name: Ident,
    targs: Option<TypeExpr[]>,
    spread: Option<Expr>,
    fields: FieldInit[],
    exp: Option<Type>,
  ): Result<HExpr, Diagnostic> {
    const gt = this.fx.env.gtypes[g];
    const fdecls = match (gt.decl.body) {
      DRecord(fs) => fs,
      _ => {
        return Err(diag("E0400", name.span, "`" + name.name + "` is not a record type"));
      },
    };
    match (spread) {
      Some(se) => {
        const s = this.ex(se, None)?;
        const o = originOf(this.fx.env, s.ty);
        let ok = false;
        let rid: usize = 0;
        match (o) {
          Some(inst) => {
            if (isRecordKind(inst.kind) && inst.gid == g) {
              ok = true;
              rid = inst.id;
            }
          },
          None => {},
        }
        if (!ok) {
          return Err(
            diag(
              "E0400",
              se.span,
              "spread of `" + name.name + "` literal must be an instance of `" + name.name
                  + "`, found `" + showType(this.fx.env, s.ty) + "`",
            ),
          );
        }
        return this.recordOf(span, rid, spread, fields);
      },
      None => {},
    }
    let idxs: usize[] = [];
    let seen: bool[] = [];
    let names: string[] = [];
    for (const fd of fdecls) {
      seen.push(false);
      names.push(fd.name.name);
    }
    let ptes: TypeExpr[] = [];
    let vals: Expr[] = [];
    for (const f of fields) {
      const io = fieldDeclIndex(fdecls, f.name.name);
      if (io.isNone()) {
        return Err(
          diag(
            "E0411",
            f.name.span,
            "record `" + name.name + "` has no field `" + f.name.name + "`",
          ),
        );
      }
      const idx = io.unwrap();
      if (seen[idx]) {
        return Err(diag("E0411", f.name.span, "field `" + f.name.name + "` given more than once"));
      }
      seen[idx] = true;
      idxs.push(idx);
      ptes.push(fdecls[idx].ty);
      vals.push(f.value);
    }
    const missing = missingNames(names, seen);
    if (missing.length > 0) {
      return Err(diag("E0411", span, "missing field(s) in record literal: " + missing.join(", ")));
    }
    const io = this.infer(
      span,
      "record `" + name.name + "`",
      gt.unit,
      gt.decl.typeParams,
      ptes,
      Some(selfTypeExpr(gt.decl)),
      vals,
      exp,
      targs,
    )?;
    const inst = instType(this.fx.env, g, io.tys, 0, span)?;
    this.fx.adopt(inst.env);
    const rid = match (inst.ty) {
      TyRecord(r) => r,
      _ => 0,
    };
    let out: FieldInitH[] = [];
    let i: usize = 0;
    while (i < idxs.length) {
      out.push(FieldInitH { index: idxs[i], value: io.args[i] });
      i += 1;
    }
    return Ok(mk(XRecord(rid, None, out), TyRecord(rid), span));
  }

  @Requires(rid < this.fx.env.records.length)
  @Ensures(result.isOk() ==> typeEq(result.unwrap().ty, TyRecord(rid)))
  private recordOf(
    span: Span,
    rid: usize,
    spread: Option<Expr>,
    fields: FieldInit[],
  ): Result<HExpr, Diagnostic> {
    const def = this.fx.env.records[rid];
    let sp: Option<HExpr> = None;
    match (spread) {
      Some(s) => {
        const r = this.ep(s, TyRecord(rid))?;
        sp = Some(r);
      },
      None => {},
    }
    let seen: bool[] = [];
    let names: string[] = [];
    for (const fd of def.fields) {
      seen.push(false);
      names.push(fd.name);
    }
    let out: FieldInitH[] = [];
    for (const f of fields) {
      const io = fieldIndex(def.fields, f.name.name);
      if (io.isNone()) {
        return Err(
          diag(
            "E0411",
            f.name.span,
            "record `" + def.name + "` has no field `" + f.name.name + "`",
          ),
        );
      }
      const idx = io.unwrap();
      if (seen[idx]) {
        return Err(diag("E0411", f.name.span, "field `" + f.name.name + "` given more than once"));
      }
      seen[idx] = true;
      const v = this.ep(f.value, def.fields[idx].ty)?;
      out.push(FieldInitH { index: idx, value: v });
    }
    if (sp.isNone()) {
      const missing = missingNames(names, seen);
      if (missing.length > 0) {
        return Err(
          diag("E0411", span, "missing field(s) in record literal: " + missing.join(", ")),
        );
      }
    }
    return Ok(mk(XRecord(rid, sp, out), TyRecord(rid), span));
  }

  // ---------------------------------------------------------------------------
  // Calls
  // ---------------------------------------------------------------------------

  // The arguments checked against the parameter types, in source order.
  @Ensures(result.isOk() ==> result.unwrap().length == params.length)
  @Ensures(args.length != params.length ==> result.isErr())
  private argsExpect(
    span: Span,
    what: string,
    args: Expr[],
    params: Type[],
  ): Result<HExpr[], Diagnostic> {
    // A function whose first parameter is a grant (a std network / file scope function, or a builtin): a call without that
    // grant is E0470, with a grant of another family E0471 (ADR-0027, ADR-0033), not a plain arity / type error.
    if (params.length > 0) {
      match (params[0]) {
        TyGrant(k) => {
          const gname = grantTypeName(k);
          if (args.length == 0 && params.length >= 1) {
            return Err(grantMissingErr(span, what, gname));
          }
          if (args.length + 1 == params.length || args.length == params.length) {
            const saved = this.fx;
            const g0 = this.ex(args[0], None)?;
            const isGrant = match (g0.ty) {
              TyGrant(_) => true,
              _ => false,
            };
            this.fx = saved;
            if (!isGrant && args.length + 1 == params.length) {
              return Err(grantMissingErr(span, what, gname));
            }
            if (args.length == params.length && !typeEq(g0.ty, params[0])) {
              return Err(grantMismatchErr(args[0].span, what, gname, showType(this.fx.env, g0.ty), isGrant));
            }
          }
        },
        _ => {},
      }
    }
    if (args.length != params.length) {
      return Err(
        diag(
          "E0404",
          span,
          what + " expects " + params.length.toString() + " argument(s), found "
              + args.length.toString(),
        ),
      );
    }
    let out: HExpr[] = [];
    let i: usize = 0;
    for (const a of args) {
      const r = this.ep(a, params[i])?;
      out.push(r);
      i += 1;
    }
    return Ok(out);
  }

  private call(
    span: Span,
    callee: Expr,
    args: Expr[],
    exp: Option<Type>,
  ): Result<HExpr, Diagnostic> {
    if (inContract(this.fx.cmode)) {
      match (callee.kind) {
        EIdent(id) => {
          if (id.name == "old") {
            return this.oldExpr(span, args);
          }
        },
        _ => {},
      }
    }
    match (callee.kind) {
      EIdent(id) => {
        return this.callIdent(span, callee, id, args, exp);
      },
      ETyApp(id, targs) => {
        return this.callTyApp(span, callee, id, targs, args, exp);
      },
      EMember(base, name) => {
        const noTargs: Option<TypeExpr[]> = None;
        return this.callMember(span, base, name, noTargs, args, exp);
      },
      EMethodT(base, name, targs) => {
        return this.callMember(span, base, name, Some(targs), args, exp);
      },
      _ => {
        return this.callValue(span, callee, args);
      },
    }
  }

  // `old(e)` in an `@Ensures` expression (ADR-0012): the value of `e` in the pre-state. Type checking
  // treats it as `e` itself (the runtime-check expansion evaluates it at entry).
  @Ensures(result.isOk() ==> isEnsuresMode(this.fx.cmode))
  private oldExpr(span: Span, args: Expr[]): Result<HExpr, Diagnostic> {
    if (!isEnsuresMode(this.fx.cmode)) {
      return Err(
        diag(
          "E0415",
          span,
          isOldMode(this.fx.cmode)
              ? "`old(..)` cannot be nested"
              : "`old(..)` is only allowed in an @Ensures expression",
        ),
      );
    }
    if (args.length != 1) {
      return Err(diag("E0404", span, "`old` expects 1 argument, found " + args.length.toString()));
    }
    this.fx.setCmode(CmOld);
    const r = this.ex(args[0], None)?;
    this.fx.setCmode(CmEnsures);
    return Ok(r);
  }

  // Call of a function value: `f(x)` with a local `f`, `fs[i](x)`, `g(1)(2)`, `(x => x)(3)`.
  private callValue(span: Span, callee: Expr, args: Expr[]): Result<HExpr, Diagnostic> {
    const c = this.ex(callee, None)?;
    match (c.ty) {
      TyFn(ps, r) => {
        const a = this.argsExpect(span, "function value", args, ps)?;
        return Ok(mk(XCallIndirect(c, a), r, span));
      },
      _ => {
        match (callee.kind) {
          EIdent(id) => {
            return Err(diag("E0400", callee.span, "`" + id.name + "` is not a function"));
          },
          _ => {
            return Err(diag("E0400", callee.span, "expression is not callable"));
          },
        }
      },
    }
  }

  private callIdent(
    span: Span,
    callee: Expr,
    id: Ident,
    args: Expr[],
    exp: Option<Type>,
  ): Result<HExpr, Diagnostic> {
    const lv = this.fx.lookupVar(id.name);
    if (lv.isSome()) {
      return this.callValue(span, callee, args);
    }
    const g = globalVal(this.fx.env, this.fx.unit, id.name);
    if (g.isNone()) {
      if (id.name == "parseInt") {
        return this.callBuiltin(span, "function `parseInt`", BParseInt, args);
      }
      if (id.name == "parseI128" || id.name == "parseU128") {
        return Err(
          diag(
            "E0431",
            id.span,
            "the 128-bit integer types are not supported yet (ADR-0022); use `parseI64` / `parseU64`",
          ),
        );
      }
      const pk = parseFnKind(id.name);
      if (pk >= 0) {
        const a = this.argsExpect(span, "function `" + id.name + "`", args, [TyString])?;
        return Ok(mk(parseExpr(a[0], pk, span).kind, TyOption(kindType(pk)), span));
      }
      if (id.name == "parseFloat") {
        return this.callBuiltin(span, "function `parseFloat`", BParseFloat, args);
      }
      if (id.name == "bytesToString") {
        return this.callBuiltin(span, "function `bytesToString`", BBytesToString, args);
      }
      if (id.name == "stringToBytes") {
        return this.callBuiltin(span, "function `stringToBytes`", BStringToBytes, args);
      }
      if (id.name == "Some" || id.name == "Ok" || id.name == "Err") {
        return this.builtinCtor(span, id.name, args, exp);
      }
      return Err(this.unresolved(id));
    }
    match (g.unwrap()) {
      VNamespace(_) => {
        return Err(nsValueErr(id));
      },
      VGFunc(gi) => {
        return this.callGeneric(span, gi, id, None, args, exp);
      },
      VGVariant(gi, tag) => {
        return this.genericVariant(span, gi, tag, None, args, exp);
      },
      VFunc(fid) => {
        const f = this.fx.env.funcs[fid];
        const tg = testGuard(f, span);
        if (tg.isSome()) {
          return Err(tg.unwrap());
        }
        const a = this.argsExpect(span, "function `" + id.name + "`", args, f.params)?;
        return Ok(mk(XCall(fid, a), f.ret, span));
      },
      VVariant(u, tag) => {
        const v = this.fx.env.unions[u].variants[tag];
        const a = this.argsExpect(span, "variant `" + v.name + "`", args, v.payload)?;
        return Ok(mk(XVariant(tag, a), TyUnion(u), span));
      },
      VStd(b) => {
        match (b) {
          BTask(k) => {
            if (k == 10) {
              return this.callTake(span, "function `" + id.name + "`", b, args, exp);
            }
          },
          _ => {},
        }
        return this.callBuiltin(span, "function `" + id.name + "`", b, args);
      },
      VConst(_) => {
        return Err(diag("E0400", callee.span, "`" + id.name + "` is not a function"));
      },
    }
  }

  // ---------------------------------------------------------------------------
  // Generic calls (beyond Orin-B, ADR-0007)
  // ---------------------------------------------------------------------------

  // Notes for E0405 on `string` and arrays: what exists, and `length` is a property.
  private noMethodNote(d0: Diagnostic, ty: Type, n: string): Diagnostic {
    let d = d0;
    if (n == "length" && (isString(ty) || isArrayTy(ty))) {
      d.notes.push("`length` is a property, write `xs.length`");
    } else if (isString(ty)) {
      d.notes.push("string has the methods charAt, charCodeAt, substring, indexOf, includes, startsWith, endsWith, split and trim, and the property length");
      d.notes.push("build text with template literals or `+`");
    }
    return d;
  }

  // E0300 for an unknown name, with a note when the usual first-day mistake is recognisable.
  private unresolved(id: Ident): Diagnostic {
    const n = id.name;
    let d = unresolvedName(this.fx.selfName, id);
    if (this.fx.selfName != "" && n == this.fx.selfName) {
      return d;
    }
    const m = this.fx.fmode;
    if (isClassMode(m) && !isStaticMode(m)) {
      const fs = this.fx.env.classes[this.fx.fcls].fields;
      for (const f of fs) {
        if (f.name == n) {
          d.notes.push("did you mean `this." + n + "`?");
          return d;
        }
      }
    }
    const found = findType(this.fx.env.units[this.fx.unit].scope, n);
    if (found.isSome()) {
      const co = match (found.unwrap()) {
        EntRecord(r) => classOfRec(this.fx.env, r),
        EntGen(g) => classOfGeneric(this.fx.env, g),
        _ => None,
      };
      if (co.isSome()) {
        d.notes.push("create instances with `new " + n + "(...)`");
        return d;
      }
    }
    if (n == "Math") {
      d.notes.push("`Math` is not available in Orin; see `std:math` (`import { sqrt } from \"std:math\";`)");
    } else if (n == "JSON") {
      d.notes.push("`JSON` is not available in Orin; see `std:json`");
    } else if (n == "fetch") {
      d.notes.push("`fetch` is not available in Orin; see `std:http`");
    } else if (n == "setTimeout" || n == "setInterval" || n == "Promise") {
      d.notes.push("`" + n + "` is not available in Orin; see `std:task`");
    } else if (n == "console" || n == "parseInt" || n == "parseFloat" || n == "require" || n == "process") {
      d.notes.push("`" + n + "` is not available in Orin (there are no JavaScript globals other than `console.log`)");
    }
    return d;
  }

  private callTyApp(
    span: Span,
    callee: Expr,
    id: Ident,
    targs: TypeExpr[],
    args: Expr[],
    exp: Option<Type>,
  ): Result<HExpr, Diagnostic> {
    if (this.fx.isVisibleVar(id.name)) {
      return Err(
        diag("E0400", callee.span, "`" + id.name + "` is not generic and takes no type arguments"),
      );
    }
    const g = globalVal(this.fx.env, this.fx.unit, id.name);
    if (g.isNone()) {
      return Err(diag("E0300", id.span, "unresolved name `" + id.name + "`"));
    }
    match (g.unwrap()) {
      VGFunc(gi) => {
        return this.callGeneric(span, gi, id, Some(targs), args, exp);
      },
      VGVariant(gi, tag) => {
        return this.genericVariant(span, gi, tag, Some(targs), args, exp);
      },
      _ => {
        return Err(
          diag(
            "E0400",
            callee.span,
            "`" + id.name + "` is not generic and takes no type arguments",
          ),
        );
      },
    }
  }

  // Resolves a parameter / result type expression of a generic callee with its type parameters
  // bound to `tys` (only mentioned parameters need to be real).
  @Requires(tp.length == tys.length)
  @Ensures(result.isOk() ==> typeInRange(this.fx.env, result.unwrap()))
  private resolveBound(
    unit: usize,
    tp: string[],
    tys: Type[],
    te: TypeExpr,
    voidOk: bool,
  ): Result<Type, Diagnostic> {
    const sc = new TScope(unit, tp, tys, 0);
    const r = resolveType(this.fx.env, sc, te, voidOk)?;
    this.fx.adopt(r.env);
    return Ok(r.ty);
  }

  // Infers the type arguments of a call to a generic callee (function, variant constructor or
  // record literal) and checks the arguments. Order of authority: explicit type arguments; else
  // the expected type; then the arguments left to right (arguments that cannot be typed alone,
  // such as `[]` or `None`, and bare integer literals are deferred until the others are known).
  // Returns the type arguments and the checked arguments in source order.
  @Ensures(result.isOk()
      ==> result.unwrap().args.length == args.length && result.unwrap().tys.length == tps.length)
  private infer(
    span: Span,
    what: string,
    unit: usize,
    tps: Ident[],
    paramTEs: TypeExpr[],
    retTE: Option<TypeExpr>,
    args: Expr[],
    exp: Option<Type>,
    explicit: Option<TypeExpr[]>,
  ): Result<InferOut, Diagnostic> {
    return this.inferPre(
      span,
      what,
      unit,
      tps,
      paramTEs,
      retTE,
      args,
      exp,
      explicit,
      noPre(args.length),
      [],
    );
  }

  // An argument that is typed on its own because its parameter type still mentions unbound type
  // parameters. An arrow function whose expected parameter types are all known (but not its result,
  // e.g. `xs.map(x => x + 1)`) is checked against them; its type then binds the result parameter.
  // When no such special case applies, the argument is checked on its own from the unchanged context.
  private loose(
    a: Expr,
    te: TypeExpr,
    unit: usize,
    tp: string[],
    inf: Inference,
  ): Result<HExpr, Diagnostic> {
    const saved = this.fx;
    match (te.kind) {
      TFn(pts, _) => {
        match (a.kind) {
          EArrow(ps, rte, body) => {
            if (ps.length == pts.length) {
              // Parameter types: from the expected type where its type parameters are known, else
              // from the arrow's own annotation (an unannotated parameter then needs the fallback).
              let tys: Type[] = [];
              let ok = true;
              let i: usize = 0;
              while (i < pts.length && ok) {
                if (!inf.unbound(pts[i].ty)) {
                  const ty = this.resolveBound(unit, tp, inf.current(), pts[i].ty, false)?;
                  tys.push(ty);
                } else {
                  match (ps[i].ty) {
                    Some(ate) => {
                      const ty = this.resolve(ate, false)?;
                      tys.push(ty);
                    },
                    None => {
                      ok = false;
                    },
                  }
                }
                i += 1;
              }
              if (ok) {
                const noR: Option<Type> = None;
                return this.arrow(a.span, ps, rte, body, Some(tys), noR);
              }
            }
          },
          EIdent(id) => {
            let known = true;
            for (const p of pts) {
              if (inf.unbound(p.ty)) {
                known = false;
              }
            }
            if (known && !this.fx.isVisibleVar(id.name)) {
              const g = globalVal(this.fx.env, this.fx.unit, id.name);
              if (g.isSome()) {
                let tys: Type[] = [];
                for (const p of pts) {
                  const ty = this.resolveBound(unit, tp, inf.current(), p.ty, false)?;
                  tys.push(ty);
                }
                const noR: Option<Type> = None;
                match (g.unwrap()) {
                  VFunc(_) => {
                    return this.funcValue(a.span, g.unwrap(), id, Some(tys), noR);
                  },
                  VGFunc(_) => {
                    return this.funcValue(a.span, g.unwrap(), id, Some(tys), noR);
                  },
                  _ => {},
                }
              }
            }
          },
          _ => {},
        }
      },
      _ => {},
    }
    this.fx = saved;
    return this.ex(a, None);
  }

  // `infer` where some arguments are already checked (`pre[i]`, e.g. the receiver of a method call).
  @Ensures(result.isOk()
      ==> result.unwrap().args.length == args.length && result.unwrap().tys.length == tps.length)
  private inferPre(
    span: Span,
    what: string,
    unit: usize,
    tps: Ident[],
    paramTEs: TypeExpr[],
    retTE: Option<TypeExpr>,
    args: Expr[],
    exp: Option<Type>,
    explicit: Option<TypeExpr[]>,
    pre: Option<HExpr>[],
    fixed: Type[],
  ): Result<InferOut, Diagnostic> {
    if (args.length != paramTEs.length) {
      return Err(
        diag(
          "E0404",
          span,
          what + " expects " + paramTEs.length.toString() + " argument(s), found "
              + args.length.toString(),
        ),
      );
    }
    const tp = paramNameList(tps);
    let inf = new Inference(tp, args.length);
    // The first type parameters are fixed by the receiver of a method call (the class's type arguments, ADR-0040).
    let k0: usize = 0;
    while (k0 < fixed.length && k0 < tp.length) {
      inf.explicit(k0, fixed[k0]);
      k0 += 1;
    }
    match (explicit) {
      Some(ts) => {
        if (ts.length + k0 != tp.length) {
          return Err(
            diag(
              "E0400",
              span,
              what + " expects " + (tp.length - k0).toString() + " type argument(s), found "
                  + ts.length.toString(),
            ),
          );
        }
        let k: usize = k0;
        for (const t of ts) {
          const ty = this.resolve(t, true)?;
          inf.explicit(k, ty);
          k += 1;
        }
      },
      None => {
        match (exp) {
          Some(et) => {
            match (retTE) {
              Some(rt) => {
                inf.learn(this.fx.env, unit, rt, et);
              },
              None => {},
            }
          },
          None => {},
        }
      },
    }
    let pi: usize = 0;
    while (pi < args.length) {
      match (pre[pi]) {
        Some(h) => {
          inf.fill(pi, h);
          inf.learn(this.fx.env, unit, paramTEs[pi], h.ty);
        },
        None => {},
      }
      pi += 1;
    }
    let deferred: usize[] = [];
    let i: usize = 0;
    while (i < args.length) {
      const te = paramTEs[i];
      if (inf.isFilled(i)) {
        // already checked
      } else if (!inf.unbound(te)) {
        const pt = this.resolveBound(unit, tp, inf.current(), te, false)?;
        const r = this.ep(args[i], pt)?;
        inf.fill(i, r);
      } else if (untypedInt(args[i])) {
        deferred.push(i);
      } else {
        const saved = this.fx;
        const lr = this.loose(args[i], te, unit, tp, inf);
        match (lr) {
          Ok(r) => {
            inf.fill(i, r);
            inf.learn(this.fx.env, unit, te, r.ty);
          },
          Err(d) => {
            if (d.code == "E0407") {
              this.fx = saved;
              deferred.push(i);
            } else {
              return Err(d);
            }
          },
        }
      }
      i += 1;
    }
    // Deferred arguments: resolvable ones are checked against their parameter; others are typed on
    // their own. Bare integer literals (default `int`) go last, one at a time.
    let pending = deferred;
    while (pending.length > 0) {
      let progress = false;
      let rest: usize[] = [];
      let firstErr: Option<Diagnostic> = None;
      for (const di of pending) {
        const te = paramTEs[di];
        if (!inf.unbound(te)) {
          const pt = this.resolveBound(unit, tp, inf.current(), te, false)?;
          const r = this.ep(args[di], pt)?;
          inf.fill(di, r);
          progress = true;
        } else if (untypedInt(args[di])) {
          rest.push(di);
        } else {
          const saved = this.fx;
          const lr = this.loose(args[di], te, unit, tp, inf);
          match (lr) {
            Ok(r) => {
              inf.fill(di, r);
              inf.learn(this.fx.env, unit, te, r.ty);
              progress = true;
            },
            Err(d) => {
              if (d.code != "E0407") {
                return Err(d);
              }
              this.fx = saved;
              if (firstErr.isNone()) {
                firstErr = Some(d);
              }
              rest.push(di);
            },
          }
        }
      }
      if (!progress) {
        let lit: Option<usize> = None;
        for (const di of rest) {
          if (lit.isNone() && untypedInt(args[di])) {
            lit = Some(di);
          }
        }
        if (lit.isNone()) {
          return Err(firstErr.unwrap());
        }
        const li = lit.unwrap();
        const r = this.ex(args[li], None)?;
        inf.fill(li, r);
        inf.learn(this.fx.env, unit, paramTEs[li], r.ty);
        let rest2: usize[] = [];
        for (const di of rest) {
          if (di != li) {
            rest2.push(di);
          }
        }
        rest = rest2;
      }
      pending = rest;
    }
    const tys = inf.typeArgs(span, what)?;
    const filled = inf.args();
    let hargs: HExpr[] = [];
    let j: usize = 0;
    for (const he of filled) {
      const pt = this.resolveBound(unit, tp, tys, paramTEs[j], false)?;
      if (!typeEq(he.ty, pt)) {
        return Err(mismatch(this.fx.env, args[j].span, pt, he.ty));
      }
      hargs.push(he);
      j += 1;
    }
    return Ok(InferOut { tys: tys, args: hargs });
  }

  private callGeneric(
    span: Span,
    g: usize,
    id: Ident,
    explicit: Option<TypeExpr[]>,
    args: Expr[],
    exp: Option<Type>,
  ): Result<HExpr, Diagnostic> {
    return this.callGenericW(span, g, "function `" + id.name + "`", explicit, args, exp);
  }

  // `what` names the callee in diagnostics ("function `f`", "constructor of `Box`").
  private callGenericW(
    span: Span,
    g: usize,
    what: string,
    explicit: Option<TypeExpr[]>,
    args: Expr[],
    exp: Option<Type>,
  ): Result<HExpr, Diagnostic> {
    const gf = this.fx.env.gfuncs[g];
    let ptes: TypeExpr[] = [];
    for (const p of gf.decl.params) {
      ptes.push(p.ty);
    }
    const io = this.infer(
      span,
      what,
      gf.unit,
      gf.decl.typeParams,
      ptes,
      gf.decl.ret,
      args,
      exp,
      explicit,
    )?;
    let ret: Type = TyVoid;
    match (gf.decl.ret) {
      Some(rte) => {
        ret = this.resolveBound(gf.unit, paramNameList(gf.decl.typeParams), io.tys, rte, true)?;
      },
      None => {},
    }
    match (checkBounds(this.fx.env, gf.unit, gf.decl, io.tys, span)) {
      Some(d) => {
        return Err(d);
      },
      None => {},
    }
    let fid: usize = 0;
    if (!this.fx.abs) {
      const kr = this.keyRedirect(g, io.tys, span)?;
      if (kr.isSome()) {
        fid = kr.unwrap();
      } else {
        const fo = instFunc(this.fx.env, g, io.tys, this.fx.depth + 1, span)?;
        this.fx.adopt(fo.env);
        fid = fo.fid;
      }
    }
    return Ok(mk(XCall(fid, io.args), ret, span));
  }

  // `keyHash<K>` / `keyEq<K>` of the Map prelude for a key type that is not a scalar (ADR-0034): the derived (or, for a class, the
  // explicit) `hash` / `equals`. The scalar keys are redirected to `hashInt`, `eqStr`, ... by `instFunc`. None: not a key function.
  private keyRedirect(g: usize, tys: Type[], span: Span): Result<Option<usize>, Diagnostic> {
    const q = this.fx.env.gfuncs[g].qname;
    const none: Option<usize> = None;
    if (q != "$array/map.keyHash" && q != "$array/map.keyEq" || tys.length != 1 || isMapKeyType(tys[0])) {
      return Ok(none);
    }
    const bad = mapKeyError(this.fx.env, tys[0], true, span);
    if (bad.isSome()) {
      return Err(bad.unwrap());
    }
    if (q == "$array/map.keyHash") {
      const o = hashFunc(this.fx.env, tys[0], this.fx.unit, this.fx.depth, span)?;
      this.fx.adopt(o.env);
      return Ok(Some(o.fid));
    }
    const o = eqFunc(this.fx.env, tys[0], this.fx.unit, this.fx.depth, span)?;
    this.fx.adopt(o.env);
    return Ok(Some(o.fid));
  }

  @Ensures(result.isOk() ==> isUnionTy(result.unwrap().ty))
  private genericVariant(
    span: Span,
    g: usize,
    tag: usize,
    explicit: Option<TypeExpr[]>,
    args: Expr[],
    exp: Option<Type>,
  ): Result<HExpr, Diagnostic> {
    const gt = this.fx.env.gtypes[g];
    const vs = match (gt.decl.body) {
      DUnion(x) => x,
      _ => {
        return Err(diag("E0400", span, "not a variant constructor"));
      },
    };
    const v = vs[tag];
    const io = this.infer(
      span,
      "variant `" + v.name.name + "`",
      gt.unit,
      gt.decl.typeParams,
      v.payload,
      Some(selfTypeExpr(gt.decl)),
      args,
      exp,
      explicit,
    )?;
    const inst = instType(this.fx.env, g, io.tys, 0, span)?;
    match (inst.ty) {
      TyUnion(u) => {
        this.fx.adopt(inst.env);
        return Ok(mk(XVariant(tag, io.args), TyUnion(u), span));
      },
      _ => {
        return Err(diag("E0400", span, "not a variant constructor"));
      },
    }
  }

  // The task primitives whose types depend on the call (hir/taskops.or): transitPut (9) takes any value but a resource handle,
  // grantClone (17) and grantMove (18) take any family grant or a NetGrant (clone returns a grant of the same family); grantMove also a Stream (E0487 for a Listener, or a clone of a Stream).
  private taskTyped(
    span: Span,
    what: string,
    b: Builtin,
    k: usize,
    args: Expr[],
  ): Result<HExpr, Diagnostic> {
    if (args.length != 1) {
      return Err(
        diag("E0404", span, what + " expects 1 argument(s), found " + args.length.toString()),
      );
    }
    const r0 = this.ex(args[0], None)?;
    match (r0.ty) {
      TyGrant(g) => {
        if (k == 9 || k == 25) {
          return Err(
            diag("E0480", args[0].span, what + " cannot send a resource handle (a handle is not a value)"),
          );
        }
        if (g == 0) {
          return Err(
            diag("E0471", args[0].span, what + " needs a grant of a family (fs, process, stdio, clock, net), not the host"),
          );
        }
        // ADR-0017 Addendum C: a NetGrant is cloned and moved like a family grant; an accepted Stream is only moved
        // (never duplicated); a Listener never leaves its task.
        if (g == 6 || (g == 7 && k == 17)) {
          return Err(
            diag("E0487", args[0].span, what + (g == 6 ? " cannot take a Listener: a listener stays in the task that bound it (accept there and move the Stream)" : " cannot clone a Stream: a socket is moved into a task, never duplicated")),
          );
        }
        return Ok(mk(XBuiltin(b, [r0]), k == 17 ? r0.ty : TyUsize, span));
      },
      TyFile => {
        return Err(
          diag("E0480", args[0].span, what + " cannot take a file handle (a handle is not a value)"),
        );
      },
      _ => {
        if (k == 9 || k == 25) {
          return Ok(mk(XBuiltin(b, [r0]), TyUsize, span));
        }
        return Err(
          diag("E0471", args[0].span, what + " needs a grant, found `" + showType(this.fx.env, r0.ty) + "`"),
        );
      },
    }
  }

  // `addrOf(x)` (core dialect, ADR-0052 R3a): the object address of a string, an array or a record, as a usize.
  private coreAddrOf(
    span: Span,
    what: string,
    b: Builtin,
    args: Expr[],
  ): Result<HExpr, Diagnostic> {
    if (args.length != 1) {
      return Err(
        diag("E0404", span, what + " expects 1 argument(s), found " + args.length.toString()),
      );
    }
    const r0 = this.ex(args[0], None)?;
    const ok = match (r0.ty) {
      TyString => true,
      TyArray(_) => true,
      TyRecord(_) => true,
      _ => false,
    };
    if (!ok) {
      return Err(
        diag(
          "E0471",
          args[0].span,
          what + " needs a string, an array or a record, found `" + showType(this.fx.env, r0.ty) + "`",
        ),
      );
    }
    return Ok(mk(XBuiltin(b, [r0]), TyUsize, span));
  }

  // `plat(k, a, b, c)` and `fnAddr(k)` (hir/coreops.or 28, 29): `k` selects a function of a closed table and must be an integer literal
  // (a named `const` is inlined to its literal) naming a member of it, so that no call is computed (ADR-0052 Addendum B section 2.1).
  private coreLiteralK(
    span: Span,
    what: string,
    b: Builtin,
    op: usize,
    args: Expr[],
  ): Result<HExpr, Diagnostic> {
    const a = this.argsExpect(span, what, args, builtinSig(b).params)?;
    const k: int = match (a[0].kind) {
      XInt(n) => n,
      _ => -1,
    };
    if (k < 0) {
      return Err(
        diag("E0404", args[0].span, what + " needs an integer literal (or a named constant) as its first argument, not a computed value"),
      );
    }
    const ku = k.toUsize();
    let known = false;
    if (op == 28) {
      known = ku < platOpCount();
    } else {
      for (const e of fnAddrEntries()) {
        if (e == ku) {
          known = true;
        }
      }
    }
    if (!known) {
      return Err(
        diag(
          "E0404",
          args[0].span,
          what + " has no entry " + k.toString() + (op == 28 ? " (the table of platform functions has " + platOpCount().toString() + ")" : " that has a C wrapper of type void(void *)"),
        ),
      );
    }
    return Ok(mk(XBuiltin(b, a), TyUsize, span));
  }

  // `transitTake(token)`: its result is the record type expected at the call (an annotated local or a typed position).
  private callTake(
    span: Span,
    what: string,
    b: Builtin,
    args: Expr[],
    exp: Option<Type>,
  ): Result<HExpr, Diagnostic> {
    const a = this.argsExpect(span, what, args, [TyUsize])?;
    match (exp) {
      Some(t) => {
        return Ok(mk(XBuiltin(b, a), t, span));
      },
      None => {
        return Err(
          diag("E0407", span, what + " has no expected type: bind its result to a variable with a declared record type"),
        );
      },
    }
  }

  // The network builtins that accept more than one kind of handle (ADR-0033): one argument, a grant of kind lo..hi
  // (5 NetGrant, 6 Listener, 7 Stream).
  private netHandleCall(
    span: Span,
    what: string,
    b: Builtin,
    args: Expr[],
    lo: usize,
    hi: usize,
  ): Result<HExpr, Diagnostic> {
    if (args.length != 1) {
      return Err(diag("E0404", span, what + " expects 1 argument(s), found " + args.length.toString()));
    }
    const r0 = this.ex(args[0], None)?;
    const ok = match (r0.ty) {
      TyGrant(k) => k >= lo && k <= hi,
      _ => false,
    };
    if (!ok) {
      return Err(
        diag(
          "E0471",
          args[0].span,
          what + " needs a " + grantTypeName(lo) + (lo == hi ? "" : " or " + grantTypeName(hi)) + ", found `"
            + showType(this.fx.env, r0.ty) + "`",
        ),
      );
    }
    const ret = match (b) {
      BNetClose => TyVoid,
      _ => TyInt,
    };
    return Ok(mk(XBuiltin(b, [r0]), ret, span));
  }

  private callBuiltin(
    span: Span,
    what: string,
    b: Builtin,
    args: Expr[],
  ): Result<HExpr, Diagnostic> {
    match (b) {
      BTask(k) => {
        if (k == 9 || k == 17 || k == 18 || k == 25) {
          return this.taskTyped(span, what, b, k, args);
        }
      },
      BCore(k) => {
        if (k == 12) {
          return this.coreAddrOf(span, what, b, args);
        }
        if (k == 28 || k == 29) {
          return this.coreLiteralK(span, what, b, k, args);
        }
      },
      BGrantRevoke => {
        // `grantRevoke(g)` (std:fsraw, library code only): any grant
        if (args.length != 1) {
          return Err(
            diag("E0404", span, what + " expects 1 argument(s), found " + args.length.toString()),
          );
        }
        const r0 = this.ex(args[0], None)?;
        match (r0.ty) {
          TyGrant(_) => {
            return Ok(mk(XBuiltin(b, [r0]), TyVoid, span));
          },
          _ => {
            return Err(
              diag(
                "E0471",
                args[0].span,
                what + " needs a grant, found `" + showType(this.fx.env, r0.ty) + "`",
              ),
            );
          },
        }
      },
      BNetStatus => { return this.netHandleCall(span, what, b, args, 6, 7); },
      BNetClose => { return this.netHandleCall(span, what, b, args, 6, 7); },
      BNetPort => { return this.netHandleCall(span, what, b, args, 6, 6); },
      BNetNow => { return this.netHandleCall(span, what, b, args, 5, 7); },
      _ => {},
    }
    const sig = builtinSig(b);
    const gk = grantNeeded(b);
    if (gk.isSome()) {
      const gname = grantTypeName(gk.unwrap());
      if (args.length + 1 == sig.params.length) {
        return Err(grantMissingErr(span, what, gname));
      }
      if (args.length == sig.params.length) {
        // The first argument is only probed for its type: it is checked again with the others below.
        const saved = this.fx;
        const g0 = this.ex(args[0], Some(sig.params[0]))?;
        if (!typeEq(g0.ty, sig.params[0])) {
          const found = showType(this.fx.env, g0.ty);
          const isGrant = match (g0.ty) {
            TyGrant(_) => true,
            _ => false,
          };
          return Err(grantMismatchErr(args[0].span, what, gname, found, isGrant));
        }
        this.fx = saved;
      }
    }
    const a = this.argsExpect(span, what, args, sig.params)?;
    return Ok(mk(XBuiltin(b, a), sig.ret, span));
  }

  private callMember(
    span: Span,
    base: Expr,
    name: Ident,
    explicit: Option<TypeExpr[]>,
    args: Expr[],
    exp: Option<Type>,
  ): Result<HExpr, Diagnostic> {
    match (base.kind) {
      EIdent(bid) => {
        const special = (bid.name == "console" || bid.name == "String")
            && !this.fx.isVisibleVar(bid.name)
            && globalVal(this.fx.env, this.fx.unit, bid.name).isNone();
        if (special) {
          let b: Option<Builtin> = None;
          if (bid.name == "console" && name.name == "log") {
            b = Some(BConsoleLog);
          } else if (bid.name == "console" && name.name == "error") {
            b = Some(BConsoleError);
          } else if (bid.name == "String" && name.name == "fromCharCode") {
            b = Some(BStringFromCharCode);
          }
          if (b.isNone()) {
            return Err(
              diag("E0405", name.span, "`" + bid.name + "` has no member `" + name.name + "`"),
            );
          }
          if (explicit.isSome()) {
            return Err(notGenericMethod(name));
          }
          return this.callBuiltin(span, "`" + bid.name + "." + name.name + "`", b.unwrap(), args);
        }
        if (!this.fx.isVisibleVar(bid.name)
            && globalVal(this.fx.env, this.fx.unit, bid.name).isNone()) {
          const te = findType(this.fx.env.units[this.fx.unit].scope, bid.name);
          if (te.isSome()) {
            match (te.unwrap()) {
              EntRecord(r) => {
                const co = classOfRec(this.fx.env, r);
                if (co.isSome()) {
                  return this.staticCall(span, co.unwrap(), name, explicit, args, exp);
                }
              },
              EntGen(g) => {
                const co = classOfGeneric(this.fx.env, g);
                if (co.isSome()) {
                  return this.staticCall(span, co.unwrap(), name, explicit, args, exp);
                }
              },
              _ => {},
            }
          }
        }
      },
      _ => {},
    }
    return this.methodCall(span, base, name, explicit, args, exp);
  }

  private builtinCtor(
    span: Span,
    name: string,
    args: Expr[],
    exp: Option<Type>,
  ): Result<HExpr, Diagnostic> {
    if (name == "Some") {
      return this.someCtor(span, args, exp);
    }
    if (exp.isNone()) {
      // Ok(x) / Err(x) cannot infer the other type parameter.
      for (const a of args) {
        this.ex(a, None)?;
      }
      if (name == "Ok") {
        return Err(
          diag("E0407", span, "cannot infer the error type of `Ok(..)`; add a type annotation"),
        );
      }
      return Err(
        diag("E0407", span, "cannot infer the success type of `Err(..)`; add a type annotation"),
      );
    }
    const et = exp.unwrap();
    match (et) {
      TyResult(t, e) => {
        if (name == "Ok") {
          return this.okCtor(span, args, t, e);
        }
        return this.errCtor(span, args, t, e);
      },
      _ => {
        return Err(
          diag("E0400", span, "expected `" + showType(this.fx.env, et) + "`, found a `Result`"),
        );
      },
    }
  }

  @Ensures(result.isOk() ==> isOptionTy(result.unwrap().ty))
  private someCtor(span: Span, args: Expr[], exp: Option<Type>): Result<HExpr, Diagnostic> {
    if (args.length != 1) {
      return Err(diag("E0404", span, "`Some` expects 1 argument, found " + args.length.toString()));
    }
    let inner: Option<Type> = None;
    match (exp) {
      Some(t) => {
        match (t) {
          TyOption(x) => {
            inner = Some(x);
          },
          _ => {},
        }
      },
      None => {},
    }
    let p: HExpr = mk(XBool(false), TyBool, span);
    match (inner) {
      Some(x) => {
        p = this.ep(args[0], x)?;
      },
      None => {
        p = this.ex(args[0], None)?;
      },
    }
    if (isVoid(p.ty) && !this.fx.inst) {
      return Err(diag("E0400", args[0].span, "`Option<void>` is not allowed"));
    }
    return Ok(mk(XVariant(0, [p]), TyOption(p.ty), span));
  }

  @Ensures(result.isOk() ==> typeEq(result.unwrap().ty, TyResult(t, e)))
  private okCtor(span: Span, args: Expr[], t: Type, e: Type): Result<HExpr, Diagnostic> {
    const want: usize = isVoid(t) ? 0 : 1;
    if (want == 0 && args.length == 1 && this.fx.inst) {
      // `Ok(x)` with `x: T` in an instance with `T = void` (ADR-0040): the unit value, evaluated and dropped by the lowering
      const vp = this.ep(args[0], TyVoid)?;
      return Ok(mk(XVariant(0, [vp]), TyResult(t, e), span));
    }
    if (args.length != want) {
      return Err(
        diag(
          "E0404",
          span,
          "`Ok` expects " + want.toString() + " argument(s), found " + args.length.toString(),
        ),
      );
    }
    if (want == 0) {
      return Ok(mk(XVariant(0, noExprs()), TyResult(t, e), span));
    }
    const p = this.ep(args[0], t)?;
    return Ok(mk(XVariant(0, [p]), TyResult(t, e), span));
  }

  @Ensures(result.isOk() ==> typeEq(result.unwrap().ty, TyResult(t, e)))
  private errCtor(span: Span, args: Expr[], t: Type, e: Type): Result<HExpr, Diagnostic> {
    if (args.length != 1) {
      return Err(diag("E0404", span, "`Err` expects 1 argument, found " + args.length.toString()));
    }
    const p = this.ep(args[0], e)?;
    return Ok(mk(XVariant(1, [p]), TyResult(t, e), span));
  }

  // ---------------------------------------------------------------------------
  // Method calls
  // ---------------------------------------------------------------------------

  // Is `base` shaped like an assignable place (a visible variable, `this`, a field or an element)?
  private isPlaceShaped(base: Expr): bool {
    return match (base.kind) {
      EIdent(id) => this.fx.isVisibleVar(id.name),
      EThis => true,
      EMember(_, _) => true,
      EIndex(_, _) => true,
      _ => false,
    };
  }

  private methodCall(
    span: Span,
    base: Expr,
    name: Ident,
    explicit: Option<TypeExpr[]>,
    args: Expr[],
    exp: Option<Type>,
  ): Result<HExpr, Diagnostic> {
    const n = name.name;
    // The receiver is checked as a value first; for `push` / `pop` on a place it is checked again as a
    // place from the unchanged context.
    const saved = this.fx;
    const bo = this.ex(base, None);
    if (bo.isOk() && explicit.isSome()) {
      // explicit type arguments belong to a generic method of a class (ADR-0040)
      const isClassMethod = match (bo.unwrap().ty) {
        TyRecord(r) => classOfRec(this.fx.env, r).isSome()
            && findMethod(this.fx.env.classes[classOfRec(this.fx.env, r).unwrap()], n).isSome()
            && mapOrigin(this.fx.env, bo.unwrap().ty).isNone()
            && parOrigin(this.fx.env, bo.unwrap().ty).isNone(),
        _ => false,
      };
      if (!isClassMethod) {
        return Err(notGenericMethod(name));
      }
    }
    if (bo.isOk()) {
      const b0 = bo.unwrap();
      // `equals` / `compare` / `hash` of an `Eq` / `Ord` / `Hash` type (ADR-0034)
      const ck = cmpMethodKind(n);
      if (ck > 0 && cmpMethodApplies(this.fx, b0.ty, ck)) {
        const cps: Type[] = ck == 3 ? [] : [b0.ty];
        const ca = this.argsExpect(span, "method `" + n + "`", args, cps)?;
        const cm = cmpMethodExpr(this.fx, ck, b0, ca, span)?;
        this.fx.adopt(cm.env);
        return Ok(cm.e);
      }
      match (b0.ty) {
        TyRecord(r) => {
          const po = parOrigin(this.fx.env, b0.ty);
          if (po.isSome()) {
            return this.parMethodCall(b0, span, name, args, exp);
          }
          const mo = mapOrigin(this.fx.env, b0.ty);
          if (mo.isSome()) {
            return this.mapMethodCall(b0, span, base, name, args, exp, mo.unwrap());
          }
          const co = classOfRec(this.fx.env, r);
          if (co.isSome()) {
            const mi = findMethod(this.fx.env.classes[co.unwrap()], n);
            if (mi.isSome() || !recordHasFnField(this.fx.env.records[r].fields, n)) {
              return this.classMethodCall(span, base, b0, co.unwrap(), name, explicit, args, exp);
            }
          }
          const bds = boundsOf(this.fx.env, r);
          if (bds.length > 0) {
            // `T extends A & B`: the call goes to the first bound that declares the method (E0477 rules out bounds that
            // disagree on its signature); a method no bound declares is reported against the first bound
            let target = bds[0];
            let hit = false;
            for (const bi of bds) {
              if (!hit && ifaceMethodIndex(this.fx.env.ifaces[bi], n).isSome()) {
                target = bi;
                hit = true;
              }
            }
            return this.ifaceCall(b0, span, target, name, args);
          }
          if (recordHasFnField(this.fx.env.records[r].fields, n)) {
            return this.callFieldValue(b0, span, r, name, args);
          }
        },
        TyArray(t) => {
          if (n == "parallel") {
            return this.parallelCall(b0, span, t, name, args, exp);
          }
          if (isArrayApi(n)) {
            return this.arrayApiCall(b0, span, t, name, args, exp);
          }
        },
        TyIface(i) => {
          return this.ifaceCall(b0, span, i, name, args);
        },
        _ => {},
      }
    }
    if (n == "push" || n == "pop") {
      this.fx = saved;
      return this.mutMethodCall(span, base, name, args);
    }
    const b = bo?;
    if (isIntish(b.ty)) {
      const im = this.intMethodCall(b, span, name, args)?;
      if (im.isSome()) {
        return Ok(im.unwrap());
      }
    }
    const so = methodSig(b.ty, n);
    if (so.isNone()) {
      return Err(this.noMethodNote(
        diag(
          "E0405",
          name.span,
          "no method `" + n + "` on type `" + showType(this.fx.env, b.ty) + "`",
        ),
        b.ty,
        n,
      ));
    }
    const s = so.unwrap();
    const a = this.argsExpect(span, "method `" + n + "`", args, s.params)?;
    let all: HExpr[] = [b];
    for (const x of a) {
      all.push(x);
    }
    return Ok(mk(XBuiltin(s.op, all), s.ret, span));
  }

  // Methods of the integer types (ADR-0022) that need constants or the receiver type: explicit conversions
  // (`toI32()`, `toUsize()`, `toInt()`, ...) and `wrapping*` / `saturating*` / `checked*` `Add` / `Sub` / `Mul`.
  // None when `name` is not one of them (the plain built-in methods are in builtins.or).
  private intMethodCall(
    b: HExpr,
    span: Span,
    name: Ident,
    args: Expr[],
  ): Result<Option<HExpr>, Diagnostic> {
    const n = name.name;
    if (n == "toI128" || n == "toU128") {
      return Err(
        diag(
          "E0431",
          name.span,
          "the 128-bit integer types are not supported yet (ADR-0022); use `toI64()` / `toU64()`",
        ),
      );
    }
    const dk = convMethodKind(n);
    if (dk >= 0) {
      const none: Type[] = [];
      this.argsExpect(span, "method `" + n + "`", args, none)?;
      return Ok(Some(convExpr(b, dk, span)));
    }
    const mode = arithMethodMode(n);
    if (mode >= 0) {
      const a = this.argsExpect(span, "method `" + n + "`", args, [b.ty])?;
      return Ok(Some(arithExpr(mode, b, a[0], span)));
    }
    const bit = bitMethodMode(n);
    if (bit >= 0) {
      if (bit == 3) {
        const none3: Type[] = [];
        this.argsExpect(span, "method `" + n + "`", args, none3)?;
        const noArg: Option<HExpr> = None;
        return Ok(Some(bitExpr(bit, b, noArg, span)));
      }
      const want = bit >= 4 ? TyInt : b.ty;
      const a = this.argsExpect(span, "method `" + n + "`", args, [want])?;
      return Ok(Some(bitExpr(bit, b, Some(a[0]), span)));
    }
    const none2: Option<HExpr> = None;
    return Ok(none2);
  }

  @Ensures(result.isOk() ==> isVoid(result.unwrap().ty) || isOptionTy(result.unwrap().ty))
  private mutMethodCall(
    span: Span,
    base: Expr,
    name: Ident,
    args: Expr[],
  ): Result<HExpr, Diagnostic> {
    const n = name.name;
    if (this.isPlaceShaped(base)) {
      const pi = this.placeOf(base)?;
      match (pi.place.ty) {
        TyArray(t) => {
          if (!pi.mutable) {
            return Err(
              diag(
                "E0401",
                base.span,
                "cannot call `" + n + "` on `" + pi.rootName + "`: it is not declared with `let`",
              ),
            );
          }
          const isPush = n == "push";
          const params: Type[] = isPush ? [t] : [];
          this.fx.markMut(pi.place);
          const a = this.argsExpect(span, "method `" + n + "`", args, params)?;
          const op: MutBuiltin = isPush ? MArrPush : MArrPop;
          const ret: Type = isPush ? TyVoid : TyOption(t);
          return Ok(mk(XMutMethod(op, pi.place, a), ret, span));
        },
        _ => {
          return Err(this.noMethodNote(
            diag(
              "E0405",
              name.span,
              "no method `" + n + "` on type `" + showType(this.fx.env, pi.place.ty) + "`",
            ),
            pi.place.ty,
            n,
          ));
        },
      }
    }
    const b = this.ex(base, None)?;
    if (isArrayTy(b.ty)) {
      return Err(diag("E0401", base.span, "receiver of `" + n + "` must be a mutable place"));
    }
    return Err(this.noMethodNote(
      diag(
        "E0405",
        name.span,
        "no method `" + n + "` on type `" + showType(this.fx.env, b.ty) + "`",
      ),
      b.ty,
      n,
    ));
  }

  // ---------------------------------------------------------------------------
  // Places
  // ---------------------------------------------------------------------------

  private placeOf(e: Expr): Result<PlaceInfo, Diagnostic> {
    match (e.kind) {
      EIdent(id) => {
        const lv = this.fx.lookupVar(id.name);
        if (lv.isSome()) {
          const l = lv.unwrap();
          if (this.fx.isCapturedLocal(l)) {
            return Err(capturedErr(e.span, id.name));
          }
          const loc = this.fx.locals[l];
          const path: PlaceElem[] = [];
          return Ok(PlaceInfo {
            place: Place { root: l, path: path, ty: loc.ty },
            mutable: loc.mutable,
            rootName: id.name,
          });
        }
        if (globalVal(this.fx.env, this.fx.unit, id.name).isSome()) {
          return Err(diag("E0401", e.span, "cannot assign to `" + id.name + "`"));
        }
        return Err(this.unresolved(id));
      },
      EThis => {
        const lv = this.fx.lookupVar("this");
        if (lv.isNone()) {
          return Err(thisErr(this.fx.fmode, e.span));
        }
        const l = lv.unwrap();
        if (this.fx.isCapturedLocal(l)) {
          return Err(capturedErr(e.span, "this"));
        }
        const path: PlaceElem[] = [];
        return Ok(PlaceInfo {
          place: Place { root: l, path: path, ty: this.fx.locals[l].ty },
          mutable: this.fx.locals[l].mutable,
          rootName: "this",
        });
      },
      EMember(base, name) => {
        const p = this.placeOf(base)?;
        match (p.place.ty) {
          TyRecord(r) => {
            if (this.outsideMapPrelude(p.place.ty)) {
              return Err(
                diag(
                  "E0401",
                  e.span,
                  "`" + name.name
                      + "` is read-only: a `Map` changes only through `set` and `delete`",
                ),
              );
            }
            const def = this.fx.env.records[r];
            const io = fieldIndex(def.fields, name.name);
            if (io.isNone()) {
              return Err(
                diag("E0405", name.span, "no field `" + name.name + "` on type `" + def.name + "`"),
              );
            }
            this.fieldAccess(r, name)?;
            const i = io.unwrap();
            return Ok(PlaceInfo {
              place: extendPath(p.place, PField(r, i), def.fields[i].ty),
              mutable: p.mutable,
              rootName: p.rootName,
            });
          },
          TyString => {
            if (name.name == "length") {
              return Err(diag("E0401", e.span, "`length` is read-only"));
            }
            return Err(noField(this.fx.env, name, p.place.ty));
          },
          TyArray(_) => {
            if (name.name == "length") {
              return Err(diag("E0401", e.span, "`length` is read-only"));
            }
            return Err(noField(this.fx.env, name, p.place.ty));
          },
          _ => {
            return Err(noField(this.fx.env, name, p.place.ty));
          },
        }
      },
      EIndex(base, index) => {
        const p = this.placeOf(base)?;
        match (p.place.ty) {
          TyArray(t) => {
            const idx = this.ep(index, TyUsize)?;
            return Ok(PlaceInfo {
              place: extendPath(p.place, PIndex(idx), t),
              mutable: p.mutable,
              rootName: p.rootName,
            });
          },
          _ => {
            return Err(
              diag(
                "E0400",
                e.span,
                "cannot index into type `" + showType(this.fx.env, p.place.ty) + "`",
              ),
            );
          },
        }
      },
      _ => {
        return Err(diag("E0401", e.span, "expression is not an assignable place"));
      },
    }
  }

  // ---------------------------------------------------------------------------
  // Classes (beyond Orin-B, ADR-0009)
  // ---------------------------------------------------------------------------

  // A private field is only accessible inside its class (E0405).
  @Ensures(result.isErr() ==> result.unwrapErr().code == "E0405")
  private fieldAccess(r: usize, name: Ident): Result<void, Diagnostic> {
    const co = classOfRec(this.fx.env, r);
    if (co.isSome()) {
      const c = co.unwrap();
      const ci = this.fx.env.classes[c];
      if (fieldIsPrivate(ci, name.name) && !this.fx.inClass(c)) {
        return Err(
          diag(
            "E0405",
            name.span,
            "field `" + name.name + "` of class `" + ci.name + "` is private",
          ),
        );
      }
    }
    return Ok();
  }

  private newExpr(
    span: Span,
    name: Ident,
    targs: TypeExpr[],
    args: Expr[],
    exp: Option<Type>,
  ): Result<HExpr, Diagnostic> {
    const env = this.fx.env;
    if (name.name == "Map"
        && findType(env.units[this.fx.unit].scope, "Map").isNone()
        && env.mapUnit.isSome()) {
      return this.newMap(span, targs, args, exp);
    }
    const found = findType(env.units[this.fx.unit].scope, name.name);
    if (found.isNone()) {
      return Err(diag("E0300", name.span, "unknown class `" + name.name + "`"));
    }
    const co = match (found.unwrap()) {
      EntRecord(r) => classOfRec(env, r),
      EntGen(g) => classOfGeneric(env, g),
      _ => None,
    };
    if (co.isNone()) {
      return Err(diag("E0400", name.span, "`" + name.name + "` is not a class"));
    }
    const ci = env.classes[co.unwrap()];
    if (ci.gid >= 0) {
      // Generic class (ADR-0026): the constructor is a generic function; the type arguments come from the
      // explicit list, the expected type or the arguments, exactly as for a generic function call.
      let explicit: Option<TypeExpr[]> = None;
      if (targs.length > 0) {
        explicit = Some(targs);
      }
      return this.callGenericW(
        span,
        ci.ctor,
        "constructor of `" + name.name + "`",
        explicit,
        args,
        exp,
      );
    }
    if (targs.length > 0) {
      return Err(
        diag(
          "E0400",
          name.span,
          "class `" + name.name + "` is not generic and takes no type arguments",
        ),
      );
    }
    const f = env.funcs[ci.ctor];
    const a = this.argsExpect(span, "constructor of `" + name.name + "`", args, f.params)?;
    return Ok(mk(XCall(ci.ctor, a), TyRecord(ci.rec), span));
  }

  private staticCall(
    span: Span,
    c: usize,
    name: Ident,
    explicit: Option<TypeExpr[]>,
    args: Expr[],
    exp: Option<Type>,
  ): Result<HExpr, Diagnostic> {
    const ci = this.fx.env.classes[c];
    const mo = findMethod(ci, name.name);
    if (mo.isNone()) {
      return Err(
        diag(
          "E0405",
          name.span,
          "class `" + ci.name + "` has no static method `" + name.name + "`",
        ),
      );
    }
    const mi = ci.methods[mo.unwrap()];
    if (mi.priv && !this.fx.inClass(c)) {
      return Err(
        diag(
          "E0405",
          name.span,
          "method `" + name.name + "` of class `" + ci.name + "` is private",
        ),
      );
    }
    if (!mi.isStatic) {
      return Err(
        diag(
          "E0405",
          name.span,
          "`" + name.name + "` is an instance method of `" + ci.name + "`; call it on a value",
        ),
      );
    }
    if (mi.gen) {
      // a generic static method (ADR-0040): inferred and instantiated like a generic function
      return this.callGenericW(span, mi.fid, "method `" + ci.name + "." + name.name + "`", explicit, args, exp);
    }
    if (explicit.isSome()) {
      return Err(notGenericMethod(name));
    }
    const f = this.fx.env.funcs[mi.fid];
    const a = this.argsExpect(span, "method `" + name.name + "`", args, f.params)?;
    return Ok(mk(XCall(mi.fid, a), f.ret, span));
  }

  // `recv.m(args)` where the receiver has class type `c` (already checked as `b`).
  private classMethodCall(
    span: Span,
    base: Expr,
    b: HExpr,
    c: usize,
    name: Ident,
    explicit: Option<TypeExpr[]>,
    args: Expr[],
    exp: Option<Type>,
  ): Result<HExpr, Diagnostic> {
    const ci = this.fx.env.classes[c];
    const mo = findMethod(ci, name.name);
    if (mo.isNone()) {
      return Err(
        diag("E0405", name.span, "no method `" + name.name + "` on class `" + ci.name + "`"),
      );
    }
    const mi = ci.methods[mo.unwrap()];
    if (mi.priv && !this.fx.inClass(c)) {
      return Err(
        diag(
          "E0405",
          name.span,
          "method `" + name.name + "` of class `" + ci.name + "` is private",
        ),
      );
    }
    if (mi.isStatic) {
      return Err(
        diag(
          "E0405",
          name.span,
          "`" + name.name + "` is a static method; call it as `" + ci.name + "." + name.name
              + "(..)`",
        ),
      );
    }
    let ms: MethSig = MethSig { fid: 0, params: [], ret: TyVoid, srcRet: TyVoid, retRec: 0 };
    let all: HExpr[] = [b];
    if (mi.ownTps > 0) {
      // a generic method (ADR-0040): the method's type arguments are explicit or inferred from the arguments and the
      // expected type; the class's come from the receiver
      const gm = this.genericMethodSig(span, ci, mi, base, b, name, explicit, args, exp)?;
      ms = gm.ms;
      for (const x of gm.args) {
        all.push(x);
      }
    } else {
      if (explicit.isSome()) {
        return Err(notGenericMethod(name));
      }
      ms = this.methodSigOf(ci, mi, b.ty, span)?;
      const a = this.argsExpect(span, "method `" + name.name + "`", args, tailTypes(ms.params))?;
      for (const x of a) {
        all.push(x);
      }
    }
    if (!mi.mutating) {
      return Ok(mk(XCall(ms.fid, all), ms.srcRet, span));
    }
    if (!this.isPlaceShaped(base)) {
      return Err(
        diag(
          "E0401",
          base.span,
          "receiver of mutating method `" + name.name
              + "` must be a mutable place (a `let` variable, field or element)",
        ),
      );
    }
    const pi = this.placeOf(base)?;
    if (!pi.mutable) {
      return Err(
        diag(
          "E0401",
          base.span,
          "cannot call mutating method `" + name.name + "` on `" + pi.rootName
              + "`: it is not declared with `let`",
        ),
      );
    }
    this.fx.markMut(pi.place);
    if (this.fx.probe) {
      if (mi.hasRet) {
        return Ok(mk(XCall(ms.fid, noExprs()), ms.srcRet, span));
      }
      return Ok(nopExpr(span));
    }
    if (!purePlace(pi.place)) {
      return Err(
        diag(
          "E0408",
          base.span,
          "the receiver of mutating method `" + name.name
              + "` must not contain index expressions with side effects",
        ),
      );
    }
    const call = mk(XCall(ms.fid, all), ms.ret, span);
    if (!mi.hasRet) {
      this.fx.hoist(HAssign(pi.place, None, call));
      return Ok(nopExpr(span));
    }
    const tid = this.fx.newTemp("$r", ms.ret);
    const tmp = mk(XLocal(tid), ms.ret, span);
    this.fx.hoist(HLet(tid, call));
    const selfTy = b.ty;
    this.fx.hoist(HAssign(pi.place, None, mk(XField(tmp, ms.retRec, 0), selfTy, span)));
    return Ok(mk(XField(tmp, ms.retRec, 1), ms.srcRet, span));
  }

  // The signature of method `mi` of class `ci` for a receiver of type `recv`. An ordinary class has one
  // function per method. A generic class (ADR-0026) has a generic function per method: the signature
  // is the one under the receiver's type arguments, and outside abstract checks and mutation probes the
  // instance is created (`instFunc`) and called. Abstract checks / probes never create instances.
  @Ensures(result.isOk() && !mi.isStatic ==> result.unwrap().params.length >= 1)
  private methodSigOf(
    ci: ClassInfo,
    mi: MethodInfo,
    recv: Type,
    span: Span,
  ): Result<MethSig, Diagnostic> {
    if (ci.gid < 0 || mi.isStatic) {
      const f = this.fx.env.funcs[mi.fid];
      return Ok(MethSig {
        fid: mi.fid,
        params: f.params,
        ret: f.ret,
        srcRet: f.srcRet,
        retRec: mi.retRec,
      });
    }
    const o = originOf(this.fx.env, recv);
    const args = match (o) {
      Some(i) => i.args,
      None => {
        return Err(
          diag(
            "E0400",
            span,
            "`" + showType(this.fx.env, recv) + "` is not an instance of class `" + ci.name + "`",
          ),
        );
      },
    };
    const gf = this.fx.env.gfuncs[mi.fid];
    if (this.fx.abs || this.fx.probe) {
      const sc = new TScope(gf.unit, paramNameList(gf.decl.typeParams), args, 0);
      const sig = resolveSig(this.fx.env, sc, gf.decl)?;
      this.fx.adopt(sig.env);
      return Ok(MethSig { fid: 0, params: sig.params, ret: sig.ret, srcRet: sig.ret, retRec: 0 });
    }
    const fo = instFunc(this.fx.env, mi.fid, args, this.fx.depth + 1, span)?;
    const f = fo.env.funcs[fo.fid];
    let rr: usize = 0;
    if (isMutRetMode(f.mode)) {
      rr = match (f.ret) {
        TyRecord(r) => r,
        _ => 0,
      };
    }
    this.fx.adopt(fo.env);
    return Ok(MethSig { fid: fo.fid, params: f.params, ret: f.ret, srcRet: f.srcRet, retRec: rr });
  }

  // The call `recv.m<..>(args)` of a generic method `mi` of class `ci` (ADR-0040). The method is the generic function
  // `C.m<class params.., method params..>(this$: C<..>, params..)`: the class's type arguments are fixed by the receiver,
  // the method's are explicit or inferred like those of a generic function. The instance is keyed by (class instance, method,
  // type arguments) because the class's arguments are the first ones. In an abstract check or a mutation probe no instance
  // is created. Returns the signature and the checked arguments (without the receiver).
  private genericMethodSig(
    span: Span,
    ci: ClassInfo,
    mi: MethodInfo,
    base: Expr,
    b: HExpr,
    name: Ident,
    explicit: Option<TypeExpr[]>,
    args: Expr[],
    exp: Option<Type>,
  ): Result<GenMeth, Diagnostic> {
    const gf = this.fx.env.gfuncs[mi.fid];
    let fixed: Type[] = [];
    if (ci.gid >= 0) {
      const o = originOf(this.fx.env, b.ty);
      match (o) {
        Some(i) => {
          fixed = i.args;
        },
        None => {
          return Err(
            diag(
              "E0400",
              span,
              "`" + showType(this.fx.env, b.ty) + "` is not an instance of class `" + ci.name + "`",
            ),
          );
        },
      }
    }
    if (args.length + 1 != gf.decl.params.length) {
      return Err(
        diag(
          "E0404",
          span,
          "method `" + name.name + "` expects " + (gf.decl.params.length - 1).toString()
              + " argument(s), found " + args.length.toString(),
        ),
      );
    }
    let ptes: TypeExpr[] = [];
    for (const p of gf.decl.params) {
      ptes.push(p.ty);
    }
    // The receiver is argument 0 (already checked; its source expression is not used).
    let all: Expr[] = [base];
    let pre: Option<HExpr>[] = [Some(b)];
    for (const a of args) {
      all.push(a);
      pre.push(None);
    }
    const io = this.inferPre(
      span,
      "method `" + name.name + "`",
      gf.unit,
      gf.decl.typeParams,
      ptes,
      gf.decl.ret,
      all,
      exp,
      explicit,
      pre,
      fixed,
    )?;
    match (checkBounds(this.fx.env, gf.unit, gf.decl, io.tys, span)) {
      Some(d) => {
        return Err(d);
      },
      None => {},
    }
    let rest: HExpr[] = [];
    let i: usize = 1;
    while (i < io.args.length) {
      rest.push(io.args[i]);
      i += 1;
    }
    if (this.fx.abs || this.fx.probe) {
      const sc = new TScope(gf.unit, paramNameList(gf.decl.typeParams), io.tys, 0);
      const sig = resolveSig(this.fx.env, sc, gf.decl)?;
      this.fx.adopt(sig.env);
      return Ok(GenMeth {
        ms: MethSig { fid: 0, params: sig.params, ret: sig.ret, srcRet: sig.ret, retRec: 0 },
        args: rest,
      });
    }
    const fo = instFunc(this.fx.env, mi.fid, io.tys, this.fx.depth + 1, span)?;
    const f = fo.env.funcs[fo.fid];
    let rr: usize = 0;
    if (isMutRetMode(f.mode)) {
      rr = match (f.ret) {
        TyRecord(r) => r,
        _ => 0,
      };
    }
    this.fx.adopt(fo.env);
    return Ok(GenMeth {
      ms: MethSig { fid: fo.fid, params: f.params, ret: f.ret, srcRet: f.srcRet, retRec: rr },
      args: rest,
    });
  }

  // `r.f(args)` where field `f` of record `r` has a function type.
  private callFieldValue(
    b: HExpr,
    span: Span,
    r: usize,
    name: Ident,
    args: Expr[],
  ): Result<HExpr, Diagnostic> {
    const def = this.fx.env.records[r];
    const i = fieldIndex(def.fields, name.name).unwrap();
    this.fieldAccess(r, name)?;
    const callee = mk(XField(b, r, i), def.fields[i].ty, span);
    match (def.fields[i].ty) {
      TyFn(ps, ret) => {
        const a = this.argsExpect(span, "function value `" + name.name + "`", args, ps)?;
        return Ok(mk(XCallIndirect(callee, a), ret, span));
      },
      _ => {
        return Err(diag("E0400", span, "`" + name.name + "` is not a function"));
      },
    }
  }

  // ---------------------------------------------------------------------------
  // Closures and function values (beyond Orin-B, ADR-0011)
  // ---------------------------------------------------------------------------

  // An arrow function: `expP` / `expR` are the parameter and result types of the expected function
  // type, when known. The body is checked as a new function (closure conversion): its first parameter
  // is the environment record holding the captured variables, which are bound to immutable locals
  // at entry. The result is `XClosure(lifted, captures)`.
  @Ensures(result.isOk() ==> isFn(result.unwrap().ty) && this.fx.ncl == old(this.fx.ncl) + 1)
  @Ensures(result.isOk() ==> this.fx.env.lifted.length > old(this.fx.env.lifted.length))
  private arrow(
    span: Span,
    ps: ArrowParam[],
    retTE: Option<TypeExpr>,
    body: ArrowBody,
    expP: Option<Type[]>,
    expR: Option<Type>,
  ): Result<HExpr, Diagnostic> {
    match (expP) {
      Some(eps) => {
        if (eps.length != ps.length) {
          return Err(
            diag(
              "E0404",
              span,
              "this function value is expected to take " + eps.length.toString()
                  + " argument(s), the arrow function has " + ps.length.toString()
                  + " parameter(s)",
            ),
          );
        }
      },
      None => {},
    }
    let ptys: Type[] = [];
    let names: string[] = [];
    let i: usize = 0;
    for (const p of ps) {
      for (const n of names) {
        if (n == p.name.name) {
          return Err(diag("E0304", p.name.span, "duplicate parameter `" + p.name.name + "`"));
        }
      }
      let t: Type = TyInt;
      match (p.ty) {
        Some(te) => {
          t = this.resolve(te, false)?;
          match (expP) {
            Some(eps) => {
              if (!typeEq(eps[i], t)) {
                return Err(mismatch(this.fx.env, p.span, eps[i], t));
              }
            },
            None => {},
          }
        },
        None => {
          match (expP) {
            Some(eps) => {
              t = eps[i];
            },
            None => {
              return Err(
                diag(
                  "E0407",
                  p.name.span,
                  "cannot infer the type of parameter `" + p.name.name + "`; add a type annotation",
                ),
              );
            },
          }
        },
      }
      if (isNamespaceName(this.fx.env, this.fx.unit, p.name.name)) {
        return Err(nsShadowErr(p.name));
      }
      ptys.push(t);
      names.push(p.name.name);
      i += 1;
    }
    let ret: Type = TyVoid;
    let known = false;
    match (retTE) {
      Some(te) => {
        ret = this.resolve(te, true)?;
        known = true;
      },
      None => {
        match (expR) {
          Some(t) => {
            ret = t;
            known = true;
          },
          None => {},
        }
      },
    }
    const isBlock = match (body) {
      ABlock(_) => true,
      AExpr(_) => false,
    };
    const lname = this.fx.qname + "$closure" + this.fx.ncl.toString();
    // The body is checked as a function of its own, in a context that sees this one as `outer`.
    let sub = new ExprChecker(
      newClosureCtx(this.fx, lname, names, ptys, ret, !known && isBlock),
      this.host,
    );
    let stmts: HStmt[] = [];
    let finalRet = ret;
    match (body) {
      AExpr(e) => {
        if (known && isVoid(ret)) {
          const so = this.host.stmtExpr(sub.fx, e)?;
          sub.fx = so.fx;
          stmts = [so.stmt];
        } else {
          let r: HExpr = mk(XBool(false), TyBool, span);
          if (known) {
            r = sub.ep(e, ret)?;
          } else {
            r = sub.ex(e, None)?;
          }
          if (isVoid(r.ty)) {
            finalRet = TyVoid;
            stmts = isNop(r) ? [] : [HExprStmt(r)];
          } else {
            finalRet = r.ty;
            stmts = [HReturn(Some(r))];
          }
        }
        if (sub.fx.pre.length > 0) {
          let all: HStmt[] = [];
          for (const h of sub.fx.pre) {
            all.push(h);
          }
          for (const h of stmts) {
            all.push(h);
          }
          stmts = all;
          sub.fx.restorePre([]);
        }
      },
      ABlock(b) => {
        const bo = this.host.block(sub.fx, b)?;
        sub.fx = bo.fx;
        stmts = bo.block.stmts;
        if (!known) {
          finalRet = sub.fx.retSeen.unwrapOr(TyVoid);
        }
        if (!isVoid(finalRet) && !bo.div) {
          return Err(diag("E0403", span, "the closure does not return a value on every path"));
        }
      },
    }
    if (hasResource(finalRet)) {
      return Err(
        diag(
          "E0450",
          span,
          "a closure cannot return a resource handle (it can only be passed to functions, borrowed)",
        ),
      );
    }
    // Environment record, entry prologue, lifted function; then, back in the enclosing function,
    // evaluate the captured variables there.
    const lo = liftClosure(sub.fx, lname, ptys, stmts, finalRet, span);
    this.fx.replaceEnv(lo.env);
    this.fx.ncl += 1;
    let caps: HExpr[] = [];
    for (const nm of sub.fx.caps.names) {
      const v = this.fx.lookupVar(nm);
      const id = v.unwrap();
      caps.push(mk(XLocal(id), this.fx.locals[id].ty, span));
    }
    return Ok(mk(XClosure(lo.fid, caps), TyFn(ptys, finalRet), span));
  }

  // The lifted wrapper of function `fid` as a function value (created once per function).
  @Ensures(result.isOk() ==> isFn(result.unwrap().ty))
  private wrapFunc(span: Span, fid: usize): Result<HExpr, Diagnostic> {
    const w = wrapperOf(this.fx, span, fid)?;
    if (w.created) {
      this.fx.replaceEnv(w.env);
    }
    const f = this.fx.env.funcs[fid];
    const noCaps: HExpr[] = [];
    return Ok(mk(XClosure(w.wid, noCaps), TyFn(f.params, f.ret), span));
  }

  // A top-level function used as a value. A generic function needs its type arguments from the
  // expected function type: `expP` / `expR` (parameter types, and the result type when known).
  @Ensures(result.isOk() ==> isFn(result.unwrap().ty))
  private funcValue(
    span: Span,
    ent: ValEnt,
    id: Ident,
    expP: Option<Type[]>,
    expR: Option<Type>,
  ): Result<HExpr, Diagnostic> {
    match (ent) {
      VFunc(fid) => {
        const tg = testGuard(this.fx.env.funcs[fid], span);
        if (tg.isSome()) {
          return Err(tg.unwrap());
        }
        return this.wrapFunc(span, fid);
      },
      VGFunc(g) => {
        const gf = this.fx.env.gfuncs[g];
        const tp = paramNameList(gf.decl.typeParams);
        let inf = new Inference(tp, 0);
        match (expP) {
          Some(eps) => {
            if (eps.length != gf.decl.params.length) {
              return Err(
                diag(
                  "E0404",
                  span,
                  "function `" + id.name + "` takes " + gf.decl.params.length.toString()
                      + " argument(s), the expected function type has " + eps.length.toString(),
                ),
              );
            }
            let i: usize = 0;
            while (i < eps.length) {
              inf.learn(this.fx.env, gf.unit, gf.decl.params[i].ty, eps[i]);
              i += 1;
            }
          },
          None => {},
        }
        match (expR) {
          Some(er) => {
            match (gf.decl.ret) {
              Some(rt) => {
                inf.learn(this.fx.env, gf.unit, rt, er);
              },
              None => {},
            }
          },
          None => {},
        }
        let tys: Type[] = [];
        let bi: usize = 0;
        for (const b of inf.binds) {
          match (b) {
            Some(t) => {
              tys.push(t);
            },
            None => {
              return Err(
                diag(
                  "E0407",
                  span,
                  "cannot infer type argument `" + tp[bi] + "` of function `" + id.name
                      + "` used as a value; its type arguments come from the expected function type, add a type annotation",
                ),
              );
            },
          }
          bi += 1;
        }
        let ptys: Type[] = [];
        for (const p of gf.decl.params) {
          const pt = this.resolveBound(gf.unit, tp, tys, p.ty, false)?;
          ptys.push(pt);
        }
        let ret: Type = TyVoid;
        match (gf.decl.ret) {
          Some(rte) => {
            ret = this.resolveBound(gf.unit, tp, tys, rte, true)?;
          },
          None => {},
        }
        match (checkBounds(this.fx.env, gf.unit, gf.decl, tys, span)) {
          Some(d) => {
            return Err(d);
          },
          None => {},
        }
        if (this.fx.abs) {
          const noCaps: HExpr[] = [];
          return Ok(mk(XClosure(0, noCaps), TyFn(ptys, ret), span));
        }
        const fo = instFunc(this.fx.env, g, tys, this.fx.depth + 1, span)?;
        this.fx.adopt(fo.env);
        return this.wrapFunc(span, fo.fid);
      },
      _ => {
        return Err(diag("E0400", span, "function `" + id.name + "` cannot be used as a value"));
      },
    }
  }

  // ---------------------------------------------------------------------------
  // Array API (spec 08): methods implemented as functions of the injected prelude
  // (library/collections/array.or, unit `$array/array`), called with the receiver as first argument.
  // ---------------------------------------------------------------------------

  private arrayApiCall(
    b: HExpr,
    span: Span,
    elem: Type,
    name: Ident,
    args: Expr[],
    exp: Option<Type>,
  ): Result<HExpr, Diagnostic> {
    const n = name.name;
    let fname = n;
    if (n == "indexOf" || n == "includes") {
      const suffix = elemSuffix(elem);
      if (suffix == "") {
        return Err(
          diag(
            "E0405",
            name.span,
            "method `" + n + "` is only available on arrays of integers, `bool` or `string`, not `"
                + showType(this.fx.env, TyArray(elem)) + "`",
          ),
        );
      }
      fname = n + suffix;
    }
    const noMethod = this.noMethodNote(diag(
      "E0405",
      name.span,
      "no method `" + n + "` on type `" + showType(this.fx.env, TyArray(elem)) + "`",
    ), TyArray(elem), n);
    if (this.fx.env.prelude.isNone()) {
      return Err(noMethod);
    }
    const argTy: Option<Type> = (n == "indexOf" || n == "includes") && isIntish(elem)
        ? Some(elem)
        : None;
    return this.preludeCall(
      b,
      span,
      this.fx.env.prelude.unwrap(),
      fname,
      n,
      noMethod,
      args,
      noPre(args.length),
      exp,
      argTy,
    );
  }

  // The array method `parallel()` (ADR-0039): a call of `parallel` of the parallel prelude (library/collections/parallel.or, loaded for every
  // file that calls it). The input is lent to worker tasks without a copy, which needs element types without counted
  // references inside the elements: scalars and records of scalars (E0486) until borrow inference exists (ADR-0039 §4).
  private parallelCall(
    b: HExpr,
    span: Span,
    elem: Type,
    name: Ident,
    args: Expr[],
    exp: Option<Type>,
  ): Result<HExpr, Diagnostic> {
    const noMethod = diag(
      "E0405",
      name.span,
      "no method `parallel` on type `" + showType(this.fx.env, TyArray(elem)) + "`",
    );
    if (this.fx.env.parUnit.isNone()) {
      return Err(noMethod);
    }
    if (!this.parallelElem(elem)) {
      return Err(
        diag(
          "E0486",
          name.span,
          "`parallel()` needs an array of scalars or of records whose fields are scalars, not `"
              + showType(this.fx.env, TyArray(elem))
              + "`: the worker tasks read the input without copying it, and until borrow inference exists (ADR-0039 §4) that is only sound for elements that hold no counted references (map to scalars first, or drop `parallel()`)",
        ),
      );
    }
    return this.preludeCall(
      b, span, this.fx.env.parUnit.unwrap(), "parallel", "parallel", noMethod, args, noPre(args.length), exp, None,
    );
  }

  // A scalar (integer, float, bool) or a record whose fields are all scalars.
  private parallelElem(t: Type): bool {
    if (isParScalar(t)) {
      return true;
    }
    match (t) {
      TyRecord(r) => {
        if (classOfRec(this.fx.env, r).isSome() || mapOrigin(this.fx.env, t).isSome()) {
          return false;
        }
        for (const f of this.fx.env.records[r].fields) {
          if (!isParScalar(f.ty)) {
            return false;
          }
        }
        return true;
      },
      _ => {
        return false;
      },
    }
  }

  // A method of the view `Parallel<T>` (ADR-0039): `map`, `filter`, `reduce`, `some`, `every`, `find`, `findIndex` and
  // `toArray`, calls of `parMap`, `parFilter`, ... of the parallel prelude with the view as first argument. The rules
  // on the closures (pure literals, associative reducers) are checked on the whole program (parallel.or).
  private parMethodCall(
    b: HExpr,
    span: Span,
    name: Ident,
    args: Expr[],
    exp: Option<Type>,
  ): Result<HExpr, Diagnostic> {
    const n = name.name;
    const noMethod = diag(
      "E0405",
      name.span,
      "no method `" + n + "` on type `" + showType(this.fx.env, b.ty)
          + "` (a parallel view has map, filter, reduce, some, every, find, findIndex and toArray)",
    );
    const fname = parFnName(n);
    if (fname == "") {
      return Err(noMethod);
    }
    return this.preludeCall(
      b, span, this.fx.env.parUnit.unwrap(), fname, n, noMethod, args, noPre(args.length), exp, None,
    );
  }

  // Call of the prelude function `fname` of unit `unit` with the checked receiver `b` as first argument and
  // `args` as the others (`argPre[i]` may hold an already checked argument). Generic functions get their type
  // arguments inferred; non-generic ones are called directly.
  private preludeCall(
    b: HExpr,
    span: Span,
    unit: usize,
    fname: string,
    n: string,
    noMethod: Diagnostic,
    args: Expr[],
    argPre: Option<HExpr>[],
    exp: Option<Type>,
    argTy: Option<Type>,
  ): Result<HExpr, Diagnostic> {
    const ent = findVal(this.fx.env.units[unit].scope, fname);
    if (ent.isNone()) {
      return Err(noMethod);
    }
    match (ent.unwrap()) {
      VGFunc(g) => {
        const gf = this.fx.env.gfuncs[g];
        if (args.length + 1 != gf.decl.params.length) {
          return Err(
            diag(
              "E0404",
              span,
              "method `" + n + "` expects " + (gf.decl.params.length - 1).toString()
                  + " argument(s), found " + args.length.toString(),
            ),
          );
        }
        let ptes: TypeExpr[] = [];
        for (const p of gf.decl.params) {
          ptes.push(p.ty);
        }
        // The receiver is argument 0 (already checked; its source expression is not used).
        let all: Expr[] = [Expr { kind: EIdent(Ident { name: n, span: span }), span: b.span }];
        let pre: Option<HExpr>[] = [Some(b)];
        let ai: usize = 0;
        for (const a of args) {
          all.push(a);
          pre.push(argPre[ai]);
          ai += 1;
        }
        const noExplicit: Option<TypeExpr[]> = None;
        const io = this.inferPre(
          span,
          "method `" + n + "`",
          gf.unit,
          gf.decl.typeParams,
          ptes,
          gf.decl.ret,
          all,
          exp,
          noExplicit,
          pre,
          [],
        )?;
        let ret: Type = TyVoid;
        match (gf.decl.ret) {
          Some(rte) => {
            ret = this.resolveBound(gf.unit, paramNameList(gf.decl.typeParams), io.tys, rte, true)?;
          },
          None => {},
        }
        let fid: usize = 0;
        if (!this.fx.abs) {
          const fo = instFunc(this.fx.env, g, io.tys, this.fx.depth + 1, span)?;
          this.fx.adopt(fo.env);
          fid = fo.fid;
        }
        return Ok(mk(XCall(fid, io.args), ret, span));
      },
      VFunc(fid) => {
        const f = this.fx.env.funcs[fid];
        // the helpers of a type class serve every integer type of that class: the argument has the element type
        const ptys: Type[] = argTy.isSome() ? [argTy.unwrap()] : tailTypes(f.params);
        const a = this.argsExpect(span, "method `" + n + "`", args, ptys)?;
        let all: HExpr[] = [b];
        for (const x of a) {
          all.push(x);
        }
        return Ok(mk(XCall(fid, all), f.ret, span));
      },
      _ => {
        return Err(noMethod);
      },
    }
  }

  // ---------------------------------------------------------------------------
  // Map<K, V> (spec 08 std:map, ADR-0018): methods are functions of the Map prelude (library/collections/map.or).
  // ---------------------------------------------------------------------------

  // Instance of the generic Map-prelude function `fname` at `tys` (a dummy id in an abstract check).
  @Ensures(result.isOk() ==> this.fx.abs || result.unwrap() < this.fx.env.funcs.length)
  private mapFunc(span: Span, fname: string, tys: Type[]): Result<usize, Diagnostic> {
    if (this.fx.abs) {
      return Ok(0);
    }
    const ent = findVal(this.fx.env.units[this.fx.env.mapUnit.unwrap()].scope, fname);
    if (ent.isSome()) {
      match (ent.unwrap()) {
        VGFunc(g) => {
          const fo = instFunc(this.fx.env, g, tys, this.fx.depth + 1, span)?;
          this.fx.adopt(fo.env);
          return Ok(fo.fid);
        },
        _ => {},
      }
    }
    return Err(
      diag("E0405", span, "internal error: the Map prelude has no function `" + fname + "`"),
    );
  }

  // `new Map<K, V>()`; the type arguments may be omitted when the expected type is a Map.
  @Ensures(result.isOk() ==> mapOrigin(this.fx.env, result.unwrap().ty).isSome())
  private newMap(
    span: Span,
    targs: TypeExpr[],
    args: Expr[],
    exp: Option<Type>,
  ): Result<HExpr, Diagnostic> {
    if (args.length != 0) {
      return Err(
        diag("E0404", span, "`new Map` takes no arguments, found " + args.length.toString()),
      );
    }
    let kt: Type = TyVoid;
    let vt: Type = TyVoid;
    if (targs.length == 2) {
      kt = this.resolve(targs[0], false)?;
      vt = this.resolve(targs[1], false)?;
    } else if (targs.length == 0) {
      let found = false;
      match (exp) {
        Some(t) => {
          const mo = mapOrigin(this.fx.env, t);
          if (mo.isSome()) {
            kt = mo.unwrap().args[0];
            vt = mo.unwrap().args[1];
            found = true;
          }
        },
        None => {},
      }
      if (!found) {
        return Err(
          diag(
            "E0407",
            span,
            "cannot infer the type arguments of `new Map()`; write `new Map<K, V>()` or add a type annotation",
          ),
        );
      }
    } else {
      return Err(diag("E0400", span, "`Map` takes exactly two type arguments"));
    }
    const keyBad = mapKeyError(this.fx.env, kt, true, span);
    if (keyBad.isSome()) {
      return Err(keyBad.unwrap());
    }
    const gm = mapGenType(this.fx.env, "Map").unwrap();
    const inst = instType(this.fx.env, gm, [kt, vt], 0, span)?;
    this.fx.adopt(inst.env);
    const fid = this.mapFunc(span, "mapNew", [kt, vt])?;
    return Ok(mk(XCall(fid, noExprs()), inst.ty, span));
  }

  private mapMethodCall(
    b: HExpr,
    span: Span,
    base: Expr,
    name: Ident,
    args: Expr[],
    exp: Option<Type>,
    inst: Inst,
  ): Result<HExpr, Diagnostic> {
    const n = name.name;
    const unit = this.fx.env.mapUnit.unwrap();
    const noMethod = diag(
      "E0405",
      name.span,
      "no method `" + n + "` on type `" + showType(this.fx.env, b.ty) + "`",
    );
    const fname = mapReadFn(n);
    if (fname != "") {
      const noTy: Option<Type> = None;
      return this.preludeCall(
        b,
        span,
        unit,
        fname,
        n,
        noMethod,
        args,
        noPre(args.length),
        exp,
        noTy,
      );
    }
    if (n == "set" || n == "delete") {
      return this.mapMutCall(b, span, base, name, args, inst);
    }
    return Err(noMethod);
  }

  // `m.set(k, v)` / `m.delete(k)`: the receiver is a mutable place; the call becomes `m = mapSet(m, k, v)`
  // (a statement hoisted before the current one, like mutating class methods, ADR-0009).
  @Ensures(result.isOk() && !this.fx.probe ==> this.fx.pre.length > old(this.fx.pre.length))
  private mapMutCall(
    b: HExpr,
    span: Span,
    base: Expr,
    name: Ident,
    args: Expr[],
    inst: Inst,
  ): Result<HExpr, Diagnostic> {
    const n = name.name;
    const isSet = n == "set";
    const kt = inst.args[0];
    const vt = inst.args[1];
    const params: Type[] = isSet ? [kt, vt] : [kt];
    if (!this.isPlaceShaped(base)) {
      return Err(
        diag(
          "E0401",
          base.span,
          "receiver of `" + n + "` must be a mutable place (a `let` variable, field or element)",
        ),
      );
    }
    const pi = this.placeOf(base)?;
    if (!pi.mutable) {
      return Err(
        diag(
          "E0401",
          base.span,
          "cannot call `" + n + "` on `" + pi.rootName + "`: it is not declared with `let`",
        ),
      );
    }
    this.fx.markMut(pi.place);
    const a = this.argsExpect(span, "method `" + n + "`", args, params)?;
    if (this.fx.probe) {
      if (isSet) {
        return Ok(nopExpr(span));
      }
      return Ok(mk(XBool(false), TyBool, span));
    }
    if (!purePlace(pi.place)) {
      return Err(
        diag(
          "E0408",
          base.span,
          "the receiver of `" + n + "` must not contain index expressions with side effects",
        ),
      );
    }
    const mapTy = b.ty;
    const kv: Type[] = [kt, vt];
    if (isSet) {
      const fid = this.mapFunc(span, "mapSet", kv)?;
      const call = mk(XCall(fid, [b, a[0], a[1]]), mapTy, span);
      this.fx.hoist(HAssign(pi.place, None, call));
      return Ok(nopExpr(span));
    }
    // delete: the key is evaluated once into a temporary; the result is `has` taken before the removal.
    const hasF = this.mapFunc(span, "mapHas", kv)?;
    const delF = this.mapFunc(span, "mapDelete", kv)?;
    const kid = this.fx.newTemp("$k", kt);
    const rid = this.fx.newTemp("$r", TyBool);
    const kx = mk(XLocal(kid), kt, span);
    this.fx.hoist(HLet(kid, a[0]));
    this.fx.hoist(HLet(rid, mk(XCall(hasF, [b, kx]), TyBool, span)));
    this.fx.hoist(HAssign(pi.place, None, mk(XCall(delF, [b, kx]), mapTy, span)));
    return Ok(mk(XLocal(rid), TyBool, span));
  }
}
