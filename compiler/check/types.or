// Type resolution, generic instantiation (monomorphization of types and function signatures)
// and type-argument unification. Beyond Orin-B: see docs/decisions/0007-generics-monomorphization.md.
//
// Type expressions are resolved in a `TScope`: the unit whose names are visible plus the
// bindings of the enclosing generic declaration's type parameters. Resolving a generic type
// application creates (or finds) a concrete record / union instance in the environment, so
// resolution returns the possibly grown `Env` together with the type.

import { Span, Diagnostic, diag } from "../diag";
import {
  Ident, TypeExpr, TNamed, TArray, TFn, TypeDeclBody, DAlias, DRecord, DUnion, FunctionDecl,
  FieldDecl, VariantDecl,
} from "../syntax";
import { Type, FieldDef, RecordDef, UnionDef, VariantDef, Local } from "../hir";
import { intNamed, is128, classSuffix } from "./ints";
import { classOfGeneric, checkClassBounds, mapKeyError } from "./classes";
import { hasResource, resourceNested } from "./resources";
import {
  Env, FuncInfo, Inst, EntRecord, EntUnion, EntAlias, EntGen, EntIface, EntBuiltin, findType,
  findInst, originOf, isVoid, tysKey, mapGenType, isMapKeyType, showType, addBound, boundsOf,
  isWellFormedEnv, typeEq, typeInRange, typesInRange, InstKind, IkRecord, IkUnion, IkFunction,
  isOrdinaryMode, isCtorMode, isMutVoidMode, isMutRetMode,
} from "./env";

export const CYCLE_MSG: string = "type alias is defined in terms of itself";
export const MAX_DEPTH: usize = 32;

// E0450 (ADR-0025): a resource type (`File`) cannot be part of another type.
export function resourceIn(span: Span, what: string): Diagnostic {
  return diag(
    "E0450",
    span,
    `a resource type cannot be ${what}; a resource handle can only be a parameter (borrowed)`,
  );
}

// The scope type expressions are resolved in: the unit whose names are visible, the type parameters
// of the enclosing generic declaration with the types they stand for (parallel arrays), and how deeply
// generic instantiations are nested (bounded by MAX_DEPTH). A program with a duplicate type parameter is
// reported (E0304) but still reaches the resolver, so the names are not required to be distinct.
@Invariant(this.names.length == this.tys.length)
export class TScope {
  unit: usize;
  names: string[];
  tys: Type[];
  depth: usize;

  @Requires(names.length == tys.length)
  constructor(unit: usize, names: string[], tys: Type[], depth: usize) {
    this.unit = unit;
    this.names = names;
    this.tys = tys;
    this.depth = depth;
  }
}

export type TyOut = { env: Env; ty: Type; };
export type TysOut = { env: Env; tys: Type[]; };
export type SigOut = { env: Env; params: Type[]; locals: Local[]; ret: Type; };
export type FuncOut = { env: Env; fid: usize; };

@Requires(names.length == tys.length)
@Ensures(result.depth == 0 && result.unit == unit)
export function scopeOf(unit: usize, names: string[], tys: Type[]): TScope {
  return new TScope(unit, names, tys, 0);
}

@Ensures(result.names.length == 0 && result.tys.length == 0)
export function plainScope(unit: usize): TScope {
  return new TScope(unit, [], [], 0);
}

@Ensures(result.isSome() ==> result.unwrap() < names.length && names[result.unwrap()] == n)
@Ensures(result.isNone() ==> !names.includes(n))
export function indexOfName(names: string[], n: string): Option<usize> {
  return names.indexOf(n);
}

function inStack(stack: int[], k: int): bool {
  return stack.includes(k);
}

// A resolution result is sound: the type refers only to records / unions / interfaces of its
// environment, and the environment is well-formed (the instance table fits its tables).
export function resolvedOk(r: Result<TyOut, Diagnostic>): bool {
  return match (r) {
    Ok(o) => typeInRange(o.env, o.ty) && isWellFormedEnv(o.env),
    Err(_) => true,
  };
}

// A resolved signature is sound: one parameter type and one local per declared parameter, all
// types inside the returned environment.
export function sigOk(decl: FunctionDecl, r: Result<SigOut, Diagnostic>): bool {
  return match (r) {
    Ok(o) => o.params.length == decl.params.length
        && o.locals.length == decl.params.length
        && typesInRange(o.env, o.params)
        && typeInRange(o.env, o.ret)
        && isWellFormedEnv(o.env),
    Err(_) => true,
  };
}

// An instantiated function is sound: its id is inside the function table, the instance is
// registered (found again by its generic and arguments), and its type arguments are the ones asked for.
export function funcOutOk(g: usize, args: Type[], r: Result<FuncOut, Diagnostic>): bool {
  return match (r) {
    Ok(o) => o.fid < o.env.funcs.length && isWellFormedEnv(o.env),
    Err(_) => true,
  };
}

// Every entry of `binds` that was bound stays bound (and unchanged) in `after`.
@Ensures(result ==> before.length == after.length)
export function bindsKept(before: Option<Type>[], after: Option<Type>[]): bool {
  if (before.length != after.length) {
    return false;
  }
  let i: usize = 0;
  while (i < before.length) {
    if (before[i].isSome()
        && (after[i].isNone() || !typeEq(before[i].unwrap(), after[i].unwrap()))) {
      return false;
    }
    i += 1;
  }
  return true;
}

// Nothing is bound.
@Ensures(result == binds.every(b => b.isNone()))
export function allUnbound(binds: Option<Type>[]): bool {
  return binds.every(b => b.isNone());
}

function ok(env: Env, ty: Type): Result<TyOut, Diagnostic> {
  return Ok(TyOut { env: env, ty: ty });
}

function depthErr(span: Span, what: string): Diagnostic {
  return diag(
    "E0413",
    span,
    `generic instantiation limit exceeded: ${what} nests deeper than ${MAX_DEPTH} (polymorphic recursion?)`,
  );
}

// ---------------------------------------------------------------------------
// Resolution
// ---------------------------------------------------------------------------

// `stack` holds the aliases currently being expanded (cycle detection): a plain alias index, or
// -(generic id) - 1 for a generic alias.
@Requires(idx < env.aliases.length && isWellFormedEnv(env))
@Ensures(resolvedOk(result))
export function aliasType(env: Env, idx: usize, stack: int[]): Result<TyOut, Diagnostic> {
  const a = env.aliases[idx];
  const key = idx.toInt();
  if (inStack(stack, key)) {
    return Err(diag("E0400", a.target.span, CYCLE_MSG));
  }
  let st = stack;
  st.push(key);
  return resolveTy(env, plainScope(a.unit), a.target, false, st);
}

@Requires(sc.unit < env.units.length && isWellFormedEnv(env))
@Ensures(resolvedOk(result))
export function resolveTy(
  env: Env,
  sc: TScope,
  te: TypeExpr,
  voidOk: bool,
  stack: int[],
): Result<TyOut, Diagnostic> {
  return match (te.kind) {
    TArray(inner) => {
      const r = resolveTy(env, sc, inner, true, stack)?;
      if (hasResource(r.ty)) {
        return Err(resourceIn(te.span, "an array element"));
      }
      return ok(r.env, TyArray(r.ty));
    },
    TNamed(name, args) => resolveNamed(env, sc, te, name, args, voidOk, stack),
    TFn(ps, ret) => {
      let cur = env;
      let tys: Type[] = [];
      for (const p of ps) {
        const r = resolveTy(cur, sc, p.ty, false, stack)?;
        cur = r.env;
        tys.push(r.ty);
      }
      const rr = resolveTy(cur, sc, ret, true, stack)?;
      if (hasResource(rr.ty)) {
        return Err(resourceIn(te.span, "the result of a function type"));
      }
      return ok(rr.env, TyFn(tys, rr.ty));
    },
  };
}

@Requires(sc.unit < env.units.length && isWellFormedEnv(env))
@Ensures(resolvedOk(result))
export function resolveType(
  env: Env,
  sc: TScope,
  te: TypeExpr,
  voidOk: bool,
): Result<TyOut, Diagnostic> {
  const stack: int[] = [];
  return resolveTy(env, sc, te, voidOk, stack);
}

function resolveNamed(
  env: Env,
  sc: TScope,
  te: TypeExpr,
  name: Ident,
  args: TypeExpr[],
  voidOk: bool,
  stack: int[],
): Result<TyOut, Diagnostic> {
  const n = name.name;
  if (args.length == 0) {
    const k = indexOfName(sc.names, n);
    if (k.isSome()) {
      return ok(env, sc.tys[k.unwrap()]);
    }
  }
  if (is128(n) && findType(env.units[sc.unit].scope, n).isNone()) {
    return Err(
      diag(
        "E0431",
        te.span,
        `the 128-bit integer type \`${n}\` is not supported yet (ADR-0022); use \`i64\` / \`u64\``,
      ),
    );
  }
  let b: Option<Type> = intNamed(n);
  if (b.isSome()) {
    // an integer type
  } else if (n == "bool") {
    b = Some(TyBool);
  } else if (n == "float") {
    b = Some(TyFloat);
  } else if (n == "f32") {
    b = Some(TyF32);
  } else if (n == "string") {
    b = Some(TyString);
  } else if (n == "void") {
    b = Some(TyVoid);
  }
  if (b.isSome()) {
    const bt = b.unwrap();
    if (args.length > 0) {
      return Err(diag("E0400", te.span, `type \`${n}\` takes no type arguments`));
    }
    if (isVoid(bt) && !voidOk) {
      return Err(
        diag(
          "E0400",
          te.span,
          "`void` is only allowed as a return type or as a type argument (`Result<void, E>`, `Option<void>`, `Box<void>`, `void[]`)",
        ),
      );
    }
    return ok(env, bt);
  }
  if (n == "Option") {
    if (args.length != 1) {
      return Err(diag("E0400", te.span, "`Option` takes exactly one type argument"));
    }
    const t = resolveTy(env, sc, args[0], true, stack)?;
    if (hasResource(t.ty)) {
      return Err(resourceIn(te.span, "the type argument of `Option`"));
    }
    return ok(t.env, TyOption(t.ty));
  }
  if (n == "Result") {
    if (args.length != 2) {
      return Err(diag("E0400", te.span, "`Result` takes exactly two type arguments"));
    }
    const t = resolveTy(env, sc, args[0], true, stack)?;
    const e = resolveTy(t.env, sc, args[1], false, stack)?;
    if (hasResource(t.ty) || hasResource(e.ty)) {
      return Err(resourceIn(te.span, "a type argument of `Result`"));
    }
    return ok(e.env, TyResult(t.ty, e.ty));
  }
  const found = findType(env.units[sc.unit].scope, n);
  if (found.isNone()) {
    if (n == "Map" || n == "MapEntry") {
      const mg = mapGenType(env, n);
      if (mg.isSome()) {
        return resolveMapType(env, sc, te, name, mg.unwrap(), args, stack);
      }
    }
    let d = diag("E0300", name.span, `unknown type \`${n}\``);
    if (n == "number") {
      d.notes.push("use `int` (64-bit integer) or `float`");
    } else if (n == "any") {
      d.notes.push("Orin has no `any`; use a concrete type or a generic `T`");
    } else if (n == "boolean") {
      d.notes.push("use `bool`");
    } else if (n == "Promise") {
      d.notes.push("there is no async/await in Orin; see std:task");
    }
    return Err(d);
  }
  return match (found.unwrap()) {
    EntRecord(r) => {
      if (args.length > 0) {
        return Err(diag("E0400", te.span, `type \`${n}\` takes no type arguments`));
      }
      return ok(env, TyRecord(r));
    },
    EntUnion(u) => {
      if (args.length > 0) {
        return Err(diag("E0400", te.span, `type \`${n}\` takes no type arguments`));
      }
      return ok(env, TyUnion(u));
    },
    EntAlias(i) => {
      if (args.length > 0) {
        return Err(diag("E0400", te.span, `type \`${n}\` takes no type arguments`));
      }
      return aliasType(env, i, stack);
    },
    EntGen(g) => resolveGeneric(env, sc, te, name, g, args, stack),
    EntIface(i) => {
      if (args.length > 0) {
        return Err(
          diag("E0408", te.span, "generic interfaces are not supported in Orin 1.0 (ADR-0019)"),
        );
      }
      return ok(env, TyIface(i));
    },
    EntBuiltin(t) => {
      if (args.length > 0) {
        return Err(diag("E0400", te.span, `type \`${n}\` takes no type arguments`));
      }
      return ok(env, t);
    },
  };
}

// `Map<K, V>` / `MapEntry<K, V>` written in user code (ADR-0018): the generic records of the Map prelude;
// the key type of a Map must be `Hash` (ADR-0034).
function resolveMapType(
  env: Env,
  sc: TScope,
  te: TypeExpr,
  name: Ident,
  g: usize,
  args: TypeExpr[],
  stack: int[],
): Result<TyOut, Diagnostic> {
  const r = resolveGeneric(env, sc, te, name, g, args, stack)?;
  if (name.name == "Map") {
    const o = originOf(r.env, r.ty);
    if (o.isSome() && o.unwrap().args.length > 0) {
      // ADR-0034: a key is any `Hash` type; records and unions are checked when a map is created (they may still be
      // incomplete while declarations are resolved)
      const bad = mapKeyError(r.env, o.unwrap().args[0], false, te.span);
      if (bad.isSome()) {
        return Err(bad.unwrap());
      }
    }
  }
  return Ok(r);
}

@Ensures(result.length == ps.length)
function paramNames(ps: Ident[]): string[] {
  return ps.map(p => p.name);
}

function resolveGeneric(
  env: Env,
  sc: TScope,
  te: TypeExpr,
  name: Ident,
  g: usize,
  args: TypeExpr[],
  stack: int[],
): Result<TyOut, Diagnostic> {
  const gt = env.gtypes[g];
  const params = gt.decl.typeParams;
  if (args.length != params.length) {
    return Err(
      diag(
        "E0400",
        te.span,
        `type \`${name.name}\` expects ${params.length} type argument(s), found ${args.length}`,
      ),
    );
  }
  let cur = env;
  let tys: Type[] = [];
  for (const a of args) {
    const r = resolveTy(cur, sc, a, true, stack)?;
    cur = r.env;
    if (hasResource(r.ty)) {
      return Err(resourceIn(a.span, `a type argument of \`${name.name}\``));
    }
    tys.push(r.ty);
  }
  return match (gt.decl.body) {
    DAlias(target) => {
      const key = 0 - g.toInt() - 1;
      if (inStack(stack, key)) {
        return Err(diag("E0400", te.span, CYCLE_MSG));
      }
      if (sc.depth + 1 > MAX_DEPTH) {
        return Err(depthErr(te.span, `alias \`${name.name}\``));
      }
      let st = stack;
      st.push(key);
      const sc2 = new TScope(gt.unit, paramNames(params), tys, sc.depth + 1);
      return resolveTy(cur, sc2, target, false, st);
    },
    _ => instType(cur, g, tys, sc.depth, te.span),
  };
}

// The record / union instance of generic type `g` at `args`, created on first use. The instance
// is registered before its fields are resolved so recursive types terminate.
@Requires(g < env.gtypes.length && isWellFormedEnv(env))
@Requires(args.length == env.gtypes[g].decl.typeParams.length && typesInRange(env, args))
@Ensures(resolvedOk(result))
@Ensures(match (result) {
  Ok(o) => originOf(o.env, o.ty).isSome() && originOf(o.env, o.ty).unwrap().gid == g,
  Err(_) => true,
})
export function instType(
  env: Env,
  g: usize,
  args: Type[],
  depth: usize,
  span: Span,
): Result<TyOut, Diagnostic> {
  for (const a of args) {
    if (hasResource(a)) {
      return Err(
        resourceIn(span, "a type argument of a generic type (it was inferred as a resource)"),
      );
    }
  }
  const gt = env.gtypes[g];
  const isRec = match (gt.decl.body) {
    DRecord(_) => true,
    _ => false,
  };
  const kind: InstKind = isRec ? IkRecord : IkUnion;
  const old = findInst(env, kind, g, args);
  if (old.isSome()) {
    const i = old.unwrap();
    return ok(env, isRec ? TyRecord(i.id) : TyUnion(i.id));
  }
  if (isRec) {
    // A generic class with bounded type parameters (ADR-0026): the arguments must satisfy them.
    const gc = classOfGeneric(env, g);
    if (gc.isSome()) {
      match (checkClassBounds(env, gc.unwrap(), args, span)) {
        Some(d) => {
          return Err(d);
        },
        None => {},
      }
    }
  }
  if (depth + 1 > MAX_DEPTH) {
    return Err(depthErr(span, `type \`${gt.decl.name.name}\``));
  }
  const name = `${gt.qname}<${tysKey(env, args)}>`;
  const sc2 = new TScope(gt.unit, paramNames(gt.decl.typeParams), args, depth + 1);
  let e = env;
  return match (gt.decl.body) {
    DRecord(fields) => {
      const id = e.records.length;
      const none: FieldDef[] = [];
      e.records.push(RecordDef { name: name, fields: none });
      e.insts.add(Inst { kind: IkRecord, gid: g, args: args, id: id, depth: depth });
      let out: FieldDef[] = [];
      for (const f of fields) {
        for (const o of out) {
          if (o.name == f.name.name) {
            return Err(diag("E0304", f.name.span, `duplicate field \`${f.name.name}\``));
          }
        }
        const r = resolveType(e, sc2, f.ty, false)?;
        e = r.env;
        out.push(FieldDef { name: f.name.name, ty: r.ty });
      }
      e.records[id] = RecordDef { name: name, fields: out };
      return ok(e, TyRecord(id));
    },
    DUnion(vs) => {
      const id = e.unions.length;
      const none: VariantDef[] = [];
      e.unions.push(UnionDef { name: name, variants: none });
      e.insts.add(Inst { kind: IkUnion, gid: g, args: args, id: id, depth: depth });
      let out: VariantDef[] = [];
      for (const v of vs) {
        let payload: Type[] = [];
        for (const te of v.payload) {
          const r = resolveType(e, sc2, te, false)?;
          e = r.env;
          payload.push(r.ty);
        }
        out.push(VariantDef { name: v.name.name, payload: payload });
      }
      e.unions[id] = UnionDef { name: name, variants: out };
      return ok(e, TyUnion(id));
    },
    DAlias(_) => Err(
      diag("E0400", span, `type alias \`${gt.decl.name.name}\` cannot be instantiated here`),
    ),
  };
}

// A fresh opaque type for an abstract check: a field-less record named after the parameter.
// Nothing can be done with a value of such a type except bind, pass, return and store it.
@Ensures(match (result.ty) {
  TyRecord(r) => r == env.records.length && result.env.records.length == env.records.length + 1,
  _ => false,
})
export function mkOpaque(env: Env, name: string): TyOut {
  let e = env;
  const id = e.records.length;
  const none: FieldDef[] = [];
  e.records.push(RecordDef { name: name, fields: none });
  return TyOut { env: e, ty: TyRecord(id) };
}

// An opaque type bounded by the interfaces `ifaces` (`T extends I`, ADR-0019; `T extends I & J`, several bounds): it
// additionally supports the methods of each of them and converts to each of them.
export function mkOpaqueBound(env: Env, name: string, ifaces: usize[]): TyOut {
  const o = mkOpaque(env, name);
  const rid = match (o.ty) {
    TyRecord(r) => r,
    _ => 0,
  };
  let e = o.env;
  for (const i of ifaces) {
    e = addBound(e, rid, i);
  }
  return TyOut { env: e, ty: o.ty };
}

// ---------------------------------------------------------------------------
// Function signatures and instances
// ---------------------------------------------------------------------------

@Requires(sc.unit < env.units.length && isWellFormedEnv(env))
@Ensures(sigOk(decl, result))
export function resolveSig(env: Env, sc: TScope, decl: FunctionDecl): Result<SigOut, Diagnostic> {
  let cur = env;
  let params: Type[] = [];
  let locals: Local[] = [];
  for (const p of decl.params) {
    for (const l of locals) {
      if (l.name == p.name.name) {
        return Err(diag("E0304", p.name.span, `duplicate parameter \`${p.name.name}\``));
      }
    }
    const r = resolveType(cur, sc, p.ty, false)?;
    cur = r.env;
    locals.push(Local { name: p.name.name, ty: r.ty, mutable: false });
    params.push(r.ty);
  }
  let ret: Type = TyVoid;
  match (decl.ret) {
    Some(te) => {
      const r = resolveType(cur, sc, te, true)?;
      if (hasResource(r.ty)) {
        return Err(
          diag(
            "E0450",
            te.span,
            "a function cannot return a resource; a resource handle can only be passed to functions (borrowed)",
          ),
        );
      }
      cur = r.env;
      ret = r.ty;
    },
    None => {},
  }
  return Ok(SigOut { env: cur, params: params, locals: locals, ret: ret });
}

// The function instance of generic function `g` at `args` (new function id on first use).
// `depth` is the instantiation depth of the *new* instance.
// `keyHash<K>` / `keyEq<K>` of the Map prelude (library/collections/map.or) are replaced by the function of the key class
// (`hashInt`, `eqString`, ...): a generic body cannot hash or compare a `K` itself (ADR-0018).
@Ensures(result.isSome() ==> result.unwrap() < env.funcs.length)
function keyClassFunc(env: Env, qname: string, args: Type[]): Option<usize> {
  if (qname != "$array/map.keyHash" && qname != "$array/map.keyEq" || args.length != 1) {
    return None;
  }
  let suffix = classSuffix(args[0]);
  if (suffix == "") {
    suffix = match (args[0]) {
      TyBool => "Bool",
      TyString => "String",
      _ => "",
    };
  }
  if (suffix == "") {
    return None;
  }
  const target = `${qname == "$array/map.keyHash" ? "$array/map.hash" : "$array/map.eq"}${suffix}`;
  let i: usize = 0;
  while (i < env.funcs.length) {
    if (env.funcs[i].qname == target) {
      return Some(i);
    }
    i += 1;
  }
  return None;
}

@Requires(g < env.gfuncs.length && isWellFormedEnv(env) && typesInRange(env, args))
@Ensures(funcOutOk(g, args, result))
export function instFunc(
  env: Env,
  g: usize,
  args: Type[],
  depth: usize,
  span: Span,
): Result<FuncOut, Diagnostic> {
  for (const a of args) {
    if (hasResource(a)) {
      return Err(
        resourceIn(
          span,
          "a type argument of a generic function (it was inferred as a resource; a callback or generic function cannot return or wrap a handle)",
        ),
      );
    }
  }
  const redirect = keyClassFunc(env, env.gfuncs[g].qname, args);
  if (redirect.isSome()) {
    return Ok(FuncOut { env: env, fid: redirect.unwrap() });
  }
  const old = findInst(env, IkFunction, g, args);
  if (old.isSome()) {
    return Ok(FuncOut { env: env, fid: old.unwrap().id });
  }
  if (depth > MAX_DEPTH) {
    return Err(depthErr(span, `function \`${env.gfuncs[g].decl.name.name}\``));
  }
  const gf = env.gfuncs[g];
  const names = paramNames(gf.decl.typeParams);
  const sc = new TScope(gf.unit, names, args, 0);
  const sig = resolveSig(env, sc, gf.decl)?;
  let e = sig.env;
  const id = e.funcs.length;
  const qname = `${gf.qname}<${tysKey(env, args)}>`;
  // The constructor and instance methods of a generic class (ADR-0026) are lowered like those of an
  // ordinary class (ADR-0009): FmCtor constructor, FmMethod non-mutating method, FmMutVoid mutating method
  // returning the updated receiver, FmMutRet mutating method with a result (a `$ret` record per instance).
  let ret = sig.ret;
  let srcRet: Type = TyVoid;
  if (!isOrdinaryMode(gf.mode) && !isCtorMode(gf.mode)) {
    srcRet = sig.ret;
  }
  if (isMutVoidMode(gf.mode)) {
    ret = sig.params[0];
  } else if (isMutRetMode(gf.mode)) {
    const rid = e.records.length;
    const fields: FieldDef[] = [
      FieldDef { name: "self", ty: sig.params[0] },
      FieldDef { name: "value", ty: sig.ret },
    ];
    e.records.push(RecordDef { name: `${qname}$ret`, fields: fields });
    ret = TyRecord(rid);
  }
  e.funcs.push(FuncInfo {
    unit: gf.unit,
    qname: qname,
    decl: gf.decl,
    params: sig.params,
    paramLocals: sig.locals,
    ret: ret,
    tpNames: names,
    tpTys: args,
    depth: depth,
    mode: gf.mode,
    cls: gf.cls,
    srcRet: srcRet,
  });
  e.insts.add(Inst { kind: IkFunction, gid: g, args: args, id: id, depth: depth });
  return Ok(FuncOut { env: e, fid: id });
}

// ---------------------------------------------------------------------------
// Unification of a callee's parameter type expressions with argument types
// ---------------------------------------------------------------------------

@Ensures(result.length == n && allUnbound(result))
export function noBinds(n: usize): Option<Type>[] {
  let out: Option<Type>[] = [];
  @Invariant(out.length <= n && out.every(b => b.isNone()))
  while (out.length < n) {
    out.push(None);
  }
  return out;
}

// Binds the type parameters `tp` mentioned in `te` by matching `te` against the concrete type
// `actual`. Mismatches are ignored here (the later type check reports them); the first binding
// of a parameter wins.
@Requires(tp.length == binds.length)
@Ensures(bindsKept(binds, result))
export function unify(
  env: Env,
  unit: usize,
  te: TypeExpr,
  actual: Type,
  tp: string[],
  binds: Option<Type>[],
): Option<Type>[] {
  return match (te.kind) {
    TArray(inner) => match (actual) {
      TyArray(a) => unify(env, unit, inner, a, tp, binds),
      _ => binds,
    },
    TNamed(name, args) => unifyNamed(env, unit, name, args, actual, tp, binds),
    TFn(ps, ret) => match (actual) {
      TyFn(aps, ar) => {
        let b = binds;
        if (aps.length == ps.length) {
          let i: usize = 0;
          while (i < ps.length) {
            b = unify(env, unit, ps[i].ty, aps[i], tp, b);
            i += 1;
          }
          b = unify(env, unit, ret, ar, tp, b);
        }
        return b;
      },
      _ => binds,
    },
  };
}

@Requires(tp.length == binds.length)
function unifyNamed(
  env: Env,
  unit: usize,
  name: Ident,
  args: TypeExpr[],
  actual: Type,
  tp: string[],
  binds: Option<Type>[],
): Option<Type>[] {
  const n = name.name;
  let b = binds;
  if (args.length == 0) {
    const k = indexOfName(tp, n);
    if (k.isSome()) {
      // `void` is bound like any type (ADR-0040): a nested position (`() => T` against a closure returning `void`,
      // `Option<T>`, `T[]`, ...) instantiates `T = void`. A bare `T` against a `void` argument or expectation is not an
      // instantiation (that is `Inference.learn`, which skips it): `void` as a value stays an error.
      const i = k.unwrap();
      match (b[i]) {
        None => {
          b[i] = Some(actual);
        },
        Some(_) => {},
      }
      return b;
    }
  }
  if (n == "Option" && args.length == 1) {
    return match (actual) {
      TyOption(a) => unify(env, unit, args[0], a, tp, b),
      _ => b,
    };
  }
  if (n == "Result" && args.length == 2) {
    return match (actual) {
      TyResult(x, y) => unify(env, unit, args[1], y, tp, unify(env, unit, args[0], x, tp, b)),
      _ => b,
    };
  }
  const found = findType(env.units[unit].scope, n);
  if (found.isNone()) {
    if (n == "Map" || n == "MapEntry") {
      const mg = mapGenType(env, n);
      if (mg.isSome()) {
        return unifyGeneric(env, unit, mg.unwrap(), args, actual, tp, b);
      }
    }
    return b;
  }
  return match (found.unwrap()) {
    EntGen(g) => unifyGeneric(env, unit, g, args, actual, tp, b),
    _ => b,
  };
}

@Requires(tp.length == binds.length && g < env.gtypes.length)
function unifyGeneric(
  env: Env,
  unit: usize,
  g: usize,
  args: TypeExpr[],
  actual: Type,
  tp: string[],
  binds: Option<Type>[],
): Option<Type>[] {
  const gt = env.gtypes[g];
  let b = binds;
  if (args.length != gt.decl.typeParams.length) {
    return b;
  }
  match (gt.decl.body) {
    DAlias(target) => {
      // Match the alias body against `actual` to learn the alias parameters, then match the
      // written arguments against those.
      const gp = paramNames(gt.decl.typeParams);
      const ab = unify(env, gt.unit, target, actual, gp, noBinds(gp.length));
      let i: usize = 0;
      @Invariant(b.length == tp.length)
      while (i < args.length) {
        match (ab[i]) {
          Some(t) => {
            b = unify(env, unit, args[i], t, tp, b);
          },
          None => {},
        }
        i += 1;
      }
    },
    _ => {
      const o = originOf(env, actual);
      if (o.isSome()) {
        const inst = o.unwrap();
        if (inst.gid == g) {
          let i: usize = 0;
          @Invariant(b.length == tp.length)
          while (i < args.length && i < inst.args.length) {
            b = unify(env, unit, args[i], inst.args[i], tp, b);
            i += 1;
          }
        }
      }
    },
  }
  return b;
}

// True if `te` mentions a type parameter of `tp` that is still unbound.
@Requires(tp.length == binds.length)
export function mentionsUnbound(te: TypeExpr, tp: string[], binds: Option<Type>[]): bool {
  return match (te.kind) {
    TArray(inner) => mentionsUnbound(inner, tp, binds),
    TFn(ps, ret) => {
      for (const p of ps) {
        if (mentionsUnbound(p.ty, tp, binds)) {
          return true;
        }
      }
      return mentionsUnbound(ret, tp, binds);
    },
    TNamed(name, args) => {
      if (args.length == 0) {
        const k = indexOfName(tp, name.name);
        if (k.isSome()) {
          return binds[k.unwrap()].isNone();
        }
      }
      for (const a of args) {
        if (mentionsUnbound(a, tp, binds)) {
          return true;
        }
      }
      return false;
    },
  };
}
