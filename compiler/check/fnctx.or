// Per-function checking context (class `FnCtx`): locals, scope stack, loop stack, hoisted statements,
// captures. It is the state of one `ExprChecker` (expr.or); values are copy-on-write, so a snapshot
// (`const saved = fx`) is cheap and restoring it undoes a failed trial check.

import { Diagnostic, diag } from "../diag";
import { range } from "std:seq";
import { Ident } from "../syntax";
import { Type, Local, HStmt, HExpr, Place } from "../hir";
import {
  FuncInfo, Env, typeEq, FnMode, FmOrdinary, ContractMode, CmCode, sameContractMode, isOrdinaryMode,
  isClassMode, isNamespaceName, nsShadowErr,
} from "./env";
import { MAX_DEPTH } from "./types";

// What a visible name is bound to: the local's id and the scope level it was declared at.
export type Bind = { id: usize; level: usize; };
// What a declaration shadowed (`prev`), so that closing its scope can restore it.
export type Shadowed = { name: string; prev: Option<Bind>; };

// The open scopes' start positions never decrease and lie inside the log.
@Ensures(result == (marks.every(m => m <= logLen) && range(1, marks.length).every(i => marks[i - 1] <= marks[i])))
function marksOrdered(marks: usize[], logLen: usize): bool {
  let prev: usize = 0;
  for (const m of marks) {
    if (m < prev || m > logLen) {
      return false;
    }
    prev = m;
  }
  return true;
}

// The visible local names of one function body: a stack of lexical scopes over a hash table, so a
// lookup is O(1) however deep the nesting. `vis` maps a visible name to its binding; `log` remembers
// what every declaration shadowed, so closing a scope restores the outer binding; `marks` holds the
// log length at the opening of each open scope (the first one, the parameters' scope, starts at 0).
@Invariant(marksOrdered(this.marks, this.log.length))
@Invariant(this.vis.size <= this.log.length)
export class Scope {
  private vis: Map<string, Bind> = new Map<string, Bind>();
  private log: Shadowed[] = [];
  private marks: usize[] = [0];

  // Number of open scopes.
  @Ensures(result == this.marks.length)
  depth(): usize {
    return this.marks.length;
  }

  @Ensures(this.depth() == old(this.depth()) + 1)
  open(): void {
    this.marks.push(this.log.length);
  }

  // Closes the innermost scope and forgets its names; with no scope open it forgets every name.
  @Ensures(old(this.depth()) > 0 ? this.depth() + 1 == old(this.depth()) : this.depth() == 0)
  close(): void {
    const k = this.marks.pop().unwrapOr(0);
    while (this.log.length > k) {
      const u = this.log.pop().unwrap();
      match (u.prev) {
        Some(b) => {
          this.vis.set(u.name, b);
        },
        None => {
          this.vis.delete(u.name);
        },
      }
    }
  }

  // Binds `name` in the innermost scope; a binding of the same name (in this or an outer scope) is
  // shadowed until this scope closes.
  @Ensures(this.depth() == old(this.depth()))
  @Ensures(this.lookup(name).isSome() && this.lookup(name).unwrap() == id)
  @Ensures(this.inInnermost(name))
  bind(name: string, id: usize): void {
    this.log.push(Shadowed { name: name, prev: this.vis.get(name) });
    this.vis.set(name, Bind { id: id, level: this.marks.length });
  }

  @Ensures(result.isSome() == this.vis.has(name))
  @Ensures(result.isSome() ==> result.unwrap() == this.vis.get(name).unwrap().id)
  lookup(name: string): Option<usize> {
    const b = this.vis.get(name);
    return b.isSome() ? Some(b.unwrap().id) : None;
  }

  // True if `name` is declared in the innermost scope.
  @Ensures(result ==> this.lookup(name).isSome())
  @Ensures(result == (this.vis.has(name) && this.vis.get(name).unwrap().level == this.marks.length))
  inInnermost(name: string): bool {
    const b = this.vis.get(name);
    return b.isSome() && b.unwrap().level == this.marks.length;
  }
}

// All distinct (no value occurs twice).
@Ensures(result == range(0, xs.length).every(i => range(0, i).every(j => xs[i] != xs[j])))
function distinctStrings(xs: string[]): bool {
  let i: usize = 0;
  @Invariant(i <= xs.length && range(0, i).every(a => range(0, a).every(b => xs[a] != xs[b])))
  while (i < xs.length) {
    let j: usize = 0;
    @Invariant(j <= i && range(0, j).every(b => xs[i] != xs[b]))
    while (j < i) {
      if (xs[i] == xs[j]) {
        return false;
      }
      j += 1;
    }
    i += 1;
  }
  return true;
}

@Ensures(result == range(0, xs.length).every(i => range(0, i).every(j => xs[i] != xs[j])))
function distinctUsizes(xs: usize[]): bool {
  let i: usize = 0;
  @Invariant(i <= xs.length && range(0, i).every(a => range(0, a).every(b => xs[a] != xs[b])))
  while (i < xs.length) {
    let j: usize = 0;
    @Invariant(j <= i && range(0, j).every(b => xs[i] != xs[b]))
    while (j < i) {
      if (xs[i] == xs[j]) {
        return false;
      }
      j += 1;
    }
    i += 1;
  }
  return true;
}

// The variables an arrow function captured from its enclosing functions (ADR-0011): per capture its name,
// its type and the id of the fresh local that holds it, in the order of first use (that is the field
// order of the closure's environment record). The three arrays are parallel, and a variable is captured
// once: a second use finds the first capture. The arrays are read by the closure lowering; only `add`
// may grow them.
@Invariant(this.names.length == this.tys.length && this.names.length == this.ids.length)
@Invariant(distinctStrings(this.names) && distinctUsizes(this.ids))
export class Captures {
  names: string[] = [];
  tys: Type[] = [];
  ids: usize[] = [];

  @Ensures(result == this.names.length)
  size(): usize {
    return this.names.length;
  }

  @Ensures(result.isSome()
      ==> result.unwrap() < this.names.length && this.names[result.unwrap()] == name)
  @Ensures(result.isNone() ==> !this.names.includes(name))
  indexOf(name: string): Option<usize> {
    return this.names.indexOf(name);
  }

  @Ensures(result == this.ids.includes(id))
  hasId(id: usize): bool {
    return this.ids.includes(id);
  }

  @Requires(this.indexOf(name).isNone() && !this.hasId(id))
  @Ensures(this.size() == old(this.size()) + 1)
  @Ensures(this.indexOf(name).isSome() && this.indexOf(name).unwrap() == this.size() - 1)
  add(name: string, ty: Type, id: usize): void {
    this.names.push(name);
    this.tys.push(ty);
    this.ids.push(id);
  }
}

// The environment tables only ever grow while a body is checked (generic instances, lifted closures).
function envGrew(old: Env, e: Env): bool {
  return e.insts.size() >= old.insts.size()
      && e.funcs.length >= old.funcs.length
      && e.records.length >= old.records.length
      && e.vtables.length >= old.vtables.length;
}

// True when the instance, function, record and vtable tables of `e` are exactly as large as those of
// `old` (no instance was created): `adopt` then keeps the current environment.
function sameTables(old: Env, e: Env): bool {
  return e.insts.size() == old.insts.size()
      && e.funcs.length == old.funcs.length
      && e.records.length == old.records.length
      && e.vtables.length == old.vtables.length;
}

// The state of the function body being checked: its locals and their visible names, the loop stack,
// the environment (which grows as generic instances are created), the statements hoisted out of the
// expression being checked, the mutation probe and, for an arrow function, the snapshot of the
// enclosing function and the captures. One `FnCtx` is owned by one `ExprChecker`; an arrow function
// body gets a context of its own (`newClosureCtx`).
//
// Invariants: a scope is always open (the parameters' scope at least); every capture is a local;
// a result type is only inferred (`retSeen`) for a closure
// that asked for it; a closure has its environment local 0; the type parameters and their bindings are
// parallel; an ordinary function's lowered result type is its source result type; a generic instance is
// no deeper than the instantiation limit (types.or).
@Invariant(this.scope.depth() >= 1)
@Invariant(this.caps.size() <= this.locals.length)
@Invariant(this.retSeen.isSome() ==> this.retInfer)
@Invariant(this.outer.isSome() ==> this.locals.length >= 1)
@Invariant(this.tpNames.length == this.tpTys.length)
@Invariant(this.clsAcc >= -1)
@Invariant(this.depth <= MAX_DEPTH)
@Invariant(isOrdinaryMode(this.fmode) ==> typeEq(this.ret, this.lret))
export class FnCtx {
  unit: usize;
  ret: Type; // the source-level result type
  locals: Local[];
  scope: Scope; // the visible local names
  loops: bool[] = []; // one flag per enclosing loop: has a `break` targeting it been seen?
  env: Env; // current environment: grows as generic instances are created
  tpNames: string[] = []; // type parameters of the function being checked ...
  tpTys: Type[] = []; // ... and their bindings (opaque types in an abstract check)
  abs: bool = false; // abstract check of a generic body: no function instances are created
  inst: bool = false; // an instance of a generic declaration (type arguments known): `void` may stand for a type parameter (ADR-0040)
  depth: usize = 0; // instantiation depth of the function being checked
  // Classes (ADR-0009): FuncInfo.mode / cls of the function being checked ...
  fmode: FnMode = FmOrdinary;
  fcls: usize = 0;
  lret: Type; // the lowered return type (FuncInfo.ret); `ret` is the source-level one
  // ... statements hoisted out of the expression being checked (mutating method calls), flushed by
  // the enclosing block before the statement that contains the expression ...
  pre: HStmt[] = [];
  tmps: usize = 0; // counter for hoisting temporaries
  // ... and the mutation probe: while true, bodies are only analysed for `this` mutation (no HIR is kept).
  probe: bool = false;
  mutThis: bool = false; // a `this` place was mutated (set by the probe)
  // Closures (ADR-0011). While an arrow function body is checked, `outer` is the context of the
  // enclosing function at the point of creation (a snapshot; never modified). A name that is not
  // a local of this function but is visible in `outer` becomes a *capture*: a fresh immutable local
  // initialised from the environment record, recorded in `caps`.
  outer: Option<FnCtx> = None;
  caps: Captures = new Captures();
  qname: string; // name of the function being checked (prefix of its lifted closures)
  ncl: usize = 0; // closures created so far in this function
  retInfer: bool = false; // arrow block body without a known result type: `ret` is inferred from `return`s
  retSeen: Option<Type> = None;
  clsAcc: int = -1; // class whose private members are visible here (-1: none); closures inherit it
  selfName: string = ""; // name of the `let` whose initialiser is being checked ("" if none)
  pendLet: string = ""; // set by `let` while checking its initialiser, consumed by an arrow
  // Contract clauses (ADR-0012): the ContractMode of the expression being checked; and the checked
  // expressions of the loop clauses seen so far (for the purity pass).
  cmode: ContractMode = CmCode;
  cexprs: HExpr[] = [];

  @Requires(scope.depth() >= 1)
  constructor(unit: usize, qname: string, env: Env, locals: Local[], scope: Scope, ret: Type) {
    this.unit = unit;
    this.qname = qname;
    this.env = env;
    this.locals = locals;
    this.scope = scope;
    this.ret = ret;
    this.lret = ret;
  }

  // ---- names and locals ------------------------------------------------------------------------

  // A new local; it is not visible by name until `declare`d. Its id is its index.
  @Ensures(result == old(this.locals.length) && this.locals.length == result + 1)
  @Ensures(this.locals[result].name == name && this.locals[result].mutable == mutable)
  @Ensures(typeEq(this.locals[result].ty, ty))
  newLocal(name: string, ty: Type, mutable: bool): usize {
    const id = this.locals.length;
    this.locals.push(Local { name: name, ty: ty, mutable: mutable });
    return id;
  }

  // A fresh immutable temporary `prefix` + counter, for statements hoisted out of an expression.
  @Ensures(this.tmps == old(this.tmps) + 1 && this.locals.length == old(this.locals.length) + 1)
  @Ensures(result == old(this.locals.length)
      && this.locals[result].name == prefix + old(this.tmps.toString()))
  newTemp(prefix: string, ty: Type): usize {
    const name = prefix + this.tmps.toString();
    this.tmps += 1;
    return this.newLocal(name, ty, false);
  }

  // Makes the local `id` visible as `name` in the innermost scope. Refused (E0304) when the name
  // is already declared in the innermost scope, or is the name of a namespace import of the file (ADR-0048 addendum).
  @Requires(id < this.locals.length)
  @Ensures(this.scope.depth() == old(this.scope.depth())
      && this.locals.length == old(this.locals.length))
  @Ensures(result.isOk()
      ==> this.scope.lookup(name.name).isSome() && this.scope.lookup(name.name).unwrap() == id)
  @Ensures(result.isErr() ==> result.unwrapErr().code == "E0304")
  declare(name: Ident, id: usize): Result<void, Diagnostic> {
    if (isNamespaceName(this.env, this.unit, name.name)) {
      return Err(nsShadowErr(name));
    }
    if (this.scope.inInnermost(name.name)) {
      return Err(diag("E0304", name.span, `\`${name.name}\` is already declared in this block`));
    }
    this.scope.bind(name.name, id);
    return Ok();
  }

  // True if `name` is already declared in the innermost scope.
  @Ensures(result ==> this.scope.lookup(name).isSome())
  declaredInScope(name: string): bool {
    return this.scope.inInnermost(name);
  }

  @Ensures(result.isSome() ==> result.unwrap() < this.locals.length)
  lookupLocal(name: string): Option<usize> {
    return this.scope.lookup(name);
  }

  // Type of `name` as seen from here: a local, a capture, or (through the chain of enclosing
  // functions) something an arrow function could capture.
  varType(name: string): Option<Type> {
    const l = this.scope.lookup(name);
    if (l.isSome()) {
      return Some(this.locals[l.unwrap()].ty);
    }
    const c = this.caps.indexOf(name);
    if (c.isSome()) {
      return Some(this.caps.tys[c.unwrap()]);
    }
    return match (this.outer) {
      Some(o) => o.varType(name),
      None => None,
    };
  }

  isVisibleVar(name: string): bool {
    return this.varType(name).isSome();
  }

  // Resolves a variable use: a local of this function, else (inside an arrow function) a capture
  // of a variable of an enclosing function, which is registered on first use. The result is a local.
  @Ensures(result.isSome() ==> result.unwrap() < this.locals.length)
  @Ensures(this.locals.length >= old(this.locals.length)
      && this.caps.size() >= old(this.caps.size()))
  @Ensures(result.isNone() ==> this.locals.length == old(this.locals.length))
  lookupVar(name: string): Option<usize> {
    const l = this.scope.lookup(name);
    if (l.isSome()) {
      return l;
    }
    const c = this.caps.indexOf(name);
    if (c.isSome()) {
      return Some(this.caps.ids[c.unwrap()]);
    }
    match (this.outer) {
      Some(o) => {
        const t = o.varType(name);
        match (t) {
          Some(ty) => {
            const id = this.locals.length;
            this.locals.push(Local { name: name, ty: ty, mutable: false });
            this.caps.add(name, ty, id);
            return Some(id);
          },
          None => {},
        }
      },
      None => {},
    }
    return None;
  }

  @Ensures(result ==> id < this.locals.length)
  isCapturedLocal(id: usize): bool {
    return this.caps.hasId(id);
  }

  // ---- scopes and loops ------------------------------------------------------------------------

  @Ensures(this.scope.depth() == old(this.scope.depth()) + 1
      && this.locals.length == old(this.locals.length))
  pushScope(): void {
    this.scope.open();
  }

  @Requires(this.scope.depth() > 1)
  @Ensures(this.scope.depth() + 1 == old(this.scope.depth())
      && this.locals.length == old(this.locals.length))
  popScope(): void {
    this.scope.close();
  }

  @Ensures(this.loops.length == old(this.loops.length) + 1 && !this.loops[this.loops.length - 1])
  pushLoop(): void {
    this.loops.push(false);
  }

  // Leaves the innermost loop; true if a `break` targeted it.
  @Requires(this.loops.length > 0)
  @Ensures(this.loops.length + 1 == old(this.loops.length))
  popLoop(): bool {
    return this.loops.pop().unwrapOr(false);
  }

  // Records a `break` for the innermost loop; the caller has checked that a loop exists.
  @Requires(this.loops.length > 0)
  @Ensures(this.loops.length == old(this.loops.length) && this.loops[this.loops.length - 1])
  markBreak(): void {
    this.loops[this.loops.length - 1] = true;
  }

  // ---- hoisted statements ----------------------------------------------------------------------

  // A statement that has to run before the one being checked (ADR-0009 hoisting).
  @Ensures(this.pre.length == old(this.pre.length) + 1)
  hoist(s: HStmt): void {
    this.pre.push(s);
  }

  // Sets the pending list aside (the statement about to be checked starts with an empty one) and
  // returns it; `restorePre` puts it back.
  @Ensures(this.pre.length == 0 && result.length == old(this.pre.length))
  stashPre(): HStmt[] {
    const outer = this.pre;
    const none: HStmt[] = [];
    this.pre = none;
    return outer;
  }

  @Ensures(this.pre.length == outer.length)
  restorePre(outer: HStmt[]): void {
    this.pre = outer;
  }

  // ---- environment -----------------------------------------------------------------------------

  // Takes over `e`, the environment after a resolution or instantiation that may have created
  // instances (they only ever grow the tables). An unchanged environment is not copied in.
  @Requires(envGrew(this.env, e))
  @Ensures(envGrew(old(this.env), this.env))
  @Ensures(this.env.insts.size() >= e.insts.size() && this.env.funcs.length >= e.funcs.length)
  adopt(e: Env): void {
    if (sameTables(this.env, e)) {
      return;
    }
    this.env = e;
  }

  // Replaces the environment by `e` (closure conversion adds records and lifted functions).
  @Requires(envGrew(this.env, e))
  @Ensures(this.env.records.length == e.records.length && this.env.funcs.length == e.funcs.length)
  replaceEnv(e: Env): void {
    this.env = e;
  }

  // ---- contract modes and mutation tracking ----------------------------------------------------

  @Ensures(sameContractMode(this.cmode, m))
  setCmode(m: ContractMode): void {
    this.cmode = m;
  }

  // Records that the `this` of the method being analysed is mutated through `place`.
  @Ensures(this.mutThis == (old(this.mutThis) || result))
  @Ensures(result
      ==> this.lookupLocal("this").isSome() && this.lookupLocal("this").unwrap() == place.root)
  markMut(place: Place): bool {
    const t = this.scope.lookup("this");
    if (t.isSome() && t.unwrap() == place.root) {
      this.mutThis = true;
      return true;
    }
    return false;
  }

  // True inside the constructor / methods of class `c` (private members are visible there).
  @Ensures(result == (this.clsAcc == c.toInt()))
  inClass(c: usize): bool {
    return this.clsAcc == c.toInt();
  }

  // The local `this` as an expression (only called where `this` is in scope).
  thisLocal(): usize {
    return this.scope.lookup("this").unwrapOr(0);
  }
}

// A context with the defaults every function starts with; the two constructors below set the rest.
@Ensures(result.locals.length == f.paramLocals.length && result.scope.depth() == 1)
@Ensures(result.loops.length == 0 && result.caps.size() == 0 && result.outer.isNone())
@Ensures(paramsVisible(result, f))
export function newFnCtx(f: FuncInfo, env: Env, abs: bool): FnCtx {
  let scope = new Scope();
  let i: usize = 0;
  for (const l of f.paramLocals) {
    scope.bind(l.name, i);
    i += 1;
  }
  let fx = new FnCtx(
    f.unit,
    f.qname,
    env,
    f.paramLocals,
    scope,
    isOrdinaryMode(f.mode) ? f.ret : f.srcRet,
  );
  fx.tpNames = f.tpNames;
  fx.tpTys = f.tpTys;
  fx.abs = abs;
  fx.inst = !abs && f.tpTys.length > 0;
  fx.depth = f.depth;
  fx.fmode = f.mode;
  fx.fcls = f.cls;
  fx.lret = f.ret;
  fx.clsAcc = isClassMode(f.mode) ? f.cls.toInt() : -1;
  return fx;
}

// The context for checking the body of an arrow function created in `o`: parameters (after the
// environment local 0) are given by name and type. `ret` is TyVoid when it has to be inferred.
@Requires(names.length == tys.length)
@Ensures(result.locals.length == names.length + 1
    && result.scope.depth() == 1
    && result.outer.isSome())
@Ensures(result.abs == o.abs && result.probe == o.probe && result.clsAcc == o.clsAcc)
export function newClosureCtx(
  o: FnCtx,
  qname: string,
  names: string[],
  tys: Type[],
  ret: Type,
  infer: bool,
): FnCtx {
  let locals: Local[] = [Local { name: "env$", ty: TyVoid, mutable: false }];
  let scope = new Scope();
  let i: usize = 0;
  while (i < names.length) {
    locals.push(Local { name: names[i], ty: tys[i], mutable: false });
    scope.bind(names[i], i + 1);
    i += 1;
  }
  let fx = new FnCtx(o.unit, qname, o.env, locals, scope, ret);
  fx.tpNames = o.tpNames;
  fx.tpTys = o.tpTys;
  fx.abs = o.abs;
  fx.inst = o.inst;
  fx.depth = o.depth;
  fx.probe = o.probe;
  fx.outer = Some(o);
  fx.retInfer = infer;
  fx.clsAcc = o.clsAcc;
  fx.selfName = o.pendLet;
  return fx;
}

// Every parameter of `f` is a visible name of `fx`.
function paramsVisible(fx: FnCtx, f: FuncInfo): bool {
  for (const l of f.paramLocals) {
    if (fx.scope.lookup(l.name).isNone()) {
      return false;
    }
  }
  return true;
}
