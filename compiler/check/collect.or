// Phase 1: collection of declarations, imports and re-exports.
// Port of `Checker::collect` (bootstrap/src/checker/mod.rs). Ids are dense and assigned in unit
// order (dependencies first), then declaration order.

import { Span, Diagnostic, diag } from "../diag";
import { Ident, Item, TypeDecl, TypeDeclBody, TypeExpr, TNamed, TArray, TFn, IFunction, IType, IConst, IInterface, DAlias, DRecord, DUnion, FieldDecl, VariantDecl, AnnotationKind } from "../syntax";
import { Type, Builtin, FieldDef, RecordDef, UnionDef, VariantDef, Local, Function, VTable, taskOpFromName, coreOpFromName } from "../hir";
import { LoadedProgram, ImportTarget, ImportUnit, ImportStd, StdModule, StdFs, StdProcess, StdClock, StdCore } from "../loader";
import {
  TypeEnt, ValEnt, EntRecord, EntUnion, EntAlias, EntGen, EntIface, EntBuiltin, IfaceInfo, IfaceSig, VFunc, VConst, VVariant, VStd, VGFunc, VGVariant, VNamespace,
  Names, UnitInfo, AliasInfo, FuncInfo, ConstInfo, ConstLit, LitInt, Env, RecordSrc,
  UnionSrc, GenType, GenFunc, Insts, ClassInfo, typeEntEq, valEntEq, nsShadowErr, findType, findVal, emptyNames, isBuiltinTypeName, FmOrdinary,
  builtinCmpIfaces
} from "./env";

export type Collected = {
  env: Env;
  recordSrc: RecordSrc[];
  unionSrc: UnionSrc[];
  diags: Diagnostic[];
};

// E0305: a record or a variant payload is stored in at most 64 slots (one per field / payload value); ADR-0056 6.9.
const MAX_SLOTS: usize = 64;

function slotLimitDiags(t: TypeDecl): Diagnostic[] {
  let out: Diagnostic[] = [];
  match (t.body) {
    DRecord(fs) => {
      if (fs.length > MAX_SLOTS) {
        out.push(diag("E0305", t.name.span, "record `" + t.name.name + "` has " + fs.length.toString() + " fields; the limit is "
          + MAX_SLOTS.toString()));
      }
    },
    DUnion(vs) => {
      for (const v of vs) {
        if (v.payload.length > MAX_SLOTS) {
          out.push(diag("E0305", v.span, "variant `" + v.name.name + "` has " + v.payload.length.toString() + " payload values; the limit is "
            + MAX_SLOTS.toString()));
        }
      }
    },
    DAlias(_) => {},
  }
  return out;
}

// E0306: an exported declaration whose signature names a type declared in the same file without `export` (ADR-0056 6.9, MOD-7).
function mentionsPrivate(t: TypeExpr, priv: string[], tparams: Ident[]): Option<Ident> {
  match (t.kind) {
    TNamed(id, args) => {
      if (priv.some(n => n == id.name) && !tparams.some(p => p.name == id.name)) {
        return Some(id);
      }
      for (const a of args) {
        const r = mentionsPrivate(a, priv, tparams);
        if (r.isSome()) { return r; }
      }
      return None;
    },
    TArray(e) => { return mentionsPrivate(e, priv, tparams); },
    TFn(ps, r) => {
      for (const p of ps) {
        const m = mentionsPrivate(p.ty, priv, tparams);
        if (m.isSome()) { return m; }
      }
      return mentionsPrivate(r, priv, tparams);
    },
  }
}

function leak(what: string, name: string, t: TypeExpr, tps: Ident[], priv: string[]): Diagnostic[] {
  match (mentionsPrivate(t, priv, tps)) {
    Some(id) => {
      return [diag("E0306", id.span, "exported " + what + " `" + name + "` mentions the private type `" + id.name + "`; export `" + id.name + "` or keep the declaration private")];
    },
    None => { return []; },
  }
}

function privField(rec: string, field: string, ui: usize, classes: ClassInfo[]): bool {
  return classes.some(c => c.unit == ui && c.name == rec && c.fields.some(f => f.priv && f.name == field));
}

function privMethod(fn: string, ui: usize, classes: ClassInfo[]): bool {
  return classes.some(c => c.unit == ui && c.methods.some(m => m.priv && fn == c.name + "." + m.name));
}

// `classes` (from lowerClasses) tell which fields and methods of a lowered class are private: those may mention private types.
export function privacyLeakDiags(items: Item[], ui: usize, classes: ClassInfo[]): Diagnostic[] {
  let out: Diagnostic[] = [];
  let priv: string[] = [];
  for (const item of items) {
    match (item) {
      IType(t) => { if (!t.exported) { priv.push(t.name.name); } },
      _ => {},
    }
  }
  if (priv.length == 0) { return out; }
  const noParams: Ident[] = [];
  for (const item of items) {
    match (item) {
      IFunction(f) => {
        if (f.exported && !privMethod(f.name.name, ui, classes)) {
          for (const p of f.params) { out = out.concat(leak("function", f.name.name, p.ty, f.typeParams, priv)); }
          match (f.ret) { Some(r) => { out = out.concat(leak("function", f.name.name, r, f.typeParams, priv)); }, None => {} }
        }
      },
      IType(t) => {
        // an `@Sealed` type is opaque to importers (they can neither build nor change it), so its fields may name private types
        if (t.exported && !t.annotations.some(a => match (a.kind) { ASealed => true, _ => false })) {
          match (t.body) {
            DAlias(a) => { out = out.concat(leak("type", t.name.name, a, t.typeParams, priv)); },
            DRecord(fs) => { for (const f of fs) { if (!privField(t.name.name, f.name.name, ui, classes)) { out = out.concat(leak("type", t.name.name, f.ty, t.typeParams, priv)); } } },
            DUnion(vs) => { for (const v of vs) { for (const p of v.payload) { out = out.concat(leak("type", t.name.name, p, t.typeParams, priv)); } } },
          }
        }
      },
      IConst(c) => {
        if (c.exported) {
          match (c.ty) { Some(ty) => { out = out.concat(leak("constant", c.name.name, ty, noParams, priv)); }, None => {} }
        }
      },
      IInterface(k) => {
        if (k.exported) {
          for (const m of k.methods) {
            for (const p of m.params) { out = out.concat(leak("interface", k.name.name, p.ty, noParams, priv)); }
            match (m.ret) { Some(r) => { out = out.concat(leak("interface", k.name.name, r, noParams, priv)); }, None => {} }
          }
        }
      },
      _ => {},
    }
  }
  return out;
}

type AddTypeOut = { names: Names; err: Option<Diagnostic>; };

function addType(names: Names, name: string, ent: TypeEnt, span: Span): AddTypeOut {
  const old = findType(names, name);
  return match (old) {
    Some(o) => AddTypeOut {
      names: names,
      err: typeEntEq(o, ent) ? None : Some(diag("E0304", span, "duplicate definition of type `" + name + "`"))
    },
    None => addTypeNew(names, name, ent)
  };
}

@Requires(!names.hasType(name))
function addTypeNew(names: Names, name: string, ent: TypeEnt): AddTypeOut {
  let n = names;
  n.bindType(name, ent);
  return AddTypeOut { names: n, err: None };
}

function addVal(names: Names, name: string, ent: ValEnt, span: Span): AddTypeOut {
  const old = findVal(names, name);
  return match (old) {
    Some(o) => AddTypeOut {
      names: names,
      err: valEntEq(o, ent) ? None : Some(diag("E0304", span, "duplicate definition of `" + name + "`"))
    },
    None => addValNew(names, name, ent)
  };
}

@Requires(!names.hasVal(name))
function addValNew(names: Names, name: string, ent: ValEnt): AddTypeOut {
  let n = names;
  n.bindVal(name, ent);
  return AddTypeOut { names: n, err: None };
}

// Type parameter lists: names must be distinct and must not reuse a built-in type name.
function checkTypeParams(ps: Ident[]): Diagnostic[] {
  let diags: Diagnostic[] = [];
  let seen: string[] = [];
  for (const p of ps) {
    if (isBuiltinTypeName(p.name)) {
      diags.push(diag("E0408", p.span, "type parameter `" + p.name + "` reuses a built-in type name"));
    }
    for (const q of seen) {
      if (q == p.name) {
        diags.push(diag("E0304", p.span, "duplicate type parameter `" + p.name + "`"));
      }
    }
    seen.push(p.name);
  }
  return diags;
}

type Lookup = { t: Option<TypeEnt>; v: Option<ValEnt>; };

// The first of two optional library primitives.
function anyVal(a: Option<ValEnt>, b: Option<ValEnt>): Option<ValEnt> {
  return match (a) {
    Some(_) => a,
    None => b
  };
}

// The task primitives of std:task (ADR-0017), numbered in hir/taskops.or.
function taskVal(name: string): Option<ValEnt> {
  return match (taskOpFromName(name)) {
    Some(k) => Some(VStd(BTask(k))),
    None => None
  };
}

// The core operations of the runtime core dialect (ADR-0052 R3a), numbered in hir/coreops.or.
function coreVal(name: string): Option<ValEnt> {
  return match (coreOpFromName(name)) {
    Some(k) => Some(VStd(BCore(k))),
    None => None
  };
}

// The network primitives of std:fsraw (ADR-0033), library code only.
function netLookup(name: string): Option<ValEnt> {
  const names = ["grantNet", "grantListen", "grantConnect", "netListen", "netAccept", "netConnect", "netStatus", "netClose", "netPort",
    "netNow", "netRecv", "netSend", "netShutdown", "netPeer", "netResolve", "netErrorText"];
  const ops = [BGrantNet, BGrantListen, BGrantConnect, BNetListen, BNetAccept, BNetConnect, BNetStatus, BNetClose, BNetPort,
    BNetNow, BNetRecv, BNetSend, BNetShutdown, BNetPeer, BNetResolve, BNetErrorText];
  let i: usize = 0;
  while (i < names.length) {
    if (names[i] == name) {
      return Some(VStd(ops[i]));
    }
    i += 1;
  }
  return None;
}

// The stdio and process primitives behind std:io (library/std/io.or): `shellRaw` and `shellTimeoutRaw` are wrapped there
// into `Result`s; the other three are re-exported under their own names.
function ioLookup(name: string): Option<ValEnt> {
  return name == "readBytes" ? Some(VStd(BIoReadBytes))
    : (name == "readLine" ? Some(VStd(BIoReadLine))
    : (name == "writeStdout" ? Some(VStd(BIoWriteStdout))
    : (name == "shellRaw" ? Some(VStd(BIoShell))
    : (name == "shellTimeoutRaw" ? Some(VStd(BIoShellTimeout)) : None))));
}

function stdLookup(m: StdModule, name: string): Option<ValEnt> {
  return match (m) {
    StdFs => name == "fsReadFile" ? Some(VStd(BFsReadFile))
      : (name == "fsWriteFile" ? Some(VStd(BFsWriteFile))
      : (name == "fsExists" ? Some(VStd(BFsExists))
      : (name == "fsListDir" ? Some(VStd(BFsListDir))
      : (name == "fileOpen" ? Some(VStd(BFileOpen))
      : (name == "fileIsOpen" ? Some(VStd(BFileIsOpen))
      : (name == "fileOpenError" ? Some(VStd(BFileOpenError))
      : (name == "fileClose" ? Some(VStd(BFileClose))
      : (name == "grantFs" ? Some(VStd(BGrantFs))
      : (name == "grantProcess" ? Some(VStd(BGrantProcess))
      : (name == "grantStdio" ? Some(VStd(BGrantStdio))
      : (name == "grantClock" ? Some(VStd(BGrantClock))
      : (name == "grantUnder" ? Some(VStd(BGrantUnder))
      : (name == "grantReadOnly" ? Some(VStd(BGrantReadOnly))
      : (name == "grantArgsOnly" ? Some(VStd(BGrantArgsOnly))
      : (name == "grantRevoke" ? Some(VStd(BGrantRevoke)) : anyVal(ioLookup(name), anyVal(netLookup(name), taskVal(name)))))))))))))))))),
    StdProcess => name == "args" ? Some(VStd(BProcessArgs))
      : (name == "exit" ? Some(VStd(BProcessExit)) : None),
    StdClock => name == "nowMillis" ? Some(VStd(BTimeNowMillis))
      : (name == "monotonicMillis" ? Some(VStd(BTimeMonotonicMillis)) : None),
    StdCore => coreVal(name)
  };
}

// Types exported by the internal std modules: `File` (ADR-0025).
function stdTypeLookup(m: StdModule, name: string): Option<TypeEnt> {
  return match (m) {
    StdFs => name == "File" ? Some(EntBuiltin(TyFile))
      : (name == "Host" ? Some(EntBuiltin(TyGrant(0)))
      : (name == "FsGrant" ? Some(EntBuiltin(TyGrant(1)))
      : (name == "ProcessGrant" ? Some(EntBuiltin(TyGrant(2)))
      : (name == "StdioGrant" ? Some(EntBuiltin(TyGrant(3)))
      : (name == "ClockGrant" ? Some(EntBuiltin(TyGrant(4)))
      : (name == "NetGrant" ? Some(EntBuiltin(TyGrant(5)))
      : (name == "Listener" ? Some(EntBuiltin(TyGrant(6)))
      : (name == "Stream" ? Some(EntBuiltin(TyGrant(7))) : None)))))))),
    StdProcess => name == "ProcessGrant" ? Some(EntBuiltin(TyGrant(2))) : None,
    StdClock => name == "ClockGrant" ? Some(EntBuiltin(TyGrant(4))) : None,
    StdCore => None
  };
}

function exportLookup(exports: Names[], target: ImportTarget, name: string): Lookup {
  return match (target) {
    ImportUnit(j) => j < exports.length
      ? Lookup { t: findType(exports[j], name), v: findVal(exports[j], name) }
      : Lookup { t: None, v: None },
    ImportStd(m) => Lookup { t: stdTypeLookup(m, name), v: stdLookup(m, name) }
  };
}

// A companion module is a virtual unit whose path is the source module's path with `.gen` instead of `.or` (the loader).
function isCompanionUnit(path: string): bool {
  return !path.startsWith("$") && path.endsWith(".gen");
}

// The unit index of the source module of the companion at `path`.
function companionSource(prog: LoadedProgram, path: string): Option<usize> {
  const want = path.substring(0, path.length - 4) + ".or";
  let i: usize = 0;
  while (i < prog.units.length) {
    if (prog.units[i].path == want) {
      return Some(i);
    }
    i += 1;
  }
  return None;
}

export function collect(prog: LoadedProgram): Collected {
  let diags: Diagnostic[] = [];
  let units: UnitInfo[] = [];
  let exportsAll: Names[] = [];
  let aliases: AliasInfo[] = [];
  let records: RecordDef[] = [];
  let recordSrc: RecordSrc[] = [];
  let sealed: string[] = [];
  let unions: UnionDef[] = [];
  let unionSrc: UnionSrc[] = [];
  let funcs: FuncInfo[] = [];
  let gtypes: GenType[] = [];
  let gfuncs: GenFunc[] = [];
  let consts: ConstInfo[] = [];
  let ifaces: IfaceInfo[] = [];
  const noNames: string[] = [];
  const noClasses: ClassInfo[] = [];
  const noTypes: Type[] = [];
  const noLocals: Local[] = [];
  let ui: usize = 0;
  // Companion modules (ADR-0046 S4): `m.gen` is generated *for* `m`, so it starts with the scope of `m` (its private
  // declarations and imports); it exports only what it declares itself. `scopesAll` is kept only when a companion exists.
  const hasCompanion = prog.units.some(u => isCompanionUnit(u.path));
  let scopesAll: Names[] = [];
  for (const unit of prog.units) {
    let scope = emptyNames();
    let exports = emptyNames();
    if (hasCompanion && isCompanionUnit(unit.path)) {
      const src = companionSource(prog, unit.path);
      if (src.isSome() && src.unwrap() < scopesAll.length) {
        scope = scopesAll[src.unwrap()];
      }
    }
    for (const item of unit.ast.items) {
      match (item) {
        IFunction(f) => {
          let ent: ValEnt = VFunc(funcs.length);
          if (f.typeParams.length > 0) {
            for (const d of checkTypeParams(f.typeParams)) { diags.push(d); }
            ent = VGFunc(gfuncs.length);
            gfuncs.push(GenFunc { unit: ui, qname: unit.name + "." + f.name.name, decl: f, mode: FmOrdinary, cls: 0 });
          } else {
            funcs.push(FuncInfo {
              unit: ui,
              qname: unit.name + "." + f.name.name,
              decl: f,
              params: noTypes,
              paramLocals: noLocals,
              ret: TyVoid,
              tpNames: noNames,
              tpTys: noTypes,
              depth: 0,
              mode: FmOrdinary,
              cls: 0,
              srcRet: TyVoid
            });
          }
          const a = addVal(scope, f.name.name, ent, f.name.span);
          scope = a.names;
          match (a.err) { Some(d) => { diags.push(d); }, None => {} }
          if (f.exported) {
            const b = addVal(exports, f.name.name, ent, f.name.span);
            exports = b.names;
            match (b.err) { Some(d) => { diags.push(d); }, None => {} }
          }
        },
        IConst(c) => {
          const id = consts.length;
          consts.push(ConstInfo { unit: ui, decl: c, ty: TyVoid, lit: LitInt(0) });
          const a = addVal(scope, c.name.name, VConst(id), c.name.span);
          scope = a.names;
          match (a.err) { Some(d) => { diags.push(d); }, None => {} }
          if (c.exported) {
            const b = addVal(exports, c.name.name, VConst(id), c.name.span);
            exports = b.names;
            match (b.err) { Some(d) => { diags.push(d); }, None => {} }
          }
        },
        IType(t) => {
          for (const d of slotLimitDiags(t)) { diags.push(d); }
          if (t.annotations.some(a => match (a.kind) { ASealed => true, _ => false })) {
            sealed.push(unit.name + "." + t.name.name);
          }
          if (isBuiltinTypeName(t.name.name)) {
            diags.push(diag("E0304", t.name.span, "`" + t.name.name + "` is a built-in type name"));
          } else if (t.typeParams.length > 0) {
            for (const d of checkTypeParams(t.typeParams)) { diags.push(d); }
            const gid = gtypes.length;
            gtypes.push(GenType { unit: ui, qname: unit.name + "." + t.name.name, decl: t });
            const ent = EntGen(gid);
            match (t.body) {
              DUnion(vs) => {
                let tag: usize = 0;
                for (const v of vs) {
                  const a = addVal(scope, v.name.name, VGVariant(gid, tag), v.name.span);
                  scope = a.names;
                  match (a.err) { Some(d) => { diags.push(d); }, None => {} }
                  if (t.exported) {
                    const b = addVal(exports, v.name.name, VGVariant(gid, tag), v.name.span);
                    exports = b.names;
                    match (b.err) { Some(d) => { diags.push(d); }, None => {} }
                  }
                  tag += 1;
                }
              },
              _ => {}
            }
            const a = addType(scope, t.name.name, ent, t.name.span);
            scope = a.names;
            match (a.err) { Some(d) => { diags.push(d); }, None => {} }
            if (t.exported) {
              const b = addType(exports, t.name.name, ent, t.name.span);
              exports = b.names;
              match (b.err) { Some(d) => { diags.push(d); }, None => {} }
            }
          } else {
            const qname = unit.name + "." + t.name.name;
            let ent: TypeEnt = EntAlias(0);
            match (t.body) {
              DAlias(te) => {
                ent = EntAlias(aliases.length);
                aliases.push(AliasInfo { unit: ui, target: te });
              },
              DRecord(fields) => {
                ent = EntRecord(records.length);
                const nf: FieldDef[] = [];
                records.push(RecordDef { name: qname, fields: nf });
                recordSrc.push(RecordSrc { unit: ui, fields: fields });
              },
              DUnion(vs) => {
                const uid = unions.length;
                ent = EntUnion(uid);
                let vdefs: VariantDef[] = [];
                for (const v of vs) {
                  vdefs.push(VariantDef { name: v.name.name, payload: noTypes });
                }
                unions.push(UnionDef { name: qname, variants: vdefs });
                unionSrc.push(UnionSrc { unit: ui, variants: vs });
                let tag: usize = 0;
                for (const v of vs) {
                  const a = addVal(scope, v.name.name, VVariant(uid, tag), v.name.span);
                  scope = a.names;
                  match (a.err) { Some(d) => { diags.push(d); }, None => {} }
                  if (t.exported) {
                    const b = addVal(exports, v.name.name, VVariant(uid, tag), v.name.span);
                    exports = b.names;
                    match (b.err) { Some(d) => { diags.push(d); }, None => {} }
                  }
                  tag += 1;
                }
              }
            }
            const a = addType(scope, t.name.name, ent, t.name.span);
            scope = a.names;
            match (a.err) { Some(d) => { diags.push(d); }, None => {} }
            if (t.exported) {
              const b = addType(exports, t.name.name, ent, t.name.span);
              exports = b.names;
              match (b.err) { Some(d) => { diags.push(d); }, None => {} }
            }
          }
        },
        IImport(_) => {},
        IReExport(_) => {},
        IClass(_) => {},   // lowered to a record and functions before collection (classes.or)
        IInterface(k) => {
          if (isBuiltinTypeName(k.name.name)) {
            diags.push(diag("E0304", k.name.span, "`" + k.name.name + "` is a built-in type name"));
          }
          if (k.typeParams.length > 0) {
            diags.push(diag("E0408", k.typeParams[0].span, "generic interfaces are not supported in Orin 1.0 (ADR-0019)"));
          }
          match (k.ext) {
            Some(b) => {
              diags.push(diag("E0408", b.span, "interface inheritance (`extends`) is not supported in Orin 1.0 (ADR-0019)"));
            },
            None => {}
          }
          let seenM: string[] = [];
          for (const m of k.methods) {
            for (const q of seenM) {
              if (q == m.name.name) {
                diags.push(diag("E0304", m.name.span, "duplicate method `" + m.name.name + "` in interface `" + k.name.name + "`"));
              }
            }
            seenM.push(m.name.name);
          }
          const ent = EntIface(ifaces.length);
          const noSigs: IfaceSig[] = [];
          ifaces.push(IfaceInfo { name: unit.name + "." + k.name.name, unit: ui, decl: k, methods: noSigs });
          const a = addType(scope, k.name.name, ent, k.name.span);
          scope = a.names;
          match (a.err) { Some(d) => { diags.push(d); }, None => {} }
          if (k.exported) {
            const b = addType(exports, k.name.name, ent, k.name.span);
            exports = b.names;
            match (b.err) { Some(d) => { diags.push(d); }, None => {} }
          }
        }
      }
    }
    // Imports and re-exports.
    let imp: usize = 0;
    let oxUnit = -1;
    let nsBound: string[] = [];
    for (const item of unit.ast.items) {
      let isImport = false;
      let isReexport = false;
      let names: Ident[] = [];
      let aliasOf: Option<Ident>[] = [];
      let nsName: Option<Ident> = None;
      let nsUses: Ident[] = [];
      let path = "";
      match (item) {
        IImport(d) => {
          isImport = true;
          names = d.names;
          aliasOf = d.aliases;
          nsName = d.namespace;
          nsUses = d.uses;
          path = d.path;
          if (d.provider && imp < unit.imports.length) {
            match (unit.imports[imp]) { ImportUnit(t) => { oxUnit = t.toInt(); }, _ => {} }
          }
        },
        IReExport(d) => { isImport = true; isReexport = true; names = d.names; aliasOf = d.aliases; path = d.path; },
        _ => {}
      }
      if (isImport) {
        const hasTarget = imp < unit.imports.length;
        if (!hasTarget) {
          const sp = names.length > 0 ? names[0].span : (nsName.isSome() ? nsName.unwrap().span : Span { file: unit.file, start: 0, end: 0 });
          diags.push(diag("E0300", sp, "module `" + path + "` was not resolved by the loader"));
        } else {
          const target = unit.imports[imp];
          // The entries to bind: the export `member` of the target under the name `local` (variants of a union under
          // `vprefix` + their name). A named import binds each name (or its alias); a namespace import (ADR-0048
          // addendum) binds `m.x` for every `m.x` the file wrote, and `m` itself as the namespace.
          let members: string[] = [];
          let locals: string[] = [];
          let vprefixes: string[] = [];
          let spans: Span[] = [];
          let k: usize = 0;
          while (k < names.length) {
            members.push(names[k].name);
            locals.push(k < aliasOf.length && aliasOf[k].isSome() ? aliasOf[k].unwrap().name : names[k].name);
            vprefixes.push("");
            spans.push(names[k].span);
            k += 1;
          }
          if (nsName.isSome()) {
            const ns = nsName.unwrap();
            nsBound.push(ns.name);
            const clash = findVal(scope, ns.name).isSome() || findType(scope, ns.name).isSome();
            const r = addVal(scope, ns.name, VNamespace(imp), ns.span);
            scope = r.names;
            if (clash) {
              diags.push(diag("E0304", ns.span, "the namespace import `" + ns.name + "` clashes with another definition of `" + ns.name + "` in this file; rename one of them"));
            }
            for (const u of nsUses) {
              members.push(u.name.substring(ns.name.length + 1, u.name.length));
              locals.push(u.name);
              vprefixes.push(ns.name + ".");
              spans.push(u.span);
            }
          }
          k = 0;
          while (k < members.length) {
            const member = members[k];
            const local = locals[k];
            const vprefix = vprefixes[k];
            const nspan = spans[k];
            const lk = exportLookup(exportsAll, target, member);
            if (lk.t.isNone() && lk.v.isNone()) {
              diags.push(diag("E0300", nspan, "`" + member + "` is not exported by `" + path + "`"
                + (vprefix == "" ? "" : " (`" + local + "` names a member of the namespace import `" + vprefix.substring(0, vprefix.length - 1) + "`; a local or parameter of that name would shadow the namespace)")));
            } else {
              if (lk.t.isSome()) {
                const te = lk.t.unwrap();
                const r = addType(isReexport ? exports : scope, local, te, nspan);
                if (isReexport) { exports = r.names; } else { scope = r.names; }
                match (r.err) { Some(d) => { diags.push(d); }, None => {} }
              }
              if (lk.v.isSome()) {
                const ve = lk.v.unwrap();
                const r = addVal(isReexport ? exports : scope, local, ve, nspan);
                if (isReexport) { exports = r.names; } else { scope = r.names; }
                match (r.err) { Some(d) => { diags.push(d); }, None => {} }
              }
              if (lk.t.isSome()) {
                match (lk.t.unwrap()) {
                  EntUnion(u) => {
                    let tag: usize = 0;
                    for (const v of unions[u].variants) {
                      const r = addVal(isReexport ? exports : scope, vprefix + v.name, VVariant(u, tag), nspan);
                      if (isReexport) { exports = r.names; } else { scope = r.names; }
                      match (r.err) { Some(d) => { diags.push(d); }, None => {} }
                      tag += 1;
                    }
                  },
                  EntGen(g) => {
                    match (gtypes[g].decl.body) {
                      DUnion(vs) => {
                        let tag: usize = 0;
                        for (const v of vs) {
                          const r = addVal(isReexport ? exports : scope, vprefix + v.name.name, VGVariant(g, tag), nspan);
                          if (isReexport) { exports = r.names; } else { scope = r.names; }
                          match (r.err) { Some(d) => { diags.push(d); }, None => {} }
                          tag += 1;
                        }
                      },
                      _ => {}
                    }
                  },
                  _ => {}
                }
              }
            }
            k += 1;
          }
        }
        imp += 1;
      }
    }
    // A parameter must not reuse the name of a namespace import (the other locals are checked by FnCtx.declare).
    if (nsBound.length > 0) {
      for (const item of unit.ast.items) {
        match (item) {
          IFunction(f) => {
            for (const p of f.params) {
              for (const nb of nsBound) {
                if (p.name.name == nb) {
                  diags.push(nsShadowErr(p.name));
                }
              }
            }
          },
          _ => {}
        }
      }
    }
    units.push(UnitInfo { name: unit.name, file: unit.file, scope: scope, ox: oxUnit });
    scopesAll.push(hasCompanion ? scope : emptyNames());
    exportsAll.push(exports);
    ui += 1;
  }
  for (const b of builtinCmpIfaces(units.length)) {
    ifaces.push(b);
  }
  const noLifted: Function[] = [];
  const noVts: VTable[] = [];
  const env = Env {
    units: units,
    aliases: aliases,
    records: records,
    unions: unions,
    funcs: funcs,
    consts: consts,
    entry: prog.entry,
    gtypes: gtypes,
    gfuncs: gfuncs,
    insts: new Insts(),
    classes: noClasses,
    ifaces: ifaces,
    bounds: new Map<usize, usize[]>(),
    vtables: noVts,
    lifted: noLifted,
    wrappers: new Map<string, usize>(),
    prelude: None,
    mapUnit: None,
    parUnit: None,
    sealed: sealed
  };
  return Collected { env: env, recordSrc: recordSrc, unionSrc: unionSrc, diags: diags };
}
