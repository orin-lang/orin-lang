// Purity of contract expressions (ADR-0012, spec 15 §4.2a; inference: ADR-0031 A4). Beyond Orin-B.
//
// A contract expression may only observe the program, never change or depend on the world. A
// function is *pure* when
//   * it performs no I/O built-in (console.log/error, fs.readFile/writeFile/exists, process.args/exit,
//     io.readBytes/readLine/writeStdout/shell, the file primitives),
//   * it mutates no non-local state (changing its own locals and arrays is not an effect: value
//     semantics, and Orin has no mutable globals; a mutating call on `this` inside a contract is rejected
//     by the checker, E0416),
//   * it calls only pure functions, and
//   * it calls a function value only if that value is a *pure closure*: a function-typed parameter
//     that is called makes the function pure *relative to its argument* (`every(xs, pred)` is pure
//     exactly when the closure passed for `pred` is), and a call site that passes a closure literal
//     is judged by that closure. A function value of any other origin (a local, a field, a call
//     result, a captured variable) and an interface method call have unknown effects and make the
//     caller impure.
// Recursion is allowed (termination is not part of purity). The analysis is a fixed point over the
// call graph of the typed HIR (all functions, generic instances and lifted closures); closure creation
// counts as a call of the closure's function. Everything else (arithmetic, string / array / Option /
// Result built-ins, record and variant construction, `match`, conditionals) is pure. Traps (division by
// zero, index out of bounds, `unwrap` of `None`) and non-termination are not effects of this analysis.
// Capability grants (ADR-0021 Stage A) are I/O: every grant built-in and every grant-taking std I/O built-in
// (including the clock) is listed in `ioName`, so a function that uses a grant is impure.
// Violations are E0416; the message names the impure operation and its location.

import { Span, Diagnostic, SourceMap, diag, describeSpan } from "../diag";
import { Function, HExpr, Builtin, foldExpr, foldBlock, coreOpReads, coreOpPure } from "../hir";

// One call (or closure creation) found in a body.
type Call = { callee: usize; span: Span; args: HExpr[]; };

type Scan = {
  calls: Call[];
  nparams: usize;     // the first `nparams` locals are parameters (a call of one is a call of an argument)
  io: string;         // first I/O built-in found ("" if none)
  ioSpan: Span;
  mut: bool;          // a mutating built-in was found
  mutSpan: Span;
  unknown: string;    // first call whose target has unknown effects ("" if none)
  unkSpan: Span;
  applied: usize[];   // function-typed parameters that are called
};

function ioName(b: Builtin): string {
  return match (b) {
    BConsoleLog => "console.log",
    BConsoleError => "console.error",
    BFsReadFile => "readFile",
    BFsWriteFile => "writeFile",
    BFsExists => "exists",
    BFsListDir => "listDir",
    BFsRename => "rename",
    BFsRemoveFile => "removeFile",
    BFsRemoveDir => "removeDir",
    BFsWriteFileAtomic => "writeFileAtomic",
    BProcessArgs => "args",
    BProcessEnv => "env",
    BProcessExit => "exit",
    BIoReadBytes => "readBytes",
    BIoReadLine => "readLine",
    BIoWriteStdout => "writeStdout",
    BIoShell => "shell",
    BIoShellTimeout => "shellTimeout",
    BTimeNowMillis => "nowMillis",
    BTimeMonotonicMillis => "monotonicMillis",
    BGrantFs => "grantFs",
    BGrantProcess => "grantProcess",
    BGrantStdio => "grantStdio",
    BGrantClock => "grantClock",
    BGrantUnder => "grantUnder",
    BGrantReadOnly => "grantReadOnly",
    BGrantArgsOnly => "grantArgsOnly",
    BGrantRevoke => "grantRevoke",
    BGrantNet => "grantNet",
    BGrantListen => "grantListen",
    BGrantConnect => "grantConnect",
    BNetListen => "netListen",
    BNetAccept => "netAccept",
    BNetConnect => "netConnect",
    BNetStatus => "netStatus",
    BNetClose => "netClose",
    BNetPort => "netPort",
    BNetNow => "netNow",
    BNetRecv => "netRecv",
    BNetSend => "netSend",
    BNetShutdown => "netShutdown",
    BNetPeer => "netPeer",
    BNetResolve => "netResolve",
    BNetErrorText => "netErrorText",
    BFileOpen => "fileOpen",
    BFileIsOpen => "fileIsOpen",
    BFileOpenError => "fileOpenError",
    BFileClose => "fileClose",
    BFileReadLine => "File.readLine",
    BFileRead => "File.read",
    BFileReadAll => "File.readAll",
    BFileWrite => "File.write",
    BFileWriteLine => "File.writeLine",
    BFileFlush => "File.flush",
    BTask(_) => "a task primitive",
    BCore(k) => coreOpPure(k) ? "" : (coreOpReads(k) ? "a core load" : "a core store or memory operation"),
    _ => ""
  };
}

// True for a built-in that performs I/O or derives / uses a grant: the calls that make a function impure.
export function isIoBuiltin(b: Builtin): bool {
  return ioName(b) != "";
}

function hasUsize(xs: usize[], k: usize): bool {
  for (const x of xs) {
    if (x == k) {
      return true;
    }
  }
  return false;
}

function addCall(s0: Scan, callee: usize, sp: Span, args: HExpr[]): Scan {
  let s = s0;
  s.calls.push(Call { callee: callee, span: sp, args: args });
  return s;
}

function markUnknown(s0: Scan, what: string, sp: Span): Scan {
  let s = s0;
  if (s.unknown == "") {
    s.unknown = what;
    s.unkSpan = sp;
  }
  return s;
}

// What one node contributes to the scan; the traversal (hir/walk.or) visits the children afterwards, in the same order.
function scanNode(e: HExpr, s0: Scan): Scan {
  let s = s0;
  match (e.kind) {
    XCall(id, args) => { s = addCall(s, id, e.span, args); },
    XBuiltin(b, _) => {
      const n = ioName(b);
      if (n != "" && s.io == "") {
        s.io = n;
        s.ioSpan = e.span;
      }
    },
    XMutMethod(_, _, _) => {
      if (!s.mut) {
        s.mut = true;
        s.mutSpan = e.span;
      }
    },
    XClosure(fid, _) => { s = addCall(s, fid, e.span, []); },
    XCallVirtual(_, _, _) => { s = markUnknown(s, "call of an interface method", e.span); },
    XCallIndirect(c, _) => {
      // a call of a parameter applies it; the callee expression is then a plain local, nothing to scan
      match (c.kind) {
        XLocal(k) => {
          if (k < s.nparams) {
            if (!hasUsize(s.applied, k)) {
              s.applied.push(k);
            }
          } else {
            s = markUnknown(s, "call through a function value", e.span);
          }
        },
        XClosure(_, _) => {},
        _ => { s = markUnknown(s, "call through a function value", e.span); }
      }
    },
    _ => {}
  }
  return s;
}

function emptyScan(sp: Span, nparams: usize): Scan {
  const cs: Call[] = [];
  const ap: usize[] = [];
  return Scan {
    calls: cs, nparams: nparams, io: "", ioSpan: sp, mut: false, mutSpan: sp, unknown: "", unkSpan: sp, applied: ap
  };
}

// Functions called or closed over by `f` (with repeats).
export function callTargets(f: Function): usize[] {
  let out: usize[] = [];
  for (const c of foldBlock(f.body, emptyScan(f.span, f.paramCount), scanNode).calls) {
    out.push(c.callee);
  }
  return out;
}

// ---------------------------------------------------------------------------
// Inference: a fixed point over the call graph
// ---------------------------------------------------------------------------

// The result for the functions reachable from the roots given to `inferPurity` (`reached[k]` is false
// for the others, which carry no information).
export type Purity = {
  reached: bool[];
  impure: bool[];
  why: string[];       // own impurity: what happens ("performs I/O (console.log)"), "" for a transitive one
  whySpan: Span[];     // ... and where (for a transitive one: the call)
  via: int[];          // transitive impurity: the callee that makes it impure, else -1
  applied: usize[][];  // function-typed parameters that are called (the function is pure relative to them)
};

function markImpure(p0: Purity, k: usize, why: string, sp: Span, via: int): Purity {
  let p = p0;
  p.impure[k] = true;
  p.why[k] = why;
  p.whySpan[k] = sp;
  p.via[k] = via;
  return p;
}

// Analyses every function reachable from `roots` (function ids).
export function inferPurity(funcs: Function[], roots: usize[]): Purity {
  let reached: bool[] = [];
  let impure: bool[] = [];
  let why: string[] = [];
  let whySpan: Span[] = [];
  let via: int[] = [];
  let applied: usize[][] = [];
  let scans: Scan[] = [];
  let k0: usize = 0;
  while (k0 < funcs.length) {
    reached.push(false);
    impure.push(false);
    why.push("");
    whySpan.push(funcs[k0].span);
    via.push(-1);
    const none: usize[] = [];
    applied.push(none);
    scans.push(emptyScan(funcs[k0].span, 0));
    k0 += 1;
  }
  let p = Purity { reached: reached, impure: impure, why: why, whySpan: whySpan, via: via, applied: applied };
  // 1. reachable functions and their scans
  let order: usize[] = [];
  let stack: usize[] = [];
  for (const r of roots) {
    stack.push(r);
  }
  while (stack.length > 0) {
    const k = stack.pop().unwrap();
    if (k >= funcs.length || p.reached[k]) {
      continue;
    }
    p.reached[k] = true;
    order.push(k);
    const sc = foldBlock(funcs[k].body, emptyScan(funcs[k].span, funcs[k].paramCount), scanNode);
    scans[k] = sc;
    p.applied[k] = sc.applied;
    for (const c of sc.calls) {
      if (c.callee < funcs.length && !p.reached[c.callee]) {
        stack.push(c.callee);
      }
    }
    if (sc.io != "") {
      p = markImpure(p, k, "performs I/O (" + sc.io + ")", sc.ioSpan, -1);
    } else if (sc.unknown != "") {
      p = markImpure(p, k, "makes a " + sc.unknown + " whose effects are unknown", sc.unkSpan, -1);
    }
  }
  // 2. propagate until nothing changes (monotone: a function only becomes impure, and only gains
  // called parameters)
  let changed = true;
  while (changed) {
    changed = false;
    for (const k of order) {
      if (p.impure[k]) {
        continue;
      }
      for (const c of scans[k].calls) {
        if (p.impure[k] || c.callee >= funcs.length) {
          continue;
        }
        const g = c.callee;
        if (p.impure[g]) {
          p = markImpure(p, k, "", c.span, g.toInt());
          changed = true;
          continue;
        }
        for (const j of p.applied[g]) {
          if (p.impure[k] || j >= c.args.length) {
            continue;
          }
          match (c.args[j].kind) {
            XClosure(fid, _) => {
              if (fid < funcs.length && p.applied[fid].length > 0) {
                p = markImpure(p, k, "passes a closure that calls function values to `" + funcs[g].name + "`", c.span, -1);
                changed = true;
              }
            },
            XLocal(q) => {
              if (q < funcs[k].paramCount) {
                if (!hasUsize(p.applied[k], q)) {
                  p.applied[k].push(q);
                  changed = true;
                }
              } else {
                p = markImpure(p, k, "passes a function value of unknown origin to `" + funcs[g].name + "`", c.span, -1);
                changed = true;
              }
            },
            _ => {
              p = markImpure(p, k, "passes a function value of unknown origin to `" + funcs[g].name + "`", c.span, -1);
              changed = true;
            }
          }
        }
      }
    }
  }
  return p;
}

// "`f` -> `g` performs I/O (console.log) at file.or:3:5" for an impure function `k0`.
export function explain(sm: SourceMap, funcs: Function[], p: Purity, k0: usize): string {
  let names = "`" + funcs[k0].name + "`";
  let k = k0;
  let guard: usize = 0;
  while (p.via[k] >= 0 && guard < 64) {
    k = p.via[k].toUsize();
    names = names + " -> `" + funcs[k].name + "`";
    guard += 1;
  }
  return names + " " + p.why[k] + " at " + describeSpan(sm, p.whySpan[k]);
}

// The number of reached functions that are pure (tooling and tests).
export function pureCount(p: Purity): usize {
  let n: usize = 0;
  let k: usize = 0;
  while (k < p.reached.length) {
    if (p.reached[k] && !p.impure[k]) {
      n += 1;
    }
    k += 1;
  }
  return n;
}

// All function ids: the roots of a whole-program analysis.
export function allFunctions(funcs: Function[]): usize[] {
  let out: usize[] = [];
  let k: usize = 0;
  while (k < funcs.length) {
    out.push(k);
    k += 1;
  }
  return out;
}

// E0416 diagnostics for the contract expressions `exprs` (checked HIR); `funcs` is the final
// function table (indexed by function id).
export function purityDiags(sm: SourceMap, funcs: Function[], exprs: HExpr[]): Diagnostic[] {
  let out: Diagnostic[] = [];
  let scans: Scan[] = [];
  let roots: usize[] = [];
  for (const e of exprs) {
    const s = foldExpr(e, emptyScan(e.span, 0), scanNode);
    for (const c of s.calls) {
      roots.push(c.callee);
    }
    scans.push(s);
  }
  const p = inferPurity(funcs, roots);
  for (const s of scans) {
    if (s.mut) {
      out.push(diag("E0416", s.mutSpan, "mutation is not allowed in a contract expression"));
    }
    if (s.io != "") {
      out.push(diag("E0416", s.ioSpan, "I/O built-in `" + s.io + "` is not allowed in a contract expression (contracts must be pure)"));
    }
    if (s.unknown != "") {
      out.push(diag("E0416", s.unkSpan, "a " + s.unknown + " is not allowed in a contract expression: its effects are unknown (only a closure literal, or a pure function that is given one, is analysed)"));
    }
    for (const c of s.calls) {
      if (c.callee >= funcs.length) {
        continue;
      }
      const g = c.callee;
      if (p.impure[g]) {
        out.push(diag("E0416", c.span, "call is not provably pure: " + explain(sm, funcs, p, g) + "; contract expressions may only call pure functions"));
        continue;
      }
      for (const j of p.applied[g]) {
        if (j >= c.args.length) {
          continue;
        }
        match (c.args[j].kind) {
          XClosure(_, _) => {},
          _ => {
            out.push(diag("E0416", c.args[j].span, "function value passed to `" + funcs[g].name + "` in a contract expression is not a closure literal, so its effects are unknown"));
          }
        }
      }
    }
  }
  return out;
}
