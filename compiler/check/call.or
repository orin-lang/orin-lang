// Calls: the type-argument inference state of a generic call (`Inference`) and the diagnostics of
// built-in calls. The checking of the arguments themselves is in expr.or (`ExprChecker`), which owns
// the context; this file holds what needs no context.

import { Span, Diagnostic, diag } from "../diag";
import { Type, HExpr } from "../hir";
import { TypeExpr, TNamed } from "../syntax";
import { Env, typeEq, isVoid } from "./env";
import { unify, noBinds, mentionsUnbound, bindsKept } from "./types";
import { bindsOrVoid } from "./ops";

// Every slot of `xs` holds a value.
export function allFilled(xs: Option<HExpr>[]): bool {
  for (const x of xs) {
    if (x.isNone()) {
      return false;
    }
  }
  return true;
}

// Number of slots that hold a value.
export function filledCount(xs: Option<HExpr>[]): usize {
  let n: usize = 0;
  for (const x of xs) {
    if (x.isSome()) {
      n += 1;
    }
  }
  return n;
}

// Is `te` exactly one of the type parameters `tp` (not a type that merely mentions one)?
function isBareParam(te: TypeExpr, tp: string[]): bool {
  return match (te.kind) {
    TNamed(id, args) => args.length == 0 && tp.includes(id.name),
    _ => false,
  };
}

// What is known while the type arguments of a call to a generic callee (function, variant constructor
// or record literal) are inferred: per type parameter its binding (once bound it never changes), and
// per argument its checked HIR (a slot is filled once). Order of authority is the checker's: explicit
// type arguments, the expected type, then the arguments left to right.
@Invariant(this.binds.length == this.tp.length)
export class Inference {
  tp: string[];
  binds: Option<Type>[];
  slots: Option<HExpr>[];

  constructor(tp: string[], nargs: usize) {
    this.tp = tp;
    this.binds = noBinds(tp.length);
    this.slots = [];
    let i: usize = 0;
    while (i < nargs) {
      this.slots.push(None);
      i += 1;
    }
  }

  // Binds type parameter `k` to an explicit type argument.
  @Requires(k < this.binds.length && this.binds[k].isNone())
  @Ensures(this.binds[k].isSome() && typeEq(this.binds[k].unwrap(), ty))
  explicit(k: usize, ty: Type): void {
    this.binds[k] = Some(ty);
  }

  // Binds the type parameters mentioned in `te` by matching it against the concrete type `actual`;
  // bindings made earlier win and are never undone.
  @Ensures(bindsKept(old(this.binds), this.binds))
  learn(env: Env, unit: usize, te: TypeExpr, actual: Type): void {
    if (isVoid(actual) && isBareParam(te, this.tp)) {
      return;
    }
    this.binds = unify(env, unit, te, actual, this.tp, this.binds);
  }

  // Records the checked argument `h` at position `i`; every position is filled once.
  @Requires(i < this.slots.length && this.slots[i].isNone())
  @Ensures(this.slots[i].isSome() && filledCount(this.slots) == old(filledCount(this.slots)) + 1)
  fill(i: usize, h: HExpr): void {
    this.slots[i] = Some(h);
  }

  @Requires(i < this.slots.length)
  isFilled(i: usize): bool {
    return this.slots[i].isSome();
  }

  // True if `te` mentions a type parameter that is still unbound.
  unbound(te: TypeExpr): bool {
    return mentionsUnbound(te, this.tp, this.binds);
  }

  // The bindings so far, with `void` for a parameter still unbound (only mentioned parameters need to
  // be real when a parameter type is resolved).
  @Ensures(result.length == this.tp.length)
  current(): Type[] {
    return bindsOrVoid(this.binds);
  }

  // The type arguments once the arguments are in: every parameter bound (`void` is a type argument, ADR-0040).
  @Ensures(result.isOk() ==> result.unwrap().length == this.tp.length)
  typeArgs(span: Span, what: string): Result<Type[], Diagnostic> {
    let tys: Type[] = [];
    let bi: usize = 0;
    @Invariant(tys.length == bi)
    for (const b of this.binds) {
      match (b) {
        Some(t) => {
          tys.push(t);
        },
        None => {
          return Err(
            diag(
              "E0407",
              span,
              "cannot infer type argument `" + this.tp[bi] + "` of " + what
                  + "; add explicit type arguments or a type annotation",
            ),
          );
        },
      }
      bi += 1;
    }
    return Ok(tys);
  }

  // The checked arguments in source order; every position is filled.
  @Requires(allFilled(this.slots))
  @Ensures(result.length == this.slots.length)
  args(): HExpr[] {
    let out: HExpr[] = [];
    for (const s of this.slots) {
      out.push(s.unwrap());
    }
    return out;
  }
}

// ---------------------------------------------------------------------------
// Built-in calls that need a capability grant (ADR-0027)
// ---------------------------------------------------------------------------

// A call that passes no grant to a function that needs one (E0470).
export function grantMissingErr(span: Span, what: string, gname: string): Diagnostic {
  return diag(
    "E0470",
    span,
    what + " needs a `" + gname
        + "` as its first argument: standard I/O is authorised by a capability grant, and a grant"
        + " can only be obtained from `main(host: Host)` (ADR-0027); a program whose `main()` has no `host` parameter has no I/O authority",
  );
}

// The first argument is not the grant the function needs: a grant of another family (E0471) or no
// grant at all (E0470).
@Ensures(result.code == (isGrant ? "E0471" : "E0470"))
export function grantMismatchErr(
  span: Span,
  what: string,
  gname: string,
  found: string,
  isGrant: bool,
): Diagnostic {
  if (isGrant) {
    return diag(
      "E0471",
      span,
      what + " needs a `" + gname + "`, found a `" + found
          + "`: a grant authorises only its own family of operations",
    );
  }
  return diag(
    "E0470",
    span,
    what + " needs a `" + gname + "` as its first argument, found `" + found + "` (ADR-0027)",
  );
}
