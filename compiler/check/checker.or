// Checker driver: collect -> resolve declarations -> check bodies. Each phase stops the
// pipeline if it produced diagnostics (same as bootstrap/src/checker/mod.rs `check`).

import { Diagnostic, SourceMap, diag } from "../diag";
import { Ident, DAlias, FunctionDecl } from "../syntax";
import { Program, Function, HBlock, HExpr, XLocal, HReturn, Type, IfaceDef } from "../hir";
import { LoadedProgram } from "../loader";
import {
  Env, FuncInfo, dedupDiags, isVoid, isOrdinaryMode, isCtorMode, isMutVoidMode, isLiftedMode,
} from "./env";
import { collect, privacyLeakDiags } from "./collect";
import { resolveDecls, findMain } from "./decls";
import { newFnCtx } from "./fnctx";
import { checkBlock } from "./body";
import { lowerClasses, buildClassTables, classOfGeneric } from "./classes";
import { opaquesBounded, abstractInfo } from "./gclass";
import { inferClasses } from "./classfix";
import { scopeOf, resolveType, instType } from "./types";
import { resolveImpls, checkImpls } from "./ifaces";
import { checkFuncContracts, checkRecordContracts } from "./contracts";
import { purityDiags } from "./purity";
import { resourceDiags } from "./resources";
import { taskDiags } from "./tasks";
import { parallelDiags } from "./parallel";
import { expandContracts } from "./rtcheck";
import { instrumentProgram } from "./rthir";
import { testSignatureDiags, inlineCycleDiags, hasInline } from "./annotations";
import { userAnnotationDiags } from "./userannos";

// `cexprs`: the checked contract expressions of the function (ADR-0012), for the purity pass.
type FuncOut = { func: Function; err: Option<Diagnostic>; env: Env; cexprs: HExpr[]; };

// Checks one function body. `abs` marks the abstract check of a generic body (type parameters
// are opaque types; no function instances are created). Returns the (possibly grown) environment.
function checkFunc(env: Env, f: FuncInfo, abs: bool): FuncOut {
  if (isLiftedMode(f.mode)) {
    // A lifted closure function: its HIR was produced while its enclosing function was checked.
    const noErr: Option<Diagnostic> = None;
    return FuncOut { func: env.lifted[f.cls], err: noErr, env: env, cexprs: [] };
  }
  let fx0 = newFnCtx(f, env, abs);
  let cexprs: HExpr[] = [];
  if (f.decl.contracts.length > 0) {
    // Contract clauses are type-checked in a forked context and erased (ADR-0012).
    const cf = checkFuncContracts(env, f, fx0);
    match (cf) {
      Err(d) => {
        return FuncOut {
          func: Function {
            name: f.qname,
            paramCount: f.paramLocals.length,
            locals: f.paramLocals,
            ret: f.ret,
            body: HBlock { stmts: [] },
            span: f.decl.span
          },
          err: Some(d),
          env: env,
          cexprs: cexprs
        };
      },
      Ok(o) => {
        fx0 = o.fx;
        cexprs = o.exprs;
      }
    }
  }
  const fx = fx0;
  const r = checkBlock(fx, f.decl.body);
  return match (r) {
    Err(d) => FuncOut {
      func: Function {
        name: f.qname,
        paramCount: f.paramLocals.length,
        locals: f.paramLocals,
        ret: f.ret,
        body: HBlock { stmts: [] },
        span: f.decl.span
      },
      err: Some(d),
      env: env,
      cexprs: cexprs
    },
    Ok(b) => {
      let err: Option<Diagnostic> = None;
      let block = b.block;
      // Classes: constructors and void mutating methods return the receiver (`this` is the first local
      // after the parameters).
      if ((isCtorMode(f.mode) || isMutVoidMode(f.mode)) && !b.div) {
        const thisE = HExpr { kind: XLocal(f.paramLocals.length), ty: f.ret, span: f.decl.span };
        block.stmts.push(HReturn(Some(thisE)));
      }
      const srcVoid = isOrdinaryMode(f.mode) ? isVoid(f.ret) : isVoid(f.srcRet);
      if (!srcVoid && !b.div) {
        err = Some(diag(
          "E0403",
          f.decl.name.span,
          "function `" + f.decl.name.name + "` does not return a value on every path"
        ));
      }
      return FuncOut {
        func: Function {
          name: f.qname,
          paramCount: f.paramLocals.length,
          locals: b.fx.locals,
          ret: f.ret,
          body: block,
          span: f.decl.span
        },
        err: err,
        env: b.fx.env,
        cexprs: appendAll(cexprs, b.fx.cexprs)
      };
    }
  };
}

function appendAll(a: HExpr[], b: HExpr[]): HExpr[] {
  let out = a;
  for (const x of b) {
    out.push(x);
  }
  return out;
}

// Abstract check of a generic function: the body is checked once with opaque type parameters. The
// constructor and instance methods of a generic class (ADR-0026) are checked the same way, with the
// class mode set (see gclass.or).
function abstractFunc(env: Env, g: usize): Option<Diagnostic> {
  const ai = match (abstractInfo(env, g)) {
    Ok(x) => x,
    Err(d) => {
      return Some(d);
    }
  };
  return checkFunc(ai.env, ai.f, true).err;
}

// Abstract check of a generic type declaration: its field / payload types must resolve.
function abstractType(env: Env, g: usize): Option<Diagnostic> {
  const gt = env.gtypes[g];
  let bounds: Ident[][] = [];
  const gc = classOfGeneric(env, g);
  if (gc.isSome()) {
    bounds = env.classes[gc.unwrap()].bounds;
  }
  const opr = opaquesBounded(env, gt.unit, gt.decl.typeParams, bounds);
  if (opr.isErr()) {
    return Some(opr.unwrapErr());
  }
  const op = opr.unwrap();
  match (gt.decl.body) {
    DAlias(target) => {
      match (resolveType(op.env, scopeOf(gt.unit, op.names, op.tys), target, false)) {
        Err(d) => { return Some(d); },
        Ok(_) => { return None; }
      }
    },
    _ => {
      match (instType(op.env, g, op.tys, 0, gt.decl.name.span)) {
        Err(d) => { return Some(d); },
        Ok(_) => { return None; }
      }
    }
  }
}

// Unit index of the array prelude (`library/collections/array.or`, loaded implicitly as unit `$array/array`; see
// compiler/loader/prelude.or), or None when the program was loaded without preludes.
function arrayPreludeUnit(prog: LoadedProgram): Option<usize> {
  return preludeUnit(prog, "$array/array");
}

// Unit index of the unit called `name` (a prelude unit), or None.
function preludeUnit(prog: LoadedProgram, name: string): Option<usize> {
  let i: usize = 0;
  while (i < prog.units.length) {
    if (prog.units[i].name == name) {
      return Some(i);
    }
    i += 1;
  }
  return None;
}

function ifaceDefs(env: Env): IfaceDef[] {
  let out: IfaceDef[] = [];
  for (const i of env.ifaces) {
    if (i.unit == env.units.length) {
      continue;   // the built-in constraint interfaces Eq / Ord / Hash (ADR-0034) are not part of the HIR
    }
    let ms: string[] = [];
    for (const m of i.methods) {
      ms.push(m.name);
    }
    out.push(IfaceDef { name: i.name, methods: ms });
  }
  return out;
}

// Qualified names of the inferred-mutating instance methods of every class (Program.mutating).
function mutatingMethods(env: Env): string[] {
  let out: string[] = [];
  for (const c of env.classes) {
    for (const m of c.methods) {
      if (m.mutating) {
        out.push(env.units[c.unit].name + "." + c.name + "." + m.name);
      }
    }
  }
  return out;
}

export function check(prog: LoadedProgram, sm: SourceMap): Result<Program, Diagnostic[]> {
  const userAnnos = userAnnotationDiags(prog);
  if (userAnnos.length > 0) {
    return Err(userAnnos);
  }
  const sigs = testSignatureDiags(prog);
  if (sigs.length > 0) {
    return Err(sigs);
  }
  // Classes are lowered to records and functions first (ADR-0009).
  const lw = lowerClasses(prog);
  if (lw.diags.length > 0) {
    return Err(dedupDiags(lw.diags));
  }
  let c = collect(lw.prog);
  let ui: usize = 0;
  for (const u of lw.prog.units) {
    for (const d of privacyLeakDiags(u.ast.items, ui, lw.classes)) { c.diags.push(d); }
    ui += 1;
  }
  if (c.diags.length > 0) {
    return Err(dedupDiags(c.diags));
  }
  c.env.prelude = arrayPreludeUnit(lw.prog);
  c.env.mapUnit = preludeUnit(lw.prog, "$array/map");
  c.env.parUnit = preludeUnit(lw.prog, "$array/parallel");
  // `implements` lists are resolved before the declarations: a bounded generic class (`Box<T extends I>`,
  // ADR-0026) checks its type arguments against them while declarations are resolved.
  const im = resolveImpls(buildClassTables(c.env, lw.classes));
  if (im.diags.length > 0) {
    return Err(dedupDiags(im.diags));
  }
  const r = resolveDecls(im.env, c.recordSrc, c.unionSrc);
  if (r.diags.length > 0) {
    return Err(dedupDiags(r.diags));
  }
  let env = inferClasses(r.env);
  const cd = checkImpls(env);
  if (cd.length > 0) {
    return Err(dedupDiags(cd));
  }
  let diags: Diagnostic[] = [];
  // Generic declarations are checked once, abstractly, at their definition.
  let gi: usize = 0;
  while (gi < env.gtypes.length) {
    match (abstractType(env, gi)) {
      Some(d) => { diags.push(d); },
      None => {}
    }
    gi += 1;
  }
  gi = 0;
  while (gi < env.gfuncs.length) {
    match (abstractFunc(env, gi)) {
      Some(d) => { diags.push(d); },
      None => {}
    }
    gi += 1;
  }
  // Ordinary functions, then the generic instances they (transitively) request: instances are
  // appended to `env.funcs` while checking, so the loop runs until the table stops growing.
  let funcs: Function[] = [];
  let cexprs: HExpr[] = [];
  const rc = checkRecordContracts(env, lw.prog);
  env = rc.env;
  for (const d of rc.diags) {
    diags.push(d);
  }
  cexprs = appendAll(cexprs, rc.exprs);
  let fi: usize = 0;
  while (fi < env.funcs.length) {
    const o = checkFunc(env, env.funcs[fi], false);
    env = o.env;
    funcs.push(o.func);
    cexprs = appendAll(cexprs, o.cexprs);
    match (o.err) {
      Some(d) => { diags.push(d); },
      None => {}
    }
    fi += 1;
  }
  if (diags.length == 0) {
    for (const d of taskDiags(funcs, env.records)) {
      diags.push(d);
    }
  }
  if (diags.length == 0 && env.parUnit.isSome()) {
    for (const d of parallelDiags(sm, funcs)) {
      diags.push(d);
    }
  }
  if (diags.length == 0) {
    for (const d of resourceDiags(funcs)) {
      diags.push(d);
    }
  }
  if (diags.length == 0 && cexprs.length > 0) {
    for (const d of purityDiags(sm, funcs, cexprs)) {
      diags.push(d);
    }
  }
  // `@Inline` (ADR-0024): the hint travels by function name; a function in a call cycle is rejected.
  let inl: bool[] = [];
  let inlineFns: string[] = [];
  for (const fi2 of env.funcs) {
    const h = !isLiftedMode(fi2.mode) && hasInline(fi2.decl.annotations);
    inl.push(h);
    if (h) {
      inlineFns.push(fi2.qname);
    }
  }
  if (diags.length == 0 && inlineFns.length > 0) {
    for (const d of inlineCycleDiags(funcs, inl)) {
      diags.push(d);
    }
  }
  if (diags.length > 0) {
    return Err(dedupDiags(diags));
  }
  const mainId = findMain(env).unwrapOr(0);
  return Ok(Program {
    records: env.records, unions: env.unions, functions: funcs, main: mainId, vtables: env.vtables, ifaces: ifaceDefs(env),
    mutating: mutatingMethods(env), inlineFns: inlineFns
  });
}

// `check` with runtime contract checking (`orin compile --check-contracts`, ADR-0012): the program is
// checked as usual (so contract errors are reported once, with their own codes), expanded, and the
// expansion is checked again.
export function checkRuntime(prog: LoadedProgram, sm: SourceMap): Result<Program, Diagnostic[]> {
  const first = check(prog, sm);
  if (first.isErr()) {
    return first;
  }
  const second = check(expandContracts(prog, sm), sm);
  return match (second) {
    Ok(p) => Ok(instrumentProgram(p, sm)),
    Err(_) => second
  };
}
