// Checker environment: symbol tables, type helpers and type display.
// Port of the "Tables" section of bootstrap/src/checker/mod.rs.

import { Span, Diagnostic, diag } from "../diag";
import {
  Ident, FunctionDecl, ConstDecl, TypeExpr, FieldDecl, VariantDecl, TypeDecl, InterfaceDecl,
} from "../syntax";
import {
  Type, RecordDef, UnionDef, Local, Builtin, Function, VTable, grantTypeName, intKindOf, kindName, kindSigned,
} from "../hir";

// Entry of the type namespace (records, unions, aliases).
// EntGen: a generic type declaration (record, union or alias with type parameters), index into
// Env.gtypes. EntIface: an interface (ADR-0019), index into Env.ifaces.
// EntBuiltin: a built-in type exported by an internal std module (`File`, ADR-0025).
export type TypeEnt =
  EntRecord(usize)
  | EntUnion(usize)
  | EntAlias(usize)
  | EntGen(usize)
  | EntIface(usize)
  | EntBuiltin(Type);

// Entry of the value namespace: functions, consts, union variants (union id, tag), std functions.
// VGFunc: generic function (index into Env.gfuncs); VGVariant: variant of a generic union
// (Env.gtypes index, tag). VNamespace: the name of a namespace import `import * as m` (the import's index in its unit; ADR-0048
// addendum). It is no value: the members `m.x` are ordinary entries of the unit's scope under the name "m.x", bound by the
// collector for every `m.x` the file wrote.
export type ValEnt =
  VFunc(usize)
  | VConst(usize)
  | VVariant(usize, usize)
  | VStd(Builtin)
  | VGFunc(usize)
  | VGVariant(usize, usize)
  | VNamespace(usize);

// The names visible in a unit (or exported by it), one table per namespace, looked up in O(1). A name
// is bound at most once per namespace (the collector reports duplicates, E0304, and keeps the first):
// `bound` counts the bindings made, so a silent overwrite would show as a count that is larger than the
// tables.
@Invariant(this.bound == this.types.size + this.vals.size)
export class Names {
  private types: Map<string, TypeEnt> = new Map<string, TypeEnt>();
  private vals: Map<string, ValEnt> = new Map<string, ValEnt>();
  private bound: usize = 0;

  @Ensures(result == this.bound)
  count(): usize {
    return this.bound;
  }

  @Ensures(result == this.types.has(name))
  hasType(name: string): bool {
    return this.types.has(name);
  }

  @Ensures(result == this.vals.has(name))
  hasVal(name: string): bool {
    return this.vals.has(name);
  }

  @Ensures(result.isSome() == this.types.has(name))
  typeOf(name: string): Option<TypeEnt> {
    return this.types.get(name);
  }

  @Ensures(result.isSome() == this.vals.has(name))
  valOf(name: string): Option<ValEnt> {
    return this.vals.get(name);
  }

  @Requires(!this.hasType(name))
  @Ensures(this.hasType(name) && this.count() == old(this.count()) + 1)
  bindType(name: string, ent: TypeEnt): void {
    this.types.set(name, ent);
    this.bound += 1;
  }

  @Requires(!this.hasVal(name))
  @Ensures(this.hasVal(name) && this.count() == old(this.count()) + 1)
  bindVal(name: string, ent: ValEnt): void {
    this.vals.set(name, ent);
    this.bound += 1;
  }
}

// `ox`: the unit selected by `import ox from ".."` (the file's OX provider, ADR-0044), -1 if none.
export type UnitInfo = { name: string; file: usize; scope: Names; ox: int; };

export type AliasInfo = { unit: usize; target: TypeExpr; };

// What a checked function is (ADR-0009, ADR-0011). The class modes (`FmCtor` .. `FmStatic`) have a class
// (`FuncInfo.cls`) and a source result type (`FuncInfo.srcRet`).
// FmOrdinary: an ordinary function. FmCtor: a constructor. FmMethod: a non-mutating method.
// FmMutVoid: a mutating method returning void (lowered result: the updated receiver).
// FmMutRet: a mutating method with a result (lowered result: a `$ret` record). FmStatic: a static method.
// FmLifted: a lifted function (arrow body or function-value wrapper) whose HIR was produced while checking
// its enclosing function.
export type FnMode = FmOrdinary | FmCtor | FmMethod | FmMutVoid | FmMutRet | FmStatic | FmLifted;

// Where an expression is being checked (ADR-0012): CmCode ordinary code, CmContract a contract expression
// (`@Requires`, `@Invariant`, `@Decreases`, loop clauses), CmEnsures an `@Ensures` expression (`result`,
// `old(..)`), CmOld inside `old(..)`.
export type ContractMode = CmCode | CmContract | CmEnsures | CmOld;

export function sameContractMode(a: ContractMode, b: ContractMode): bool {
  return contractModeNo(a) == contractModeNo(b);
}

function contractModeNo(m: ContractMode): usize {
  return match (m) {
    CmCode => 0,
    CmContract => 1,
    CmEnsures => 2,
    CmOld => 3,
  };
}

// Inside any contract expression (not ordinary code).
export function inContract(m: ContractMode): bool {
  return match (m) {
    CmCode => false,
    _ => true,
  };
}

export function isEnsuresMode(m: ContractMode): bool {
  return match (m) {
    CmEnsures => true,
    _ => false,
  };
}

export function isOldMode(m: ContractMode): bool {
  return match (m) {
    CmOld => true,
    _ => false,
  };
}

// The modes a whole contract clause is checked in: CmContract or CmEnsures.
export function isClauseMode(m: ContractMode): bool {
  return match (m) {
    CmContract => true,
    CmEnsures => true,
    _ => false,
  };
}

@Ensures(result == match (m) { FmOrdinary => true, _ => false })
export function isOrdinaryMode(m: FnMode): bool {
  return match (m) {
    FmOrdinary => true,
    _ => false,
  };
}

export function isCtorMode(m: FnMode): bool {
  return match (m) {
    FmCtor => true,
    _ => false,
  };
}

export function isStaticMode(m: FnMode): bool {
  return match (m) {
    FmStatic => true,
    _ => false,
  };
}

export function isLiftedMode(m: FnMode): bool {
  return match (m) {
    FmLifted => true,
    _ => false,
  };
}

export function isMutVoidMode(m: FnMode): bool {
  return match (m) {
    FmMutVoid => true,
    _ => false,
  };
}

export function isMutRetMode(m: FnMode): bool {
  return match (m) {
    FmMutRet => true,
    _ => false,
  };
}

// An instance method of a class: non-mutating or mutating.
export function isInstanceMethodMode(m: FnMode): bool {
  return match (m) {
    FmMethod => true,
    FmMutVoid => true,
    FmMutRet => true,
    _ => false,
  };
}

// A constructor or method of a class (not an ordinary or a lifted function).
export function isClassMode(m: FnMode): bool {
  return match (m) {
    FmOrdinary => false,
    FmLifted => false,
    _ => true,
  };
}

export type FuncInfo = {
  unit: usize;
  qname: string;
  decl: FunctionDecl;
  params: Type[];
  paramLocals: Local[];
  ret: Type;
  // Monomorphized instances (and abstract checks) of generic functions: type parameter names,
  // their bindings, and the instantiation nesting depth. Empty / 0 for ordinary functions.
  tpNames: string[];
  tpTys: Type[];
  depth: usize;
  // Classes (ADR-0009). `mode`: see FnMode. `cls`: index into Env.classes (the class modes). `srcRet`: the
  // return type as written (`ret` is the lowered one); only meaningful for the class modes.
  // Closures (ADR-0011): for FmLifted `cls` indexes Env.lifted.
  mode: FnMode;
  cls: usize;
  srcRet: Type;
};

// A class member as seen by the checker: access and mutability. Methods are plain functions
// `Class.name(this$, args)` found by id (ADR-0009).
export type FieldAcc = { name: string; priv: bool; };
export type MethodInfo = {
  name: string;
  fid: usize;
  isStatic: bool;
  priv: bool;
  mutating: bool; // inferred (fixpoint over the classes)
  hasRet: bool; // declared result type is not void
  retRec: usize; // the `$ret` record (mutating methods with a result)
  gen: bool; // `fid` indexes Env.gfuncs: an instance method of a generic class, or a method with type parameters of its own (ADR-0040)
  ownTps: usize; // number of type parameters the method declares itself (ADR-0040); they follow the class's in the generic function
};
// Generic classes (ADR-0026): `gid` is the index of the generic record in Env.gtypes (-1 for an ordinary class;
// `rec` is then meaningless), `bounds` parallel to the type parameters. The constructor and the instance
// methods of a generic class are generic functions: `ctor` / `MethodInfo.fid` index Env.gfuncs; static
// methods stay ordinary functions (they cannot mention the type parameters, as in TypeScript).
export type ClassInfo = {
  name: string;
  unit: usize;
  gid: int;
  bounds: Ident[][];
  rec: usize; // the record the class lowers to
  fields: FieldAcc[];
  ctor: usize; // function id of the constructor
  methods: MethodInfo[];
  implNames: Ident[]; // `implements` list as written (ADR-0019) ...
  impls: usize[]; // ... resolved to interface ids (buildClassTables); parallel to implNames
};

// Interfaces (ADR-0019). `methods` are the resolved signatures in declaration order (receiver
// excluded); the slot of a method in a vtable is its index here.
export type IfaceSig = { name: string; paramNames: string[]; params: Type[]; ret: Type; };
export type IfaceInfo = { name: string; unit: usize; decl: InterfaceDecl; methods: IfaceSig[]; };

// Generic declarations (ADR-0007). Their bodies are only ever checked through instances.
export type GenType = { unit: usize; qname: string; decl: TypeDecl; };
// `mode` / `cls`: FuncInfo.mode and class index for the constructor and instance methods of a generic class
// (ADR-0026; FmOrdinary for every other generic function). Their instances inherit both.
export type GenFunc = { unit: usize; qname: string; decl: FunctionDecl; mode: FnMode; cls: usize; };

// What a monomorphic instance instantiates: a generic record, union or function.
export type InstKind = IkRecord | IkUnion | IkFunction;

export function sameInstKind(a: InstKind, b: InstKind): bool {
  return instKindNo(a) == instKindNo(b);
}

export function isRecordKind(k: InstKind): bool {
  return match (k) {
    IkRecord => true,
    _ => false,
  };
}

// Number of an instance kind in the keys of `Insts` (0 record, 1 union, 2 function).
function instKindNo(k: InstKind): usize {
  return match (k) {
    IkRecord => 0,
    IkUnion => 1,
    IkFunction => 2,
  };
}

// A monomorphic instance; `gid` indexes gtypes (IkRecord / IkUnion) or gfuncs (IkFunction); `id` is the
// record / union / function id of the instance.
export type Inst = { kind: InstKind; gid: usize; args: Type[]; id: usize; depth: usize; };

export type ConstLit = LitInt(int) | LitStr(string) | LitBool(bool) | LitFloat(string);

export type ConstInfo = { unit: usize; decl: ConstDecl; ty: Type; lit: ConstLit; };

export type Env = {
  units: UnitInfo[];
  aliases: AliasInfo[];
  records: RecordDef[];
  unions: UnionDef[];
  funcs: FuncInfo[];
  consts: ConstInfo[];
  entry: usize;
  gtypes: GenType[];
  gfuncs: GenFunc[];
  insts: Insts; // the instances of generic types / functions created so far (with their indexes)
  classes: ClassInfo[];
  ifaces: IfaceInfo[];
  // Opaque type parameters with a bound (abstract check of `function f<T extends I>`): the field-less
  // record id stands for any class implementing every interface id it maps to (`T extends A & B`: several).
  bounds: Map<usize, usize[]>;
  vtables: VTable[]; // interned (class, interface) vtables (ADR-0019)
  lifted: Function[]; // checked HIR of the lifted closure functions (FuncInfo.mode 6)
  wrappers: Map<string, usize>; // function-value wrappers (lift.or): qualified name `f$closure` -> function id
  prelude: Option<usize>; // unit index of the array prelude ($array/array), None if none
  mapUnit: Option<usize>; // unit index of the Map prelude ($array/map), None if none (ADR-0018)
  parUnit: Option<usize>; // unit index of the parallel-pipeline prelude ($array/parallel), None if not loaded (ADR-0039)
  sealed: string[]; // qualified names (`unit.Type`) of the `@Sealed` record types (ADR-0044)
};

// Source declarations needed by the declaration-resolution phase (indexed like Env.records/unions).
export type RecordSrc = { unit: usize; fields: FieldDecl[]; };
export type UnionSrc = { unit: usize; variants: VariantDecl[]; };

// ---------------------------------------------------------------------------
// Type helpers
// ---------------------------------------------------------------------------

@Ensures(result == (typeId(a) == typeId(b)))
export function typeEq(a: Type, b: Type): bool {
  return match (a) {
    TyInt => match (b) {
      TyInt => true,
      _ => false,
    },
    TyUsize => match (b) {
      TyUsize => true,
      _ => false,
    },
    TyIntK(k) => match (b) {
      TyIntK(j) => k == j,
      _ => false,
    },
    TyBool => match (b) {
      TyBool => true,
      _ => false,
    },
    TyFloat => match (b) {
      TyFloat => true,
      _ => false,
    },
    TyF32 => match (b) {
      TyF32 => true,
      _ => false,
    },
    TyString => match (b) {
      TyString => true,
      _ => false,
    },
    TyVoid => match (b) {
      TyVoid => true,
      _ => false,
    },
    TyArray(x) => match (b) {
      TyArray(y) => typeEq(x, y),
      _ => false,
    },
    TyOption(x) => match (b) {
      TyOption(y) => typeEq(x, y),
      _ => false,
    },
    TyResult(x1, x2) => match (b) {
      TyResult(y1, y2) => typeEq(x1, y1) && typeEq(x2, y2),
      _ => false,
    },
    TyRecord(i) => match (b) {
      TyRecord(j) => i == j,
      _ => false,
    },
    TyUnion(i) => match (b) {
      TyUnion(j) => i == j,
      _ => false,
    },
    TyFn(p1, r1) => match (b) {
      TyFn(p2, r2) => typesEq(p1, p2) && typeEq(r1, r2),
      _ => false,
    },
    TyIface(i) => match (b) {
      TyIface(j) => i == j,
      _ => false,
    },
    TyFile => match (b) {
      TyFile => true,
      _ => false,
    },
    TyGrant(k) => match (b) {
      TyGrant(j) => k == j,
      _ => false,
    },
  };
}

// `int` (= i64) exactly.
export function isInt(t: Type): bool {
  return match (t) {
    TyInt => true,
    _ => false,
  };
}

// A signed integer type (negation is defined).
@Ensures(result ==> isIntish(t))
export function isSignedInt(t: Type): bool {
  const k = intKindOf(t);
  return k >= 0 && kindSigned(k);
}

export function isUsize(t: Type): bool {
  return match (t) {
    TyUsize => true,
    _ => false,
  };
}

@Ensures(result == match (t) { TyBool => true, _ => false })
export function isBool(t: Type): bool {
  return match (t) {
    TyBool => true,
    _ => false,
  };
}

export function isString(t: Type): bool {
  return match (t) {
    TyString => true,
    _ => false,
  };
}

export function isFn(t: Type): bool {
  return match (t) {
    TyFn(_, _) => true,
    _ => false,
  };
}

export function isIface(t: Type): bool {
  return match (t) {
    TyIface(_) => true,
    _ => false,
  };
}

export function isVoid(t: Type): bool {
  return match (t) {
    TyVoid => true,
    _ => false,
  };
}

// Any integer type (int, usize and the fixed-width ones, ADR-0022).
@Ensures(result == (intKindOf(t) >= 0))
export function isIntish(t: Type): bool {
  return intKindOf(t) >= 0;
}

// `float` or `f32` (ADR-0018).
export function isFloatTy(t: Type): bool {
  return match (t) {
    TyFloat => true,
    TyF32 => true,
    _ => false,
  };
}

// A numeric type that adopts a literal's type from context: int, usize, float, f32.
export function isNumeric(t: Type): bool {
  return isIntish(t) || isFloatTy(t);
}

export function isArrayTy(t: Type): bool {
  return match (t) {
    TyArray(_) => true,
    _ => false,
  };
}

// `Some(t)` is the expected type, and it is `usize`.
@Ensures(result ==> exp.isSome())
export function expIsUsize(exp: Option<Type>): bool {
  return match (exp) {
    Some(t) => isUsize(t),
    None => false,
  };
}

@Ensures(result.length > 0)
export function showType(env: Env, t: Type): string {
  return match (t) {
    TyInt => "int",
    TyUsize => "usize",
    TyIntK(k) => kindName(k.toInt()),
    TyBool => "bool",
    TyFloat => "float",
    TyF32 => "f32",
    TyString => "string",
    TyVoid => "void",
    TyArray(e) => `${showType(env, e)}[]`,
    TyOption(e) => `Option<${showType(env, e)}>`,
    TyResult(a, b) => `Result<${showType(env, a)}, ${showType(env, b)}>`,
    TyRecord(r) => r < env.records.length ? prettyName(env.records[r].name) : "?",
    TyUnion(u) => u < env.unions.length ? env.unions[u].name : "?",
    TyFn(ps, r) => `(${showTypes(env, ps)}) => ${showType(env, r)}`,
    TyIface(i) => i < env.ifaces.length ? env.ifaces[i].name : "?",
    TyFile => "File",
    TyGrant(k) => grantTypeName(k),
  };
}

// `$array/map.Map<string,int>` is shown as `Map<string, int>` (the Map prelude's instances, ADR-0018).
function prettyName(n: string): string {
  if (n.startsWith("$array/map.")) {
    return n.substring(11, n.length).split(",").join(", ");
  }
  return n;
}

function showTypes(env: Env, ts: Type[]): string {
  return ts.map(t => showType(env, t)).join(", ");
}

// Comma-separated, space-free rendering used in deterministic instance names
// (`main.Pair<int,string>`).
@Ensures(result.length > 0)
export function tyKey(env: Env, t: Type): string {
  return match (t) {
    TyArray(e) => `${tyKey(env, e)}[]`,
    TyOption(e) => `Option<${tyKey(env, e)}>`,
    TyResult(a, b) => `Result<${tyKey(env, a)},${tyKey(env, b)}>`,
    TyFn(ps, r) => `(${tysKey(env, ps)})=>${tyKey(env, r)}`,
    _ => showType(env, t),
  };
}

@Ensures(ts.length == 0 ==> result == "")
export function tysKey(env: Env, ts: Type[]): string {
  return ts.map(t => tyKey(env, t)).join(",");
}

@Ensures(result.code == "E0400"
    && result.span.file == span.file
    && result.span.start == span.start
    && result.span.end == span.end)
export function mismatch(env: Env, span: Span, expected: Type, found: Type): Diagnostic {
  return diag(
    "E0400",
    span,
    `expected \`${showType(env, expected)}\`, found \`${showType(env, found)}\``,
  );
}

// Identity of a diagnostic (code, span, message): the message comes last, so the key is unambiguous.
function diagKey(d: Diagnostic): string {
  return `${d.code}|${d.span.file}|${d.span.start}|${d.span.end}|${d.message}`;
}

// Drops later duplicates (same code, span and message), keeping first-occurrence order.
@Ensures(result.length <= ds.length)
@Ensures(ds.length > 0 ==> result.length > 0)
@Ensures(noRepeats(result))
export function dedupDiags(ds: Diagnostic[]): Diagnostic[] {
  let seen = new Map<string, bool>();
  let out: Diagnostic[] = [];
  for (const d of ds) {
    const k = diagKey(d);
    if (!seen.has(k)) {
      seen.set(k, true);
      out.push(d);
    }
  }
  return out;
}

// ---------------------------------------------------------------------------
// Name tables
// ---------------------------------------------------------------------------

export function typeEntEq(a: TypeEnt, b: TypeEnt): bool {
  return match (a) {
    EntRecord(x) => match (b) {
      EntRecord(y) => x == y,
      _ => false,
    },
    EntUnion(x) => match (b) {
      EntUnion(y) => x == y,
      _ => false,
    },
    EntAlias(x) => match (b) {
      EntAlias(y) => x == y,
      _ => false,
    },
    EntGen(x) => match (b) {
      EntGen(y) => x == y,
      _ => false,
    },
    EntIface(x) => match (b) {
      EntIface(y) => x == y,
      _ => false,
    },
    EntBuiltin(x) => match (b) {
      EntBuiltin(y) => typeEq(x, y),
      _ => false,
    },
  };
}

// Only the std functions can appear in VStd; this id distinguishes them.
function stdId(b: Builtin): int {
  return match (b) {
    BFsReadFile => 1,
    BFsWriteFile => 2,
    BFsExists => 3,
    BFsListDir => 41,
    BProcessArgs => 4,
    BProcessExit => 5,
    BIoReadBytes => 6,
    BIoReadLine => 7,
    BIoWriteStdout => 8,
    BIoShell => 9,
    BIoShellTimeout => 39,
    BTimeNowMillis => 10,
    BTimeMonotonicMillis => 40,
    BFileOpen => 11,
    BFileIsOpen => 12,
    BFileOpenError => 13,
    BFileClose => 14,
    BGrantFs => 15,
    BGrantProcess => 16,
    BGrantStdio => 17,
    BGrantClock => 18,
    BGrantUnder => 19,
    BGrantReadOnly => 20,
    BGrantArgsOnly => 21,
    BGrantRevoke => 22,
    BTask(k) => 100 + k.toInt(),
    BCore(k) => 200 + k.toInt(),
    BGrantNet => 23,
    BGrantListen => 24,
    BGrantConnect => 25,
    BNetListen => 26,
    BNetAccept => 27,
    BNetConnect => 28,
    BNetStatus => 29,
    BNetClose => 30,
    BNetPort => 31,
    BNetNow => 32,
    BNetRecv => 33,
    BNetSend => 34,
    BNetShutdown => 35,
    BNetPeer => 36,
    BNetResolve => 37,
    BNetErrorText => 38,
    _ => 0,
  };
}

export function valEntEq(a: ValEnt, b: ValEnt): bool {
  return match (a) {
    VFunc(x) => match (b) {
      VFunc(y) => x == y,
      _ => false,
    },
    VConst(x) => match (b) {
      VConst(y) => x == y,
      _ => false,
    },
    VVariant(u1, t1) => match (b) {
      VVariant(u2, t2) => u1 == u2 && t1 == t2,
      _ => false,
    },
    VStd(x) => match (b) {
      VStd(y) => stdId(x) == stdId(y),
      _ => false,
    },
    VGFunc(x) => match (b) {
      VGFunc(y) => x == y,
      _ => false,
    },
    VGVariant(g1, t1) => match (b) {
      VGVariant(g2, t2) => g1 == g2 && t1 == t2,
      _ => false,
    },
    VNamespace(x) => match (b) {
      VNamespace(y) => x == y,
      _ => false,
    },
  };
}

@Ensures(result.isSome() == names.hasType(name))
export function findType(names: Names, name: string): Option<TypeEnt> {
  return names.typeOf(name);
}

@Ensures(result.isSome() == names.hasVal(name))
export function findVal(names: Names, name: string): Option<ValEnt> {
  return names.valOf(name);
}

@Ensures(result.count() == 0)
export function emptyNames(): Names {
  return new Names();
}

export function isBuiltinTypeName(n: string): bool {
  return n == "int"
      || n == "usize"
      || n == "bool"
      || n == "string"
      || n == "void"
      || n == "Option"
      || n == "Result"
      || n == "float"
      || n == "f32";
}

// Value lookup in the scope of unit `unit`.
@Requires(unit < env.units.length)
export function globalVal(env: Env, unit: usize, name: string): Option<ValEnt> {
  return findVal(env.units[unit].scope, name);
}

// `name` is the name of a namespace import (`import * as name`) of unit `unit`: no local, parameter or declaration may reuse it.
@Requires(unit < env.units.length)
export function isNamespaceName(env: Env, unit: usize, name: string): bool {
  const g = globalVal(env, unit, name);
  if (g.isNone()) {
    return false;
  }
  return match (g.unwrap()) {
    VNamespace(_) => true,
    _ => false,
  };
}

// The error for a namespace import used as a value (passed, stored, compared, printed or called).
export function nsValueErr(name: Ident): Diagnostic {
  return diag("E0400", name.span, "`" + name.name + "` is a namespace (`import * as " + name.name + "`), not a value; write `" + name.name + ".name`");
}

// The error for a local, parameter or closure parameter `name` that has the name of a namespace import.
export function nsShadowErr(name: Ident): Diagnostic {
  return diag("E0304", name.span, "`" + name.name + "` has the same name as the namespace import `" + name.name + "`; rename one of them");
}

// Key of an instance in `Insts.byId`: kind (0 record, 1 union, 2 function) and the instance's id.
export function originKey(kind: InstKind, id: usize): string {
  return `${instKindNo(kind)}:${id}`;
}

// `inst` is the instance of generic `gid` of `kind` at `args`.
function instIs(inst: Inst, kind: InstKind, gid: usize, args: Type[]): bool {
  return sameInstKind(inst.kind, kind) && inst.gid == gid && typesEq(inst.args, args);
}

// `inst` is the instance that `t` (a record or union type) was created from.
function instOrigin(inst: Inst, t: Type): bool {
  return match (t) {
    TyRecord(r) => sameInstKind(inst.kind, IkRecord) && inst.id == r,
    TyUnion(u) => sameInstKind(inst.kind, IkUnion) && inst.id == u,
    _ => false,
  };
}

// The monomorphic instances created so far, in creation order, with two indexes: by what they
// instantiate (generic id and type arguments, for `find`) and by the record / union / function id they
// produced (for `origin`). Both indexes stay exactly as large as the list, so an instance is created
// once and every index entry points inside the list.
@Invariant(this.list.length == this.byKey.size)
@Invariant(this.list.length == this.byId.size)
export class Insts {
  private list: Inst[] = [];
  private byKey: Map<string, usize> = new Map<string, usize>(); // `instKey` -> index in `list`
  private byId: Map<string, usize> = new Map<string, usize>(); // `originKey` -> index in `list`

  @Ensures(result == this.list.length)
  size(): usize {
    return this.list.length;
  }

  @Requires(i < this.list.length)
  @Ensures(result.id == this.list[i].id)
  at(i: usize): Inst {
    return this.list[i];
  }

  @Ensures(result == this.byKey.has(instKey(kind, gid, args)))
  has(kind: InstKind, gid: usize, args: Type[]): bool {
    return this.byKey.has(instKey(kind, gid, args));
  }

  @Ensures(result.isSome() ==> instIs(result.unwrap(), kind, gid, args))
  @Ensures(result.isSome() == this.has(kind, gid, args))
  find(kind: InstKind, gid: usize, args: Type[]): Option<Inst> {
    const at = this.byKey.get(instKey(kind, gid, args));
    return at.isSome() ? Some(this.list[at.unwrap()]) : None;
  }

  @Ensures(result.isSome() ==> sameInstKind(result.unwrap().kind, kind) && result.unwrap().id == id)
  @Ensures(result.isSome() == this.byId.has(originKey(kind, id)))
  origin(kind: InstKind, id: usize): Option<Inst> {
    const at = this.byId.get(originKey(kind, id));
    return at.isSome() ? Some(this.list[at.unwrap()]) : None;
  }

  // An instance is created once, and it produces a record / union / function id that no other
  // instance produced.
  @Requires(!this.has(inst.kind, inst.gid, inst.args))
  @Requires(this.origin(inst.kind, inst.id).isNone())
  @Ensures(this.size() == old(this.size()) + 1)
  @Ensures(this.find(inst.kind, inst.gid, inst.args).isSome()
      && this.find(inst.kind, inst.gid, inst.args).unwrap().id == inst.id)
  @Ensures(this.origin(inst.kind, inst.id).isSome() && this.at(this.size() - 1).id == inst.id)
  add(inst: Inst): void {
    const at = this.list.length;
    this.list.push(inst);
    this.byKey.set(instKey(inst.kind, inst.gid, inst.args), at);
    this.byId.set(originKey(inst.kind, inst.id), at);
  }
}

// Instance record for type `t` (a record or union instantiated from a generic type).
@Ensures(result.isSome() ==> instOrigin(result.unwrap(), t))
export function originOf(env: Env, t: Type): Option<Inst> {
  return match (t) {
    TyRecord(r) => env.insts.origin(IkRecord, r),
    TyUnion(u) => env.insts.origin(IkUnion, u),
    _ => None,
  };
}

// The generic type `name` (`Map` or `MapEntry`) of the Map prelude (library/collections/map.or), if that prelude is loaded.
@Requires(isWellFormedEnv(env))
@Ensures(result.isSome() ==> result.unwrap() < env.gtypes.length)
export function mapGenType(env: Env, name: string): Option<usize> {
  return match (env.mapUnit) {
    Some(mu) => match (findType(env.units[mu].scope, name)) {
      Some(ent) => match (ent) {
        EntGen(g) => Some(g),
        _ => None,
      },
      None => None,
    },
    None => None,
  };
}

// The instance record of `Map<K, V>` (library/collections/map.or) when `t` is one.
@Ensures(result.isSome() ==> isRecordKind(result.unwrap().kind))
export function mapOrigin(env: Env, t: Type): Option<Inst> {
  const o = originOf(env, t);
  const g = mapGenType(env, "Map");
  if (o.isSome() && g.isSome()) {
    const i = o.unwrap();
    if (isRecordKind(i.kind) && i.gid == g.unwrap()) {
      return o;
    }
  }
  return None;
}

// The instance record of `Parallel<T>` (library/collections/parallel.or, ADR-0039) when `t` is one: the view the array method
// `parallel()` returns.
@Requires(isWellFormedEnv(env))
@Ensures(result.isSome() ==> isRecordKind(result.unwrap().kind))
export function parOrigin(env: Env, t: Type): Option<Inst> {
  const pu = match (env.parUnit) {
    Some(u) => u,
    None => {
      return None;
    },
  };
  const o = originOf(env, t);
  const g = findType(env.units[pu].scope, "Parallel");
  if (o.isSome() && g.isSome()) {
    const i = o.unwrap();
    match (g.unwrap()) {
      EntGen(gid) => {
        if (isRecordKind(i.kind) && i.gid == gid) {
          return o;
        }
      },
      _ => {},
    }
  }
  return None;
}

// Key types of `Map<K, V>`: the classes that have a hash and an equality (ADR-0018).
export function isMapKeyType(t: Type): bool {
  return match (t) {
    TyInt => true,
    TyUsize => true,
    TyIntK(_) => true,
    TyBool => true,
    TyString => true,
    _ => false,
  };
}

@Ensures(result ==> a.length == b.length)
@Ensures(result == (typesId(a) == typesId(b)))
export function typesEq(a: Type[], b: Type[]): bool {
  if (a.length != b.length) {
    return false;
  }
  let i: usize = 0;
  while (i < a.length) {
    if (!typeEq(a[i], b[i])) {
      return false;
    }
    i += 1;
  }
  return true;
}

// Structural identity of a type (record / union ids, not names: two records can share a name).
export function typeId(t: Type): string {
  return match (t) {
    TyInt => "i",
    TyUsize => "u",
    TyIntK(k) => `k${k.toInt()}`,
    TyBool => "b",
    TyFloat => "f",
    TyF32 => "g",
    TyString => "s",
    TyVoid => "v",
    TyArray(e) => `[${typeId(e)}]`,
    TyOption(e) => `?${typeId(e)}`,
    TyResult(a, b) => `R<${typeId(a)},${typeId(b)}>`,
    TyRecord(r) => `r${r}`,
    TyUnion(u) => `n${u}`,
    TyFn(ps, r) => `(${typesId(ps)})>${typeId(r)}`,
    TyIface(i) => `I${i}`,
    TyFile => "F",
    TyGrant(k) => `G${k}`,
  };
}

// Comma-separated `typeId`s (a loop, not `map`: it is used in contracts, which cannot call function values).
export function typesId(ts: Type[]): string {
  let out = "";
  for (const t of ts) {
    out = out == "" ? typeId(t) : `${out},${typeId(t)}`;
  }
  return out;
}

// Key of an instance in `Env.instIdx`.
export function instKey(kind: InstKind, gid: usize, args: Type[]): string {
  return `${instKindNo(kind)}:${gid}:${typesId(args)}`;
}

@Ensures(result.isSome() ==> instIs(result.unwrap(), kind, gid, args))
export function findInst(env: Env, kind: InstKind, gid: usize, args: Type[]): Option<Inst> {
  return env.insts.find(kind, gid, args);
}

// ---------------------------------------------------------------------------
// Interfaces (ADR-0019)
// ---------------------------------------------------------------------------

@Ensures(result.isSome()
    ==> result.unwrap() < i.methods.length && i.methods[result.unwrap()].name == name)
export function ifaceMethodIndex(i: IfaceInfo, name: string): Option<usize> {
  let k: usize = 0;
  while (k < i.methods.length) {
    if (i.methods[k].name == name) {
      return Some(k);
    }
    k += 1;
  }
  return None;
}

// `area(x: int): int` — a rendered interface method signature.
@Requires(m.paramNames.length == m.params.length)
@Ensures(result.length > 0)
export function showIfaceSig(env: Env, m: IfaceSig): string {
  let ps: string[] = [];
  let k: usize = 0;
  while (k < m.params.length) {
    ps.push(`${m.paramNames[k]}: ${showType(env, m.params[k])}`);
    k += 1;
  }
  return `${m.name}(${ps.join(", ")}): ${showType(env, m.ret)}`;
}

// The built-in constraint interfaces `Eq`, `Ord` and `Hash` (ADR-0034). They are appended to `Env.ifaces` after every
// declared interface, with the sentinel unit `units.length`, no methods and no declaration site; they are in no scope, so
// the only places that name them are type parameter bounds and `implements` lists (`boundIface`, `resolveImpls`).
export function builtinCmpIfaces(units: usize): IfaceInfo[] {
  const sp = Span { file: 0, start: 0, end: 0 };
  let out: IfaceInfo[] = [];
  for (const n of ["Eq", "Ord", "Hash"]) {
    const decl = InterfaceDecl {
      exported: false,
      name: Ident { name: n, span: sp },
      typeParams: [],
      ext: None,
      methods: [],
      annotations: [],
      span: sp,
    };
    out.push(IfaceInfo { name: n, unit: units, decl: decl, methods: [] });
  }
  return out;
}

// 1 for `Eq`, 2 for `Ord`, 3 for `Hash` when interface `i` is the built-in one, else 0.
export function cmpKindOfIface(env: Env, i: usize): usize {
  if (i >= env.ifaces.length || env.ifaces[i].unit != env.units.length) {
    return 0;
  }
  const n = env.ifaces[i].name;
  return n == "Eq" ? 1 : (n == "Ord" ? 2 : (n == "Hash" ? 3 : 0));
}

// The built-in constraint interface called `name` (`Eq`, `Ord`, `Hash`).
export function builtinIface(env: Env, name: string): Option<usize> {
  let i: usize = 0;
  while (i < env.ifaces.length) {
    if (env.ifaces[i].unit == env.units.length && env.ifaces[i].name == name) {
      return Some(i);
    }
    i += 1;
  }
  return None;
}

// Is record `r` the opaque type of a type parameter in an abstract check (a field-less record named after the
// parameter, `mkOpaque`)? Real records are qualified (`unit.Name`), so their names contain a dot.
export function isOpaqueRec(env: Env, r: usize): bool {
  return env.records[r].fields.length == 0 && !env.records[r].name.includes(".");
}

// The interfaces bounding the opaque record `r` (abstract check of a bounded type parameter, `T extends A & B`), in
// source order; empty for an unbounded parameter.
// Every recorded bound names an existing interface (`addBound` requires it and interfaces are never removed);
// without this precondition the @Ensures does not follow (found by `orin verify --contracts`, ADR-0031 B).
@Requires(env.bounds.values().every(ifs => ifs.every(i => i < env.ifaces.length)))
@Ensures(result.every(i => i < env.ifaces.length))
export function boundsOf(env: Env, r: usize): usize[] {
  const none: usize[] = [];
  return env.bounds.get(r).unwrapOr(none);
}

// Appends `iface` to the bounds of the opaque record `rec`.
@Requires(rec < env.records.length && iface < env.ifaces.length)
export function addBound(env: Env, rec: usize, iface: usize): Env {
  let e = env;
  const none: usize[] = [];
  let cur = e.bounds.get(rec).unwrapOr(none);
  cur.push(iface);
  e.bounds.set(rec, cur);
  return e;
}

// Every record / union / interface id of `t` exists in `env` (no dangling reference).
export function typeInRange(env: Env, t: Type): bool {
  return match (t) {
    TyArray(e) => typeInRange(env, e),
    TyOption(e) => typeInRange(env, e),
    TyResult(a, b) => typeInRange(env, a) && typeInRange(env, b),
    TyRecord(r) => r < env.records.length,
    TyUnion(u) => u < env.unions.length,
    TyIface(i) => i < env.ifaces.length,
    TyFn(ps, r) => typesInRange(env, ps) && typeInRange(env, r),
    _ => true,
  };
}

export function typesInRange(env: Env, ts: Type[]): bool {
  for (const t of ts) {
    if (!typeInRange(env, t)) {
      return false;
    }
  }
  return true;
}

// Two diagnostics with the same code, span and message.
function sameDiag(a: Diagnostic, b: Diagnostic): bool {
  return a.code == b.code
      && a.span.file == b.span.file
      && a.span.start == b.span.start
      && a.span.end == b.span.end
      && a.message == b.message;
}

// No diagnostic occurs twice (same code, span and message).
export function noRepeats(ds: Diagnostic[]): bool {
  let i: usize = 0;
  while (i < ds.length) {
    let j: usize = 0;
    while (j < i) {
      if (sameDiag(ds[i], ds[j])) {
        return false;
      }
      j += 1;
    }
    i += 1;
  }
  return true;
}

// `o` (a prelude unit index) is the unit `u`.
export function isUnit(o: Option<usize>, u: usize): bool {
  return match (o) {
    Some(i) => i == u,
    None => false,
  };
}

// The optional unit index `u` (a prelude unit) is absent or points at one of `n` units.
@Ensures(result == (u.isNone() || u.unwrap() < n))
function unitBelow(u: Option<usize>, n: usize): bool {
  return match (u) {
    Some(i) => i < n,
    None => true,
  };
}

// The cheap well-formedness conditions of an environment: the unit indexes it stores point at units
// and the instance table is no larger than the number of records, unions and functions (an instance
// owns one id of those tables; two instances never share one) and every function-value wrapper is a
// lifted function.
@Ensures(result == (env.entry < env.units.length
    && unitBelow(env.mapUnit, env.units.length)
    && unitBelow(env.parUnit, env.units.length)
    && unitBelow(env.prelude, env.units.length)
    && env.insts.size() <= env.records.length + env.unions.length + env.funcs.length
    && env.wrappers.size <= env.lifted.length))
export function isWellFormedEnv(env: Env): bool {
  return env.entry < env.units.length
      && unitBelow(env.mapUnit, env.units.length)
      && unitBelow(env.parUnit, env.units.length)
      && unitBelow(env.prelude, env.units.length)
      && env.insts.size() <= env.records.length + env.unions.length + env.funcs.length
      && env.wrappers.size <= env.lifted.length;
}

// An environment of one empty unit (no declarations): the starting point for unit tests of the
// checker's building blocks.
@Ensures(isWellFormedEnv(result) && result.units.length == 1 && result.records.length == 0)
export function emptyEnv(): Env {
  const noLifted: Function[] = [];
  const noVts: VTable[] = [];
  return Env {
    units: [UnitInfo { name: "test", file: 0, scope: emptyNames(), ox: -1 }],
    aliases: [],
    records: [],
    unions: [],
    funcs: [],
    consts: [],
    entry: 0,
    gtypes: [],
    gfuncs: [],
    insts: new Insts(),
    classes: [],
    ifaces: [],
    bounds: new Map<usize, usize[]>(),
    vtables: noVts,
    lifted: noLifted,
    wrappers: new Map<string, usize>(),
    prelude: None,
    mapUnit: None,
    parUnit: None,
    sealed: []
  };
}
