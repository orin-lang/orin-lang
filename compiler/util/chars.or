// Character classes and hex digits on byte values (`charCodeAt`).

// `0`..`9`.
@Ensures(result == (c >= 48 && c <= 57))
export function isDigit(c: int): bool {
  return c >= 48 && c <= 57;
}

// Space, tab, newline and carriage return: the whitespace set of JSON (and of the solver's S-expressions).
@Ensures(result == (c == 32 || c == 9 || c == 10 || c == 13))
export function isJsonSpace(c: int): bool {
  return c == 32 || c == 9 || c == 10 || c == 13;
}

// Value of a hex digit character (either case), or -1.
@Ensures(result >= -1 && result < 16)
@Ensures(c >= 48 && c <= 57 ==> result == c - 48)
@Ensures(c >= 97 && c <= 102 ==> result == c - 87)
@Ensures(c >= 65 && c <= 70 ==> result == c - 55)
@Ensures((result >= 0) == (c >= 48 && c <= 57 || c >= 97 && c <= 102 || c >= 65 && c <= 70))
export function hexVal(c: int): int {
  if (c >= 48 && c <= 57) {
    return c - 48;
  }
  if (c >= 97 && c <= 102) {
    return c - 87;
  }
  if (c >= 65 && c <= 70) {
    return c - 55;
  }
  return -1;
}

// The lowercase hex digit of `n` (0..15).
export function hexDigitLower(n: int): string {
  return String.fromCharCode(n < 10 ? 48 + n : 87 + n);
}

// The uppercase hex digit of `n` (0..15).
export function hexDigitUpper(n: int): string {
  return String.fromCharCode(n < 10 ? 48 + n : 55 + n);
}
