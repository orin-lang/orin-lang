// Lexer for Orin source text (docs/bootstrap-subset.md §1): class `Lexer`.
// Produces a flat token array that always ends with one KEof token. The first lexical error stops the lexer;
// errors are E0100. Positions are `usize` byte offsets.

import { Span, Diagnostic, span, diag } from "../diag";
import { isDigit, hexVal } from "../util";

// Token classes. Punctuation and keywords share one class each; the exact
// spelling is in `Token.text` (e.g. KPunct with text "=>", KKeyword with text "let").
// Reserved words (`var`, `class`, ...) are KKeyword too; the parser rejects them.
// KFloat (beyond Orin-B, ADR-0018): `text` is the canonical spelling, always with a `.` (`1e9` -> `1.0e9`).
// KBigInt (ADR-0022): an integer literal in 2^63 .. 2^64-1 (a `u64` value); `value` holds the 64-bit pattern
// as a (negative) int. Template literals (ADR-0022) are lexed into KTplFull (`...` without interpolation), or
// KTplHead (`...${), zero or more KTplMid (}...${), and KTplTail (}...`) with the expression tokens in between;
// `text` is the cooked (unescaped) text of that chunk, the span covers the delimiters.
// OX (ADR-0043) is lexed in its own modes: KOxOpen (`<` starting a tag, `</` starting a closing tag, `<:` / `</:` the same for a named slot, ADR-0044), KOxEnd (`>` or
// `/>` ending a tag) and KOxText (text between tags, cooked: whitespace rules applied and entities decoded, never
// empty). Inside a tag, names (which may contain `-`, and are never keywords) are KIdent, `=` and the braces of
// `{expr}` are KPunct and values are KStr; between `{` and `}` the ordinary tokens.
export type TokKind =
  KIdent
  | KKeyword
  | KInt
  | KBigInt
  | KFloat
  | KStr
  | KPunct
  | KEof
  | KTplFull
  | KTplHead
  | KTplMid
  | KTplTail
  | KOxOpen
  | KOxEnd
  | KOxText;

// `text`: source spelling; for KStr and the template kinds the unescaped bytes. `value`: integer value for KInt /
// KBigInt, else 0.
export type Token = { kind: TokKind; text: string; span: Span; value: int; };

const INT_MAX: int = 9223372036854775807;

@Ensures(result == match (t.kind) { KEof => true, _ => false })
export function isEofTok(t: Token): bool {
  return match (t.kind) {
    KEof => true,
    _ => false,
  };
}

// The token stream of a source of `n` bytes in file `file` is well formed: every token lies in the source and in the
// file, the tokens are in source order and do not overlap, only the last token is KEof and it is the empty span at
// the end, every other token is non-empty. (The parser relies on the final KEof: it never reads past it.)
export function tokensWellFormed(toks: Token[], file: usize, n: usize): bool {
  if (toks.length == 0) {
    return false;
  }
  const last = toks[toks.length - 1];
  if (!isEofTok(last) || last.span.start != n || last.span.end != n) {
    return false;
  }
  let prevEnd: usize = 0;
  for (const t of toks) {
    if (t.span.file != file || t.span.start < prevEnd || t.span.end > n) {
      return false;
    }
    if (!isEofTok(t) && t.span.end <= t.span.start) {
      return false;
    }
    prevEnd = t.span.end;
  }
  return toks.filter(t => isEofTok(t)).length == 1;
}

@Ensures(result == (c >= 65 && c <= 90 || c >= 97 && c <= 122 || c == 95))
function isAlpha(c: int): bool {
  return c >= 65 && c <= 90 || c >= 97 && c <= 122 || c == 95;
}

export function isKeyword(s: string): bool {
  return s == "const"
      || s == "let"
      || s == "function"
      || s == "return"
      || s == "if"
      || s == "else"
      || s == "while"
      || s == "for"
      || s == "of"
      || s == "break"
      || s == "continue"
      || s == "type"
      || s == "import"
      || s == "export"
      || s == "from"
      || s == "match"
      || s == "true"
      || s == "false";
}

// Reserved words: lexed as keywords so they can never be identifiers.
export function isReserved(s: string): bool {
  return s == "var"
      || s == "class"
      || s == "interface"
      || s == "enum"
      || s == "new"
      || s == "this"
      || s == "null"
      || s == "undefined"
      || s == "async"
      || s == "await";
}

// Value of the digits src[a..b) in `base`, or -1 if it exceeds i64 max (no overflow trap).
@Requires(a <= b && b <= src.length)
@Ensures(result >= -1)
function digitsValue(src: string, a: usize, b: usize, base: int): int {
  let v: int = 0;
  let i = a;
  while (i < b) {
    const d = hexVal(src.charCodeAt(i));
    if (v > (INT_MAX - d) / base) {
      return -1;
    }
    v = v * base + d;
    i += 1;
  }
  return v;
}

// Value of the digits src[a..b) (at least one, base 10 or 16) when it lies in 2^63 .. 2^64-1, as the 64-bit
// pattern (a negative int); None if it exceeds 2^64-1. The caller knows it exceeds i64 max. The last digit is
// split off so that no intermediate overflows: value = 2 * (prefix * base/2) + d, pattern = value - 2^64.
@Requires(a < b && b <= src.length && (base == 10 || base == 16))
@Ensures(result.isNone() || result.unwrap() < 0)
function bigDigitsValue(src: string, a: usize, b: usize, base: int): Option<int> {
  const prefix = digitsValue(src, a, b - 1, base);
  const half = base / 2;
  if (prefix < 0 || prefix > INT_MAX / half) {
    return None;
  }
  const d = hexVal(src.charCodeAt(b - 1));
  const x = prefix * half;
  const y = x - INT_MAX - 1;
  const t = y + d;
  if (t > -1 - y) {
    return None; // 2*y + d would be >= 0, i.e. the literal exceeds 2^64-1
  }
  return Some(y + t);
}

// Character code for a simple escape letter (`n t r 0 \ " '`), or -1.
@Ensures(result >= -1 && result <= 255)
function simpleEscape(e: int): int {
  if (e == 110) {
    return 10;
  }
  if (e == 116) {
    return 9;
  }
  if (e == 114) {
    return 13;
  }
  if (e == 48) {
    return 0;
  }
  if (e == 92 || e == 34 || e == 39) {
    return e;
  }
  return -1;
}

// One chunk of a template literal (ADR-0022), starting at `start` just after the opening backtick or the `}`
// that closes an interpolation. Scans the cooked text up to the closing backtick (`ended`) or a `${`.
// `open` is the offset of the delimiter that began the chunk (for error spans). Escapes: those of string
// literals plus `\``, `\$`; a raw newline is kept (CRLF becomes LF); a `$` not followed by `{` is literal.
type TplChunk = { text: string; end: usize; ended: bool; };

@Requires(open < start && start <= src.length)
@Ensures(result.isOk() ==> result.unwrap().end > start && result.unwrap().end <= src.length)
@Ensures(result.isErr() ==> result.unwrapErr().span.end <= src.length)
function lexTemplateChunk(
  file: usize,
  src: string,
  open: usize,
  start: usize,
): Result<TplChunk, Diagnostic> {
  const n = src.length;
  let parts: string[] = [];
  let i = start;
  let run = i;
  @Invariant(start <= i && i <= n)
  @Invariant(run <= i)
  while (true) {
    if (i >= n) {
      return Err(diag("E0100", span(file, open, open + 1), "unterminated template literal"));
    }
    const c = src.charCodeAt(i);
    if (c == 96) {
      parts.push(src.substring(run, i));
      return Ok(TplChunk { text: parts.join(""), end: i + 1, ended: true });
    }
    if (c == 36 && i + 1 < n && src.charCodeAt(i + 1) == 123) {
      parts.push(src.substring(run, i));
      return Ok(TplChunk { text: parts.join(""), end: i + 2, ended: false });
    }
    if (c == 13 && i + 1 < n && src.charCodeAt(i + 1) == 10) {
      parts.push(src.substring(run, i));
      i += 1;
      run = i;
    } else if (c == 92) {
      parts.push(src.substring(run, i));
      if (i + 1 >= n) {
        return Err(diag("E0100", span(file, open, n), "unterminated template literal"));
      }
      const e = src.charCodeAt(i + 1);
      let code = simpleEscape(e);
      let adv: usize = 2;
      if (e == 96 || e == 36) {
        code = e;
      }
      if (e == 120) {
        if (i + 3 >= n) {
          return Err(diag("E0100", span(file, i, n), "invalid \\x escape"));
        }
        const h1 = hexVal(src.charCodeAt(i + 2));
        const h2 = hexVal(src.charCodeAt(i + 3));
        if (h1 < 0 || h2 < 0) {
          return Err(diag("E0100", span(file, i, i + 4), "invalid \\x escape"));
        }
        code = h1 * 16 + h2;
        adv = 4;
      }
      if (code < 0) {
        return Err(diag("E0100", span(file, i, i + 2), "unknown escape sequence"));
      }
      parts.push(String.fromCharCode(code));
      i += adv;
      run = i;
    } else {
      i += 1;
    }
  }
  return Err(diag("E0100", span(file, open, open + 1), "unterminated template literal"));
}

// The next significant offset at or after `start` (whitespace and comments skipped). A pure function, not a
// method: it runs once per token and reads only the source.
@Requires(start <= src.length)
@Ensures(result.isOk() ==> result.unwrap() >= start && result.unwrap() <= src.length)
@Ensures(result.isErr() ==> result.unwrapErr().span.end <= src.length)
function skipTrivia(file: usize, src: string, start: usize): Result<usize, Diagnostic> {
  const n = src.length;
  let i = start;
  @Invariant(start <= i && i <= n)
  while (i < n) {
    const c = src.charCodeAt(i);
    if (c == 32 || c == 9 || c == 10 || c == 13) {
      i += 1;
    } else if (c == 47 && i + 1 < n && src.charCodeAt(i + 1) == 47) {
      i += 2;
      @Invariant(start <= i && i <= n)
      while (i < n && src.charCodeAt(i) != 10) {
        i += 1;
      }
    } else if (c == 47 && i + 1 < n && src.charCodeAt(i + 1) == 42) {
      const cstart = i;
      i += 2;
      let closed = false;
      @Invariant(cstart + 2 <= i && i <= n)
      while (i < n && !closed) {
        if (src.charCodeAt(i) == 42 && i + 1 < n && src.charCodeAt(i + 1) == 47) {
          closed = true;
          i += 2;
        } else {
          i += 1;
        }
      }
      if (!closed) {
        return Err(diag("E0100", span(file, cstart, cstart + 2), "unterminated block comment"));
      }
    } else {
      return Ok(i);
    }
  }
  return Ok(i);
}

// ---------------------------------------------------------------------------
// OX text (ADR-0043)
// ---------------------------------------------------------------------------

// Lexical contexts (Lexer.ctx).
const CTX_TPL: int = 0;
const CTX_OX_EXPR: int = 1;
const CTX_OX_TAG: int = 2;
const CTX_OX_KIDS: int = 3;
const CTX_OX_CLOSE: int = 4;

// The UTF-8 bytes of code point `cp`, or "" when `cp` is not a Unicode scalar value (0, a surrogate, above U+10FFFF).
@Ensures(result.length <= 4)
@Ensures(cp > 0 && cp < 128 ==> result.length == 1)
export function utf8Of(cp: int): string {
  if (cp <= 0 || cp > 1114111 || cp >= 55296 && cp <= 57343) {
    return "";
  }
  if (cp < 128) {
    return String.fromCharCode(cp);
  }
  if (cp < 2048) {
    return String.fromCharCode(192 + cp / 64) + String.fromCharCode(128 + cp % 64);
  }
  if (cp < 65536) {
    return String.fromCharCode(224 + cp / 4096)
        + String.fromCharCode(128 + cp / 64 % 64)
        + String.fromCharCode(128 + cp % 64);
  }
  return String.fromCharCode(240 + cp / 262144)
      + String.fromCharCode(128 + cp / 4096 % 64)
      + String.fromCharCode(128 + cp / 64 % 64)
      + String.fromCharCode(128 + cp % 64);
}

// The code point of the named character reference `name` (without `&` and `;`), or -1. A small table: the five XML
// entities, `nbsp` and common typography; any other `&name;` stays literal text (it is then escaped on output).
@Ensures(result == -1 || result > 0)
export function namedEntity(name: string): int {
  return match (name) {
    "amp" => 38,
    "lt" => 60,
    "gt" => 62,
    "quot" => 34,
    "apos" => 39,
    "nbsp" => 160,
    "copy" => 169,
    "reg" => 174,
    "deg" => 176,
    "middot" => 183,
    "laquo" => 171,
    "raquo" => 187,
    "times" => 215,
    "ndash" => 8211,
    "mdash" => 8212,
    "lsquo" => 8216,
    "rsquo" => 8217,
    "ldquo" => 8220,
    "rdquo" => 8221,
    "hellip" => 8230,
    "euro" => 8364,
    "trade" => 8482,
    _ => -1,
  };
}

// The code point of the reference `body` (between `&` and `;`): a name, `#ddd` or `#xhh`; -1 if it is none of them or
// out of range.
export function entityCode(body: string): int {
  if (body.length < 2 || body.charCodeAt(0) != 35) {
    return namedEntity(body);
  }
  let base: int = 10;
  let i: usize = 1;
  if (body.charCodeAt(1) == 120 || body.charCodeAt(1) == 88) {
    base = 16;
    i = 2;
  }
  if (i >= body.length || body.length - i > 6) {
    return -1;
  }
  let v: int = 0;
  while (i < body.length) {
    const d = hexVal(body.charCodeAt(i));
    if (d < 0 || d >= base) {
      return -1;
    }
    v = v * base + d;
    i += 1;
  }
  return v;
}

// `s` with every character reference (`&amp;`, `&#169;`, `&#xA9;`, ...) replaced by the UTF-8 bytes it denotes. A `&`
// that starts no known reference is kept. Never longer than `s` (a reference is at least as long as its bytes).
@Ensures(result.length <= s.length)
export function decodeEntities(s: string): string {
  if (!s.includes("&")) {
    return s;
  }
  let parts: string[] = [];
  let run: usize = 0;
  let i: usize = 0;
  @Invariant(run <= i && i <= s.length)
  while (i < s.length) {
    let decoded = false;
    if (s.charCodeAt(i) == 38) {
      let j = i + 1;
      @Invariant(i < j && j <= s.length)
      while (j < s.length && j - i <= 10 && s.charCodeAt(j) != 59 && s.charCodeAt(j) != 38) {
        j += 1;
      }
      if (j < s.length && s.charCodeAt(j) == 59) {
        const bytes = utf8Of(entityCode(s.substring(i + 1, j)));
        if (bytes.length > 0) {
          parts.push(s.substring(run, i));
          parts.push(bytes);
          i = j + 1;
          run = i;
          decoded = true;
        }
      }
    }
    if (!decoded) {
      i += 1;
    }
  }
  parts.push(s.substring(run, s.length));
  return parts.join("");
}

// One line of OX text with the whitespace rules applied (`first` / `last`: the first / last line of the text): tabs
// count as spaces; leading spaces are dropped except on the first line, trailing spaces except on the last line.
@Ensures(result.length <= line.length)
function oxTrimLine(line: string, first: bool, last: bool): string {
  let a: usize = 0;
  let b = line.length;
  if (!first) {
    while (a < b && (line.charCodeAt(a) == 32 || line.charCodeAt(a) == 9)) {
      a += 1;
    }
  }
  if (!last) {
    while (b > a && (line.charCodeAt(b - 1) == 32 || line.charCodeAt(b - 1) == 9 || line.charCodeAt(b - 1) == 13)) {
      b -= 1;
    }
  }
  const t = line.substring(a, b);
  return t.includes("\t") ? t.split("\t").join(" ") : t;
}

// The value of raw OX text `raw` (between tags), as React / TypeScript define it: entities decoded, then the text is
// split into lines, each line trimmed (`oxTrimLine`), empty lines dropped and the rest joined with one space. Text that
// is only whitespace with a line break yields "" (no child); `a  b` on one line keeps both spaces.
@Ensures(result.length <= raw.length)
export function cookOxText(raw: string): string {
  const lines = decodeEntities(raw).split("\n");
  let kept: string[] = [];
  let i: usize = 0;
  while (i < lines.length) {
    const t = oxTrimLine(lines[i], i == 0, i + 1 == lines.length);
    if (t.length > 0) {
      kept.push(t);
    }
    i += 1;
  }
  return kept.join(" ");
}

// A `.` right after an identifier, `)` or `]` is a member access (`a.1` is then a parse error, not a float).
function isMemberBase(c: int): bool {
  return isAlpha(c) || isDigit(c) || c == 41 || c == 93;
}

// The lexer state: the source, the cursor `pos` and the tokens so far. `ctx` is the stack of open lexical contexts
// (innermost last): CTX_TPL an open `${ .. }` of a template literal, CTX_OX_EXPR an open `{ .. }` inside OX,
// CTX_OX_TAG / CTX_OX_CLOSE the inside of an OX opening / closing tag, CTX_OX_KIDS the children of an OX element.
// `depth` (parallel to `ctx`) holds the brace depth inside each open `{` context (0 for the others). The tokens are in source order and end at or before the cursor
// (the full order / non-overlap property, `tokensWellFormed`, is the `@Ensures` of `run`). The first lexical error is
// kept in `err` and ends the lexer: the methods return nothing, so a call costs no `(self, result)` pair (one per token).
@Invariant(this.pos <= this.src.length)
@Invariant(this.toks.length == 0 || this.toks[this.toks.length - 1].span.end <= this.pos)
@Invariant(this.depth.every(d => d >= 0))
@Invariant(this.depth.length == this.ctx.length)
@Invariant(this.ctx.every(k => k >= CTX_TPL && k <= CTX_OX_CLOSE))
@Invariant(!this.done || this.err.isSome() || this.pos == this.src.length)
@Invariant(this.err.isNone() || this.done)
@Invariant(this.err.isNone()
    || this.err.unwrap().code == "E0100" && this.err.unwrap().span.end <= this.src.length)
export class Lexer {
  private file: usize;
  private src: string;
  private pos: usize = 0;
  private toks: Token[] = [];
  private depth: int[] = [];
  private ctx: int[] = [];
  private done: bool = false;
  private err: Option<Diagnostic> = None;

  constructor(file: usize, src: string) {
    this.file = file;
    this.src = src;
  }

  // The cursor: the offset of the next byte to lex.
  position(): usize {
    return this.pos;
  }

  // The tokens lexed so far (without the final KEof until `run` returns).
  tokens(): Token[] {
    return this.toks;
  }

  // True once only trivia was left (the cursor is at the end of the source and `run` appends KEof) or after an error.
  finished(): bool {
    return this.done;
  }

  // The first lexical error, if any (it finished the lexer).
  error(): Option<Diagnostic> {
    return this.err;
  }

  // Records the first error and stops.
  @Requires(this.err.isNone() && d.code == "E0100" && d.span.end <= this.src.length)
  @Ensures(this.done && this.err.isSome())
  private fail(d: Diagnostic): void {
    this.err = Some(d);
    this.done = true;
  }

  // Lexes the next token (after whitespace and comments): one token is added, it starts at or after the old cursor and
  // ends at the new one, so the cursor advanced (progress: `run` terminates). When only trivia was left, no token is
  // added, the cursor is at the end of the source and the lexer is `finished`. A lexical error finishes it with `error`.
  @Requires(!this.done)
  @Ensures(!this.done
      ==> this.pos > old(this.pos)
          && this.toks.length == old(this.toks.length) + 1
          && this.toks[this.toks.length - 1].span.start >= old(this.pos)
          && this.toks[this.toks.length - 1].span.end == this.pos)
  @Ensures(this.done && this.err.isNone()
      ==> this.pos == this.src.length && this.toks.length == old(this.toks.length))
  @Ensures(this.pos <= this.src.length)
  @Ensures(this.err.isNone()
      || this.err.unwrap().code == "E0100" && this.err.unwrap().span.end <= this.src.length)
  step(): void {
    const mode = this.mode();
    if (mode == CTX_OX_KIDS) {
      this.oxChild();
      return;
    }
    const sk = skipTrivia(this.file, this.src, this.pos);
    if (sk.isErr()) {
      this.fail(sk.unwrapErr());
      return;
    }
    this.pos = sk.unwrap();
    const src = this.src;
    const n = src.length;
    const i = this.pos;
    if (i >= n) {
      this.done = true;
      return;
    }
    if (mode == CTX_OX_TAG || mode == CTX_OX_CLOSE) {
      this.oxTag(mode);
      return;
    }
    const c = src.charCodeAt(i);
    if (isAlpha(c)) {
      this.ident();
      return;
    }
    if (c == 60 && this.oxStarts(i)) {
      this.emit(KOxOpen, "<", i, i + 1, 0);
      this.enter(CTX_OX_TAG);
      return;
    }
    if (isDigit(c)) {
      const isHex = c == 48
          && i + 1 < n
          && (src.charCodeAt(i + 1) == 120 || src.charCodeAt(i + 1) == 88);
      if (!isHex) {
        const before = this.toks.length;
        this.float();
        if (this.done || this.toks.length > before) {
          return;
        }
      }
      this.number();
      return;
    }
    if (c == 34) {
      this.string();
      return;
    }
    if (c == 96) {
      const r = lexTemplateChunk(this.file, src, i, i + 1);
      if (r.isErr()) {
        this.fail(r.unwrapErr());
        return;
      }
      const ch = r.unwrap();
      this.emit(ch.ended ? KTplFull : KTplHead, ch.text, i, ch.end, 0);
      if (!ch.ended) {
        this.enter(CTX_TPL);
      }
      return;
    }
    const open = this.depth.length;
    if (c == 123 && open > 0) {
      this.depth[open - 1] += 1;
    }
    if (c == 125 && open > 0) {
      if (this.depth[open - 1] == 0 && this.ctx[open - 1] == CTX_OX_EXPR) {
        // the `}` of an OX `{expr}`: back to the tag or the children it was written in
        this.emit(KPunct, "}", i, i + 1, 0);
        this.leave();
        return;
      }
      if (this.depth[open - 1] == 0) {
        const r = lexTemplateChunk(this.file, src, i, i + 1);
        if (r.isErr()) {
          this.fail(r.unwrapErr());
          return;
        }
        const ch = r.unwrap();
        this.emit(ch.ended ? KTplTail : KTplMid, ch.text, i, ch.end, 0);
        if (ch.ended) {
          this.leave();
        }
        return;
      }
      this.depth[open - 1] -= 1;
    }
    this.punct();
  }

  // The whole token stream: lexes to the end, checks that every template interpolation was closed and appends KEof.
  @Requires(this.pos == 0 && this.toks.length == 0 && !this.done)
  @Ensures(result.isOk() ==> tokensWellFormed(result.unwrap(), this.file, this.src.length))
  @Ensures(result.isOk() ==> result.unwrap().length > 0 && isEofTok(result.unwrap()[result.unwrap().length - 1]))
  @Ensures(result.isErr()
      ==> result.unwrapErr().code == "E0100" && result.unwrapErr().span.end <= this.src.length)
  run(): Result<Token[], Diagnostic> {
    // The class invariants again: the verifier havocs `this` at the start of an iteration and assumes the callee's
    // class invariants only for a receiver that satisfies them (`step` maintains them). Not run time checks (loop
    // invariants are type-checked only, compiler/check/rtcheck.or); the two quantifiers range over the context stack.
    @Invariant(this.pos <= this.src.length)
    @Invariant(this.toks.length == 0 || this.toks[this.toks.length - 1].span.end <= this.pos)
    @Invariant(this.depth.every(d => d >= 0))
    @Invariant(this.depth.length == this.ctx.length)
    @Invariant(this.ctx.every(k => k >= CTX_TPL && k <= CTX_OX_CLOSE))
    @Invariant(!this.done || this.err.isSome() || this.pos == this.src.length)
    @Invariant(this.err.isNone() || this.done)
    @Invariant(this.err.isNone()
        || this.err.unwrap().code == "E0100" && this.err.unwrap().span.end <= this.src.length)
    while (!this.done) {
      this.step();
    }
    if (this.err.isSome()) {
      return Err(this.err.unwrap());
    }
    const n = this.src.length;
    if (this.ctx.length > 0 && this.ctx[this.ctx.length - 1] != CTX_TPL) {
      return Err(diag("E0100", span(this.file, n, n), "unterminated OX element (missing closing tag or `}`)"));
    }
    if (this.depth.length > 0) {
      return Err(
        diag(
          "E0100",
          span(this.file, n, n),
          "unterminated template literal interpolation (missing `}`)",
        ),
      );
    }
    this.emit(KEof, "", n, n, 0);
    return Ok(this.toks);
  }

  // The innermost lexical context, or -1 at the top level. (The class invariant on `ctx` is restated: a private method
  // does not get the invariants assumed by the verifier.)
  @Requires(this.ctx.every(k => k >= CTX_TPL && k <= CTX_OX_CLOSE))
  @Ensures(result >= -1 && result <= CTX_OX_CLOSE)
  @Ensures(result == -1 || this.ctx.length > 0)
  private mode(): int {
    const k = this.ctx.length;
    return k == 0 ? -1 : this.ctx[k - 1];
  }

  @Requires(k >= CTX_TPL && k <= CTX_OX_CLOSE)
  @Ensures(this.ctx.length == old(this.ctx.length) + 1)
  private enter(k: int): void {
    this.ctx.push(k);
    this.depth.push(0);
  }

  @Requires(this.ctx.length > 0)
  @Ensures(this.ctx.length == old(this.ctx.length) - 1)
  private leave(): void {
    this.ctx.pop();
    this.depth.pop();
  }

  // Replaces the innermost context (an OX tag becomes the children of its element, the children its closing tag).
  @Requires(this.ctx.length > 0 && k >= CTX_TPL && k <= CTX_OX_CLOSE)
  @Ensures(this.ctx.length == old(this.ctx.length))
  private become(k: int): void {
    this.ctx[this.ctx.length - 1] = k;
  }

  // Whether the `<` at `i` starts an OX element (ADR-0043): it is followed by a tag name or `>` (a fragment), and the
  // previous token cannot end an operand, so `<` cannot be the less-than operator (`a < b`, `f<T>(x)` and
  // `Map<K, V>` all have a name, literal, `)` or `]` before it).
  @Requires(i < this.src.length)
  private oxStarts(i: usize): bool {
    if (i + 1 >= this.src.length) {
      return false;
    }
    const c2 = this.src.charCodeAt(i + 1);
    if (!isAlpha(c2) && c2 != 62) {
      return false;
    }
    const k = this.toks.length;
    if (k == 0) {
      return true;
    }
    const t = this.toks[k - 1];
    return match (t.kind) {
      KPunct => t.text != ")" && t.text != "]" && t.text != "}",
      KKeyword => t.text == "return",
      KTplHead => true,
      KTplMid => true,
      _ => false,
    };
  }

  // One token inside an OX opening (`mode` CTX_OX_TAG) or closing tag (CTX_OX_CLOSE), at a significant offset: a name,
  // `=`, a string value, the `{` of an expression value, or the `>` / `/>` that ends the tag.
  @Requires(!this.done && this.pos < this.src.length)
  @Requires(this.err.isNone())
  @Requires(this.ctx.length > 0)
  private oxTag(mode: int): void {
    const src = this.src;
    const n = src.length;
    const i = this.pos;
    const c = src.charCodeAt(i);
    if (c == 62) {
      this.emit(KOxEnd, ">", i, i + 1, 0);
      if (mode == CTX_OX_TAG) {
        this.become(CTX_OX_KIDS);
      } else {
        this.leave();
      }
      return;
    }
    if (c == 47 && i + 1 < n && src.charCodeAt(i + 1) == 62 && mode == CTX_OX_TAG) {
      this.emit(KOxEnd, "/>", i, i + 2, 0);
      this.leave();
      return;
    }
    if (isAlpha(c)) {
      let j = i + 1;
      @Invariant(i < j && j <= n)
      while (j < n && (isAlpha(src.charCodeAt(j)) || isDigit(src.charCodeAt(j)) || src.charCodeAt(j) == 45)) {
        j += 1;
      }
      this.emit(KIdent, src.substring(i, j), i, j, 0);
      return;
    }
    if (c == 46) {
      // the `.` of a member tag `<ui.Card>` (ADR-0044); the parser checks where it may appear
      this.emit(KPunct, ".", i, i + 1, 0);
      return;
    }
    if (c == 61) {
      this.emit(KPunct, "=", i, i + 1, 0);
      return;
    }
    if (c == 34 || c == 39) {
      this.oxString();
      return;
    }
    if (c == 123 && mode == CTX_OX_TAG) {
      this.emit(KPunct, "{", i, i + 1, 0);
      this.enter(CTX_OX_EXPR);
      return;
    }
    this.fail(diag("E0100", span(this.file, i, i + 1), "unexpected `" + src.charAt(i) + "` in an OX tag"));
  }

  // An OX attribute string at the cursor (`"` or `'`), as in TypeScript: no backslash escapes, line breaks allowed,
  // character references decoded (`title="Tom &amp; Jerry"` is `Tom & Jerry`). The token is a KStr.
  @Requires(this.err.isNone() && this.pos < this.src.length)
  private oxString(): void {
    const src = this.src;
    const start = this.pos;
    const q = src.charCodeAt(start);
    let j = start + 1;
    @Invariant(start < j && j <= src.length)
    while (j < src.length && src.charCodeAt(j) != q) {
      j += 1;
    }
    if (j >= src.length) {
      this.fail(diag("E0100", span(this.file, start, src.length), "unterminated OX attribute string"));
      return;
    }
    this.emit(KStr, decodeEntities(src.substring(start + 1, j)), start, j + 1, 0);
  }

  // One child of an OX element (ADR-0043), at the cursor (no trivia: whitespace and `//` are text here): text up to the
  // next `<` or `{` (not emitted when it cooks to nothing), then that `{` (an expression child), `</` (the closing tag)
  // or `<` (a nested element); `<:` starts a named slot tag and `</:` closes it (ADR-0044). `}` and `>` are not allowed in text (as in TypeScript): write `{"}"}` or `&gt;`.
  @Requires(!this.done)
  @Requires(this.err.isNone() && this.ctx.length > 0 && this.pos <= this.src.length)
  private oxChild(): void {
    const src = this.src;
    const n = src.length;
    const i = this.pos;
    let j = i;
    // (`this.pos`, `this.src`, `this.err` and `this.ctx` are not changed by an iteration that continues: the ones that
    // call `fail` return)
    @Invariant(i <= j && j <= n)
    @Invariant(this.pos == i && this.src.length == n && this.err.isNone() && this.ctx.length > 0)
    while (j < n && src.charCodeAt(j) != 60 && src.charCodeAt(j) != 123) {
      const c = src.charCodeAt(j);
      if (c == 125 || c == 62) {
        this.fail(
          diag(
            "E0100",
            span(this.file, j, j + 1),
            "`" + src.charAt(j) + "` is not allowed in OX text; write {\"" + src.charAt(j) + "\"}"
                + (c == 62 ? " or &gt;" : " (or a closing tag is missing before it)"),
          ),
        );
        return;
      }
      j += 1;
    }
    if (j > i) {
      const text = cookOxText(src.substring(i, j));
      if (text.length > 0) {
        this.emit(KOxText, text, i, j, 0);
        return;
      }
    }
    if (j >= n) {
      this.fail(diag("E0100", span(this.file, n, n), "unterminated OX element (missing closing tag)"));
      return;
    }
    if (src.charCodeAt(j) == 123) {
      this.emit(KPunct, "{", j, j + 1, 0);
      this.enter(CTX_OX_EXPR);
      return;
    }
    if (j + 2 < n && src.charCodeAt(j + 1) == 47 && src.charCodeAt(j + 2) == 58) {
      this.emit(KOxOpen, "</:", j, j + 3, 0);
      this.become(CTX_OX_CLOSE);
      return;
    }
    if (j + 1 < n && src.charCodeAt(j + 1) == 47) {
      this.emit(KOxOpen, "</", j, j + 2, 0);
      this.become(CTX_OX_CLOSE);
      return;
    }
    if (j + 2 < n && src.charCodeAt(j + 1) == 58 && isAlpha(src.charCodeAt(j + 2))) {
      this.emit(KOxOpen, "<:", j, j + 2, 0);
      this.enter(CTX_OX_TAG);
      return;
    }
    if (j + 1 < n && (isAlpha(src.charCodeAt(j + 1)) || src.charCodeAt(j + 1) == 62)) {
      this.emit(KOxOpen, "<", j, j + 1, 0);
      this.enter(CTX_OX_TAG);
      return;
    }
    this.fail(diag("E0100", span(this.file, j, j + 1), "expected a tag name, `>` or `/` after `<` in OX"));
  }

  // Appends a token for src[start..end) and moves the cursor to its end.
  @Requires(start >= this.pos && start <= end && end <= this.src.length)
  @Ensures(this.pos == end && this.toks.length == old(this.toks.length) + 1)
  @Ensures(isEofTok(this.toks[this.toks.length - 1]) == match (kind) { KEof => true, _ => false })
  private emit(kind: TokKind, text: string, start: usize, end: usize, value: int): void {
    this.toks.push(Token {
      kind: kind,
      text: text,
      span: span(this.file, start, end),
      value: value,
    });
    this.pos = end;
  }

  // Identifier or keyword at the cursor (an alphabetic character).
  private ident(): void {
    const src = this.src;
    const n = src.length;
    const start = this.pos;
    let i = start + 1;
    while (i < n && (isAlpha(src.charCodeAt(i)) || isDigit(src.charCodeAt(i)))) {
      i += 1;
    }
    const text = src.substring(start, i);
    let kind: TokKind = KIdent;
    if (isKeyword(text) || isReserved(text)) {
      kind = KKeyword;
    }
    this.emit(kind, text, start, i, 0);
  }

  // Integer literal at the cursor (decimal or `0x` hexadecimal).
  @Requires(this.err.isNone() && this.pos < this.src.length)
  private number(): void {
    const src = this.src;
    const file = this.file;
    const n = src.length;
    const start = this.pos;
    let base: int = 10;
    let i = start;
    if (src.charCodeAt(start) == 48
        && start + 1 < n
        && (src.charCodeAt(start + 1) == 120 || src.charCodeAt(start + 1) == 88)) {
      base = 16;
      i = start + 2;
    }
    const dstart = i;
    if (base == 16) {
      @Invariant(start <= dstart && dstart <= i && i <= n)
      while (i < n && hexVal(src.charCodeAt(i)) >= 0) {
        i += 1;
      }
    } else {
      @Invariant(start <= dstart && dstart <= i && i <= n)
      while (i < n && isDigit(src.charCodeAt(i))) {
        i += 1;
      }
    }
    if (i == dstart) {
      this.fail(diag("E0100", span(file, start, i), "hexadecimal literal has no digits"));
      return;
    }
    if (i < n && (isAlpha(src.charCodeAt(i)) || isDigit(src.charCodeAt(i)))) {
      this.fail(diag("E0100", span(file, start, i + 1), "invalid character in number literal"));
      return;
    }
    const v = digitsValue(src, dstart, i, base);
    let big: Option<int> = None;
    if (v < 0) {
      big = bigDigitsValue(src, dstart, i, base);
      if (big.isNone()) {
        this.fail(
          diag(
            "E0100",
            span(file, start, i),
            "integer literal does not fit in 64 bits (the largest is 18446744073709551615)",
          ),
        );
        return;
      }
    }
    if (base == 16 && i + 1 < n && src.charCodeAt(i) == 46 && isDigit(src.charCodeAt(i + 1))) {
      this.fail(
        diag("E0100", span(file, start, i + 1), "hexadecimal float literals are not supported"),
      );
      return;
    }
    if (big.isSome()) {
      this.emit(KBigInt, src.substring(start, i), start, i, big.unwrap());
    } else {
      this.emit(KInt, src.substring(start, i), start, i, v);
    }
    return;
  }

  // Float literal (ADR-0018) at the cursor (a digit): `D+ . D+ [exp]` or `D+ exp` with exp = `(e|E) [+-]? D+`.
  // No token and nothing consumed when the text is not a float literal (so it is an integer).
  @Requires(this.err.isNone() && this.pos < this.src.length)
  @Ensures(!this.done && this.toks.length == old(this.toks.length) ==> this.pos == old(this.pos))
  @Ensures(this.toks.length > old(this.toks.length) ==> this.pos > old(this.pos))
  private float(): void {
    const src = this.src;
    const file = this.file;
    const n = src.length;
    const start = this.pos;
    let i = start;
    @Invariant(start <= i && i <= n)
    while (i < n && isDigit(src.charCodeAt(i))) {
      i += 1;
    }
    const intEnd = i;
    let fracStart = i;
    let fracEnd = i;
    let hasFrac = false;
    if (i + 1 < n && src.charCodeAt(i) == 46 && isDigit(src.charCodeAt(i + 1))) {
      hasFrac = true;
      fracStart = i + 1;
      i += 1;
      @Invariant(start <= intEnd && intEnd < fracStart && fracStart <= i && i <= n)
      while (i < n && isDigit(src.charCodeAt(i))) {
        i += 1;
      }
      fracEnd = i;
    }
    let hasExp = false;
    let expSign = "";
    let expStart = i;
    let expEnd = i;
    if (i < n && (src.charCodeAt(i) == 101 || src.charCodeAt(i) == 69)) {
      let j = i + 1;
      let sg = "";
      if (j < n && (src.charCodeAt(j) == 43 || src.charCodeAt(j) == 45)) {
        sg = src.charAt(j);
        j += 1;
      }
      if (j < n && isDigit(src.charCodeAt(j))) {
        hasExp = true;
        expSign = sg;
        expStart = j;
        @Invariant(i < expStart && expStart <= j && j <= n)
        while (j < n && isDigit(src.charCodeAt(j))) {
          j += 1;
        }
        expEnd = j;
        i = j;
      }
    }
    if (!hasFrac && !hasExp) {
      return;
    }
    if (i < n && (isAlpha(src.charCodeAt(i)) || isDigit(src.charCodeAt(i)))) {
      this.fail(diag("E0100", span(file, start, i + 1), "invalid character in number literal"));
      return;
    }
    // Range: decimal magnitude of the value must not exceed 308 (no float arithmetic here, so estimate
    // from the number of significant integer digits and the exponent).
    let intDigits: usize = 0;
    let seenNonZero = false;
    let k = start;
    @Invariant(start <= k && k <= intEnd && intEnd <= i && i <= n)
    while (k < intEnd) {
      if (src.charCodeAt(k) != 48) {
        seenNonZero = true;
      }
      if (seenNonZero) {
        intDigits += 1;
      }
      k += 1;
    }
    if (hasExp) {
      if (expEnd - expStart > 4) {
        this.fail(diag("E0100", span(file, start, i), "float literal exponent out of range"));
        return;
      }
      const ev = digitsValue(src, expStart, expEnd, 10);
      if (seenNonZero && expSign != "-" && intDigits.toInt() - 1 + ev > 308) {
        this.fail(diag("E0100", span(file, start, i), "float literal out of range for `float`"));
        return;
      }
    } else if (intDigits > 309) {
      this.fail(diag("E0100", span(file, start, i), "float literal out of range for `float`"));
      return;
    }
    let text = src.substring(start, intEnd) + ".";
    if (hasFrac) {
      text += src.substring(fracStart, fracEnd);
    } else {
      text += "0";
    }
    if (hasExp) {
      text += "e" + expSign + src.substring(expStart, expEnd);
    }
    this.emit(KFloat, text, start, i, 0);
    return;
  }

  // String literal at the cursor (the opening quote). The token text is the unescaped content.
  @Requires(this.err.isNone() && this.pos < this.src.length)
  private string(): void {
    const src = this.src;
    const file = this.file;
    const n = src.length;
    const start = this.pos;
    let parts: string[] = [];
    let i = start + 1;
    let run = i;
    let closed = false;
    // (an iteration that continues leaves `this` as it was: the ones that call `fail` return)
    @Invariant(start < i && i <= n && run <= i)
    @Invariant(this.pos == start && this.src.length == n && this.err.isNone())
    while (!closed) {
      if (i >= n) {
        this.fail(diag("E0100", span(file, start, n), "unterminated string literal"));
        return;
      }
      const c = src.charCodeAt(i);
      if (c == 34) {
        parts.push(src.substring(run, i));
        i += 1;
        closed = true;
      } else if (c == 10) {
        this.fail(diag("E0100", span(file, start, i), "unterminated string literal"));
        return;
      } else if (c == 92) {
        parts.push(src.substring(run, i));
        if (i + 1 >= n) {
          this.fail(diag("E0100", span(file, start, n), "unterminated string literal"));
          return;
        }
        const e = src.charCodeAt(i + 1);
        let code = simpleEscape(e);
        let adv: usize = 2;
        if (e == 120) {
          if (i + 3 >= n) {
            this.fail(diag("E0100", span(file, i, n), "invalid \\x escape"));
            return;
          }
          const h1 = hexVal(src.charCodeAt(i + 2));
          const h2 = hexVal(src.charCodeAt(i + 3));
          if (h1 < 0 || h2 < 0) {
            this.fail(diag("E0100", span(file, i, i + 4), "invalid \\x escape"));
            return;
          }
          code = h1 * 16 + h2;
          adv = 4;
        }
        if (code < 0) {
          this.fail(diag("E0100", span(file, i, i + 2), "unknown escape sequence"));
          return;
        }
        parts.push(String.fromCharCode(code));
        i += adv;
        run = i;
      } else {
        i += 1;
      }
    }
    this.emit(KStr, parts.join(""), start, i, 0);
    return;
  }

  // Punctuation at the cursor (longest match), or the lexical error for a character that starts no token.
  @Requires(this.err.isNone() && this.pos < this.src.length)
  private punct(): void {
    const src = this.src;
    const file = this.file;
    const n = src.length;
    const start = this.pos;
    const c = src.charCodeAt(start);
    let c2: int = 0;
    if (start + 1 < n) {
      c2 = src.charCodeAt(start + 1);
    }
    const ch = src.charAt(start);
    let len: usize = 0;
    if (c == 46 && isDigit(c2) && !(start > 0 && isMemberBase(src.charCodeAt(start - 1)))) {
      this.fail(
        diag(
          "E0100",
          span(file, start, start + 2),
          "a float literal needs a digit before the decimal point (write `0"
              + src.substring(start, start + 2) + "`)",
        ),
      );
      return;
    }
    if (c == 46 && c2 == 46) {
      if (start + 2 < n && src.charCodeAt(start + 2) == 46) {
        len = 3;
      } else {
        this.fail(
          diag("E0100", span(file, start, start + 2), "unexpected `..`; did you mean `...`?"),
        );
        return;
      }
    } else if (c == 61 && c2 == 61 && start + 2 < n && src.charCodeAt(start + 2) == 62) {
      len = 3; // `==>` (implication, contract expressions only: ADR-0012)
    } else if (c2 == 61 && "=!+-*/%<>".includes(ch)) {
      len = 2;
    } else if (c == 61 && c2 == 62 || c == 38 && c2 == 38 || c == 124 && c2 == 124) {
      len = 2;
    } else if ("(){}[],;:.?=+-*/%<>!|&".includes(ch)) {
      len = 1;
    } else if (c == 64 && start + 1 < n && isAlpha(c2)) {
      len = 1; // `@Name`: contract clause / annotation (ADR-0012); a lone `@` stays a lexical error
    } else {
      if (c >= 128) {
        this.fail(diag("E0100", span(file, start, start + 1), "unexpected non-ASCII character"));
        return;
      }
      this.fail(diag("E0100", span(file, start, start + 1), "unexpected character `" + ch + "`"));
      return;
    }
    this.emit(KPunct, src.substring(start, start + len), start, start + len, 0);
    return;
  }
}

// The tokens of `src` (file `file`), ending with KEof; or the first lexical error (E0100), whose span lies in the source.
@Ensures(result.isOk() ==> tokensWellFormed(result.unwrap(), file, src.length))
@Ensures(result.isOk() ==> result.unwrap().length > 0 && isEofTok(result.unwrap()[result.unwrap().length - 1]))
@Ensures(result.isErr()
    ==> result.unwrapErr().code == "E0100"
        && result.unwrapErr().span.file == file
        && result.unwrapErr().span.end <= src.length)
export function lex(file: usize, src: string): Result<Token[], Diagnostic> {
  let lx = new Lexer(file, src);
  return lx.run();
}
