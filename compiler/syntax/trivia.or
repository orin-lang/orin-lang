// Comment trivia scanner (spec 18 §1: comments are preserved for the formatter).
// The lexer discards comments; this scanner finds them again from the source text.
// It is string-literal aware, so `//` inside a string is not a comment.
// Only meaningful for source text that lexes successfully. OX elements (ADR-0043) are skipped as a whole: their text
// is not code (`http://x` in text is no comment), and `orin fmt` prints them verbatim with any comments inside.

import { Token, lex } from "./lexer";

// A `//` or `/* */` comment. `[start, end)` is its byte span; `text` is the raw source text
// (for line comments without trailing whitespace). `ownLine`: only whitespace precedes it on its
// line. `blankBefore`: a blank line separates it from the previous token or comment.
export type Comment = {
  start: usize;
  end: usize;
  text: string;
  isLine: bool;
  ownLine: bool;
  blankBefore: bool;
};

function isSpace(c: int): bool {
  return c == 32 || c == 9 || c == 13 || c == 11 || c == 12;
}

function mkComment(
  src: string,
  start: usize,
  end: usize,
  isLine: bool,
  ownLine: bool,
  blank: bool,
): Comment {
  return Comment {
    start: start,
    end: end,
    text: src.substring(start, end),
    isLine: isLine,
    ownLine: ownLine,
    blankBefore: blank,
  };
}

// Index just after the template-literal text that starts at `i` (just past a backtick or the `}` ending an
// interpolation): at the closing backtick (`ended`) or after a `${`.
type TplEnd = { end: usize; ended: bool; };

function scanTemplateText(src: string, start: usize): TplEnd {
  const n = src.length;
  let i = start;
  while (i < n) {
    const d = src.charCodeAt(i);
    if (d == 92) {
      i += 2;
    } else if (d == 96) {
      return TplEnd { end: i + 1, ended: true };
    } else if (d == 36 && i + 1 < n && src.charCodeAt(i + 1) == 123) {
      return TplEnd { end: i + 2, ended: false };
    } else {
      i += 1;
    }
  }
  return TplEnd { end: n, ended: true };
}

// The comments found in `src` are what the formatter can rely on: each lies in the source, is non-empty, starts with
// `//` (a line comment) or `/*`, holds exactly its source text, and they are in source order without overlap. (A
// comment that overlapped the next or held other text would be printed twice or garbled by `orin fmt`.)
export function commentsWellFormed(cs: Comment[], src: string): bool {
  let prevEnd: usize = 0;
  for (const c of cs) {
    if (c.start < prevEnd
        || c.end <= c.start
        || c.end > src.length
        || c.text != src.substring(c.start, c.end)) {
      return false;
    }
    if (c.isLine != c.text.startsWith("//") || !c.isLine && !c.text.startsWith("/*")) {
      return false;
    }
    prevEnd = c.end;
  }
  return true;
}

// The extents of the outermost OX elements of `src` as flat pairs `start, end` in source order (none when `src` does
// not lex). Nesting is counted on the tokens: `<` (or `<:`, a named slot) opens an element, `/>` closes it, `</` or `</:` .. `>` closes it.
@Ensures(result.length % 2 == 0)
export function oxRegions(src: string): usize[] {
  let out: usize[] = [];
  if (!src.includes("<")) {
    return out;
  }
  const r = lex(0, src);
  if (r.isErr()) {
    return out;
  }
  let depth: usize = 0;
  let closing = false;
  for (const t of r.unwrap()) {
    match (t.kind) {
      KOxOpen => {
        if (t.text == "</" || t.text == "</:") {
          closing = true;
        } else {
          if (depth == 0) {
            out.push(t.span.start);
          }
          depth += 1;
        }
      },
      KOxEnd => {
        if ((t.text == "/>" || closing) && depth > 0) {
          depth -= 1;
          if (depth == 0) {
            out.push(t.span.end);
          }
        }
        closing = false;
      },
      _ => {},
    }
  }
  if (out.length % 2 == 1) {
    out.push(src.length);
  }
  return out;
}

@Ensures(commentsWellFormed(result, src))
export function scanComments(src: string): Comment[] {
  let out: Comment[] = [];
  const n = src.length;
  const ox = oxRegions(src);
  let k: usize = 0;
  let i: usize = 0;
  let nl: int = 0;
  let lineStart = true;
  // brace depth inside each open template interpolation; comments there stay part of the (verbatim) template
  let depth: int[] = [];
  while (i < n) {
    while (k < ox.length && ox[k + 1] <= i) {
      k += 2;
    }
    if (k < ox.length && ox[k] == i) {
      i = ox[k + 1];
      k += 2;
      nl = 0;
      lineStart = false;
      continue;
    }
    const c = src.charCodeAt(i);
    if (c == 96) {
      const t = scanTemplateText(src, i + 1);
      i = t.end;
      if (!t.ended) {
        depth.push(0);
      }
      nl = 0;
      lineStart = false;
    } else if (depth.length > 0 && c == 123) {
      depth[depth.length - 1] += 1;
      i += 1;
    } else if (depth.length > 0 && c == 125) {
      if (depth[depth.length - 1] == 0) {
        const t = scanTemplateText(src, i + 1);
        i = t.end;
        if (t.ended) {
          depth.pop();
        }
      } else {
        depth[depth.length - 1] -= 1;
        i += 1;
      }
    } else if (c == 10) {
      nl += 1;
      lineStart = true;
      i += 1;
    } else if (isSpace(c)) {
      i += 1;
    } else if (c == 34) {
      i += 1;
      while (i < n) {
        const d = src.charCodeAt(i);
        if (d == 92) {
          i += 2;
        } else if (d == 34) {
          i += 1;
          break;
        } else if (d == 10) {
          break;
        } else {
          i += 1;
        }
      }
      nl = 0;
      lineStart = false;
    } else if (c == 47 && i + 1 < n && src.charCodeAt(i + 1) == 47) {
      const s = i;
      @Invariant(s <= i && i <= n)
      while (i < n && src.charCodeAt(i) != 10) {
        i += 1;
      }
      let e = i;
      @Invariant(s <= e && e <= i && i <= n)
      while (e > s && isSpace(src.charCodeAt(e - 1))) {
        e -= 1;
      }
      if (depth.length == 0) {
        out.push(mkComment(src, s, e, true, lineStart, nl >= 2));
      }
      nl = 0;
      lineStart = false;
    } else if (c == 47 && i + 1 < n && src.charCodeAt(i + 1) == 42) {
      const s = i;
      i += 2;
      let closed = false;
      while (i < n && !closed) {
        if (src.charCodeAt(i) == 42 && i + 1 < n && src.charCodeAt(i + 1) == 47) {
          closed = true;
          i += 2;
        } else {
          i += 1;
        }
      }
      if (depth.length == 0) {
        out.push(mkComment(src, s, i, false, lineStart, nl >= 2));
      }
      nl = 0;
      lineStart = false;
    } else {
      nl = 0;
      lineStart = false;
      i += 1;
    }
  }
  return out;
}
