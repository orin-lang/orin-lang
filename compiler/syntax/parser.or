// Recursive-descent parser: source text -> ast.Module (docs/bootstrap-subset.md §2, §4, §5): class `Parser`.
// Errors: E0200 (syntax), E0201 (`var`), E0408 (constructs the language rejects at parse time), E0440 / E0441 / E0442
// (annotations). Lexical errors (E0100) come from `lex`. `parse` stops at the first error. `parseRecovering` reports
// up to MAX_SYNTAX_ERRORS errors per file (error recovery, docs/rewrite.md "Parser error recovery"): after an error
// the parser skips to the next statement of the block, the next member of the class or interface, or the next
// top-level declaration. Its first error is always the one `parse` reports. When the file has errors the partial tree
// is dropped, so no node built by recovery reaches the checker.
//
// The parser holds the tokens and a cursor `pos`. Every `parseX` method starts at the cursor and leaves it at the
// first token after the construct. Progress: every successful `parseX` consumes at least one token (stated as an
// `@Ensures`, mostly `spansFrom`: the node's span is exactly the extent of the tokens it consumed). The only methods
// that may consume nothing are `parseTypeParamsB` / `parseTypeParams` (no `<`) and the speculative `tryTypeArgs`
// (None), which leave the cursor where it was. Every loop of the parser calls a consuming method or stops at a token
// it does not consume, so the parser terminates on any input; the final KEof token is never consumed. The four loops
// that recover (block statements, class members, interface methods, module items) continue after a failed iteration
// only when the recovery moved the cursor past the start of the failed construct or onto the `}` that ends the loop
// (the `@Ensures` of `recoverStmt` / `recoverMember` / `recoverItem`), so recovery cannot spin either.

import { Span, Diagnostic, spanTo, diag } from "../diag";
import {
  Ident, Module, Item, ImportDecl, plainImport, FunctionDecl, Param, TypeDecl, TypeDeclBody, FieldDecl,
  VariantDecl, ConstDecl, TypeExpr, TypeExprKind, Block, Stmt, AssignOp, StmtKind, Expr, UnaryOp,
  BinaryOp, ExprKind, FieldInit, MatchArm, ArmBody, Pattern, PatternKind, InterfaceDecl,
  IfaceMethod, ClassDecl, ClassMember, ClassField, CtorDecl, CtorParam, MethodDecl, FnTyParam,
  ArrowParam, ArrowBody, ContractKind, ContractClause, AnnotationKind, Annotation,
  OxElement, OxAttr, OxValue, OxChild,
} from "./ast";
import { Token, lex, isEofTok } from "./lexer";
import { OpTable } from "./precedence";
import {
  T_FUNCTION, T_METHOD, T_CTOR, T_CLASS, T_RECORD, T_TYPE, T_LOOP, T_INTERFACE, T_IFACE_METHOD,
  T_CONST, T_IMPORT, T_FIELD, checkPlacement, checkAnnoPlacement, isBuiltinAnnotation, annotationName,
  annotationTargets, isClauseName, isTargetWord,
} from "./rules";
import {
  exprShallowOk, stmtShallowOk, typeShallowOk, patShallowOk, blockShallowOk, itemShallowOk,
  memberShallowOk, itemSpan, memberSpan, moduleWellFormed,
} from "./wellformed";

// Type parameters with their optional bounds (parallel); `any`: some parameter has a bound.
type Bounds = { ids: Ident[]; bounds: Ident[][]; any: bool; };

// Contract clauses and annotations before a declaration; `first` is the span of the first one.
type Decos = { clauses: ContractClause[]; annos: Annotation[]; first: Span; };

// Parameters, result type and body of a function or method.
type Sig = { params: Param[]; ret: Option<TypeExpr>; body: Block; };

function describe(t: Token): string {
  return match (t.kind) {
    KEof => "end of file",
    KStr => "string literal",
    KTplFull => "template literal",
    KTplHead => "template literal",
    KTplMid => "`}` in a template literal",
    KTplTail => "`}` in a template literal",
    KOxText => "OX text",
    _ => "`" + t.text + "`",
  };
}

// Syntax error at token `t`; a stray `var` keyword always reports E0201.
@Ensures(result.code == "E0200" || result.code == "E0201")
@Ensures(result.span.start == t.span.start && result.span.end == t.span.end)
function errAt(t: Token, msg: string): Diagnostic {
  const isVar = match (t.kind) {
    KKeyword => t.text == "var",
    _ => false,
  };
  if (isVar) {
    return diag("E0201", t.span, "`var` is not allowed; use `const` or `let`");
  }
  return diag("E0200", t.span, msg);
}

@Ensures(result ==> !isEofTok(t))
function isPunctTok(t: Token, s: string): bool {
  return match (t.kind) {
    KPunct => t.text == s,
    _ => false,
  };
}

@Ensures(result ==> !isEofTok(t))
function isKeywordTok(t: Token, s: string): bool {
  return match (t.kind) {
    KKeyword => t.text == s,
    _ => false,
  };
}

@Ensures(result ==> !isEofTok(t))
function isIdentTok(t: Token, s: string): bool {
  return match (t.kind) {
    KIdent => t.text == s,
    _ => false,
  };
}

@Ensures(result ==> !isEofTok(t))
function isAnyIdentTok(t: Token): bool {
  return match (t.kind) {
    KIdent => true,
    _ => false,
  };
}

@Ensures(result ==> !isEofTok(t))
function isKindInt(t: Token): bool {
  return match (t.kind) {
    KInt => true,
    _ => false,
  };
}

@Ensures(result ==> !isEofTok(t))
function isStrTok(t: Token): bool {
  return match (t.kind) {
    KStr => true,
    _ => false,
  };
}

function assignOpOf(s: string): AssignOp {
  if (s == "=") {
    return OpAssign;
  }
  if (s == "+=") {
    return OpAddAssign;
  }
  if (s == "-=") {
    return OpSubAssign;
  }
  if (s == "*=") {
    return OpMulAssign;
  }
  if (s == "/=") {
    return OpDivAssign;
  }
  return OpRemAssign;
}

function isMatchExpr(e: Expr): bool {
  return match (e.kind) {
    EMatch(_, _) => true,
    _ => false,
  };
}

@Ensures(result.span.file == sp.file && result.span.start == sp.start && result.span.end == sp.end)
function mkExpr(kind: ExprKind, sp: Span): Expr {
  return Expr { kind: kind, span: sp };
}

// Error recovery: at most this many syntax errors per file; when there are more, the last reported one carries
// SUPPRESSED_NOTE and the parse stops.
export const MAX_SYNTAX_ERRORS: usize = 20;
export const SUPPRESSED_NOTE: string = "further syntax errors suppressed";

@Ensures(result ==> !isEofTok(t))
function isKwTok(t: Token, s: string): bool {
  return match (t.kind) {
    KKeyword => t.text == s,
    _ => false,
  };
}

// A keyword that starts a top-level declaration (inside a block or a class body it means a `}` is missing).
@Ensures(result ==> !isEofTok(t))
function isDeclKwTok(t: Token): bool {
  return match (t.kind) {
    KKeyword => t.text == "function"
        || t.text == "class"
        || t.text == "interface"
        || t.text == "type"
        || t.text == "import"
        || t.text == "export",
    _ => false,
  };
}

// A token where a statement starts for sure: a statement keyword or `@` (loop contract clauses).
@Ensures(result ==> !isEofTok(t))
function isStmtStartTok(t: Token): bool {
  return match (t.kind) {
    KKeyword => t.text == "let"
        || t.text == "const"
        || t.text == "if"
        || t.text == "while"
        || t.text == "for"
        || t.text == "return"
        || t.text == "break"
        || t.text == "continue",
    KPunct => t.text == "@",
    _ => false,
  };
}

// The same diagnostic: code, message, span and notes.
export function sameDiag(a: Diagnostic, b: Diagnostic): bool {
  return a.code == b.code
      && a.message == b.message
      && a.span.file == b.span.file
      && a.span.start == b.span.start
      && a.span.end == b.span.end
      && a.notes.join("\n") == b.notes.join("\n")
      && a.notes.length == b.notes.length;
}

// The errors of a recovering parse of a source of `len` bytes in file `file`: one to MAX_SYNTAX_ERRORS parse errors with
// spans inside the source, strictly ordered by their start (no error reported twice, none out of order); only the last
// may carry a note, SUPPRESSED_NOTE, and only when the cap is reached.
export function syntaxErrorsOk(ds: Diagnostic[], file: usize, len: usize): bool {
  if (ds.length == 0 || ds.length > MAX_SYNTAX_ERRORS) {
    return false;
  }
  let i: usize = 0;
  while (i < ds.length) {
    const d = ds[i];
    if (!isSyntaxCode(d.code) || d.span.file != file || d.span.end > len) {
      return false;
    }
    if (i > 0 && ds[i - 1].span.start >= d.span.start) {
      return false;
    }
    if (d.notes.length > 0
        && (i + 1 != MAX_SYNTAX_ERRORS || d.notes.length != 1 || d.notes[0] != SUPPRESSED_NOTE)) {
      return false;
    }
    i += 1;
  }
  return true;
}

// The codes a parse error can have.
export function isSyntaxCode(code: string): bool {
  return code == "E0100"
      || code == "E0200"
      || code == "E0201"
      || code == "E0408"
      || code == "E0440"
      || code == "E0441"
      || code == "E0442"
      || code == "E0447"
      || code == "E0460";
}

function hasIdentNamed(ids: Ident[], name: string): bool {
  for (const i of ids) {
    if (i.name == name) {
      return true;
    }
  }
  return false;
}

type ImportNames = { names: Ident[]; aliases: Option<Ident>[]; };

// The parser over a token stream that ends with KEof (`lex` output). The cursor stays on a token: it never moves past
// the final KEof. Error recovery (only after `enableRecovery`): `errs` holds the errors reported so far (at most
// MAX_SYNTAX_ERRORS); an error that starts at or before `floor` (the last error, or the token a recovery resumed at) is
// dropped as a cascade; `unwinding` makes every catcher propagate the error to `parseModule`, which resumes at the cursor
// (a declaration keyword, or the final KEof when the parse has stopped).
@Invariant(this.toks.length > 0 && isEofTok(this.toks[this.toks.length - 1]))
@Invariant(this.pos < this.toks.length)
@Invariant(this.errs.length <= MAX_SYNTAX_ERRORS)
@Invariant(!this.recovering ==> this.errs.length == 0 && !this.unwinding)
@Invariant(this.errs.length > 0 ==> this.errs[this.errs.length - 1].span.start <= this.floor)
export class Parser {
  private toks: Token[];
  private pos: usize = 0;
  private ops: OpTable = new OpTable();
  private recovering: bool = false;
  private errs: Diagnostic[] = [];
  private floor: usize = 0;
  private unwinding: bool = false;
  private sawProvider: bool = false; // an `import ox from` was parsed (ADR-0044: at most one per file)
  private nsNames: string[] = []; // the namespace imports of the file (`import * as m`), found by a scan of the tokens
  private nsUses: Ident[] = []; // every `m.x` merged into one identifier so far (ADR-0048 addendum)

  @Requires(toks.length > 0 && isEofTok(toks[toks.length - 1]))
  constructor(toks: Token[]) {
    this.toks = toks;
    let i: usize = 0;
    while (i + 3 < toks.length) {
      if (isKeywordTok(toks[i], "import") && isPunctTok(toks[i + 1], "*") && isIdentTok(toks[i + 2], "as") && isAnyIdentTok(toks[i + 3])) {
        this.nsNames.push(toks[i + 3].text);
      }
      i += 1;
    }
  }

  // Report several errors (see `parseRecovering`) instead of stopping at the first.
  @Ensures(this.recovering && this.errs.length == old(this.errs.length))
  enableRecovery(): void {
    this.recovering = true;
  }

  // The errors reported by a recovering parse, in source order.
  errors(): Diagnostic[] {
    return this.errs;
  }

  // ---------------------------------------------------------------------------
  // Error recovery
  // ---------------------------------------------------------------------------
  // Recovery points: a statement of a block (`recoverStmt`), a member of a class or interface body (`recoverMember`),
  // a top-level declaration (`recoverItem`). The innermost catcher reports the error and skips tokens; when it finds a
  // declaration keyword (a `}` is missing) or the end of the file it sets `unwinding`, and the error travels to
  // `parseModule` unreported. Progress: every recovery that lets a loop continue leaves the cursor past the start of
  // the construct that failed, or on the `}` that ends the loop (stated as `@Ensures`), so recovery never spins.

  // Reports `d` unless it is a cascade (it starts at or before the last error or resume point). The error past the cap
  // is not reported: the last reported one gets SUPPRESSED_NOTE and the parse stops.
  @Requires(this.recovering)
  @Requires(this.pos < this.toks.length && this.toks.length > 0 && isEofTok(this.toks[this.toks.length - 1]))
  @Ensures(this.pos == old(this.pos) && this.unwinding == old(this.unwinding)
      || this.unwinding && this.pos == this.toks.length - 1)
  @Ensures(this.errs.length >= old(this.errs.length)
      && this.errs.length <= old(this.errs.length) + 1)
  @Ensures(this.errs.length == old(this.errs.length) + 1
      ==> sameDiag(this.errs[this.errs.length - 1], d))
  private report(d: Diagnostic): void {
    if (this.errs.length > 0 && d.span.start <= this.floor) {
      return;
    }
    if (this.errs.length == MAX_SYNTAX_ERRORS) {
      const last = this.errs[MAX_SYNTAX_ERRORS - 1];
      this.errs[MAX_SYNTAX_ERRORS - 1] = Diagnostic {
        code: last.code,
        message: last.message,
        span: last.span,
        notes: last.notes.concat([SUPPRESSED_NOTE]),
      };
      this.stop();
      return;
    }
    this.errs.push(d);
    if (d.span.start > this.floor) {
      this.floor = d.span.start;
    }
  }

  // Ends the parse: the cursor goes to the final KEof and the catchers unwind.
  @Requires(this.toks.length > 0 && isEofTok(this.toks[this.toks.length - 1]))
  @Ensures(this.unwinding && this.atEnd())
  @Ensures(this.pos == this.toks.length - 1)
  private stop(): void {
    this.pos = this.toks.length - 1;
    this.unwinding = true;
  }

  // Continue at token `i`. An error at that token or the next one is taken as a cascade of the recovery and dropped:
  // a construct that fails at once after a resume point means the tokens are still out of step (a `}` missing or
  // doubled), and every following line would report "expected `(` or `:` in class member, found `.`" and the like.
  @Requires(i < this.toks.length)
  @Ensures(this.pos == i && result && this.floor >= this.toks[i].span.start)
  private resumeAt(i: usize): bool {
    this.pos = i;
    const s = this.tokAbs(i + 1).span.start;
    if (s > this.floor) {
      this.floor = s;
    }
    return true;
  }

  // Unwind to the top level, which continues at token `i` (a declaration keyword).
  @Requires(i < this.toks.length)
  @Ensures(this.pos == i && this.unwinding && !result)
  private unwindAt(i: usize): bool {
    this.resumeAt(i);
    this.unwinding = true;
    return false;
  }

  // `{` minus `}` in the tokens `first` .. `last` - 1, never below zero: the brace nesting of the cursor relative to the
  // start of the construct that failed.
  private braceDepth(first: usize, last: usize): usize {
    let depth: usize = 0;
    let i = first;
    while (i < last) {
      const t = this.toks[i];
      if (isPunctTok(t, "{")) {
        depth += 1;
      } else if (isPunctTok(t, "}") && depth > 0) {
        depth -= 1;
      }
      i += 1;
    }
    return depth;
  }

  // A statement of a block failed with `d`; it started at token `st`. Reports `d` and skips to the next statement:
  // after a `;` at the statement's brace level; to a `}` that closes the block (not consumed); past the `}` that ends
  // the body of an `if` / `while` / `for` / block statement (unless `else` follows); or to a token after the error that
  // starts a statement. False (propagate `d`): no recovery, the parse is unwinding, a declaration keyword at the
  // statement's level (resume there, at the top level) or the end of the file (stop).
  @Requires(st <= this.pos && this.pos < this.toks.length && this.toks.length > 0 && isEofTok(this.toks[this.toks.length - 1]))
  @Ensures(result ==> this.recovering && !this.unwinding && (this.pos > st || this.isP("}")))
  @Ensures(!result && this.recovering ==> this.unwinding)
  private recoverStmt(d: Diagnostic, st: usize): bool {
    if (!this.recovering || this.unwinding) {
      return false;
    }
    this.report(d);
    if (this.unwinding) {
      return false;
    }
    const fail = this.pos;
    let depth = this.braceDepth(st, fail);
    const first = this.toks[st];
    const bodied = isKwTok(first, "if")
        || isKwTok(first, "while")
        || isKwTok(first, "for")
        || isPunctTok(first, "{");
    let i = fail;
    @Invariant(fail <= i && i < this.toks.length && this.toks.length > 0 && isEofTok(this.toks[this.toks.length - 1]))
    @Invariant(this.recovering && !this.unwinding)
    while (true) {
      const t = this.toks[i];
      if (isEofTok(t)) {
        this.stop();
        return false;
      }
      if (isPunctTok(t, "{")) {
        depth += 1;
      } else if (isPunctTok(t, "}")) {
        if (depth == 0) {
          return this.resumeAt(i);
        }
        depth -= 1;
        if (depth == 0 && bodied && !isKwTok(this.tokAbs(i + 1), "else")) {
          return this.resumeAt(i + 1);
        }
      } else if (depth == 0) {
        if (isPunctTok(t, ";")) {
          return this.resumeAt(i + 1);
        }
        if (isDeclKwTok(t)) {
          return this.unwindAt(i);
        }
        if (i > fail && isStmtStartTok(t)) {
          return this.resumeAt(i);
        }
      }
      i += 1;
    }
    return false;
  }

  // A member of a class or interface body failed with `d`; it started at token `st`. Reports `d` and skips to the next
  // member: after a `;` or after the `}` that closes a method body, at the member's brace level; to a `@` after the
  // error; to the `}` that closes the body (not consumed). False: as `recoverStmt`.
  @Requires(st <= this.pos && this.pos < this.toks.length && this.toks.length > 0 && isEofTok(this.toks[this.toks.length - 1]))
  @Ensures(result ==> this.recovering && !this.unwinding && (this.pos > st || this.isP("}")))
  @Ensures(!result && this.recovering ==> this.unwinding)
  private recoverMember(d: Diagnostic, st: usize): bool {
    if (!this.recovering || this.unwinding) {
      return false;
    }
    this.report(d);
    if (this.unwinding) {
      return false;
    }
    const fail = this.pos;
    let depth = this.braceDepth(st, fail);
    let i = fail;
    @Invariant(fail <= i && i < this.toks.length && this.toks.length > 0 && isEofTok(this.toks[this.toks.length - 1]))
    @Invariant(this.recovering && !this.unwinding)
    while (true) {
      const t = this.toks[i];
      if (isEofTok(t)) {
        this.stop();
        return false;
      }
      if (isPunctTok(t, "{")) {
        depth += 1;
      } else if (isPunctTok(t, "}")) {
        if (depth == 0) {
          return this.resumeAt(i);
        }
        depth -= 1;
        if (depth == 0) {
          return this.resumeAt(i + 1);
        }
      } else if (depth == 0) {
        if (isPunctTok(t, ";")) {
          return this.resumeAt(i + 1);
        }
        if (isDeclKwTok(t)) {
          return this.unwindAt(i);
        }
        if (i > fail && isPunctTok(t, "@")) {
          return this.resumeAt(i);
        }
      }
      i += 1;
    }
    return false;
  }

  // A top-level declaration failed with `d`; it started at token `st`. Reports `d` (unless it was reported where it was
  // caught, `unwinding`) and skips to the next `function`, `class`, `interface`, `type`, `import`, `export` or `@` at the
  // declaration's brace level after the error, or to the end of the file. False only without recovery.
  @Requires(st <= this.pos && this.pos < this.toks.length && this.toks.length > 0 && isEofTok(this.toks[this.toks.length - 1]))
  @Ensures(result == this.recovering)
  @Ensures(result ==> !this.unwinding && (this.pos > st || this.atEnd()))
  private recoverItem(d: Diagnostic, st: usize): bool {
    if (!this.recovering) {
      return false;
    }
    if (this.unwinding) {
      this.unwinding = false;
      return true;
    }
    this.report(d);
    if (this.unwinding) {
      this.unwinding = false;
      return true;
    }
    const fail = this.pos;
    let depth = this.braceDepth(st, fail);
    let i = fail;
    @Invariant(fail <= i && i < this.toks.length)
    while (!isEofTok(this.toks[i])) {
      const t = this.toks[i];
      if (isPunctTok(t, "{")) {
        depth += 1;
      } else if (isPunctTok(t, "}")) {
        if (depth > 0) {
          depth -= 1;
        }
      } else if (depth == 0 && i > fail && (isDeclKwTok(t) || isPunctTok(t, "@"))) {
        // A declaration keyword or `@` at the top level is a reliable resume point, and an annotation error starts
        // at its `@`: no cascade window here (unlike `resumeAt`).
        this.pos = i;
        return true;
      }
      i += 1;
    }
    this.pos = i;
    return true;
  }

  // ---------------------------------------------------------------------------
  // Cursor and token tests
  // ---------------------------------------------------------------------------

  // The index of the current token.
  position(): usize {
    return this.pos;
  }

  // True at the final KEof token.
  @Ensures(result == isEofTok(this.toks[this.pos]))
  atEnd(): bool {
    return isEofTok(this.toks[this.pos]);
  }

  // The token `k` after the cursor; positions past the end read as the final KEof token.
  private at(k: usize): Token {
    const i = this.pos + k;
    if (i < this.toks.length) {
      return this.toks[i];
    }
    return this.toks[this.toks.length - 1];
  }

  // The token at index `i`, clamped like `at`.
  private tokAbs(i: usize): Token {
    if (i < this.toks.length) {
      return this.toks[i];
    }
    return this.toks[this.toks.length - 1];
  }

  private isP(s: string): bool {
    return isPunctTok(this.toks[this.pos], s);
  }

  private isPAt(k: usize, s: string): bool {
    return isPunctTok(this.at(k), s);
  }

  private isKw(s: string): bool {
    const t = this.toks[this.pos];
    return match (t.kind) {
      KKeyword => t.text == s,
      _ => false,
    };
  }

  private isKwAt(k: usize, s: string): bool {
    const t = this.at(k);
    return match (t.kind) {
      KKeyword => t.text == s,
      _ => false,
    };
  }

  private isEof(): bool {
    return isEofTok(this.toks[this.pos]);
  }

  private isIdentAt(k: usize): bool {
    return match (this.at(k).kind) {
      KIdent => true,
      _ => false,
    };
  }

  // Contextual keyword: an identifier with exactly this spelling, `k` tokens after the cursor.
  private isIdentText(k: usize, s: string): bool {
    const t = this.at(k);
    return match (t.kind) {
      KIdent => t.text == s,
      _ => false,
    };
  }

  // Span of the last consumed token (the cursor has moved at least once; `pos < toks.length` is the class invariant,
  // restated for the verifier, which does not assume it in a private method).
  @Requires(this.pos >= 1 && this.pos < this.toks.length)
  private lastSpan(): Span {
    return this.toks[this.pos - 1].span;
  }

  // `sp` is exactly the extent of the tokens consumed since index `first`: at least one token was consumed, the span
  // starts with the first of them and ends with the last. (Progress plus a span that neither misses nor overshoots.)
  private spansFrom(sp: Span, first: usize): bool {
    return first < this.pos
        && sp.file == this.toks[first].span.file
        && sp.start == this.toks[first].span.start
        && sp.end == this.toks[this.pos - 1].span.end;
  }

  private errExpectedAt(k: usize, what: string): Diagnostic {
    const t = this.at(k);
    return errAt(t, "expected " + what + ", found " + describe(t));
  }

  private errExpected(what: string): Diagnostic {
    return this.errExpectedAt(0, what);
  }

  // Consumes the punctuation `s` or reports what was found instead.
  @Ensures(result.isOk() ==> this.pos == old(this.pos) + 1)
  @Ensures(result.isErr() ==> this.pos == old(this.pos))
  private expectP(s: string): Result<void, Diagnostic> {
    if (this.isP(s)) {
      this.pos += 1;
      return Ok();
    }
    return Err(this.errExpected("`" + s + "`"));
  }

  @Ensures(result.isOk() ==> this.pos == old(this.pos) + 1)
  @Ensures(result.isErr() ==> this.pos == old(this.pos))
  private expectKw(s: string): Result<void, Diagnostic> {
    if (this.isKw(s)) {
      this.pos += 1;
      return Ok();
    }
    return Err(this.errExpected("`" + s + "`"));
  }

  @Ensures(result.isOk()
      ==> this.pos == old(this.pos) + 1 && this.spansFrom(result.unwrap().span, old(this.pos)))
  private parseIdent(): Result<Ident, Diagnostic> {
    const t = this.toks[this.pos];
    const ok = match (t.kind) {
      KIdent => true,
      _ => false,
    };
    if (ok) {
      if (t.text.startsWith("__g")) {
        return Err(
          diag("E0447", t.span, "identifiers starting with `__g` are reserved for generated code (ADR-0046)"),
        );
      }
      this.pos += 1;
      return Ok(Ident { name: t.text, span: t.span });
    }
    return Err(this.errExpected("identifier"));
  }

  // ---------------------------------------------------------------------------
  // Types
  // ---------------------------------------------------------------------------

  // True if the tokens at the cursor start a function type: `(` followed by `)` or `name :`.
  private isFnTypeStart(): bool {
    if (!this.isP("(")) {
      return false;
    }
    if (this.isPAt(1, ")")) {
      return true;
    }
    return this.isIdentAt(1) && this.isPAt(2, ":");
  }

  // `(a: T, b: U) => R` (beyond Orin-B, ADR-0011) or a parenthesised type `(T)` followed by any
  // number of `[]`; the cursor is at the `(`.
  @Ensures(result.isOk()
      ==> this.spansFrom(result.unwrap().span, old(this.pos)) && typeShallowOk(result.unwrap()))
  private parseParenType(): Result<TypeExpr, Diagnostic> {
    const open = this.toks[this.pos].span;
    if (this.isFnTypeStart()) {
      this.pos += 1;
      let ps: FnTyParam[] = [];
      while (!this.isP(")")) {
        const pn = this.parseIdent()?;
        this.expectP(":")?;
        const pt = this.parseType()?;
        ps.push(FnTyParam { name: pn, ty: pt });
        if (this.isP(",")) {
          this.pos += 1;
        } else if (!this.isP(")")) {
          return Err(this.errExpected("`,` or `)`"));
        }
      }
      this.pos += 1;
      this.expectP("=>")?;
      const rt = this.parseType()?;
      return Ok(TypeExpr { kind: TFn(ps, rt), span: spanTo(open, rt.span) });
    }
    this.pos += 1;
    const inner = this.parseType()?;
    this.expectP(")")?;
    let ty = TypeExpr { kind: inner.kind, span: spanTo(open, this.lastSpan()) };
    while (this.isP("[") && this.isPAt(1, "]")) {
      this.pos += 2;
      ty = TypeExpr { kind: TArray(ty), span: spanTo(ty.span, this.lastSpan()) };
    }
    return Ok(ty);
  }

  // An identifier; when it names a namespace import of the file (`import * as m`) and `.name` follows, both are merged into
  // the one identifier `m.name` (ADR-0048 addendum). No other identifier can contain a `.`, so the checker finds
  // such a name in the file's scope only through the import. The merged identifier is recorded in `nsUses`.
  private parseNameRef(): Result<Ident, Diagnostic> {
    const nm = this.parseIdent()?;
    if (this.isP(".") && this.isAnyIdentAt(1) && this.nsNames.indexOf(nm.name).isSome()) {
      this.pos += 1;
      const mem = this.parseIdent()?;
      const merged = Ident { name: nm.name + "." + mem.name, span: spanTo(nm.span, mem.span) };
      this.nsUses.push(merged);
      return Ok(merged);
    }
    return Ok(nm);
  }

  // `Name`, `Name<A, B>`, followed by any number of `[]`; or a function type (see above).
  @Ensures(result.isOk()
      ==> this.spansFrom(result.unwrap().span, old(this.pos)) && typeShallowOk(result.unwrap()))
  parseType(): Result<TypeExpr, Diagnostic> {
    if (this.isP("(")) {
      return this.parseParenType();
    }
    const nm = this.parseNameRef()?;
    let args: TypeExpr[] = [];
    if (this.isP("<")) {
      this.pos += 1;
      while (true) {
        const a = this.parseType()?;
        args.push(a);
        if (this.isP(",")) {
          this.pos += 1;
        } else {
          break;
        }
      }
      this.expectP(">")?;
    }
    let ty = TypeExpr { kind: TNamed(nm, args), span: spanTo(nm.span, this.lastSpan()) };
    while (this.isP("[") && this.isPAt(1, "]")) {
      this.pos += 2;
      ty = TypeExpr { kind: TArray(ty), span: spanTo(ty.span, this.lastSpan()) };
    }
    return Ok(ty);
  }

  // Optional `<T, U>` list of generic parameter names, each with an optional bound `T extends Shape`
  // (interfaces, ADR-0019), or a list of bounds `T extends Ord & Hash` (ADR-0034 limit lifted). `bounds` is parallel to `ids`; an empty
  // list means no bound. Consumes nothing when there is no `<`.
  @Ensures(result.isOk() ==> result.unwrap().ids.length == result.unwrap().bounds.length)
  @Ensures(result.isOk() ==> result.unwrap().ids.length == 0 == (this.pos == old(this.pos)))
  @Ensures(result.isOk() ==> result.unwrap().any == result.unwrap().bounds.some(b => b.length > 0))
  private parseTypeParamsB(): Result<Bounds, Diagnostic> {
    let ids: Ident[] = [];
    let bounds: Ident[][] = [];
    let any = false;
    if (!this.isP("<")) {
      return Ok(Bounds { ids: ids, bounds: bounds, any: any });
    }
    this.pos += 1;
    while (true) {
      const id = this.parseIdent()?;
      ids.push(id);
      let b: Ident[] = [];
      if (this.isIdentText(0, "extends")) {
        this.pos += 1;
        b.push(this.parseIdent()?);
        any = true;
        while (this.isP("&")) {
          this.pos += 1;
          b.push(this.parseIdent()?);
        }
      }
      bounds.push(b);
      if (this.isP(",")) {
        this.pos += 1;
      } else {
        break;
      }
    }
    this.expectP(">")?;
    return Ok(Bounds { ids: ids, bounds: bounds, any: any });
  }

  // Type parameters of declarations that cannot have bounds (types, classes, methods).
  @Ensures(result.isOk() ==> result.unwrap().length == 0 == (this.pos == old(this.pos)))
  private parseTypeParams(): Result<Ident[], Diagnostic> {
    const here = this.toks[this.pos].span;
    const r = this.parseTypeParamsB()?;
    if (r.any) {
      return Err(
        diag(
          "E0408",
          here,
          "type parameter bounds (`extends`) are only supported on generic functions and classes (ADR-0019, ADR-0026)",
        ),
      );
    }
    return Ok(r.ids);
  }

  // ---------------------------------------------------------------------------
  // Contract clauses (beyond Orin-B, ADR-0012, spec 15 §4.2a)
  // ---------------------------------------------------------------------------
  // `@Requires(e)`, `@Ensures(e)`, `@Invariant(e)`, `@Decreases(e)`, `@Rule("ID")` look like annotations
  // but are dedicated, reserved constructs with their own productions and AST node (ContractClause).
  // `@Test`, `@Deprecated`, `@Inline` are the built-in annotations (ADR-0024); any other `@Name` is E0408.

  // The cursor is at `@`.
  @Requires(this.isP("@"))
  @Ensures(result.isOk() ==> this.spansFrom(result.unwrap().span, old(this.pos)))
  @Ensures(result.isOk()
      ==> result.unwrap().expr.isNone() == (this.toks[old(this.pos) + 1].text == "Rule"))
  private parseClause(): Result<ContractClause, Diagnostic> {
    const at = this.toks[this.pos].span;
    if (!this.isIdentAt(1)) {
      return Err(this.errExpectedAt(1, "a contract clause name after `@`"));
    }
    const nt = this.at(1);
    let kind: ContractKind = CRequires;
    if (nt.text == "Requires") {
      kind = CRequires;
    } else if (nt.text == "Ensures") {
      kind = CEnsures;
    } else if (nt.text == "Invariant") {
      kind = CInvariant;
    } else if (nt.text == "Decreases") {
      kind = CDecreases;
    } else if (nt.text == "Rule") {
      kind = CRule;
    } else if (isBuiltinAnnotation(nt.text)) {
      return Err(
        diag(
          "E0440",
          spanTo(at, nt.span),
          "annotation `@" + nt.text + "` cannot be applied here (it applies to "
              + annotationTargets(nt.text) + ")",
        ),
      );
    } else {
      return Err(
        diag(
          "E0408",
          spanTo(at, nt.span),
          "unknown annotation `@" + nt.text
              + "`: here only the contract clauses @Requires, @Ensures, @Invariant, @Decreases and @Rule "
              + "are allowed (annotations cannot be applied to statements)",
        ),
      );
    }
    this.pos += 2;
    this.expectP("(")?;
    let ex: Option<Expr> = None;
    let rule = "";
    const isRule = match (kind) {
      CRule => true,
      _ => false,
    };
    if (isRule) {
      const st = this.toks[this.pos];
      if (!isStrTok(st)) {
        return Err(this.errExpected("a string literal (rule id)"));
      }
      rule = st.text;
      this.pos += 1;
    } else {
      const e = this.parseExpr()?;
      ex = Some(e);
    }
    this.expectP(")")?;
    return Ok(ContractClause {
      kind: kind,
      expr: ex,
      rule: rule,
      span: spanTo(at, this.lastSpan()),
    });
  }

  // ---------------------------------------------------------------------------
  // Built-in annotations (beyond Orin-B, ADR-0024): `@Test`, `@Deprecated("message")`, `@Inline`
  // ---------------------------------------------------------------------------

  // The cursor is at `@` followed by the name of a built-in annotation.
  @Requires(this.isP("@") && this.isIdentAt(1))
  @Ensures(result.isOk() ==> this.spansFrom(result.unwrap().span, old(this.pos)))
  @Ensures(result.isErr() ==> result.unwrapErr().code == "E0441")
  private parseAnnotation(): Result<Annotation, Diagnostic> {
    const at = this.toks[this.pos].span;
    const nt = this.at(1);
    if (nt.text == "Annotation") {
      return this.parseAnnotationDef();
    }
    if (nt.text == "Deprecated") {
      if (!this.isPAt(2, "(")) {
        return Err(
          diag(
            "E0441",
            spanTo(at, nt.span),
            "`@Deprecated` requires a message: `@Deprecated(\"use other() instead\")`",
          ),
        );
      }
      const st = this.at(3);
      if (!isStrTok(st) || !this.isPAt(4, ")")) {
        return Err(
          diag(
            "E0441",
            spanTo(at, st.span),
            "`@Deprecated` takes exactly one string literal argument (the message)",
          ),
        );
      }
      this.pos += 5;
      return Ok(Annotation {
        kind: ADeprecated,
        message: st.text,
        span: spanTo(at, this.lastSpan()),
      });
    }
    if (this.isPAt(2, "(")) {
      return Err(diag("E0441", spanTo(at, nt.span), "`@" + nt.text + "` takes no arguments"));
    }
    this.pos += 2;
    const kind: AnnotationKind = nt.text == "Test" ? ATest : nt.text == "Sealed" ? ASealed : AInline;
    return Ok(Annotation { kind: kind, message: "", span: spanTo(at, nt.span) });
  }

  // `@Annotation(function, method, ...)` (ADR-0046): the cursor is at `@Annotation`. The target words are keywords or
  // identifiers; each must be one of `isTargetWord`, at most once, and there is at least one.
  @Requires(this.isP("@") && this.isIdentAt(1))
  @Ensures(result.isOk() ==> this.spansFrom(result.unwrap().span, old(this.pos)))
  @Ensures(result.isErr() ==> result.unwrapErr().code == "E0441")
  private parseAnnotationDef(): Result<Annotation, Diagnostic> {
    const at = this.toks[this.pos].span;
    const nt = this.at(1);
    if (!this.isPAt(2, "(")) {
      return Err(
        diag(
          "E0441",
          spanTo(at, nt.span),
          "`@Annotation` requires target words: `@Annotation(function, method, class, type, interface, field, const)`",
        ),
      );
    }
    this.pos += 3;
    let ts: Ident[] = [];
    while (!this.isP(")")) {
      const t = this.toks[this.pos];
      const word = match (t.kind) {
        KIdent => true,
        KKeyword => true,
        _ => false,
      };
      if (!word || !isTargetWord(t.text)) {
        return Err(
          diag(
            "E0441",
            t.span,
            "unknown annotation target " + describe(t)
                + " (targets: function, method, class, type, interface, field, const)",
          ),
        );
      }
      if (ts.some(x => x.name == t.text)) {
        return Err(diag("E0441", t.span, "duplicate annotation target `" + t.text + "`"));
      }
      ts.push(Ident { name: t.text, span: t.span });
      this.pos += 1;
      if (this.isP(",")) {
        this.pos += 1;
      } else if (!this.isP(")")) {
        return Err(this.errExpected("`,` or `)`"));
      }
    }
    if (ts.length == 0) {
      return Err(diag("E0441", spanTo(at, this.toks[this.pos].span), "`@Annotation` needs at least one target"));
    }
    this.pos += 1;
    return Ok(Annotation { kind: AAnnotation(ts), message: "", span: spanTo(at, this.lastSpan()) });
  }

  // `@Name` or `@Name(a1, ..)` of an annotation that is not a built-in (ADR-0046): the cursor is at `@`. The arguments
  // are parsed as expressions; the checker resolves the name and requires constants.
  @Requires(this.isP("@") && this.isIdentAt(1))
  @Ensures(result.isOk() ==> this.spansFrom(result.unwrap().span, old(this.pos)))
  private parseUserAnnotation(): Result<Annotation, Diagnostic> {
    const at = this.toks[this.pos].span;
    const nt = this.at(1);
    this.pos += 2;
    let args: Expr[] = [];
    if (this.isP("(")) {
      this.pos += 1;
      while (!this.isP(")")) {
        const e = this.parseExpr()?;
        args.push(e);
        if (this.isP(",")) {
          this.pos += 1;
        } else if (!this.isP(")")) {
          return Err(this.errExpected("`,` or `)`"));
        }
      }
      this.pos += 1;
    }
    const id = Ident { name: nt.text, span: nt.span };
    return Ok(Annotation { kind: ACustom(id, args), message: "", span: spanTo(at, this.lastSpan()) });
  }

  // Contract clauses and annotations in any order; the cursor is at the first `@`. `first` is the span of
  // the first one (the declaration's span starts there).
  @Requires(this.isP("@"))
  @Ensures(result.isOk()
      ==> this.pos > old(this.pos)
          && result.unwrap().first.start == this.toks[old(this.pos)].span.start)
  @Ensures(result.isOk()
      ==> result.unwrap().clauses.length + result.unwrap().annos.length >= 1 && !this.isP("@"))
  private parseDecos(): Result<Decos, Diagnostic> {
    let cs: ContractClause[] = [];
    let as: Annotation[] = [];
    const first = this.toks[this.pos].span;
    while (this.isP("@")) {
      if (this.isIdentAt(1) && isBuiltinAnnotation(this.at(1).text)) {
        const a = this.parseAnnotation()?;
        as.push(a);
      } else if (this.isIdentAt(1) && !isClauseName(this.at(1).text)) {
        const a = this.parseUserAnnotation()?;
        as.push(a);
      } else {
        const c = this.parseClause()?;
        cs.push(c);
      }
    }
    return Ok(Decos { clauses: cs, annos: as, first: first });
  }

  // One or more clauses; the cursor is at the first `@`.
  @Requires(this.isP("@"))
  @Ensures(result.isOk()
      ==> this.pos > old(this.pos) && result.unwrap().length >= 1 && !this.isP("@"))
  private parseClauses(): Result<ContractClause[], Diagnostic> {
    let cs: ContractClause[] = [];
    while (this.isP("@")) {
      const c = this.parseClause()?;
      cs.push(c);
    }
    return Ok(cs);
  }

  // ---------------------------------------------------------------------------
  // Items
  // ---------------------------------------------------------------------------

  // `{ a, b as c, }` list of imported names with optional aliases (trailing comma allowed).
  @Ensures(result.isOk() ==> this.pos >= old(this.pos) + 2)
  private parseImportNames(): Result<ImportNames, Diagnostic> {
    this.expectP("{")?;
    let ids: Ident[] = [];
    let als: Option<Ident>[] = [];
    while (!this.isP("}")) {
      const id = this.parseIdent()?;
      ids.push(id);
      if (this.isIdentText(0, "as") && this.isAnyIdentAt(1)) {
        this.pos += 1;
        const al = this.parseIdent()?;
        als.push(Some(al));
      } else {
        als.push(None);
      }
      if (this.isP(",")) {
        this.pos += 1;
      } else if (!this.isP("}")) {
        return Err(this.errExpected("`,` or `}`"));
      }
    }
    this.pos += 1;
    return Ok(ImportNames { names: ids, aliases: als });
  }

  private isAnyIdentAt(k: usize): bool {
    return isAnyIdentTok(this.at(k));
  }

  // `import { .. } from "path";`, `import * as m from "path";` or `export { .. } from "path";` (the cursor is at the first
  // keyword).
  @Ensures(result.isOk() ==> this.spansFrom(result.unwrap().span, old(this.pos)))
  private parseImportDecl(): Result<ImportDecl, Diagnostic> {
    const start = this.toks[this.pos].span;
    const isImport = this.isKw("import");
    this.pos += 1;
    if (this.isIdentText(0, "ox") && this.isKwAt(1, "from")) {
      if (this.sawProvider) {
        return Err(diag("E0200", this.toks[this.pos].span, "a file selects at most one OX provider"));
      }
      this.sawProvider = true;
      this.pos += 1;
      return this.parseImportRest(start, plainImport([], "", start, start, true));
    }
    if (isImport && this.isP("*")) {
      const star = this.toks[this.pos].span;
      this.pos += 1;
      if (!(this.isIdentText(0, "as") && this.isAnyIdentAt(1))) {
        return Err(diag("E0200", star, "`import *` needs a name: write `import * as name from \"path\";`"));
      }
      this.pos += 1;
      const ns = this.parseIdent()?;
      const d = plainImport([], "", start, start, false);
      return this.parseImportRest(start, ImportDecl {
        names: d.names, aliases: d.aliases, namespace: Some(ns), uses: d.uses,
        path: "", pathSpan: start, span: start, provider: false,
      });
    }
    const nl = this.parseImportNames()?;
    const noUses: Ident[] = [];
    return this.parseImportRest(start, ImportDecl {
      names: nl.names, aliases: nl.aliases, namespace: None, uses: noUses,
      path: "", pathSpan: start, span: start, provider: false,
    });
  }

  // `from "path";` of an import (the names, the namespace or `ox` are parsed and given in `head`).
  private parseImportRest(start: Span, head: ImportDecl): Result<ImportDecl, Diagnostic> {
    this.expectKw("from")?;
    const pt = this.toks[this.pos];
    if (!isStrTok(pt)) {
      return Err(this.errExpected("module path string"));
    }
    this.pos += 1;
    this.expectP(";")?;
    return Ok(ImportDecl {
      names: head.names,
      aliases: head.aliases,
      namespace: head.namespace,
      uses: head.uses,
      path: pt.text,
      pathSpan: pt.span,
      span: spanTo(start, this.lastSpan()),
      provider: head.provider,
    });
  }

  // One top-level declaration with the clauses and annotations before it.
  @Ensures(result.isOk()
      ==> this.spansFrom(itemSpan(result.unwrap()), old(this.pos))
          && itemShallowOk(result.unwrap()))
  parseItem(): Result<Item, Diagnostic> {
    let cls: ContractClause[] = [];
    let annos: Annotation[] = [];
    let start = this.toks[this.pos].span;
    if (this.isP("@")) {
      const cr = this.parseDecos()?;
      cls = cr.clauses;
      annos = cr.annos;
      start = cr.first;
    }
    if (this.isKw("import")) {
      if (cls.length > 0) {
        return Err(diag("E0200", cls[0].span, "contract clauses cannot precede an import"));
      }
      checkAnnoPlacement(annos, T_IMPORT)?;
      const d = this.parseImportDecl()?;
      return Ok(IImport(d));
    }
    let exported = false;
    if (this.isKw("export")) {
      if (this.isPAt(1, "{")) {
        if (cls.length > 0) {
          return Err(diag("E0200", cls[0].span, "contract clauses cannot precede a re-export"));
        }
        checkAnnoPlacement(annos, T_IMPORT)?;
        const d = this.parseImportDecl()?;
        return Ok(IReExport(d));
      }
      exported = true;
      this.pos += 1;
    }
    if (this.isKw("function")) {
      checkPlacement(cls, T_FUNCTION)?;
      checkAnnoPlacement(annos, T_FUNCTION)?;
      return this.parseFunction(exported, start, cls, annos);
    }
    if (this.isKw("type")) {
      return this.parseTypeDecl(exported, start, cls, annos);
    }
    if (this.isKw("const")) {
      if (cls.length > 0) {
        return Err(diag("E0200", cls[0].span, "contract clauses cannot precede a constant"));
      }
      checkAnnoPlacement(annos, T_CONST)?;
      return this.parseConstDecl(exported, start, annos);
    }
    if (this.isKw("class")) {
      checkPlacement(cls, T_CLASS)?;
      checkAnnoPlacement(annos, T_CLASS)?;
      return this.parseClass(exported, start, cls, annos);
    }
    if (this.isKw("interface")) {
      if (cls.length > 0) {
        return Err(
          diag("E0200", cls[0].span, "contract clauses cannot be applied to an interface"),
        );
      }
      checkAnnoPlacement(annos, T_INTERFACE)?;
      return this.parseInterface(exported, start, annos);
    }
    return Err(this.errExpected("declaration"));
  }

  // `(a: T, ..) [: R] { body }` with the cursor at the `(`; shared by functions and methods.
  @Ensures(result.isOk()
      ==> this.pos > old(this.pos) && this.lastSpan().end == result.unwrap().body.span.end)
  private parseSigBody(): Result<Sig, Diagnostic> {
    this.expectP("(")?;
    let params: Param[] = [];
    while (!this.isP(")")) {
      const pn = this.parseIdent()?;
      this.expectP(":")?;
      const pt = this.parseType()?;
      params.push(Param { name: pn, ty: pt, span: spanTo(pn.span, pt.span) });
      if (this.isP(",")) {
        this.pos += 1;
      } else if (!this.isP(")")) {
        return Err(this.errExpected("`,` or `)`"));
      }
    }
    this.pos += 1;
    let ret: Option<TypeExpr> = None;
    if (this.isP(":")) {
      this.pos += 1;
      const rt = this.parseType()?;
      ret = Some(rt);
    }
    const body = this.parseBlock()?;
    return Ok(Sig { params: params, ret: ret, body: body });
  }

  // The cursor is at `function`; `start` is the span of the item's first token.
  @Requires(this.isKw("function"))
  @Ensures(result.isOk() ==> this.pos > old(this.pos))
  private parseFunction(
    exported: bool,
    start: Span,
    cls: ContractClause[],
    annos: Annotation[],
  ): Result<Item, Diagnostic> {
    this.pos += 1;
    const name = this.parseIdent()?;
    const tps = this.parseTypeParamsB()?;
    const sg = this.parseSigBody()?;
    return Ok(
      IFunction(FunctionDecl {
        exported: exported,
        name: name,
        typeParams: tps.ids,
        bounds: tps.bounds,
        params: sg.params,
        ret: sg.ret,
        body: sg.body,
        contracts: cls,
        annotations: annos,
        span: spanTo(start, sg.body.span),
      }),
    );
  }

  // ---------------------------------------------------------------------------
  // Classes (beyond Orin-B, ADR-0009) and interfaces (ADR-0019)
  // ---------------------------------------------------------------------------

  // The cursor is at `class`.
  @Requires(this.isKw("class"))
  @Ensures(result.isOk() ==> this.pos > old(this.pos))
  private parseClass(
    exported: bool,
    start: Span,
    cls: ContractClause[],
    annos: Annotation[],
  ): Result<Item, Diagnostic> {
    this.pos += 1;
    const name = this.parseIdent()?;
    const tps = this.parseTypeParamsB()?;
    let ext: Option<Ident> = None;
    if (this.isIdentText(0, "extends")) {
      this.pos += 1;
      const b = this.parseIdent()?;
      ext = Some(b);
    }
    let impls: Ident[] = [];
    if (this.isIdentText(0, "implements")) {
      this.pos += 1;
      while (true) {
        const ii = this.parseIdent()?;
        impls.push(ii);
        if (this.isP(",")) {
          this.pos += 1;
        } else {
          break;
        }
      }
    }
    this.expectP("{")?;
    let members: ClassMember[] = [];
    while (!this.isP("}")) {
      const st = this.pos;
      const m = this.parseMember();
      if (m.isOk()) {
        members.push(m.unwrap());
      } else if (!this.recoverMember(m.unwrapErr(), st)) {
        return Err(m.unwrapErr());
      }
    }
    this.pos += 1;
    return Ok(
      IClass(ClassDecl {
        exported: exported,
        name: name,
        typeParams: tps.ids,
        bounds: tps.bounds,
        ext: ext,
        impls: impls,
        members: members,
        contracts: cls,
        annotations: annos,
        span: spanTo(start, this.lastSpan()),
      }),
    );
  }

  // The cursor is at `interface` (ADR-0019): `interface Name { m(a: T): R; .. }`. `extends` and type parameters are
  // parsed so the checker can reject them; fields and method bodies are E0408 here.
  @Requires(this.isKw("interface"))
  @Ensures(result.isOk() ==> this.pos > old(this.pos))
  private parseInterface(
    exported: bool,
    start: Span,
    annos: Annotation[],
  ): Result<Item, Diagnostic> {
    this.pos += 1;
    const name = this.parseIdent()?;
    const tps = this.parseTypeParamsB()?;
    let ext: Option<Ident> = None;
    if (this.isIdentText(0, "extends")) {
      this.pos += 1;
      const b = this.parseIdent()?;
      ext = Some(b);
    }
    this.expectP("{")?;
    let methods: IfaceMethod[] = [];
    while (!this.isP("}")) {
      const st = this.pos;
      const m = this.parseIfaceMethod();
      if (m.isOk()) {
        methods.push(m.unwrap());
      } else if (!this.recoverMember(m.unwrapErr(), st)) {
        return Err(m.unwrapErr());
      }
    }
    this.pos += 1;
    return Ok(
      IInterface(InterfaceDecl {
        exported: exported,
        name: name,
        typeParams: tps.ids,
        ext: ext,
        methods: methods,
        annotations: annos,
        span: spanTo(start, this.lastSpan()),
      }),
    );
  }

  // `[@Deprecated(..)] name(a: T, ..) [: R];` inside an interface.
  @Ensures(result.isOk() ==> this.spansFrom(result.unwrap().span, old(this.pos)))
  private parseIfaceMethod(): Result<IfaceMethod, Diagnostic> {
    let mstart = this.toks[this.pos].span;
    let mannos: Annotation[] = [];
    if (this.isP("@")) {
      const dr = this.parseDecos()?;
      if (dr.clauses.length > 0) {
        return Err(
          diag(
            "E0200",
            dr.clauses[0].span,
            "contract clauses cannot be applied to an interface method",
          ),
        );
      }
      checkAnnoPlacement(dr.annos, T_IFACE_METHOD)?;
      mannos = dr.annos;
      mstart = dr.first;
    }
    const mn = this.parseIdent()?;
    if (this.isP(":")) {
      return Err(
        diag(
          "E0408",
          spanTo(mstart, mn.span),
          "interfaces cannot declare fields; declare a method (ADR-0019)",
        ),
      );
    }
    if (this.isP("<")) {
      return Err(
        diag(
          "E0460",
          this.toks[this.pos].span,
          "an interface method cannot be generic (a virtual call cannot pick a monomorphised instance, ADR-0040)",
        ),
      );
    }
    this.expectP("(")?;
    let params: Param[] = [];
    while (!this.isP(")")) {
      const pn = this.parseIdent()?;
      this.expectP(":")?;
      const pt = this.parseType()?;
      params.push(Param { name: pn, ty: pt, span: spanTo(pn.span, pt.span) });
      if (this.isP(",")) {
        this.pos += 1;
      } else if (!this.isP(")")) {
        return Err(this.errExpected("`,` or `)`"));
      }
    }
    this.pos += 1;
    let ret: Option<TypeExpr> = None;
    if (this.isP(":")) {
      this.pos += 1;
      const rt = this.parseType()?;
      ret = Some(rt);
    }
    if (this.isP("{")) {
      return Err(
        diag(
          "E0408",
          this.toks[this.pos].span,
          "interface methods cannot have a body (no default methods in Orin 1.0, ADR-0019)",
        ),
      );
    }
    this.expectP(";")?;
    return Ok(IfaceMethod {
      name: mn,
      params: params,
      ret: ret,
      annotations: mannos,
      span: spanTo(mstart, this.lastSpan()),
    });
  }

  // One class member; modifiers (`public`, `private`, `static`) are contextual keywords that only
  // count when another identifier follows.
  @Ensures(result.isOk()
      ==> this.spansFrom(memberSpan(result.unwrap()), old(this.pos))
          && memberShallowOk(result.unwrap()))
  private parseMember(): Result<ClassMember, Diagnostic> {
    let cls: ContractClause[] = [];
    let annos: Annotation[] = [];
    let start = this.toks[this.pos].span;
    if (this.isP("@")) {
      const cr = this.parseDecos()?;
      cls = cr.clauses;
      annos = cr.annos;
      start = cr.first;
    }
    let priv = false;
    let isStatic = false;
    let mods: usize = 0;
    while (this.isIdentAt(1)) {
      if (this.isIdentText(0, "public")) {
        this.pos += 1;
      } else if (this.isIdentText(0, "private")) {
        priv = true;
        this.pos += 1;
      } else if (this.isIdentText(0, "static")) {
        isStatic = true;
        this.pos += 1;
      } else {
        break;
      }
      mods += 1;
    }
    const name = this.parseIdent()?;
    if (this.isP("(") && name.name == "constructor" && mods == 0) {
      checkPlacement(cls, T_CTOR)?;
      checkAnnoPlacement(annos, T_CTOR)?;
      return this.parseCtor(start, cls);
    }
    if (this.isP("(") || this.isP("<")) {
      checkPlacement(cls, T_METHOD)?;
      checkAnnoPlacement(annos, T_METHOD)?;
      const tps = this.parseTypeParamsB()?;
      const sg = this.parseSigBody()?;
      return Ok(
        MMethod(MethodDecl {
          priv: priv,
          isStatic: isStatic,
          name: name,
          typeParams: tps.ids,
          bounds: tps.bounds,
          params: sg.params,
          ret: sg.ret,
          body: sg.body,
          contracts: cls,
          annotations: annos,
          span: spanTo(start, sg.body.span),
        }),
      );
    }
    if (this.isP(":")) {
      if (cls.length > 0) {
        return Err(diag("E0200", cls[0].span, "contract clauses cannot be applied to a field"));
      }
      checkAnnoPlacement(annos, T_FIELD)?;
      if (isStatic) {
        return Err(
          diag("E0408", spanTo(start, name.span), "static fields are not supported (ADR-0009)"),
        );
      }
      this.pos += 1;
      const ft = this.parseType()?;
      let init: Option<Expr> = None;
      if (this.isP("=")) {
        this.pos += 1;
        const e = this.parseExpr()?;
        init = Some(e);
      }
      this.expectP(";")?;
      return Ok(
        MField(ClassField {
          priv: priv,
          name: name,
          ty: ft,
          init: init,
          annotations: annos,
          span: spanTo(start, this.lastSpan()),
        }),
      );
    }
    return Err(this.errExpected("`(` or `:` in class member"));
  }

  // The cursor is at the `(` after `constructor`.
  @Requires(this.isP("("))
  @Ensures(result.isOk() ==> this.pos > old(this.pos))
  private parseCtor(start: Span, cls: ContractClause[]): Result<ClassMember, Diagnostic> {
    this.pos += 1;
    let params: CtorParam[] = [];
    while (!this.isP(")")) {
      const pstart = this.toks[this.pos].span;
      let access = 0;
      if (this.isIdentAt(1)) {
        if (this.isIdentText(0, "public")) {
          access = 1;
          this.pos += 1;
        } else if (this.isIdentText(0, "private")) {
          access = 2;
          this.pos += 1;
        }
      }
      const pn = this.parseIdent()?;
      this.expectP(":")?;
      const pt = this.parseType()?;
      params.push(CtorParam { access: access, name: pn, ty: pt, span: spanTo(pstart, pt.span) });
      if (this.isP(",")) {
        this.pos += 1;
      } else if (!this.isP(")")) {
        return Err(this.errExpected("`,` or `)`"));
      }
    }
    this.pos += 1;
    const body = this.parseBlock()?;
    return Ok(
      MCtor(CtorDecl {
        params: params,
        body: body,
        contracts: cls,
        span: spanTo(start, body.span),
      }),
    );
  }

  // ---------------------------------------------------------------------------
  // Type and constant declarations
  // ---------------------------------------------------------------------------

  // The cursor is at `type`.
  @Requires(this.isKw("type"))
  @Ensures(result.isOk() ==> this.pos > old(this.pos))
  private parseTypeDecl(
    exported: bool,
    start: Span,
    cls: ContractClause[],
    annos: Annotation[],
  ): Result<Item, Diagnostic> {
    this.pos += 1;
    const name = this.parseIdent()?;
    const tps = this.parseTypeParams()?;
    this.expectP("=")?;
    const body = this.parseTypeBody()?;
    this.expectP(";")?;
    const isRecord = match (body) {
      DRecord(_) => true,
      _ => false,
    };
    checkPlacement(cls, isRecord ? T_RECORD : T_TYPE)?;
    checkAnnoPlacement(annos, isRecord ? T_RECORD : T_TYPE)?;
    return Ok(
      IType(TypeDecl {
        exported: exported,
        name: name,
        typeParams: tps,
        body: body,
        contracts: cls,
        annotations: annos,
        span: spanTo(start, this.lastSpan()),
      }),
    );
  }

  // Right side of `type N = ...`: `{..}` record; `Name(..)` or any `|` -> union; else alias.
  // Mirrors Stage 0: the first member is parsed as a type; a following `|` makes it a union,
  // in which case it must be a bare `Name`. A leading `|` is not accepted.
  @Ensures(result.isOk() ==> this.pos > old(this.pos))
  private parseTypeBody(): Result<TypeDeclBody, Diagnostic> {
    if (this.isP("{")) {
      return this.parseRecordBody();
    }
    let variants: VariantDecl[] = [];
    if (this.isIdentAt(0) && this.isPAt(1, "(")) {
      const v = this.parseVariant()?;
      variants.push(v);
    } else {
      const t = this.parseType()?;
      if (!this.isP("|")) {
        return Ok(DAlias(t));
      }
      const bare = match (t.kind) {
        TNamed(id, args) => args.length == 0,
        TArray(_) => false,
        TFn(_, _) => false,
      };
      if (!bare) {
        return Err(diag("E0200", t.span, "union members must be `Name` or `Name(T, ...)`"));
      }
      const nm = match (t.kind) {
        TNamed(id, args) => id,
        TArray(_) => Ident { name: "", span: t.span },
        TFn(_, _) => Ident { name: "", span: t.span },
      };
      variants.push(VariantDecl { name: nm, payload: [], span: t.span });
    }
    while (this.isP("|")) {
      this.pos += 1;
      const v = this.parseVariant()?;
      variants.push(v);
    }
    return Ok(DUnion(variants));
  }

  // `{ a: T; b: U; }`
  @Requires(this.isP("{"))
  @Ensures(result.isOk() ==> this.pos >= old(this.pos) + 2)
  private parseRecordBody(): Result<TypeDeclBody, Diagnostic> {
    this.pos += 1;
    let fields: FieldDecl[] = [];
    while (!this.isP("}")) {
      let fannos: Annotation[] = [];
      let fstart = this.toks[this.pos].span;
      if (this.isP("@")) {
        const dr = this.parseDecos()?;
        if (dr.clauses.length > 0) {
          return Err(diag("E0200", dr.clauses[0].span, "contract clauses cannot be applied to a field"));
        }
        checkAnnoPlacement(dr.annos, T_FIELD)?;
        fannos = dr.annos;
        fstart = dr.first;
      }
      const fname = this.parseIdent()?;
      this.expectP(":")?;
      const ft = this.parseType()?;
      this.expectP(";")?;
      fields.push(FieldDecl { name: fname, ty: ft, annotations: fannos, span: spanTo(fstart, this.lastSpan()) });
    }
    this.pos += 1;
    return Ok(DRecord(fields));
  }

  // `Name` or `Name(T1, T2)`
  @Ensures(result.isOk() ==> this.spansFrom(result.unwrap().span, old(this.pos)))
  private parseVariant(): Result<VariantDecl, Diagnostic> {
    const name = this.parseIdent()?;
    let payload: TypeExpr[] = [];
    if (this.isP("(")) {
      this.pos += 1;
      while (true) {
        const t = this.parseType()?;
        payload.push(t);
        if (this.isP(",")) {
          this.pos += 1;
          if (this.isP(")")) {
            break;
          }
        } else {
          break;
        }
      }
      this.expectP(")")?;
    }
    return Ok(VariantDecl {
      name: name,
      payload: payload,
      span: spanTo(name.span, this.lastSpan()),
    });
  }

  // The cursor is at `const`: `const NAME: T = expr;`
  @Requires(this.isKw("const"))
  @Ensures(result.isOk() ==> this.pos > old(this.pos))
  private parseConstDecl(exported: bool, start: Span, annos: Annotation[]): Result<Item, Diagnostic> {
    this.pos += 1;
    const name = this.parseIdent()?;
    let ty: Option<TypeExpr> = None;
    if (this.isP(":")) {
      this.pos += 1;
      const t = this.parseType()?;
      ty = Some(t);
    }
    this.expectP("=")?;
    const value = this.parseExpr()?;
    this.expectP(";")?;
    return Ok(
      IConst(ConstDecl {
        exported: exported,
        name: name,
        ty: ty,
        value: value,
        annotations: annos,
        span: spanTo(start, this.lastSpan()),
      }),
    );
  }

  // ---------------------------------------------------------------------------
  // Statements
  // ---------------------------------------------------------------------------

  // A statement of kind `kind` from `start` to the last consumed token.
  private mkStmt(kind: StmtKind, start: Span): Stmt {
    return Stmt { kind: kind, span: spanTo(start, this.lastSpan()) };
  }

  // `{ stmt* }`
  @Ensures(result.isOk()
      ==> this.spansFrom(result.unwrap().span, old(this.pos)) && blockShallowOk(result.unwrap()))
  parseBlock(): Result<Block, Diagnostic> {
    const open = this.toks[this.pos].span;
    this.expectP("{")?;
    let stmts: Stmt[] = [];
    while (!this.isP("}")) {
      if (this.isEof()) {
        return Err(this.errExpected("`}`"));
      }
      const st = this.pos;
      if (this.isP("@")) {
        // Loop contract clauses: one SContract statement per clause, directly before the loop.
        const cs = this.parseLoopClauses();
        if (cs.isErr()) {
          if (!this.recoverStmt(cs.unwrapErr(), st)) {
            return Err(cs.unwrapErr());
          }
          continue;
        }
        for (const c of cs.unwrap()) {
          stmts.push(c);
        }
      }
      const s = this.parseStmt();
      if (s.isOk()) {
        stmts.push(s.unwrap());
      } else if (!this.recoverStmt(s.unwrapErr(), st)) {
        return Err(s.unwrapErr());
      }
    }
    const blk = Block { stmts: stmts, span: spanTo(open, this.toks[this.pos].span) };
    this.pos += 1;
    return Ok(blk);
  }

  // Loop contract clauses (the cursor is at the first `@`) as SContract statements; a loop must follow.
  @Requires(this.isP("@"))
  @Ensures(result.isOk() ==> this.pos > old(this.pos) && result.unwrap().length >= 1)
  @Ensures(result.isOk() ==> this.isKw("while") || this.isKw("for"))
  private parseLoopClauses(): Result<Stmt[], Diagnostic> {
    const cs = this.parseClauses()?;
    checkPlacement(cs, T_LOOP)?;
    if (!this.isKw("while") && !this.isKw("for")) {
      return Err(this.errExpected("`while` or `for` after a loop contract clause"));
    }
    return Ok(cs.map(c => Stmt { kind: SContract(c), span: c.span }));
  }

  @Ensures(result.isOk()
      ==> this.spansFrom(result.unwrap().span, old(this.pos)) && stmtShallowOk(result.unwrap()))
  parseStmt(): Result<Stmt, Diagnostic> {
    const t = this.toks[this.pos];
    const isKwTok = match (t.kind) {
      KKeyword => true,
      _ => false,
    };
    if (isKwTok) {
      if (t.text == "const" || t.text == "let") {
        return this.parseLet();
      }
      if (t.text == "if") {
        return this.parseIf();
      }
      if (t.text == "while") {
        return this.parseWhile();
      }
      if (t.text == "for") {
        return this.parseFor();
      }
      if (t.text == "return") {
        return this.parseReturn();
      }
      if (t.text == "break" || t.text == "continue") {
        this.pos += 1;
        this.expectP(";")?;
        let k: StmtKind = SBreak;
        if (t.text == "continue") {
          k = SContinue;
        }
        return Ok(this.mkStmt(k, t.span));
      }
    }
    if (this.isP("{")) {
      const b = this.parseBlock()?;
      return Ok(Stmt { kind: SBlock(b), span: b.span });
    }
    return this.parseExprStmt();
  }

  // `const x[: T] = e;` / `let x[: T] = e;` (initializer required)
  @Ensures(result.isOk() ==> this.spansFrom(result.unwrap().span, old(this.pos)))
  private parseLet(): Result<Stmt, Diagnostic> {
    const start = this.toks[this.pos].span;
    const mutable = this.isKw("let");
    this.pos += 1;
    const name = this.parseIdent()?;
    let ty: Option<TypeExpr> = None;
    if (this.isP(":")) {
      this.pos += 1;
      const t = this.parseType()?;
      ty = Some(t);
    }
    this.expectP("=")?;
    const init = this.parseExpr()?;
    this.expectP(";")?;
    return Ok(this.mkStmt(SLet(mutable, name, ty, init), start));
  }

  // `( expr )`: the inner expression (its span does not include the parentheses).
  @Ensures(result.isOk() ==> this.pos >= old(this.pos) + 3)
  private parseParenExpr(): Result<Expr, Diagnostic> {
    this.expectP("(")?;
    const e = this.parseExpr()?;
    this.expectP(")")?;
    return Ok(e);
  }

  @Ensures(result.isOk() ==> this.spansFrom(result.unwrap().span, old(this.pos)))
  private parseIf(): Result<Stmt, Diagnostic> {
    const start = this.toks[this.pos].span;
    this.pos += 1;
    const cond = this.parseParenExpr()?;
    const thenB = this.parseBlock()?;
    let els: Option<Stmt> = None;
    if (this.isKw("else")) {
      this.pos += 1;
      if (this.isKw("if")) {
        const e = this.parseIf()?;
        els = Some(e);
      } else {
        const b = this.parseBlock()?;
        els = Some(Stmt { kind: SBlock(b), span: b.span });
      }
    }
    return Ok(this.mkStmt(SIf(cond, thenB, els), start));
  }

  @Ensures(result.isOk() ==> this.spansFrom(result.unwrap().span, old(this.pos)))
  private parseWhile(): Result<Stmt, Diagnostic> {
    const start = this.toks[this.pos].span;
    this.pos += 1;
    const cond = this.parseParenExpr()?;
    const body = this.parseBlock()?;
    return Ok(this.mkStmt(SWhile(cond, body), start));
  }

  // `for (const x of expr) { .. }`
  @Ensures(result.isOk() ==> this.spansFrom(result.unwrap().span, old(this.pos)))
  private parseFor(): Result<Stmt, Diagnostic> {
    const start = this.toks[this.pos].span;
    this.pos += 1;
    this.expectP("(")?;
    this.expectKw("const")?;
    const name = this.parseIdent()?;
    this.expectKw("of")?;
    const iter = this.parseExpr()?;
    this.expectP(")")?;
    const body = this.parseBlock()?;
    return Ok(this.mkStmt(SForOf(name, iter, body), start));
  }

  @Ensures(result.isOk() ==> this.spansFrom(result.unwrap().span, old(this.pos)))
  private parseReturn(): Result<Stmt, Diagnostic> {
    const start = this.toks[this.pos].span;
    this.pos += 1;
    let val: Option<Expr> = None;
    if (!this.isP(";")) {
      const e = this.parseExpr()?;
      val = Some(e);
    }
    this.expectP(";")?;
    return Ok(this.mkStmt(SReturn(val), start));
  }

  private isAssignTok(): bool {
    const t = this.toks[this.pos];
    return match (t.kind) {
      KPunct => t.text == "="
          || t.text == "+="
          || t.text == "-="
          || t.text == "*="
          || t.text == "/="
          || t.text == "%=",
      _ => false,
    };
  }

  // Expression statement or assignment. A statement-level `match` needs no `;`.
  @Ensures(result.isOk() ==> this.spansFrom(result.unwrap().span, old(this.pos)))
  private parseExprStmt(): Result<Stmt, Diagnostic> {
    const start = this.toks[this.pos].span;
    const e = this.parseExpr()?;
    if (this.isAssignTok()) {
      const op = assignOpOf(this.toks[this.pos].text);
      this.pos += 1;
      const rhs = this.parseExpr()?;
      this.expectP(";")?;
      return Ok(this.mkStmt(SAssign(e, op, rhs), start));
    }
    if (isMatchExpr(e) && !this.isP(";")) {
      return Ok(this.mkStmt(SExpr(e), start));
    }
    this.expectP(";")?;
    return Ok(this.mkStmt(SExpr(e), start));
  }

  // ---------------------------------------------------------------------------
  // Expressions
  // ---------------------------------------------------------------------------

  // A whole expression: an arrow function, or a conditional optionally followed by `==> expr`.
  @Ensures(result.isOk()
      ==> this.spansFrom(result.unwrap().span, old(this.pos)) && exprShallowOk(result.unwrap()))
  parseExpr(): Result<Expr, Diagnostic> {
    const k = this.arrowStart();
    if (k == 1) {
      return this.parseArrow(false);
    }
    if (k == 2) {
      return this.parseArrow(true);
    }
    const c = this.parseCond()?;
    if (this.isP("==>")) {
      // `a ==> b`: implication, right-associative, lower than `?:`. Only valid inside contract
      // expressions; the checker rejects it elsewhere (E0415).
      this.pos += 1;
      const r = this.parseExpr()?;
      return Ok(mkExpr(EBinary(BImplies, c, r), spanTo(c.span, r.span)));
    }
    return Ok(c);
  }

  // Index of the `)` matching the `(` at the cursor (counting only parentheses), or of the final KEof.
  @Requires(this.isP("("))
  @Ensures(result > this.pos && result < this.toks.length)
  private matchingParen(): usize {
    let depth: usize = 0;
    let p = this.pos;
    while (p < this.toks.length) {
      const t = this.toks[p];
      if (isPunctTok(t, "(")) {
        depth += 1;
      } else if (isPunctTok(t, ")")) {
        depth -= 1;
        if (depth == 0) {
          return p;
        }
      } else if (isEofTok(t)) {
        return p;
      }
      p += 1;
    }
    return p;
  }

  // Does an arrow function start at the cursor? 1: `name =>`; 2: `( .. ) [: R] =>`; 0: no (beyond Orin-B,
  // ADR-0011). Looks ahead without moving the cursor (a return type is tried on a copy of the parser).
  @Requires(this.pos < this.toks.length && this.toks.length > 0 && isEofTok(this.toks[this.toks.length - 1]))
  @Ensures(result >= 0 && result <= 2)
  private arrowStart(): int {
    if (this.isIdentAt(0)) {
      return this.isPAt(1, "=>") ? 1 : 0;
    }
    if (!this.isP("(")) {
      return 0;
    }
    const q = this.matchingParen();
    if (!isPunctTok(this.tokAbs(q), ")")) {
      return 0;
    }
    if (isPunctTok(this.tokAbs(q + 1), "=>")) {
      return 2;
    }
    if (isPunctTok(this.tokAbs(q + 1), ":")) {
      let probe = new Parser(this.toks);
      probe.pos = q + 2;
      const rt = probe.parseType();
      if (rt.isOk() && probe.isP("=>")) {
        return 2;
      }
    }
    return 0;
  }

  // `x => body`, `(x: T, y) [: R] => body`; the body is a block when it starts with `{`.
  @Ensures(result.isOk() ==> this.spansFrom(result.unwrap().span, old(this.pos)))
  private parseArrow(parens: bool): Result<Expr, Diagnostic> {
    const start = this.toks[this.pos].span;
    let ps: ArrowParam[] = [];
    let ret: Option<TypeExpr> = None;
    if (!parens) {
      const nm = this.parseIdent()?;
      ps.push(ArrowParam { name: nm, ty: None, span: nm.span });
    } else {
      this.pos += 1;
      while (!this.isP(")")) {
        const pn = this.parseIdent()?;
        let pty: Option<TypeExpr> = None;
        let psp = pn.span;
        if (this.isP(":")) {
          this.pos += 1;
          const pt = this.parseType()?;
          pty = Some(pt);
          psp = spanTo(pn.span, pt.span);
        }
        ps.push(ArrowParam { name: pn, ty: pty, span: psp });
        if (this.isP(",")) {
          this.pos += 1;
        } else if (!this.isP(")")) {
          return Err(this.errExpected("`,` or `)`"));
        }
      }
      this.pos += 1;
      if (this.isP(":")) {
        this.pos += 1;
        const rt = this.parseType()?;
        ret = Some(rt);
      }
    }
    this.expectP("=>")?;
    if (this.isP("{")) {
      const b = this.parseBlock()?;
      return Ok(mkExpr(EArrow(ps, ret, ABlock(b)), spanTo(start, b.span)));
    }
    const e = this.parseExpr()?;
    return Ok(mkExpr(EArrow(ps, ret, AExpr(e)), spanTo(start, e.span)));
  }

  // `c ? a : b` (right-associative, below every binary operator). A `?` that reaches here was not
  // taken as postfix propagation (ADR-0003).
  @Ensures(result.isOk() ==> this.spansFrom(result.unwrap().span, old(this.pos)))
  private parseCond(): Result<Expr, Diagnostic> {
    const c = this.parseBin(0)?;
    if (this.isP("?")) {
      this.pos += 1;
      const a = this.parseCond()?;
      this.expectP(":")?;
      const b = this.parseCond()?;
      return Ok(mkExpr(ECond(c, a, b), spanTo(c.span, b.span)));
    }
    return Ok(c);
  }

  // Level of the binary operator at the cursor (precedence.or), or -1.
  private levelHere(): int {
    const t = this.toks[this.pos];
    return match (t.kind) {
      KPunct => this.ops.level(t.text),
      _ => -1,
    };
  }

  // Precedence climbing over the operator table: an operand followed by operators of level `min` or tighter. A
  // left-associative operator parses its right side one level tighter (so `a - b - c` is `(a - b) - c`), a
  // right-associative one at its own level. On return the operator at the cursor, if any, is looser than `min`.
  @Requires(min >= 0)
  @Ensures(result.isOk()
      ==> this.spansFrom(result.unwrap().span, old(this.pos)) && this.levelHere() < min)
  private parseBin(min: int): Result<Expr, Diagnostic> {
    let lhs = this.parseUnary()?;
    while (this.levelHere() >= min) {
      const row = this.ops.rowOf(this.toks[this.pos].text);
      this.pos += 1;
      const rhs = this.parseBin(row.rightAssoc ? row.level : row.level + 1)?;
      lhs = mkExpr(EBinary(row.op, lhs, rhs), spanTo(lhs.span, rhs.span));
    }
    return Ok(lhs);
  }

  @Ensures(result.isOk() ==> this.spansFrom(result.unwrap().span, old(this.pos)))
  private parseUnary(): Result<Expr, Diagnostic> {
    const t = this.toks[this.pos];
    if (this.isP("!") || this.isP("-")) {
      this.pos += 1;
      const operand = this.parseUnary()?;
      let op: UnaryOp = UNot;
      if (t.text == "-") {
        op = UNeg;
      }
      return Ok(mkExpr(EUnary(op, operand), spanTo(t.span, operand.span)));
    }
    return this.parsePostfix();
  }

  // True if the token after the cursor cannot start an expression, so a `?` at the cursor is
  // propagation: one of `) ] } , ; . ? :` or end of file (ADR-0003).
  private isPropagateFollow(): bool {
    const t = this.at(1);
    return match (t.kind) {
      KEof => true,
      KPunct => t.text == ")"
          || t.text == "]"
          || t.text == "}"
          || t.text == ","
          || t.text == ";"
          || t.text == "."
          || t.text == "?"
          || t.text == ":",
      _ => false,
    };
  }

  // `open` ... `close` comma-separated expressions; the cursor is at the opening token.
  @Ensures(result.isOk()
      ==> this.pos >= old(this.pos) + 2 && isPunctTok(this.toks[this.pos - 1], close))
  private parseExprList(close: string): Result<Expr[], Diagnostic> {
    this.pos += 1;
    let xs: Expr[] = [];
    while (!this.isP(close)) {
      const a = this.parseExpr()?;
      xs.push(a);
      if (this.isP(",")) {
        this.pos += 1;
      } else if (!this.isP(close)) {
        return Err(this.errExpected("`,` or `" + close + "`"));
      }
    }
    this.pos += 1;
    return Ok(xs);
  }

  // primary followed by calls, member accesses, indexing and `?`.
  @Ensures(result.isOk() ==> this.spansFrom(result.unwrap().span, old(this.pos)))
  private parsePostfix(): Result<Expr, Diagnostic> {
    let e = this.parsePrimary()?;
    while (true) {
      if (this.isP("(")) {
        const args = this.parseExprList(")")?;
        e = mkExpr(ECall(e, args), spanTo(e.span, this.lastSpan()));
      } else if (this.isP(".")) {
        this.pos += 1;
        const m = this.parseIdent()?;
        // `recv.m<T, U>(args)`: explicit type arguments of a generic method (ADR-0040), decided by backtracking like
        // `f<T>(x)`: the `>` must be followed by `(`.
        let targs: Option<TypeExpr[]> = None;
        if (this.isP("<")) {
          const afterName = this.pos;
          const ta = this.tryTypeArgs();
          if (ta.isSome() && this.isP("(")) {
            targs = ta;
          } else {
            this.pos = afterName;
          }
        }
        if (targs.isSome()) {
          e = mkExpr(EMethodT(e, m, targs.unwrap()), spanTo(e.span, this.lastSpan()));
        } else {
          e = mkExpr(EMember(e, m), spanTo(e.span, m.span));
        }
      } else if (this.isP("[")) {
        this.pos += 1;
        const ix = this.parseExpr()?;
        this.expectP("]")?;
        e = mkExpr(EIndex(e, ix), spanTo(e.span, this.lastSpan()));
      } else if (this.isP("?") && this.isPropagateFollow()) {
        e = mkExpr(ETry(e), spanTo(e.span, this.toks[this.pos].span));
        this.pos += 1;
      } else {
        break;
      }
    }
    return Ok(e);
  }

  // A template literal with interpolations (ADR-0022), at its KTplHead token: `head expr (mid expr)* tail`.
  @Ensures(result.isOk() ==> this.spansFrom(result.unwrap().span, old(this.pos)))
  private parseTemplate(): Result<Expr, Diagnostic> {
    const head = this.toks[this.pos];
    let parts: string[] = [head.text];
    let exprs: Expr[] = [];
    this.pos += 1;
    while (true) {
      const e = this.parseExpr()?;
      exprs.push(e);
      const t = this.toks[this.pos];
      const isMid = match (t.kind) {
        KTplMid => true,
        _ => false,
      };
      const isTail = match (t.kind) {
        KTplTail => true,
        _ => false,
      };
      if (!isMid && !isTail) {
        return Err(this.errExpected("`}` to close the interpolation"));
      }
      parts.push(t.text);
      this.pos += 1;
      if (isTail) {
        return Ok(mkExpr(ETemplate(parts, exprs), spanTo(head.span, t.span)));
      }
    }
    return Err(this.errExpected("template literal"));
  }

  @Ensures(result.isOk() ==> this.spansFrom(result.unwrap().span, old(this.pos)))
  private parsePrimary(): Result<Expr, Diagnostic> {
    const t = this.toks[this.pos];
    match (t.kind) {
      KInt => {
        this.pos += 1;
        return Ok(mkExpr(EInt(t.value), t.span));
      },
      KBigInt => {
        this.pos += 1;
        return Ok(mkExpr(EBigInt(t.value), t.span));
      },
      KFloat => {
        this.pos += 1;
        return Ok(mkExpr(EFloat(t.text), t.span));
      },
      KStr => {
        this.pos += 1;
        return Ok(mkExpr(EStr(t.text), t.span));
      },
      KTplFull => {
        this.pos += 1;
        const none: Expr[] = [];
        return Ok(mkExpr(ETemplate([t.text], none), t.span));
      },
      KTplHead => {
        return this.parseTemplate();
      },
      KTplMid => {
        return Err(this.errExpected("expression"));
      },
      KTplTail => {
        return Err(this.errExpected("expression"));
      },
      KOxOpen => {
        const el = this.parseOxElement()?;
        return Ok(mkExpr(EOx(el), el.span));
      },
      KOxEnd => {
        return Err(this.errExpected("expression"));
      },
      KOxText => {
        return Err(this.errExpected("expression"));
      },
      KIdent => {
        return this.parseIdentExpr();
      },
      KPunct => {
        return this.parsePunctExpr();
      },
      KKeyword => {
        return this.parseKeywordExpr();
      },
      KEof => {
        return Err(this.errExpected("expression"));
      },
    }
  }

  // ---------------------------------------------------------------------------
  // OX (ADR-0043)
  // ---------------------------------------------------------------------------

  private isOxEnd(s: string): bool {
    const t = this.toks[this.pos];
    return match (t.kind) {
      KOxEnd => t.text == s,
      _ => false,
    };
  }

  private isOxOpen(s: string): bool {
    const t = this.toks[this.pos];
    return match (t.kind) {
      KOxOpen => t.text == s,
      _ => false,
    };
  }

  // `{...expr}` in an opening tag: the attribute named `...` with the value JVSpread (ADR-0044). The cursor is at `{`.
  @Requires(this.isP("{"))
  @Ensures(result.isOk() ==> this.spansFrom(result.unwrap().span, old(this.pos)))
  private parseOxSpread(): Result<OxAttr, Diagnostic> {
    const open = this.toks[this.pos];
    this.pos += 1;
    if (!this.isP("...")) {
      return Err(this.errExpected("`...` (an OX attribute is a name or a spread `{...expr}`)"));
    }
    this.pos += 1;
    const e = this.parseExpr()?;
    this.expectP("}")?;
    const sp = spanTo(open.span, this.lastSpan());
    return Ok(OxAttr { name: Ident { name: "...", span: sp }, value: JVSpread(e), span: sp });
  }

  // The children of an element or slot, up to (not including) its closing tag `</` or `</:`. Named slots `<:x>` are
  // children only where `slots` holds (directly inside a component, ADR-0044).
  @Ensures(result.isOk() ==> this.isOxOpen("</") || this.isOxOpen("</:"))
  private parseOxKids(slots: bool): Result<OxChild[], Diagnostic> {
    let kids: OxChild[] = [];
    while (!this.isOxOpen("</") && !this.isOxOpen("</:")) {
      const t = this.toks[this.pos];
      const isText = match (t.kind) {
        KOxText => true,
        _ => false,
      };
      if (isText) {
        kids.push(JText(t.text, t.span));
        this.pos += 1;
      } else if (this.isOxOpen("<:")) {
        if (!slots) {
          return Err(errAt(t, "a named slot `<:x>` can only appear directly inside a component"));
        }
        kids.push(this.parseOxSlot()?);
      } else if (this.isOxOpen("<")) {
        kids.push(JElem(this.parseOxElement()?));
      } else if (this.isP("{")) {
        this.pos += 1;
        if (this.isP("}")) {
          this.pos += 1; // `{}` or `{/* comment */}`: no child
        } else {
          const e = this.parseExpr()?;
          this.expectP("}")?;
          kids.push(JExpr(e));
        }
      } else {
        return Err(this.errExpected("OX text, `{`, an element or a closing tag"));
      }
    }
    return Ok(kids);
  }

  // A named slot `<:name> children </:name>` at its `<:` (ADR-0044): no attributes, not self-closing, the closing tag
  // repeats the name, the children are text, `{expr}` and elements (no slot directly inside a slot).
  @Requires(this.isOxOpen("<:"))
  private parseOxSlot(): Result<OxChild, Diagnostic> {
    const open = this.toks[this.pos];
    this.pos += 1;
    const name = this.parseIdent()?;
    if (this.isOxEnd("/>")) {
      return Err(errAt(this.toks[this.pos], "a named slot cannot be self-closing; write `<:" + name.name + "></:" + name.name + ">`"));
    }
    if (!this.isOxEnd(">")) {
      return Err(errAt(this.toks[this.pos], "a named slot `<:" + name.name + ">` has no attributes"));
    }
    this.pos += 1;
    const kids = this.parseOxKids(false)?;
    if (!this.isOxOpen("</:")) {
      return Err(this.errExpected("`</:" + name.name + ">` to close `<:" + name.name + ">`"));
    }
    this.pos += 1;
    if (!this.isIdentText(0, name.name)) {
      return Err(this.errExpected("`" + name.name + "` to close `<:" + name.name + ">`"));
    }
    this.pos += 1;
    if (!this.isOxEnd(">")) {
      return Err(this.errExpected("`>`"));
    }
    this.pos += 1;
    return Ok(JSlot(name, kids, spanTo(open.span, this.lastSpan())));
  }

  // An OX element or fragment at its KOxOpen `<`: `<name attrs />`, `<name attrs> children </name>` or
  // `<> children </>`. The lexer has already split tags, text and `{..}`; this checks the structure (the closing tag
  // repeats the name, fragments have no attributes and are not self-closing).
  @Requires(this.isOxOpen("<"))
  @Ensures(result.isOk() ==> this.spansFrom(result.unwrap().span, old(this.pos)))
  private parseOxElement(): Result<OxElement, Diagnostic> {
    const open = this.toks[this.pos];
    this.pos += 1;
    let name: Option<Ident> = None;
    let recv: Option<Expr> = None;
    let path: string[] = [];
    if (this.isIdentAt(0)) {
      let id = this.parseIdent()?;
      path.push(id.name);
      if (this.isP(".")) {
        // a member tag `<a.b.C>` (ADR-0044): `recv` is the path before the last segment
        let r = mkExpr(id.name == "this" ? EThis : EIdent(id), id.span);
        while (this.isP(".")) {
          this.pos += 1;
          if (!this.isIdentAt(0)) {
            return Err(this.errExpected("a name after `.` in an OX tag"));
          }
          const seg = this.parseIdent()?;
          path.push(seg.name);
          if (this.isP(".")) {
            r = mkExpr(EMember(r, seg), spanTo(r.span, seg.span));
          }
          id = seg;
        }
        if (id.name.charCodeAt(0) < 65 || id.name.charCodeAt(0) > 90) {
          return Err(diag("E0200", id.span, "a dotted OX tag `<" + path.join(".") + ">` must end in an upper-case name (a member tag calls a method)"));
        }
        recv = Some(r);
      }
      name = Some(id);
    } else if (!this.isOxEnd(">")) {
      return Err(this.errExpected("an OX tag name or `>`"));
    }
    let attrs: OxAttr[] = [];
    while (this.isIdentAt(0) || this.isP("{")) {
      if (name.isNone()) {
        return Err(errAt(this.toks[this.pos], "a fragment `<>` cannot have attributes"));
      }
      if (this.isP("{")) {
        attrs.push(this.parseOxSpread()?);
        continue;
      }
      const an = this.parseIdent()?;
      let v: OxValue = JVTrue;
      if (this.isP("=")) {
        this.pos += 1;
        const t = this.toks[this.pos];
        if (isStrTok(t)) {
          this.pos += 1;
          v = JVStr(t.text);
        } else if (this.isP("{")) {
          this.pos += 1;
          const e = this.parseExpr()?;
          this.expectP("}")?;
          v = JVExpr(e);
        } else {
          return Err(this.errExpected("a string literal or `{` for the OX attribute value"));
        }
      }
      for (const a of attrs) {
        if (a.name.name == an.name) {
          return Err(diag("E0200", an.span, "duplicate OX attribute `" + an.name + "`"));
        }
      }
      attrs.push(OxAttr { name: an, value: v, span: spanTo(an.span, this.lastSpan()) });
    }
    const noKids: OxChild[] = [];
    if (this.isOxEnd("/>")) {
      if (name.isNone()) {
        return Err(errAt(this.toks[this.pos], "a fragment cannot be self-closing; write `<></>`"));
      }
      this.pos += 1;
      return Ok(OxElement {
        recv: recv,
        name: name,
        attrs: attrs,
        children: noKids,
        selfClosing: true,
        span: spanTo(open.span, this.lastSpan()),
      });
    }
    if (!this.isOxEnd(">")) {
      return Err(this.errExpected("`>` or `/>` to end the OX tag"));
    }
    this.pos += 1;
    const isComponent = match (name) {
      Some(n) => n.name.length > 0 && n.name.charCodeAt(0) >= 65 && n.name.charCodeAt(0) <= 90,
      None => false,
    };
    const kids = this.parseOxKids(isComponent)?;
    if (this.isOxOpen("</:")) {
      return Err(errAt(this.toks[this.pos], "a slot closing tag `</:..>` without its opening tag"));
    }
    this.pos += 1;
    const want = path.join(".");
    if (want.length > 0) {
      let k: usize = 0;
      while (k < path.length) {
        if (k > 0) {
          if (!this.isP(".")) {
            return Err(this.errExpected("`" + want + "` to close `<" + want + ">`"));
          }
          this.pos += 1;
        }
        if (!this.isIdentText(0, path[k])) {
          return Err(this.errExpected("`" + want + "` to close `<" + want + ">`"));
        }
        this.pos += 1;
        k += 1;
      }
    } else if (this.isIdentAt(0)) {
      return Err(this.errExpected("`>` to close the fragment `<>`"));
    }
    if (!this.isOxEnd(">")) {
      return Err(this.errExpected("`>`"));
    }
    this.pos += 1;
    return Ok(OxElement {
      recv: recv,
      name: name,
      attrs: attrs,
      children: kids,
      selfClosing: false,
      span: spanTo(open.span, this.lastSpan()),
    });
  }

  // `( e )` or `[a, b]`. Parentheses produce no node: the result is the inner expression with
  // its span widened to include the parentheses (as Stage 0 does).
  @Ensures(result.isOk() ==> this.spansFrom(result.unwrap().span, old(this.pos)))
  private parsePunctExpr(): Result<Expr, Diagnostic> {
    const start = this.toks[this.pos].span;
    if (this.isP("(")) {
      const inner = this.parseParenExpr()?;
      return Ok(mkExpr(inner.kind, spanTo(start, this.lastSpan())));
    }
    if (this.isP("[")) {
      const xs = this.parseExprList("]")?;
      return Ok(mkExpr(EArray(xs), spanTo(start, this.lastSpan())));
    }
    return Err(this.errExpected("expression"));
  }

  @Ensures(result.isOk() ==> this.spansFrom(result.unwrap().span, old(this.pos)))
  private parseKeywordExpr(): Result<Expr, Diagnostic> {
    const t = this.toks[this.pos];
    if (t.text == "true" || t.text == "false") {
      this.pos += 1;
      return Ok(mkExpr(EBool(t.text == "true"), t.span));
    }
    if (t.text == "match") {
      return this.parseMatch();
    }
    if (t.text == "this") {
      this.pos += 1;
      return Ok(mkExpr(EThis, t.span));
    }
    if (t.text == "new") {
      return this.parseNew();
    }
    return Err(this.errExpected("expression"));
  }

  // `new C(args)` / `new C<T>(args)` (type arguments: generic classes, ADR-0026).
  @Ensures(result.isOk() ==> this.spansFrom(result.unwrap().span, old(this.pos)))
  private parseNew(): Result<Expr, Diagnostic> {
    if (!this.isIdentAt(1)) {
      return Err(this.errExpected("expression"));
    }
    const start = this.toks[this.pos].span;
    this.pos += 1;
    const nm = this.parseNameRef()?;
    let targs: TypeExpr[] = [];
    if (this.isP("<")) {
      const ta = this.tryTypeArgs();
      if (ta.isSome()) {
        targs = ta.unwrap();
      }
    }
    if (!this.isP("(")) {
      return Err(this.errExpected("`(` after `new` class name"));
    }
    const args = this.parseExprList(")")?;
    return Ok(mkExpr(ENew(nm, targs, args), spanTo(start, this.lastSpan())));
  }

  // `<T, U>` list of type arguments at the cursor, or None if the tokens there are not a well-formed
  // list (the caller then treats `<` as a comparison). Never reports errors; on None the cursor is unchanged.
  @Ensures(result.isNone() ==> this.pos == old(this.pos))
  @Ensures(result.isSome()
      ==> this.pos >= old(this.pos) + 3
          && result.unwrap().length >= 1
          && isPunctTok(this.toks[this.pos - 1], ">"))
  private tryTypeArgs(): Option<TypeExpr[]> {
    if (!this.isP("<")) {
      return None;
    }
    const save = this.pos;
    this.pos += 1;
    let tys: TypeExpr[] = [];
    while (true) {
      const r = this.parseType();
      if (r.isErr()) {
        this.pos = save;
        return None;
      }
      tys.push(r.unwrap());
      if (this.isP(",")) {
        this.pos += 1;
      } else {
        break;
      }
    }
    if (!this.isP(">")) {
      this.pos = save;
      return None;
    }
    this.pos += 1;
    return Some(tys);
  }

  // Identifier, record literal when directly followed by `{`, or (beyond Orin-B) a generic
  // form `name<types>(` / `Name<types> {` -- decided by backtracking (ADR-0007).
  @Ensures(result.isOk() ==> this.spansFrom(result.unwrap().span, old(this.pos)))
  private parseIdentExpr(): Result<Expr, Diagnostic> {
    const nm = this.parseNameRef()?;
    if (this.isP("{")) {
      return this.parseRecordLit(nm, []);
    }
    if (this.isP("<")) {
      const afterName = this.pos;
      const ta = this.tryTypeArgs();
      if (ta.isSome()) {
        const targs = ta.unwrap();
        if (this.isP("(")) {
          return Ok(mkExpr(ETyApp(nm, targs), spanTo(nm.span, this.lastSpan())));
        }
        if (this.isP("{")) {
          return this.parseRecordLit(nm, targs);
        }
        this.pos = afterName;
      }
    }
    return Ok(mkExpr(EIdent(nm), nm.span));
  }

  // `Name { ...spread, a: e, b: e }`; the name (and type arguments) are consumed, the cursor is at the `{`.
  @Requires(this.isP("{"))
  @Ensures(result.isOk()
      ==> this.pos >= old(this.pos) + 2
          && result.unwrap().span.start == nm.span.start
          && result.unwrap().span.end == this.lastSpan().end)
  private parseRecordLit(nm: Ident, targs: TypeExpr[]): Result<Expr, Diagnostic> {
    this.pos += 1;
    let spread: Option<Expr> = None;
    if (this.isP("...")) {
      this.pos += 1;
      const s = this.parseExpr()?;
      spread = Some(s);
      if (this.isP(",")) {
        this.pos += 1;
      } else if (!this.isP("}")) {
        return Err(this.errExpected("`,` or `}`"));
      }
    }
    let fields: FieldInit[] = [];
    while (!this.isP("}")) {
      const fname = this.parseIdent()?;
      this.expectP(":")?;
      const v = this.parseExpr()?;
      fields.push(FieldInit { name: fname, value: v, span: spanTo(fname.span, v.span) });
      if (this.isP(",")) {
        this.pos += 1;
      } else if (!this.isP("}")) {
        return Err(this.errExpected("`,` or `}`"));
      }
    }
    this.pos += 1;
    const sp = spanTo(nm.span, this.lastSpan());
    if (targs.length > 0) {
      return Ok(mkExpr(ERecordT(nm, targs, spread, fields), sp));
    }
    return Ok(mkExpr(ERecord(nm, spread, fields), sp));
  }

  // `match (e) { pattern => body, ... }`
  @Ensures(result.isOk() ==> this.spansFrom(result.unwrap().span, old(this.pos)))
  private parseMatch(): Result<Expr, Diagnostic> {
    const start = this.toks[this.pos].span;
    this.pos += 1;
    const scrut = this.parseParenExpr()?;
    this.expectP("{")?;
    let arms: MatchArm[] = [];
    while (!this.isP("}")) {
      const pat = this.parsePattern()?;
      this.expectP("=>")?;
      if (this.isP("{")) {
        // Block arm: the comma after it is optional.
        const b = this.parseBlock()?;
        arms.push(MatchArm { pattern: pat, body: BBlock(b), span: spanTo(pat.span, b.span) });
        if (this.isP(",")) {
          this.pos += 1;
        }
      } else {
        const e = this.parseExpr()?;
        arms.push(MatchArm { pattern: pat, body: BExpr(e), span: spanTo(pat.span, e.span) });
        if (this.isP(",")) {
          this.pos += 1;
        } else if (!this.isP("}")) {
          return Err(this.errExpected("`,` or `}`"));
        }
      }
    }
    this.pos += 1;
    return Ok(mkExpr(EMatch(scrut, arms), spanTo(start, this.lastSpan())));
  }

  // ---------------------------------------------------------------------------
  // Patterns
  // ---------------------------------------------------------------------------

  @Ensures(result.isOk()
      ==> this.spansFrom(result.unwrap().span, old(this.pos)) && patShallowOk(result.unwrap()))
  parsePattern(): Result<Pattern, Diagnostic> {
    const t = this.toks[this.pos];
    match (t.kind) {
      KIdent => {
        return this.parseIdentPattern();
      },
      KInt => {
        this.pos += 1;
        return Ok(Pattern { kind: PInt(t.value), span: t.span });
      },
      KFloat => {
        return Err(this.errExpected("pattern (float literals cannot be matched)"));
      },
      KBigInt => {
        return Err(this.errExpected("pattern (integer literal too large for a pattern)"));
      },
      KTplFull => {
        return Err(this.errExpected("pattern (template literals cannot be matched)"));
      },
      KTplHead => {
        return Err(this.errExpected("pattern (template literals cannot be matched)"));
      },
      KTplMid => {
        return Err(this.errExpected("pattern"));
      },
      KTplTail => {
        return Err(this.errExpected("pattern"));
      },
      KOxOpen => {
        return Err(this.errExpected("pattern (OX cannot be matched)"));
      },
      KOxEnd => {
        return Err(this.errExpected("pattern"));
      },
      KOxText => {
        return Err(this.errExpected("pattern"));
      },
      KStr => {
        this.pos += 1;
        return Ok(Pattern { kind: PStr(t.text), span: t.span });
      },
      KKeyword => {
        if (t.text == "true" || t.text == "false") {
          this.pos += 1;
          return Ok(Pattern { kind: PBool(t.text == "true"), span: t.span });
        }
        return Err(this.errExpected("pattern"));
      },
      KPunct => {
        // Negative integer literal pattern.
        const nt = this.at(1);
        if (this.isP("-")) {
          if (isKindInt(nt)) {
            this.pos += 2;
            return Ok(Pattern { kind: PInt(0 - nt.value), span: spanTo(t.span, nt.span) });
          }
          return Err(this.errExpectedAt(1, "integer after `-` in pattern"));
        }
        return Err(this.errExpected("pattern"));
      },
      KEof => {
        return Err(this.errExpected("pattern"));
      },
    }
  }

  // `_`, `Name`, or `Name(p, ..)`. Nested patterns are accepted here (as in Stage 0); Orin-B's
  // restriction to bindings and `_` is enforced later, by the checker.
  @Ensures(result.isOk() ==> this.spansFrom(result.unwrap().span, old(this.pos)))
  private parseIdentPattern(): Result<Pattern, Diagnostic> {
    const nm = this.parseNameRef()?;
    if (nm.name == "_") {
      return Ok(Pattern { kind: PWildcard, span: nm.span });
    }
    if (!this.isP("(")) {
      return Ok(Pattern { kind: PIdent(nm), span: nm.span });
    }
    this.pos += 1;
    let subs: Pattern[] = [];
    while (!this.isP(")")) {
      const sub = this.parsePattern()?;
      subs.push(sub);
      if (this.isP(",")) {
        this.pos += 1;
      } else if (!this.isP(")")) {
        return Err(this.errExpected("`,` or `)`"));
      }
    }
    this.pos += 1;
    return Ok(Pattern { kind: PVariant(nm, subs), span: spanTo(nm.span, this.lastSpan()) });
  }

  // ---------------------------------------------------------------------------
  // Module
  // ---------------------------------------------------------------------------

  // All items up to the final KEof, in file `file`. With recovery the result is always a module (the errors are in
  // `errors()`; items that failed are left out).
  @Ensures(result.isOk() ==> this.atEnd() && result.unwrap().file == file)
  @Ensures(this.recovering ==> result.isOk() && !this.unwinding)
  parseModule(file: usize): Result<Module, Diagnostic> {
    let items: Item[] = [];
    while (!this.isEof()) {
      const st = this.pos;
      const it = this.parseItem();
      if (it.isOk()) {
        items.push(it.unwrap());
      } else if (!this.recoverItem(it.unwrapErr(), st)) {
        return Err(it.unwrapErr());
      }
    }
    return Ok(Module { file: file, items: this.withNsUses(items) });
  }

  // The namespace imports get the uses of their namespace (`m.x` of `import * as m`) collected while parsing.
  private withNsUses(items: Item[]): Item[] {
    if (this.nsUses.length == 0) {
      return items;
    }
    let out: Item[] = [];
    for (const it of items) {
      match (it) {
        IImport(d) => {
          match (d.namespace) {
            Some(ns) => {
              let mine: Ident[] = [];
              for (const u of this.nsUses) {
                if (u.name.startsWith(ns.name + ".") && !hasIdentNamed(mine, u.name)) {
                  mine.push(u);
                }
              }
              out.push(IImport(ImportDecl {
                names: d.names, aliases: d.aliases, namespace: d.namespace, uses: mine,
                path: d.path, pathSpan: d.pathSpan, span: d.span, provider: d.provider,
              }));
            },
            None => { out.push(it); },
          }
        },
        _ => { out.push(it); },
      }
    }
    return out;
  }
}

// True when the errors of a recovering parse begin with the error `parse` reports (and only then there are any).
function agreesWithParse(r: Result<Module, Diagnostic[]>, file: usize, src: string): bool {
  const first = parse(file, src);
  if (r.isOk() || first.isOk()) {
    return r.isOk() == first.isOk();
  }
  return sameDiag(r.unwrapErr()[0], first.unwrapErr());
}

// The syntax tree of `src` (file `file`), or its syntax errors with error recovery: at most MAX_SYNTAX_ERRORS, in source
// order, the first one exactly the error `parse` reports. A lexical error ends the scan, so it is the only error. When
// there are errors the partial tree is dropped: nothing built by recovery reaches a later phase.
@Ensures(result.isOk()
    ==> result.unwrap().file == file && moduleWellFormed(result.unwrap(), src.length))
@Ensures(result.isErr() ==> syntaxErrorsOk(result.unwrapErr(), file, src.length))
@Ensures(agreesWithParse(result, file, src))
export function parseRecovering(file: usize, src: string): Result<Module, Diagnostic[]> {
  const lr = lex(file, src);
  if (lr.isErr()) {
    return Err([lr.unwrapErr()]);
  }
  let p = new Parser(lr.unwrap());
  p.enableRecovery();
  const m = p.parseModule(file);
  if (m.isErr()) {
    return Err([m.unwrapErr()]);
  }
  const es = p.errors();
  if (es.length > 0) {
    return Err(es);
  }
  return Ok(m.unwrap());
}

// The syntax tree of `src` (file `file`), or the first lexical or syntax error. A module is well formed (spans nested
// and ordered, inside the source); an error has a parse-error code and a span inside the source.
@Ensures(result.isOk()
    ==> result.unwrap().file == file && moduleWellFormed(result.unwrap(), src.length))
@Ensures(result.isErr()
    ==> isSyntaxCode(result.unwrapErr().code)
        && result.unwrapErr().span.file == file
        && result.unwrapErr().span.end <= src.length)
export function parse(file: usize, src: string): Result<Module, Diagnostic> {
  const toks = lex(file, src)?;
  let p = new Parser(toks);
  return p.parseModule(file);
}
