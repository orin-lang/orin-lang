// Readable MIR dump (`orin mir <entry>`).

import { BinOp, UnOp, Builtin, taskOpName, coreOpName } from "../hir";
import { Span } from "../diag";
import { MType, MLocal, Operand, Instr, SwitchCase, Terminator, MBlock, MFunction, MProgram, hasSpan } from "./mir";

function u(n: usize): string {
  return n.toString();
}

function tyName(t: MType): string {
  return match (t) {
    MInt => "int",
    MUsize => "usize",
    MBool => "bool",
    MFloat => "float",
    MHandle => "handle",
    MRef => "ref",
    MVoid => "void",
    MAgg(n) => "agg" + u(n)
  };
}

function loc(i: usize): string {
  return "l" + u(i);
}

function opStr(o: Operand): string {
  return match (o) {
    OLocal(l) => loc(l),
    OInt(v) => v.toString(),
    OUsize(v) => v.toString() + "u",
    OBool(b) => b ? "true" : "false",
    OFloat(t) => "f" + t,
    OStr(i) => "str#" + u(i)
  };
}

function opsStr(os: Operand[]): string {
  let parts: string[] = [];
  for (const o of os) {
    parts.push(opStr(o));
  }
  return parts.join(", ");
}

function binName(op: BinOp): string {
  return match (op) {
    OpAdd => "add",
    OpSub => "sub",
    OpMul => "mul",
    OpDiv => "div",
    OpRem => "rem",
    OpEq => "eq",
    OpNe => "ne",
    OpLt => "lt",
    OpLe => "le",
    OpGt => "gt",
    OpGe => "ge",
    OpAnd => "and",
    OpOr => "or"
  };
}

function unName(op: UnOp): string {
  return match (op) {
    UnNot => "not",
    UnNeg => "neg"
  };
}

export function builtinName(b: Builtin): string {
  return match (b) {
    BConsoleLog => "console.log",
    BConsoleError => "console.error",
    BStringFromCharCode => "String.fromCharCode",
    BParseInt => "parseInt",
    BFsReadFile => "fs.readFile",
    BFsWriteFile => "fs.writeFile",
    BFsExists => "fs.exists",
    BFsListDir => "fs.listDir",
    BProcessArgs => "process.args",
    BProcessExit => "process.exit",
    BIoReadBytes => "io.readBytes",
    BIoReadLine => "io.readLine",
    BIoWriteStdout => "io.writeStdout",
    BIoShell => "io.shell",
    BIoShellTimeout => "io.shellTimeout",
    BTimeNowMillis => "time.nowMillis",
    BTimeMonotonicMillis => "time.monotonicMillis",
    BGrantFs => "grant.fs",
    BGrantProcess => "grant.process",
    BGrantStdio => "grant.stdio",
    BGrantClock => "grant.clock",
    BGrantUnder => "grant.under",
    BGrantReadOnly => "grant.readOnly",
    BGrantArgsOnly => "grant.argsOnly",
    BGrantRevoke => "grant.revoke",
    BTask(k) => "task." + taskOpName(k),
    BCore(k) => "core." + coreOpName(k),
    BGrantNet => "grant.net",
    BGrantListen => "grant.listen",
    BGrantConnect => "grant.connect",
    BNetListen => "net.listen",
    BNetAccept => "net.accept",
    BNetConnect => "net.connect",
    BNetStatus => "net.status",
    BNetClose => "net.close",
    BNetPort => "net.port",
    BNetNow => "net.now",
    BNetRecv => "net.recv",
    BNetSend => "net.send",
    BNetShutdown => "net.shutdown",
    BNetPeer => "net.peer",
    BNetResolve => "net.resolve",
    BNetErrorText => "net.errorText",
    BFileOpen => "file.open",
    BFileIsOpen => "file.isOpen",
    BFileOpenError => "file.openError",
    BFileClose => "file.close",
    BFileReadLine => "file.readLine",
    BFileRead => "file.read",
    BFileReadAll => "file.readAll",
    BFileWrite => "file.write",
    BFileWriteLine => "file.writeLine",
    BFileFlush => "file.flush",
    BStrLength => "str.length",
    BStrCharCodeAt => "str.charCodeAt",
    BStrCharAt => "str.charAt",
    BStrSubstring => "str.substring",
    BStrIndexOf => "str.indexOf",
    BStrIncludes => "str.includes",
    BStrStartsWith => "str.startsWith",
    BStrEndsWith => "str.endsWith",
    BStrSplit => "str.split",
    BStrTrim => "str.trim",
    BStrWithCapacity => "str.withCapacity",
    BArrLength => "arr.length",
    BArrGet => "arr.get",
    BArrSlice => "arr.slice",
    BArrConcat => "arr.concat",
    BArrJoin => "arr.join",
    BBytesToString => "bytes.toString",
    BStringToBytes => "string.toBytes",
    BIntToString => "int.toString",
    BIntToUsize => "int.toUsize",
    BUsizeToString => "usize.toString",
    BUsizeToInt => "usize.toInt",
    BBoolToString => "bool.toString",
    BOptIsSome => "opt.isSome",
    BOptIsNone => "opt.isNone",
    BOptUnwrap => "opt.unwrap",
    BOptUnwrapOr => "opt.unwrapOr",
    BResIsOk => "res.isOk",
    BResIsErr => "res.isErr",
    BResUnwrap => "res.unwrap",
    BResUnwrapErr => "res.unwrapErr",
    BParseFloat => "parseFloat",
    BFloatToString => "float.toString",
    BF32ToString => "f32.toString",
    BIntToFloat => "int.toFloat",
    BUsizeToFloat => "usize.toFloat",
    BFloatToInt => "float.toInt",
    BF32Round => "f32.round",
    BF32ToFloat => "f32.toFloat",
    BFloatFloor => "float.floor",
    BFloatCeil => "float.ceil",
    BFloatRound => "float.round",
    BFloatSqrt => "float.sqrt",
    BFloatAbs => "float.abs",
    BFloatPow => "float.pow",
    BFloatIsNaN => "float.isNaN",
    BFloatIsFinite => "float.isFinite",
    BIntRange => "int.range",
    BIntConv => "int.conv",
    BUIntConv => "uint.conv",
    BIntId => "int.id",
    BIntOp => "int.op",
    BIntChk => "int.chk",
    BParseIntK => "parseIntK"
  };
}

function dstStr(d: Option<usize>): string {
  return match (d) {
    Some(x) => loc(x) + " = ",
    None => ""
  };
}

export function instrStr(i: Instr): string {
  return match (i) {
    ICopy(d, o) => loc(d) + " = copy " + opStr(o),
    IMove(d, s) => loc(d) + " = move " + loc(s),
    IBorrow(d, s) => loc(d) + " = borrow " + loc(s),
    IDup(d, o) => loc(d) + " = dup " + opStr(o),
    IRelease(x) => "release " + loc(x),
    IUnary(d, op, o) => loc(d) + " = " + unName(op) + " " + opStr(o),
    IBinary(d, op, a, b) => loc(d) + " = " + binName(op) + " " + opStr(a) + ", " + opStr(b),
    ICall(d, f, args) => dstStr(d) + "call fn" + u(f) + "(" + opsStr(args) + ")",
    IBuiltin(d, b, args) => dstStr(d) + "builtin " + builtinName(b) + "(" + opsStr(args) + ")",
    IStrAppend(x, y) => "strappend " + loc(x) + ", " + opStr(y),
    IStrPrepend(x, y) => "strprepend " + loc(x) + ", " + opStr(y),
    IStrAppendSub(x, y, a, b) => "strappendsub " + loc(x) + ", " + opStr(y) + ", " + opStr(a) + ", " + opStr(b),
    IStrAppendNum(x, y, uns) => (uns ? "strappendu " : "strappendi ") + loc(x) + ", " + opStr(y),
    IArrayExtend(x, y) => "arrayextend " + loc(x) + ", " + opStr(y),
    IStructNew(d, tag, slots) => loc(d) + " = struct tag" + u(tag) + " {" + opsStr(slots) + "}",
    INullary(d, t) => loc(d) + " = nullary tag" + u(t),
    ITag(d, o) => loc(d) + " = tag " + opStr(o),
    IGetField(d, o, i) => loc(d) + " = getfield " + opStr(o) + "." + u(i),
    ISetField(x, i, v) => "setfield " + loc(x) + "." + u(i) + " = " + opStr(v),
    ITakeField(d, x, i) => loc(d) + " = takefield " + loc(x) + "." + u(i),
    IPutField(x, i, s) => "putfield " + loc(x) + "." + u(i) + " = " + loc(s),
    IMakeUnique(x) => "makeunique " + loc(x),
    IArrayNew(d, r, es) => loc(d) + " = arraynew " + (r ? "ref " : "val ") + "[" + opsStr(es) + "]",
    IArrayGet(d, a, i) => loc(d) + " = arrayget " + opStr(a) + "[" + opStr(i) + "]",
    IArraySet(x, i, v) => "arrayset " + loc(x) + "[" + opStr(i) + "] = " + opStr(v),
    IShapeCheck(x, i) => "shapecheck " + loc(x) + "." + u(i),
    IGetFieldU(d, o, i) => loc(d) + " = getfieldu " + opStr(o) + "." + u(i),
    ISetFieldU(x, i, v) => "setfieldu " + loc(x) + "." + u(i) + " = " + opStr(v),
    IArrayGetU(d, a, i) => loc(d) + " = arraygetu " + opStr(a) + "[" + opStr(i) + "]",
    IArraySetU(x, i, v) => "arraysetu " + loc(x) + "[" + opStr(i) + "] = " + opStr(v),
    IArrayTake(d, x, i) => loc(d) + " = arraytake " + loc(x) + "[" + opStr(i) + "]",
    IArrayPut(x, i, s) => "arrayput " + loc(x) + "[" + opStr(i) + "] = " + loc(s),
    IArrayPush(x, v) => "arraypush " + loc(x) + ", " + opStr(v),
    IArrayPop(d, x) => loc(d) + " = arraypop " + loc(x),
    IForward(d, s, o, k) => loc(d) + " = forward " + loc(s) + ", " + opStr(o) + "[" + opStr(k) + "]",
    IClosure(d, f, caps) => loc(d) + " = closure fn" + u(f) + " {" + opsStr(caps) + "}",
    ICallIndirect(d, f, args) => dstStr(d) + "callind " + opStr(f) + "(" + opsStr(args) + ")",
    IIface(d, vt, v) => loc(d) + " = iface vt" + u(vt) + " {" + opStr(v) + "}",
    ICallVirtual(d, r, slot, args) => dstStr(d) + "callvirt " + opStr(r) + "#" + u(slot) + "(" + opsStr(args) + ")"
  };
}

function casesStr(cs: SwitchCase[]): string {
  let parts: string[] = [];
  for (const c of cs) {
    parts.push(c.value.toString() + " -> b" + u(c.target));
  }
  return parts.join(", ");
}

export function termStr(t: Terminator): string {
  return match (t) {
    TGoto(b) => "goto b" + u(b),
    TBranch(c, a, b) => "branch " + opStr(c) + " ? b" + u(a) + " : b" + u(b),
    TSwitch(o, cs, d) => "switch " + opStr(o) + " [" + casesStr(cs) + "] default b" + u(d),
    TReturn(o) => match (o) {
      Some(x) => "return " + opStr(x),
      None => "return"
    },
    TTrap(m) => "trap \"" + m + "\""
  };
}

// The source position of an instruction or terminator: " @<file>:<start>-<end>" (byte offsets, `file` is an index into the
// source map), empty for code without a source position. The text parser of compiler/tests/verify_text.or reads it back.
@Ensures(hasSpan(sp) ? result.startsWith(" @") : result == "")
export function spanSuffix(sp: Span): string {
  if (!hasSpan(sp)) {
    return "";
  }
  return " @" + u(sp.file) + ":" + u(sp.start) + "-" + u(sp.end);
}

// ", owned l0 l2" when some parameter is owned, else "". A function with an in/out receiver (v1.10) adds ", inout", then ", unique-in" and ", unique-out" (v2.7).
function ownedStr(f: MFunction): string {
  let s = "";
  let i: usize = 0;
  while (i < f.paramOwned.length) {
    if (f.paramOwned[i]) {
      s += " " + loc(i);
    }
    i += 1;
  }
  return s == "" ? "" : ", owned" + s;
}

function funcStr(idx: usize, f: MFunction): string {
  let out: string[] = [];
  out.push("fn" + u(idx) + " " + f.name + " (params " + u(f.paramCount) + ownedStr(f) + (f.inout ? ", inout" : "") + (f.uniqueIn ? ", unique-in" : "") + (f.uniqueOut ? ", unique-out" : "") + ") -> " + tyName(f.ret) + "\n");
  let i: usize = 0;
  let line = "  locals:";
  while (i < f.locals.length) {
    line += " " + loc(i) + ":" + tyName(f.locals[i].ty);
    i += 1;
  }
  out.push(line + "\n");
  let b: usize = 0;
  for (const blk of f.blocks) {
    out.push("  b" + u(b) + ":\n");
    let k: usize = 0;
    for (const ins of blk.instrs) {
      out.push("    " + instrStr(ins) + spanSuffix(blk.spans[k]) + "\n");
      k += 1;
    }
    out.push("    " + termStr(blk.term) + spanSuffix(blk.termSpan) + "\n");
    b += 1;
  }
  return out.join("");
}

export function printProgram(p: MProgram): string {
  let out: string[] = [];
  let i: usize = 0;
  for (const s of p.strings) {
    out.push("str#" + u(i) + " = \"" + s + "\"\n");
    i += 1;
  }
  i = 0;
  for (const v of p.vtables) {
    let fs: string[] = [];
    for (const g of v.funcs) {
      fs.push("fn" + u(g));
    }
    out.push("vtable#" + u(i) + " = [" + fs.join(", ") + "] // " + v.name + "\n");
    i += 1;
  }
  i = 0;
  out.push("main = fn" + u(p.main) + "\n\n");
  i = 0;
  for (const f of p.functions) {
    out.push(funcStr(i, f));
    out.push("\n");
    i += 1;
  }
  return out.join("");
}
