// Typed, fully resolved HIR — Stage 1 shared contract (v1).
// Originally mirrored the Rust Stage 0 hir.rs (retired; branch archive/stage0-final). Owned by the lead
// architect. Producer: compiler/check. Consumer: compiler/lower (HIR -> MIR).
// Ids are indices (usize) into Program.records / unions / functions and Function.locals.

import { Span } from "../diag";

export type Type =
  TyInt
  | TyUsize
  | TyIntK(usize)                 // the other fixed-width integers (ADR-0022), by kind: 0 i8, 1 i16, 2 i32, 4 isize,
                                  // 5 u8, 6 u16, 7 u32, 8 u64 (3 = `int` = i64 is TyInt, 9 = usize is TyUsize)
  | TyBool
  | TyFloat                       // IEEE-754 binary64 (ADR-0018)
  | TyF32                         // IEEE-754 binary32
  | TyString
  | TyVoid
  | TyArray(Type)
  | TyOption(Type)
  | TyResult(Type, Type)
  | TyRecord(usize)
  | TyUnion(usize)
  | TyFn(Type[], Type)            // function value: parameter types, result (closures, ADR-0011)
  | TyIface(usize)                // interface value (ADR-0019): index into the checker's interface table;
                                  // a heap object { vtable pointer, boxed class value }
  | TyFile                        // resource handle of an open file (ADR-0025): NOT a value type. It exists only as
                                  // a parameter / argument (borrowed); compiler/check/resources.or rejects every
                                  // other use. A scalar in MIR (class MHandle).
  | TyGrant(usize);               // capability grant (ADR-0021 Stage A, ADR-0027): a resource handle exactly like
                                  // TyFile, created only by the runtime / the std:host scope functions. The number is the
                                  // kind: 0 Host, 1 FsGrant, 2 ProcessGrant, 3 StdioGrant, 4 ClockGrant, 5 NetGrant, 6 Listener, 7 Stream
                                  // (ADR-0033: Listener and Stream are the network resources, closed by BNetClose).

// Names of the grant types (kind -> source name).
@Ensures((k < 8) == (result != "?"))
export function grantTypeName(k: usize): string {
  const names = ["Host", "FsGrant", "ProcessGrant", "StdioGrant", "ClockGrant", "NetGrant", "Listener", "Stream"];
  return k < names.length ? names[k] : "?";
}

export type Program = {
  records: RecordDef[];
  unions: UnionDef[];
  functions: Function[];
  main: usize;
  vtables: VTable[];              // one per (class, interface) pair that is converted (ADR-0019)
  ifaces: IfaceDef[];             // interface table (names for diagnostics and tooling; TyIface indexes it)
  mutating: string[];             // qualified names ("unit.C.m") of the inferred-mutating instance methods of all classes
                                  // (tooling only, ADR-0026: instances of generic-class methods exist only when used, so
                                  // their mutability cannot be read from the functions)
  inlineFns: string[];            // names of the `@Inline` functions (ADR-0024): a backend hint, semantics unchanged
};

// An interface: qualified name and method names in slot order (ADR-0019).
export type IfaceDef = { name: string; methods: string[]; };

// A vtable: the class method functions (receiver first, all parameters borrowed) in interface-method order.
export type VTable = { name: string; funcs: usize[]; };

export type FieldDef = { name: string; ty: Type; };

// Qualified, unique, deterministic names, e.g. "users/user.User".
export type RecordDef = { name: string; fields: FieldDef[]; };

export type UnionDef = { name: string; variants: VariantDef[]; };

export type VariantDef = { name: string; payload: Type[]; };

// The parameters are the first `paramCount` locals, so there are at least that many locals.
@Invariant(this.paramCount <= this.locals.length)
export type Function = {
  name: string;
  paramCount: usize;      // the first paramCount locals are the parameters
  locals: Local[];
  ret: Type;
  body: HBlock;
  span: Span;
};

export type Local = { name: string; ty: Type; mutable: bool; };

export type HBlock = { stmts: HStmt[]; };

export type HStmt =
  HLet(usize, HExpr)                          // local, init
  | HAssign(Place, Option<BinOp>, HExpr)      // place, compound op (Add..Rem) or None, value
  | HExprStmt(HExpr)
  | HIf(HExpr, HBlock, Option<HBlock>)
  | HWhile(HExpr, HBlock)
  | HForOf(usize, HExpr, HBlock)              // local, iterated array, body
  | HBreak
  | HContinue
  | HReturn(Option<HExpr>)
  | HBlockStmt(HBlock);

export type Place = { root: usize; path: PlaceElem[]; ty: Type; };

export type PlaceElem = PField(usize, usize) | PIndex(HExpr);   // PField(recordId, fieldIndex)

export type HExpr = { kind: HExprKind; ty: Type; span: Span; };

export type UnOp = UnNot | UnNeg;

export type BinOp =
  OpAdd | OpSub | OpMul | OpDiv | OpRem
  | OpEq | OpNe | OpLt | OpLe | OpGt | OpGe
  | OpAnd | OpOr;

export type HExprKind =
  XInt(int)
  | XFloat(string)                            // float literal: canonical decimal text (type TyFloat / TyF32)
  | XBool(bool)
  | XStr(string)
  | XLocal(usize)
  | XUnary(UnOp, HExpr)
  | XBinary(BinOp, HExpr, HExpr)
  | XCall(usize, HExpr[])                     // function id, args
  | XBuiltin(Builtin, HExpr[])                // receiver (if any) is args[0]
  | XMutMethod(MutBuiltin, Place, HExpr[])
  | XField(HExpr, usize, usize)               // base, recordId, fieldIndex
  | XIndex(HExpr, HExpr)
  | XRecord(usize, Option<HExpr>, FieldInitH[])   // recordId, spread, explicit fields (source order)
  | XVariant(usize, HExpr[])                  // tag, payload; union given by HExpr.ty
  | XArray(HExpr[])
  | XTry(HExpr)
  | XCond(HExpr, HExpr, HExpr)
  | XMatch(HExpr, HArm[])
  // --- closures (ADR-0011, docs/mir.md v1.3) ---
  // XClosure(fn, captures): a function value built from the lifted function `fn` (its first parameter
  // is the environment record) and the captured values, evaluated at creation (snapshot); type TyFn.
  // XCallIndirect(callee, args): call of a function value (type TyFn), args in source order.
  | XClosure(usize, HExpr[])
  | XCallIndirect(HExpr, HExpr[])
  // --- interfaces (ADR-0019, docs/mir.md v1.5) ---
  // XIface(vtable, value): the value of a class type converted to an interface type (HExpr.ty is TyIface):
  // a snapshot of `value` boxed together with the vtable `Program.vtables[vtable]`.
  // XCallVirtual(recv, slot, args): call of interface method number `slot` on the interface value `recv`.
  | XIface(usize, HExpr)
  | XCallVirtual(HExpr, usize, HExpr[]);

export type FieldInitH = { index: usize; value: HExpr; };

// value: arm value for non-void match expressions; None if void or body diverges.
export type HArm = { pattern: HPattern; body: HBlock; value: Option<HExpr>; };

export type HPattern =
  HPWildcard
  | HPVariant(usize, Option<usize>[])         // tag, bindings (Some(local) or None for `_`)
  | HPInt(int)
  | HPStr(string)
  | HPBool(bool);

export type Builtin =
  BConsoleLog | BConsoleError | BStringFromCharCode | BParseInt
  | BFsReadFile | BFsWriteFile | BFsExists | BFsListDir | BFsRename | BFsRemoveFile | BFsRemoveDir | BFsWriteFileAtomic | BProcessArgs | BProcessExit
  // --- file resources (ADR-0025). BFileOpen / BFileIsOpen / BFileOpenError / BFileClose are the raw scope
  // primitives (internal module std:fsraw, usable only by the std:fs library); the others are the methods of
  // a `File` handle: args[0] is the handle ---
  | BFileOpen | BFileIsOpen | BFileOpenError | BFileClose
  // --- capability grants (ADR-0027). The raw primitives (internal module std:fsraw, usable only by the std:host and
  // std:fs libraries): BGrantFs.. acquire a root grant of one family from the Host, BGrantUnder / BGrantReadOnly /
  // BGrantArgsOnly narrow a grant, BGrantRevoke ends one. Like BFileOpen they define a handle that the defining
  // function must revoke on every path ---
  | BGrantFs | BGrantProcess | BGrantStdio | BGrantClock | BGrantUnder | BGrantReadOnly | BGrantArgsOnly | BGrantRevoke
  // --- network (ADR-0033; internal module std:fsraw, library code only). Handles: NetGrant = TyGrant(5), Listener = TyGrant(6),
  // Stream = TyGrant(7). Openers: BGrantNet (from the Host), BGrantListen / BGrantConnect (narrow a NetGrant), BNetListen
  // (NetGrant -> Listener), BNetAccept (Listener -> Stream), BNetConnect (NetGrant -> Stream); the closer of a Listener / Stream
  // is BNetClose (the closer of a grant is BGrantRevoke). BNetStatus / BNetClose / BNetPort / BNetNow accept the handle
  // kinds named in checker/expr.or; the others have fixed types (checker/builtins.or) ---
  | BGrantNet | BGrantListen | BGrantConnect | BNetListen | BNetAccept | BNetConnect | BNetStatus | BNetClose | BNetPort | BNetNow
  | BNetRecv | BNetSend | BNetShutdown | BNetPeer | BNetResolve | BNetErrorText
  | BFileReadLine | BFileRead | BFileReadAll | BFileWrite | BFileWriteLine | BFileFlush
  | BIoReadBytes | BIoReadLine | BIoWriteStdout | BIoShell | BIoShellTimeout | BTimeNowMillis | BTimeMonotonicMillis
  // --- tasks (ADR-0017 stage 0): `BTask(k)` is task primitive number k of taskops.or (monitors, transfer, thread start /
  // join, moving a grant into a task). Only std:task uses them (through the internal module std:fsraw). BTask(17)
  // (grantClone) and BTask(19..22) (grantAdopt*) define a handle like BGrant*; BTask(18) (grantMove) ends one ---
  | BTask(usize)
  // --- core dialect (ADR-0052 R3a): `BCore(k)` is core operation number k of coreops.or (raw loads / stores at a usize
  // address, platform memory functions, the object address of a reference). Only library code reaches them (internal
  // module std:fsraw) ---
  | BCore(usize)
  | BStrLength | BStrCharCodeAt | BStrCharAt | BStrSubstring | BStrIndexOf
  | BStrIncludes | BStrStartsWith | BStrEndsWith | BStrSplit | BStrTrim
  // BStrWithCapacity(n): a new owned empty string with room for n bytes (OX markup roots, ADR-0044); no surface method
  | BStrWithCapacity
  | BArrLength | BArrGet | BArrSlice | BArrConcat | BArrJoin
  // --- bulk conversions between a `u8[]` and a string (runtime object model, no per-byte allocation):
  // BBytesToString(a, start, len): string of a[start .. start + len); BStringToBytes(s): the bytes of s as a `u8[]` ---
  | BBytesToString | BStringToBytes
  | BIntToString | BIntToUsize | BUsizeToString | BUsizeToInt | BBoolToString
  | BOptIsSome | BOptIsNone | BOptUnwrap | BOptUnwrapOr
  | BResIsOk | BResIsErr | BResUnwrap | BResUnwrapErr
  // --- floats (ADR-0018). Arguments / results are `float` or `f32` (an f32 is kept in a double that is
  // exactly representable in binary32; lowering rounds after every builtin whose result type is f32) ---
  | BParseFloat | BFloatToString | BF32ToString | BIntToFloat | BUsizeToFloat | BFloatToInt | BF32Round
  | BF32ToFloat | BFloatFloor | BFloatCeil | BFloatRound | BFloatSqrt | BFloatAbs | BFloatPow
  | BFloatIsNaN | BFloatIsFinite
  // --- fixed-width integers (ADR-0022). A value of an integer type narrower than 64 bits, `isize` and `i64` is an
  // MInt holding its (sign- or zero-extended) value; `u64` / `usize` are MUsize. Args after the first are constants. ---
  // BIntRange(v, lo, hi): v, trap "integer overflow" unless lo <= v <= hi (after an operation on a narrow type)
  // BIntConv(v, lo, hi): like BIntRange for a conversion from a signed-pattern value, trap "integer conversion out of range"
  // BUIntConv(v, hi): conversion from a u64 / usize value (unsigned compare v <= hi)
  // BIntId(v): v unchanged (conversion that cannot fail)
  // BIntOp(mode, a, b, kind): wrapping (modes 0..2 add sub mul) / saturating (3..5) arithmetic of integer kind `kind`
  // BIntChk(mode, a, b, kind): checked add / sub / mul (modes 0..2): Option of the result
  // BIntBit(mode, a, b, kind): bit operations of integer kind `kind` on the 64-bit patterns (modes 0 and, 1 or, 2 xor, 3 not (b is 0),
  //   4 shl, 5 shr, 6 rotl, 7 rotr; the count b is an int: shl / shr trap unless 0 <= b < width, rotations take b modulo the width)
  // BParseIntK(s, kind): Option of the integer of kind `kind` parsed from s
  | BIntRange | BIntConv | BUIntConv | BIntId | BIntOp | BIntChk | BIntBit | BParseIntK;

export type MutBuiltin = MArrPush | MArrPop;

// ---------------------------------------------------------------------------
// Integer kinds (ADR-0022). Kind numbers: 0 i8, 1 i16, 2 i32, 3 i64 (= `int`), 4 isize, 5 u8, 6 u16, 7 u32,
// 8 u64, 9 usize. The runtime (`orin_int_op` etc.) uses the same numbers.
// ---------------------------------------------------------------------------

// The kind of an integer type, or -1.
@Ensures(result >= -1 && result <= 9)
export function intKindOf(t: Type): int {
  return match (t) {
    TyInt => 3,
    TyUsize => 9,
    TyIntK(k) => k.toInt(),
    _ => -1
  };
}

// The integer type of kind `k`: the inverse of `intKindOf`.
@Requires(isKindNumber(k))
@Ensures(intKindOf(result) == k)
export function kindType(k: int): Type {
  if (k == 3) {
    return TyInt;
  }
  if (k == 9) {
    return TyUsize;
  }
  return TyIntK(k.toUsize());
}

// One of the ten integer kinds.
@Ensures(result == (k >= 0 && k <= 9))
export function isKindNumber(k: int): bool {
  return k >= 0 && k <= 9;
}

@Requires(isKindNumber(k))
export function kindName(k: int): string {
  const names = ["i8", "i16", "i32", "int", "isize", "u8", "u16", "u32", "u64", "usize"];
  return names[k.toUsize()];
}

@Ensures(result == (k <= 4))
export function kindSigned(k: int): bool {
  return k <= 4;
}

// Types narrower than 64 bits: kept in an MInt and range-checked after every operation.
@Ensures(result == (kindBits(k) < 64))
@Ensures(result == (k == 0 || k == 1 || k == 2 || k == 5 || k == 6 || k == 7))
export function kindNarrow(k: int): bool {
  return k == 0 || k == 1 || k == 2 || k == 5 || k == 6 || k == 7;
}

// Machine class: true for u64 / usize (an MUsize), false for the others (an MInt).
@Ensures(result ==> !kindSigned(k) && kindBits(k) == 64)
@Ensures(result == (k == 8 || k == 9))
export function kindUnsigned64(k: int): bool {
  return k == 8 || k == 9;
}

@Ensures(result == 8 || result == 16 || result == 32 || result == 64)
@Ensures((k == 0 || k == 5) == (result == 8) && (k == 1 || k == 6) == (result == 16) && (k == 2 || k == 7) == (result == 32))
export function kindBits(k: int): int {
  if (k == 0 || k == 5) {
    return 8;
  }
  if (k == 1 || k == 6) {
    return 16;
  }
  if (k == 2 || k == 7) {
    return 32;
  }
  return 64;
}

@Ensures(result == -9223372036854775807 - 1)
export function i64Min(): int {
  return -9223372036854775807 - 1;
}

// 2^e for 0 <= e <= 62.
@Requires(e >= 0 && e <= 62)
@Ensures(result > 0)
export function pow2(e: int): int {
  let r = 1;
  let i = 0;
  @Invariant(r > 0)
  while (i < e) {
    r = r * 2;
    i += 1;
  }
  return r;
}

// Smallest value of the kind as an int (0 for the unsigned kinds).
@Ensures(kindSigned(k) == (result < 0))
@Ensures(kindSigned(k) && kindNarrow(k) ==> result == 0 - pow2(kindBits(k) - 1))
export function kindLo(k: int): int {
  if (!kindSigned(k)) {
    return 0;
  }
  const b = kindBits(k);
  return b == 8 ? -128 : (b == 16 ? -32768 : (b == 32 ? -2147483648 : i64Min()));
}

// Largest value of the kind as an int; for u64 / usize it is the pattern of 2^64-1, i.e. -1 (compare unsigned). A narrow
// kind has exactly 2^bits values from `kindLo` to `kindHi`.
@Ensures(kindUnsigned64(k) == (result == -1))
@Ensures(kindNarrow(k) ==> result - kindLo(k) + 1 == pow2(kindBits(k)))
export function kindHi(k: int): int {
  const b = kindBits(k);
  if (kindSigned(k)) {
    return b == 8 ? 127 : (b == 16 ? 32767 : (b == 32 ? 2147483647 : 9223372036854775807));
  }
  return b == 8 ? 255 : (b == 16 ? 65535 : (b == 32 ? 4294967295 : -1));
}
