// Source files, spans and diagnostics: the types every compiler phase reports errors with.

import { countNewlines, lineCol } from "../util";

// Half-open byte range [start, end) in file `file` (index into SourceMap.files).
@Invariant(this.start <= this.end)
export type Span = { file: usize; start: usize; end: usize; };

export type SourceFile = { path: string; text: string; };

export type SourceMap = { files: SourceFile[]; };

// `code` is "E" (error) or "W" (warning) followed by four digits, e.g. "E0400" (see isValidCode).
// (Record invariants are checked at every literal, field write and function result under `--check-contracts`,
// ADR-0031 A3; `diag` and `Diagnostics.add` also enforce this one without it.)
@Invariant(isValidCode(this.code) && this.span.start <= this.span.end)
export type Diagnostic = { code: string; message: string; span: Span; notes: string[]; };

// A diagnostic code: one letter, `E` or `W`, then exactly four decimal digits.
@Ensures(result ==> code.length == 5 && (code.charCodeAt(0) == 69 || code.charCodeAt(0) == 87))
@Ensures(result == (code.length == 5
    && (code.charCodeAt(0) == 69 || code.charCodeAt(0) == 87)
    && code.charCodeAt(1) >= 48 && code.charCodeAt(1) <= 57
    && code.charCodeAt(2) >= 48 && code.charCodeAt(2) <= 57
    && code.charCodeAt(3) >= 48 && code.charCodeAt(3) <= 57
    && code.charCodeAt(4) >= 48 && code.charCodeAt(4) <= 57))
export function isValidCode(code: string): bool {
  // Five fixed characters, written out (no loop): the solver proves the equivalence above directly.
  return code.length == 5
      && (code.charCodeAt(0) == 69 || code.charCodeAt(0) == 87)
      && code.charCodeAt(1) >= 48 && code.charCodeAt(1) <= 57
      && code.charCodeAt(2) >= 48 && code.charCodeAt(2) <= 57
      && code.charCodeAt(3) >= 48 && code.charCodeAt(3) <= 57
      && code.charCodeAt(4) >= 48 && code.charCodeAt(4) <= 57;
}

@Requires(start <= end)
@Ensures(result.file == file && result.start == start && result.end == end)
export function span(file: usize, start: usize, end: usize): Span {
  return Span { file: file, start: start, end: end };
}

// Smallest span covering a and b, which lie in the same file.
@Requires(a.file == b.file)
@Ensures(result.file == a.file && result.start <= a.start && result.start <= b.start)
@Ensures(result.end >= a.end && result.end >= b.end && result.start <= result.end)
export function spanTo(a: Span, b: Span): Span {
  const s = a.start < b.start ? a.start : b.start;
  const e = a.end > b.end ? a.end : b.end;
  return Span { file: a.file, start: s, end: e };
}

@Requires(isValidCode(code) && sp.start <= sp.end)
@Ensures(result.code == code && result.message == message && result.notes.length == 0)
@Ensures(result.span.file == sp.file && result.span.start == sp.start && result.span.end == sp.end)
@Ensures(isWarning(result) == (code.charCodeAt(0) == 87))
export function diag(code: string, sp: Span, message: string): Diagnostic {
  const notes: string[] = [];
  return Diagnostic { code: code, message: message, span: sp, notes: notes };
}

// `path:line:col` of the start of `sp` (1-based), for messages that point at a second location. A span
// outside the map is shown as `<unknown>`.
export function describeSpan(sm: SourceMap, sp: Span): string {
  if (sp.file >= sm.files.length) {
    return "<unknown>";
  }
  const f = sm.files[sp.file];
  const pos = lineCol(f.text, sp.start);
  return `${f.path}:${pos.line}:${pos.col}`;
}

// Warnings (ADR-0024) have codes starting with `W` (W0440 = use of a deprecated symbol); they never
// stop compilation. Everything else is an error.
@Ensures(result == (d.code.length > 0 && d.code.charCodeAt(0) == 87))
export function isWarning(d: Diagnostic): bool {
  return d.code.length > 0 && d.code.charCodeAt(0) == 87;
}

// True when `d` can be rendered against `sm`: its span lies in a file of the map, within the text
// (the end may lie past the text: spans of EOF diagnostics and of generated code are clamped by their users).
export function isRenderable(sm: SourceMap, d: Diagnostic): bool {
  return d.span.file < sm.files.length
      && d.span.start <= d.span.end
      && d.span.start <= sm.files[d.span.file].text.length;
}

// True when every note of a diagnostic appears in its rendering as a `note:` line.
function containsAllNotes(s: string, notes: string[]): bool {
  for (const n of notes) {
    if (!s.includes("\n  note: " + n)) {
      return false;
    }
  }
  return true;
}

// True when every diagnostic of `ds` can be rendered against `sm` (`every` with a pure closure: contracts
// may call it, ADR-0031 A4).
export function allRenderable(sm: SourceMap, ds: Diagnostic[]): bool {
  return ds.every(d => isRenderable(sm, d));
}

// True when every diagnostic of `ds` has a valid code and a non-inverted span.
export function allWellFormed(ds: Diagnostic[]): bool {
  return ds.every(d => isValidCode(d.code) && d.span.start <= d.span.end);
}

// Number of diagnostics of `ds` that are warnings.
export function countWarnings(ds: Diagnostic[]): usize {
  let n: usize = 0;
  for (const d of ds) {
    if (isWarning(d)) {
      n += 1;
    }
  }
  return n;
}

// `path:line:col: error[CODE]: message` (+ "\n  note: ..." lines); `warning[CODE]` for warnings.
@Requires(isRenderable(sm, d))
@Ensures(result.length > 0)
@Ensures(result.startsWith(sm.files[d.span.file].path + ":"))
@Ensures(result.includes(
  isWarning(d) ? ": warning[" + d.code + "]: " : ": error[" + d.code + "]: ",
))
@Ensures(result.includes("[" + d.code + "]: " + d.message))
@Ensures(containsAllNotes(result, d.notes))
@Ensures(countNewlines(result) >= d.notes.length)
export function render(sm: SourceMap, d: Diagnostic): string {
  const f = sm.files[d.span.file];
  const pos = lineCol(f.text, d.span.start);
  const kind = isWarning(d) ? "warning" : "error";
  const head = `${f.path}:${pos.line}:${pos.col}: ${kind}[${d.code}]: ${d.message}`;
  return head + d.notes.map(n => `\n  note: ${n}`).join("");
}

// A list of diagnostics under construction (collecting passes: manifest validation, ...). The counters
// are redundant on purpose: the invariant ties them to the list, so a code path that bypasses `add`
// (or an `add` that forgets a counter) is caught after the next method call.
@Invariant(this.errors + this.warnings == this.items.length)
@Invariant(countWarnings(this.items) == this.warnings)
@Invariant(allWellFormed(this.items))
export class Diagnostics {
  private items: Diagnostic[] = [];
  private errors: usize = 0;
  private warnings: usize = 0;

  @Requires(isValidCode(d.code) && d.span.start <= d.span.end)
  @Ensures(this.items.length == old(this.items.length) + 1)
  @Ensures(this.errors + this.warnings == old(this.errors + this.warnings) + 1)
  add(d: Diagnostic): void {
    this.items.push(d);
    if (isWarning(d)) {
      this.warnings += 1;
    } else {
      this.errors += 1;
    }
  }

  @Ensures(result == this.items.length)
  count(): usize {
    return this.items.length;
  }

  @Ensures(result == this.errors)
  errorCount(): usize {
    return this.errors;
  }

  @Ensures(result == this.errors > 0)
  hasErrors(): bool {
    return this.errors > 0;
  }

  // The collected diagnostics in insertion order.
  @Ensures(result.length == this.items.length && allWellFormed(result))
  toArray(): Diagnostic[] {
    return this.items;
  }
}
