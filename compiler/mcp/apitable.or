// Built-in API entries for `inspect("Type.member")` (spec 10 "Introspection"): signature, purity,
// complexity, allocation, failure semantics and a minimal example. Derived from
// docs/bootstrap-subset.md §6 and the runtime (runtime/core/orin_runtime.c); `Array.find` is a
// spec-level entry that the self-hosted compiler does not implement yet (status "planned").

import { Json, JStr, JObj, JField, jField, getStr } from "../json";

export type Api = {
  name: string;
  sig: string;
  fails: string;
  pure: bool;
  cost: string;
  alloc: string;
  example: string;
  status: string;
};

function api(
  name: string,
  sig: string,
  fails: string,
  cost: string,
  alloc: string,
  example: string,
): Api {
  return Api {
    name: name,
    sig: sig,
    fails: fails,
    pure: true,
    cost: cost,
    alloc: alloc,
    example: example,
    status: "implemented",
  };
}

function mutating(a: Api): Api {
  return Api { ...a, pure: false };
}

// The built-in API table. Names are unique (`apiLookup` answers the first match).
@Ensures(namesDistinct(result))
function table(): Api[] {
  return [
    api("std:json.jsonParseErrorMessage", "jsonParseErrorMessage(e: JsonParseError): string", "never fails; \"line L, column C: cause (limit)\", no input text", "O(1)", "one short string", "jsonParseErrorMessage(e)"),
    api("std:json.jsonWriteErrorMessage", "jsonWriteErrorMessage(e: JsonWriteError): string", "never fails; cause and limit name, no input text", "O(1)", "one short string", "jsonWriteErrorMessage(e)"),
    api("std:json/decode.decodeErrorMessage", "decodeErrorMessage(e: DecodeError): string", "never fails; JSON Pointer path, cause, expected/found words, never a value", "O(path bytes)", "one short string", "decodeErrorMessage(e)"),
    api("std:json/legacy.toValue", "toValue(j: Json): JsonValue", "never fails; JNum(n) becomes the exact token of n", "O(nodes)", "allocates the new tree", "toValue(j)"),
    api("std:json/legacy.fromValue", "fromValue(v: JsonValue): Result<Json, NumberError>", "NotIntegral or IntegerRange for numbers that are not an int", "O(nodes)", "allocates the new tree", "fromValue(v)"),
    api("std:json/legacy.getIndex", "getIndex(j: Json, index: usize): Option<Json>", "None for an out-of-range index or a non-array", "O(1)", "allocates Option", "getIndex(j, 0)"),
    api("std:json/legacy.getPath", "getPath(j: Json, keys: string[]): Option<Json>", "None when a key is missing or a value is not an object", "O(fields visited)", "allocates Option", "getPath(j, [\"a\", \"b\"])"),
    api("std:json/legacy.jsonErrorMessage", "jsonErrorMessage(e: JsonError): string", "never fails; \"line L, column C: message\"", "O(1)", "one short string", "jsonErrorMessage(e)"),
    api("std:json/decode.decodeRoot", "decodeRoot(value: JsonValue, limits: JsonLimits): Result<DecodeCursor, DecodeError>", "validates caller tree, UTF8 and budgets; rejects duplicates", "O(nodes + bytes) expected; hash collisions may degrade", "O(depth + live duplicate indexes)", "decodeRoot(...)"),
    api("std:json/decode.cursorValue", "cursorValue(c: DecodeCursor): JsonValue", "never fails; COW value copy", "O(1)", "shares storage", "cursorValue(...)"),
    api("std:json/decode.cursorPath", "cursorPath(c: DecodeCursor): PathSegment[]", "never fails; COW path copy", "O(1)", "shares storage", "cursorPath(...)"),
    api("std:json/decode.formatPath", "formatPath(path: PathSegment[]): string", "root empty; escapes ~ and /; caller paths not validated", "O(path bytes + segments)", "O(encoded path bytes)", "formatPath(...)"),
    api("std:json/decode.requiredField", "requiredField(c: DecodeCursor, key: string): Result<DecodeCursor, DecodeError>", "MissingField includes key; wrong parent, schema UTF8/budgets checked", "O(members + comparison bytes + key bytes + path depth)", "O(path depth)", "requiredField(...)"),
    api("std:json/decode.optionalField", "optionalField(c: DecodeCursor, key: string): Result<Option<DecodeCursor>, DecodeError>", "None only when absent; present null is Some", "O(members + comparison bytes + key bytes + path depth)", "O(path depth) when present", "optionalField(...)"),
    api("std:json/decode.decodeString", "decodeString(c: DecodeCursor): Result<string, DecodeError>", "WrongType, no coercion or raw value diagnostics", "O(1)", "fixed result, shares string", "decodeString(...)"),
    api("std:json/decode.decodeBool", "decodeBool(c: DecodeCursor): Result<bool, DecodeError>", "WrongType; no coercion", "O(1)", "fixed result", "decodeBool(...)"),
    api("std:json/decode.decodeNumber", "decodeNumber(c: DecodeCursor): Result<JsonNumber, DecodeError>", "WrongType; returns exact token", "O(1)", "fixed result, shares token", "decodeNumber(...)"),
    api("std:json/decode.decodeInt", "decodeInt(c: DecodeCursor, min: int, max: int): Result<int, DecodeError>", "InvalidSchema before type for reversed range; exact integer and inclusive bounds", "O(token bytes)", "O(1)", "decodeInt(...)"),
    api("std:json/decode.decodeArray", "decodeArray(c: DecodeCursor): Result<DecodeCursor[], DecodeError>", "WrongType; validated tree bounds apply", "O(elements * path depth)", "O(elements * path depth)", "decodeArray(...)"),
    api("std:json/decode.checkFields", "checkFields(c: DecodeCursor, allowed: string[], policy: UnknownFieldPolicy): Result<void, DecodeError>", "explicit reject/ignore; schema checked in either mode; first unknown in field order", "O(schema bytes + member-key bytes + members) expected", "O(schema index)", "checkFields(...)"),
    api("std:json.defaultLimits", "defaultLimits(): JsonLimits", "never fails", "O(1)", "one record", "defaultLimits()"),
    api("std:json.defaultReadOptions", "defaultReadOptions(): JsonReadOptions", "never fails; default rejects duplicate decoded keys", "O(1)", "fixed records", "defaultReadOptions()"),
    api("std:json.parseDocument", "parseDocument(text: string, options: JsonReadOptions): Result<JsonValue, JsonParseError>", "strict UTF8, surrogates, JSON grammar and explicit limits; byte/line/column errors; duplicate policy explicit", "O(input bytes) expected; hash collisions may degrade object duplicate checks", "O(input bytes + tree), bounded counters", "parseDocument(\"1.00e3\", defaultReadOptions())"),
    api("std:json.writeDocument", "writeDocument(v: JsonValue, limits: JsonLimits): Result<string, JsonWriteError>", "validates caller trees, UTF8 and budgets; exact number tokens and duplicate order preserved", "O(nodes + string/number/output bytes)", "O(output bytes + bounded stack)", "writeDocument(v, defaultLimits())"),
    api("std:json/number.jsonNumber", "jsonNumber(text: string, maxBytes: usize): Result<JsonNumber, NumberError>", "InvalidLimits before NumberLimit before InvalidNumber; byte offsets for limit/syntax", "O(text bytes); over-limit O(1)", "O(1); retains immutable input", "jsonNumber(\"1.00e3\", 1024)"),
    api("std:json/number.numberFromInt", "numberFromInt(n: int): JsonNumber", "never fails; full i64 range", "O(1), bounded by int width", "one short string and record", "numberFromInt(-42)"),
    api("std:json/number.numberAsInt", "numberAsInt(n: JsonNumber): Result<int, NumberError>", "NotIntegral before IntegerRange for fractional results; offsets None", "O(token bytes), no exponent expansion", "O(1)", "numberAsInt(jsonNumber(\"1e3\", 1024).unwrap())"),
    api("std:json/number.numberErrorMessage", "numberErrorMessage(e: NumberError): string", "never fails", "O(1), bounded message", "one short message", "numberErrorMessage(e)"),
    mutating(api("std:io.shell", "shell(proc: ProcessGrant, cmd: string): Result<int, ProcessError> [unstable]", "Ok(0..255) exit status (a failing command is still Ok); Err(Failed) when the command cannot run, a signal ended it or the OS failed; requires spawn-capable ProcessGrant", "O(command bytes + running time)", "O(command bytes), one child process", "shell(proc, \"printf hello\")")),
    mutating(api("std:io.shellTimeout", "shellTimeout(proc: ProcessGrant, cmd: string, timeout: Duration): Result<int, ProcessError> [unstable]", "Ok(0..255) exit status; Err kind Timeout, InvalidDuration (zero or negative) or Failed; a fraction of a second rounds up; requires spawn-capable ProcessGrant", "O(command bytes + elapsed time / 10ms); sleeps between checks", "O(command bytes), one child process and process group", "shellTimeout(proc, \"printf hello\", seconds(1))")),
    api("std:io.processErrorMessage", "processErrorMessage(e: ProcessError): string [unstable]", "never fails; \"command timed out: <cmd>\", \"timeout must be positive: <cmd>\" or \"command could not be run to completion: <cmd>\"", "O(command bytes)", "allocates message", "processErrorMessage(e)"),

    api("std:encoding.hexEncode", "hexEncode(src: Bytes): string", "never fails; lowercase ASCII hex (Bytes.toHex)", "O(n)", "O(n) output/storage", "import { hexEncode } from \"std:encoding\";"),
    api("std:encoding.hexDecode", "hexDecode(src: Bytes): Result<Bytes, EncodingError>", "Err with kind and byte offset; no partial output; strict hex; either case", "O(n)", "O(n) output/storage", "import { hexDecode } from \"std:encoding\";"),
    api("std:encoding.hexDecodeText", "hexDecodeText(s: string): Result<Bytes, EncodingError>", "hexDecode of the bytes of a string; same errors and offsets", "O(n)", "O(n) output/storage", "hexDecodeText(\"00ff\")"),
    api("std:encoding.base64Encode", "base64Encode(src: Bytes, padding: Padding): string", "never fails; RFC 4648 standard alphabet; Padded emits padding, Unpadded omits it", "O(n)", "O(n) output/storage", "import { base64Encode, Padded } from \"std:encoding\";"),
    api("std:encoding.base64Decode", "base64Decode(src: Bytes, padding: Padding): Result<Bytes, EncodingError>", "Err with kind and byte offset; no partial output; strict standard alphabet and canonical bits; Padded requires padding, Unpadded forbids it", "O(n)", "O(n) output/storage", "import { base64Decode } from \"std:encoding\";"),
    api("std:encoding.base64DecodeText", "base64DecodeText(s: string, padding: Padding): Result<Bytes, EncodingError>", "base64Decode of the bytes of a string; same errors and offsets", "O(n)", "O(n) output/storage", "base64DecodeText(\"Zm9v\", Padded)"),
    api("std:encoding.base64UrlEncode", "base64UrlEncode(src: Bytes, padding: Padding): string", "never fails; RFC 4648 URL alphabet; Padded emits padding, Unpadded omits it", "O(n)", "O(n) output/storage", "import { base64UrlEncode } from \"std:encoding\";"),
    api("std:encoding.base64UrlDecode", "base64UrlDecode(src: Bytes, padding: Padding): Result<Bytes, EncodingError>", "Err with kind and byte offset; no partial output; strict URL alphabet and canonical bits; Padded requires padding, Unpadded forbids it", "O(n)", "O(n) output/storage", "import { base64UrlDecode } from \"std:encoding\";"),
    api("std:encoding.base64UrlDecodeText", "base64UrlDecodeText(s: string, padding: Padding): Result<Bytes, EncodingError>", "base64UrlDecode of the bytes of a string; same errors and offsets", "O(n)", "O(n) output/storage", "base64UrlDecodeText(\"-_8\", Unpadded)"),
    api("std:encoding.encodingErrorMessage", "encodingErrorMessage(e: EncodingError): string", "never fails", "O(1)", "allocates message", "encodingErrorMessage(e)"),
    api("string.length", "length: usize", "never fails", "O(1)", "none", "\"abc\".length // 3"),
    api(
      "string.charCodeAt",
      "charCodeAt(i: usize): int",
      "traps if i >= length",
      "O(1)",
      "none",
      "\"A\".charCodeAt(0) // 65",
    ),
    api(
      "string.charAt",
      "charAt(i: usize): string",
      "traps if i >= length",
      "O(1)",
      "allocates 1-byte string",
      "\"abc\".charAt(1) // \"b\"",
    ),
    api(
      "string.substring",
      "substring(a: usize, b: usize): string",
      "traps unless a <= b <= length",
      "O(b-a)",
      "allocates result",
      "\"hello\".substring(1, 3) // \"el\"",
    ),
    api(
      "string.indexOf",
      "indexOf(s: string): Option<usize>",
      "None when absent",
      "O(n*m)",
      "allocates Option",
      "\"abc\".indexOf(\"c\") // Some(2)",
    ),
    api(
      "string.includes",
      "includes(s: string): bool",
      "never fails",
      "O(n*m)",
      "none",
      "\"abc\".includes(\"b\") // true",
    ),
    api(
      "string.startsWith",
      "startsWith(s: string): bool",
      "never fails",
      "O(m)",
      "none",
      "\"abc\".startsWith(\"a\")",
    ),
    api(
      "string.endsWith",
      "endsWith(s: string): bool",
      "never fails",
      "O(m)",
      "none",
      "\"abc\".endsWith(\"c\")",
    ),
    api(
      "string.split",
      "split(sep: string): string[]",
      "traps if sep is empty",
      "O(n)",
      "allocates array + parts",
      "\"a,b\".split(\",\") // [\"a\",\"b\"]",
    ),
    api(
      "string.trim",
      "trim(): string",
      "never fails",
      "O(n)",
      "allocates result",
      "\"  x \".trim() // \"x\"",
    ),
    api("Array.length", "length: usize", "never fails", "O(1)", "none", "xs.length"),
    api(
      "Array.get",
      "get(i: usize): Option<T>",
      "None when out of range",
      "O(1)",
      "allocates Option",
      "xs.get(0).unwrapOr(d)",
    ),
    mutating(
      api(
        "Array.push",
        "push(v: T): void",
        "receiver must be a mutable place (E0401)",
        "amortized O(1)",
        "may reallocate the array",
        "xs.push(1)",
      ),
    ),
    mutating(
      api(
        "Array.pop",
        "pop(): Option<T>",
        "None when empty; receiver must be a mutable place (E0401)",
        "O(1)",
        "allocates Option",
        "xs.pop()",
      ),
    ),
    api(
      "Array.slice",
      "slice(a: usize, b: usize): T[]",
      "traps unless a <= b <= length",
      "O(b-a)",
      "allocates result",
      "xs.slice(1, 3)",
    ),
    api(
      "Array.concat",
      "concat(ys: T[]): T[]",
      "never fails",
      "O(n+m)",
      "allocates result",
      "xs.concat(ys)",
    ),
    api(
      "Array.join",
      "join(sep: string): string  (receiver string[])",
      "never fails",
      "O(total bytes)",
      "allocates result",
      "[\"a\",\"b\"].join(\"-\") // \"a-b\"",
    ),
    Api {
      name: "Array.find",
      sig: "find(pred: (T) => bool): Option<T>",
      fails: "None when no element matches; never traps",
      pure: true,
      cost: "O(n), short-circuits",
      alloc: "allocates Option",
      example: "xs.find((x) => x > 2)",
      status: "planned (spec 08; not implemented in the self-hosted compiler: use a loop)",
    },
    api(
      "int.toString",
      "toString(): string",
      "never fails",
      "O(digits)",
      "allocates result",
      "(42).toString()",
    ),
    api(
      "int.toUsize",
      "toUsize(): usize  (also toI8, toI16, toI32, toI64/toInt, toIsize, toU8, toU16, toU32, toU64: any integer type to any other)",
      "traps if the value does not fit the target type",
      "O(1)",
      "none",
      "n.toUsize()",
    ),
    api(
      "int.wrappingAdd",
      "wrappingAdd(b: T): T  (also wrappingSub, wrappingMul; receiver any integer type T)",
      "never fails (two's complement wrap-around)",
      "O(1)",
      "none",
      "x.wrappingAdd(100) // 44 for x: u8 = 200 (x + 100 would trap)",
    ),
    api(
      "int.bitAnd",
      "bitAnd(b: T): T  (also bitOr, bitXor; bitNot(): T; shl(n: int): T, shr(n: int): T, rotl(n: int): T, rotr(n: int): T; receiver any integer type T)",
      "never fails, except shl and shr, which trap unless 0 <= n < the width of T; the result stays in the range of T",
      "O(1)",
      "none",
      "x.rotr(7) // 0xc1 for x: u8 = 0x83; x.shl(4) // 0x30 for x: u8 = 0x83",
    ),
    api(
      "int.saturatingAdd",
      "saturatingAdd(b: T): T  (also saturatingSub, saturatingMul)",
      "never fails (clamps to the type's range)",
      "O(1)",
      "none",
      "x.saturatingAdd(100) // 255 for u8",
    ),
    api(
      "int.checkedAdd",
      "checkedAdd(b: T): Option<T>  (also checkedSub, checkedMul)",
      "None on overflow",
      "O(1)",
      "allocates Option",
      "x.checkedAdd(100).unwrapOr(0)",
    ),
    api(
      "parseI32",
      "parseI32(s: string): Option<i32>  (also parseI8, parseI16, parseI64, parseIsize, parseU8, parseU16, parseU32, parseU64, parseUsize; parseInt = parseI64)",
      "None unless the whole string is an optionally negated decimal that fits the type",
      "O(n)",
      "allocates Option",
      "parseI32(\"-42\")",
    ),
    api(
      "usize.toString",
      "toString(): string",
      "never fails",
      "O(digits)",
      "allocates result",
      "n.toString()",
    ),
    api("usize.toInt", "toInt(): int", "traps if > i64 max", "O(1)", "none", "n.toInt()"),
    api("bool.toString", "toString(): string", "never fails", "O(1)", "none", "true.toString()"),
    api("Option.isSome", "isSome(): bool", "never fails", "O(1)", "none", "o.isSome()"),
    api("Option.isNone", "isNone(): bool", "never fails", "O(1)", "none", "o.isNone()"),
    api("Option.unwrap", "unwrap(): T", "traps on None", "O(1)", "none", "o.unwrap()"),
    api("Option.unwrapOr", "unwrapOr(d: T): T", "never fails", "O(1)", "none", "o.unwrapOr(0)"),
    api("Result.isOk", "isOk(): bool", "never fails", "O(1)", "none", "r.isOk()"),
    api("Result.isErr", "isErr(): bool", "never fails", "O(1)", "none", "r.isErr()"),
    api("Result.unwrap", "unwrap(): T", "traps on Err", "O(1)", "none", "r.unwrap()"),
    api("Result.unwrapErr", "unwrapErr(): E", "traps on Ok", "O(1)", "none", "r.unwrapErr()"),
    api(
      "Result.?",
      "expr?  (in a function returning Result<_, E>)",
      "returns Err(e) early",
      "O(1)",
      "none",
      "const n = parse(s)?;",
    ),
    api(
      "float.toString",
      "toString(): string",
      "never fails",
      "O(1)",
      "allocates result",
      "(0.1 + 0.2).toString() // \"0.30000000000000004\"",
    ),
    api(
      "float.toInt",
      "toInt(): int",
      "traps on NaN, Infinity or a value outside int; truncates toward zero",
      "O(1)",
      "none",
      "(3.99).toInt() // 3",
    ),
    api(
      "float.round",
      "round(): float  (also floor, ceil, sqrt, abs; pow(y))",
      "never fails (IEEE: NaN/Infinity propagate)",
      "O(1)",
      "none",
      "(2.5).round() // 3.0",
    ),
    api(
      "float.isNaN",
      "isNaN(): bool  (also isFinite)",
      "never fails",
      "O(1)",
      "none",
      "x.isNaN()",
    ),
    api(
      "int.toFloat",
      "toFloat(): float  (also toF32; usize likewise)",
      "never fails",
      "O(1)",
      "none",
      "n.toFloat()",
    ),
    api(
      "bytesToString",
      "bytesToString(a: u8[], start: usize, len: usize): string",
      "traps (\"slice out of range\") unless start + len <= a.length; one byte per character, no decoding",
      "O(len), one allocation",
      "allocates result",
      "bytesToString(buf, 0, 4)",
    ),
    api(
      "stringToBytes",
      "stringToBytes(s: string): u8[]",
      "never fails; one u8 per string byte, no decoding",
      "O(n), one allocation",
      "allocates result",
      "stringToBytes(\"abc\") // [97, 98, 99]",
    ),
    api(
      "parseFloat",
      "parseFloat(s: string): Option<float>",
      "None unless the whole string is a float literal, Infinity or NaN",
      "O(n)",
      "allocates Option",
      "parseFloat(\"1.5e3\")",
    ),
    api(
      "Map.get",
      "get(k: K): Option<V>  (Map<K, V>, K in int/usize/bool/string)",
      "None when absent",
      "expected O(1)",
      "allocates Option",
      "m.get(\"a\").unwrapOr(0)",
    ),
    api("bytesToString", "bytesToString(a: u8[], start: usize, len: usize): string", "traps (\"slice out of range\") unless start + len <= a.length; one byte per character, no decoding", "O(len), one allocation", "allocates result", "bytesToString(buf, 0, 4)"),
    api("stringToBytes", "stringToBytes(s: string): u8[]", "never fails; one u8 per string byte, no decoding", "O(n), one allocation", "allocates result", "stringToBytes(\"abc\") // [97, 98, 99]"),
    api("Map.has", "has(k: K): bool", "never fails", "expected O(1)", "none", "m.has(\"a\")"),
    mutating(
      api(
        "Map.set",
        "set(k: K, v: V): void",
        "receiver must be a mutable place (E0401)",
        "expected O(1); O(n) first write of a shared map",
        "may reallocate tables",
        "m.set(\"a\", 1)",
      ),
    ),
    mutating(
      api(
        "Map.delete",
        "delete(k: K): bool",
        "false when absent; receiver must be a mutable place (E0401)",
        "expected O(1)",
        "may rebuild tables",
        "m.delete(\"a\")",
      ),
    ),
    api("Map.size", "size: usize", "never fails", "O(1)", "none", "m.size"),
    api(
      "Map.keys",
      "keys(): K[]  (also values(): V[], entries(): MapEntry<K, V>[]; insertion order)",
      "never fails",
      "O(n)",
      "allocates result",
      "m.keys()",
    ),
  ].concat(
    stdTable(),
  );
}

// Std modules written in Orin (library/std/, docs/std.md): `inspect("std:path.join")` etc. The full doc
// comments live in the module sources; this is the signature/failure/cost summary.
function stdTable(): Api[] {
  return [
    api(
      "std:url.percentEncode",
      "percentEncode(s: string, space: FormSpace): string",
      "never fails; encodes raw bytes, only ALPHA/DIGIT/-._~ pass through",
      "O(n)",
      "allocates buffer and result",
      "percentEncode(\"a +\", PlusAsSpace) // a+%2B",
    ),
    api(
      "std:url.percentEncodeBytes",
      "percentEncodeBytes(b: Bytes, space: FormSpace): string",
      "never fails; arbitrary Bytes view",
      "O(n)",
      "allocates temporary string, buffer and result",
      "percentEncodeBytes(b, PercentSpace)",
    ),
    api(
      "std:url.percentDecode",
      "percentDecode(s: string, space: FormSpace): Result<string, UrlError>",
      "Err {kind, offset} for malformed %HH or invalid UTF-8; original byte offset",
      "O(n)",
      "allocates buffer and result",
      "percentDecode(\"caf%C3%A9\", PercentSpace)",
    ),
    api(
      "std:url.percentDecodeBytes",
      "percentDecodeBytes(s: string, space: FormSpace): Result<Bytes, UrlError>",
      "Err {kind, offset} for malformed %HH; accepts arbitrary decoded bytes",
      "O(n)",
      "allocates buffer, temporary string and Bytes",
      "percentDecodeBytes(\"%FF\", PercentSpace)",
    ),
    api(
      "std:url.parseQuery",
      "parseQuery(s: string, space: FormSpace): Result<QueryPair[], UrlError>",
      "strict UTF-8; original byte offsets; skips empty fields; preserves duplicate order; bare key has empty value",
      "O(n)",
      "allocates pairs and component buffers/strings",
      "parseQuery(\"a=1&a=2\", PlusAsSpace)",
    ),
    api(
      "std:url.stringifyQuery",
      "stringifyQuery(pairs: QueryPair[], space: FormSpace): Result<string, QueryEncodeError>",
      "Err {kind, pairIndex, offset} (InvalidKeyUtf8 | InvalidValueUtf8) for invalid UTF-8; emits key=value in source order",
      "O(bytes + pairs)",
      "allocates component buffers/strings and result buffer/string",
      "stringifyQuery(pairs, PlusAsSpace)",
    ),
    api(
      "std:url.urlErrorMessage",
      "urlErrorMessage(e: UrlError): string",
      "never fails",
      "O(1)",
      "allocates message",
      "urlErrorMessage(e)",
    ),
    api(
      "std:url.queryEncodeErrorMessage",
      "queryEncodeErrorMessage(e: QueryEncodeError): string",
      "never fails",
      "O(1)",
      "allocates message",
      "queryEncodeErrorMessage(e)",
    ),
    api(
      "std:path.join",
      "join(base: string, part: string): string",
      "never fails; an empty part is skipped, an absolute part does not reset, the result is normalized",
