// One function of the C output: class `CFunctionEmitter`.
//
// A direct translation: one C local per MIR local (`l<i>`), blocks as labels (`B<i>:`) and gotos. The emitter reads the
// program-wide `CSymbols` and the program (callee signatures), and writes nothing but its own text, so the text of a
// function depends only on the function, the symbol table and the callees' `inout` flags (rule 8; `emitCFunction`).

import { BinOp, UnOp, Builtin, taskOpC, taskOpRet, platOpCount, platOpName, platOpParams, platOpResult } from "../../hir";
import {
  MType, MLocal, Operand, Instr, SwitchCase, Terminator, MBlock, MFunction, MProgram, aggWords,
  isAggTy, slotWords, RT_OPT_UNWRAP, RT_RES_UNWRAP, RT_RES_UNWRAP_ERR, RT_V_UNWRAP, RT_ASSERT_FACT, RT_ASSERT_ARRAY,
  RT_STRUCT_NEW, RT_ARRAY_NEW, RT_STR_APPEND, RT_STR_APPEND_SUB, RT_STR_APPEND_USIZE, RT_STR_APPEND_INT, RT_STR_PREPEND,
  RT_ARRAY_SLICE, RT_ARRAY_CONCAT, RT_ARRAY_EXTEND, RT_BYTES_TO_STRING, RT_STRING_TO_BYTES, rtSig, l1Builtin, l1Task, RT_LAST,
} from "../../mir";

import {
  u, isRefT, isUsizeT, isFloatT, cty, fromSlot, toSlot, commentSafe, cString, intCode, refMask,
} from "./text";
import { CSymbols, refsDeclared } from "./symbols";

// ---------------------------------------------------------------- operands, operators, builtins (pure)

export function lname(i: usize): string {
  return "l" + u(i);
}

export function opC(o: Operand): string {
  return match (o) {
    OLocal(l) => lname(l),
    OInt(v) => intCode(v),
    OUsize(v) => "((uint64_t)" + v.toString() + "ULL)",
    OBool(b) => b ? "1" : "0",
    OFloat(t) => "(" + t + ")",
    OStr(i) => "orin_s" + u(i),
  };
}

function arith(op: BinOp, usz: bool, a: string, b: string): string {
  const suffix = usz ? "u" : "i";
  const name = match (op) {
    OpAdd => "add",
    OpSub => "sub",
    OpMul => "mul",
    OpDiv => "div",
    OpRem => "rem",
    _ => "?",
  };
  return "orinc_" + name + "_" + suffix + "(" + a + ", " + b + ")";
}

// IEEE arithmetic on doubles: plain C operators, no traps.
function floatArith(op: BinOp, a: string, b: string): string {
  const s = match (op) {
    OpAdd => "+",
    OpSub => "-",
    OpMul => "*",
    _ => "/",
  };
  return "(" + a + " " + s + " " + b + ")";
}

function binaryC(op: BinOp, ref: bool, usz: bool, flt: bool, a: string, b: string): string {
  return match (op) {
    OpAdd => flt ? floatArith(op, a, b) : arith(op, usz, a, b),
    OpSub => flt ? floatArith(op, a, b) : arith(op, usz, a, b),
    OpMul => flt ? floatArith(op, a, b) : arith(op, usz, a, b),
    OpDiv => flt ? floatArith(op, a, b) : arith(op, usz, a, b),
    OpRem => arith(op, usz, a, b),
    OpEq => ref ? "orin_str_eq(" + a + ", " + b + ")" : "(" + a + " == " + b + ")",
    OpNe => ref ? "(!orin_str_eq(" + a + ", " + b + "))" : "(" + a + " != " + b + ")",
    OpLt => "(" + a + " < " + b + ")",
    OpLe => "(" + a + " <= " + b + ")",
    OpGt => "(" + a + " > " + b + ")",
    OpGe => "(" + a + " >= " + b + ")",
    OpAnd => "(" + a + " && " + b + ")",
    OpOr => "(" + a + " || " + b + ")",
  };
}

function unaryC(op: UnOp, usz: bool, flt: bool, a: string): string {
  return match (op) {
    UnNot => "(!" + a + ")",
    UnNeg => flt ? "(-" + a + ")" : usz ? "orinc_neg_u(" + a + ")" : "orinc_neg_i(" + a + ")",
  };
}

// `f(a0, .., a<n-1>)` with the first `n` argument texts.
@Requires(n <= a.length)
function callN(f: string, a: string[], n: usize): string {
  return f + "(" + a.slice(0, n).join(", ") + ")";
}

// The runtime function and arity of a builtin that is a plain call, or None for the ones written inline.
type RtCall = { name: string; n: usize; };

function c(name: string, n: usize): Option<RtCall> {
  return Some(RtCall { name: name, n: n });
}

function runtimeCall(op: Builtin): Option<RtCall> {
  return match (op) {
    BConsoleLog => c("orin_console_log", 1),
    BConsoleError => c("orin_console_error", 1),
    BStringFromCharCode => c("orin_string_from_char_code", 1),
    BParseInt => c("orin_parse_int", 1),
    BFsReadFile => c("orin_fs_read_file", 2),
    BFsWriteFile => c("orin_fs_write_file", 3),
    BFsExists => c("orin_fs_exists", 2),
    BFsListDir => c("orin_fs_list_dir", 2),
    BFsRename => c("orin_fs_rename", 3),
    BFsRemoveFile => c("orin_fs_remove_file", 2),
    BFsRemoveDir => c("orin_fs_remove_dir", 2),
    BFsWriteFileAtomic => c("orin_fs_write_file_atomic", 3),
    BProcessArgs => c("orin_process_args", 1),
    BProcessExit => c("orin_process_exit", 1),
    BIoReadBytes => c("orin_io_read_bytes", 2),
    BIoReadLine => c("orin_io_read_line", 1),
    BIoWriteStdout => c("orin_io_write_stdout", 2),
    BIoShell => c("orin_io_shell", 2),
    BIoShellTimeout => c("orin_io_shell_timeout", 3),
    BTimeNowMillis => c("orin_time_now_millis", 1),
    BTimeMonotonicMillis => c("orin_time_monotonic_millis", 1),
    BGrantFs => c("orin_cap_fs", 1),
    BGrantProcess => c("orin_cap_process", 1),
    BGrantStdio => c("orin_cap_stdio", 1),
    BGrantClock => c("orin_cap_clock", 1),
    BGrantUnder => c("orin_cap_under", 2),
    BGrantReadOnly => c("orin_cap_read_only", 1),
    BGrantArgsOnly => c("orin_cap_args_only", 1),
    BGrantRevoke => c("orin_cap_revoke", 1),
    BGrantNet => c("orin_cap_net", 1),
    BGrantListen => c("orin_cap_listen", 3),
    BGrantConnect => c("orin_cap_connect", 4),
    BNetListen => c("orin_net_listen", 5),
    BNetAccept => c("orin_net_accept", 3),
    BNetConnect => c("orin_net_connect", 5),
    BNetStatus => c("orin_net_status", 1),
    BNetClose => c("orin_net_close", 1),
    BNetPort => c("orin_net_port", 1),
    BNetNow => c("orin_net_now", 1),
    BNetRecv => c("orin_net_recv", 3),
    BNetSend => c("orin_net_send", 5),
    BNetShutdown => c("orin_net_shutdown", 2),
    BNetPeer => c("orin_net_peer", 1),
    BNetResolve => c("orin_net_resolve", 2),
    BNetErrorText => c("orin_net_error_text", 1),
    BFileOpen => c("orin_file_open", 3),
    BFileIsOpen => c("orin_file_is_open", 1),
    BFileOpenError => c("orin_file_open_error", 1),
    BFileClose => c("orin_file_close", 1),
    BFileReadLine => c("orin_file_read_line", 1),
    BFileRead => c("orin_file_read", 2),
    BFileReadAll => c("orin_file_read_all", 1),
    BFileWrite => c("orin_file_write", 2),
    BFileWriteLine => c("orin_file_write_line", 2),
    BFileFlush => c("orin_file_flush", 1),
    BStrLength => c("orinc_str_len", 1),
    BStrCharCodeAt => c("orinc_str_char_code_at", 2),
    BStrCharAt => c("orin_str_char_at", 2),
    BStrSubstring => c("orin_str_substring", 3),
    BStrIndexOf => c("orin_str_index_of", 2),
    BStrIncludes => c("orin_str_includes", 2),
    BStrStartsWith => c("orin_str_starts_with", 2),
    BStrEndsWith => c("orin_str_ends_with", 2),
    BStrSplit => c("orin_str_split", 2),
    BStrTrim => c("orin_str_trim", 1),
    BStrWithCapacity => c("orin_str_with_capacity", 1),
    BArrLength => c("orinc_array_len", 1),
    BArrGet => c("orin_array_get", 2),
    BArrJoin => c("orin_array_join", 2),
    BIntToString => c("orin_int_to_string", 1),
    BIntToUsize => c("orinc_int_to_usize", 1),
    BUsizeToString => c("orin_usize_to_string", 1),
    BUsizeToInt => c("orinc_usize_to_int", 1),
    BBoolToString => c("orin_bool_to_string", 1),
    BParseFloat => c("orin_parse_float", 1),
    BFloatToString => c("orin_float_to_string", 1),
    BF32ToString => c("orin_f32_to_string", 1),
    BFloatToInt => c("orin_float_to_int", 1),
    BFloatFloor => c("__builtin_floor", 1),
    BFloatCeil => c("__builtin_ceil", 1),
    BFloatRound => c("__builtin_round", 1),
    BFloatSqrt => c("__builtin_sqrt", 1),
    BFloatAbs => c("__builtin_fabs", 1),
    BFloatPow => c("__builtin_pow", 2),
    BIntRange => c("orinc_range_i", 3),
    BIntConv => c("orinc_conv_i", 3),
    BUIntConv => c("orinc_conv_u", 2),
    BIntOp => c("orin_int_op", 4),
    BIntChk => c("orin_int_chk", 4),
    BParseIntK => c("orin_parse_int_k", 2),
    _ => None,
  };
}

// Builtins that return a borrowed slot are retained: the MIR result is Owned.
function dupIf(rt: MType, code: string): string {
  if (isRefT(rt)) {
    return "orinc_dup(" + code + ")";
  }
  return code;
}

// The address operand `a` as a C pointer.
function addrC(a: string): string {
  return "(void *)(uintptr_t)(" + a + ")";
}

// A core load (ADR-0052 R3a): `n` bytes at the address, native-endian, no alignment needed. `__builtin_memcpy` with a
// constant size is not a libc call: the compiler folds it into one (possibly unaligned) load and it is not an aliasing
// violation, unlike a pointer cast.
function loadC(a: string, cty0: string, n: string, wide: string): string {
  return "({ " + cty0 + " v_; __builtin_memcpy(&v_, " + addrC(a) + ", " + n + "); (" + wide + ")v_; })";
}

// A core store of the low `n` bytes of `v`.
function storeC(a: string, cty0: string, n: string, v: string): string {
  return "({ " + cty0 + " v_ = (" + cty0 + ")(" + v + "); __builtin_memcpy(" + addrC(a) + ", &v_, " + n + "); })";
}

// The C code of core operation k (hir/coreops.or) over the operands `a`. The memory operations are the L0 functions.
function coreC(k: usize, a: string[]): string {
  return match (k) {
    0 => loadC(a[0], "uint8_t", "1", "uint64_t"),
    1 => loadC(a[0], "uint32_t", "4", "uint64_t"),
    2 => loadC(a[0], "uint64_t", "8", "uint64_t"),
    3 => loadC(a[0], "double", "8", "double"),
    4 => storeC(a[0], "uint8_t", "1", a[1]),
    5 => storeC(a[0], "uint32_t", "4", a[1]),
    6 => storeC(a[0], "uint64_t", "8", a[1]),
    7 => storeC(a[0], "double", "8", a[1]),
    8 => "({ void *m_ = orin_platform_alloc(ORIN_SIZE(" + a[0] + ")); if (!m_) orin_trap(\"out of memory\"); (uint64_t)(uintptr_t)m_; })",
    9 => "orin_platform_free(" + addrC(a[0]) + ")",
    10 => "(void)orin_platform_mem_copy(" + addrC(a[0]) + ", " + addrC(a[1]) + ", ORIN_SIZE(" + a[2] + "))",
    11 => "(void)orin_platform_mem_set(" + addrC(a[0]) + ", (int)(uint8_t)(" + a[1] + "), ORIN_SIZE(" + a[2] + "))",
    12 => "((uint64_t)(uintptr_t)(" + a[0] + "))",
    13 => "((uint64_t)(" + a[0] + ") & (uint64_t)(" + a[1] + "))",
    14 => "((uint64_t)(" + a[0] + ") | (uint64_t)(" + a[1] + "))",
    15 => "((uint64_t)(" + a[0] + ") ^ (uint64_t)(" + a[1] + "))",
    16 => "({ uint64_t n_ = (uint64_t)(" + a[1] + "); n_ >= 64 ? (uint64_t)0 : (uint64_t)(" + a[0] + ") << n_; })",
    17 => "({ uint64_t n_ = (uint64_t)(" + a[1] + "); n_ >= 64 ? (uint64_t)0 : (uint64_t)(" + a[0] + ") >> n_; })",
    18 => "((int64_t)__builtin_expect((long)(" + a[0] + "), (long)(" + a[1] + ")))",
    19 => "((uint64_t)((" + a[0] + ") == 0 ? ORIN_CFG_FREELIST : (" + a[0] + ") == 1 ? ORIN_CFG_STATS : (" + a[0]
        + ") == 2 ? ORIN_CFG_SITES : 0))",
    20 => "((uint64_t)(uintptr_t)&orin_heap)",
    21 => "({ void *m_ = orin_platform_realloc(" + addrC(a[0]) + ", ORIN_SIZE(" + a[1]
        + ")); if (!m_) orin_trap(\"out of memory\"); (uint64_t)(uintptr_t)m_; })",
    22 => "(void)orin_platform_mem_move(" + addrC(a[0]) + ", " + addrC(a[1]) + ", ORIN_SIZE(" + a[2] + "))",
    24 => "((uint64_t)(" + a[0] + ") + (uint64_t)(" + a[1] + "))",
    25 => "((uint64_t)(" + a[0] + ") - (uint64_t)(" + a[1] + "))",
    26 => "((uint64_t)(" + a[0] + ") * (uint64_t)(" + a[1] + "))",
    30 => "((uint64_t)(uintptr_t)&orin_shared)",
    27 => "orin_core_hook((uint64_t)(" + a[0] + "), (uint64_t)(" + a[1] + "), (uint64_t)(" + a[2] + "), (uint64_t)(" + a[3] + "))",
    _ => "({ int c_ = orin_platform_mem_cmp(" + addrC(a[0]) + ", " + addrC(a[1]) + ", ORIN_SIZE(" + a[2]
        + ")); (int64_t)((c_ > 0) - (c_ < 0)); })",
  };
}

// The literal value of operand `o` (the `k` of `plat` / `fnAddr`, which the checker guarantees to be a literal), -1 for anything else.
function litOf(o: Operand): int {
  return match (o) {
    OUsize(v) => v,
    OInt(v) => v,
    _ => -1,
  };
}

// The C expression of `plat(k, a, b, c)` (hir/coreops.or 28): the direct call of the L0 function `orin_platform_<name>` with the
// arguments `a[1..]` cast to its parameter types (`n` a C int, `p` a pointer, `f` a function pointer, else a 64-bit integer); the
// result is a word (a C int sign-extended, a pointer as its address, 0 for a void function).
function platC(o: Operand, a: string[]): string {
  const k = litOf(o);
  if (k < 0 || k.toUsize() >= platOpCount()) {
    return "(orin_trap(\"internal error: plat needs a literal table index\"), (uint64_t)0)";
  }
  const ps = platOpParams(k.toUsize());
  let args = "";
  let i: usize = 0;
  while (i < ps.length) {
    const c = ps.substring(i, i + 1);
    const v = a[i + 1];
    args += (i > 0 ? ", " : "")
        + (c == "p" ? addrC(v) : c == "f" ? "(void (*)(void *))(uintptr_t)(" + v + ")" : c == "n" ? "(int)(" + v + ")" : "(int64_t)(" + v + ")");
    i += 1;
  }
  const call = "orin_platform_" + platOpName(k.toUsize()) + "(" + args + ")";
  const r = platOpResult(k.toUsize());
  return r == "v" ? "(" + call + ", (uint64_t)0)"
      : r == "n" ? "((uint64_t)(int64_t)" + call + ")"
      : r == "p" ? "((uint64_t)(uintptr_t)" + call + ")"
      : "((uint64_t)" + call + ")";
}

// The C expression of `fnAddr(k)` (hir/coreops.or 29): the address of the C-ABI wrapper of the L1 entry k (mir/rt.or `RtWrap`).
function fnAddrC(o: Operand): string {
  const k = litOf(o);
  if (k < 0) {
    return "(orin_trap(\"internal error: fnAddr needs a literal entry\"), (uint64_t)0)";
  }
  return match (rtSig(k.toUsize())) {
    Some(w) => "((uint64_t)(uintptr_t)&" + w.name + ")",
    None => "(orin_trap(\"internal error: fnAddr names an entry without a wrapper\"), (uint64_t)0)",
  };
}

// The call of a task or monitor operation (`BTask(k)`, hir/taskops.or): the Orin function of `$rt` that replaces the C function (mir/rt.or
// `l1Task`) when the program has it, with every argument as a word (objects as addresses) and an object result cast back; else the C
// runtime function `taskOpC(k)`.
function taskC(syms: CSymbols, k: usize, a: string[]): string {
  const sym = match (l1Task(k)) {
    Some(e) => syms.l1(e),
    None => "",
  };
  if (sym == "") {
    return taskOpC(k) + "(" + a.join(", ") + ")";
  }
  let args = "";
  let i: usize = 0;
  while (i < a.length) {
    args += (i > 0 ? ", " : "") + "ORIN_WORD(" + a[i] + ")";
    i += 1;
  }
  const call = sym + "(" + args + ")";
  return taskOpRet(k) == 2 ? "((OrinObj *)(uintptr_t)" + call + ")" : call;
}

// The call of the L1 function `sym` (mir/rt.or) with the object `a` as an address word.
function l1Obj(sym: string, a: string): string {
  return sym + "((uint64_t)(uintptr_t)(" + a + "))";
}

// The call of the string / array function that the L1 entry `k` replaces, with the C arguments `a`: the Orin function of `$rt`
// (objects as address words, the result cast back) when the program has it, else the C runtime function of the same signature.
@Requires(k <= RT_LAST)
function rtCallC(syms: CSymbols, k: usize, a: string[]): string {
  const sym = syms.l1(k);
  const w = rtSig(k).unwrap();
  if (sym == "") {
    return callN(w.name, a, a.length);
  }
  let args = "";
  let i: usize = 0;
  while (i < w.params.length) {
    args += (i > 0 ? ", " : "") + (w.params[i] == "o" ? "(uint64_t)(uintptr_t)(" + a[i] + ")" : a[i]);
    i += 1;
  }
  return "((OrinObj *)(uintptr_t)" + sym + "(" + args + "))";
}

// C expression for a builtin whose result is a fresh Owned ref or a scalar. `rt` is the type of the destination (MVoid
// when there is none). `syms` holds the L1 entries (the unwrap builtins call the Orin functions of `$rt`; without them the
// C runtime's).
export function builtinC(op: Builtin, a: string[], rt: MType, syms: CSymbols): string {
  match (l1Builtin(op)) {
    Some(k) => {
      return rtCallC(syms, k, a);
    },
    None => {},
  }
  match (runtimeCall(op)) {
    Some(rc) => {
      return callN(rc.name, a, rc.n);
    },
    None => {},
  }
  return match (op) {
    BOptIsSome => "(orinc_tag(" + a[0] + ") == 0)",
    BOptIsNone => "(orinc_tag(" + a[0] + ") == 1)",
    BResIsOk => "(orinc_tag(" + a[0] + ") == 0)",
    BResIsErr => "(orinc_tag(" + a[0] + ") == 1)",
    BOptUnwrap => dupIf(
      rt,
      fromSlot(rt, syms.l1(RT_OPT_UNWRAP) != "" ? l1Obj(syms.l1(RT_OPT_UNWRAP), a[0]) : callN("orin_opt_unwrap", a, 1)),
    ),
    BOptUnwrapOr => dupIf(
      rt,
      "(orinc_tag(" + a[0] + ") == 0 ? " + fromSlot(rt, "orinc_struct_get(" + a[0] + ", 0)") + " : "
          + a[1] + ")",
    ),
    BResUnwrap => dupIf(
      rt,
      fromSlot(rt, syms.l1(RT_RES_UNWRAP) != "" ? l1Obj(syms.l1(RT_RES_UNWRAP), a[0]) : callN("orin_res_unwrap", a, 1)),
    ),
    BResUnwrapErr => dupIf(
      rt,
      fromSlot(
        rt,
        syms.l1(RT_RES_UNWRAP_ERR) != "" ? l1Obj(syms.l1(RT_RES_UNWRAP_ERR), a[0]) : callN("orin_res_unwrap_err", a, 1),
      ),
    ),
    BIntToFloat => "((double)(" + a[0] + "))",
    BUsizeToFloat => "((double)(" + a[0] + "))",
    BF32Round => "((double)(float)(" + a[0] + "))",
    BF32ToFloat => "(" + a[0] + ")",
    BFloatIsNaN => "((int64_t)(!!__builtin_isnan(" + a[0] + ")))",
    BFloatIsFinite => "((int64_t)(!!__builtin_isfinite(" + a[0] + ")))",
    BIntId => "(" + a[0] + ")",
    BIntBit => "orinc_bit(" + a[0] + ", " + a[1] + ", " + a[2] + ", " + a[3] + ")",
    BTask(k) => taskC(syms, k, a),
    BCore(k) => coreC(k, a),
    _ => "?",
  };
}

function switchC(o: Operand, cases: SwitchCase[], d: usize): string {
  let s = "switch (" + opC(o) + ") {";
  for (const k of cases) {
    s += " case " + k.value.toString() + ": goto B" + u(k.target) + ";";
  }
  s += " default: goto B" + u(d) + "; }";
  return s;
}

// The `x = ..;` or `..;` statement of a call-like expression with an optional destination.
function assignOpt(d: Option<usize>, code: string): string {
  return match (d) {
    Some(x) => lname(x) + " = " + code + ";",
    None => code + ";",
  };
}

// The receiver of a call of an in/out function is a local: its address is passed (docs/mir.md v1.10; the verifier's wf
// rule). A constant there would be `&orin_s0` in C and `ptr null` in LLVM, which the callee writes through.
export function inoutArgOk(prog: MProgram, g: usize, args: Operand[]): bool {
  return !prog.functions[g].inout
      || args.length > 0
          && match (args[0]) {
            OLocal(_) => true,
            _ => false,
          };
}

// Every block a terminator continues in is one of the `n` blocks of the function (each is a label `B<i>`).
export function targetsBelow(t: Terminator, n: usize): bool {
  return match (t) {
    TGoto(a) => a < n,
    TBranch(_, a, b) => a < n && b < n,
    TSwitch(_, cases, d) => d < n && cases.every(k => k.target < n),
    TReturn(_) => true,
    TTrap(_) => true,
  };
}

// ---------------------------------------------------------------- unboxed aggregates (docs/mir.md v2.2)

// Word `k` of the aggregate held by local `l` (word 0 is the tag).
export function aggWordC(l: usize, k: usize): string {
  return lname(l) + ".w[" + u(k) + "]";
}

// The `what` code of `orin_v_unwrap` for an unwrapping builtin (the trap message of the boxed builtin).
function unwrapWhat(b: Builtin): string {
  return match (b) {
    BResUnwrap => "1",
    BResUnwrapErr => "2",
    _ => "0",
  };
}

// C expression of an Option / Result builtin whose argument 0 is the aggregate local `l` (`a1` the C text of argument 1,
// the default of `unwrapOr`); `rt` is the type of the destination (a plain scalar, or MVoid).
export function aggBuiltinC(b: Builtin, l: usize, a1: string, rt: MType, syms: CSymbols): string {
  const tag = aggWordC(l, 0);
  return match (b) {
    BOptIsSome => "(" + tag + " == 0)",
    BResIsOk => "(" + tag + " == 0)",
    BOptIsNone => "(" + tag + " == 1)",
    BResIsErr => "(" + tag + " == 1)",
    BOptUnwrapOr => "(" + tag + " == 0 ? " + fromSlot(rt, aggWordC(l, 1)) + " : " + a1 + ")",
    _ => fromSlot(
      rt,
      (syms.l1(RT_V_UNWRAP) != "" ? syms.l1(RT_V_UNWRAP) : "orin_v_unwrap") + "(" + tag + ", " + aggWordC(l, 1) + ", "
          + unwrapWhat(b) + ")",
    ),
  };
}

// ---------------------------------------------------------------- the emitter

// The function being emitted is one of the program and one of the symbol table; its parameters are declared locals.
@Invariant(this.fi < this.prog.functions.length && this.syms.count() == this.prog.functions.length)
@Invariant(this.f.paramCount <= this.f.locals.length)
@Invariant(this.syms.rtSlots() == RT_LAST + 1)
export class CFunctionEmitter {
  private syms: CSymbols;
  private prog: MProgram;
  private fi: usize;
  private f: MFunction;
  private lines: string[];
  private facts: bool;

  // `facts`: the `--assert-facts` build, which checks every `IForward` against the slot it was forwarded from.
  @Requires(fi < prog.functions.length && syms.count() == prog.functions.length)
  @Requires(prog.functions[fi].paramCount <= prog.functions[fi].locals.length)
  constructor(syms: CSymbols, prog: MProgram, fi: usize, facts: bool) {
    this.syms = syms;
    this.prog = prog;
    this.fi = fi;
    this.f = prog.functions[fi];
    this.lines = [];
    this.facts = facts;
  }

  private ty(l: usize): MType {
    return this.f.locals[l].ty;
  }

  private opTy(o: Operand): MType {
    return match (o) {
      OLocal(l) => this.f.locals[l].ty,
      OInt(_) => MInt,
      OUsize(_) => MUsize,
      OBool(_) => MBool,
      OFloat(_) => MFloat,
      OStr(_) => MRef,
    };
  }

  // A stored operand that is a scalar (not a reference, not an unboxed aggregate): the old slot value is a scalar too (the
  // slot's kind is fixed by its static type, ADR-0038 lever 2 T3), so the store needs no release and no is_ref / refmask test.
  private scalarOp(o: Operand): bool {
    return match (this.opTy(o)) {
      MInt => true,
      MUsize => true,
      MBool => true,
      MFloat => true,
      MHandle => true,
      _ => false,
    };
  }

  // `--assert-facts`: the check an unchecked array access skips, run before it (exit 70 if it would have trapped).
  private assertArray(a: Operand, k: Operand): string {
    const sym = this.syms.l1(RT_ASSERT_ARRAY);
    return this.facts
        ? (sym != "" ? sym + "((uint64_t)(uintptr_t)(" + opC(a) + "), " : "orin_assert_array(" + opC(a) + ", ") + opC(k) + "); "
        : "";
  }

  private slotOf(o: Operand): string {
    return toSlot(this.opTy(o), opC(o));
  }

  // The local operand `o` names, when it holds an unboxed aggregate.
  private aggLocal(o: Operand): Option<usize> {
    return match (o) {
      OLocal(l) => isAggTy(this.ty(l)) ? Some(l) : None,
      _ => None,
    };
  }

  // The C words a slot operand contributes to an aggregate: one for a scalar, all words of an aggregate.
  private wordsOf(o: Operand): string[] {
    match (this.aggLocal(o)) {
      Some(l) => {
        let out: string[] = [];
        let k: usize = 0;
        while (k < slotWords(this.ty(l))) {
          out.push(aggWordC(l, k));
          k += 1;
        }
        return out;
      },
      None => {},
    }
    return [this.slotOf(o)];
  }

  // `d = (OrinV<n>){{ tag, words.. }}` (the rest of the words zero).
  private aggNew(d: usize, tag: usize, slots: Operand[]): string {
    let ws: string[] = [u(tag)];
    for (const o of slots) {
      ws = ws.concat(this.wordsOf(o));
    }
    return lname(d) + " = (" + cty(this.ty(d)) + "){{" + ws.join(", ") + "}};";
  }

  // `d = o.slot` where `o` is the aggregate local `l` and `k` a word offset into its payload.
  private aggGet(d: usize, l: usize, k: usize): string {
    const t = this.ty(d);
    if (!isAggTy(t)) {
      return lname(d) + " = " + fromSlot(t, aggWordC(l, k + 1)) + ";";
    }
    let ws: string[] = [];
    let j: usize = 0;
    while (j < slotWords(t)) {
      ws.push(aggWordC(l, k + 1 + j));
      j += 1;
    }
    return lname(d) + " = (" + cty(t) + "){{" + ws.join(", ") + "}};";
  }

  // A builtin: an Option / Result builtin on an aggregate reads its words, every other one is the boxed form.
  private builtin(d: Option<usize>, b: Builtin, args: Operand[]): string {
    const rt = match (d) {
      Some(x) => this.ty(x),
      None => MVoid,
    };
    const agg: Option<usize> = args.length > 0 ? this.aggLocal(args[0]) : None;
    const code = match (agg) {
      Some(l) => aggBuiltinC(b, l, args.length > 1 ? opC(args[1]) : "0", rt, this.syms),
      None => match (b) {
        BCore(k) => k == 28 ? platC(args[0], args.map(opC)) : (k == 29 ? fnAddrC(args[0]) : builtinC(b, args.map(opC), rt, this.syms)),
        _ => builtinC(b, args.map(opC), rt, this.syms),
      },
    };
    return assignOpt(d, code);
  }

  private maskOf(os: Operand[]): usize {
    let refs: bool[] = [];
    for (const o of os) {
      refs.push(isRefT(this.opTy(o)));
    }
    return refMask(refs);
  }

  private instr(i: Instr): string {
    return match (i) {
      ICopy(d, o) => lname(d) + " = " + opC(o) + ";",
      IMove(d, s) => lname(d) + " = " + lname(s) + ";",
      IBorrow(d, s) => lname(d) + " = " + lname(s) + ";",
      IDup(d, o) => lname(d) + " = orinc_dup(" + opC(o) + ");",
      IRelease(x) => "orinc_release(" + lname(x) + ");",
      IUnary(d, op, o) => lname(d) + " = "
          + unaryC(op, isUsizeT(this.ty(d)), isFloatT(this.ty(d)), opC(o)) + ";",
      IBinary(d, op, a, b) => lname(d) + " = "
          + binaryC(
            op,
            isRefT(this.opTy(a)),
            isUsizeT(this.opTy(a)),
            isFloatT(this.opTy(a)),
            opC(a),
            opC(b),
          )
          + ";",
      ICall(d, g, args) => this.call(d, g, args),
      IBuiltin(d, b, args) => this.builtin(d, b, args),

      IStrAppend(x, y) => lname(x) + " = " + rtCallC(this.syms, RT_STR_APPEND, [lname(x), opC(y)]) + ";",
      IStrAppendSub(x, y, a, b) => lname(x) + " = " + rtCallC(this.syms, RT_STR_APPEND_SUB, [lname(x), opC(y), opC(a), opC(b)])
          + ";",
      IStrAppendNum(x, y, uns) => lname(x) + " = "
          + rtCallC(this.syms, uns ? RT_STR_APPEND_USIZE : RT_STR_APPEND_INT, [lname(x), opC(y)]) + ";",
      IStrPrepend(x, y) => lname(x) + " = " + rtCallC(this.syms, RT_STR_PREPEND, [lname(x), opC(y)]) + ";",
      IArrayExtend(x, y) => lname(x) + " = " + rtCallC(this.syms, RT_ARRAY_EXTEND, [lname(x), opC(y)]) + ";",
      IStructNew(d, tag, slots) => this.structNew(d, tag, slots),
      INullary(d, t) => isAggTy(this.ty(d))
          ? this.aggNew(d, t, [])
          : lname(d) + " = " + this.nullaryC(t) + ";",
      ITag(d, o) => match (this.aggLocal(o)) {
        Some(l) => lname(d) + " = (int64_t)" + aggWordC(l, 0) + ";",
        None => lname(d) + " = (int64_t)orinc_tag(" + opC(o) + ");",
      },
      IGetField(d, o, k) => match (this.aggLocal(o)) {
        Some(l) => this.aggGet(d, l, k),
        None => lname(d) + " = "
            + fromSlot(this.ty(d), "orinc_struct_get(" + opC(o) + ", " + u(k) + ")") + ";",
      },

      ISetField(x, k, v) => (this.scalarOp(v) ? "orinc_struct_set(" : "orinc_mir_struct_replace(")
          + lname(x) + ", " + u(k) + ", " + this.slotOf(v) + ");",
      // v2.8 (rule U6): the shape check was passed by an earlier access of this block (no `--assert-facts` re-check: see docs/mir.md)
      IShapeCheck(x, k) => "orinc_chk_slot(" + lname(x) + ", " + u(k) + ");",
      IGetFieldU(d, o, k) => lname(d) + " = " + fromSlot(this.ty(d), "orinc_struct_get_u(" + opC(o) + ", " + u(k) + ")") + ";",
      ISetFieldU(x, k, v) => (this.scalarOp(v) ? "orinc_struct_set_u(" : "orinc_mir_struct_replace_u(")
          + lname(x) + ", " + u(k) + ", " + this.slotOf(v) + ");",
      ITakeField(d, x, k) => lname(d) + " = ORIN_REF(orinc_mir_struct_take(" + lname(x) + ", " + u(k)
          + "));",
      IPutField(x, k, s) => "orinc_struct_set(" + lname(x) + ", " + u(k) + ", ORIN_SLOT(" + lname(s)
          + "));",
      IMakeUnique(x) => lname(x) + " = orinc_make_unique(" + lname(x) + ");",
      IArrayNew(d, r, es) => this.arrayNew(d, r, es),
      IArrayGet(d, a, k) => lname(d) + " = "
          + fromSlot(this.ty(d), "orinc_array_at(" + opC(a) + ", " + opC(k) + ")") + ";",
      IArraySet(x, k, v) => (this.scalarOp(v) ? "orinc_mir_array_put(" : "orinc_mir_array_replace(")
          + lname(x) + ", " + opC(k) + ", " + this.slotOf(v) + ");",
      // v2.6 (rule U1): the kind and bounds checks were passed by an earlier access of this block; `--assert-facts` re-checks them here
      IArrayGetU(d, a, k) => this.assertArray(a, k) + lname(d) + " = "
          + fromSlot(this.ty(d), "orinc_array_at_u(" + opC(a) + ", " + opC(k) + ")") + ";",
      IArraySetU(x, k, v) => this.assertArray(OLocal(x), k)
          + (this.scalarOp(v) ? "orinc_mir_array_put_u(" : "orinc_mir_array_replace_u(")
          + lname(x) + ", " + opC(k) + ", " + this.slotOf(v) + ");",
      IArrayTake(d, x, k) => lname(d) + " = ORIN_REF(orinc_mir_array_take(" + lname(x) + ", "
          + opC(k) + "));",
      IArrayPut(x, k, s) => "orinc_mir_array_put(" + lname(x) + ", " + opC(k) + ", ORIN_SLOT("
          + lname(s) + "));",
      IArrayPush(x, v) => lname(x) + " = orinc_mir_array_push(" + lname(x) + ", " + this.slotOf(v)
          + ");",
      IArrayPop(d, x) => lname(x) + " = orinc_make_unique(" + lname(x) + "); "
          + (isAggTy(this.ty(d))
              ? "orin_array_pop_v(" + lname(x) + ", " + lname(d) + ".w);"
              : lname(d) + " = orin_array_pop(" + lname(x) + ");"),

      // Check the pre-instruction slot: d may also be the index local k.
      IForward(d, s, o, k) => (this.facts
          ? (this.syms.l1(RT_ASSERT_FACT) != ""
              ? this.syms.l1(RT_ASSERT_FACT) + "((uint64_t)(uintptr_t)(" + opC(o) + "), "
              : "orin_assert_fact(" + opC(o) + ", ") + opC(k) + ", " + this.slotOf(OLocal(s)) + "); "
          : "")
          + lname(d) + " = " + lname(s) + ";",
      IClosure(d, g, caps) => this.closure(d, g, caps),
      ICallIndirect(d, c, args) => this.callThrough(
        d,
        c,
        args,
        "(uintptr_t)orinc_struct_get(" + opC(c) + ", 0)",
      ),
      IIface(d, vt, v) => this.iface(d, vt, v),
      ICallVirtual(d, r, slot, args) => this.callThrough(
        d,
        r,
        args,
        "(((void *const *)(uintptr_t)orinc_struct_get(" + opC(r) + ", 0))[" + u(slot) + "])",
      ),
    };
  }

  // A direct call; an in/out callee (docs/mir.md v1.10) stores its final receiver through the extra pointer argument.
  @Requires(g < this.prog.functions.length && inoutArgOk(this.prog, g, args))
  private call(d: Option<usize>, g: usize, args: Operand[]): string {
    let cargs = args.map(opC);
    if (this.prog.functions[g].inout) {
      cargs.push("&" + opC(args[0]));
    }
    return assignOpt(d, this.syms.name(g) + "(" + cargs.join(", ") + ")");
  }

  private structNew(d: usize, tag: usize, slots: Operand[]): string {
    if (isAggTy(this.ty(d))) {
      return this.aggNew(d, tag, slots);
    }
    const n = lname(d);

    let s = n + " = " + this.newStruct(u(tag), u(slots.length), u(this.maskOf(slots)) + "ULL") + ";";
    let k: usize = 0;
    for (const o of slots) {
      s += " orinc_struct_init(" + n + ", " + u(k) + ", " + this.slotOf(o) + ");";
      k += 1;
    }
    return s;
  }

  private arrayNew(d: usize, isRef: bool, es: Operand[]): string {
    const n = lname(d);
    const sym = this.syms.l1(RT_ARRAY_NEW);
    let s = n + " = " + (sym != "" ? "(OrinObj *)(uintptr_t)" + sym : "orin_array_new") + "(" + u(es.length) + ", "
        + (isRef ? "1" : "0") + ");";
    for (const o of es) {
      s += " orinc_array_push(" + n + ", " + this.slotOf(o) + ");";
    }
    return s;
  }

  // The C expression of a new struct (`orin_struct_new`): the Orin function of `$rt` when the program has it (a `static inline`
  // the C compiler can inline), else the C runtime's.
  private newStruct(tag: string, nslots: string, mask: string): string {
    const sym = this.syms.l1(RT_STRUCT_NEW);
    return (sym != "" ? "(OrinObj *)(uintptr_t)" + sym : "orin_struct_new") + "(" + tag + ", " + nslots + ", " + mask + ")";
  }

  // The immortal payload-less variant with tag `t`: a static object of the unit when the program has the L1 entries
  // (`nullaryDecls` in cemit.or: no table, no atomic load), else the C runtime's shared singleton.
  private nullaryC(t: usize): string {
    return this.syms.l1Loaded() ? "(OrinObj *)&orin_nz" + u(t) : "orin_nullary(" + u(t) + ")";
  }

  // A closure is a struct `{ code pointer (scalar slot 0), environment (reference slot 1) }`; the environment is a struct
  // holding the captured values in order (the immortal nullary object when nothing is captured). docs/mir.md v1.3,
  // ADR-0011.
  @Requires(g < this.prog.functions.length)
  private closure(d: usize, g: usize, caps: Operand[]): string {
    const n = lname(d);
    let s = "";
    let env = this.nullaryC(0);
    if (caps.length > 0) {
      s += "{ OrinObj *env_ = " + this.newStruct("0", u(caps.length), u(this.maskOf(caps)) + "ULL") + ";";
      let k: usize = 0;
      for (const o of caps) {
        s += " orinc_struct_init(env_, " + u(k) + ", " + this.slotOf(o) + ");";
        k += 1;
      }
      s += " ";
      env = "env_";
    }
    s += n + " = " + this.newStruct("0", "2", "2ULL") + "; orinc_struct_init(" + n + ", 0, (uint64_t)(uintptr_t)&"
        + this.syms.name(g) + "); orinc_struct_init(" + n + ", 1, ORIN_SLOT(" + env + "));";
    if (caps.length > 0) {
      s += " }";
    }
    return s;
  }

  // Call through a closure or a vtable entry (`code` is the function pointer as an integer or `void *`): cast to the C
  // type implied by the operand and destination types, the environment / boxed value (slot 1 of `r`) first.
  private callThrough(d: Option<usize>, r: Operand, args: Operand[], code: string): string {
    const c = opC(r);
    const rt = match (d) {
      Some(x) => cty(this.ty(x)),
      None => "void",
    };
    let sig = rt + " (*)(OrinObj *";
    let cargs: string[] = ["ORIN_REF(orinc_struct_get(" + c + ", 1))"];
    for (const a of args) {
      sig += ", " + cty(this.opTy(a));
      cargs.push(opC(a));
    }
    sig += ")";
    return assignOpt(d, "((" + sig + ")" + code + ")(" + cargs.join(", ") + ")");
  }

  // An interface value (docs/mir.md v1.5, ADR-0019): a struct `{ vtable pointer (scalar slot 0), boxed value (reference
  // slot 1) }`; the vtable is the static table `orin_vtN`.
  @Requires(vt < this.syms.vtables())
  private iface(d: usize, vt: usize, v: Operand): string {
    const n = lname(d);
    return n + " = " + this.newStruct("0", "2", "2ULL") + "; orinc_struct_init(" + n
        + ", 0, (uint64_t)(uintptr_t)orin_vt" + u(vt) + "); orinc_struct_init(" + n + ", 1, "
        + this.slotOf(v) + ");";
  }

  @Requires(targetsBelow(t, this.f.blocks.length))
  private term(t: Terminator): string {
    return match (t) {
      TGoto(b) => "goto B" + u(b) + ";",
      TBranch(c, a, b) => "if (" + opC(c) + ") goto B" + u(a) + "; else goto B" + u(b) + ";",
      TSwitch(o, cases, d) => switchC(o, cases, d),
      TReturn(o) => {
        const out = this.f.inout ? "{ *orin_out = l0; " : "";
        const end = this.f.inout ? " }" : "";
        return match (o) {
          Some(x) => out + "return " + opC(x) + ";" + end,
          None => out + "return;" + end,
        };
      },
      TTrap(m) => "orin_trap(" + cString(m) + ");",
    };
  }

  // Emits the whole function: signature, the non-parameter locals (zero-initialised), the blocks.
  // In a census build (`--stats-sites`) every instruction and terminator is preceded by `ORIN_SITE(n, orin_site_caller);`
  // with consecutive ids from the function's first site (`CSymbols.firstSite`), and the function remembers its caller's
  // site; a normal build has neither.
  @Requires(this.lines.length == 0)
  @Ensures(this.syms.firstSite(this.fi) == 0
      ==> this.lines.length
          == 2 + (this.f.locals.length - this.f.paramCount) + linesOfBlocks(this.f.blocks))
  @Ensures(this.syms.firstSite(this.fi) > 0
      ==> this.lines.length
          == 3 + (this.f.locals.length - this.f.paramCount) + linesOfBlocks(this.f.blocks))
  run(): void {
    const f = this.f;
    this.lines.push(this.syms.sig(this.fi) + " {\n");
    let i = f.paramCount;
    while (i < f.locals.length) {
      const l = f.locals[i];
      const init = isRefT(l.ty) ? "NULL" : isAggTy(l.ty) ? "{{0}}" : "0";
      this.lines.push(
        "  " + cty(l.ty) + " " + lname(i) + " = " + init + "; /* " + commentSafe(l.name) + " */\n",
      );
      i += 1;
    }
    let b: usize = 0;
    let site = this.syms.firstSite(this.fi);
    if (site > 0) {
      // census: the site that called this function (one level of calling context for the allocations made here)
      this.lines.push("  const uint32_t orin_site_caller = orin_site_cur;\n");
    }
    for (const blk of f.blocks) {
      this.lines.push("B" + u(b) + ":;\n");
      for (const ins of blk.instrs) {
        this.lines.push("  " + siteMark(site) + this.instr(ins) + "\n");
        site = nextSite(site);
      }
      this.lines.push("  " + siteMark(site) + this.term(blk.term) + "\n");
      site = nextSite(site);
      b += 1;
    }
    this.lines.push("}\n");
  }

  // The text emitted so far.
  text(): string {
    return this.lines.join("");
  }
}

// Census mode: `ORIN_SITE(n, orin_site_caller); ` in front of every instruction and terminator; nothing when off (site 0).
function siteMark(site: usize): string {
  return site == 0 ? "" : "ORIN_SITE(" + u(site) + ", orin_site_caller); ";
}

function nextSite(site: usize): usize {
  return site == 0 ? 0 : site + 1;
}

// Number of lines the blocks take: a label, the instructions, the terminator.
export function linesOfBlocks(blocks: MBlock[]): usize {
  return blocks.reduce((n: usize, b: MBlock) => n + b.instrs.length + 2, 0);
}

// The C definition of function `fi`: a function of the symbol table and the program only (no state is shared between
// two calls), so the functions of a program can be emitted independently and joined in index order. The text starts
// with the function's own signature and refers only to symbols the table declares.
@Requires(fi < prog.functions.length && syms.count() == prog.functions.length)
@Ensures(result.startsWith(syms.sig(fi) + " {\n") && result.endsWith("}\n"))
@Ensures(refsDeclared(result, syms))
export function emitCFunction(syms: CSymbols, prog: MProgram, fi: usize): string {
  return emitCFunctionWith(syms, prog, fi, false);
}

// `emitCFunction`, and with `facts` (`--assert-facts`) a check of the forwarded value after every `IForward`.
@Requires(fi < prog.functions.length && syms.count() == prog.functions.length)
@Ensures(result.startsWith(syms.sig(fi) + " {\n") && result.endsWith("}\n"))
@Ensures(refsDeclared(result, syms))
export function emitCFunctionWith(syms: CSymbols, prog: MProgram, fi: usize, facts: bool): string {
  let e = new CFunctionEmitter(syms, prog, fi, facts);
  e.run();
  return e.text();
}
