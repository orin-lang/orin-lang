// The split layout of the generated C (ADR-0049 P1): the same program as N + 1 translation units that `cc` can compile in
// parallel. Nothing is re-emitted: the function texts of the single-file unit (cemit.or) are distributed over the units.
//
//   <base>.h        the preamble, every prototype, the string and vtable declarations, the bodies of the `static inline`
//                   functions (each unit that includes it gets its own copy: they are `@Inline` hints, ADR-0024, and
//                   keeping them visible keeps them inlinable)
//   <base>.<k>.c    `#include` of the header and the other functions, k = 0 .. n-1
//   <base>.data.c   the string literals (the runtime's `ORIN_STRING_LIT`, so the object layout stays the runtime's),
//                   exported through `orin_s<k>_x` pointers that the header maps back to the `orin_s<k>` names the function
//                   bodies use; the vtables (`orin_vt<k>`, now with external linkage); `main`. It repeats the preamble,
//                   the prototypes and the inline bodies instead of including the header, because the header's
//                   declarations of the strings and vtables would clash with these definitions.
//
// Functions other than `@Inline` already have external linkage and a unique symbol (`orin_fn_<index>_<name>`), so they
// need no renaming. A string literal stays one object (never duplicated per unit); a vtable stays one table. The rule is
// deterministic: the non-inline functions are cut into n runs of consecutive indices of about equal text length.

import { MProgram, rtWrappersOn } from "../../mir";
import { u, commentSafe, cString, cPreamble } from "./text";
import { CSymbols } from "./symbols";
import { nullaryDecls } from "./nullary";
import { rtWrapDecls } from "./rtwrap";

// `whole` is the single-file unit (`joinC`); the rest is its split form.
export type CSplit = { whole: string; header: string; data: string; units: string[]; };

function isInlineSig(syms: CSymbols, i: usize): bool {
  return syms.sig(i).startsWith("static inline ");
}

// The unit (0 .. n-1) of a function whose text has length `len` and that follows `before` characters of functions.
// The middle of the text decides, so the runs are balanced to within one function.
export function unitOf(before: usize, len: usize, total: usize, n: usize): usize {
  if (total == 0) {
    return 0;
  }
  const k = (before + len / 2) * n / total;
  return k < n ? k : n - 1;
}

@Requires(syms.count() == prog.functions.length && bodies.length == prog.functions.length && n >= 1)
@Ensures(result.units.length == n)
export function splitC(
  prog: MProgram,
  syms: CSymbols,
  bodies: string[],
  whole: string,
  floats: bool,
  header: string,
  n: usize,
): CSplit {
  const pre = cPreamble(floats);
  let protos: string[] = [];
  let inl: string[] = [];
  let total: usize = 0;
  let i: usize = 0;
  while (i < syms.count()) {
    protos.push(syms.sig(i) + ";\n");
    if (isInlineSig(syms, i)) {
      inl.push(bodies[i]);
      inl.push("\n");
    } else {
      total += bodies[i].length;
    }
    i += 1;
  }
  let h: string[] = [pre];
  h.push(protos.join(""));
  h.push("\n");
  let d: string[] = [pre];
  d.push(protos.join(""));
  d.push("\n");
  let k: usize = 0;
  while (k < prog.strings.length) {
    const s = prog.strings[k];
    const name = "orin_s" + u(k);
    h.push("extern OrinObj *const " + name + "_x;\n#define " + name + " " + name + "_x\n");
    d.push("ORIN_STRING_LIT(" + name + ", " + s.length.toString() + ", " + cString(s) + ");\n");
    d.push("OrinObj *const " + name + "_x = " + name + ";\n");
    k += 1;
  }
  h.push(nullaryDecls(prog, syms));
  d.push(nullaryDecls(prog, syms));
  h.push("\n");
  d.push("\n");
  d.push(inl.join(""));
  d.push(rtWrapDecls(syms, rtWrappersOn(prog)));
  k = 0;
  for (const v of prog.vtables) {
    h.push("extern void *const orin_vt" + u(k) + "[];\n");
    let fs: string[] = v.funcs.map(g => "(void *)&" + syms.name(g));
    if (fs.length == 0) {
      fs.push("NULL");
    }
    d.push(
      "void *const orin_vt" + u(k) + "[] = { " + fs.join(", ") + " }; /* " + commentSafe(v.name)
          + " */\n",
    );
    k += 1;
  }
  h.push("\n");
  d.push("\n");
  h.push(inl.join(""));
  const hostArg = prog.functions[prog.main].paramCount == 1 ? "orin_cap_host_root()" : "";
  d.push(
    "int main(int argc, char **argv) {\n  orin_init(argc, argv);\n  " + syms.name(prog.main) + "("
        + hostArg + ");\n  orin_flush();\n  return 0;\n}\n",
  );
  let units: string[][] = [];
  k = 0;
  while (k < n) {
    units.push([
      "/* Generated by orinc (split unit " + u(k) + " of " + u(n)
          + "). Do not edit. */\n#include \"" + header + "\"\n\n",
    ]);
    k += 1;
  }
  let before: usize = 0;
  i = 0;
  while (i < syms.count()) {
    if (!isInlineSig(syms, i)) {
      const len = bodies[i].length;
      const t = unitOf(before, len, total, n);
      units[t].push(bodies[i]);
      units[t].push("\n");
      before += len;
    }
    i += 1;
  }
  return CSplit {
    whole: whole,
    header: h.join(""),
    data: d.join(""),
    units: units.map(x => x.join("")),
  };
}
