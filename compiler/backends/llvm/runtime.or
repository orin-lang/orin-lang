    "declare ptr @orin_usize_to_string(i64)",
    "declare ptr @orin_bool_to_string(i64)",
    "declare ptr @orin_parse_float(ptr)",
    "declare i64 @orin_int_op(i64, i64, i64, i64)",
    "declare ptr @orin_int_chk(i64, i64, i64, i64)",
