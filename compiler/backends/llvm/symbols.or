// The program-wide symbol table of the LLVM backend (rewrite step 3d, rule 8).
//
// Everything numbered across the program is fixed here, in one step that walks the program in a fixed order before any
// function is emitted: the function symbols (shared with the C backend, `fnSymbol`), the trap messages (`@.m<k>`: the
// prelude's fixed messages first, then every other `TTrap` message in function, block order, first occurrence wins), and
// the counts of string literals (`@orin_s<k>`) and vtables (`@orin_vt<k>`). Emitting a function only reads this table.

import { MProgram, rtIds, rtLoaded, rtWraps, rtTestWraps, RT_LAST } from "../../mir";
import { fnSymbol } from "../c";
import { fixedMsgs, prelude, declares, coreDeclares, factsDeclare } from "./runtime";

// Function symbols in function order, all distinct; trap messages without repeats, each indexed by `msgIdx`; the runtime
// symbols the module declares or defines (C runtime, prelude helpers, intrinsics).
@Invariant(this.byName.size == this.names.length)
@Invariant(this.msgIdx.size == this.msgs.length)
@Invariant(this.msgs.length >= 9)
@Invariant(this.rt.length == RT_LAST + 1)
export class LlvmSymbols {
  private names: string[];
  private byName: Map<string, usize>;
  private msgs: string[];
  private msgIdx: Map<string, usize>;
  private runtime: Map<string, bool>;
  private nStrings: usize;
  private nVtables: usize;
  private rt: int[];

  @Requires(rt.length == RT_LAST + 1)
  constructor(
    names: string[],
    byName: Map<string, usize>,
    msgs: string[],
    msgIdx: Map<string, usize>,
    runtime: Map<string, bool>,
    nStrings: usize,
    nVtables: usize,
    rt: int[],
  ) {
    this.names = names;
    this.byName = byName;
    this.msgs = msgs;
    this.msgIdx = msgIdx;
    this.runtime = runtime;
    this.nStrings = nStrings;
    this.nVtables = nVtables;
    this.rt = rt;
  }

  // The symbol of the L1 entry `k` (mir/rt.or) in the program; "" when the program has none (it then calls the C runtime).
  @Requires(k < this.rt.length)
  l1(k: usize): string {
    return this.rt[k] < 0 ? "" : this.names[this.rt[k].toUsize()];
  }

  // Number of L1 entry slots (one per entry of mir/rt.or, so every `RT_*` number is below it).
  @Ensures(result == this.rt.length && result == RT_LAST + 1)
  rtSlots(): usize {
    return this.rt.length;
  }

  // True when the program was built with the L1 entries (`$rt` loaded): its immortal variants are global objects.
  l1Loaded(): bool {
    return rtLoaded(this.rt);
  }

  @Ensures(result == this.names.length)
  count(): usize {
    return this.names.length;
  }

  @Ensures(result == this.nStrings)
  strings(): usize {
    return this.nStrings;
  }

  @Ensures(result == this.nVtables)
  vtables(): usize {
    return this.nVtables;
  }

  messages(): string[] {
    return this.msgs;
  }

  @Requires(i < this.names.length)
  @Ensures(this.byName.get(result).isSome() && this.byName.get(result).unwrap() == i)
  name(i: usize): string {
    return this.names[i];
  }

  isFunction(sym: string): bool {
    return this.byName.has(sym);
  }

  // True when `m` has a global `@.m<k>`.
  hasMessage(m: string): bool {
    return this.msgIdx.has(m);
  }

  // The index k of the global `@.m<k>` that holds `m`.
  @Requires(this.hasMessage(m))
  @Ensures(result < this.msgs.length && this.msgs[result] == m)
  message(m: string): usize {
    return this.msgIdx.get(m).unwrap();
  }

  // True when `sym` (without `@`) is declared or defined by the fixed part of the module.
  isRuntime(sym: string): bool {
    return this.runtime.has(sym);
  }
}

// The names that the `declare` / `define` lines of `text` introduce, and the external globals it declares.
export function introducedNames(text: string): string[] {
  let out: string[] = [];
  for (const line of text.split("\n")) {
    if (line.startsWith("@") && line.includes(" = external ")) {
      // a global of the C runtime (`@orin_heap = external thread_local ...`)
      out.push(line.substring(1, line.indexOf(" ").unwrap()));
    }
    if (line.startsWith("declare ") || line.startsWith("define ")) {
      const at = line.indexOf("@");
      if (at.isSome()) {
        const start = at.unwrap() + 1;
        let end = start;
        while (end < line.length && line.charCodeAt(end) != 40) {
          end += 1;
        }
        out.push(line.substring(start, end));
      }
    }
  }
  return out;
}

// The table of `prog`, built before any function is emitted.
@Ensures(result.count() == prog.functions.length)
@Ensures(result.strings() == prog.strings.length && result.vtables() == prog.vtables.length)
@Ensures(trapsIndexed(prog, result))
export function llvmSymbols(prog: MProgram): LlvmSymbols {
  let names: string[] = [];
  let byName = new Map<string, usize>();
  let i: usize = 0;
  for (const f of prog.functions) {
    const n = fnSymbol(i, f.name);
    names.push(n);
    byName.set(n, i);
    i += 1;
  }
  let msgs = fixedMsgs();
  let msgIdx = new Map<string, usize>();
  i = 0;
  for (const m of msgs) {
    msgIdx.set(m, i);
    i += 1;
  }
  for (const f of prog.functions) {
    for (const b of f.blocks) {
      match (b.term) {
        TTrap(m) => {
          if (!msgIdx.has(m)) {
            msgIdx.set(m, msgs.length);
            msgs.push(m);
          }
        },
        _ => {},
      }
    }
  }
  let runtime = new Map<string, bool>();
  for (const n of introducedNames(declares() + coreDeclares(prog) + factsDeclare() + prelude())) {
    runtime.set(n, true);
  }
  // the C-named wrappers of the L1 entries (rtwrap.or) are defined by the module itself; `fnAddr` takes the address of one
  for (const w of rtWraps()) {
    runtime.set(w.name, true);
  }
  for (const w of rtTestWraps()) {
    runtime.set(w.name, true);
  }
  return new LlvmSymbols(
    names,
    byName,
    msgs,
    msgIdx,
    runtime,
    prog.strings.length,
    prog.vtables.length,
    rtIds(prog),
  );
}

// Every trap message of the program has a global.
export function trapsIndexed(prog: MProgram, syms: LlvmSymbols): bool {
  return prog.functions.every(
    f => f.blocks.every(
      b => match (b.term) {
        TTrap(m) => syms.hasMessage(m),
        _ => true,
      },
    ),
  );
}

// ---------------------------------------------------------------- what a piece of IR refers to

function isDigit(c: int): bool {
  return c >= 48 && c <= 57;
}

// Characters of an unquoted LLVM global name.
function isNameChar(c: int): bool {
  return isDigit(c) || c >= 65 && c <= 90 || c >= 97 && c <= 122 || c == 95 || c == 46 || c == 36;
}

// `<prefix><k>` with k decimal below n (the whole name).
function numberedBelow(w: string, prefix: string, n: usize): bool {
  if (!w.startsWith(prefix) || w.length == prefix.length) {
    return false;
  }
  let v: usize = 0;
  let j = prefix.length;
  while (j < w.length) {
    const c = w.charCodeAt(j);
    if (!isDigit(c)) {
      return false;
    }
    if (v < 1000000000) {
      v = v * 10 + (c - 48).toUsize();
    }
    j += 1;
  }
  return v < n;
}

// Is the global `@w` defined in a module built from `syms`?
function globalDeclared(w: string, syms: LlvmSymbols): bool {
  if (w.startsWith("orin_fn_")) {
    // `<f>.body`: the body of a function split into wrapper and body (function.or `guardBlock`).
    return syms.isFunction(w)
        || w.endsWith(".body") && syms.isFunction(w.substring(0, w.length - 5));
  }
  if (w.startsWith(".m")) {
    return numberedBelow(w, ".m", syms.messages().length);
  }
  if (numberedBelow(w, "orin_s", syms.strings()) || numberedBelow(w, "orin_vt", syms.vtables())) {
    return true;
  }
  if (w.startsWith("orin_nz") && w.length > 7 && syms.l1Loaded()) {
    // a static payload-less variant (`nullaryDecls` in llvm.or): the tag is any decimal number
    return numberedBelow(w, "orin_nz", 4294967296);
  }
  return syms.isRuntime(w) || w == "main";
}

// Every global that `text` (the IR of one function, or the whole module) mentions is defined: a function of the program,
// a trap message, a string literal, a vtable, or a runtime function / prelude helper / intrinsic that the module declares.
// `c"..."` constants are skipped. Catches a builtin mapped to a runtime function nobody declared (`opt` would reject the
// module with "use of undefined value"), a stale function symbol, a trap message without its global, a string or vtable
// index past its table.
export function llvmRefsDeclared(text: string, syms: LlvmSymbols): bool {
  let i: usize = 0;
  while (i < text.length) {
    const c = text.charCodeAt(i);
    if (c == 99 && i + 1 < text.length && text.charCodeAt(i + 1) == 34) {
      // c"..." (no escaped quote: llStr writes `"` as \22)
      let j = i + 2;
      while (j < text.length && text.charCodeAt(j) != 34) {
        j += 1;
      }
      i = j + 1;
    } else if (c == 64) {
      let j = i + 1;
      while (j < text.length && isNameChar(text.charCodeAt(j))) {
        j += 1;
      }
      if (!globalDeclared(text.substring(i + 1, j), syms)) {
        return false;
      }
      i = j;
    } else {
      i += 1;
    }
  }
  return true;
}

// The globals a module defines: the name of every `@name = ..` line and of every `define` / `declare` line.
export function definedGlobals(text: string): Map<string, bool> {
  let out = new Map<string, bool>();
  for (const line of text.split("\n")) {
    if (line.startsWith("@")) {
      const sp = line.indexOf(" ");
      if (sp.isSome()) {
        out.set(line.substring(1, sp.unwrap()), true);
      }
    }
  }
  for (const n of introducedNames(text)) {
    out.set(n, true);
  }
  return out;
}

// Everything the table numbers is defined in `text` (the whole module): every function symbol, trap message, string
// literal and vtable has its global. Together with `llvmRefsDeclared` (every reference is to something the table numbers)
// this says that every reference resolves. Catches a join that leaves out a section (the vtables, the messages).
export function globalsDefined(text: string, syms: LlvmSymbols): bool {
  const d = definedGlobals(text);
  let i: usize = 0;
  while (i < syms.count()) {
    if (!d.has(syms.name(i))) {
      return false;
    }
    i += 1;
  }
  return numberedDefined(d, ".m", syms.messages().length)
      && numberedDefined(d, "orin_s", syms.strings())
      && numberedDefined(d, "orin_vt", syms.vtables());
}

function numberedDefined(d: Map<string, bool>, prefix: string, n: usize): bool {
  let k: usize = 0;
  while (k < n) {
    if (!d.has(prefix + k.toString())) {
      return false;
    }
    k += 1;
  }
  return true;
}
