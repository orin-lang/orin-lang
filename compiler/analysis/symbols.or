// AST-level queries that need no checker support: document symbols and completion candidates.
//
// Phase 1 limitation: a file with a syntax error has NO symbols (the parser is not error
// tolerant); callers may answer from a cached earlier result.

import { FsGrant } from "std:fs";
import {
  Item, FunctionDecl, TypeDecl, ConstDecl, ImportDecl, importedName, TypeExpr, Param, FieldDecl, VariantDecl,
  Ident, InterfaceDecl, ClassDecl, parse, lex,
} from "../syntax";
import { Span } from "../diag";
import { dirname, joinPath, normalizePath, isNormalized, preludeRoots } from "../loader";
import { Workspace, fileText } from "./workspace";

export type DeclKind =
  DkFunction
  | DkRecord
  | DkUnion
  | DkAlias
  | DkConst
  | DkField
  | DkVariant
  | DkKeyword
  | DkBuiltinType
  | DkImported
  | DkLocal
  | DkInterface;

// A declaration with its spans. `span` covers the whole declaration, `nameSpan` its name; both
// are in file 0 of the parse (byte offsets are what matters).
export type DocSymbol = {
  name: string;
  kind: DeclKind;
  detail: string;
  exported: bool;
  span: Span;
  nameSpan: Span;
  children: DocSymbol[]; // record fields / union variants
};

export type CompletionItem = { label: string; kind: DeclKind; detail: string; };

// ---- rendering ----------------------------------------------------------------------------

export function renderType(t: TypeExpr): string {
  return match (t.kind) {
    TNamed(id, args) => {
      if (args.length == 0) {
        return id.name;
      }
      let parts: string[] = [];
      for (const a of args) {
        parts.push(renderType(a));
      }
      return id.name + "<" + parts.join(", ") + ">";
    },
    TArray(e) => {
      const inner = renderType(e);
      return match (e.kind) {
        TFn(_, _) => "(" + inner + ")[]",
        _ => inner + "[]",
      };
    },
    TFn(ps, ret) => {
      let parts: string[] = [];
      for (const p of ps) {
        parts.push(p.name.name + ": " + renderType(p.ty));
      }
      return "(" + parts.join(", ") + ") => " + renderType(ret);
    },
  };
}

function renderParams(ps: Param[]): string {
  let parts: string[] = [];
  for (const p of ps) {
    parts.push(p.name.name + ": " + renderType(p.ty));
  }
  return parts.join(", ");
}

function funcSymbol(f: FunctionDecl): DocSymbol {
  let detail = "function " + f.name.name + "(" + renderParams(f.params) + ")";
  match (f.ret) {
    Some(t) => {
      detail += ": " + renderType(t);
    },
    None => {},
  }
  const none: DocSymbol[] = [];
  return DocSymbol {
    name: f.name.name,
    kind: DkFunction,
    detail: detail,
    exported: f.exported,
    span: f.span,
    nameSpan: f.name.span,
    children: none,
  };
}

function fieldSymbol(fd: FieldDecl): DocSymbol {
  const none: DocSymbol[] = [];
  return DocSymbol {
    name: fd.name.name,
    kind: DkField,
    detail: renderType(fd.ty),
    exported: false,
    span: fd.span,
    nameSpan: fd.name.span,
    children: none,
  };
}

function variantSymbol(v: VariantDecl, owner: string, exported: bool): DocSymbol {
  let detail = owner;
  if (v.payload.length > 0) {
    let parts: string[] = [];
    for (const t of v.payload) {
      parts.push(renderType(t));
    }
    detail = v.name.name + "(" + parts.join(", ") + "): " + owner;
  }
  const none: DocSymbol[] = [];
  return DocSymbol {
    name: v.name.name,
    kind: DkVariant,
    detail: detail,
    exported: exported,
    span: v.span,
    nameSpan: v.name.span,
    children: none,
  };
}

function typeSymbol(t: TypeDecl): DocSymbol {
  let kind: DeclKind = DkAlias;
  let detail = "";
  let children: DocSymbol[] = [];
  match (t.body) {
    DAlias(te) => {
      detail = "type " + t.name.name + " = " + renderType(te);
    },
    DRecord(fs) => {
      kind = DkRecord;
      detail = "type " + t.name.name + " (record)";
      for (const fd of fs) {
        children.push(fieldSymbol(fd));
      }
    },
    DUnion(vs) => {
      kind = DkUnion;
      detail = "type " + t.name.name + " (union)";
      for (const v of vs) {
        children.push(variantSymbol(v, t.name.name, t.exported));
      }
    },
  }
  return DocSymbol {
    name: t.name.name,
    kind: kind,
    detail: detail,
    exported: t.exported,
    span: t.span,
    nameSpan: t.name.span,
    children: children,
  };
}

// A class (members are not listed): a record-like type, so it shares `DkRecord`.
function classSymbol(c: ClassDecl): DocSymbol {
  let name = c.name.name;
  if (c.typeParams.length > 0) {
    name += "<" + c.typeParams.map(t => t.name).join(", ") + ">";
  }
  const none: DocSymbol[] = [];
  return DocSymbol {
    name: c.name.name,
    kind: DkRecord,
    detail: "class " + name,
    exported: c.exported,
    span: c.span,
    nameSpan: c.name.span,
    children: none,
  };
}

// An interface (ADR-0019) with its methods as children.
function interfaceSymbol(k: InterfaceDecl): DocSymbol {
  let children: DocSymbol[] = [];
  for (const m of k.methods) {
    let detail = "method " + m.name.name + "(" + renderParams(m.params) + ")";
    match (m.ret) {
      Some(t) => {
        detail += ": " + renderType(t);
      },
      None => {},
    }
    const none: DocSymbol[] = [];
    children.push(DocSymbol {
      name: m.name.name,
      kind: DkFunction,
      detail: detail,
      exported: k.exported,
      span: m.span,
      nameSpan: m.name.span,
      children: none,
    });
  }
  return DocSymbol {
    name: k.name.name,
    kind: DkInterface,
    detail: "interface " + k.name.name,
    exported: k.exported,
    span: k.span,
    nameSpan: k.name.span,
    children: children,
  };
}

function constSymbol(c: ConstDecl): DocSymbol {
  let detail = "const " + c.name.name;
  match (c.ty) {
    Some(t) => {
      detail += ": " + renderType(t);
    },
    None => {},
  }
  const none: DocSymbol[] = [];
  return DocSymbol {
    name: c.name.name,
    kind: DkConst,
    detail: detail,
    exported: c.exported,
    span: c.span,
    nameSpan: c.name.span,
    children: none,
  };
}

// ---- document symbols ---------------------------------------------------------------------

function symbolsOfText(text: string): Result<DocSymbol[], string> {
  const pr = parse(0, text);
  if (pr.isErr()) {
    return Err(pr.unwrapErr().message);
  }
  let out: DocSymbol[] = [];
  for (const it of pr.unwrap().items) {
    match (it) {
      IFunction(f) => {
        out.push(funcSymbol(f));
      },
      IType(t) => {
        out.push(typeSymbol(t));
      },
      IConst(c) => {
        out.push(constSymbol(c));
      },
      IInterface(k) => {
        out.push(interfaceSymbol(k));
      },
      IClass(c) => {
        out.push(classSymbol(c));
      },
      _ => {},
    }
  }
  return Ok(out);
}

function symbolsOrEmpty(text: string): DocSymbol[] {
  const r = symbolsOfText(text);
  if (r.isErr()) {
    return [];
  }
  return r.unwrap();
}

// Buffer text from the workspace overlay, else the file on disk (read through the loader's `Sources`, the one
// place that touches the disk).
@Ensures(fileText(ws, path).isSome()
    ==> result.isSome() && result.unwrap() == fileText(ws, path).unwrap())
export function readText(fs: FsGrant, ws: Workspace, path: string): Option<string> {
  const src = ws.sources();
  const p = normalizePath(path);
  if (!src.exists(fs, p)) {
    return None;
  }
  const r = src.read(fs, p);
  return r.isOk() ? Some(r.unwrap()) : None;
}

// Top-level declarations of `path` in source order (functions, types with field/variant
// children, consts). Imports and re-exports are not symbols. Empty on read or syntax errors.
export function documentSymbols(fs: FsGrant, ws: Workspace, path: string): DocSymbol[] {
  const t = readText(fs, ws, path);
  if (t.isNone()) {
    return [];
  }
  const r = symbolsOfText(t.unwrap());
  if (r.isErr()) {
    return [];
  }
  return r.unwrap();
}

// ---- completion ---------------------------------------------------------------------------

export function keywordCompletions(): CompletionItem[] {
  const words = [
    "const",
    "let",
    "function",
    "return",
    "if",
    "else",
    "while",
    "for",
    "of",
    "break",
    "continue",
    "type",
    "import",
    "export",
    "from",
    "match",
    "true",
    "false",
    "class",
    "interface",
    "implements",
    "extends",
  ];
  return words.map(w => CompletionItem { label: w, kind: DkKeyword, detail: "keyword" });
}

// Built-in types and global objects of Orin-B (docs/bootstrap-subset.md §3, §6).
export function builtinCompletions(): CompletionItem[] {
  let out: CompletionItem[] = [];
  const types = [
    "int",
    "usize",
    "i8",
    "i16",
    "i32",
    "i64",
    "isize",
    "u8",
    "u16",
    "u32",
    "u64",
    "float",
    "f32",
    "bool",
    "string",
    "void",
    "Option",
    "Result",
  ];
  for (const t of types) {
    out.push(CompletionItem { label: t, kind: DkBuiltinType, detail: "built-in type" });
  }
  out.push(CompletionItem {
    label: "console",
    kind: DkBuiltinType,
    detail: "console.log / console.error",
  });
  out.push(CompletionItem { label: "String", kind: DkBuiltinType, detail: "String.fromCharCode" });
  out.push(CompletionItem {
    label: "parseInt",
    kind: DkFunction,
    detail: "function parseInt(s: string): Option<int>",
  });
  out.push(CompletionItem { label: "bytesToString", kind: DkFunction, detail: "function bytesToString(a: u8[], start: usize, len: usize): string" });
  out.push(CompletionItem { label: "stringToBytes", kind: DkFunction, detail: "function stringToBytes(s: string): u8[]" });
  out.push(CompletionItem { label: "Some", kind: DkVariant, detail: "Some(v): Option<T>" });
  out.push(CompletionItem { label: "None", kind: DkVariant, detail: "None: Option<T>" });
  out.push(CompletionItem { label: "Ok", kind: DkVariant, detail: "Ok(v): Result<T, E>" });
  out.push(CompletionItem { label: "Err", kind: DkVariant, detail: "Err(e): Result<T, E>" });
  return out;
}

// Resolve import path `p` (as written in `import ... from "p"`) from file `fromPath` to a normalized
// file path that exists in the workspace overlay or on disk (`Sources.exists`). None for std modules/missing files.
@Ensures(result.isSome() ==> isNormalized(result.unwrap()) && result.unwrap().endsWith(".or"))
@Ensures(p.startsWith("std:") ==> result.isNone())
export function resolveModulePath(
  fs: FsGrant,
  ws: Workspace,
  fromPath: string,
  p: string,
): Option<string> {
  if (p.startsWith("std:")) {
    return None;
  }
  const src = ws.sources();
  const dir = dirname(normalizePath(fromPath));
  const c1 = joinPath(dir, p + ".or");
  if (src.exists(fs, c1)) {
    return Some(c1);
  }
  const c2 = joinPath(dir, p + "/module.or");
  if (src.exists(fs, c2)) {
    return Some(c2);
  }
  return None;
}

function hasLabel(items: CompletionItem[], label: string): bool {
  return items.some(it => it.label == label);
}

function isUnion(k: DeclKind): bool {
  return match (k) {
    DkUnion => true,
    _ => false,
  };
}

function asItem(s: DocSymbol): CompletionItem {
  return CompletionItem { label: s.name, kind: s.kind, detail: s.detail };
}

// Names usable at top level of `path`: its own declarations (and union variants, which are
// module-level constructors) plus the names of its `import { ... }` lists. Imported names
// are described from the exporting file when it can be resolved and parsed (an imported union
// brings its variants too, ADR-0004); otherwise they are offered as `DkImported`.
export function declCompletions(fs: FsGrant, ws: Workspace, path: string): CompletionItem[] {
  let out: CompletionItem[] = [];
  const t = readText(fs, ws, path);
  if (t.isNone()) {
    return out;
  }
  const pr = parse(0, t.unwrap());
  if (pr.isErr()) {
    return out;
  }
  const own = symbolsOrEmpty(t.unwrap());
  for (const s of own) {
    out.push(asItem(s));
    if (isUnion(s.kind)) {
      for (const v of s.children) {
        out.push(asItem(v));
      }
    }
  }
  for (const it of pr.unwrap().items) {
    match (it) {
      IImport(imp) => {
        out = addImported(fs, ws, path, imp, out);
      },
      _ => {},
    }
  }
  return out;
}

function addImported(
  fs: FsGrant,
  ws: Workspace,
  path: string,
  imp: ImportDecl,
  items: CompletionItem[],
): CompletionItem[] {
  let out = items;
  let target: DocSymbol[] = [];
  const mp = resolveModulePath(fs, ws, path, imp.path);
  if (mp.isSome()) {
    const tt = readText(fs, ws, mp.unwrap());
    if (tt.isSome()) {
      target = symbolsOrEmpty(tt.unwrap());
    }
  }
  if (imp.namespace.isSome()) {
    const ns = imp.namespace.unwrap();
    if (!hasLabel(out, ns.name)) {
      out.push(CompletionItem { label: ns.name, kind: DkImported, detail: "namespace of \"" + imp.path + "\"" });
    }
  }
  let k: usize = 0;
  while (k < imp.names.length) {
    const n = imp.names[k];
    const local = importedName(imp, k);
    k += 1;
    if (hasLabel(out, local.name)) {
      continue;
    }
    let found = false;
    for (const s of target) {
      if (s.name == n.name && s.exported) {
        found = true;
        out.push(CompletionItem { label: local.name, kind: s.kind, detail: s.detail });
        if (isUnion(s.kind)) {
          for (const v of s.children) {
            if (!hasLabel(out, v.name)) {
              out.push(asItem(v));
            }
          }
        }
      }
    }
    if (!found) {
      out.push(CompletionItem {
        label: local.name,
        kind: DkImported,
        detail: "imported from \"" + imp.path + "\"",
      });
    }
  }
  return out;
}

function isNameChar(c: int): bool {
  return (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95;
}

// The namespace name when the cursor (byte offset `off` of `text`) sits after `ns.` or `ns.prefix`: the identifier before
// the `.` that precedes the identifier prefix at the cursor.
function namespaceBeforeCursor(text: string, off: usize): Option<string> {
  let i = off < text.length ? off : text.length;
  while (i > 0 && isNameChar(text.charCodeAt(i - 1))) {
    i -= 1;
  }
  if (i < 2 || text.charCodeAt(i - 1) != 46) {
    return None;
  }
  const end = i - 1;
  let st = end;
  while (st > 0 && isNameChar(text.charCodeAt(st - 1))) {
    st -= 1;
  }
  if (st == end) {
    return None;
  }
  return Some(text.substring(st, end));
}

// The import path of the namespace import (`import * as ns from "p"`) that `ns` names when the cursor (byte offset
// `off` of `text`) sits after `ns.` or `ns.prefix`; None when the cursor does not follow `name.` or `name` is no
// namespace import of the file. The file need not parse (it is being typed): the import is found in the token stream.
export function namespaceImportPath(text: string, off: usize): Option<string> {
  const nsq = namespaceBeforeCursor(text, off);
  if (nsq.isNone()) {
    return None;
  }
  const toks = lex(0, text);
  if (toks.isErr()) {
    return None;
  }
  const ts = toks.unwrap();
  let k: usize = 0;
  while (k + 5 < ts.length) {
    if (ts[k].text == "import" && ts[k + 1].text == "*" && ts[k + 2].text == "as" && ts[k + 3].text == nsq.unwrap()
        && ts[k + 4].text == "from") {
      return Some(ts[k + 5].text);
    }
    k += 1;
  }
  return None;
}

// The embedded source of the std module `p` (`std:bytes`, `std:json/number`, `std:bytes/internal` = the flat file
// `bytes_internal.or`, `std:math`), the same mapping as the loader's import resolver. None for the runtime-backed
// modules (`std:process`, `std:core`, ...), which have no Orin source, and for unknown modules.
function stdSourceText(p: string): Option<string> {
  if (!p.startsWith("std:")) {
    return None;
  }
  const id = p.substring(4, p.length);
  const file = id.endsWith("/internal") ? id.split("/").join("_") : id;
  const vp = id == "math" ? "$array/math.or" : "$stdlib/" + file + ".or";
  for (const r of preludeRoots()) {
    for (const f of r.files) {
      if (f.path == vp) {
        return Some(f.text);
      }
    }
  }
  return None;
}

function exportedItems(syms: DocSymbol[]): CompletionItem[] {
  let out: CompletionItem[] = [];
  for (const s of syms) {
    if (s.exported) {
      out.push(asItem(s));
      if (isUnion(s.kind)) {
        for (const v of s.children) {
          out.push(asItem(v));
        }
      }
    }
  }
  return out;
}

// The members a namespace import of the std module `p` offers: its exported declarations (and the variants of its
// unions) plus its re-exports (`export { a } from "std:x"`), described from the re-exported module when that one is
// embedded Orin source, else offered as `DkImported`. Empty when `p` has no embedded source. The sources are
// compiled into the compiler and never change, so `AnalysisCache.stdMembers` memoizes this.
export function stdModuleMembers(p: string): CompletionItem[] {
  const t = stdSourceText(p);
  if (t.isNone()) {
    return [];
  }
  const pr = parse(0, t.unwrap());
  if (pr.isErr()) {
    return [];
  }
  let out = exportedItems(symbolsOrEmpty(t.unwrap()));
  for (const it of pr.unwrap().items) {
    match (it) {
      IReExport(d) => {
        const src = stdSourceText(d.path);
        let target: CompletionItem[] = [];
        if (src.isSome()) {
          target = exportedItems(symbolsOrEmpty(src.unwrap()));
        }
        let k: usize = 0;
        while (k < d.names.length) {
          const orig = d.names[k].name;
          const local = importedName(d, k).name;
          k += 1;
          if (hasLabel(out, local)) {
            continue;
          }
          const hit = target.filter(c => c.label == orig);
          if (hit.length > 0) {
            out.push(CompletionItem { label: local, kind: hit[0].kind, detail: hit[0].detail });
          } else {
            out.push(CompletionItem { label: local, kind: DkImported, detail: "re-exported from \"" + d.path + "\"" });
          }
        }
      },
      _ => {},
    }
  }
  return out;
}

// Member completion after `ns.` (ADR-0048 addendum): when the cursor follows a namespace import of the file
// (`import * as ns from "./m"`), the exported declarations of the target module (and the variants of its unions). None
// when the cursor does not follow `name.` or `name` is no namespace import. The target of a std module is not read here
// (`resolveModulePath`): the list for a std namespace is empty and the caller answers it with `stdModuleMembers` (through
// `AnalysisCache.stdMembers`). The file need not parse (it is being typed): the import is found in the token stream.
export function namespaceCompletions(fs: FsGrant, ws: Workspace, path: string, text: string, off: usize): Option<CompletionItem[]> {
  const ip = namespaceImportPath(text, off);
  if (ip.isNone()) {
    return None;
  }
  let out: CompletionItem[] = [];
  const mp = resolveModulePath(fs, ws, path, ip.unwrap());
  if (mp.isSome()) {
    const tt = readText(fs, ws, mp.unwrap());
    if (tt.isSome()) {
      out = exportedItems(symbolsOrEmpty(tt.unwrap()));
    }
  }
  return Some(out);
}
