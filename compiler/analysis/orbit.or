// The capability manifest of the `wasm64-orbit` and `wasm32-orbit` targets (ADR-0055; Orbit host ABI, section 6 "manifest").
//
// `orin compile <entry.or> -o out.c --target=wasm64-orbit|wasm32-orbit` (C backend only) appends a manifest to the generated C: a
// WebAssembly custom section `orbit.manifest` whose payload is the UTF-8 JSON
//
//     {"abi":1,"requires":["clock/v1","log/v1"],"producer":"orin <version>"}
//
// The manifest DESCRIBES what the module needs; it never authorises anything (the host decides what it grants).
//
// `requires` comes from the effect analysis behind `orin effects` (effects.or): the transitive effect set of the entry
// point `main` (the same set `orin effects <entry> --summary` reports for it). The mapping, by primitive effect:
//
//   Console.Write, Stdio.Write                       -> "log/v1"
//   Clock.Now                                        -> "clock/v1"
//   Process.Args, Stdio.Read                         -> "process/v1" (arguments, standard input)
//   Fs.ReadFile, Fs.WriteFile, Fs.Stat, Fs.Open,
//   Fs.Read, Fs.Write                                -> "fs/v1" (files under the mounts the host grants)
//   Net.Bind, Net.Accept, Net.Connect,
//   Stream.Read, Stream.Write                        -> "net/v1" (TCP, DNS)
//   Fs.Narrow, Net.Narrow, Process.Narrow            -> no capability: narrowing a grant is a check inside the guest
//   Process.Exit, Host.Acquire                       -> no capability: handled inside the guest (exit traps after recording
//                                                       the status)
//   Task.*, Channel.*                                -> no capability: the guest runs the tasks itself, one at a time, in its
//                                                       one WebAssembly thread (ADR-0055); a program that needs two tasks
//                                                       to run at once ends at run time with a "wasm64-orbit: deadlock"
//                                                       message instead of failing to build
//   Unknown.* (a call the analysis cannot resolve,  -> no error, but "clock/v1" is required too, and so is every capability
//   such as a call of a function value)               that any function of the package needs (the report's package effects):
//                                                       the unresolved call can reach only code of the program, and the manifest
//                                                       must list every capability the module imports. The import list, not the
//                                                       effect set, bounds what the module can ask the host for
//   anything else (Process.Spawn: the shell)         -> NOT available on this target: error E0523, one diagnostic per effect,
//                                                       located at the evidence the analysis has
//
// "log/v1" is ALWAYS required, even without Console.Write: a runtime trap prints its message to stderr, which the guest maps
// to the log capability. So `requires` is at least ["log/v1"], plus the capabilities above; sorted, no duplicates.
//
// The producer string is "orin": the compiler does not know its own version (orin.toml is not embedded).

import { Diagnostic, diag } from "../diag";
import { EffContext, EffView, buildReport, pathLines } from "./effectsum";
import { isUnknownOp } from "./effects";

export const ORBIT_TARGET: string = "wasm64-orbit";
export const ORBIT_TARGET32: string = "wasm32-orbit";

// Both widths share the generated C, the manifest and the capability table (ADR-0055, decision 8).
export function isOrbitTarget(t: string): bool {
  return t == ORBIT_TARGET || t == ORBIT_TARGET32;
}
export const ORBIT_ERROR: string = "E0523";
const ORBIT_PRODUCER: string = "orin";

// "" for an effect that needs no capability, else the capability. `known` is false for an effect the target lacks.
type CapMap = { known: bool; cap: string; };

function capabilityOf(op: string): CapMap {
  if (op == "Console.Write" || op == "Stdio.Write") {
    return CapMap { known: true, cap: "log/v1" };
  }
  if (op == "Clock.Now") {
    return CapMap { known: true, cap: "clock/v1" };
  }
  if (op == "Process.Args" || op == "Stdio.Read") {
    return CapMap { known: true, cap: "process/v1" };
  }
  if (op.startsWith("Fs.") && op != "Fs.Narrow") {
    return CapMap { known: true, cap: "fs/v1" };
  }
  if ((op.startsWith("Net.") || op.startsWith("Stream.")) && op != "Net.Narrow") {
    return CapMap { known: true, cap: "net/v1" };
  }
  if (op == "Fs.Narrow" || op == "Net.Narrow" || op == "Process.Narrow" || op == "Process.Exit" || op == "Host.Acquire"
      || op.startsWith("Task.") || op.startsWith("Channel.")) {
    return CapMap { known: true, cap: "" };
  }
  return CapMap { known: false, cap: "" };
}

export type OrbitPlan = {
  requires: string[];      // sorted, no duplicates, always contains "log/v1"
  errors: Diagnostic[];    // E0523, one per distinct unavailable effect
};

export function orbitPlan(c: EffContext, target: string): OrbitPlan {
  let caps: string[] = [];
  let unknown = false;
  let errors: Diagnostic[] = [];
  let seen: string[] = [];
  const rep = buildReport(c);
  for (const v of rep.entryEffects) {
    if (isUnknownOp(v.op)) {
      unknown = true;
      continue;
    }
    const m = capabilityOf(v.op);
    if (m.known) {
      if (m.cap != "" && !caps.includes(m.cap)) {
        caps.push(m.cap);
      }
      continue;
    }
    if (seen.includes(v.op)) {
      continue;
    }
    seen.push(v.op);
    let d = diag(
      ORBIT_ERROR,
      v.start,
      "`main` needs " + v.op + ", which the " + target + " target does not provide",
    );
    d.notes = pathLines(v, "");
    errors.push(d);
  }
  if (unknown) {
    // an unresolved call may reach any function of the package: list what they need (an unavailable one is no error here)
    caps.push("clock/v1");
    for (const v of rep.packageEffects) {
      const m = isUnknownOp(v.op) ? CapMap { known: false, cap: "" } : capabilityOf(v.op);
      if (m.known && m.cap != "" && !caps.includes(m.cap)) {
        caps.push(m.cap);
      }
    }
  }
  // sorted by a fixed order (no string ordering: the seed compiler lacks `<` on strings); log/v1 is always there
  let requires: string[] = [];
  for (const k of ["clock/v1", "fs/v1", "log/v1", "net/v1", "process/v1"]) {
    if (k == "log/v1" || caps.includes(k)) {
      requires.push(k);
    }
  }
  return OrbitPlan { requires: requires, errors: errors };
}

// The JSON payload of the section.
export function orbitManifestJson(requires: string[]): string {
  let items: string[] = [];
  for (const r of requires) {
    items.push("\"" + r + "\"");
  }
  return "{\"abi\":1,\"requires\":[" + items.join(",") + "],\"producer\":\"" + ORBIT_PRODUCER + "\"}";
}

// The family of the WebAssembly L0 (runtime/platform/orbit/include) that implements a capability, "" for the ones the core has.
function familyHeader(cap: string): string {
  if (cap == "process/v1") {
    return "orbit_proc.h";
  }
  if (cap == "fs/v1") {
    return "orbit_fs.h";
  }
  if (cap == "net/v1") {
    return "orbit_net.h";
  }
  return "";
}

// The C text appended at the very end of the generated file. First the L0 families the manifest lists (`#include` of their
// header: the core of the L0 only has refusing stubs for them, so a module imports exactly the capabilities it lists), then the
// manifest itself. The JSON's quotes are escaped twice: once for the assembler string of `.ascii` (\") and once for the C string
// literal (\\\").
export function orbitManifestC(requires: string[]): string {
  const json = orbitManifestJson(requires);
  const asmEscaped = json.split("\"").join("\\\"");
  const cEscaped = asmEscaped.split("\\").join("\\\\").split("\"").join("\\\"");
  let families = "";
  for (const r of requires) {
    if (familyHeader(r) != "") {
      families = families + "#include \"" + familyHeader(r) + "\"\n";
    }
  }
  return families + "/* Orbit capability manifest (ADR-0055): describes requirements, never authorises */\n"
      + "__asm__(\".section .custom_section.orbit.manifest,\\\"\\\",@\\n.ascii \\\"" + cEscaped
      + "\\\"\\n.text\\n\");\n";
}
