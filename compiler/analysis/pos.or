// Byte offset <-> editor position conversion.
//
// Source text is UTF-8 bytes (Orin byte strings). `Pos.line` is 0-based; `Pos.character` is
// 0-based and counted in UTF-16 code units (the LSP default): every UTF-8 sequence counts 1 unit,
// except 4-byte sequences (astral code points) which count 2. `\n` ends a line; a `\r` before
// it counts as one ordinary trailing character of the line.
//
// The two directions are inverse on character boundaries: `posToOffset(offsetToPos(o)) == o` for every offset `o`
// of the text that does not point into the middle of a UTF-8 sequence (stated as the `@Ensures` of `offsetToPos`), and
// `posToOffset` only ever answers such a boundary.

export type Pos = { line: usize; character: usize; };

// UTF-16 units contributed by byte `c` of a UTF-8 text: 0 for continuation bytes, 2 for the
// lead byte of a 4-byte sequence, else 1.
@Ensures((c >= 128 && c < 192) == (result == 0) && (c >= 240) == (result == 2))
function unitsOfByte(c: int): usize {
  if (c >= 128 && c < 192) {
    return 0;
  }
  if (c >= 240) {
    return 2;
  }
  return 1;
}

// True when `off` is a position between two characters of `text`: inside the text (or at its end) and not on a UTF-8
// continuation byte.
export function isCharBoundary(text: string, off: usize): bool {
  return off == text.length || off < text.length && unitsOfByte(text.charCodeAt(off)) > 0;
}

// Position of byte offset `off` (clamped to the text length).
@Ensures(isCharBoundary(text, off) ==> posToOffset(text, result.line, result.character) == off)
export function offsetToPos(text: string, off: usize): Pos {
  let line: usize = 0;
  let ch: usize = 0;
  let i: usize = 0;
  while (i < off && i < text.length) {
    const c = text.charCodeAt(i);
    if (c == 10) {
      line += 1;
      ch = 0;
    } else {
      ch += unitsOfByte(c);
    }
    i += 1;
  }
  return Pos { line: line, character: ch };
}

// Byte offset of `line`/`character`. A character past the end of the line clamps to the line
// end (the offset of its `\n`, or the text length).
@Ensures(result <= text.length && isCharBoundary(text, result))
@Ensures(offsetToPos(text, result).line <= line)
export function posToOffset(text: string, line: usize, character: usize): usize {
  let i: usize = 0;
  let l: usize = 0;
  while (l < line && i < text.length) {
    if (text.charCodeAt(i) == 10) {
      l += 1;
    }
    i += 1;
  }
  let ch: usize = 0;
  while (i < text.length) {
    const c = text.charCodeAt(i);
    if (c == 10) {
      break;
    }
    const u = unitsOfByte(c);
    if (u > 0 && ch >= character) {
      break;
    }
    ch += u;
    i += 1;
  }
  return i;
}
