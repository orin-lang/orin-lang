// Queries over the checker's SemanticIndex (hir/index.or): go to definition, hover, find
// references, rename. Pure functions; `file` is a SourceMap file index (Span.file) and `off` a
// byte offset in that file. Spans compare as closed ranges [start, end] so a cursor placed just
// after an identifier still selects it (the usual editor convention).
//
// The producer of the index is the checker; until it is wired (`indexAvailable()` in analyze.or)
// `Analysis.index` is None and callers answer "no result". Everything here is tested against a
// hand-built index (compiler/tests/analysis_test.or).
//
// Contract assumptions about the index (see hir/index.or):
//   - `defs[i].id == i` (`defIdsDense`, a precondition of every query: the checker's `addDef` hands out the index).
//   - `refs` contains one entry per resolved identifier occurrence; the defining identifier
//     itself (`SymbolDef.nameSpan`) may or may not also appear as a ref — results are
//     de-duplicated by span either way.
//   - A ref's `def` indexes `defs`; invalid ids are ignored.
//   - `SymbolDef.container` and `unit` identify the scope used for rename collision checks.
//
// What the queries guarantee (their `@Ensures`): a definition id they answer exists, every span they answer is an
// occurrence of the symbol that was asked for (its defining name or one of its references) and lies in the index, no
// span is answered twice, and a rename edits exactly those occurrences.

import { Span } from "../diag";
import { SemanticIndex, SymbolDef, SkInterface } from "../hir";

export type HoverInfo = { span: Span; text: string; };

// A text replacement of a source span.
export type TextEdit = { span: Span; newText: string; };

// Every definition sits at its own index (`defs[i].id == i`), so an id found on a definition indexes `defs`.
@Ensures(idx.defs.length == 0 ==> result)
export function defIdsDense(idx: SemanticIndex): bool {
  let i: usize = 0;
  @Invariant(i <= idx.defs.length)
  while (i < idx.defs.length) {
    if (idx.defs[i].id != i) {
      return false;
    }
    i += 1;
  }
  return true;
}

@Ensures(result == (a.file == b.file && a.start == b.start && a.end == b.end))
export function spanEq(a: Span, b: Span): bool {
  return a.file == b.file && a.start == b.start && a.end == b.end;
}

// `sp` is an occurrence of definition `def`: its defining name or the span of one of its references.
@Ensures(def >= idx.defs.length ==> !result)
export function isOccurrence(idx: SemanticIndex, def: usize, sp: Span): bool {
  return def < idx.defs.length
      && (spanEq(idx.defs[def].nameSpan, sp)
          || idx.refs.some(r => r.def == def && spanEq(r.span, sp)));
}

// `sp` is the defining name of some definition of the index.
@Ensures(idx.defs.length == 0 ==> !result)
export function isDefName(idx: SemanticIndex, sp: Span): bool {
  return idx.defs.some(d => spanEq(d.nameSpan, sp));
}

// No span occurs twice.
@Ensures(sps.length <= 1 ==> result)
export function spansDistinct(sps: Span[]): bool {
  let i: usize = 0;
  @Invariant(i <= sps.length)
  while (i < sps.length) {
    let j: usize = 0;
    @Invariant(j <= i)
    while (j < i) {
      if (spanEq(sps[i], sps[j])) {
        return false;
      }
      j += 1;
    }
    i += 1;
  }
  return true;
}

@Ensures(result == (sp.file == file && sp.start <= off && off <= sp.end))
function covers(sp: Span, file: usize, off: usize): bool {
  return sp.file == file && sp.start <= off && off <= sp.end;
}

@Ensures(result == sp.end - sp.start)
function width(sp: Span): usize {
  return sp.end - sp.start;
}

type Hit = { def: usize; span: Span; };

// The definition id and occurrence span of the narrowest symbol occurrence (reference or
// defining name) at the position.
@Requires(defIdsDense(idx))
@Ensures(result.isSome() ==> isOccurrence(idx, result.unwrap().def, result.unwrap().span))
@Ensures(result.isSome() ==> covers(result.unwrap().span, file, off))
function hitAt(idx: SemanticIndex, file: usize, off: usize): Option<Hit> {
  let best: Option<Hit> = None;
  for (const r of idx.refs) {
    if (r.def < idx.defs.length && covers(r.span, file, off)) {
      const better = match (best) {
        None => true,
        Some(b) => width(r.span) < width(b.span),
      };
      if (better) {
        best = Some(Hit { def: r.def, span: r.span });
      }
    }
  }
  for (const d of idx.defs) {
    if (covers(d.nameSpan, file, off)) {
      const better = match (best) {
        None => true,
        Some(b) => width(d.nameSpan) < width(b.span),
      };
      if (better) {
        best = Some(Hit { def: d.id, span: d.nameSpan });
      }
    }
  }
  return best;
}

// Definition id of the symbol at the position.
@Requires(defIdsDense(idx))
@Ensures(result.isSome() ==> result.unwrap() < idx.defs.length)
export function symbolAt(idx: SemanticIndex, file: usize, off: usize): Option<usize> {
  const h = hitAt(idx, file, off);
  if (h.isNone()) {
    return None;
  }
  return Some(h.unwrap().def);
}

// Span of the symbol occurrence at the position (the `prepareRename` range).
@Requires(defIdsDense(idx))
@Ensures(result.isSome()
    ==> covers(result.unwrap(), file, off) && symbolAt(idx, file, off).isSome())
export function symbolSpanAt(idx: SemanticIndex, file: usize, off: usize): Option<Span> {
  const h = hitAt(idx, file, off);
  if (h.isNone()) {
    return None;
  }
  return Some(h.unwrap().span);
}

// Go to definition: the span of the defining identifier.
@Requires(defIdsDense(idx))
@Ensures(result.isSome() ==> isDefName(idx, result.unwrap()))
@Ensures(result.isSome() == symbolAt(idx, file, off).isSome())
export function definitionAt(idx: SemanticIndex, file: usize, off: usize): Option<Span> {
  const h = hitAt(idx, file, off);
  if (h.isNone()) {
    return None;
  }
  return Some(idx.defs[h.unwrap().def].nameSpan);
}

// Hover: the symbol's rendered signature/type if the position is on a symbol occurrence,
// else the rendered type of the narrowest typed expression span covering it.
@Requires(defIdsDense(idx))
@Ensures(result.isSome() ==> covers(result.unwrap().span, file, off))
export function hoverAt(idx: SemanticIndex, file: usize, off: usize): Option<HoverInfo> {
  const h = hitAt(idx, file, off);
  if (h.isSome()) {
    const hit = h.unwrap();
    return Some(HoverInfo { span: hit.span, text: idx.defs[hit.def].detail });
  }
  let best: Option<HoverInfo> = None;
  for (const t of idx.types) {
    if (covers(t.span, file, off)) {
      const better = match (best) {
        None => true,
        Some(b) => width(t.span) < width(b.span),
      };
      if (better) {
        best = Some(HoverInfo { span: t.span, text: t.ty });
      }
    }
  }
  return best;
}

// Go to implementations (ADR-0019): for an interface, the classes that declare `implements` it; for an
// interface method, the methods of those classes with the same name. Other symbols have none.
@Ensures(result.every(sp => isDefName(idx, sp)))
@Ensures(def >= idx.defs.length ==> result.length == 0)
export function implementationsOfDef(idx: SemanticIndex, def: usize): Span[] {
  let out: Span[] = [];
  if (def >= idx.defs.length) {
    return out;
  }
  const d = idx.defs[def];
  const isIface = match (d.kind) {
    SkInterface => true,
    _ => false,
  };
  if (isIface) {
    for (const l of idx.impls) {
      if (l.iface == def && l.cls < idx.defs.length) {
        out.push(idx.defs[l.cls].nameSpan);
      }
    }
    return out;
  }
  if (d.container.isSome()) {
    const parent = d.container.unwrap();
    if (parent < idx.defs.length) {
      const parentIsIface = match (idx.defs[parent].kind) {
        SkInterface => true,
        _ => false,
      };
      if (parentIsIface) {
        for (const l of idx.impls) {
          if (l.iface == parent) {
            for (const o of idx.defs) {
              const inCls = match (o.container) {
                Some(c) => c == l.cls,
                None => false,
              };
              if (inCls && o.name == d.name) {
                out.push(o.nameSpan);
              }
            }
          }
        }
      }
    }
  }
  return out;
}

// Implementations of the symbol at the position.
@Requires(defIdsDense(idx))
@Ensures(result.every(sp => isDefName(idx, sp)))
export function implementationsAt(idx: SemanticIndex, file: usize, off: usize): Span[] {
  const s = symbolAt(idx, file, off);
  if (s.isNone()) {
    return [];
  }
  return implementationsOfDef(idx, s.unwrap());
}

function hasSpan(spans: Span[], s: Span): bool {
  return spans.some(x => spanEq(x, s));
}

// All occurrences of definition `def`: its defining identifier first (when `includeDecl`),
// then every reference in index (source) order. De-duplicated by span.
@Ensures(result.every(sp => isOccurrence(idx, def, sp)))
@Ensures(spansDistinct(result))
@Ensures(def >= idx.defs.length ==> result.length == 0)
@Ensures(def < idx.defs.length && includeDecl
    ==> result.length > 0 && spanEq(result[0], idx.defs[def].nameSpan))
@Ensures(def < idx.defs.length && !includeDecl
    ==> result.every(sp => !spanEq(sp, idx.defs[def].nameSpan)))
export function referencesOfDef(idx: SemanticIndex, def: usize, includeDecl: bool): Span[] {
  let out: Span[] = [];
  if (def >= idx.defs.length) {
    return out;
  }
  const decl = idx.defs[def].nameSpan;
  if (includeDecl) {
    out.push(decl);
  }
  for (const r of idx.refs) {
    if (r.def == def && !hasSpan(out, r.span) && (includeDecl || !spanEq(r.span, decl))) {
      out.push(r.span);
    }
  }
  return out;
}

// Find references of the symbol at the position.
@Requires(defIdsDense(idx))
@Ensures(symbolAt(idx, file, off).isSome()
    ==> result.every(sp => isOccurrence(idx, symbolAt(idx, file, off).unwrap(), sp)))
@Ensures(symbolAt(idx, file, off).isNone() ==> result.length == 0)
export function referencesTo(
  idx: SemanticIndex,
  file: usize,
  off: usize,
  includeDecl: bool,
): Span[] {
  const s = symbolAt(idx, file, off);
  if (s.isNone()) {
    return [];
  }
  return referencesOfDef(idx, s.unwrap(), includeDecl);
}

// ---- rename -------------------------------------------------------------------------------

function isIdentChar(c: int, first: bool): bool {
  if (c >= 65 && c <= 90 || c >= 97 && c <= 122 || c == 95) {
    return true;
  }
  return !first && c >= 48 && c <= 57;
}

function reservedWords(): string[] {
  return [
    "const",
    "let",
    "function",
    "return",
    "if",
    "else",
    "while",
    "for",
    "of",
    "break",
    "continue",
    "type",
    "import",
    "export",
    "from",
    "match",
    "true",
    "false",
    "var",
    "class",
    "interface",
    "enum",
    "new",
    "this",
    "null",
    "undefined",
    "async",
    "await",
  ];
}

// None when `s` is a legal Orin identifier, else the reason.
export function identError(s: string): Option<string> {
  if (s.length == 0) {
    return Some("name is empty");
  }
  let i: usize = 0;
  while (i < s.length) {
    if (!isIdentChar(s.charCodeAt(i), i == 0)) {
      return Some("`" + s + "` is not a valid identifier");
    }
    i += 1;
  }
  for (const k of reservedWords()) {
    if (k == s) {
      return Some("`" + s + "` is a reserved word");
    }
  }
  return None;
}

function sameContainer(a: Option<usize>, b: Option<usize>): bool {
  return match (a) {
    None => b.isNone(),
    Some(x) => match (b) {
      None => false,
      Some(y) => x == y,
    },
  };
}

function collides(idx: SemanticIndex, d: SymbolDef, newName: string): bool {
  for (const o of idx.defs) {
    if (o.id != d.id
        && o.name == newName
        && o.unit == d.unit
        && sameContainer(o.container, d.container)) {
      return true;
    }
  }
  return false;
}

// Rename the symbol at the position: edits for the defining identifier and every reference
// (including import-list names and uses in other files, which the index records as refs).
// Rejected when the new name is not an identifier, is reserved or unchanged, or collides with
// another definition in the same unit and container (conservative: same-scope names of any kind).
// Not checked (needs per-unit scope data): clashes with names imported into other units.
@Requires(defIdsDense(idx))
@Ensures(result.isOk() ==> identError(newName).isNone() && result.unwrap().length > 0)
@Ensures(result.isOk()
    ==> result
        .unwrap()
        .every(
          e => e.newText == newName && isOccurrence(idx, symbolAt(idx, file, off).unwrap(), e.span),
        ))
export function renameEdits(
  idx: SemanticIndex,
  file: usize,
  off: usize,
  newName: string,
): Result<TextEdit[], string> {
  const s = symbolAt(idx, file, off);
  if (s.isNone()) {
    return Err("no renameable symbol at this position");
  }
  const d = idx.defs[s.unwrap()];
  const bad = identError(newName);
  if (bad.isSome()) {
    return Err(bad.unwrap());
  }
  if (newName == d.name) {
    return Err("the new name is identical to the old name");
  }
  if (collides(idx, d, newName)) {
    return Err("`" + newName + "` is already defined in this scope");
  }
  let edits: TextEdit[] = [];
  for (const sp of referencesOfDef(idx, d.id, true)) {
    edits.push(TextEdit { span: sp, newText: newName });
  }
  return Ok(edits);
}
