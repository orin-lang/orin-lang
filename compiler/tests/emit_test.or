// Unit tests of the code generators (rewrite step 3d): the C backend (`compiler/backends/c`) and the LLVM backend
// (`compiler/backends/llvm`). Literals and names, the symbol tables, the "refers only to declared symbols" predicates, the reference
// mask of large structs, and rule 8: a function's text depends only on the read-only symbol table, so emitting the
// functions in another order and joining them in index order gives the same unit. Run:
// `orin test compiler/tests/emit_test.or --runtime runtime/core` (contracts are checked at run time).

import { Host, useFs } from "std:host";
import { FsGrant } from "std:fs";
import { assert, assertEqUsize, assertEqString } from "std:test";
import { SourceFile } from "../diag";
import {
  MType, Operand, SwitchCase, MLocal, MBlock, Instr, Terminator, MFunction, MProgram, MVTable,
  plainBlock, rtNames, rtFnAddrOk, l1Task, rtWraps, RT_CORE_PROBE_FN, RT_ARRAY_NEW, RT_TASK_MAIN, RT_TASK_TRAP, rtAlways, rtWrappersOn, withRtWrappers,
} from "../mir";
import { BinOp, Builtin, BCore, BTask, fnAddrEntries, RT_FN_TASK_MAIN, RT_FN_PROBE_ENTRY, taskOpCount, platOpCount, platOpName, platOpParams, platOpResult } from "../hir";
import { loadWithOverlay } from "../loader";
import { check } from "../check";
import { lower } from "../lower";
import { optimize, pruneProgram } from "../opt";
import {
  emitC, joinC, emittable, indices, CSymbols, cSymbols, refsDeclared, symbolsWellFormed,
  namesDefined, emitCFunction, sanitize, fnSymbol, commentSafe, cString, cStringValue, refMask,
  maskAll, identChars, inoutArgOk, targetsBelow, emitCFacts,
} from "../backends/c";
import {
  emitLlvm, joinLlvm, LlvmSymbols, llvmSymbols, trapsIndexed, introducedNames, llvmRefsDeclared,
  globalsDefined, emitLlvmFunction, llStr, llStrValue, prelude, declares, fixedMsgs, emitLlvmFacts,
} from "../backends/llvm";

// ---------------------------------------------------------------- builders

function lr(n: string): MLocal {
  return MLocal { name: n, ty: MRef };
}

function bk(instrs: Instr[], term: Terminator): MBlock {
  return plainBlock(instrs, term);
}

function fn(name: string, locals: MLocal[], blocks: MBlock[]): MFunction {
  return MFunction {
    name: name,
    paramCount: 0,
    paramOwned: [],
    inout: false, uniqueIn: false, uniqueOut: false,
    locals: locals,
    ret: MVoid,
    blocks: blocks,
  };
}

// main calls `a.b`, which builds a closure of `c/d`, traps with a message used twice and returns a string literal.
function sample(): MProgram {
  const mainF = fn("main", [], [bk([ICall(None, 1, [])], TReturn(None))]);
  const ab = fn(
    "a.b",
    [lr("k"), lr("s")],
    [
      bk([IClosure(0, 2, []), IRelease(0), ICopy(1, OStr(1))], TBranch(OBool(true), 1, 2)),
      bk([], TTrap("custom failure")),
      bk([], TTrap("custom failure")),
    ],
  );
  const env = MFunction {
    name: "c/d",
    paramCount: 1,
    paramOwned: [false],
    inout: false, uniqueIn: false, uniqueOut: false,
    locals: [lr("env")],
    ret: MVoid,
    blocks: [bk([], TReturn(None))],
  };
  return MProgram {
    functions: [mainF, ab, env],
    strings: ["hi", "a \"quoted\" */ string?\n"],
    main: 0,
    vtables: [MVTable { name: "I for c/d */", funcs: [2] }],
    inlineFns: [],
  };
}

function reversed(xs: string[]): string[] {
  let out: string[] = [];
  let i = xs.length;
  while (i > 0) {
    i -= 1;
    out.push(xs[i]);
  }
  return out;
}

// ---------------------------------------------------------------- text

@Test
function cStringRoundTripsEveryByte(): void {
  let all = "";
  let c: int = 1;
  while (c < 256) {
    all += String.fromCharCode(c);
    c += 1;
  }
  const samples = [
    "",
    "plain",
    "say \"hi\"",
    "back\\slash",
    "??=trigraph",
    "tab\there",
    String.fromCharCode(127) + "1",
    all,
  ];
  for (const s of samples) {
    const lit = cString(s);
    assert(cStringValue(lit).isSome() && cStringValue(lit).unwrap() == s, "cString round-trips");
  }
  assert(cStringValue("\"\\1\"").isNone(), "a short octal escape is not cString's form");
  assert(cStringValue("\"a\"b\"").isNone(), "an unescaped quote is not");
}

@Test
function llStrRoundTripsEveryByte(): void {
  let all = "";
  let c: int = 1;
  while (c < 256) {
    all += String.fromCharCode(c);
    c += 1;
  }
  assert(llStrValue(llStr(all)).unwrap() == all, "llStr round-trips");
  assert(llStrValue("\\4").isNone(), "a truncated escape is rejected");
  assert(llStrValue("\\4g").isNone(), "a non-hex escape is rejected");
}

@Test
function commentsCannotBeClosedByANameAndSymbolsAreIdentifiers(): void {
  assert(!commentSafe("a*/b").includes("*/"), "*/ is broken up");
  assert(!commentSafe("**/").includes("*/"), "**/ too");
  assertEqString(sanitize("a.b/c$d"), "a_b_c_d", "one underscore per character");
  assert(identChars(fnSymbol(3, "x.y-z")), "a symbol is an identifier");
  assert(
    fnSymbol(0, "a.b") != fnSymbol(1, "a_b"),
    "names that sanitize alike get different symbols",
  );
}

// The defect fixed in step 3d: a struct with more than 64 slots made the mask loop add bit 63 once per extra reference
// slot and overflow (`trap: usize overflow` in the compiler). Slots from 64 on contribute nothing now; the runtime traps
// on such a struct with "struct has more than 64 slots" when it is built.
@Test
function referenceMasksOfLargeStructsDoNotOverflow(): void {
  let refs: bool[] = [];
  let i: usize = 0;
  while (i < 70) {
    refs.push(true);
    i += 1;
  }
  assertEqUsize(refMask(refs), maskAll(64), "all 64 mask bits, nothing beyond");
  assertEqUsize(refMask([false, true, true]), 6, "bits 1 and 2");
  assertEqUsize(refMask([]), 0, "no slots");
}

@Test
function emitterPreconditionsRejectWhatTheVerifierRejects(): void {
  let p = sample();
  assert(
    targetsBelow(TBranch(OBool(true), 1, 2), 3) && !targetsBelow(TGoto(3), 3),
    "branch targets",
  );
  assert(
    !targetsBelow(TSwitch(OInt(0), [SwitchCase { value: 1, target: 5 }], 0), 3),
    "a switch case out of range",
  );
  assert(inoutArgOk(p, 1, []), "a plain callee takes anything");
  p.functions[1].inout = true;
  assert(
    inoutArgOk(p, 1, [OLocal(0)]) && !inoutArgOk(p, 1, [OStr(0)]),
    "an in/out receiver must be a local",
  );
}

// ---------------------------------------------------------------- symbol tables and references

@Test
function theCSymbolTableNamesEveryFunctionOnce(): void {
  const p = sample();
  const syms = cSymbols(p);
  assertEqUsize(syms.count(), 3, "one symbol per function");
  assert(symbolsWellFormed(syms), "orin_fn_<i>_<name>");
  assert(syms.isFunction(syms.name(2)) && !syms.isFunction("orin_fn_9_x"), "lookup");
  assert(
    refsDeclared("x = orin_fn_1_a_b(orin_s1); orin_str_eq(a, b); orin_s2f(z);", syms),
    "known symbols pass",
  );
  assert(!refsDeclared("orin_fn_7_nope();", syms), "an undefined function is caught");
  assert(!refsDeclared("x = orin_s2;", syms), "a string literal past the table is caught");
  assert(!refsDeclared("x = orin_vt1;", syms), "a vtable past the table is caught");
  assert(
    refsDeclared("orin_trap(\"orin_s99\"); /* orin_fn_9_x */", syms),
    "string literals and comments are not code",
  );
}

@Test
function theLlvmSymbolTableNumbersTrapMessagesOnce(): void {
  const p = sample();
  const syms = llvmSymbols(p);
  const fixed = fixedMsgs();
  assertEqUsize(syms.messages().length, fixed.length + 1, "the repeated message has one global");
  assertEqUsize(syms.message("custom failure"), fixed.length, "after the fixed messages");
  assertEqUsize(syms.message("integer overflow"), 0, "a fixed message keeps its index");
  assert(trapsIndexed(p, syms), "every trap has a global");
  assert(introducedNames(declares()).includes("orin_str_eq"), "declarations are runtime symbols");
  assert(introducedNames(prelude()).includes("orinl_dup"), "prelude helpers too");
  assert(
    llvmRefsDeclared("call void @orin_trap(ptr @.m11) call ptr @orinl_dup(ptr %x)", syms),
    "known globals pass",
  );
  assert(
    !llvmRefsDeclared("call void @orin_bogus()", syms),
    "an undeclared runtime function is caught",
  );
  assert(
    !llvmRefsDeclared("call void @orin_trap(ptr @.m12)", syms),
    "a message past the table is caught",
  );
  assert(
    llvmRefsDeclared("@x = constant [3 x i8] c\"@no\\00\"", syms) == false,
    "@x itself is undeclared",
  );
}

// ---------------------------------------------------------------- whole units, rule 8

@Test
function aCUnitIsTheJoinOfIndependentlyEmittedFunctions(): void {
  const p = sample();
  assert(emittable(p), "the sample is emittable");
  const whole = emitC(p);
  const syms = cSymbols(p);
  // emit the functions last to first, then put them in index order: the same unit
  let rev: string[] = [];
  let i = p.functions.length;
  while (i > 0) {
    i -= 1;
    rev.push(emitCFunction(syms, p, i));
  }
  assertEqString(joinC(p, syms, reversed(rev)), whole, "order of emission does not matter");
  assert(refsDeclared(whole, syms), "the unit refers only to what it declares");
  assert(namesDefined(whole, syms), "and defines every function, literal and vtable");
  assert(
    !namesDefined(
      whole.split("static void *const orin_vt0").join("static void *const other"),
      syms,
    ),
    "a missing vtable is caught",
  );
  assert(whole.includes("ORIN_STRING_LIT(orin_s1, 22, "), "string literals are defined");
  assert(!whole.includes("I for c/d */ */"), "the vtable comment cannot close early");
  // changing one function does not change the text of another
  let q = p;
  q.functions[1].blocks[0] = bk([ICopy(1, OStr(0))], TBranch(OBool(true), 1, 2));
  const sq = cSymbols(q);
  assertEqString(
    emitCFunction(sq, q, 0),
    emitCFunction(syms, p, 0),
    "main is unaffected by a change in a.b",
  );
  assertEqString(emitCFunction(sq, q, 2), emitCFunction(syms, p, 2), "c/d is unaffected");
}

@Test
function anLlvmModuleIsTheJoinOfIndependentlyEmittedFunctions(): void {
  const p = sample();
  const whole = emitLlvm(p);
  const syms = llvmSymbols(p);
  let rev: string[] = [];
  let i = p.functions.length;
  while (i > 0) {
    i -= 1;
    rev.push(emitLlvmFunction(syms, p, i));
  }
  assertEqString(joinLlvm(p, syms, reversed(rev)), whole, "order of emission does not matter");
  assert(llvmRefsDeclared(whole, syms), "the module refers only to globals it defines or declares");
  assert(globalsDefined(whole, syms), "and defines every function, message, literal and vtable");
  assert(
    !globalsDefined(whole.split("@orin_vt0 = ").join("@other = "), syms),
    "a missing vtable is caught",
  );
  assert(
    whole.includes("@.m11 = private unnamed_addr constant [15 x i8] c\"custom failure\\00\""),
    "the trap message global",
  );
}

function compiled(fs: FsGrant, text: string): Option<MProgram> {
  const o = loadWithOverlay(fs, "/virt/a.or", [SourceFile { path: "/virt/a.or", text: text }]);
  return match (o.program) {
    Some(p) => {
      const r = check(p, o.sm);
      return r.isOk() ? Some(pruneProgram(optimize(lower(r.unwrap())))) : None;
    },
    None => None,
  };
}

function source(): string {
  return "interface Shape {\n  area(): float;\n}\nclass Sq implements Shape {\n  s: float = 2.0;\n  area(): float {\n    return this.s * this.s;\n  }\n}\n"
      + "class Counter {\n  n: int = 0;\n  next(): int {\n    this.n += 1;\n    return this.n;\n  }\n}\n"
      + "function main(): void {\n  const sh: Shape = new Sq();\n  let c = new Counter();\n  const xs = [1, 2, 3].map(x => x * c.n);\n"
      + "  console.log(sh.area().toString() + c.next().toString() + xs.length.toString());\n  const o: Option<int> = None;\n"
      + "  console.log(o.unwrapOr(4).toString());\n}\n";
}

@Test
function realProgramsReferOnlyToDeclaredSymbolsInBothBackends(host: Host): void {
  useFs(
    host,
    fs => {
      const m = compiled(fs, source());
      assert(m.isSome(), "checks, lowers, optimises");
      const p = m.unwrap();
      assert(emittable(p), "emittable");
      const c = emitC(p);
      const ll = emitLlvm(p);
      assert(refsDeclared(c, cSymbols(p)), "C");
      assert(llvmRefsDeclared(ll, llvmSymbols(p)), "LLVM");
      assert(c.includes("#pragma STDC FP_CONTRACT OFF"), "a program with floats");
      assert(
        p.functions.some(f => f.inout) && c.includes("OrinObj **orin_out"),
        "an in/out function in C",
      );
      assert(ll.includes("ptr noundef nonnull %pout"), "and in LLVM");
    },
  );
}

// ADR-0038 §8 gate 1: a small self-recursive function with a scalar early return is split into an inlined wrapper and `.body`.
function fibLike(callsItself: bool): MProgram {
  const mi = MLocal { name: "n", ty: MInt };
  const t = MLocal { name: "t", ty: MBool };
  const r = MLocal { name: "r", ty: MInt };
  const f = MFunction {
    name: "m.fib",
    paramCount: 1,
    paramOwned: [false],
    inout: false, uniqueIn: false, uniqueOut: false,
    locals: [mi, t, r],
    ret: MInt,
    blocks: [
      bk([IBinary(1, OpLt, OLocal(0), OInt(2))], TBranch(OLocal(1), 1, 2)),
      bk([], TReturn(Some(OLocal(0)))),
      bk([ICall(Some(2), callsItself ? 1 : 0, [OLocal(0)])], TReturn(Some(OLocal(2)))),
    ],
  };
  const mainF = fn("main", [], [bk([], TReturn(None))]);
  return MProgram { functions: [mainF, f], strings: [], main: 0, vtables: [], inlineFns: [] };
}

@Test
function aSmallRecursiveFunctionWithAnEarlyReturnIsSplitIntoWrapperAndBody(): void {
  const p = fibLike(true);
  const syms = llvmSymbols(p);
  const text = emitLlvmFunction(syms, p, 1);
  const name = syms.name(1);
  assert(
    text.startsWith(
      "define internal noundef i64 @" + name + "(i64 noundef %p0) alwaysinline nounwind {",
    ),
    "the wrapper",
  );
  assert(
    text.includes("define internal noundef i64 @" + name + ".body(i64 noundef %p0) nounwind {"),
    "the body",
  );
  assert(text.includes("tail call i64 @" + name + ".body(i64 %p0)"), "the wrapper calls the body");
  assert(llvmRefsDeclared(text, syms), "the body symbol is declared");
  assert(text.endsWith("}\n\n"), "ends with the closing brace");
  const q = fibLike(false);
  const plain = emitLlvmFunction(llvmSymbols(q), q, 1);
  assert(!plain.includes(".body"), "a function that does not call itself is not split");
}

// `IForward` (docs/mir.md v2.4): a plain copy in both backends; with `--assert-facts` also a call of `orin_assert_fact` on the
// original object, key and slot bits of the source before the destination is written.
function forwarding(): MProgram {
  const f = MFunction {
    name: "main",
    paramCount: 0,
    paramOwned: [],
    inout: false, uniqueIn: false, uniqueOut: false,
    locals: [lr("o"), MLocal { name: "s", ty: MInt }, MLocal { name: "d", ty: MInt }],
    ret: MVoid,
    blocks: [
      bk(
        [IStructNew(0, 0, [OInt(1)]), IGetField(1, OLocal(0), 0), IForward(2, 1, OLocal(0), OUsize(0)), IRelease(0)],
        TReturn(None),
      ),
    ],
  };
  return MProgram { functions: [f], strings: [], main: 0, vtables: [], inlineFns: [] };
}

@Test
function aForwardedLoadIsACopyAndTheFactsBuildChecksIt(): void {
  const p = forwarding();
  const c = emitC(p);
  assert(c.includes("l2 = l1;"), "C: a copy");
  assert(!c.includes("orin_assert_fact"), "C: no check in a normal build");
  const cf = emitCFacts(p, true);
  assert(
    cf.includes("orin_assert_fact(l0, ((uint64_t)0ULL), ((uint64_t)(l1))); l2 = l1;"),
    "C: the check reads the source before copying it",
  );
  assert(emitCFacts(p, false) == c, "C: facts off is the normal build");
  const ll = emitLlvm(p);
  assert(!ll.includes("orin_assert_fact"), "LLVM: no check in a normal build");
  const lf = emitLlvmFacts(p, true);
  assert(lf.includes("call void @orin_assert_fact(ptr "), "LLVM: the check");
  assert(lf.includes("declare void @orin_assert_fact(ptr, i64, i64)"), "LLVM: declared");
  assert(llvmRefsDeclared(lf, llvmSymbols(p)), "LLVM: every global is declared");
  assert(emitLlvmFacts(p, false) == ll, "LLVM: facts off is the normal build");
}

// The destination is also the array index: the fact refers to its value BEFORE the copy.
// Exported so tools/test_forward_assert.py can execute this exact verifier-accepted MIR on both backends.
export function forwardingOntoIndex(initial: usize): MProgram {
  const expected: usize = initial == 0 ? 1 : 0;
  const f = fn(
    "main",
    [
      lr("o"),
      MLocal { name: "k", ty: MUsize },
      MLocal { name: "s", ty: MUsize },
      MLocal { name: "ok", ty: MBool },
    ],
    [
      bk(
        [
          IArrayNew(0, false, [OUsize(1), OUsize(0)]),
          ICopy(1, OUsize(initial.toInt())),
          IArrayGet(2, OLocal(0), OLocal(1)),
          IForward(1, 2, OLocal(0), OLocal(1)),
          IRelease(0),
          IBinary(3, OpEq, OLocal(1), OUsize(expected.toInt())),
        ],
        TBranch(OLocal(3), 1, 2),
      ),
      bk([], TReturn(None)),
      bk([], TTrap("forward did not copy the source")),
    ],
  );
  return MProgram { functions: [f], strings: [], main: 0, vtables: [], inlineFns: [] };
}

@Test
function cForwardChecksTheOriginalIndexBeforeWritingIt(): void {
  const p = forwardingOntoIndex(0);
  const text = emitCFacts(p, true);
  assert(
    text.includes("orin_assert_fact(l0, l1, ((uint64_t)(l2))); l1 = l2;"),
    "the fact uses the original index and source before the destination is overwritten",
  );
}

@Test
function llvmForwardChecksTheOriginalIndexBeforeWritingIt(): void {
  const p = forwardingOntoIndex(0);
  const text = emitLlvmFacts(p, true);
  const checkAt = text
      .indexOf("  call void @orin_assert_fact(ptr %b0i3o1, i64 %b0i3o2, i64 %b0i3o0)")
      .unwrap();
  const storeAt = text.indexOf("  store i64 %b0i3o0, ptr %l1").unwrap();
  assert(
    checkAt < storeAt,
    "the assertion must read the original index before the destination store",
  );
}

// `IGetFieldU` / `ISetFieldU` (docs/mir.md v2.8, rule U6): the heap struct access without the kind and slot-count check.
function uncheckedFields(): MProgram {
  const f = MFunction {
    name: "main",
    paramCount: 0,
    paramOwned: [],
    inout: false, uniqueIn: false, uniqueOut: false,
    locals: [lr("o"), MLocal { name: "s", ty: MInt }, MLocal { name: "d", ty: MInt }],
    ret: MVoid,
    blocks: [
      bk(
        [
          IStructNew(0, 0, [OInt(1), OInt(2)]),
          IGetField(1, OLocal(0), 1),
          IGetFieldU(2, OLocal(0), 1),
          ISetFieldU(0, 0, OLocal(2)),
          IRelease(0),
        ],
        TReturn(None),
      ),
    ],
  };
  return MProgram { functions: [f], strings: [], main: 0, vtables: [], inlineFns: [] };
}

@Test
function cUncheckedFieldsUseTheUncheckedHelpers(): void {
  const c = emitC(uncheckedFields());
  assert(c.includes("orinc_struct_get(l0, 1)"), "C: the first access stays checked");
  assert(c.includes("orinc_struct_get_u(l0, 1)"), "C: the load is unchecked");
  assert(c.includes("orinc_struct_set_u(l0, 0, "), "C: the store is unchecked");
}

@Test
function llvmUncheckedFieldsHaveNoShapeGuard(): void {
  const p = uncheckedFields();
  const ll = emitLlvm(p);
  assert(llvmRefsDeclared(ll, llvmSymbols(p)), "LLVM: every global is declared");
  const checked = emitLlvm(MProgram {
    functions: [MFunction {
      name: "main",
      paramCount: 0,
      paramOwned: [],
      inout: false, uniqueIn: false, uniqueOut: false,
      locals: p.functions[0].locals,
      ret: MVoid,
      blocks: [bk(
        [
          IStructNew(0, 0, [OInt(1), OInt(2)]),
          IGetField(1, OLocal(0), 1),
          IGetField(2, OLocal(0), 1),
          ISetField(0, 0, OLocal(2)),
          IRelease(0),
        ],
        TReturn(None),
      )],
    }],
    strings: [],
    main: 0,
    vtables: [],
    inlineFns: [],
  });
  assert(ll.length < checked.length, "LLVM: the unchecked module is smaller (two guards fewer)");
}

@Test
function shapeCheckEmitsOnlyTheGuard(): void {
  const f = MFunction {
    name: "main", paramCount: 0, paramOwned: [], inout: false, uniqueIn: false, uniqueOut: false,
    locals: [lr("o"), MLocal { name: "d", ty: MInt }], ret: MVoid,
    blocks: [bk([IStructNew(0, 0, [OInt(1), OInt(2)]), IShapeCheck(0, 1), IGetFieldU(1, OLocal(0), 1), IRelease(0)], TReturn(None))],
  };
  const p = MProgram { functions: [f], strings: [], main: 0, vtables: [], inlineFns: [] };
  const c = emitC(p);
  assert(c.includes("orinc_chk_slot(l0, 1);"), "C: the shape check");
  assert(c.includes("orinc_struct_get_u(l0, 1)"), "C: the unchecked load");
  const ll = emitLlvm(p);
  assert(ll.includes("icmp ule i64"), "LLVM: the slot count guard");
  assert(llvmRefsDeclared(ll, llvmSymbols(p)), "LLVM: every global is declared");
}

// `IArrayGetU` / `IArraySetU` (docs/mir.md v2.6, rule U1): the checked access without the kind and bounds checks; with
// `--assert-facts` the original checks run first (`orin_assert_array`, exit 70 if they would fail).
function unchecked(): MProgram {
  const f = MFunction {
    name: "main",
    paramCount: 0,
    paramOwned: [],
    inout: false, uniqueIn: false, uniqueOut: false,
    locals: [lr("a"), MLocal { name: "s", ty: MInt }, MLocal { name: "d", ty: MInt }],
    ret: MVoid,
    blocks: [
      bk(
        [
          IArrayNew(0, false, [OInt(1), OInt(2)]),
          IArrayGet(1, OLocal(0), OUsize(1)),
          IArrayGetU(2, OLocal(0), OUsize(1)),
          IArraySetU(0, OUsize(1), OLocal(2)),
          IRelease(0),
        ],
        TReturn(None),
      ),
    ],
  };
  return MProgram { functions: [f], strings: [], main: 0, vtables: [], inlineFns: [] };
}

@Test
function cUncheckedAccessUsesTheUncheckedHelpersAndTheFactsBuildChecksFirst(): void {
  const p = unchecked();
  const c = emitC(p);
  assert(c.includes("orinc_array_at(l0, ((uint64_t)1ULL))"), "C: the first access stays checked");
  assert(c.includes("l2 = (int64_t)orinc_array_at_u(l0, ((uint64_t)1ULL));") || c.includes("orinc_array_at_u(l0, "), "C: the load is unchecked");
  assert(c.includes("orinc_mir_array_put_u(l0, "), "C: the store is unchecked");
  assert(!c.includes("orin_assert_array"), "C: no check in a normal build");
  const cf = emitCFacts(p, true);
  assert(cf.includes("orin_assert_array(l0, ((uint64_t)1ULL)); "), "C: the facts build checks first");
  assert(emitCFacts(p, false) == c, "C: facts off is the normal build");
}

@Test
function llvmUncheckedAccessHasNoGuardAndTheFactsBuildChecksFirst(): void {
  const p = unchecked();
  const ll = emitLlvm(p);
  assert(!ll.includes("orin_assert_array"), "LLVM: no check in a normal build");
  const lf = emitLlvmFacts(p, true);
  assert(lf.includes("call void @orin_assert_array(ptr "), "LLVM: the check");
  assert(lf.includes("declare void @orin_assert_array(ptr, i64)"), "LLVM: declared");
  assert(llvmRefsDeclared(lf, llvmSymbols(p)), "LLVM: every global is declared");
  assert(emitLlvmFacts(p, false) == ll, "LLVM: facts off is the normal build");
  const checked = emitLlvm(MProgram {
    functions: [MFunction {
      name: "main",
      paramCount: 0,
      paramOwned: [],
      inout: false, uniqueIn: false, uniqueOut: false,
      locals: p.functions[0].locals,
      ret: MVoid,
      blocks: [bk(
        [
          IArrayNew(0, false, [OInt(1), OInt(2)]),
          IArrayGet(1, OLocal(0), OUsize(1)),
          IArrayGet(2, OLocal(0), OUsize(1)),
          IArraySet(0, OUsize(1), OLocal(2)),
          IRelease(0),
        ],
        TReturn(None),
      )],
    }],
    strings: [],
    main: 0,
    vtables: [],
    inlineFns: [],
  });
  assert(ll.length < checked.length, "LLVM: the unchecked form emits fewer instructions than the checked one");
}

// Programs for tools/test_unchecked_assert.py, which executes them on both backends with `--assert-facts` on and off.
// variant 0: verifier-accepted (the unchecked load also overwrites its own index local); 1: an unchecked access out of bounds and
// 2: an unchecked access on a struct, both NOT verifier-accepted, so only the facts build may run them (it must exit 70).
export function uncheckedMir(variant: usize): MProgram {
  const locals = [
    lr("a"),
    MLocal { name: "i", ty: MUsize },
    MLocal { name: "s", ty: MUsize },
    MLocal { name: "ok", ty: MBool },
  ];
  let body: Instr[] = [];
  if (variant == 0) {
    body = [
      IArrayNew(0, false, [OUsize(1), OUsize(0)]),
      ICopy(1, OUsize(0)),
      IArrayGet(2, OLocal(0), OUsize(0)),
      IArrayGet(2, OLocal(0), OLocal(1)),
      IArrayGetU(1, OLocal(0), OLocal(1)),
      IArraySetU(0, OUsize(0), OUsize(7)),
      IArrayGetU(2, OLocal(0), OUsize(0)),
      IRelease(0),
      IBinary(3, OpEq, OLocal(2), OUsize(7)),
    ];
  } else if (variant == 1) {
    body = [IArrayNew(0, false, [OUsize(1), OUsize(0)]), IArrayGetU(2, OLocal(0), OUsize(5)), IRelease(0), ICopy(3, OBool(true))];
  } else {
    body = [IStructNew(0, 0, [OUsize(1), OUsize(2)]), IArrayGetU(2, OLocal(0), OUsize(0)), IRelease(0), ICopy(3, OBool(true))];
  }
  const f = fn(
    "main",
    locals,
    [bk(body, TBranch(OLocal(3), 1, 2)), bk([], TReturn(None)), bk([], TTrap("unchecked access computed the wrong value"))],
  );
  return MProgram { functions: [f], strings: [], main: 0, vtables: [], inlineFns: [] };
}

// ---------------------------------------------------------------- the task interface (ADR-0052 Addendum B, R3e.0)

@Test
function theL1EntryTableIsConsistent(): void {
  const names = rtNames();
  let i: usize = 0;
  while (i < names.length) {
    assert(names[i].startsWith("$rt/"), "an entry is a function of $rt");
    let j: usize = i + 1;
    while (j < names.length) {
      assert(names[i] != names[j], "entry names are unique");
      j += 1;
    }
    i += 1;
  }
  assertEqUsize(names.length, 56, "30 R3d entries and 26 for the task interface");
  assertEqString(names[RT_CORE_PROBE_FN], "$rt/coreprobe.probeEntry", "the probe entry");
  assertEqString(names[RT_TASK_MAIN], "$rt/task.main", "the task entry");
  assertEqUsize(RT_TASK_MAIN, RT_FN_TASK_MAIN, "fnAddr names the task entry by the number mir/rt.or gives it");
  assertEqUsize(RT_CORE_PROBE_FN, RT_FN_PROBE_ENTRY, "fnAddr names the probe entry by the number mir/rt.or gives it");
  assert(rtFnAddrOk(RT_TASK_MAIN) && !rtFnAddrOk(RT_TASK_TRAP), "the task entry is a void(void *) wrapper, the trap is not");
  assertEqUsize(rtAlways(false).length, rtWraps().length, "every wrapper but the task entry is always alive, and the trap shape");
  for (const e of fnAddrEntries()) {
    assert(rtFnAddrOk(e), "fnAddr accepts only entries whose wrapper is void(void *)");
  }
  assert(!rtFnAddrOk(RT_ARRAY_NEW), "the wrapper of orin_array_new takes two words");
  assert(!rtFnAddrOk(1000), "a number beyond the table");
  let k: usize = 0;
  while (k < taskOpCount()) {
    match (l1Task(k)) {
      Some(e) => {
        assert(e < names.length, "l1Task names a real entry");
        assert(k < 31 || k > 36, "the wake sources stay direct L0 calls");
      },
      None => {},
    }
    k += 1;
  }
  assert(l1Task(0).isSome() && l1Task(27).isSome() && l1Task(24).isSome() && l1Task(31).isNone(), "monitor operations have entries");
  assert(!rtWrappersOn(sample()), "a program has no test wrappers by default");
  assert(rtWrappersOn(withRtWrappers(sample())), "--rt-wrappers marks the program");
}

@Test
function thePlatTableMatchesTheHeader(): void {
  assertEqUsize(platOpCount(), 22, "22 L0 functions");
  assertEqString(platOpName(0), "thread_create", "threads first");
  assertEqString(platOpName(4), "monitor_new", "then the ten monitor functions");
  assertEqString(platOpName(19), "exit", "the process functions last");
  assertEqString(platOpName(20), "wake_signal", "the wake functions of C2 last");
  assertEqString(platOpName(22), "", "an unknown index has no name");
  assertEqString(platOpParams(11), "iip", "monitor_get(h, i, &out)");
  assertEqString(platOpResult(11), "n", "monitor_get gives a C int");
  assertEqString(platOpResult(17), "p", "getenv gives a pointer");
  assertEqString(platOpResult(2), "v", "thread_exit gives nothing");
}

// A program whose `main` runs one core operation `op` over the literal operands `args`, result in a usize local.
function coreProg(op: usize, args: Operand[]): MProgram {
  const f = fn(
    "main",
    [MLocal { name: "r", ty: MUsize }],
    [bk([IBuiltin(Some(0), BCore(op), args)], TReturn(None))],
  );
  return MProgram { functions: [f], strings: [], main: 0, vtables: [], inlineFns: [] };
}

@Test
function platEmitsADirectCallOfTheL0FunctionInBothBackends(): void {
  // monitor_get(h = 3, i = 1, out = 8): an int result sign-extended, a pointer argument
  const get = coreProg(28, [OUsize(11), OUsize(3), OUsize(1), OUsize(8)]);
  const c = emitC(get);
  assert(c.includes("((uint64_t)(int64_t)orin_platform_monitor_get((int64_t)(((uint64_t)3ULL)), (int64_t)(((uint64_t)1ULL)), (void *)(uintptr_t)(((uint64_t)8ULL))))"), "C: the cast call");
  const ll = emitLlvm(get);
  assert(ll.includes("declare i32 @orin_platform_monitor_get(i64, i64, ptr)\n"), "LLVM: the declaration with C types");
  assert(ll.includes("= call i32 @orin_platform_monitor_get(i64 3, i64 1, ptr "), "LLVM: the call");
  assert(ll.includes("= sext i32 "), "LLVM: a C int result is sign-extended");
  assert(!ll.includes("@orin_platform_monitor_get(i64, i64, ptr) "), "no attribute on the declaration (no readnone, no nounwind)");
  // a table index that is not used is not declared
  assert(!ll.includes("@orin_platform_monitor_lock"), "only the used functions are declared");
  // a void function gives 0; thread_exit is noreturn
  const ex = coreProg(28, [OUsize(2), OUsize(0), OUsize(0), OUsize(0)]);
  assert(emitC(ex).includes("(orin_platform_thread_exit(), (uint64_t)0)"), "C: a void function gives 0");
  assert(emitLlvm(ex).includes("declare void @orin_platform_thread_exit() noreturn\n"), "LLVM: noreturn, nothing else");
}

@Test
function fnAddrAndSharedBaseEmitAddresses(): void {
  const fa = coreProg(29, [OUsize(55)]);
  assert(emitC(fa).includes("((uint64_t)(uintptr_t)&orin_probe_entry)"), "C: the address of the wrapper");
  assert(emitLlvm(fa).includes("= ptrtoint ptr @orin_probe_entry to i64"), "LLVM: the address of the wrapper");
  const sh = coreProg(30, []);
  assert(emitC(sh).includes("((uint64_t)(uintptr_t)&orin_shared)"), "C: the shared block");
  const ll = emitLlvm(sh);
  assert(ll.includes("@orin_shared = external global [128 x i64]\n"), "LLVM: declared as 128 words");
  assert(ll.includes("= ptrtoint ptr @orin_shared to i64"), "LLVM: its address");
  assert(!emitLlvm(coreProg(20, [])).includes("@orin_shared"), "a program without sharedBase does not declare it");
}
