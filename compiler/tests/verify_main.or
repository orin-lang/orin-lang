// Test driver for the OIM ownership verifier: builds MIR programs by hand, runs `verify` and
// checks the outcome. One line per case; exit status 1 if any case fails.
//   build/bootstrap/orin2 build compiler/tests/verify_main.or -o build/verify_main && ./build/verify_main

import { MProgram, MVTable, MFunction, MType, MLocal, MBlock, Instr, Terminator, Operand, SwitchCase, plainBlock, hasSpan } from "../mir";
import { Span } from "../diag";
import {
  BStrLength, BArrLength, BFileOpen, BFileClose, BFileIsOpen, BFileReadLine, BFileWrite, BFsReadFile, BFsExists, BGrantFs, BGrantClock, BGrantUnder,
  BGrantReadOnly, BGrantRevoke, BTimeNowMillis, BTimeMonotonicMillis, BTask, BGrantNet, BGrantListen, BNetListen, BNetAccept, BNetConnect, BNetClose, BNetRecv, BNetShutdown, UnOp, BinOp
} from "../hir";
import { verify, VerifyReport } from "../verify";
import { exit } from "std:process";

// ---------------------------------------------------------------- builders

function lr(n: string): MLocal { return MLocal { name: n, ty: MRef }; }
function li(n: string): MLocal { return MLocal { name: n, ty: MInt }; }
function lu(n: string): MLocal { return MLocal { name: n, ty: MUsize }; }
function lh(n: string): MLocal { return MLocal { name: n, ty: MHandle }; }
function lb(n: string): MLocal { return MLocal { name: n, ty: MBool }; }

function bk(instrs: Instr[], term: Terminator): MBlock {
  return plainBlock(instrs, term);
}

function fn(name: string, params: usize, locals: MLocal[], ret: MType, blocks: MBlock[]): MFunction {
  return MFunction { name: name, paramCount: params, paramOwned: noOwned(params), inout: false, uniqueIn: false, uniqueOut: false, locals: locals, ret: ret, blocks: blocks };
}

function noOwned(n: usize): bool[] {
  let out: bool[] = [];
  let i: usize = 0;
  while (i < n) {
    out.push(false);
    i += 1;
  }
  return out;
}

// Like `fn` but with explicit per-parameter ownership modes.
function fnO(name: string, owned: bool[], locals: MLocal[], ret: MType, blocks: MBlock[]): MFunction {
  return MFunction { name: name, paramCount: owned.length, paramOwned: owned, inout: false, uniqueIn: false, uniqueOut: false, locals: locals, ret: ret, blocks: blocks };
}

function prog(fs: MFunction[]): MProgram {
  return MProgram { functions: fs, strings: ["s"], main: 0, vtables: [], inlineFns: [] };
}

// Single void function `f` whose only block is `instrs; return`.
function straight(params: usize, locals: MLocal[], instrs: Instr[]): MProgram {
  return prog([fn("f", params, locals, MVoid, [bk(instrs, TReturn(None))])]);
}

// Function `g(p: ref): void`.
function gVoid(): MFunction {
  return fn("g", 1, [lr("p")], MVoid, [bk([], TReturn(None))]);
}

function ret(): Terminator { return TReturn(None); }
function t(): Operand { return OBool(true); }

// ---------------------------------------------------------------- runner

// mode 0: no errors and no warnings; 1: an error containing `needle`; 2: no errors, >= 1 warning.
function run(name: string, p: MProgram, mode: int, needle: string): bool {
  const r: VerifyReport = verify(p);
  let ok = false;
  if (mode == 0) {
    ok = r.errors.length == 0 && r.warnings.length == 0;
  } else if (mode == 1) {
    for (const e of r.errors) {
      if (e.message.includes(needle)) {
        ok = true;
      }
    }
  } else {
    ok = r.errors.length == 0 && r.warnings.length > 0;
  }
  if (ok) {
    console.log("PASS " + name);
    return true;
  }
  console.log("FAIL " + name);
  for (const e of r.errors) {
    console.log("  error " + e.func + " b" + e.block.toString() + " i" + e.instr.toString() + ": " + e.message);
  }
  for (const w of r.warnings) {
    console.log("  warning " + w.func + " b" + w.block.toString() + " i" + w.instr.toString() + ": " + w.message);
  }
  return false;
}

function neg(name: string, p: MProgram, needle: string): bool { return run("neg " + name, p, 1, needle); }
function pos(name: string, p: MProgram): bool { return run("pos " + name, p, 0, ""); }

// ---------------------------------------------------------------- negative cases (part 1)

function negatives1(): usize {
  let bad: usize = 0;
  const dead = "dead";
  const uniq = "Unique";
  const inc = "inconsistent";
  const ok1 = neg("use after release", straight(0, [lr("a"), li("i")], [
    IStructNew(0, 0, []), IRelease(0), ITag(1, OLocal(0))]), dead);
  const ok2 = neg("double release", straight(0, [lr("a")], [
    IStructNew(0, 0, []), IRelease(0), IRelease(0)]), dead);
  const ok3 = neg("release of Param", straight(1, [lr("p")], [IRelease(0)]), "parameter");
  const ok4 = neg("release of Borrowed", straight(1, [lr("p"), lr("b")], [
    IGetField(1, OLocal(0), 0), IRelease(1)]), "borrowed");
  const ok5 = neg("borrow used after source released", straight(0, [lr("a"), lr("b"), li("i")], [
    IStructNew(0, 0, []), IBorrow(1, 0), IRelease(0), ITag(2, OLocal(1))]), dead);
  const ok6 = neg("borrow used after source moved", straight(0, [lr("a"), lr("b"), lr("c"), li("i")], [
    IStructNew(0, 0, []), IBorrow(1, 0), IMove(2, 0), ITag(3, OLocal(1)), IRelease(2)]), dead);
  const ok7 = neg("borrow used after ISetField on source", straight(0, [lr("a"), lr("g"), li("i")], [
    IStructNew(0, 0, [OStr(0)]), IGetField(1, OLocal(0), 0), ISetField(0, 0, OStr(0)),
    ITag(2, OLocal(1)), IRelease(0)]), dead);
  const ok8 = neg("borrow used after IMakeUnique on source", straight(0, [lr("a"), lr("g"), li("i")], [
    IStructNew(0, 0, [OStr(0)]), IGetField(1, OLocal(0), 0), IMakeUnique(0),
    ITag(2, OLocal(1)), IRelease(0)]), dead);
  const ok9 = neg("borrow used after IArrayPush on source", straight(0, [lr("a"), lr("g"), li("i")], [
    IArrayNew(0, true, [OStr(0)]), IArrayGet(1, OLocal(0), OUsize(0)), IArrayPush(0, OStr(0)),
    ITag(2, OLocal(1)), IRelease(0)]), dead);
  const ok10 = neg("ISetField on non-Unique", straight(0, [lr("a")], [
    IDup(0, OStr(0)), ISetField(0, 0, OInt(1)), IRelease(0)]), uniq);
  const ok11 = neg("Unique demoted by IDup", straight(0, [lr("a"), lr("b")], [
    IStructNew(0, 0, [OInt(1)]), IDup(1, OLocal(0)), ISetField(0, 0, OInt(2)), IRelease(0), IRelease(1)]), uniq);
  const ok12 = neg("Unique demoted by IBorrow", straight(0, [lr("a"), lr("b")], [
    IStructNew(0, 0, [OInt(1)]), IBorrow(1, 0), ISetField(0, 0, OInt(2)), IRelease(0)]), uniq);
  const ok13 = neg("take twice from same slot", straight(0, [lr("a"), lr("t"), lr("u")], [
    IStructNew(0, 0, [OStr(0)]), ITakeField(1, 0, 0), ITakeField(2, 0, 0)]), "taken");
  const ok14 = neg("put into non-hole", straight(0, [lr("a"), lr("t")], [
    IStructNew(0, 0, [OStr(0)]), IDup(1, OStr(0)), IPutField(0, 0, 1)]), "not a taken slot");
  const ok15 = neg("return with open hole", straight(0, [lr("a"), lr("t")], [
    IStructNew(0, 0, [OStr(0)]), ITakeField(1, 0, 0), IRelease(1)]), "open hole");
  const ok16 = neg("read hole via IGetField", straight(0, [lr("a"), lr("t"), lr("g")], [
    IStructNew(0, 0, [OStr(0)]), ITakeField(1, 0, 0), IGetField(2, OLocal(0), 0)]), "taken");
  const ok17 = neg("join of Dead and Owned then use", prog([fn("f", 0, [lr("a"), lb("c"), li("i")], MVoid, [
    bk([ICopy(1, t())], TBranch(OLocal(1), 1, 2)),
    bk([IStructNew(0, 0, [])], TGoto(3)),
    bk([], TGoto(3)),
    bk([ITag(2, OLocal(0))], ret())])]), inc);
  const ok18 = neg("mismatched Borrowed sources at join", prog([fn("f", 2, [lr("p"), lr("q"), lr("b"), lb("c"), li("i")], MVoid, [
    bk([ICopy(3, t())], TBranch(OLocal(3), 1, 2)),
    bk([IBorrow(2, 0)], TGoto(3)),
    bk([IBorrow(2, 1)], TGoto(3)),
    bk([ITag(4, OLocal(2))], ret())])]), inc);
  const ok19 = neg("loop releases without re-acquiring", prog([fn("f", 0, [lr("a"), lb("c")], MVoid, [
    bk([IStructNew(0, 0, []), ICopy(1, t())], TGoto(1)),
    bk([IRelease(0)], TBranch(OLocal(1), 1, 2)),
    bk([], ret())])]), inc);
  const ok20 = neg("move from Borrowed", straight(1, [lr("p"), lr("b"), lr("c")], [
    IGetField(1, OLocal(0), 0), IMove(2, 1)]), "borrowed");
  const ok21 = neg("IStructNew consumes a Borrowed", straight(1, [lr("p"), lr("b"), lr("d")], [
    IGetField(1, OLocal(0), 0), IStructNew(2, 0, [OLocal(1)])]), "borrowed");
  if (!ok1) { bad += 1; } if (!ok2) { bad += 1; } if (!ok3) { bad += 1; } if (!ok4) { bad += 1; }
  if (!ok5) { bad += 1; } if (!ok6) { bad += 1; } if (!ok7) { bad += 1; } if (!ok8) { bad += 1; }
  if (!ok9) { bad += 1; } if (!ok10) { bad += 1; } if (!ok11) { bad += 1; } if (!ok12) { bad += 1; }
  if (!ok13) { bad += 1; } if (!ok14) { bad += 1; } if (!ok15) { bad += 1; } if (!ok16) { bad += 1; }
  if (!ok17) { bad += 1; } if (!ok18) { bad += 1; } if (!ok19) { bad += 1; } if (!ok20) { bad += 1; }
  // Self-rooted borrows (found by the Lean soundness proof, docs/formal.md finding 1).
  const ok22 = neg("IGetField rooted at its own destination", straight(0, [lr("d")], [
    IStructNew(0, 0, [OStr(0)]), IGetField(0, OLocal(0), 0)]), "itself");
  const ok23 = neg("IBorrow rooted at its own destination", straight(0, [lr("d"), lr("s")], [
    IStructNew(0, 0, [OStr(0)]), IBorrow(1, 0), IBorrow(0, 1)]), "itself");
  if (!ok21) { bad += 1; } if (!ok22) { bad += 1; } if (!ok23) { bad += 1; }
  return bad;
}

// ---------------------------------------------------------------- negative cases (part 2)

function negatives2(): usize {
  let bad: usize = 0;
  const oor = "out of range";
  const ok1 = neg("block index out of range", prog([fn("f", 0, [li("i")], MVoid, [bk([], TGoto(5))])]), oor);
  const ok2 = neg("destination local out of range", straight(0, [li("i")], [ICopy(9, OInt(1))]), "bad local");
  const ok3 = neg("operand local out of range", straight(0, [li("i")], [IUnary(0, UnNeg, OLocal(4))]), "mismatch");
  const ok4 = neg("function index out of range", straight(0, [li("i")], [ICall(None, 7, [])]), oor);
  const ok5 = neg("call with wrong argument count", prog([
    fn("f", 0, [li("i")], MVoid, [bk([ICall(None, 1, [])], ret())]), gVoid()]), "wrong number");
  const ok6 = neg("call argument class mismatch", prog([
    fn("f", 0, [li("i")], MVoid, [bk([ICopy(0, OInt(1)), ICall(None, 1, [OLocal(0)])], ret())]), gVoid()]), "wrong class");
  const ok7 = neg("IBinary int + bool", straight(0, [li("i"), lb("b")], [
    ICopy(1, t()), IBinary(0, OpAdd, OInt(1), OLocal(1))]), "mismatch");
  const ok8 = neg("return a Param", prog([fn("f", 1, [lr("p")], MRef, [bk([], TReturn(Some(OLocal(0))))])]), "parameter");
  const ok9 = neg("IStructNew consumes a local twice", straight(0, [lr("a"), lr("d")], [
    IStructNew(0, 0, []), IStructNew(1, 0, [OLocal(0), OLocal(0)])]), "dead");
  const ok10 = neg("write to scalar parameter", straight(1, [li("n")], [ICopy(0, OInt(1))]), "parameter");
  const ok11 = neg("paramCount exceeds locals", straight(3, [li("n")], []), "paramCount");
  const ok12 = neg("branch on a reference", prog([fn("f", 0, [lr("a")], MVoid, [
    bk([IStructNew(0, 0, [])], TBranch(OLocal(0), 0, 0))])]), "bool");
  const ok13 = neg("IMakeUnique on Param", straight(1, [lr("p")], [IMakeUnique(0)]), "parameter");
  const ok14 = neg("call result aliasing demotes Unique", prog([
    fn("f", 0, [lr("a"), lr("r")], MVoid, [bk([
      IStructNew(0, 0, [OInt(1)]), ICall(Some(1), 1, [OLocal(0)]), ISetField(0, 0, OInt(2)),
      IRelease(0), IRelease(1)], ret())]),
    fn("g", 1, [lr("p"), lr("d")], MRef, [bk([IDup(1, OLocal(0))], TReturn(Some(OLocal(1))))])]), "Unique");
  const ok15 = neg("hole sets differ at join", prog([fn("f", 0, [lr("a"), lr("t"), lb("c")], MVoid, [
    bk([IStructNew(0, 0, [OStr(0)]), ICopy(2, t())], TBranch(OLocal(2), 1, 2)),
    bk([ITakeField(1, 0, 0)], TGoto(3)),
    bk([], TGoto(3)),
    bk([], ret())])]), "hole sets differ");
  const ok16 = neg("use of uninitialised scalar", straight(0, [li("i"), li("j")], [
    IBinary(1, OpAdd, OLocal(0), OInt(1))]), "dead");
  const ok17 = neg("IArraySet on Param", straight(1, [lr("p")], [IArraySet(0, OUsize(0), OInt(1))]), "Unique");
  const ok18 = neg("IStrAppend on Param", straight(1, [lr("p")], [IStrAppend(0, OStr(0))]), "parameter");
  const ok19 = neg("return without value in non-void function", prog([
    fn("f", 0, [li("i")], MRef, [bk([], TReturn(None))])]), "without a value");
  const ok20 = neg("release of never-defined local", straight(0, [lr("a")], [IRelease(0)]), "dead");
  const ok21 = neg("whole-object use while hole open", prog([
    fn("f", 0, [lr("a"), lr("t")], MVoid, [bk([
      IStructNew(0, 0, [OStr(0)]), ITakeField(1, 0, 0), ICall(None, 1, [OLocal(0)])], ret())]),
    gVoid()]), "open hole");
  const ok22 = neg("index local overwritten while naming a hole", straight(0, [lr("a"), lr("t"), lu("i")], [
    ICopy(2, OUsize(0)), IArrayNew(0, true, [OStr(0)]), IArrayTake(1, 0, OLocal(2)), ICopy(2, OUsize(1))]), "overwritten");
  const ok23 = neg("put a Borrowed value", straight(1, [lr("p"), lr("a"), lr("t"), lr("b")], [
    IStructNew(1, 0, [OStr(0)]), ITakeField(2, 1, 0), IGetField(3, OLocal(0), 0), IPutField(1, 0, 3)]), "borrowed");
  const ok24 = neg("ISetField into a taken slot", straight(0, [lr("a"), lr("t")], [
    IStructNew(0, 0, [OStr(0)]), ITakeField(1, 0, 0), ISetField(0, 0, OStr(0))]), "taken");
  const ok25 = neg("switch target out of range", prog([fn("f", 0, [li("i")], MVoid, [
    bk([ICopy(0, OInt(0))], TSwitch(OLocal(0), [SwitchCase { value: 0, target: 3 }], 0))])]), oor);
  const ok26 = neg("string literal index out of range", straight(0, [lr("a")], [IStructNew(0, 0, [OStr(5)])]), "bad");
  if (!ok1) { bad += 1; } if (!ok2) { bad += 1; } if (!ok3) { bad += 1; } if (!ok4) { bad += 1; }
  if (!ok5) { bad += 1; } if (!ok6) { bad += 1; } if (!ok7) { bad += 1; } if (!ok8) { bad += 1; }
  if (!ok9) { bad += 1; } if (!ok10) { bad += 1; } if (!ok11) { bad += 1; } if (!ok12) { bad += 1; }
  if (!ok13) { bad += 1; } if (!ok14) { bad += 1; } if (!ok15) { bad += 1; } if (!ok16) { bad += 1; }
  if (!ok17) { bad += 1; } if (!ok18) { bad += 1; } if (!ok19) { bad += 1; } if (!ok20) { bad += 1; }
  if (!ok21) { bad += 1; } if (!ok22) { bad += 1; } if (!ok23) { bad += 1; } if (!ok24) { bad += 1; }
  if (!ok25) { bad += 1; } if (!ok26) { bad += 1; }
  return bad;
}

// ---------------------------------------------------------------- positive cases

function positives(): usize {
  let bad: usize = 0;
  const ok1 = pos("straight line", straight(0, [lr("a"), li("i")], [
    IStructNew(0, 0, [OInt(1)]), ISetField(0, 0, OInt(2)), IGetField(1, OLocal(0), 0),
    ITag(1, OLocal(0)), IRelease(0)]));
  const ok2 = pos("if/else releases on both paths", prog([fn("f", 0, [lr("a"), lb("c")], MVoid, [
    bk([IStructNew(0, 0, []), ICopy(1, t())], TBranch(OLocal(1), 1, 2)),
    bk([IRelease(0)], TGoto(3)),
    bk([IRelease(0)], TGoto(3)),
    bk([], ret())])]));
  const ok3 = pos("loop with owned local released per iteration", prog([
    fn("f", 0, [li("i"), lb("c"), lr("a")], MVoid, [
      bk([ICopy(0, OInt(0))], TGoto(1)),
      bk([IBinary(1, OpLt, OLocal(0), OInt(3))], TBranch(OLocal(1), 2, 3)),
      bk([IStructNew(2, 0, [OLocal(0)]), IRelease(2), IBinary(0, OpAdd, OLocal(0), OInt(1))], TGoto(1)),
      bk([], ret())])]));
  const ok4 = pos("nested field update take/makeUnique/put", straight(0, [lr("x"), lr("inner"), lr("t")], [
    IStructNew(1, 0, [OInt(1)]), IStructNew(0, 0, [OLocal(1)]), ITakeField(2, 0, 0), IMakeUnique(2),
    ISetField(2, 0, OInt(5)), IPutField(0, 0, 2), IRelease(0)]));
  const ok5 = pos("early return releasing locals", prog([fn("f", 0, [lr("a"), lr("b"), lb("c")], MVoid, [
    bk([IStructNew(0, 0, []), IStructNew(1, 0, []), ICopy(2, t())], TBranch(OLocal(2), 1, 2)),
    bk([IRelease(0), IRelease(1)], ret()),
    bk([IRelease(1), IRelease(0)], ret())])]));
  const ok6 = pos("borrowed field used before source release", straight(0, [lr("a"), lr("g"), lu("n")], [
    IStructNew(0, 0, [OStr(0)]), IGetField(1, OLocal(0), 0), IBuiltin(Some(2), BStrLength, [OLocal(1)]), IRelease(0)]));
  const ok7 = pos("call passing owned, returning owned", prog([
    fn("f", 0, [lr("a"), lr("r")], MVoid, [bk([
      IStructNew(0, 0, [OInt(1)]), ICall(Some(1), 1, [OLocal(0)]), IRelease(0), IRelease(1)], ret())]),
    fn("g", 1, [lr("p"), lr("d")], MRef, [bk([IDup(1, OLocal(0))], TReturn(Some(OLocal(1))))])]));
  const ok8 = pos("array take/put with index local", straight(0, [lr("a"), lr("t"), lu("i")], [
    ICopy(2, OUsize(0)), IArrayNew(0, true, [OStr(0)]), IArrayTake(1, 0, OLocal(2)),
    IArrayPut(0, OLocal(2), 1), IRelease(0)]));
  const ok9 = pos("read from Param", straight(1, [lr("p"), lr("g"), li("i")], [
    IGetField(1, OLocal(0), 0), ITag(2, OLocal(1))]));
  const ok10 = pos("return string literal", prog([fn("f", 0, [], MRef, [bk([], TReturn(Some(OStr(0))))])]));
  const ok11 = pos("move chain", straight(0, [lr("a"), lr("b")], [
    IStructNew(0, 0, []), IMove(1, 0), IRelease(1)]));
  const ok12 = pos("switch releasing in every arm", prog([fn("f", 0, [lr("a"), li("i")], MVoid, [
    bk([IStructNew(0, 0, []), ICopy(1, OInt(0))],
      TSwitch(OLocal(1), [SwitchCase { value: 0, target: 1 }, SwitchCase { value: 1, target: 2 }], 3)),
    bk([IRelease(0)], ret()),
    bk([IRelease(0)], ret()),
    bk([IRelease(0)], ret())])]));
  const ok13 = pos("push in a loop (Unique joins to Owned)", prog([
    fn("f", 0, [lr("a"), lb("c"), li("i")], MVoid, [
      bk([IArrayNew(0, false, []), ICopy(2, OInt(0))], TGoto(1)),
      bk([IBinary(1, OpLt, OLocal(2), OInt(3))], TBranch(OLocal(1), 2, 3)),
      bk([IArrayPush(0, OLocal(2)), IBinary(2, OpAdd, OLocal(2), OInt(1))], TGoto(1)),
      bk([IRelease(0)], ret())])]));
  const ok14 = pos("dup a borrowed field and return it", prog([fn("f", 0, [lr("a"), lr("g"), lr("r")], MRef, [
    bk([IStructNew(0, 0, [OStr(0)]), IGetField(1, OLocal(0), 0), IDup(2, OLocal(1)), IRelease(0)],
      TReturn(Some(OLocal(2))))])]));
  const ok15 = pos("IStrAppend on literal copy", straight(0, [lr("s")], [
    ICopy(0, OStr(0)), IStrAppend(0, OStr(0)), IRelease(0)]));
  const ok16 = pos("scalar-result call keeps Unique", prog([
    fn("f", 0, [lr("a"), li("n")], MVoid, [bk([
      IStructNew(0, 0, [OInt(1)]), ICall(Some(1), 1, [OLocal(0)]), ISetField(0, 0, OInt(2)), IRelease(0)], ret())]),
    fn("g", 1, [lr("p"), li("n")], MInt, [bk([ICopy(1, OInt(0))], TReturn(Some(OLocal(1))))])]));
  const ok17 = pos("trap needs no cleanup", prog([fn("f", 0, [lr("a")], MVoid, [
    bk([IStructNew(0, 0, [])], TTrap("boom"))])]));
  const ok18 = pos("re-take after put", straight(0, [lr("a"), lr("t")], [
    IStructNew(0, 0, [OStr(0)]), ITakeField(1, 0, 0), IPutField(0, 0, 1),
    ITakeField(1, 0, 0), IPutField(0, 0, 1), IRelease(0)]));
  const ok19 = run("warn leak at return", straight(0, [lr("a")], [IStructNew(0, 0, [])]), 2, "");
  const ok20 = run("warn overwritten owned local", straight(0, [lr("a")], [
    IStructNew(0, 0, []), IStructNew(0, 0, []), IRelease(0)]), 2, "");
  if (!ok1) { bad += 1; } if (!ok2) { bad += 1; } if (!ok3) { bad += 1; } if (!ok4) { bad += 1; }
  if (!ok5) { bad += 1; } if (!ok6) { bad += 1; } if (!ok7) { bad += 1; } if (!ok8) { bad += 1; }
  if (!ok9) { bad += 1; } if (!ok10) { bad += 1; } if (!ok11) { bad += 1; } if (!ok12) { bad += 1; }
  if (!ok13) { bad += 1; } if (!ok14) { bad += 1; } if (!ok15) { bad += 1; } if (!ok16) { bad += 1; }
  if (!ok17) { bad += 1; } if (!ok18) { bad += 1; } if (!ok19) { bad += 1; } if (!ok20) { bad += 1; }
  return bad;
}

// ---------------------------------------------------------------- owned parameters (v1.2)

// g(owned p): void, releasing p.
function gOwnedRel(): MFunction {
  return fnO("g", [true], [lr("p")], MVoid, [bk([IRelease(0)], TReturn(None))]);
}

// g2(owned p, borrowed q): void, releasing p.
function g2(): MFunction {
  return fnO("g2", [true, false], [lr("p"), lr("q")], MVoid, [bk([IRelease(0)], TReturn(None))]);
}

function ownedCases(): usize {
  let bad: usize = 0;
  const dead = "dead";
  const p1 = pos("owned param returned via move", prog([
    fnO("f", [true], [lr("p"), lr("r")], MRef, [bk([IMove(1, 0)], TReturn(Some(OLocal(1))))])]));
  const p2 = pos("owned param released", prog([gOwnedRel()]));
  const p3 = pos("owned param released on both branches", prog([
    fnO("f", [true], [lr("p"), lb("c")], MVoid, [
      bk([ICopy(1, t())], TBranch(OLocal(1), 1, 2)),
      bk([IRelease(0)], ret()),
      bk([IRelease(0)], ret())])]));
  const p4 = pos("owned local consumed by call", prog([
    fn("f", 0, [lr("a")], MVoid, [bk([IStructNew(0, 0, []), ICall(None, 1, [OLocal(0)])], ret())]),
    gOwnedRel()]));
  const p5 = pos("Unique local consumed by call", prog([
    fn("f", 0, [lr("a")], MVoid, [bk([IStructNew(0, 0, [OInt(1)]), ICall(None, 1, [OLocal(0)])], ret())]),
    gOwnedRel()]));
  const p6 = pos("string literal passed to owned position", prog([
    fn("f", 0, [], MVoid, [bk([ICall(None, 1, [OStr(0)])], ret())]),
    gOwnedRel()]));
  const p7 = pos("dup then consume, original still usable", prog([
    fn("f", 0, [lr("a"), lr("t"), li("i")], MVoid, [bk([
      IStructNew(0, 0, []), IDup(1, OLocal(0)), ICall(None, 1, [OLocal(1)]), ITag(2, OLocal(0)), IRelease(0)], ret())]),
    gOwnedRel()]));
  const p8 = pos("owned and borrowed positions with distinct locals", prog([
    fn("f", 0, [lr("a"), lr("b")], MVoid, [bk([
      IStructNew(0, 0, []), IStructNew(1, 0, []), ICall(None, 1, [OLocal(0), OLocal(1)]), IRelease(1)], ret())]),
    g2()]));
  const p9 = pos("borrowed param dup'd and consumed", prog([
    fn("f", 1, [lr("p"), lr("t")], MVoid, [bk([IDup(1, OLocal(0)), ICall(None, 1, [OLocal(1)])], ret())]),
    gOwnedRel()]));
  const p10 = run("warn owned param never consumed", prog([
    fnO("f", [true], [lr("p")], MVoid, [bk([], ret())])]), 2, "");
  const n1 = neg("borrowed Param passed to owned position", prog([
    fn("f", 1, [lr("p")], MVoid, [bk([ICall(None, 1, [OLocal(0)])], ret())]),
    gOwnedRel()]), "parameter");
  const n2 = neg("Borrowed local passed to owned position", prog([
    fn("f", 0, [lr("a"), lr("b")], MVoid, [bk([
      IStructNew(0, 0, [OStr(0)]), IGetField(1, OLocal(0), 0), ICall(None, 1, [OLocal(1)]), IRelease(0)], ret())]),
    gOwnedRel()]), "borrowed");
  const n3 = neg("use after consumption by call", prog([
    fn("f", 0, [lr("a"), li("i")], MVoid, [bk([
      IStructNew(0, 0, []), ICall(None, 1, [OLocal(0)]), ITag(1, OLocal(0))], ret())]),
    gOwnedRel()]), dead);
  const n4 = neg("release after consumption by call", prog([
    fn("f", 0, [lr("a")], MVoid, [bk([
      IStructNew(0, 0, []), ICall(None, 1, [OLocal(0)]), IRelease(0)], ret())]),
    gOwnedRel()]), dead);
  const n5 = neg("owned param used after move", prog([
    fnO("f", [true], [lr("p"), lr("r"), li("i")], MVoid, [bk([IMove(1, 0), ITag(2, OLocal(0)), IRelease(1)], ret())])]), dead);
  const n6 = neg("owned param released twice", prog([
    fnO("f", [true], [lr("p")], MVoid, [bk([IRelease(0), IRelease(0)], ret())])]), dead);
  const n7 = neg("same local in owned and borrowed position", prog([
    fn("f", 0, [lr("a")], MVoid, [bk([IStructNew(0, 0, []), ICall(None, 1, [OLocal(0), OLocal(0)])], ret())]),
    g2()]), "aliases");
  const n8 = neg("borrowed alias of the consumed argument", prog([
    fn("f", 0, [lr("a"), lr("b")], MVoid, [bk([
      IStructNew(0, 0, [OStr(0)]), IGetField(1, OLocal(0), 0), ICall(None, 1, [OLocal(0), OLocal(1)])], ret())]),
    g2()]), "aliases");
  const n9 = neg("same local consumed twice", prog([
    fn("f", 0, [lr("a")], MVoid, [bk([IStructNew(0, 0, []), ICall(None, 1, [OLocal(0), OLocal(0)])], ret())]),
    fnO("h", [true, true], [lr("p"), lr("q")], MVoid, [bk([IRelease(0), IRelease(1)], ret())])]), dead);
  const n10 = neg("paramOwned length differs", prog([
    MFunction { name: "f", paramCount: 1, paramOwned: [], inout: false, uniqueIn: false, uniqueOut: false, locals: [lr("p")], ret: MVoid, blocks: [bk([], ret())] }]), "paramOwned");
  const n11 = neg("owned scalar parameter", prog([
    fnO("f", [true], [li("n")], MVoid, [bk([], ret())])]), "not a reference");
  const n12 = neg("borrow of owned param used after it is consumed", prog([
    fnO("f", [true], [lr("p"), lr("b"), lr("r"), li("i")], MVoid, [bk([
      IBorrow(1, 0), IMove(2, 0), ITag(3, OLocal(1)), IRelease(2)], ret())])]), dead);
  if (!p1) { bad += 1; } if (!p2) { bad += 1; } if (!p3) { bad += 1; } if (!p4) { bad += 1; }
  if (!p5) { bad += 1; } if (!p6) { bad += 1; } if (!p7) { bad += 1; } if (!p8) { bad += 1; }
  if (!p9) { bad += 1; } if (!p10) { bad += 1; }
  if (!n1) { bad += 1; } if (!n2) { bad += 1; } if (!n3) { bad += 1; } if (!n4) { bad += 1; }
  if (!n5) { bad += 1; } if (!n6) { bad += 1; } if (!n7) { bad += 1; } if (!n8) { bad += 1; }
  if (!n9) { bad += 1; } if (!n10) { bad += 1; } if (!n11) { bad += 1; } if (!n12) { bad += 1; }
  return bad;
}

// ---------------------------------------------------------------- closures (v1.3, ADR-0011)

// Lifted function `l(env: ref, x: int): void` (all parameters borrowed).
function lifted(): MFunction {
  return fn("l", 2, [lr("env"), li("x")], MVoid, [bk([], TReturn(None))]);
}

// Lifted function `lr(env: ref): ref` returning a fresh object.
function liftedRef(): MFunction {
  return fn("lr", 1, [lr("env"), lr("a"), lr("b")], MRef, [bk([IStructNew(1, 0, []), IMove(2, 1)], TReturn(Some(OLocal(2))))]);
}

function closureCases(): usize {
  let bad: usize = 0;
  const dead = "dead";
  const p1 = pos("closure without captures, called and released", prog([
    fn("f", 0, [lr("c")], MVoid, [bk([
      IClosure(0, 1, []), ICallIndirect(None, OLocal(0), [OInt(3)]), IRelease(0)], ret())]),
    lifted()]));
  const p2 = pos("captures are consumed by IClosure", prog([
    fn("f", 0, [lr("a"), lr("c")], MVoid, [bk([
      IStructNew(0, 0, [OInt(1)]), IClosure(1, 1, [OLocal(0), OInt(2)]), ICallIndirect(None, OLocal(1), [OInt(0)]),
      IRelease(1)], ret())]),
    lifted()]));
  const p3 = pos("indirect call with a reference result is Owned", prog([
    fn("f", 0, [lr("c"), lr("r")], MVoid, [bk([
      IClosure(0, 1, []), ICallIndirect(Some(1), OLocal(0), []), IRelease(1), IRelease(0)], ret())]),
    liftedRef()]));
  const p4 = pos("borrowed argument and borrowed callee", prog([
    fn("f", 2, [lr("c"), lr("p"), lr("b")], MVoid, [bk([
      IGetField(2, OLocal(1), 0), ICallIndirect(None, OLocal(0), [OLocal(2)])], ret())]),
    fn("l", 2, [lr("env"), lr("y")], MVoid, [bk([], TReturn(None))])]));
  const p5 = pos("closure returned to the caller", prog([
    fn("f", 0, [lr("c")], MRef, [bk([IClosure(0, 1, [])], TReturn(Some(OLocal(0))))]),
    lifted()]));
  const w1 = run("warn closure never released", prog([
    fn("f", 0, [lr("c")], MVoid, [bk([IClosure(0, 1, [])], ret())]),
    lifted()]), 2, "");
  const n1 = neg("capture used after IClosure consumed it", prog([
    fn("f", 0, [lr("a"), lr("c"), li("i")], MVoid, [bk([
      IStructNew(0, 0, []), IClosure(1, 1, [OLocal(0)]), ITag(2, OLocal(0)), IRelease(1)], ret())]),
    lifted()]), dead);
  const n2 = neg("capture of a Borrowed local", prog([
    fn("f", 1, [lr("p"), lr("b"), lr("c")], MVoid, [bk([
      IGetField(1, OLocal(0), 0), IClosure(2, 1, [OLocal(1)])], ret())]),
    lifted()]), "borrowed");
  const n3 = neg("indirect call of a released closure", prog([
    fn("f", 0, [lr("c")], MVoid, [bk([IClosure(0, 1, []), IRelease(0), ICallIndirect(None, OLocal(0), [OInt(1)])], ret())]),
    lifted()]), dead);
  const n4 = neg("indirect call with a dead argument", prog([
    fn("f", 0, [lr("c"), lr("a")], MVoid, [bk([
      IClosure(0, 1, []), ICallIndirect(None, OLocal(0), [OLocal(1)]), IRelease(0)], ret())]),
    fn("l", 2, [lr("env"), lr("y")], MVoid, [bk([], TReturn(None))])]), dead);
  const n5 = neg("lifted function with an owned parameter", prog([
    fn("f", 0, [lr("c")], MVoid, [bk([IClosure(0, 1, []), IRelease(0)], ret())]),
    fnO("l", [true, false], [lr("env"), li("x")], MVoid, [bk([IRelease(0)], TReturn(None))])]), "borrowed parameters");
  const n6 = neg("closure function index out of range", straight(0, [lr("c")], [IClosure(0, 9, [])]), "out of range");
  const n7 = neg("lifted function without an environment parameter", prog([
    fn("f", 0, [lr("c")], MVoid, [bk([IClosure(0, 1, []), IRelease(0)], ret())]),
    fn("l", 1, [li("x")], MVoid, [bk([], TReturn(None))])]), "environment");
  const n8 = neg("callee is not a reference", straight(0, [li("c")], [ICopy(0, OInt(1)), ICallIndirect(None, OLocal(0), [])]), "callee");
  const n9 = neg("closure released twice", prog([
    fn("f", 0, [lr("c")], MVoid, [bk([IClosure(0, 1, []), IRelease(0), IRelease(0)], ret())]),
    lifted()]), dead);
  const n10 = neg("Unique argument demoted by an indirect call with a reference result", prog([
    fn("f", 0, [lr("c"), lr("a"), lr("r")], MVoid, [bk([
      IClosure(0, 1, []), IStructNew(1, 0, [OInt(1)]), ICallIndirect(Some(2), OLocal(0), [OLocal(1)]),
      ISetField(1, 0, OInt(2)), IRelease(1), IRelease(2), IRelease(0)], ret())]),
    fn("lr", 2, [lr("env"), lr("y")], MRef, [bk([IDup(2, OLocal(1))], TReturn(Some(OLocal(2))))])]), "Unique");
  const n11 = neg("owned capture of a Param", prog([
    fn("f", 1, [lr("p"), lr("c")], MVoid, [bk([IClosure(1, 1, [OLocal(0)])], ret())]),
    lifted()]), "parameter");
  if (!p1) { bad += 1; } if (!p2) { bad += 1; } if (!p3) { bad += 1; } if (!p4) { bad += 1; }
  if (!p5) { bad += 1; } if (!w1) { bad += 1; }
  if (!n1) { bad += 1; } if (!n2) { bad += 1; } if (!n3) { bad += 1; } if (!n4) { bad += 1; }
  if (!n5) { bad += 1; } if (!n6) { bad += 1; } if (!n7) { bad += 1; } if (!n8) { bad += 1; }
  if (!n9) { bad += 1; } if (!n10) { bad += 1; } if (!n11) { bad += 1; }
  return bad;
}

// ---------------------------------------------------------------- interfaces (v1.5, ADR-0019)

function progVt(fs: MFunction[], vts: MVTable[]): MProgram {
  return MProgram { functions: fs, strings: ["s"], main: 0, vtables: vts, inlineFns: [] };
}

// Method `m(this: ref, x: int): int` implementing an interface method (all parameters borrowed).
function method(): MFunction {
  return fn("C.m", 2, [lr("this"), li("x")], MInt, [bk([], TReturn(Some(OInt(1))))]);
}

function vt(fs: usize[]): MVTable {
  return MVTable { name: "C as I", funcs: fs };
}

function ifaceCases(): usize {
  let bad: usize = 0;
  const dead = "dead";
  const p1 = pos("interface value built, called and released", progVt([
    fn("f", 0, [lr("a"), lr("v"), li("r")], MVoid, [bk([
      IStructNew(0, 0, []), IIface(1, 0, OLocal(0)), ICallVirtual(Some(2), OLocal(1), 0, [OInt(5)]), IRelease(1)], ret())]),
    method()], [vt([1])]));
  const p2 = pos("interface value returned to the caller", progVt([
    fn("f", 0, [lr("a"), lr("v")], MRef, [bk([
      IStructNew(0, 0, []), IIface(1, 0, OLocal(0))], TReturn(Some(OLocal(1))))]),
    method()], [vt([1])]));
  const p3 = pos("borrowed receiver and argument", progVt([
    fn("f", 2, [lr("v"), li("n"), li("r")], MVoid, [bk([
      ICallVirtual(Some(2), OLocal(0), 0, [OLocal(1)])], ret())]),
    method()], [vt([1])]));
  const p4 = pos("string constant boxed", progVt([
    fn("f", 0, [lr("v")], MRef, [bk([IIface(0, 0, OStr(0))], TReturn(Some(OLocal(0))))]),
    method()], [vt([1])]));
  const n1 = neg("boxed value used after IIface consumed it", progVt([
    fn("f", 0, [lr("a"), lr("v"), li("i")], MVoid, [bk([
      IStructNew(0, 0, []), IIface(1, 0, OLocal(0)), ITag(2, OLocal(0)), IRelease(1)], ret())]),
    method()], [vt([1])]), dead);
  const n2 = neg("boxing a Borrowed local", progVt([
    fn("f", 1, [lr("p"), lr("b"), lr("v")], MVoid, [bk([
      IGetField(1, OLocal(0), 0), IIface(2, 0, OLocal(1))], ret())]),
    method()], [vt([1])]), "borrowed");
  const n3 = neg("virtual call of a released interface value", progVt([
    fn("f", 0, [lr("a"), lr("v")], MVoid, [bk([
      IStructNew(0, 0, []), IIface(1, 0, OLocal(0)), IRelease(1), ICallVirtual(None, OLocal(1), 0, [OInt(1)])], ret())]),
    method()], [vt([1])]), dead);
  const n4 = neg("vtable index out of range", progVt([
    fn("f", 0, [lr("a"), lr("v")], MVoid, [bk([IStructNew(0, 0, []), IIface(1, 3, OLocal(0))], ret())]),
    method()], [vt([1])]), "vtable index");
  const n5 = neg("vtable entry with an owned parameter", progVt([
    fn("f", 0, [lr("a"), lr("v")], MVoid, [bk([IStructNew(0, 0, []), IIface(1, 0, OLocal(0)), IRelease(1)], ret())]),
    fnO("C.m", [true, false], [lr("this"), li("x")], MInt, [bk([IRelease(0)], TReturn(Some(OInt(1))))])],
    [vt([1])]), "borrowed parameters");
  const n6 = neg("vtable entry out of range", progVt([
    fn("f", 0, [lr("a")], MVoid, [bk([], ret())]),
    method()], [vt([7])]), "out of range");
  const n7 = neg("vtable entry without a reference receiver", progVt([
    fn("f", 0, [lr("a")], MVoid, [bk([], ret())]),
    fn("C.m", 1, [li("x")], MInt, [bk([], TReturn(Some(OInt(1))))])], [vt([1])]), "first parameter");
  const n8 = neg("virtual callee is not a reference", straight(0, [li("c")], [ICopy(0, OInt(1)), ICallVirtual(None, OLocal(0), 0, [])]), "interface value");
  const n9 = neg("Unique argument demoted by a virtual call with a reference result", progVt([
    fn("f", 0, [lr("a"), lr("v"), lr("x"), lr("r")], MVoid, [bk([
      IStructNew(0, 0, []), IIface(1, 0, OLocal(0)), IStructNew(2, 0, [OInt(1)]), ICallVirtual(Some(3), OLocal(1), 0, [OLocal(2)]),
      ISetField(2, 0, OInt(2)), IRelease(2), IRelease(3), IRelease(1)], ret())]),
    fn("C.m", 2, [lr("this"), lr("y")], MRef, [bk([IDup(2, OLocal(1))], TReturn(Some(OLocal(2))))])], [vt([1])]), "Unique");
  if (!p1) { bad += 1; } if (!p2) { bad += 1; } if (!p3) { bad += 1; } if (!p4) { bad += 1; }
  if (!n1) { bad += 1; } if (!n2) { bad += 1; } if (!n3) { bad += 1; } if (!n4) { bad += 1; }
  if (!n5) { bad += 1; } if (!n6) { bad += 1; } if (!n7) { bad += 1; } if (!n8) { bad += 1; }
  if (!n9) { bad += 1; }
  return bad;
}

// ---------------------------------------------------------------- resource handles (v1.8, ADR-0025; grants v1.9, ADR-0027)

// In v1.9 `BFileOpen` takes the file grant as its first argument. The file cases below are written without it:
// `opn` marks the authority with the operand `OInt(-1)` and `withAuth` gives every function that opens a file a
// leading handle parameter `auth` (a borrowed grant), shifting every local index by one.
function so(o: Operand): Operand {
  return match (o) { OLocal(l) => OLocal(l + 1), _ => o };
}

function sos(os: Operand[]): Operand[] {
  let out: Operand[] = [];
  for (const o of os) {
    out.push(so(o));
  }
  return out;
}

function sd(d: Option<usize>): Option<usize> {
  return match (d) { Some(x) => Some(x + 1), None => None };
}

function sInstr(i: Instr): Instr {
  return match (i) {
    ICopy(d, o) => ICopy(d + 1, so(o)),
    IMove(d, x) => IMove(d + 1, x + 1),
    IBorrow(d, x) => IBorrow(d + 1, x + 1),
    IDup(d, o) => IDup(d + 1, so(o)),
    IRelease(x) => IRelease(x + 1),
    IUnary(d, op, o) => IUnary(d + 1, op, so(o)),
    IBinary(d, op, a, b) => IBinary(d + 1, op, so(a), so(b)),
    ICall(d, f, args) => ICall(sd(d), f, sos(args)),
    IBuiltin(d, b, args) => match (b) {
      BFileOpen => IBuiltin(sd(d), b, [OLocal(0)].concat(sos(args.slice(1, args.length)))),
      _ => IBuiltin(sd(d), b, sos(args))
    },
    IStrAppend(x, o) => IStrAppend(x + 1, so(o)),
    IStrPrepend(x, o) => IStrPrepend(x + 1, so(o)),
    IStrAppendNum(x, o, u) => IStrAppendNum(x + 1, so(o), u),
    IStrAppendSub(x, o, a, b) => IStrAppendSub(x + 1, so(o), so(a), so(b)),
    IArrayExtend(x, o) => IArrayExtend(x + 1, so(o)),
    IStructNew(d, tag, slots) => IStructNew(d + 1, tag, sos(slots)),
    INullary(d, tag) => INullary(d + 1, tag),
    ITag(d, o) => ITag(d + 1, so(o)),
    IGetField(d, o, k) => IGetField(d + 1, so(o), k),
    IShapeCheck(x, k) => IShapeCheck(x + 1, k),
    IGetFieldU(d, o, k) => IGetFieldU(d + 1, so(o), k),
    ISetField(x, k, o) => ISetField(x + 1, k, so(o)),
    ISetFieldU(x, k, o) => ISetFieldU(x + 1, k, so(o)),
    ITakeField(d, x, k) => ITakeField(d + 1, x + 1, k),
    IPutField(x, k, y) => IPutField(x + 1, k, y + 1),
    IMakeUnique(x) => IMakeUnique(x + 1),
    IArrayNew(d, r, os) => IArrayNew(d + 1, r, sos(os)),
    IArrayGet(d, a, k) => IArrayGet(d + 1, so(a), so(k)),
    IArraySet(x, k, o) => IArraySet(x + 1, so(k), so(o)),
    IArrayGetU(d, a, k) => IArrayGetU(d + 1, so(a), so(k)),
    IArraySetU(x, k, o) => IArraySetU(x + 1, so(k), so(o)),
    IArrayTake(d, x, k) => IArrayTake(d + 1, x + 1, so(k)),
    IArrayPut(x, k, y) => IArrayPut(x + 1, so(k), y + 1),
    IArrayPush(x, o) => IArrayPush(x + 1, so(o)),
    IArrayPop(d, x) => IArrayPop(d + 1, x + 1),
    IForward(d, x, o, k) => IForward(d + 1, x + 1, so(o), so(k)),
    IClosure(d, f, caps) => IClosure(d + 1, f, sos(caps)),
    ICallIndirect(d, c, args) => ICallIndirect(sd(d), so(c), sos(args)),
    IIface(d, v, o) => IIface(d + 1, v, so(o)),
    ICallVirtual(d, r, slot, args) => ICallVirtual(sd(d), so(r), slot, sos(args))
  };
}

function sTerm(t0: Terminator): Terminator {
  return match (t0) {
    TGoto(b) => TGoto(b),
    TBranch(o, a, b) => TBranch(so(o), a, b),
    TSwitch(o, cs, d) => TSwitch(so(o), cs, d),
    TReturn(r) => TReturn(match (r) { Some(o) => Some(so(o)), None => None }),
    TTrap(m) => TTrap(m)
  };
}

function opensFile(f: MFunction): bool {
  for (const b of f.blocks) {
    for (const i of b.instrs) {
      const o = match (i) { IBuiltin(_, bi, _) => match (bi) { BFileOpen => true, _ => false }, _ => false };
      if (o) {
        return true;
      }
    }
  }
  return false;
}

function withAuth(p0: MProgram): MProgram {
  let fs: MFunction[] = [];
  for (const f of p0.functions) {
    if (!opensFile(f)) {
      fs.push(f);
      continue;
    }
    let blocks: MBlock[] = [];
    for (const b of f.blocks) {
      let is: Instr[] = [];
      for (const i of b.instrs) {
        is.push(sInstr(i));
      }
      blocks.push(plainBlock(is, sTerm(b.term)));
    }
    fs.push(MFunction {
      name: f.name, paramCount: f.paramCount + 1, paramOwned: [false].concat(f.paramOwned), inout: false, uniqueIn: false, uniqueOut: false,
      locals: [lh("auth")].concat(f.locals), ret: f.ret, blocks: blocks
    });
  }
  return MProgram { functions: fs, strings: p0.strings, main: p0.main, vtables: p0.vtables, inlineFns: p0.inlineFns };
}

function hpos(name: string, p0: MProgram): bool { return pos(name, withAuth(p0)); }
function hneg(name: string, p0: MProgram, needle: string): bool { return neg(name, withAuth(p0), needle); }

function opn(h: usize): Instr { return IBuiltin(Some(h), BFileOpen, [OInt(-1), OStr(0), OInt(0)]); }

function cls(h: usize, r: usize): Instr { return IBuiltin(Some(r), BFileClose, [OLocal(h)]); }
function rdl(h: usize, r: usize): Instr { return IBuiltin(Some(r), BFileReadLine, [OLocal(h)]); }

function handleCases(): usize {
  let bad: usize = 0;
  const dead = "dead";
  const p1 = hpos("open, read, close", straight(0, [lh("h"), lr("l"), lr("e")], [
    opn(0), rdl(0, 1), IRelease(1), cls(0, 2), IRelease(2)]));
  const p2 = hpos("handle parameter passed to a call and a builtin (borrowed)", prog([
    fn("f", 1, [lh("h"), lr("l"), li("i")], MVoid, [bk([ICall(None, 1, [OLocal(0)]), rdl(0, 1), IRelease(1)], ret())]),
    fn("g", 1, [lh("h")], MVoid, [bk([], ret())])]));
  const p3 = hpos("scope shape: open, indirect call with the handle, close", prog([
    fn("f", 0, [lh("h"), lr("c"), lr("e")], MVoid, [bk([
      IClosure(1, 1, []), opn(0), ICallIndirect(None, OLocal(1), [OLocal(0)]), cls(0, 2), IRelease(2), IRelease(1)], ret())]),
    fn("l", 2, [lr("env"), lh("h")], MVoid, [bk([], ret())])]));
  const p4 = hpos("closed on both branches", prog([
    fn("f", 1, [lb("c"), lh("h"), lr("e")], MVoid, [
      bk([opn(1)], TBranch(OLocal(0), 1, 2)),
      bk([cls(1, 2), IRelease(2)], ret()),
      bk([cls(1, 2), IRelease(2)], ret())])]));
  const p5 = hpos("two handles open at the same time", straight(0, [lh("a"), lh("b"), lr("e1"), lr("e2")], [
    opn(0), opn(1), cls(1, 2), IRelease(2), cls(0, 3), IRelease(3)]));
  const p6 = hpos("trap with an open handle (the exit hook closes it)", prog([
    fn("f", 0, [lh("h")], MVoid, [bk([opn(0)], TTrap("boom"))])]));
  const p7 = hpos("a handle can be reopened after it was closed", straight(0, [lh("h"), lr("e")], [
    opn(0), cls(0, 1), IRelease(1), opn(0), cls(0, 1), IRelease(1)]));
  const n1 = hneg("handle never closed", straight(0, [lh("h")], [opn(0)]), "not closed");
  const n2 = hneg("handle closed on one branch only", prog([
    fn("f", 1, [lb("c"), lh("h"), lr("e")], MVoid, [
      bk([opn(1)], TBranch(OLocal(0), 1, 2)),
      bk([cls(1, 2), IRelease(2)], TGoto(3)),
      bk([], TGoto(3)),
      bk([], ret())])]), "not closed");
  const n3 = hneg("use after close", straight(0, [lh("h"), lr("e"), lr("l")], [
    opn(0), cls(0, 1), IRelease(1), rdl(0, 2), IRelease(2)]), dead);
  const n4 = hneg("double close", straight(0, [lh("h"), lr("e"), lr("f")], [
    opn(0), cls(0, 1), IRelease(1), cls(0, 2), IRelease(2)]), "not open");
  const n5 = hneg("close of a handle parameter", prog([
    fn("f", 1, [lh("h"), lr("e")], MVoid, [bk([cls(0, 1), IRelease(1)], ret())])]), "parameter");
  const n6 = hneg("copy of a handle", straight(0, [lh("a"), lh("b"), lr("e")], [
    opn(0), ICopy(1, OLocal(0)), cls(0, 2), IRelease(2)]), "ICopy");
  const n7 = hneg("function returning a handle", prog([
    fn("f", 0, [lh("h")], MHandle, [bk([opn(0)], TReturn(Some(OLocal(0))))])]), "returns a resource handle");
  const n8 = hneg("handle stored in a struct", straight(0, [lh("h"), lr("s"), lr("e")], [
    opn(0), IStructNew(1, 0, [OLocal(0)]), IRelease(1), cls(0, 2), IRelease(2)]), "cannot be stored");
  const n9 = hneg("handle captured by a closure", prog([
    fn("f", 0, [lh("h"), lr("c"), lr("e")], MVoid, [bk([opn(0), IClosure(1, 1, [OLocal(0)]), IRelease(1), cls(0, 2), IRelease(2)], ret())]),
    lifted()]), "cannot be captured");
  const n10 = hneg("handles compared", straight(0, [lh("a"), lh("b"), lb("c"), lr("e")], [
    opn(0), opn(1), IBinary(2, OpEq, OLocal(0), OLocal(1)), cls(0, 3), IRelease(3), cls(1, 3), IRelease(3)]), "IBinary");
  const n11 = hneg("handle read from a field", straight(1, [lr("p"), lh("h")], [IGetField(1, OLocal(0), 0)]), "only by BFileOpen");
  const n12 = hneg("handle passed to a non-file builtin", straight(0, [lh("h"), lu("n"), lr("e")], [
    opn(0), IBuiltin(Some(1), BStrLength, [OLocal(0)]), cls(0, 2), IRelease(2)]), "only be passed");
  const n13 = hneg("handle in an array", straight(0, [lh("h"), lr("a"), lr("e")], [
    opn(0), IArrayNew(1, false, [OLocal(0)]), IRelease(1), cls(0, 2), IRelease(2)]), "IArrayNew");
  const n14 = hneg("handle overwritten while open", straight(0, [lh("h"), lr("e")], [
    opn(0), opn(0), cls(0, 1), IRelease(1)]), "overwritten");
  const n15 = hneg("handle pushed into an array", straight(0, [lh("h"), lr("a"), lr("e")], [
    opn(0), IArrayNew(1, false, []), IArrayPush(1, OLocal(0)), IRelease(1), cls(0, 2), IRelease(2)]), "IArrayPush");
  const n16 = hneg("open without a destination", straight(0, [], [IBuiltin(None, BFileOpen, [OInt(-1), OStr(0), OInt(0)])]), "bound to a local");
  const n17 = hneg("handle parameter reopened", prog([
    fn("f", 1, [lh("h"), lr("e")], MVoid, [bk([opn(0)], ret())])]), "parameter");
  const n18 = hneg("handle moved", straight(0, [lh("a"), lh("b"), lr("e")], [
    opn(0), IMove(1, 0)]), "IMove");
  const n19 = hneg("closed after a join where it is open on one path", prog([
    fn("f", 1, [lb("c"), lh("h"), lr("e")], MVoid, [
      bk([opn(1)], TBranch(OLocal(0), 1, 2)),
      bk([cls(1, 2), IRelease(2)], TGoto(3)),
      bk([], TGoto(3)),
      bk([cls(1, 2), IRelease(2)], ret())])]), "some incoming paths");
  const n20 = hneg("handle result of a call", prog([
    fn("f", 0, [lh("h")], MVoid, [bk([ICall(Some(0), 1, [])], ret())]),
    fn("g", 0, [li("x")], MInt, [bk([], TReturn(Some(OInt(1))))])]), "ICall");
  const n21 = hneg("handle passed to a call that expects a reference", prog([
    fn("f", 0, [lh("h"), lr("e")], MVoid, [bk([opn(0), ICall(None, 1, [OLocal(0)]), cls(0, 1), IRelease(1)], ret())]),
    gVoid()]), "wrong class");
  const n22 = hneg("handle returned from an int function", prog([
    fn("f", 0, [lh("h"), lr("e")], MInt, [bk([opn(0), cls(0, 1), IRelease(1)], TReturn(Some(OLocal(0))))])]), "TReturn");
  const n23 = hneg("handle used as a branch condition", prog([
    fn("f", 0, [lh("h"), lr("e")], MVoid, [bk([opn(0)], TBranch(OLocal(0), 1, 1)), bk([cls(0, 1), IRelease(1)], ret())])]), "TBranch");
  const n24 = hneg("file builtin without a handle first argument", straight(0, [lr("l")], [
    IBuiltin(Some(0), BFileReadLine, [OStr(0)])]), "first argument");
  if (!p1) { bad += 1; } if (!p2) { bad += 1; } if (!p3) { bad += 1; } if (!p4) { bad += 1; }
  if (!p5) { bad += 1; } if (!p6) { bad += 1; } if (!p7) { bad += 1; }
  if (!n1) { bad += 1; } if (!n2) { bad += 1; } if (!n3) { bad += 1; } if (!n4) { bad += 1; }
  if (!n5) { bad += 1; } if (!n6) { bad += 1; } if (!n7) { bad += 1; } if (!n8) { bad += 1; }
  if (!n9) { bad += 1; } if (!n10) { bad += 1; } if (!n11) { bad += 1; } if (!n12) { bad += 1; }
  if (!n13) { bad += 1; } if (!n14) { bad += 1; } if (!n15) { bad += 1; } if (!n16) { bad += 1; }
  if (!n17) { bad += 1; } if (!n18) { bad += 1; } if (!n19) { bad += 1; } if (!n20) { bad += 1; }
  if (!n21) { bad += 1; } if (!n22) { bad += 1; } if (!n23) { bad += 1; } if (!n24) { bad += 1; }
  return bad;
}


// ---------------------------------------------------------------- capability grants (v1.9, ADR-0027)
// A grant is a handle: the same lifecycle (opener -> use -> closer) and the same structural rules as a file. Locals:
// `host` is the Host parameter (local 0, borrowed for the whole call).

function gfs(d: usize): Instr { return IBuiltin(Some(d), BGrantFs, [OLocal(0)]); }
function gclk(d: usize): Instr { return IBuiltin(Some(d), BGrantClock, [OLocal(0)]); }
function gunder(d: usize, parent: usize): Instr { return IBuiltin(Some(d), BGrantUnder, [OLocal(parent), OStr(0)]); }
function gro(d: usize, parent: usize): Instr { return IBuiltin(Some(d), BGrantReadOnly, [OLocal(parent)]); }
function grev(g: usize): Instr { return IBuiltin(None, BGrantRevoke, [OLocal(g)]); }
function gread(g: usize, d: usize): Instr { return IBuiltin(Some(d), BFsReadFile, [OLocal(g), OStr(0)]); }

function grantCases(): usize {
  let bad: usize = 0;
  const p1 = pos("acquire, use, revoke", straight(1, [lh("host"), lh("fs"), lr("r")], [
    gfs(1), gread(1, 2), IRelease(2), grev(1)]));
  const p2 = pos("narrowing chain, revoked innermost first", straight(1, [lh("host"), lh("fs"), lh("sub"), lh("ro"), lr("r")], [
    gfs(1), gunder(2, 1), gro(3, 2), gread(3, 4), IRelease(4), grev(3), grev(2), grev(1)]));
  const p3 = pos("a file opened with the grant, the grant revoked after the file is closed", straight(1, [lh("host"), lh("fs"), lh("f"), lr("e")], [
    gfs(1), IBuiltin(Some(2), BFileOpen, [OLocal(1), OStr(0), OInt(0)]), IBuiltin(Some(3), BFileClose, [OLocal(2)]), IRelease(3), grev(1)]));
  const p4 = pos("grants are borrowed parameters of other functions", prog([
    fn("f", 1, [lh("host"), lh("fs")], MVoid, [bk([gfs(1), ICall(None, 1, [OLocal(1)]), grev(1)], ret())]),
    fn("g", 1, [lh("fs"), lr("r")], MVoid, [bk([gread(0, 1), IRelease(1)], ret())])]));
  const p5 = pos("two grants of different families at once", straight(1, [lh("host"), lh("fs"), lh("clock"), li("t")], [
    gfs(1), gclk(2), IBuiltin(Some(3), BTimeNowMillis, [OLocal(2)]), grev(2), grev(1)]));
  const pMono = pos("monotonic read consumes no clock grant", straight(1, [lh("host"), lh("clock"), lr("r")], [
    gclk(1), IBuiltin(Some(2), BTimeMonotonicMillis, [OLocal(1)]), IRelease(2), grev(1)]));
  const nMono = neg("monotonic read after clock revoke", straight(1, [lh("host"), lh("clock"), lr("r")], [
    gclk(1), grev(1), IBuiltin(Some(2), BTimeMonotonicMillis, [OLocal(1)]), IRelease(2)]), "dead");
  const n1 = neg("grant never revoked", straight(1, [lh("host"), lh("fs")], [gfs(1)]), "not closed");
  const n2 = neg("grant revoked twice", straight(1, [lh("host"), lh("fs")], [gfs(1), grev(1), grev(1)]), "not open");
  const n3 = neg("use after revoke", straight(1, [lh("host"), lh("fs"), lr("r")], [gfs(1), grev(1), gread(1, 2), IRelease(2)]), "dead");
  const n4 = neg("derived from a revoked parent", straight(1, [lh("host"), lh("fs"), lh("sub")], [gfs(1), grev(1), gunder(2, 1), grev(2)]), "dead");
  const n5 = neg("grant duplicated", straight(1, [lh("host"), lh("fs"), lh("copy")], [gfs(1), ICopy(2, OLocal(1)), grev(1)]), "ICopy");
  const n6 = neg("grant moved", straight(1, [lh("host"), lh("fs"), lh("copy")], [gfs(1), IMove(2, 1)]), "IMove");
  const n7 = neg("grant stored in a struct", straight(1, [lh("host"), lh("fs"), lr("s")], [
    gfs(1), IStructNew(2, 0, [OLocal(1)]), IRelease(2), grev(1)]), "cannot be stored");
  const n8 = neg("grant returned", prog([
    fn("f", 1, [lh("host"), lh("fs")], MHandle, [bk([gfs(1)], TReturn(Some(OLocal(1))))])]), "returns a resource handle");
  const n9 = neg("grant captured by a closure", prog([
    fn("f", 1, [lh("host"), lh("fs"), lr("c")], MVoid, [bk([gfs(1), IClosure(2, 1, [OLocal(1)]), IRelease(2), grev(1)], ret())]),
    lifted()]), "cannot be captured");
  const n10 = neg("grant is the result of a call (forged)", prog([
    fn("f", 1, [lh("host"), lh("fs")], MVoid, [bk([ICall(Some(1), 1, [])], ret())]),
    fn("g", 0, [li("x")], MInt, [bk([], TReturn(Some(OInt(1))))])]), "ICall");
  const n11 = neg("grant read from a field (forged)", straight(1, [lr("p"), lh("fs")], [IGetField(1, OLocal(0), 0)]), "only by BFileOpen");
  const n12 = neg("grant defined by a copy of a constant (forged)", straight(0, [lh("fs")], [ICopy(0, OInt(7))]), "ICopy");
  const n13 = neg("opener without an authorising handle", straight(0, [lh("fs")], [IBuiltin(Some(0), BGrantFs, [OInt(1)])]), "authorising");
  const n14 = neg("opener with a non-handle destination", straight(1, [lh("host"), li("n")], [IBuiltin(Some(1), BGrantFs, [OLocal(0)])]), "destination");
  const n15 = neg("opener without a destination", straight(1, [lh("host")], [IBuiltin(None, BGrantFs, [OLocal(0)])]), "bound to a local");
  const n16 = neg("std I/O builtin without a grant", straight(0, [lr("r")], [IBuiltin(Some(0), BFsReadFile, [OStr(0), OStr(0)])]), "first argument");
  const n17 = neg("grant compared", straight(1, [lh("host"), lh("a"), lh("b"), lb("c")], [
    gfs(1), gfs(2), IBinary(3, OpEq, OLocal(1), OLocal(2)), grev(2), grev(1)]), "IBinary");
  const n18 = neg("grant passed to a non-grant builtin", straight(1, [lh("host"), lh("fs"), lu("n")], [
    gfs(1), IBuiltin(Some(2), BStrLength, [OLocal(1)]), grev(1)]), "only be passed");
  const n19 = neg("revoke of a parameter (only the scope that derived it revokes)", prog([
    fn("f", 1, [lh("fs")], MVoid, [bk([grev(0)], ret())])]), "parameter");
  const n20 = neg("grant overwritten while live", straight(1, [lh("host"), lh("fs")], [gfs(1), gfs(1), grev(1)]), "overwritten");
  const n21 = neg("grant revoked on one branch only", prog([
    fn("f", 1, [lh("host"), lb("c"), lh("fs")], MVoid, [
      bk([gfs(2)], TBranch(OLocal(1), 1, 2)),
      bk([grev(2)], TGoto(3)),
      bk([], TGoto(3)),
      bk([], ret())])]), "not closed");
  const n22 = neg("grant in an array", straight(1, [lh("host"), lh("fs"), lr("a")], [
    gfs(1), IArrayNew(2, false, [OLocal(1)]), IRelease(2), grev(1)]), "IArrayNew");
  const n23 = neg("two grant arguments to a std I/O builtin", straight(1, [lh("host"), lh("fs"), lr("r")], [
    gfs(1), IBuiltin(Some(2), BFsExists, [OLocal(1), OLocal(1)]), grev(1)]), "only the first");
  if (!p1) { bad += 1; } if (!p2) { bad += 1; } if (!p3) { bad += 1; } if (!p4) { bad += 1; } if (!p5) { bad += 1; }
  if (!n1) { bad += 1; } if (!n2) { bad += 1; } if (!n3) { bad += 1; } if (!n4) { bad += 1; }
  if (!n5) { bad += 1; } if (!n6) { bad += 1; } if (!n7) { bad += 1; } if (!n8) { bad += 1; }
  if (!n9) { bad += 1; } if (!n10) { bad += 1; } if (!n11) { bad += 1; } if (!n12) { bad += 1; }
  if (!n13) { bad += 1; } if (!n14) { bad += 1; } if (!n15) { bad += 1; } if (!n16) { bad += 1; }
  if (!n17) { bad += 1; } if (!n18) { bad += 1; } if (!n19) { bad += 1; } if (!n20) { bad += 1; }
  if (!n21) { bad += 1; } if (!n22) { bad += 1; } if (!n23) { bad += 1; }
  return bad + cnt(pMono) + cnt(nMono);
}

// ---------------------------------------------------------------- grants moved into a task (ADR-0017, ADR-0027 Q10)
// grantClone (BTask 17) derives a handle from a parent (an opener), grantMove (BTask 18) ends it and returns a token (a closer: the
// handle is moved exactly once on every path), grantAdoptFs (BTask 19) makes a handle from a token (an opener with no authorising
// handle) that the adopting function must revoke. Locals: 0 = host (or the token), the rest as named.

function gclone(d: usize, parent: usize): Instr { return IBuiltin(Some(d), BTask(17), [OLocal(parent)]); }
function gmove(g: usize, tok: usize): Instr { return IBuiltin(Some(tok), BTask(18), [OLocal(g)]); }
function gadopt(d: usize, tok: usize): Instr { return IBuiltin(Some(d), BTask(19), [OLocal(tok)]); }

function taskGrantCases(): usize {
  let bad: usize = 0;
  const p1 = pos("clone, move: the derived handle is moved exactly once, the parent stays usable", straight(1, [lh("host"), lh("fs"), lh("c"), lu("tok"), lr("r")], [
    gfs(1), gclone(2, 1), gmove(2, 3), gread(1, 4), IRelease(4), grev(1)]));
  const p2 = pos("adopt in the task wrapper: use, revoke", prog([
    fn("f", 1, [lu("tok"), lh("g"), lr("r")], MVoid, [bk([gadopt(1, 0), gread(1, 2), IRelease(2), grev(1)], ret())])]));
  const p3 = pos("a derived handle may be narrowed before it is moved", straight(1, [lh("host"), lh("fs"), lh("c"), lh("ro"), lu("tok")], [
    gfs(1), gclone(2, 1), gro(3, 2), grev(3), gmove(2, 4), grev(1)]));
  const n1 = neg("derived handle never moved or revoked", straight(1, [lh("host"), lh("fs"), lh("c")], [gfs(1), gclone(2, 1), grev(1)]), "not closed");
  const n2 = neg("handle moved twice", straight(1, [lh("host"), lh("fs"), lh("c"), lu("t1"), lu("t2")], [
    gfs(1), gclone(2, 1), gmove(2, 3), gmove(2, 4), grev(1)]), "not open");
  const n3 = neg("handle used after it was moved into the task", straight(1, [lh("host"), lh("fs"), lh("c"), lu("tok"), lr("r")], [
    gfs(1), gclone(2, 1), gmove(2, 3), gread(2, 4), IRelease(4), grev(1)]), "dead");
  const n4 = neg("handle revoked after it was moved", straight(1, [lh("host"), lh("fs"), lh("c"), lu("tok")], [
    gfs(1), gclone(2, 1), gmove(2, 3), grev(2), grev(1)]), "not open");
  const n5 = neg("adopted handle never revoked", prog([
    fn("f", 1, [lu("tok"), lh("g")], MVoid, [bk([gadopt(1, 0)], ret())])]), "not closed");
  const n6 = neg("adopted handle revoked twice", prog([
    fn("f", 1, [lu("tok"), lh("g")], MVoid, [bk([gadopt(1, 0), grev(1), grev(1)], ret())])]), "not open");
  const n7 = neg("adopt with a handle argument (it takes a token)", prog([
    fn("f", 1, [lh("other"), lh("g")], MVoid, [bk([IBuiltin(Some(1), BTask(19), [OLocal(0)]), grev(1)], ret())])]), "token");
  const n8 = neg("move of a parameter (only the function that derived the handle moves it)", prog([
    fn("f", 1, [lh("g"), lu("tok")], MVoid, [bk([gmove(0, 1)], ret())])]), "parameter");
  const n9 = neg("clone without an authorising handle", straight(0, [lh("c")], [IBuiltin(Some(0), BTask(17), [OInt(1)])]), "authorising");
  const n10 = neg("adopt into a non-handle destination", prog([
    fn("f", 1, [lu("tok"), li("n")], MVoid, [bk([IBuiltin(Some(1), BTask(19), [OLocal(0)])], ret())])]), "destination");
  const n11 = neg("adopt without a destination", prog([
    fn("f", 1, [lu("tok")], MVoid, [bk([IBuiltin(None, BTask(19), [OLocal(0)])], ret())])]), "bound to a local");
  const n12 = neg("handle moved on one branch only", prog([
    fn("f", 1, [lh("host"), lb("c"), lh("fs"), lh("d"), lu("tok")], MVoid, [
      bk([gfs(2), gclone(3, 2)], TBranch(OLocal(1), 1, 2)),
      bk([gmove(3, 4)], TGoto(3)),
      bk([], TGoto(3)),
      bk([grev(2)], ret())])]), "closed");
  const n13 = neg("moved handle stored in a struct", straight(1, [lh("host"), lh("fs"), lh("c"), lr("s")], [
    gfs(1), gclone(2, 1), IStructNew(3, 0, [OLocal(2)]), IRelease(3), grev(1)]), "cannot be stored");
  const n14 = neg("a token (scalar) is not a handle: it cannot authorise a derived handle", prog([
    fn("f", 1, [lu("tok"), lh("c")], MVoid, [bk([IBuiltin(Some(1), BTask(17), [OLocal(0)])], ret())])]), "authorising");
  if (!p1) { bad += 1; } if (!p2) { bad += 1; } if (!p3) { bad += 1; }
  if (!n1) { bad += 1; } if (!n2) { bad += 1; } if (!n3) { bad += 1; } if (!n4) { bad += 1; }
  if (!n5) { bad += 1; } if (!n6) { bad += 1; } if (!n7) { bad += 1; } if (!n8) { bad += 1; }
  if (!n9) { bad += 1; } if (!n10) { bad += 1; } if (!n11) { bad += 1; } if (!n12) { bad += 1; }
  if (!n13) { bad += 1; } if (!n14) { bad += 1; }
  return bad;
}

// ---------------------------------------------------------------- network handles (v1.9, ADR-0033)
// NetGrant -> Listener (BNetListen) -> Stream (BNetAccept) / NetGrant -> Stream (BNetConnect): openers whose first argument is the
// authorising handle; BNetClose closes a Listener or a Stream, BGrantRevoke a grant. Locals: `host` is local 0.

function gnet(d: usize): Instr { return IBuiltin(Some(d), BGrantNet, [OLocal(0)]); }
function nlisten(d: usize, g: usize): Instr { return IBuiltin(Some(d), BNetListen, [OLocal(g), OStr(0), OInt(0), OInt(8), OInt(1)]); }
function naccept(d: usize, l: usize): Instr { return IBuiltin(Some(d), BNetAccept, [OLocal(l), OInt(100), OInt(1)]); }
function nconnect(d: usize, g: usize): Instr { return IBuiltin(Some(d), BNetConnect, [OLocal(g), OStr(0), OInt(80), OInt(100), OInt(1)]); }
function nclose(h: usize): Instr { return IBuiltin(None, BNetClose, [OLocal(h)]); }
function nrecv(h: usize, d: usize): Instr { return IBuiltin(Some(d), BNetRecv, [OLocal(h), OInt(16), OInt(100)]); }

function netCases(): usize {
  let bad: usize = 0;
  const p1 = pos("net grant, listener, accepted stream, receive, closed in reverse order", straight(1,
    [lh("host"), lh("net"), lh("ln"), lh("s"), lr("r")], [
      gnet(1), nlisten(2, 1), naccept(3, 2), nrecv(3, 4), IRelease(4), nclose(3), nclose(2), grev(1)]));
  const p2 = pos("a connected stream", straight(1, [lh("host"), lh("net"), lh("s")], [gnet(1), nconnect(2, 1), nclose(2), grev(1)]));
  const p3 = pos("a listener narrowed by a listen grant", straight(1, [lh("host"), lh("net"), lh("l"), lh("ln")], [
    gnet(1), IBuiltin(Some(2), BGrantListen, [OLocal(1), OStr(0), OInt(0)]), nlisten(3, 2), nclose(3), grev(2), grev(1)]));
  const n1 = neg("listener never closed", straight(1, [lh("host"), lh("net"), lh("ln")], [gnet(1), nlisten(2, 1), grev(1)]), "not closed");
  const n2 = neg("stream closed twice", straight(1, [lh("host"), lh("net"), lh("s")], [gnet(1), nconnect(2, 1), nclose(2), nclose(2), grev(1)]), "not open");
  const n3 = neg("receive after close", straight(1, [lh("host"), lh("net"), lh("s"), lr("r")], [
    gnet(1), nconnect(2, 1), nclose(2), nrecv(2, 3), IRelease(3), grev(1)]), "dead");
  const n4 = neg("stream accepted from a closed listener", straight(1, [lh("host"), lh("net"), lh("ln"), lh("s")], [
    gnet(1), nlisten(2, 1), nclose(2), naccept(3, 2), nclose(3), grev(1)]), "dead");
  const n5 = neg("stream duplicated", straight(1, [lh("host"), lh("net"), lh("s"), lh("copy")], [
    gnet(1), nconnect(2, 1), ICopy(3, OLocal(2)), nclose(2), grev(1)]), "ICopy");
  const n6 = neg("stream stored in a struct", straight(1, [lh("host"), lh("net"), lh("s"), lr("o")], [
    gnet(1), nconnect(2, 1), IStructNew(3, 0, [OLocal(2)]), IRelease(3), nclose(2), grev(1)]), "cannot be stored");
  const n7 = neg("stream returned", prog([
    fn("f", 1, [lh("host"), lh("net"), lh("s")], MHandle, [bk([gnet(1), nconnect(2, 1)], TReturn(Some(OLocal(2))))])]), "returns a resource handle");
  const n8 = neg("stream captured by a closure", prog([
    fn("f", 1, [lh("host"), lh("net"), lh("s"), lr("c")], MVoid, [bk([gnet(1), nconnect(2, 1), IClosure(3, 1, [OLocal(2)]), IRelease(3), nclose(2), grev(1)], ret())]),
    lifted()]), "cannot be captured");
  const n9 = neg("stream is the result of a call (forged)", prog([
    fn("f", 1, [lh("host"), lh("s")], MVoid, [bk([ICall(Some(1), 1, [])], ret())]),
    fn("g", 0, [li("x")], MInt, [bk([], TReturn(Some(OInt(1))))])]), "ICall");
  const n10 = neg("receive without a handle first argument", straight(0, [lr("r")], [
    IBuiltin(Some(0), BNetRecv, [OInt(5), OInt(16), OInt(100)])]), "first argument");
  const n11 = neg("opener (listen) without an authorising handle", straight(0, [lh("ln")], [
    IBuiltin(Some(0), BNetListen, [OInt(1), OStr(0), OInt(0), OInt(8), OInt(1)])]), "authorising");
  const n12 = neg("two handles to a send", straight(1, [lh("host"), lh("net"), lh("s"), lr("r")], [
    gnet(1), nconnect(2, 1), IBuiltin(Some(3), BNetShutdown, [OLocal(2), OLocal(1)]), nclose(2), grev(1)]), "only the first");
  const n13 = neg("stream closed on one branch only", prog([
    fn("f", 1, [lh("host"), lb("c"), lh("net"), lh("s")], MVoid, [
      bk([gnet(2), nconnect(3, 2)], TBranch(OLocal(1), 1, 2)),
      bk([nclose(3)], TGoto(3)),
      bk([], TGoto(3)),
      bk([grev(2)], ret())])]), "not closed");
  if (!p1) { bad += 1; } if (!p2) { bad += 1; } if (!p3) { bad += 1; }
  if (!n1) { bad += 1; } if (!n2) { bad += 1; } if (!n3) { bad += 1; } if (!n4) { bad += 1; }
  if (!n5) { bad += 1; } if (!n6) { bad += 1; } if (!n7) { bad += 1; } if (!n8) { bad += 1; }
  if (!n9) { bad += 1; } if (!n10) { bad += 1; } if (!n11) { bad += 1; } if (!n12) { bad += 1; }
  if (!n13) { bad += 1; }
  return bad;
}

// ---------------------------------------------------------------- network handles moved into a task (ADR-0017 Addendum C)
// A Stream (BNetAccept / BNetConnect) or a cloned NetGrant is moved out with grantMove (BTask 18; a closer, the token is a scalar);
// the task adopts a Stream with grantAdoptStream (BTask 30) or a NetGrant with grantAdoptNet (BTask 29) and must close / revoke it
// exactly once. The verifier rules are the generic handle rules; these cases pin them for the network kinds.

function gadoptStream(d: usize, tok: usize): Instr { return IBuiltin(Some(d), BTask(30), [OLocal(tok)]); }
function gadoptNet(d: usize, tok: usize): Instr { return IBuiltin(Some(d), BTask(29), [OLocal(tok)]); }

function netMoveCases(): usize {
  let bad: usize = 0;
  const p1 = pos("an accepted stream is moved into a task; the listener stays usable", straight(1,
    [lh("host"), lh("net"), lh("ln"), lh("s"), lu("tok"), lh("s2")], [
      gnet(1), nlisten(2, 1), naccept(3, 2), gmove(3, 4), naccept(5, 2), nclose(5), nclose(2), grev(1)]));
  const p2 = pos("the task adopts the stream, uses it and closes it", prog([
    fn("f", 1, [lu("tok"), lh("s"), lr("r")], MVoid, [bk([gadoptStream(1, 0), nrecv(1, 2), IRelease(2), nclose(1)], ret())])]));
  const p3 = pos("a cloned NetGrant is moved; the original is revoked by its owner", straight(1,
    [lh("host"), lh("net"), lh("c"), lu("tok")], [gnet(1), gclone(2, 1), gmove(2, 3), grev(1)]));
  const p4 = pos("the task adopts a NetGrant, connects through it, revokes it", prog([
    fn("f", 1, [lu("tok"), lh("g"), lh("s")], MVoid, [bk([gadoptNet(1, 0), nconnect(2, 1), nclose(2), grev(1)], ret())])]));
  const n1 = neg("stream moved twice", straight(1, [lh("host"), lh("net"), lh("ln"), lh("s"), lu("t1"), lu("t2")], [
    gnet(1), nlisten(2, 1), naccept(3, 2), gmove(3, 4), gmove(3, 5), nclose(2), grev(1)]), "not open");
  const n2 = neg("stream used after it was moved", straight(1, [lh("host"), lh("net"), lh("ln"), lh("s"), lu("tok"), lr("r")], [
    gnet(1), nlisten(2, 1), naccept(3, 2), gmove(3, 4), nrecv(3, 5), IRelease(5), nclose(2), grev(1)]), "dead");
  const n3 = neg("stream closed after it was moved", straight(1, [lh("host"), lh("net"), lh("ln"), lh("s"), lu("tok")], [
    gnet(1), nlisten(2, 1), naccept(3, 2), gmove(3, 4), nclose(3), nclose(2), grev(1)]), "not open");
  const n4 = neg("stream moved on one branch, left open on the other", prog([
    fn("f", 1, [lh("host"), lb("c"), lh("net"), lh("ln"), lh("s"), lu("tok")], MVoid, [
      bk([gnet(2), nlisten(3, 2), naccept(4, 3)], TBranch(OLocal(1), 1, 2)),
      bk([gmove(4, 5)], TGoto(3)),
      bk([], TGoto(3)),
      bk([nclose(3), grev(2)], ret())])]), "closed");
  const n5 = neg("a Stream parameter is not moved (its owner closes it)", prog([
    fn("f", 1, [lh("s"), lu("tok")], MVoid, [bk([gmove(0, 1)], ret())])]), "parameter");
  const n6 = neg("adopted stream never closed", prog([
    fn("f", 1, [lu("tok"), lh("s")], MVoid, [bk([gadoptStream(1, 0)], ret())])]), "not closed");
  const n7 = neg("adopted stream closed twice", prog([
    fn("f", 1, [lu("tok"), lh("s")], MVoid, [bk([gadoptStream(1, 0), nclose(1), nclose(1)], ret())])]), "not open");
  const n8 = neg("adopt a stream from a handle (it takes a token)", prog([
    fn("f", 1, [lh("other"), lh("s")], MVoid, [bk([IBuiltin(Some(1), BTask(30), [OLocal(0)]), nclose(1)], ret())])]), "token");
  const n9 = neg("the moved token is not a handle: it cannot be received on", straight(1,
    [lh("host"), lh("net"), lh("ln"), lh("s"), lu("tok"), lr("r")], [
      gnet(1), nlisten(2, 1), naccept(3, 2), gmove(3, 4), IBuiltin(Some(5), BNetRecv, [OLocal(4), OInt(16), OInt(100)]), IRelease(5), nclose(2), grev(1)]), "first argument");
  const n10 = neg("adopted NetGrant never revoked", prog([
    fn("f", 1, [lu("tok"), lh("g")], MVoid, [bk([gadoptNet(1, 0)], ret())])]), "not closed");
  if (!p1) { bad += 1; } if (!p2) { bad += 1; } if (!p3) { bad += 1; } if (!p4) { bad += 1; }
  if (!n1) { bad += 1; } if (!n2) { bad += 1; } if (!n3) { bad += 1; } if (!n4) { bad += 1; }
  if (!n5) { bad += 1; } if (!n6) { bad += 1; } if (!n7) { bad += 1; } if (!n8) { bad += 1; }
  if (!n9) { bad += 1; } if (!n10) { bad += 1; }
  return bad;
}

// ---------------------------------------------------------------- in/out receiver (v1.10)

// An inout function: parameter 0 (owned) is handed back at return. `fnIO(name, locals, ret, blocks)`.
function fnIO(name: string, locals: MLocal[], ret: MType, blocks: MBlock[]): MFunction {
  return MFunction { name: name, paramCount: 1, paramOwned: [true], inout: true, uniqueIn: false, uniqueOut: false, locals: locals, ret: ret, blocks: blocks };
}

// next(owned this): int, in/out: moves this into a temp, bumps the field, hands the receiver back, returns an int.
function ioNext(): MFunction {
  return fnIO("next", [lr("this"), lr("t"), li("v")], MInt, [bk([
    IMove(1, 0), IMakeUnique(1), ISetField(1, 0, OInt(1)), IMove(0, 1), ICopy(2, OInt(7))], TReturn(Some(OLocal(2))))]);
}

function inoutCases(): usize {
  let bad: usize = 0;
  const dead = "dead";
  const p1 = pos("inout callee hands its receiver back", prog([
    fn("f", 0, [lr("x"), li("r")], MVoid, [bk([
      IStructNew(0, 0, [OInt(1)]), ICall(Some(1), 1, [OLocal(0)]), IRelease(0)], ret())]),
    ioNext()]));
  const p2 = pos("inout callee that never touches its receiver", prog([
    fn("f", 0, [lr("x"), li("r")], MVoid, [bk([
      IStructNew(0, 0, [OInt(1)]), ICall(Some(1), 1, [OLocal(0)]), IRelease(0)], ret())]),
    fnIO("keep", [lr("this")], MInt, [bk([], TReturn(Some(OInt(3))))])]));
  const p3 = pos("inout call result may be discarded", prog([
    fn("f", 0, [lr("x")], MVoid, [bk([
      IStructNew(0, 0, [OInt(1)]), ICall(None, 1, [OLocal(0)]), IRelease(0)], ret())]),
    ioNext()]));
  const p4 = pos("inout caller passes its own receiver on", prog([
    fn("f", 0, [lr("x"), li("r")], MVoid, [bk([
      IStructNew(0, 0, [OInt(1)]), ICall(Some(1), 1, [OLocal(0)]), IRelease(0)], ret())]),
    fnIO("outer", [lr("this"), lr("t"), li("v")], MInt, [bk([
      IMove(1, 0), ICall(Some(2), 2, [OLocal(1)]), IMove(0, 1)], TReturn(Some(OLocal(2))))]),
    ioNext()]));
  const n1 = neg("inout callee returns without a receiver", prog([
    fn("f", 0, [lr("x"), li("r")], MVoid, [bk([
      IStructNew(0, 0, [OInt(1)]), ICall(Some(1), 1, [OLocal(0)]), IRelease(0)], ret())]),
    fnIO("lose", [lr("this")], MInt, [bk([IRelease(0)], TReturn(Some(OInt(3))))])]), "updated receiver");
  const n2 = neg("inout callee returns its receiver twice (released then returned)", prog([
    fnIO("twice", [lr("this"), lr("t")], MInt, [bk([IMove(1, 0), IRelease(1)], TReturn(Some(OInt(3))))])]), "updated receiver");
  const n3 = neg("inout callee holds a hole in its receiver at return", prog([
    fnIO("hole", [lr("this"), lr("t"), lr("u")], MInt, [bk([
      IMove(1, 0), IMakeUnique(1), ITakeField(2, 1, 0), IMove(0, 1), IRelease(2)], TReturn(Some(OInt(3))))])]), "hole");
  const n4 = neg("a non-inout function writes parameter 0", prog([
    fnO("f", [true], [lr("p"), lr("q")], MVoid, [bk([IMove(1, 0), IMove(0, 1), IRelease(0)], ret())])]), "write to parameter");
  const n5 = neg("inout call with a literal receiver", prog([
    fn("f", 0, [li("r")], MVoid, [bk([ICall(Some(0), 1, [OStr(0)])], ret())]),
    ioNext()]), "must be a local");
  const n6 = neg("inout call result stored in the receiver local", prog([
    fn("f", 0, [lr("x")], MVoid, [bk([IStructNew(0, 0, [OInt(1)]), ICall(Some(0), 1, [OLocal(0)])], ret())]),
    fnIO("rr", [lr("this")], MRef, [bk([IStructNew(0, 0, [])], TReturn(Some(OLocal(0))))])]), "destination must not be");
  const n7 = neg("inout call with a borrowed parameter as receiver", prog([
    fnO("f", [false], [lr("p"), li("r")], MVoid, [bk([ICall(Some(1), 1, [OLocal(0)])], ret())]),
    ioNext()]), "parameter");
  const n8 = neg("receiver read after being consumed by the inout call is fine, but a borrow of it dies", prog([
    fn("f", 0, [lr("x"), lr("b"), li("r"), li("i")], MVoid, [bk([
      IStructNew(0, 0, [OStr(0)]), IGetField(1, OLocal(0), 0), ICall(Some(2), 1, [OLocal(0)]), ITag(3, OLocal(1)), IRelease(0)], ret())]),
    ioNext()]), dead);
  const n9 = neg("inout function without parameters", prog([
    MFunction { name: "f", paramCount: 0, paramOwned: [], inout: true, uniqueIn: false, uniqueOut: false, locals: [], ret: MVoid, blocks: [bk([], ret())] }]), "parameter 0");
  const n10 = neg("inout function with a borrowed parameter 0", prog([
    MFunction { name: "f", paramCount: 1, paramOwned: [false], inout: true, uniqueIn: false, uniqueOut: false, locals: [lr("p")], ret: MVoid, blocks: [bk([], ret())] }]), "parameter 0");
  // IArrayExtend (v1.10): x = x ++ y in place; rules of IStrAppend
  const e1 = pos("arrayextend of an owned array by another", straight(0, [lr("a"), lr("b")], [
    IArrayNew(0, false, []), IArrayNew(1, false, [OInt(1)]), IArrayExtend(0, OLocal(1)), IRelease(1), IRelease(0)]));
  const e2 = pos("arrayextend leaves the array Owned: it can be released or extended again", straight(0, [lr("a"), lr("b")], [
    IArrayNew(0, false, []), IArrayNew(1, false, []), IArrayExtend(0, OLocal(1)), IArrayExtend(0, OLocal(1)), IRelease(1), IRelease(0)]));
  const e3 = neg("arrayextend of a borrowed parameter", straight(2, [lr("p"), lr("q")], [IArrayExtend(0, OLocal(1))]), "parameter");
  const e4 = neg("arrayextend by itself", straight(0, [lr("a")], [IArrayNew(0, false, []), IArrayExtend(0, OLocal(0)), IRelease(0)]), "by itself");
  const e5 = neg("arrayextend by an alias of the array", straight(0, [lr("a"), lr("g")], [
    IArrayNew(0, true, [OStr(0)]), IGetField(1, OLocal(0), 0), IArrayExtend(0, OLocal(1)), IRelease(0)]), "borrowed from the array");
  const e6 = neg("arrayextend invalidates borrows of the array", straight(0, [lr("a"), lr("b"), lr("g"), li("i")], [
    IArrayNew(0, true, [OStr(0)]), IArrayNew(1, true, []), IArrayGet(2, OLocal(0), OUsize(0)), IArrayExtend(0, OLocal(1)), ITag(3, OLocal(2)),
    IRelease(1), IRelease(0)]), dead);
  const e7 = neg("arrayextend with a literal", straight(0, [lr("a")], [IArrayNew(0, false, []), IArrayExtend(0, OStr(0))]), "needs reference locals");
  if (!e1) { bad += 1; } if (!e2) { bad += 1; } if (!e3) { bad += 1; } if (!e4) { bad += 1; } if (!e5) { bad += 1; }
  if (!e6) { bad += 1; } if (!e7) { bad += 1; }
  // IStrPrepend (v2.3): x = y ++ x; rules of IStrAppend
  const s1 = pos("strprepend onto an owned temporary, literal prefix", straight(0, [lr("t")], [
    ICopy(0, OStr(0)), IStrPrepend(0, OStr(0)), IRelease(0)]));
  const s2 = pos("strprepend leaves the string Owned", straight(0, [lr("t")], [
    ICopy(0, OStr(0)), IStrPrepend(0, OStr(0)), IStrAppend(0, OStr(0)), IStrPrepend(0, OStr(0)), IRelease(0)]));
  const s3 = neg("strprepend onto a borrowed parameter", straight(1, [lr("p")], [IStrPrepend(0, OStr(0))]), "parameter");
  const s4 = neg("strprepend by itself", straight(0, [lr("a")], [ICopy(0, OStr(0)), IStrPrepend(0, OLocal(0)), IRelease(0)]), "itself");
  const s5 = neg("strprepend after release", straight(0, [lr("t")], [
    ICopy(0, OStr(0)), IRelease(0), IStrPrepend(0, OStr(0))]), dead);
  if (!s1) { bad += 1; } if (!s2) { bad += 1; } if (!s3) { bad += 1; } if (!s4) { bad += 1; } if (!s5) { bad += 1; }
  // IStrAppendNum (v2.5): x = x ++ decimal(y); rules of IStrAppend, y a scalar
  const a1 = pos("strappendi onto an owned temporary", straight(0, [lr("t")], [
    ICopy(0, OStr(0)), IStrAppendNum(0, OInt(-5), false), IStrAppendNum(0, OInt(7), false), IRelease(0)]));
  const a2 = pos("strappendu of a usize local", straight(0, [lr("t"), lu("n")], [
    ICopy(1, OUsize(3)), ICopy(0, OStr(0)), IStrAppendNum(0, OLocal(1), true), IStrAppend(0, OStr(0)), IRelease(0)]));
  const a3 = neg("strappendi onto a borrowed parameter", straight(1, [lr("p")], [IStrAppendNum(0, OInt(1), false)]), "parameter");
  const a4 = neg("strappendi after release", straight(0, [lr("t")], [
    ICopy(0, OStr(0)), IRelease(0), IStrAppendNum(0, OInt(1), false)]), dead);
  const a5 = neg("strappendi of a string operand", straight(0, [lr("t")], [
    ICopy(0, OStr(0)), IStrAppendNum(0, OStr(0), false), IRelease(0)]), "int");
  const a6 = neg("strappendu of an int operand", straight(0, [lr("t")], [
    ICopy(0, OStr(0)), IStrAppendNum(0, OInt(1), true), IRelease(0)]), "int");
  const a7 = neg("strappendi invalidates borrows of the string", straight(0, [lr("a"), lr("g")], [
    IArrayNew(0, true, [OStr(0)]), IGetField(1, OLocal(0), 0), IStrAppendNum(1, OInt(1), false), IRelease(0)]), "borrowed");
  if (!a1) { bad += 1; } if (!a2) { bad += 1; } if (!a3) { bad += 1; } if (!a4) { bad += 1; }
  if (!a5) { bad += 1; } if (!a6) { bad += 1; } if (!a7) { bad += 1; }
  // IStrAppendSub (v2.5): x = x ++ y[a..b]; rules of IStrAppend, a and b usize scalars
  const b1 = pos("strappendsub onto an owned temporary", straight(0, [lr("t")], [
    ICopy(0, OStr(0)), IStrAppendSub(0, OStr(0), OUsize(0), OUsize(1)), IStrAppendSub(0, OStr(0), OUsize(1), OUsize(1)), IRelease(0)]));
  const b2 = pos("strappendsub of another string local", straight(0, [lr("t"), lr("u"), lu("n")], [
    ICopy(0, OStr(0)), ICopy(1, OStr(0)), ICopy(2, OUsize(1)), IStrAppendSub(0, OLocal(1), OLocal(2), OUsize(2)), IRelease(1), IRelease(0)]));
  const b3 = neg("strappendsub onto a borrowed parameter", straight(1, [lr("p")], [IStrAppendSub(0, OStr(0), OUsize(0), OUsize(0))]), "parameter");
  const b4 = neg("strappendsub after release", straight(0, [lr("t")], [
    ICopy(0, OStr(0)), IRelease(0), IStrAppendSub(0, OStr(0), OUsize(0), OUsize(0))]), dead);
  const b5 = neg("strappendsub of itself", straight(0, [lr("t")], [
    ICopy(0, OStr(0)), IStrAppendSub(0, OLocal(0), OUsize(0), OUsize(0)), IRelease(0)]), "itself");
  const b6 = neg("strappendsub with an int bound", straight(0, [lr("t")], [
    ICopy(0, OStr(0)), IStrAppendSub(0, OStr(0), OInt(0), OUsize(0)), IRelease(0)]), "usize");
  const b7 = neg("strappendsub of a borrowed alias of the destination", straight(0, [lr("a"), lr("g")], [
    IArrayNew(0, true, [OStr(0)]), IGetField(1, OLocal(0), 0), IStrAppendSub(0, OLocal(1), OUsize(0), OUsize(0)), IRelease(0)]), "borrowed");
  if (!b1) { bad += 1; } if (!b2) { bad += 1; } if (!b3) { bad += 1; } if (!b4) { bad += 1; }
  if (!b5) { bad += 1; } if (!b6) { bad += 1; } if (!b7) { bad += 1; }
  if (!p1) { bad += 1; } if (!p2) { bad += 1; } if (!p3) { bad += 1; } if (!p4) { bad += 1; }
  if (!n1) { bad += 1; } if (!n2) { bad += 1; } if (!n3) { bad += 1; } if (!n4) { bad += 1; }
  if (!n5) { bad += 1; } if (!n6) { bad += 1; } if (!n7) { bad += 1; } if (!n8) { bad += 1; }
  if (!n9) { bad += 1; } if (!n10) { bad += 1; }
  return bad;
}

// Source positions (docs/mir.md v2.0): an ownership error is reported at the span of the offending instruction, a
// well-formedness error and an error in MIR without spans carry none.
function spanCases(): usize {
  let bad: usize = 0;
  const first = Span { file: 0, start: 10, end: 20 };
  const second = Span { file: 0, start: 30, end: 41 };
  const end = Span { file: 0, start: 50, end: 52 };
  // `release x; release x`: the second release is the double free, at the second span.
  const blk = MBlock {
    instrs: [IDup(1, OStr(0)), IRelease(1), IRelease(1)],
    spans: [first, first, second],
    term: TReturn(None),
    termSpan: end
  };
  const r = verify(prog([fn("f", 1, [lr("p"), lr("x")], MVoid, [blk])]));
  if (r.errors.length != 1 || r.errors[0].instr != 2 || !hasSpan(r.errors[0].span) || r.errors[0].span.start != 30 || r.errors[0].span.end != 41) {
    console.log("FAIL span of the double release");
    bad += 1;
  } else {
    console.log("PASS span of the double release");
  }
  // a leak is a warning at the terminator that returns it (the span of the `return`).
  const leak = MBlock { instrs: [IDup(1, OStr(0))], spans: [first], term: TReturn(None), termSpan: end };
  const w = verify(prog([fn("f", 1, [lr("p"), lr("x")], MVoid, [leak])]));
  if (w.errors.length != 0 || w.warnings.length != 1 || w.warnings[0].span.start != 50) {
    console.log("FAIL span of the leak warning");
    bad += 1;
  } else {
    console.log("PASS span of the leak warning");
  }
  // hand-written MIR has no spans
  const plain = verify(prog([fn("f", 1, [lr("p"), lr("x")], MVoid, [bk([IDup(1, OStr(0)), IRelease(1), IRelease(1)], ret())])]));
  if (plain.errors.length != 1 || hasSpan(plain.errors[0].span)) {
    console.log("FAIL no span without spans");
    bad += 1;
  } else {
    console.log("PASS no span without spans");
  }
  return bad;
}

// Ill-formed MIR that made the verifier itself index out of range before step 3b (a trap instead of a report): a call
// of a callee whose parameter table is longer than its locals, a closure / vtable target with parameters but no locals,
// and a block with fewer spans than instructions (only constructible without contract checking: `MBlock`'s record
// invariant forbids it).
function robustnessCases(): usize {
  let bad: usize = 0;
  const g = MFunction { name: "g", paramCount: 2, paramOwned: [false, false], inout: false, uniqueIn: false, uniqueOut: false, locals: [lr("p")], ret: MVoid, blocks: [bk([], ret())] };
  const callsG = fn("f", 0, [lr("a")], MVoid, [bk([ICall(None, 1, [OStr(0), OStr(0)])], ret())]);
  if (!neg("call of a callee with more parameters than locals", prog([callsG, g]), "has more parameters than locals")) {
    bad += 1;
  }
  const h = MFunction { name: "h", paramCount: 1, paramOwned: [false], inout: false, uniqueIn: false, uniqueOut: false, locals: [], ret: MVoid, blocks: [bk([], ret())] };
  const mk = fn("f", 0, [lr("c")], MVoid, [bk([IClosure(0, 1, []), IRelease(0)], ret())]);
  if (!neg("closure target without locals", prog([mk, h]), "must take the environment record")) {
    bad += 1;
  }
  const vp = MProgram { functions: [fn("f", 0, [], MVoid, [bk([], ret())]), h], strings: ["s"], main: 0, vtables: [MVTable { name: "vt", funcs: [1] }], inlineFns: [] };
  if (!neg("vtable entry without locals", vp, "must take the boxed value")) {
    bad += 1;
  }
  const short = MBlock { instrs: [IDup(0, OStr(0)), IRelease(0), IRelease(0)], spans: [], term: TReturn(None), termSpan: Span { file: 0, start: 1, end: 2 } };
  if (!neg("block with fewer spans than instructions", prog([fn("f", 0, [lr("x")], MVoid, [short])]), "different number of source spans")) {
    bad += 1;
  }
  return bad;
}

// Load forwarding, rule F1 (docs/mir.md v2.4, ADR-0038 lever 2 T4). Locals: 0 = the object `o` (a record of two ints, or an
// array of three), 1 = the scalar `s` that holds a slot, 2 = the forwarded `d`, 3 = an int `w`, 4 = an index `i`.
function cnt(ok: bool): usize { return ok ? 0 : 1; }

function fwd(name: string, instrs: Instr[]): bool {
  return pos("forward " + name, straight(0, [lr("o"), li("s"), li("d"), li("w"), lu("i")], instrs));
}

function nfwd(name: string, instrs: Instr[]): bool {
  return neg("forward " + name, straight(0, [lr("o"), li("s"), li("d"), li("w"), lu("i")], instrs), "unjustified forward");
}

function rec(): Instr { return IStructNew(0, 0, [OInt(1), OInt(2)]); }
// One element: the indices the cases below use (1, 2, a local holding 1) are out of its length, so no interval fact (T6) justifies
// them and the cases test the dominating-access fact (T2) alone.
function arr(): Instr { return IArrayNew(0, false, [OInt(1)]); }
function load0(): Instr { return IGetField(1, OLocal(0), 0); }
function fwd0(): Instr { return IForward(2, 1, OLocal(0), OUsize(0)); }
function done(): Instr { return IRelease(0); }

function callProg(instrs: Instr[]): MProgram {
  return prog([fn("f", 0, [lr("o"), li("s"), li("d"), li("w"), lu("i")], MVoid, [bk(instrs, ret())]), gVoid()]);
}

function forwardCases(): usize {
  let bad: usize = 0;
  // accepted
  bad += cnt(fwd("after a load of the same field", [rec(), load0(), fwd0(), done()]));
  bad += cnt(fwd("after a store of the local into the field", [
    rec(), ICopy(1, OInt(7)), ISetField(0, 1, OLocal(1)), IForward(2, 1, OLocal(0), OUsize(1)), done()]));
  bad += cnt(fwd("across a write to another field (positive control)", [
    rec(), load0(), ICopy(3, OInt(9)), ISetField(0, 1, OLocal(3)), fwd0(), done()]));
  bad += cnt(fwd("across makeunique of the object", [rec(), load0(), IMakeUnique(0), fwd0(), done()]));
  bad += cnt(pos("forward across a call that does not receive the object", callProg([rec(), load0(), ICall(None, 1, [OStr(0)]), fwd0(), done()])));
  bad += cnt(fwd("after an array load, constant index", [
    arr(), IArrayGet(1, OLocal(0), OUsize(1)), IForward(2, 1, OLocal(0), OUsize(1)), done()]));
  bad += cnt(fwd("after an array load, local index", [
    arr(), ICopy(4, OUsize(1)), IArrayGet(1, OLocal(0), OLocal(4)), IForward(2, 1, OLocal(0), OLocal(4)), done()]));
  bad += cnt(fwd("across an array store at a different constant index", [
    arr(), IArrayGet(1, OLocal(0), OUsize(1)), ICopy(3, OInt(5)), IArraySet(0, OUsize(2), OLocal(3)),
    IForward(2, 1, OLocal(0), OUsize(1)), done()]));
  bad += cnt(fwd("after a forward (a forward is a source)", [
    rec(), load0(), fwd0(), IForward(3, 2, OLocal(0), OUsize(0)), done()]));
  // rejected
  bad += cnt(nfwd("across a write to the same field", [rec(), load0(), ICopy(3, OInt(9)), ISetField(0, 0, OLocal(3)), fwd0(), done()]));
  bad += cnt(nfwd("after the object was redefined", [rec(), load0(), done(), rec(), fwd0(), done()]));
  bad += cnt(nfwd("after the source was redefined", [rec(), load0(), ICopy(1, OInt(5)), fwd0(), done()]));
  bad += cnt(nfwd("across an array push", [
    arr(), IArrayGet(1, OLocal(0), OUsize(1)), IArrayPush(0, OInt(4)), IForward(2, 1, OLocal(0), OUsize(1)), done()]));
  bad += cnt(nfwd("for another field", [rec(), load0(), IForward(2, 1, OLocal(0), OUsize(1)), done()]));
  bad += cnt(nfwd("with no earlier access", [rec(), fwd0(), done()]));
  bad += cnt(neg("forward across a call that receives the object", callProg([rec(), load0(), ICall(None, 1, [OLocal(0)]), fwd0(), done()]), "unjustified forward"));
  bad += cnt(nfwd("across an array store at an index that may be the same", [
    arr(), ICopy(4, OUsize(1)), IArrayGet(1, OLocal(0), OUsize(1)), ICopy(3, OInt(5)), IArraySet(0, OLocal(4), OLocal(3)),
    IForward(2, 1, OLocal(0), OUsize(1)), done()]));
  bad += cnt(nfwd("after the index local was redefined", [
    arr(), ICopy(4, OUsize(1)), IArrayGet(1, OLocal(0), OLocal(4)), ICopy(4, OUsize(2)), IForward(2, 1, OLocal(0), OLocal(4)), done()]));
  // the source load redefines its own index local (`i = arrayget o[i]`): `o[i]` now names another element
  bad += cnt(neg("forward after a load that redefines its index", straight(0, [lr("o"), lu("s"), lu("d")], [
    IArrayNew(0, false, [OUsize(1), OUsize(0)]), ICopy(1, OUsize(0)), IArrayGet(1, OLocal(0), OLocal(1)),
    IForward(2, 1, OLocal(0), OLocal(1)), done()]), "unjustified forward"));
  bad += cnt(neg("forward after a forward that redefines its index", straight(0, [lr("o"), lu("s"), lu("d")], [
    IArrayNew(0, false, [OUsize(1), OUsize(0)]), ICopy(1, OUsize(0)), IArrayGet(2, OLocal(0), OLocal(1)),
    IForward(1, 2, OLocal(0), OLocal(1)), IForward(2, 1, OLocal(0), OLocal(1)), done()]), "unjustified forward"));
  bad += cnt(neg("an in/out call demotes its borrowed arguments", prog([
    fn("f", 0, [lr("r"), lr("x"), li("v")], MVoid, [bk([
      IStructNew(0, 0, [OInt(1)]), IStructNew(1, 0, [OInt(1)]), ICall(Some(2), 1, [OLocal(0), OLocal(1)]),
      ISetField(1, 0, OInt(2)), IRelease(1), IRelease(0)], ret())]),
    MFunction { name: "keep", paramCount: 2, paramOwned: [true, false], inout: true, uniqueIn: false, uniqueOut: false,
      locals: [lr("this"), lr("item"), lr("t")], ret: MInt, blocks: [bk([IMove(2, 0), IMove(0, 2)], TReturn(Some(OInt(0))))] }]),
    "to be Unique"));
  bad += cnt(nfwd("from a load into another local", [
    rec(), load0(), IGetField(3, OLocal(0), 0), fwd0(), done()]));
  bad += cnt(neg("forward across blocks", prog([fn("f", 0, [lr("o"), li("s"), li("d")], MVoid, [
    bk([rec(), load0()], TGoto(1)), bk([fwd0(), done()], ret())])]), "unjustified forward"));
  bad += cnt(neg("forward of a dead source", straight(0, [lr("o"), li("s"), li("d")], [rec(), fwd0(), done()]), "unjustified forward"));
  bad += cnt(neg("forward with a reference destination", straight(0, [lr("o"), lr("s"), lr("d")], [
    rec(), IGetField(1, OLocal(0), 0), IForward(2, 1, OLocal(0), OUsize(0)), done()]), "IForward: destination and source must be scalars"));
  bad += cnt(neg("forward from a source of another class", straight(0, [lr("o"), li("s"), lu("d")], [
    rec(), load0(), fwd0(), done()]), "IForward: destination and source must be scalars"));
  // the window is 64 instructions
  let near: Instr[] = [rec(), load0()];
  let far: Instr[] = [rec(), load0()];
  let k: usize = 0;
  while (k < 70) {
    if (k < 60) { near.push(ICopy(3, OInt(1))); }
    far.push(ICopy(3, OInt(1)));
    k += 1;
  }
  near.push(fwd0()); near.push(done());
  far.push(fwd0()); far.push(done());
  bad += cnt(fwd("within the window of 64 instructions", near));
  bad += cnt(nfwd("beyond the window of 64 instructions", far));
  return bad;
}

// Unchecked array access, rule U1 (docs/mir.md v2.6, ADR-0038 lever 2 T2). Locals: 0 = the array `a` (one int), 1 = an int `s`,
// 2 = an int `d`, 3 = an int `w`, 4 = an index `i`, 5 = a reference `r`, 6 = a second array `b`, 7 = another index `j`.
function ulocs(): MLocal[] {
  return [lr("a"), li("s"), li("d"), li("w"), lu("i"), lr("r"), lr("b"), lu("j")];
}

function uok(name: string, instrs: Instr[]): bool {
  return pos("unchecked " + name, straight(0, ulocs(), instrs));
}

const UNCHECKED_NEEDLE: string = "unchecked array access without a dominating check";

function ubad(name: string, instrs: Instr[]): bool {
  return neg("unchecked " + name, straight(0, ulocs(), instrs), UNCHECKED_NEEDLE);
}

function ubadCall(name: string, instrs: Instr[]): bool {
  return neg("unchecked " + name, prog([fn("f", 0, ulocs(), MVoid, [bk(instrs, ret())]), gVoid(), ioNext()]), UNCHECKED_NEEDLE);
}

function get1(): Instr { return IArrayGet(1, OLocal(0), OUsize(1)); }
function getU1(): Instr { return IArrayGetU(2, OLocal(0), OUsize(1)); }
function setU1(): Instr { return IArraySetU(0, OUsize(1), OLocal(3)); }
function w5(): Instr { return ICopy(3, OInt(5)); }

function uncheckedCases(): usize {
  let bad: usize = 0;
  // accepted
  bad += cnt(uok("get after get, constant index", [arr(), get1(), getU1(), done()]));
  bad += cnt(uok("set after get", [arr(), get1(), w5(), setU1(), done()]));
  bad += cnt(uok("get after set", [arr(), w5(), IArraySet(0, OUsize(1), OLocal(3)), getU1(), done()]));
  bad += cnt(uok("set after set", [arr(), w5(), IArraySet(0, OUsize(1), OLocal(3)), setU1(), done()]));
  bad += cnt(uok("same local index", [arr(), ICopy(4, OUsize(1)), IArrayGet(1, OLocal(0), OLocal(4)), IArrayGetU(2, OLocal(0), OLocal(4)), done()]));
  bad += cnt(uok("an unchecked access is a source for the next", [arr(), get1(), getU1(), IArrayGetU(1, OLocal(0), OUsize(1)), done()]));
  bad += cnt(uok("across makeunique of the array (positive control)", [arr(), get1(), IMakeUnique(0), getU1(), done()]));
  bad += cnt(uok("across an access of another index (positive control)", [arr(), get1(), IArrayGet(3, OLocal(0), OUsize(2)), IArraySet(0, OUsize(0), OLocal(3)), getU1(), done()]));
  bad += cnt(uok("across a store to the same element", [arr(), get1(), w5(), IArraySet(0, OUsize(1), OLocal(3)), getU1(), done()]));
  bad += cnt(uok("across a forward from the array", [arr(), get1(), IForward(3, 1, OLocal(0), OUsize(1)), getU1(), done()]));
  bad += cnt(uok("across an index local that is only read", [arr(), ICopy(4, OUsize(1)), IArrayGet(1, OLocal(0), OLocal(4)), IBinary(3, OpAdd, OInt(1), OInt(2)), IArrayGetU(2, OLocal(0), OLocal(4)), done()]));
  bad += cnt(pos("unchecked across a call that does not receive the array",
    callProg([arr(), get1(), ICall(None, 1, [OStr(0)]), getU1(), done()])));
  // rejected
  bad += cnt(ubad("get with no earlier access", [arr(), getU1(), done()]));
  bad += cnt(ubad("set with no earlier access", [arr(), w5(), setU1(), done()]));
  bad += cnt(ubad("access of another constant index", [arr(), IArrayGet(1, OLocal(0), OUsize(2)), getU1(), done()]));
  bad += cnt(ubad("access of another index local", [arr(), ICopy(4, OUsize(1)), ICopy(7, OUsize(1)), IArrayGet(1, OLocal(0), OLocal(4)),
    IArrayGetU(2, OLocal(0), OLocal(7)), done()]));
  bad += cnt(ubad("constant index against a local index", [arr(), ICopy(4, OUsize(1)), IArrayGet(1, OLocal(0), OLocal(4)), getU1(), done()]));
  bad += cnt(ubad("access of another array", [arr(), IArrayNew(6, false, [OInt(1), OInt(2), OInt(3)]), IArrayGet(1, OLocal(6), OUsize(1)), getU1(), IRelease(6), done()]));
  bad += cnt(ubad("across arraypush", [arr(), get1(), IArrayPush(0, OInt(4)), getU1(), done()]));
  bad += cnt(ubad("across arraypop", [arr(), get1(), IArrayPop(5, 0), getU1(), IRelease(5), done()]));
  bad += cnt(ubad("across arrayextend", [arr(), IArrayNew(6, false, [OInt(1)]), get1(), IArrayExtend(0, OLocal(6)), getU1(), done()]));
  bad += cnt(ubad("across arraytake of another element", [arr(), get1(), IArrayTake(5, 0, OUsize(2)), IArrayPut(0, OUsize(2), 5), getU1(), done()]));
  bad += cnt(ubad("across arraytake", [arr(), get1(), IArrayTake(5, 0, OUsize(2)), getU1(), IArrayPut(0, OUsize(2), 5), done()]));
  bad += cnt(ubad("after the array was redefined", [arr(), get1(), done(), arr(), getU1(), done()]));
  bad += cnt(ubad("after the array was moved in", [arr(), IArrayNew(6, false, [OInt(1)]), get1(), done(), IMove(0, 6), getU1(), done()]));
  bad += cnt(ubad("after the index local was redefined", [arr(), ICopy(4, OUsize(1)), IArrayGet(1, OLocal(0), OLocal(4)), ICopy(4, OUsize(2)), IArrayGetU(2, OLocal(0), OLocal(4)), done()]));
  bad += cnt(ubad("across a dup of the array", [arr(), get1(), IDup(5, OLocal(0)), getU1(), IRelease(5), done()]));
  bad += cnt(ubadCall("across a call that receives the array", [arr(), get1(), ICall(None, 1, [OLocal(0)]), getU1(), done()]));
  bad += cnt(ubadCall("across an in/out call on the array", [arr(), get1(), ICall(Some(3), 2, [OLocal(0)]), getU1(), done()]));
  // the source redefines its own index local (`i = arrayget a[i]`): afterwards `a[i]` names another element
  const ixs = [lr("a"), lu("i"), lu("d")];
  bad += cnt(neg("unchecked get after a load that redefines its index", straight(0, ixs, [
    IArrayNew(0, false, [OUsize(1), OUsize(0)]), ICopy(1, OUsize(0)), IArrayGet(1, OLocal(0), OLocal(1)),
    IArrayGetU(2, OLocal(0), OLocal(1)), done()]), UNCHECKED_NEEDLE));
  bad += cnt(neg("unchecked get after an unchecked load that redefines its index", straight(0, ixs, [
    IArrayNew(0, false, [OUsize(1), OUsize(0)]), ICopy(1, OUsize(0)), IArrayGet(2, OLocal(0), OLocal(1)),
    IArrayGetU(1, OLocal(0), OLocal(1)), IArrayGetU(2, OLocal(0), OLocal(1)), done()]), UNCHECKED_NEEDLE));
  bad += cnt(neg("unchecked set after a load that redefines its index", straight(0, ixs, [
    IArrayNew(0, false, [OUsize(1), OUsize(0)]), ICopy(1, OUsize(0)), IArrayGet(1, OLocal(0), OLocal(1)),
    IArraySetU(0, OLocal(1), OUsize(7)), done()]), UNCHECKED_NEEDLE));
  bad += cnt(neg("unchecked access across blocks", prog([fn("f", 0, ulocs(), MVoid, [
    bk([arr(), get1()], TGoto(1)), bk([getU1(), done()], ret())])]), UNCHECKED_NEEDLE));
  bad += cnt(neg("unchecked access of a non-local array", straight(0, ulocs(), [IArrayGetU(2, OStr(0), OUsize(1))]), "IArrayGetU: bad destination"));
  bad += cnt(neg("unchecked store into a scalar", straight(0, ulocs(), [IArraySetU(1, OUsize(1), OInt(1))]), "IArraySetU: bad array"));
  // an unchecked access is still a read or a store: the ordinary rules apply to it
  bad += cnt(neg("unchecked store into an array that is not unique", straight(0, ulocs(), [
    arr(), IDup(6, OLocal(0)), get1(), w5(), setU1(), IRelease(6), done()]), "Unique"));
  // the window is 64 instructions
  let near: Instr[] = [arr(), get1()];
  let far: Instr[] = [arr(), get1()];
  let k: usize = 0;
  while (k < 70) {
    if (k < 60) { near.push(ICopy(3, OInt(1))); }
    far.push(ICopy(3, OInt(1)));
    k += 1;
  }
  near.push(getU1()); near.push(done());
  far.push(getU1()); far.push(done());
  bad += cnt(uok("within the window of 64 instructions", near));
  bad += cnt(ubad("beyond the window of 64 instructions", far));
  return bad;
}


// Unchecked struct slot access, rule U6 (docs/mir.md v2.8, ADR-0038 lever 2 T7). Locals: 0 = the struct `o` (two ints), 1 = an int `s`,
// 2 = an int `d`, 3 = an int `w`, 4 = a reference `p`, 5 = a second struct `q`.
function flocs(): MLocal[] {
  return [lr("o"), li("s"), li("d"), li("w"), lr("p"), lr("q")];
}

function fok(name: string, instrs: Instr[]): bool {
  return pos("unchecked field " + name, straight(0, flocs(), instrs));
}

const FIELD_NEEDLE: string = "unchecked struct slot access without a dominating check";

function fbad(name: string, instrs: Instr[]): bool {
  return neg("unchecked field " + name, straight(0, flocs(), instrs), FIELD_NEEDLE);
}

function fbadCall(name: string, instrs: Instr[]): bool {
  return neg("unchecked field " + name, prog([fn("f", 0, flocs(), MVoid, [bk(instrs, ret())]), gVoid(), ioNext()]), FIELD_NEEDLE);
}

function rec0(): Instr { return IStructNew(0, 0, []); }
function rec2(): Instr { return IStructNew(0, 0, [OInt(1), OInt(2)]); }
function fget1(): Instr { return IGetField(1, OLocal(0), 1); }
function fgetU1(): Instr { return IGetFieldU(2, OLocal(0), 1); }
function fgetU0(): Instr { return IGetFieldU(2, OLocal(0), 0); }
function fsetU0(): Instr { return ISetFieldU(0, 0, OLocal(3)); }
function fw5(): Instr { return ICopy(3, OInt(5)); }

function fieldCases(): usize {
  let bad: usize = 0;
  // accepted
  bad += cnt(fok("get after get, same slot", [rec2(), fget1(), fgetU1(), done()]));
  bad += cnt(fok("get of a lower slot after a get of a higher one", [rec2(), fget1(), fgetU0(), done()]));
  bad += cnt(fok("set after get", [rec2(), fget1(), fw5(), fsetU0(), done()]));
  bad += cnt(fok("get after set", [rec2(), fw5(), ISetField(0, 1, OLocal(3)), fgetU0(), done()]));
  bad += cnt(fok("set after set", [rec2(), fw5(), ISetField(0, 0, OLocal(3)), fsetU0(), done()]));
  bad += cnt(fok("an unchecked access is a source for the next", [rec2(), fget1(), fgetU1(), IGetFieldU(1, OLocal(0), 1), done()]));
  bad += cnt(fok("a lower slot in between does not end the scan", [rec2(), fget1(), fgetU0(), IGetFieldU(1, OLocal(0), 1), done()]));
  bad += cnt(fok("across makeunique of the struct", [rec2(), fget1(), IMakeUnique(0), fgetU1(), done()]));
  bad += cnt(fok("across a store to the same slot", [rec2(), fget1(), fw5(), ISetField(0, 1, OLocal(3)), fgetU1(), done()]));
  bad += cnt(fok("across a take and a put of the same slot", [rec2(), fget1(), ITakeField(4, 0, 1), IPutField(0, 1, 4), fgetU1(), done()]));
  bad += cnt(fok("across a forward from the struct", [rec2(), fget1(), IForward(3, 1, OLocal(0), OUsize(1)), fgetU1(), done()]));
  bad += cnt(pos("unchecked field across a call that does not receive the struct",
    callProg([rec2(), fget1(), ICall(None, 1, [OStr(0)]), fgetU1(), done()])));
  bad += cnt(pos("unchecked field across a call that borrows the struct",
    prog([fn("f", 0, flocs(), MVoid, [bk([rec2(), fget1(), ICall(None, 1, [OLocal(0)]), fgetU1(), done()], ret())]), gVoid()])));
  bad += cnt(fok("after a take of a higher slot", [rec2(), ITakeField(4, 0, 1), IPutField(0, 1, 4), fgetU0(), done()]));
  bad += cnt(fok("a new struct with enough slots is a source", [rec2(), fgetU1(), done()]));
  bad += cnt(fok("a new struct with enough slots is a source for a store", [rec2(), fw5(), fsetU0(), done()]));
  bad += cnt(fok("a shape check of a high slot justifies lower and equal slots", [
    rec0(), IShapeCheck(0, 1), fgetU1(), fgetU0(), fw5(), fsetU0(), done()]));
  bad += cnt(fok("a shape check is a plain read: makeunique and a call do not end the scan", [
    rec0(), IShapeCheck(0, 1), IMakeUnique(0), fgetU1(), done()]));
  bad += cnt(fok("a shape check is no obstacle to a forward", [
    rec2(), fget1(), IShapeCheck(0, 1), IForward(3, 1, OLocal(0), OUsize(1)), done()]));
  // rejected
  bad += cnt(fbad("get with no earlier access", [rec0(), fgetU1(), done()]));
  bad += cnt(fbad("set with no earlier access", [rec0(), fw5(), fsetU0(), done()]));
  bad += cnt(fbad("get of a higher slot than any earlier access", [rec0(), IGetField(1, OLocal(0), 0), fgetU1(), done()]));
  bad += cnt(fbad("set of a higher slot than any earlier access", [rec0(), IGetField(1, OLocal(0), 0), fw5(), ISetFieldU(0, 1, OLocal(3)), done()]));
  bad += cnt(fbad("access of another struct", [rec0(), IStructNew(5, 0, [OInt(1), OInt(2)]), IGetField(1, OLocal(5), 1), fgetU1(), IRelease(5), done()]));
  bad += cnt(fbad("after the struct was redefined", [rec0(), fget1(), done(), rec0(), fgetU1(), done()]));
  bad += cnt(fbad("after the struct was moved in", [rec0(), IStructNew(5, 0, [OInt(1), OInt(2)]), fget1(), done(), IMove(0, 5), fgetU1(), done()]));
  bad += cnt(fbadCall("across an in/out call on the struct", [rec0(), fget1(), ICall(Some(3), 2, [OLocal(0)]), fgetU1(), done()]));
  // the source redefines the struct local itself (`o = getfield o.0`): afterwards `o` names another object
  const nest = [lr("o"), lr("n")];
  bad += cnt(neg("unchecked field after a load that redefines its object", straight(0, nest, [
    IStructNew(1, 0, [OInt(1), OInt(2)]), IStructNew(0, 0, [OLocal(1), OInt(3)]), IGetField(0, OLocal(0), 0),
    IGetFieldU(1, OLocal(0), 0), IRelease(0)]), FIELD_NEEDLE));
  bad += cnt(neg("unchecked field after an unchecked load that redefines its object", straight(0, nest, [
    IStructNew(1, 0, [OInt(1), OInt(2)]), IStructNew(0, 0, [OLocal(1), OInt(3)]), IGetField(1, OLocal(0), 0),
    IGetFieldU(0, OLocal(0), 0), IGetFieldU(1, OLocal(0), 0), IRelease(0)]), FIELD_NEEDLE));
  bad += cnt(neg("unchecked field across blocks", prog([fn("f", 0, flocs(), MVoid, [
    bk([rec0(), fget1()], TGoto(1)), bk([fgetU1(), done()], ret())])]), FIELD_NEEDLE));
  bad += cnt(neg("unchecked field of a non-local object", straight(0, flocs(), [IGetFieldU(2, OStr(0), 1)]), "IGetFieldU: bad destination"));
  bad += cnt(neg("unchecked field of a scalar object", straight(0, flocs(), [IGetFieldU(2, OLocal(1), 1)]), "IGetFieldU: bad destination"));
  bad += cnt(neg("unchecked store into a scalar", straight(0, flocs(), [ISetFieldU(1, 0, OInt(1))]), "ISetFieldU: bad object"));
  // an unchecked access is still a read or a store: the ordinary rules apply to it
  bad += cnt(neg("unchecked store into a struct that is not unique", straight(0, flocs(), [
    rec0(), IDup(5, OLocal(0)), fget1(), fw5(), fsetU0(), IRelease(5), done()]), "Unique"));
  bad += cnt(fbad("a new struct with too few slots", [IStructNew(0, 0, [OInt(1)]), fgetU1(), done()]));
  bad += cnt(fbad("a shape check of a lower slot", [rec0(), IShapeCheck(0, 0), fgetU1(), done()]));
  bad += cnt(fbad("a shape check of another struct", [rec0(), IStructNew(5, 0, []), IShapeCheck(5, 1), fgetU1(), IRelease(5), done()]));
  bad += cnt(fbad("a shape check before the struct was redefined", [rec0(), IShapeCheck(0, 1), done(), rec0(), fgetU1(), done()]));
  bad += cnt(neg("unchecked field after a shape check in another block", prog([fn("f", 0, flocs(), MVoid, [
    bk([rec0(), IShapeCheck(0, 1)], TGoto(1)), bk([fgetU1(), done()], ret())])]), FIELD_NEEDLE));
  bad += cnt(neg("shape check of a scalar", straight(0, flocs(), [IShapeCheck(1, 0)]), "IShapeCheck: needs a reference"));
  bad += cnt(neg("shape check of a dead struct", straight(0, flocs(), [rec0(), done(), IShapeCheck(0, 0)]), "dead"));
  // the window is 64 instructions
  let near: Instr[] = [rec2(), fget1()];
  let far: Instr[] = [rec2(), fget1()];
  let k: usize = 0;
  while (k < 70) {
    if (k < 60) { near.push(ICopy(3, OInt(1))); }
    far.push(ICopy(3, OInt(1)));
    k += 1;
  }
  near.push(fgetU1()); near.push(done());
  far.push(fgetU1()); far.push(done());
  bad += cnt(fok("within the window of 64 instructions", near));
  bad += cnt(fbad("beyond the window of 64 instructions", far));
  return bad;
}

// Range facts for unchecked array access, rule U1 (docs/mir.md v2.6, ADR-0038 lever 2 T6, compiler/verify/range.or). Locals: 0 = the array
// `a` (four ints), 1 = an index `i`, 2 = a second index `j`, 3 = a bound `n`, 4 = a bool `c`, 5 = an int `d`, 6 = an int `w`, 7 = a
// second array `b`, 8 = a usize `m`, 9 = a reference `r`.
function rlocals(): MLocal[] {
  return [lr("a"), lu("i"), lu("j"), lu("n"), lb("c"), li("d"), li("w"), lr("b"), lu("m"), lr("r")];
}

function gOwn(): MFunction {
  return MFunction { name: "own", paramCount: 1, paramOwned: [true], inout: false, uniqueIn: false, uniqueOut: false, locals: [lr("p")], ret: MVoid,
    blocks: [bk([IRelease(0)], TReturn(None))] };
}

// fn1 = g(borrowed ref), fn2 = in/out next(owned this), fn3 = own(owned ref)
function rprog(blocks: MBlock[]): MProgram {
  return prog([fn("f", 0, rlocals(), MVoid, blocks), gVoid(), ioNext(), gOwn()]);
}

function rnew4(): Instr { return IArrayNew(0, false, [OInt(1), OInt(2), OInt(3), OInt(4)]); }
function rget(k: usize): Instr { return IArrayGetU(5, OLocal(0), OLocal(k)); }
function rset(k: usize): Instr { return IArraySetU(0, OLocal(k), OLocal(6)); }
function unk(): Instr { return IBuiltin(Some(3), BStrLength, [OStr(0)]); }
function cmp(op: BinOp, x: Operand, y: Operand): Instr { return IBinary(4, op, x, y); }
function inc(): Instr { return IBinary(1, OpAdd, OLocal(1), OUsize(1)); }
function u(n: int): Operand { return OUsize(n); }
function lo(k: usize): Operand { return OLocal(k); }

// `i = 0; while (cmp) { body; i = i + 1 }` (setup builds the array): b0 setup, b1 header, b2 body, b3 exit.
function rloop(setup: Instr[], header: Instr[], body: Instr[], bodyOnTrue: bool): MProgram {
  return rprog([
    bk(setup, TGoto(1)),
    bk(header, bodyOnTrue ? TBranch(OLocal(4), 2, 3) : TBranch(OLocal(4), 3, 2)),
    bk(body.concat([inc()]), TGoto(1)),
    bk([IRelease(0)], ret())]);
}

function rinit(): Instr[] { return [rnew4(), ICopy(1, u(0))]; }

function rok(name: string, p: MProgram): bool { return pos("range " + name, p); }
function rbad(name: string, p: MProgram): bool { return neg("range " + name, p, UNCHECKED_NEEDLE); }

// straight-line function over the range locals
function rstr(instrs: Instr[]): MProgram { return rprog([bk(instrs, ret())]); }

// `unk(); c = n < 1; branch c ? b1 : b2` after the setup: a branch whose condition says nothing about the array.
function rfork(setup: Instr[]): MBlock {
  return bk(setup.concat([unk(), cmp(OpLt, lo(3), u(1))]), TBranch(OLocal(4), 1, 2));
}

function rangeCases(): usize {
  let bad: usize = 0;
  // constant indices against the literal length
  bad += cnt(rok("constant index in range", rstr([rnew4(), IArrayGetU(5, lo(0), u(3)), IRelease(0)])));
  bad += cnt(rok("constant index 0", rstr([rnew4(), IArrayGetU(5, lo(0), u(0)), IRelease(0)])));
  bad += cnt(rok("unchecked store, constant index in range", rstr([rnew4(), ICopy(6, OInt(7)), IArraySetU(0, u(3), lo(6)), IRelease(0)])));
  bad += cnt(rbad("constant index at the length", rstr([rnew4(), IArrayGetU(5, lo(0), u(4)), IRelease(0)])));
  bad += cnt(rbad("constant index beyond the length", rstr([rnew4(), IArrayGetU(5, lo(0), u(100)), IRelease(0)])));
  bad += cnt(rbad("store, constant index at the length", rstr([rnew4(), ICopy(6, OInt(7)), IArraySetU(0, u(4), lo(6)), IRelease(0)])));
  bad += cnt(rbad("empty array", rstr([IArrayNew(0, false, []), IArrayGetU(5, lo(0), u(0)), IRelease(0)])));
  bad += cnt(rok("index in a local", rstr([rnew4(), ICopy(1, u(2)), rget(1), IRelease(0)])));
  bad += cnt(rbad("index in a local, out of range", rstr([rnew4(), ICopy(1, u(4)), rget(1), IRelease(0)])));

  // loops: the guard of the branch refines the index
  bad += cnt(rok("while (i < 4)", rloop(rinit(), [cmp(OpLt, lo(1), u(4))], [rget(1)], true)));
  bad += cnt(rok("store in while (i < 4)", rloop(rinit().concat([ICopy(6, OInt(1))]), [cmp(OpLt, lo(1), u(4))], [rset(1)], true)));
  bad += cnt(rok("while (i <= 3)", rloop(rinit(), [cmp(OpLe, lo(1), u(3))], [rget(1)], true)));
  bad += cnt(rok("while (4 > i)", rloop(rinit(), [cmp(OpGt, u(4), lo(1))], [rget(1)], true)));
  bad += cnt(rok("while (3 >= i)", rloop(rinit(), [cmp(OpGe, u(3), lo(1))], [rget(1)], true)));
  bad += cnt(rok("exit on i >= 4, body on the false edge", rloop(rinit(), [cmp(OpGe, lo(1), u(4))], [rget(1)], false)));
  bad += cnt(rok("bound in a local", rloop(rinit().concat([ICopy(3, u(4))]), [cmp(OpLt, lo(1), lo(3))], [rget(1)], true)));
  bad += cnt(rok("bound is the array length", rloop(rinit(), [IBuiltin(Some(3), BArrLength, [lo(0)]), cmp(OpLt, lo(1), lo(3))], [rget(1)], true)));
  bad += cnt(rok("array length known after a store", rloop(rinit().concat([ICopy(6, OInt(1))]),
    [IBuiltin(Some(3), BArrLength, [lo(0)]), cmp(OpLt, lo(1), lo(3))], [rset(1), rget(1)], true)));
  bad += cnt(rok("the body also reads a constant index", rloop(rinit(), [cmp(OpLt, lo(1), u(4))], [rget(1), IArrayGetU(6, lo(0), u(0))], true)));
  bad += cnt(rok("start at 2", rloop([rnew4(), ICopy(1, u(2))], [cmp(OpLt, lo(1), u(4))], [rget(1)], true)));

  // off by one: the bound is one too large
  bad += cnt(rbad("while (i <= 4)", rloop(rinit(), [cmp(OpLe, lo(1), u(4))], [rget(1)], true)));
  bad += cnt(rbad("while (i < 5)", rloop(rinit(), [cmp(OpLt, lo(1), u(5))], [rget(1)], true)));
  bad += cnt(rbad("while (5 > i)", rloop(rinit(), [cmp(OpGt, u(5), lo(1))], [rget(1)], true)));
  bad += cnt(rbad("while (4 >= i)", rloop(rinit(), [cmp(OpGe, u(4), lo(1))], [rget(1)], true)));
  bad += cnt(rbad("exit on i >= 5", rloop(rinit(), [cmp(OpGe, lo(1), u(5))], [rget(1)], false)));
  bad += cnt(rbad("bound in a local, one too large", rloop(rinit().concat([ICopy(3, u(5))]), [cmp(OpLt, lo(1), lo(3))], [rget(1)], true)));
  bad += cnt(rbad("bound is an unknown value", rloop(rinit().concat([unk()]), [cmp(OpLt, lo(1), lo(3))], [rget(1)], true)));
  bad += cnt(rbad("bound is the length of a shorter array", rloop(rinit().concat([IArrayNew(7, false, [OInt(1), OInt(2)])]),
    [IBuiltin(Some(3), BArrLength, [lo(7)]), cmp(OpLt, lo(1), lo(3))], [rget(1), IRelease(7)], true)));
  bad += cnt(rbad("the index is incremented before the access", rloop(rinit(), [cmp(OpLt, lo(1), u(4))], [inc(), rget(1)], true)));
  bad += cnt(rbad("step 2 past the guard", rloop(rinit(), [cmp(OpLt, lo(1), u(4))], [IBinary(1, OpAdd, lo(1), u(2)), rget(1)], true)));
  bad += cnt(rbad("no guard at all", rloop(rinit(), [cmp(OpLt, lo(2), u(4))], [rget(1)], true)));
  bad += cnt(rbad("the guard is about another index", rloop(rinit().concat([ICopy(2, u(0))]), [cmp(OpLt, lo(2), u(4))], [rget(1)], true)));
  bad += cnt(rbad("the access is on the exit edge", rprog([
    bk(rinit(), TGoto(1)),
    bk([cmp(OpLt, lo(1), u(4))], TBranch(OLocal(4), 2, 3)),
    bk([inc()], TGoto(1)),
    bk([rget(1), IRelease(0)], ret())])));
  bad += cnt(rbad("a != guard says nothing about the body", rloop(rinit(), [cmp(OpNe, lo(1), u(4))], [rget(1)], true)));

  // the guard must still hold at the branch, in the same block
  bad += cnt(rbad("index redefined between the guard and the branch", rloop(rinit(), [cmp(OpLt, lo(1), u(4)), IBinary(1, OpAdd, lo(1), u(1))], [rget(1)], true)));
  bad += cnt(rbad("bound redefined between the guard and the branch", rloop(rinit().concat([ICopy(3, u(4))]),
    [cmp(OpLt, lo(1), lo(3)), ICopy(3, u(9))], [rget(1)], true)));
  bad += cnt(rbad("guard bool redefined", rloop(rinit(), [cmp(OpLt, lo(1), u(4)), ICopy(4, OBool(true))], [rget(1)], true)));
  bad += cnt(rbad("guard in an earlier block", rprog([
    bk([rnew4(), IBuiltin(Some(1), BStrLength, [OStr(0)]), cmp(OpLt, lo(1), u(4))], TGoto(1)),
    bk([], TBranch(OLocal(4), 2, 3)),
    bk([rget(1)], TGoto(3)),
    bk([IRelease(0)], ret())])));

  // eq refines the true edge, ne the false edge
  bad += cnt(rok("== 2 on the true edge", rprog([
    bk(rinit().concat([unk(), cmp(OpEq, lo(3), u(2))]), TBranch(OLocal(4), 1, 2)),
    bk([IArrayGetU(5, lo(0), lo(3)), IRelease(0)], ret()),
    bk([IRelease(0)], ret())])));
  bad += cnt(rbad("== on the false edge", rprog([
    bk(rinit().concat([unk(), cmp(OpEq, lo(3), u(2))]), TBranch(OLocal(4), 2, 1)),
    bk([IArrayGetU(5, lo(0), lo(3)), IRelease(0)], ret()),
    bk([IRelease(0)], ret())])));
  bad += cnt(rbad("== 4 on the true edge", rprog([
    bk(rinit().concat([unk(), cmp(OpEq, lo(3), u(4))]), TBranch(OLocal(4), 1, 2)),
    bk([IArrayGetU(5, lo(0), lo(3)), IRelease(0)], ret()),
    bk([IRelease(0)], ret())])));
  bad += cnt(rok("!= 1 on the false edge", rprog([
    bk(rinit().concat([unk(), cmp(OpNe, lo(3), u(1))]), TBranch(OLocal(4), 2, 1)),
    bk([IArrayGetU(5, lo(0), lo(3)), IRelease(0)], ret()),
    bk([IRelease(0)], ret())])));
  bad += cnt(rok("two guards in a row (n < 4, then j < n)", rprog([
    bk(rinit().concat([unk(), cmp(OpLt, lo(3), u(4))]), TBranch(OLocal(4), 1, 3)),
    bk([IBuiltin(Some(2), BStrLength, [OStr(0)]), cmp(OpLt, lo(2), lo(3))], TBranch(OLocal(4), 2, 3)),
    bk([IArrayGetU(5, lo(0), lo(2)), IArrayGetU(5, lo(0), lo(3)), IRelease(0)], ret()),
    bk([IRelease(0)], ret())])));
  bad += cnt(rbad("j < n with n unknown", rprog([
    bk(rinit().concat([unk(), IBuiltin(Some(2), BStrLength, [OStr(0)]), cmp(OpLt, lo(2), lo(3))]), TBranch(OLocal(4), 1, 2)),
    bk([IArrayGetU(5, lo(0), lo(2)), IRelease(0)], ret()),
    bk([IRelease(0)], ret())])));

  // transfer through add and sub
  bad += cnt(rok("n - 1", rstr([rnew4(), ICopy(3, u(4)), IBinary(8, OpSub, lo(3), u(1)), IArrayGetU(5, lo(0), lo(8)), IRelease(0)])));
  bad += cnt(rbad("n - 0", rstr([rnew4(), ICopy(3, u(4)), IBinary(8, OpSub, lo(3), u(0)), IArrayGetU(5, lo(0), lo(8)), IRelease(0)])));
  bad += cnt(rok("1 + 2", rstr([rnew4(), ICopy(3, u(1)), IBinary(8, OpAdd, lo(3), u(2)), IArrayGetU(5, lo(0), lo(8)), IRelease(0)])));
  bad += cnt(rbad("1 + 3", rstr([rnew4(), ICopy(3, u(1)), IBinary(8, OpAdd, lo(3), u(3)), IArrayGetU(5, lo(0), lo(8)), IRelease(0)])));
  bad += cnt(rbad("an unknown plus a constant", rstr([rnew4(), unk(), IBinary(8, OpAdd, lo(3), u(1)), IArrayGetU(5, lo(0), lo(8)), IRelease(0)])));
  bad += cnt(rbad("an unknown minus a constant", rstr([rnew4(), unk(), IBinary(8, OpSub, lo(3), u(1)), IArrayGetU(5, lo(0), lo(8)), IRelease(0)])));
  bad += cnt(rbad("a product is not tracked", rstr([rnew4(), ICopy(3, u(1)), IBinary(8, OpMul, lo(3), u(1)), IArrayGetU(5, lo(0), lo(8)), IRelease(0)])));
  bad += cnt(rok("copy keeps the interval", rstr([rnew4(), ICopy(3, u(3)), ICopy(8, lo(3)), IArrayGetU(5, lo(0), lo(8)), IRelease(0)])));
  bad += cnt(rbad("a huge constant", rstr([rnew4(), ICopy(3, OUsize(-1)), IArrayGetU(5, lo(0), lo(3)), IRelease(0)])));
  bad += cnt(rbad("a sum that cannot be bounded", rstr([rnew4(), ICopy(3, OUsize(1152921504606846976)), IBinary(8, OpAdd, lo(3), lo(3)),
    IArrayGetU(5, lo(0), lo(8)), IRelease(0)])));
  // a path that always traps leaves no state: nothing is justified there
  bad += cnt(rbad("after a subtraction that always underflows", rstr([rnew4(), ICopy(3, u(0)), IBinary(8, OpSub, lo(3), u(1)),
    IArrayGetU(5, lo(0), u(0)), IRelease(0)])));
  // index arithmetic on the guarded index
  bad += cnt(rok("nested loop, j = i + 1", rprog([
    bk(rinit(), TGoto(1)),
    bk([cmp(OpLt, lo(1), u(4))], TBranch(OLocal(4), 2, 6)),
    bk([IBinary(2, OpAdd, lo(1), u(1))], TGoto(3)),
    bk([cmp(OpLt, lo(2), u(4))], TBranch(OLocal(4), 4, 5)),
    bk([rget(1), rget(2), IBinary(2, OpAdd, lo(2), u(1))], TGoto(3)),
    bk([inc()], TGoto(1)),
    bk([IRelease(0)], ret())])));
  bad += cnt(rbad("nested loop, j = i + 2 and j <= 4", rprog([
    bk(rinit(), TGoto(1)),
    bk([cmp(OpLt, lo(1), u(4))], TBranch(OLocal(4), 2, 6)),
    bk([IBinary(2, OpAdd, lo(1), u(2))], TGoto(3)),
    bk([cmp(OpLe, lo(2), u(4))], TBranch(OLocal(4), 4, 5)),
    bk([rget(2), IBinary(2, OpAdd, lo(2), u(1))], TGoto(3)),
    bk([inc()], TGoto(1)),
    bk([IRelease(0)], ret())])));
  // the narrowing round: after `while (i < 4)` the index is exactly 4
  bad += cnt(rok("after the loop (needs the narrowing round)", rprog([
    bk(rinit(), TGoto(1)),
    bk([cmp(OpLt, lo(1), u(4))], TBranch(OLocal(4), 2, 3)),
    bk([inc()], TGoto(1)),
    bk([IBinary(8, OpSub, lo(1), u(1)), IArrayGetU(5, lo(0), lo(8)), IRelease(0)], ret())])));
  bad += cnt(rbad("after the loop, the index itself", rprog([
    bk(rinit(), TGoto(1)),
    bk([cmp(OpLt, lo(1), u(4))], TBranch(OLocal(4), 2, 3)),
    bk([inc()], TGoto(1)),
    bk([rget(1), IRelease(0)], ret())])));
  // joins
  bad += cnt(rok("join of 1 and 3", rprog([
    rfork(rinit()),
    bk([ICopy(1, u(1))], TGoto(3)),
    bk([ICopy(1, u(3))], TGoto(3)),
    bk([rget(1), IRelease(0)], ret())])));
  bad += cnt(rbad("join of 1 and 4", rprog([
    rfork(rinit()),
    bk([ICopy(1, u(1))], TGoto(3)),
    bk([ICopy(1, u(4))], TGoto(3)),
    bk([rget(1), IRelease(0)], ret())])));
  bad += cnt(rbad("join with a path that does not know the index", rprog([
    rfork(rinit()),
    bk([ICopy(1, u(1))], TGoto(3)),
    bk([IBuiltin(Some(1), BStrLength, [OStr(0)])], TGoto(3)),
    bk([rget(1), IRelease(0)], ret())])));
  bad += cnt(rok("join of two arrays of different length (hull [2, 4])", rprog([
    rfork([]),
    bk([rnew4(), ICopy(1, u(1))], TGoto(3)),
    bk([IArrayNew(0, false, [OInt(1), OInt(2)]), ICopy(1, u(1))], TGoto(3)),
    bk([rget(1), IRelease(0)], ret())])));
  bad += cnt(rbad("join of two arrays of different length, the longer index", rprog([
    rfork([]),
    bk([rnew4(), ICopy(1, u(3))], TGoto(3)),
    bk([IArrayNew(0, false, [OInt(1), OInt(2)]), ICopy(1, u(3))], TGoto(3)),
    bk([rget(1), IRelease(0)], ret())])));
  bad += cnt(rbad("join with a path where the array is not built here", rprog([
    rfork([]),
    bk([rnew4(), ICopy(1, u(1))], TGoto(3)),
    bk([IStructNew(0, 0, []), ICopy(1, u(1))], TGoto(3)),
    bk([rget(1), IRelease(0)], ret())])));
  // a loop whose index grows without a guard still terminates (widening) and justifies nothing
  bad += cnt(rbad("unguarded counter", rprog([
    bk(rinit(), TGoto(1)),
    bk([rget(1), inc(), unk(), cmp(OpLt, lo(3), u(2))], TBranch(OLocal(4), 1, 2)),
    bk([IRelease(0)], ret())])));
  // the array: destroyed by anything but a plain read
  bad += cnt(rbad("after arraypush", rstr([rnew4(), IArrayPush(0, OInt(5)), IArrayGetU(5, lo(0), u(0)), IRelease(0)])));
  bad += cnt(rbad("after arraypop", rstr([rnew4(), IArrayPop(9, 0), IArrayGetU(5, lo(0), u(0)), IRelease(9), IRelease(0)])));
  bad += cnt(rbad("after arrayextend", rstr([rnew4(), IArrayNew(7, false, [OInt(1)]), IArrayExtend(0, lo(7)), IArrayGetU(5, lo(0), u(0)), IRelease(7), IRelease(0)])));
  bad += cnt(rbad("after arraytake", rstr([rnew4(), IArrayTake(9, 0, u(1)), IArrayPut(0, u(1), 9), IArrayGetU(5, lo(0), u(0)), IRelease(0)])));
  bad += cnt(rbad("push in the loop body before the access", rloop(rinit(), [cmp(OpLt, lo(1), u(4))], [IArrayPush(0, OInt(5)), rget(1)], true)));
  bad += cnt(rbad("push in the loop body after the access", rloop(rinit(), [cmp(OpLt, lo(1), u(4))], [rget(1), IArrayPush(0, OInt(5))], true)));
  bad += cnt(rbad("push before the loop", rloop(rinit().concat([IArrayPush(0, OInt(5))]), [cmp(OpLt, lo(1), u(4))], [rget(1)], true)));
  bad += cnt(rbad("push on one path", rprog([
    rfork(rinit()),
    bk([IArrayPush(0, OInt(5))], TGoto(3)),
    bk([], TGoto(3)),
    bk([rget(1), IRelease(0)], ret())])));
  bad += cnt(rbad("after a dup of the array", rstr([rnew4(), IDup(9, lo(0)), IArrayGetU(5, lo(0), u(0)), IRelease(9), IRelease(0)])));
  bad += cnt(rbad("after a borrow of the array", rstr([rnew4(), IBorrow(9, 0), IArrayGetU(5, lo(0), u(0)), IRelease(0)])));
  bad += cnt(rbad("the array stored into a record", rstr([rnew4(), IStructNew(9, 0, [lo(0)]), IArrayGetU(5, lo(0), u(0)), IRelease(9)])));
  bad += cnt(rbad("the array redefined by a shorter one", rstr([rnew4(), IRelease(0), IArrayNew(0, false, [OInt(1)]), IArrayGetU(5, lo(0), u(2)), IRelease(0)])));
  bad += cnt(rok("the array redefined by a longer one", rstr([rnew4(), IRelease(0), IArrayNew(0, false, [OInt(1), OInt(2), OInt(3), OInt(4), OInt(5)]),
    IArrayGetU(5, lo(0), u(4)), IRelease(0)])));
  bad += cnt(rbad("the array redefined in the loop by an unknown", rloop(rinit(), [cmp(OpLt, lo(1), u(4))],
    [IRelease(0), IStructNew(0, 0, []), rget(1)], true)));
  bad += cnt(rok("moved to another local: the new name has the fact", rstr([rnew4(), IMove(7, 0), IArrayGetU(5, lo(7), u(3)), IRelease(7)])));
  bad += cnt(rbad("moved to another local: the old name has none", rstr([rnew4(), IMove(7, 0), IArrayGetU(5, lo(0), u(3)), IRelease(7)])));
  bad += cnt(rbad("moved to another local, then pushed", rstr([rnew4(), IMove(7, 0), IArrayPush(7, OInt(1)), IArrayGetU(5, lo(7), u(3)), IRelease(7)])));
  bad += cnt(rbad("the other array has another length", rstr([rnew4(), IArrayNew(7, false, [OInt(1)]), IArrayGetU(5, lo(7), u(3)), IRelease(7), IRelease(0)])));
  bad += cnt(rok("two arrays, each with its own length", rstr([rnew4(), IArrayNew(7, false, [OInt(1)]), IArrayGetU(5, lo(0), u(3)),
    IArrayGetU(5, lo(7), u(0)), IRelease(7), IRelease(0)])));
  // kept: reads, stores, makeunique, forwards and borrowed calls
  bad += cnt(rok("across a store into the array", rstr([rnew4(), ICopy(6, OInt(1)), IArraySet(0, u(0), lo(6)), IArrayGetU(5, lo(0), u(3)), IRelease(0)])));
  bad += cnt(rok("across makeunique", rstr([rnew4(), IMakeUnique(0), IArrayGetU(5, lo(0), u(3)), IRelease(0)])));
  bad += cnt(rok("across a checked read", rstr([rnew4(), IArrayGet(5, lo(0), u(9)), IArrayGetU(6, lo(0), u(3)), IRelease(0)])));
  bad += cnt(rok("across a call that gets the array borrowed", rstr([rnew4(), ICall(None, 1, [lo(0)]), IArrayGetU(5, lo(0), u(3)), IRelease(0)])));
  bad += cnt(rbad("across a call that gets the array owned", rstr([rnew4(), IDup(7, lo(0)), ICall(None, 3, [lo(7)]), ICall(None, 3, [lo(0)]), IArrayGetU(5, lo(0), u(3))])));
  bad += cnt(rbad("across an in/out call on the array", rstr([rnew4(), ICall(Some(5), 2, [lo(0)]), IArrayGetU(5, lo(0), u(3)), IRelease(0)])));
  bad += cnt(rbad("across a borrowed call and then an owned one", rstr([
    rnew4(), ICall(None, 1, [lo(0)]), ICall(None, 3, [lo(0)]), IArrayNew(0, false, [OInt(1)]), IArrayGetU(5, lo(0), u(3)), IRelease(0)])));
  bad += cnt(rbad("across an indirect call that mentions the array", rprog([
    bk([rnew4(), IClosure(9, 1, []), ICallIndirect(None, lo(9), [lo(0)]), IArrayGetU(5, lo(0), u(3)), IRelease(9), IRelease(0)], ret())])));
  // no shape fact
  bad += cnt(rbad("a parameter array", prog([fn("f", 1, [lr("p"), li("d")], MVoid, [bk([IArrayGetU(1, lo(0), u(0))], ret())])])));
  bad += cnt(rbad("an array returned by a call", prog([
    fn("f", 0, [lr("a"), li("d")], MVoid, [bk([ICall(Some(0), 1, []), IArrayGetU(1, lo(0), u(0)), IRelease(0)], ret())]),
    fn("mk", 0, [lr("a")], MRef, [bk([IArrayNew(0, false, [OInt(1)])], TReturn(Some(lo(0))))])])));
  bad += cnt(rbad("an array read from a record", rstr([IStructNew(9, 0, [OInt(1)]), IGetField(0, lo(9), 0), IArrayGetU(5, lo(0), u(0)), IRelease(9)])));
  bad += cnt(rbad("a string", rstr([ICopy(0, OStr(0)), IArrayGetU(5, lo(0), u(0))])));
  return bad;
}

// Unique receivers and results across calls, rules U2-U5 (docs/mir.md v2.7, ADR-0038 lever 2 T5).
function fnIOU(name: string, uin: bool, uout: bool, locals: MLocal[], ret: MType, blocks: MBlock[]): MFunction {
  return MFunction { name: name, paramCount: 1, paramOwned: [true], inout: true, uniqueIn: uin, uniqueOut: uout, locals: locals, ret: ret, blocks: blocks };
}

// bump(owned this): int, in/out. With `uin` it writes through the receiver without its own makeunique (rule U2).
function bump(uin: bool, uout: bool): MFunction {
  let ins: Instr[] = [IMove(1, 0)];
  if (!uin) { ins.push(IMakeUnique(1)); }
  ins.push(ISetField(1, 0, OInt(1)));
  ins.push(IMove(0, 1));
  ins.push(ICopy(2, OInt(7)));
  return fnIOU("bump", uin, uout, [lr("this"), lr("t"), li("v")], MInt, [bk(ins, TReturn(Some(OLocal(2))))]);
}

// f: x = fresh record (Unique), then `body`, then the call bump(x) (callee index 1), then `after`, then release x.
function callBump(callee: MFunction, before: Instr[], after: Instr[]): MProgram {
  let ins: Instr[] = [IStructNew(0, 0, [OInt(1)])];
  for (const i of before) { ins.push(i); }
  ins.push(ICall(Some(1), 1, [OLocal(0)]));
  for (const i of after) { ins.push(i); }
  ins.push(IRelease(0));
  return prog([fn("f", 0, [lr("x"), li("r"), lr("t")], MVoid, [bk(ins, ret())]), callee]);
}

// mk(): ref, a function that builds and returns a fresh record; `uout` declares it
function mkFn(uout: bool): MFunction {
  return MFunction { name: "mk", paramCount: 0, paramOwned: [], inout: false, uniqueIn: false, uniqueOut: uout,
    locals: [lr("s")], ret: MRef, blocks: [bk([IStructNew(0, 0, [OInt(1)])], TReturn(Some(OLocal(0))))] };
}

function uniqueCases(): usize {
  let bad: usize = 0;
  const need = "to be Unique";
  // accepted
  bad += cnt(pos("unique-in callee, Unique receiver at the call, no makeunique anywhere", callBump(bump(true, true), [], [ISetField(0, 0, OInt(2))])));
  bad += cnt(pos("unique-out callee gives a Unique receiver back", callBump(bump(false, true), [], [ISetField(0, 0, OInt(2))])));
  bad += cnt(pos("unique-in alone", callBump(bump(true, false), [], [])));
  bad += cnt(pos("U4: makeunique before the call makes the receiver Unique", prog([
    fn("f", 0, [lr("x"), li("r"), lr("t")], MVoid, [bk([
      IStructNew(0, 0, [OInt(1)]), IDup(2, OLocal(0)), IMakeUnique(0), ICall(Some(1), 1, [OLocal(0)]), IRelease(2), IRelease(0)], ret())]),
    bump(true, true)])));
  bad += cnt(pos("U5: the result of a unique-out function is Unique", prog([
    fn("f", 0, [lr("x")], MVoid, [bk([ICall(Some(0), 1, []), ISetField(0, 0, OInt(2)), IRelease(0)], ret())]), mkFn(true)])));
  // rejected
  bad += cnt(neg("U4: receiver is Owned (a call result without unique-out)", prog([
    fn("f", 0, [lr("x"), li("r")], MVoid, [bk([ICall(Some(0), 2, []), ICall(Some(1), 1, [OLocal(0)]), IRelease(0)], ret())]),
    bump(true, false), mkFn(false)]), need));
  bad += cnt(neg("U4: the caller duplicated the receiver before the call", callBump(bump(true, false), [IDup(2, OLocal(0))], [IRelease(2)]), need));
  bad += cnt(neg("U4: the receiver was borrowed whole before the call", callBump(bump(true, false), [IBorrow(2, 0)], []), need));
  bad += cnt(neg("U4: the receiver is Owned after an earlier call of a non-unique-out function", prog([
    fn("f", 0, [lr("x"), li("r")], MVoid, [bk([
      IStructNew(0, 0, [OInt(1)]), ICall(Some(1), 2, [OLocal(0)]), ICall(Some(1), 1, [OLocal(0)]), IRelease(0)], ret())]),
    bump(true, false), bump(false, false)]), need));
  bad += cnt(neg("U3: an inout function that declares unique-out and returns an Owned receiver", prog([
    fn("f", 0, [lr("x"), li("r")], MVoid, [bk([IStructNew(0, 0, [OInt(1)]), ICall(Some(1), 1, [OLocal(0)]), IRelease(0)], ret())]),
    fnIOU("lazy", false, true, [lr("this"), lr("t")], MInt, [bk([IMove(1, 0), IMove(0, 1)], TReturn(Some(OInt(3))))])]), "not Unique (rule U3)"));
  bad += cnt(neg("U3: the receiver was duplicated before the return", prog([
    fn("f", 0, [lr("x"), li("r")], MVoid, [bk([IStructNew(0, 0, [OInt(1)]), ICall(Some(1), 1, [OLocal(0)]), IRelease(0)], ret())]),
    fnIOU("shared", false, true, [lr("this"), lr("t"), lr("d")], MInt, [bk([
      IMove(1, 0), IMakeUnique(1), IDup(2, OLocal(1)), IMove(0, 1), IRelease(2)], TReturn(Some(OInt(3))))])]), "not Unique (rule U3)"));
  bad += cnt(neg("U3: a function with a reference result returns an Owned local", prog([
    fn("f", 0, [lr("x")], MVoid, [bk([ICall(Some(0), 1, []), IRelease(0)], ret())]),
    MFunction { name: "dupd", paramCount: 0, paramOwned: [], inout: false, uniqueIn: false, uniqueOut: true, locals: [lr("s"), lr("d")], ret: MRef,
      blocks: [bk([IStructNew(0, 0, [OInt(1)]), IDup(1, OLocal(0)), IRelease(0)], TReturn(Some(OLocal(1))))] }]), "not Unique (rule U3)"));
  bad += cnt(neg("U3: a function with a reference result returns a string literal", prog([
    fn("f", 0, [lr("x")], MVoid, [bk([ICall(Some(0), 1, []), IRelease(0)], ret())]),
    MFunction { name: "lit", paramCount: 0, paramOwned: [], inout: false, uniqueIn: false, uniqueOut: true, locals: [], ret: MRef,
      blocks: [bk([], TReturn(Some(OStr(0))))] }]), "not a local"));
  bad += cnt(neg("U5 then dup: the caller duplicated the result and stores through the original", prog([
    fn("f", 0, [lr("x"), lr("y")], MVoid, [bk([
      ICall(Some(0), 1, []), IDup(1, OLocal(0)), ISetField(0, 0, OInt(2)), IRelease(1), IRelease(0)], ret())]),
    mkFn(true)]), need));
  bad += cnt(neg("U5 then dup of the receiver of an in/out call", callBump(bump(false, true), [], [IDup(2, OLocal(0)), ISetField(0, 0, OInt(2)), IRelease(2)]), need));
  bad += cnt(neg("without unique-out the result stays Owned", prog([
    fn("f", 0, [lr("x")], MVoid, [bk([ICall(Some(0), 1, []), ISetField(0, 0, OInt(2)), IRelease(0)], ret())]), mkFn(false)]), need));
  bad += cnt(neg("without unique-out the receiver stays Owned", callBump(bump(false, false), [], [ISetField(0, 0, OInt(2))]), need));
  // a borrowed argument the in/out callee may keep in the receiver it hands back is not Unique after the call
  bad += cnt(neg("an in/out call demotes its borrowed arguments", prog([
    fn("f", 0, [lr("r"), lr("x"), li("v")], MVoid, [bk([
      IStructNew(0, 0, [OInt(1)]), IStructNew(1, 0, [OInt(1)]), ICall(Some(2), 1, [OLocal(0), OLocal(1)]),
      ISetField(1, 0, OInt(2)), IRelease(1), IRelease(0)], ret())]),
    MFunction { name: "keep", paramCount: 2, paramOwned: [true, false], inout: true, uniqueIn: false, uniqueOut: false,
      locals: [lr("this"), lr("item"), lr("t")], ret: MInt, blocks: [bk([IMove(2, 0), IMove(0, 2)], TReturn(Some(OInt(0))))] }]), need));
  // U2 and the flags themselves
  bad += cnt(neg("unique-in on a function without a receiver", prog([
    MFunction { name: "f", paramCount: 1, paramOwned: [true], inout: false, uniqueIn: true, uniqueOut: false, locals: [lr("p")], ret: MVoid,
      blocks: [bk([IRelease(0)], ret())] }]), "only an inout function"));
  bad += cnt(neg("unique-out on a function that is neither inout nor returns a reference", prog([
    MFunction { name: "f", paramCount: 0, paramOwned: [], inout: false, uniqueIn: false, uniqueOut: true, locals: [], ret: MInt,
      blocks: [bk([], TReturn(Some(OInt(1))))] }]), "inout or return a reference"));
  bad += cnt(neg("a unique-in function is never a closure target", prog([
    fn("f", 0, [lr("c")], MVoid, [bk([IClosure(0, 1, []), IRelease(0)], ret())]), bump(true, false)]), "only borrowed parameters"));
  bad += cnt(neg("a unique-in function is never a vtable entry", MProgram { functions: [fn("f", 0, [], MVoid, [bk([], ret())]), bump(true, false)],
    strings: ["s"], main: 0, vtables: [MVTable { name: "vt", funcs: [1] }], inlineFns: [] }, "only borrowed parameters"));
  bad += cnt(neg("main is not unique-in", prog([fnIOU("main", true, false, [lr("this")], MVoid, [bk([], ret())])]), "cannot be a unique-in"));
  return bad;
}

function main(): void {
  const bad = robustnessCases() + spanCases() + negatives1() + negatives2() + positives() + ownedCases() + closureCases() + ifaceCases() + handleCases() + grantCases() + netCases() + netMoveCases() + taskGrantCases() + inoutCases() + forwardCases() + uncheckedCases() + fieldCases() + rangeCases() + uniqueCases();
  if (bad > 0) {
    console.log(bad.toString() + " case(s) FAILED");
    exit(1);
    return;
  }
  console.log("all cases passed");
}
