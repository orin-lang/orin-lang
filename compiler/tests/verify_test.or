// Unit tests of the ownership verifier's classes and predicates (rewrite step 3b): the lattice of per-local states
// (`joinLs`, `lsLeq`), the class `State` (holes, join), `Transfer` (one block run: borrow invalidation, holes),
// `Fixpoint`, the reports, the shared MIR well-formedness predicates (compiler/mir) and the HIR integer kinds. Run:
// `orin test compiler/tests/verify_test.or --runtime runtime/core`. `orin test` checks contracts at run time, so the class
// invariants and the `@Requires` / `@Ensures` of every method called below run too; a broken invariant is a trap.

import { assert, assertEqString, assertEqUsize, assertEqBool } from "std:test";
import { span } from "../diag";
import {
  Type, intKindOf, kindType, kindName, kindLo, kindHi, kindBits, kindNarrow, kindSigned,
  kindUnsigned64, pow2, isKindNumber, CallSite, isEvidence, isCallVia,
} from "../hir";
import {
  MProgram, MFunction, MLocal, MType, MBlock, MVTable, Instr, Terminator, Operand, plainBlock,
  noSpan, hasSpan, dstOf, instrLocals, successors, instrInRange, termInRange, isWellFormedFunction,
  isWellFormedProgram, paramsWellFormed, spansAligned,
} from "../mir";
import {
  verify, VerifyReport, VerifyIssue, blockInStates, State, HoleEntry, HoleKey, mk, lsKind, joinLs,
  lsLeq, lsEq, isKind, isLive, holeAnyIn, holeHasIn, holeMayIn, holesInRange, borrowsFlatIn,
  Fixpoint, Transfer, Cx, step, noRevival, defsOf, rootsLive, issuesAt, issuePlaced, reportPlaced,
  reachClosed, statesSized, wfFunction, wfInstr, KDead, KOwned, KUnique, KImm, KBorrowed, KParam,
  KInit, KMaybeLeak, KMaybeDead, KOpen, KMaybeOpen,
} from "../verify";

// ---------------------------------------------------------------- builders

function lr(n: string): MLocal {
  return MLocal { name: n, ty: MRef };
}

function li(n: string): MLocal {
  return MLocal { name: n, ty: MInt };
}

function lb(n: string): MLocal {
  return MLocal { name: n, ty: MBool };
}

function fnOf(name: string, params: usize, locals: MLocal[], blocks: MBlock[]): MFunction {
  let owned: bool[] = [];
  let i: usize = 0;
  while (i < params) {
    owned.push(false);
    i += 1;
  }
  return MFunction {
    name: name,
    paramCount: params,
    paramOwned: owned,
    inout: false, uniqueIn: false, uniqueOut: false,
    locals: locals,
    ret: MVoid,
    blocks: blocks,
  };
}

function progOf(fs: MFunction[]): MProgram {
  return MProgram { functions: fs, strings: ["s"], main: 0, vtables: [], inlineFns: [] };
}

function straight(params: usize, locals: MLocal[], instrs: Instr[]): MProgram {
  return progOf([fnOf("f", params, locals, [plainBlock(instrs, TReturn(None))])]);
}

// Every state of the lattice over two locals: the eleven kinds, Borrowed with two different sources.
function allStates(): int[] {
  let out: int[] = [];
  let k = KDead;
  while (k <= KMaybeOpen) {
    if (k == KBorrowed) {
      out.push(mk(k, 0));
      out.push(mk(k, 1));
    } else {
      out.push(mk(k, 0));
    }
    k += 1;
  }
  return out;
}

function hasMsg(r: VerifyReport, needle: string): bool {
  return r.errors.some(e => e.message.includes(needle));
}

// ---------------------------------------------------------------- the per-local lattice

@Test
function joinIsCommutativeIdempotentAndAnUpperBound(): void {
  const all = allStates();
  assertEqUsize(all.length, 12, "eleven kinds, Borrowed twice");
  for (const a of all) {
    assert(lsEq(joinLs(a, a), a), "idempotent");
    for (const b of all) {
      const j = joinLs(a, b);
      assert(lsEq(j, joinLs(b, a)), "commutative");
      assert(lsLeq(a, j) && lsLeq(b, j), "an upper bound");
      assert(isKind(lsKind(j)), "a kind");
    }
  }
}

@Test
function joinIsAssociative(): void {
  // Associativity is what makes the fixpoint's result independent of the worklist order.
  const all = allStates();
  for (const a of all) {
    for (const b of all) {
      for (const c of all) {
        assert(lsEq(joinLs(joinLs(a, b), c), joinLs(a, joinLs(b, c))), "associative");
      }
    }
  }
}

@Test
function orderIsAPartialOrderAndTheJoinIsLeast(): void {
  const all = allStates();
  for (const a of all) {
    assert(lsLeq(a, a), "reflexive");
    for (const b of all) {
      if (lsLeq(a, b) && lsLeq(b, a)) {
        assert(lsEq(a, b), "antisymmetric");
      }
      for (const c of all) {
        if (lsLeq(a, b) && lsLeq(b, c)) {
          assert(lsLeq(a, c), "transitive");
        }
        // the join is the least upper bound: below every common upper bound
        if (lsLeq(a, c) && lsLeq(b, c)) {
          assert(lsLeq(joinLs(a, b), c), "least");
        }
      }
    }
  }
}

@Test
function joinRules(): void {
  assertEqBool(
    lsKind(joinLs(mk(KUnique, 0), mk(KImm, 0))) == KOwned,
    true,
    "owned-like states join to Owned",
  );
  assertEqBool(
    lsKind(joinLs(mk(KOwned, 0), mk(KDead, 0))) == KMaybeLeak,
    true,
    "owned on one path only: MaybeLeak",
  );
  assertEqBool(
    lsKind(joinLs(mk(KInit, 0), mk(KDead, 0))) == KMaybeDead,
    true,
    "dead on one path: MaybeDead",
  );
  assertEqBool(
    lsKind(joinLs(mk(KOpen, 0), mk(KDead, 0))) == KMaybeOpen,
    true,
    "open on one path: MaybeOpen",
  );
  assertEqBool(
    lsKind(joinLs(mk(KBorrowed, 0), mk(KBorrowed, 1))) == KMaybeDead,
    true,
    "different borrow sources: poisoned",
  );
  assertEqBool(
    lsKind(joinLs(mk(KBorrowed, 1), mk(KBorrowed, 1))) == KBorrowed,
    true,
    "the same borrow survives",
  );
  assert(
    !isLive(KMaybeLeak) && !isLive(KMaybeDead) && !isLive(KMaybeOpen) && !isLive(KDead),
    "poisoned and dead are not live",
  );
  assert(isLive(KParam) && isLive(KOpen) && isLive(KImm), "readable states are live");
}

// ---------------------------------------------------------------- State

function hole(x: usize, sym: bool, idx: usize): HoleEntry {
  return HoleEntry { obj: x, sym: sym, idx: idx };
}

@Test
function aReleaseKillsExactlyTheAliasesOfTheReleasedLocal(): void {
  const p = straight(0, [lr("a"), lr("b"), lr("c"), lr("d")], [IRelease(0)]);
  const st = new State([mk(KUnique, 0), mk(KBorrowed, 0), mk(KBorrowed, 3), mk(KOwned, 0)], []);
  let t = new Transfer(p, p.functions[0], 0, 0, st, [], []);
  t.step(IRelease(0));
  const s = t.state();
  assertEqBool(s.kind(0) == KDead && s.kind(1) == KDead, true, "released, and its alias dies");
  assertEqBool(s.kind(2) == KBorrowed && s.srcOf(2) == 3, true, "the alias of l3 lives");
  assertEqBool(s.kind(3) == KOwned, true, "l3 is untouched");
  assert(s.borrowsFlat(), "still flat");
}

@Test
function holesAreTrackedPerObjectAndKey(): void {
  const hs = [hole(0, false, 3), hole(2, true, 1)];
  assert(holeAnyIn(hs, 0) && !holeAnyIn(hs, 1), "a hole of l0, none of l1");
  assert(holeHasIn(hs, 0, HoleKey { sym: false, idx: 3 }), "exact key");
  assert(!holeHasIn(hs, 0, HoleKey { sym: false, idx: 4 }), "other slot is not taken");
  assert(
    !holeMayIn(hs, 0, HoleKey { sym: false, idx: 4 }),
    "a different constant slot cannot alias",
  );
  assert(holeMayIn(hs, 0, HoleKey { sym: true, idx: 1 }), "a symbolic index may alias any slot");
  assert(holeMayIn(hs, 2, HoleKey { sym: false, idx: 9 }), "a symbolic hole may be any slot");
  assert(holesInRange(hs, 3) && !holesInRange(hs, 2), "names locals below 3, not below 2");
}

@Test
function takeAndPutOpenAndCloseAHole(): void {
  // a = struct {s}; t = takefield a.0; putfield a.0 = t
  const p = straight(
    0,
    [lr("a"), lr("t")],
    [IStructNew(0, 0, [OStr(0)]), ITakeField(1, 0, 0), IPutField(0, 0, 1), IRelease(0)],
  );
  const f = p.functions[0];
  let t = new Transfer(p, f, 0, 0, new State([mk(KDead, 0), mk(KDead, 0)], []), [], []);
  t.step(f.blocks[0].instrs[0]);
  t.ins = 1;
  t.step(f.blocks[0].instrs[1]);
  assert(holeHasIn(t.holes, 0, HoleKey { sym: false, idx: 0 }), "slot 0 of a is taken");
  t.ins = 2;
  t.step(f.blocks[0].instrs[2]);
  assertEqUsize(t.holes.length, 0, "put back");
  assertEqUsize(t.errs.length, 0, "no error");
  assertEqUsize(verify(p).errors.length, 0, "and the function verifies");
}

@Test
function stateJoinUnitesHolesAndBoundsBothSides(): void {
  const a = new State([mk(KUnique, 0), mk(KInit, 0)], [hole(0, false, 1)]);
  const b = new State([mk(KImm, 0), mk(KDead, 0)], [hole(0, false, 2), hole(0, false, 1)]);
  const j = a.join(b);
  assertEqUsize(j.holes.length, 2, "union without repeats");
  assert(a.leq(j) && b.leq(j), "an upper bound of both");
  assertEqBool(j.kind(0) == KOwned && j.kind(1) == KMaybeDead, true, "per local");
  assert(j.join(j).equals(j), "idempotent");
  assert(a.join(b).equals(b.join(a)), "the same state either way (holes compared as sets)");
  assert(!a.equals(j), "the join added information");
}

// ---------------------------------------------------------------- Transfer

@Test
function transferReportsAtTheInstructionAndRevivesNothing(): void {
  // l0 = struct; l1 = borrow l0; release l0; t = tag l1  -> use of a dead alias at i3
  const p = straight(
    0,
    [lr("a"), lr("b"), li("t")],
    [IStructNew(0, 0, []), IBorrow(1, 0), IRelease(0), ITag(2, OLocal(1))],
  );
  const f = p.functions[0];
  let t = new Transfer(
    p,
    f,
    0,
    0,
    new State([mk(KDead, 0), mk(KDead, 0), mk(KDead, 0)], []),
    [],
    [],
  );
  t.run();
  assertEqUsize(t.errs.length, 1, "one error");
  assertEqUsize(t.errs[0].instr, 3, "at the tag");
  assert(t.errs[0].message.includes("dead"), "use of a dead local");
  assert(issuesAt(t.errs, 0, f, 0, 3), "names the instruction");
  assertEqBool(
    t.state().kind(0) == KDead && t.state().kind(1) == KDead,
    true,
    "released, alias invalidated",
  );
  assertEqBool(t.state().kind(2) == KInit, true, "the tag is defined even after the error");
}

@Test
function borrowsOfBorrowsAreRootedAtTheOwner(): void {
  // l1 = borrow l0; l2 = borrow l1 -> l2 is Borrowed(l0), so releasing l0 kills both
  const p = straight(1, [lr("p"), lr("b"), lr("c")], [IBorrow(1, 0), IBorrow(2, 1)]);
  const f = p.functions[0];
  let t = new Transfer(
    p,
    f,
    0,
    0,
    new State([mk(KParam, 0), mk(KDead, 0), mk(KDead, 0)], []),
    [],
    [],
  );
  t.run();
  assertEqUsize(t.errs.length, 0, "fine");
  assertEqBool(
    t.state().kind(2) == KBorrowed && t.state().srcOf(2) == 0,
    true,
    "rooted at the parameter, not at l1",
  );
  assert(borrowsFlatIn(t.ls), "flat");
}

@Test
function stepReplaysOneInstructionForTheOptimiser(): void {
  const p = straight(
    0,
    [lr("a"), lr("b")],
    [IStructNew(0, 0, []), IDup(1, OLocal(0)), IRelease(1), IRelease(0)],
  );
  const f = p.functions[0];
  let cx = Cx {
    prog: p,
    f: f,
    blk: 0,
    ins: 0,
    st: new State([mk(KDead, 0), mk(KDead, 0)], []),
    errs: [],
    warns: [],
  };
  cx = step(cx, f.blocks[0].instrs[0]);
  assertEqBool(cx.st.kind(0) == KUnique, true, "a new struct is Unique");
  cx.ins = 1;
  const before = cx.st;
  cx = step(cx, f.blocks[0].instrs[1]);
  assertEqBool(cx.st.kind(0) == KOwned && cx.st.kind(1) == KOwned, true, "dup demotes the source");
  assert(
    noRevival(before.ls, cx.st.ls, defsOf(p, f.blocks[0].instrs[1])),
    "only the destination came to life",
  );
  assert(!noRevival(before.ls, cx.st.ls, []), "the destination did come to life");
}

@Test
function aPushOntoAReleasedArrayDoesNotReviveIt(): void {
  // a = []; release a; push a, 1; push a, 2 -> both pushes are uses of a dead array; `a` must stay dead after the first
  // (`noRevival`), so the second is reported too
  const p = straight(
    0,
    [lr("a")],
    [IArrayNew(0, false, []), IRelease(0), IArrayPush(0, OInt(1)), IArrayPush(0, OInt(2))],
  );
  const r = verify(p);
  assertEqUsize(r.errors.length, 2, "both pushes are rejected");
  assertEqUsize(r.errors[1].instr, 3, "the second at its own instruction");
}

@Test
function anInoutCallDefinesItsReceiverArgument(): void {
  // g(inout l0) returns its receiver; f: a = struct; g(a): `a` is consumed and re-defined Owned by the call (v1.10)
  const g = MFunction {
    name: "g",
    paramCount: 1,
    paramOwned: [true],
    inout: true, uniqueIn: false, uniqueOut: false,
    locals: [lr("r")],
    ret: MVoid,
    blocks: [plainBlock([], TReturn(None))],
  };
  const call = ICall(None, 1, [OLocal(0)]);
  const f = fnOf(
    "f",
    0,
    [lr("a")],
    [plainBlock([IStructNew(0, 0, []), call, IRelease(0)], TReturn(None))],
  );
  const p = progOf([f, g]);
  assertEqUsize(verify(p).errors.length, 0, "verifies");
  assertEqUsize(
    defsOf(p, call).length,
    1,
    "the call has no destination but defines its in/out argument",
  );
  assertEqUsize(defsOf(p, call)[0], 0, "local 0");
  // a call on a released receiver is an error; the call still re-defines the receiver (Owned), which `noRevival` allows
  // because `defsOf` lists it (with `dstOf` alone the contract of `Transfer.step` would trap here)
  const bad = fnOf(
    "f",
    0,
    [lr("a")],
    [plainBlock([IStructNew(0, 0, []), IRelease(0), call], TReturn(None))],
  );
  assert(verify(progOf([bad, g])).errors.length > 0, "use of a released receiver is rejected");
}

@Test
function aliasesHaveLiveRootsAndTheJoinAllocatesOnlyOnChange(): void {
  assert(rootsLive([mk(KOwned, 0), mk(KBorrowed, 0)]), "an alias of an owned local");
  assert(!rootsLive([mk(KDead, 0), mk(KBorrowed, 0)]), "an alias of a dead local");
  const a = new State([mk(KOwned, 0), mk(KInit, 0)], []);
  assert(a.joinIfChanged(a).isNone(), "joining a state with itself changes nothing");
  const b = new State([mk(KDead, 0), mk(KInit, 0)], []);
  assert(a.joinIfChanged(b).unwrap().equals(a.join(b)), "otherwise the join");
  const h = new State([mk(KOwned, 0), mk(KInit, 0)], [hole(0, false, 1)]);
  assert(a.joinIfChanged(h).isSome(), "a new hole is a change");
  assert(h.joinIfChanged(a).isNone(), "a hole the state already has is not");
}

@Test
function arrayExtendKeepsTheArrayOwnedAndReadsItsArgument(): void {
  // a = []; b = []; arrayextend a, b; release b; release a
  const ok = straight(
    0,
    [lr("a"), lr("b")],
    [
      IArrayNew(0, false, []),
      IArrayNew(1, false, []),
      IArrayExtend(0, OLocal(1)),
      IRelease(1),
      IRelease(0),
    ],
  );
  assertEqUsize(verify(ok).errors.length + verify(ok).warnings.length, 0, "fine, nothing leaks");
  // extending by a borrow of the array itself is rejected
  const alias = straight(
    0,
    [lr("a"), lr("b")],
    [IArrayNew(0, false, []), IBorrow(1, 0), IArrayExtend(0, OLocal(1)), IRelease(0)],
  );
  assert(hasMsg(verify(alias), "is borrowed from the array being extended"), "self alias");
}

@Test
function noRevivalSeesAResurrectedLocal(): void {
  const before = [mk(KDead, 0), mk(KMaybeDead, 0)];
  const same = [mk(KDead, 0), mk(KMaybeDead, 0)];
  const revived = [mk(KDead, 0), mk(KOwned, 0)];
  assert(noRevival(before, same, []), "unchanged");
  assert(!noRevival(before, revived, []), "a poisoned local became Owned without a definition");
  assert(noRevival(before, revived, [1]), "fine when it is the destination");
}

// ---------------------------------------------------------------- Fixpoint and reports

// b0: branch c ? b1 : b2; b1: l1 = struct; goto b3; b2: goto b3; b3: return; b4 (unreachable): return
function diamond(): MProgram {
  const blocks = [
    plainBlock([], TBranch(OLocal(0), 1, 2)),
    plainBlock([IStructNew(1, 0, [])], TGoto(3)),
    plainBlock([], TGoto(3)),
    plainBlock([], TReturn(None)),
    plainBlock([], TReturn(None)),
  ];
  return progOf([fnOf("f", 1, [lb("c"), lr("x")], blocks)]);
}

@Test
function fixpointJoinsAtTheMergeAndLeavesDeadCodeUnreached(): void {
  const p = diamond();
  const f = p.functions[0];
  let fx = new Fixpoint(p, f);
  fx.run();
  assertEqUsize(fx.pending(), 0, "nothing left in the worklist");
  assert(fx.isStable(), "stable");
  assert(reachClosed(f, fx.ins) && statesSized(fx.ins, 2), "closed, sized");
  assert(fx.ins[4].isNone(), "block 4 is unreachable");
  assertEqBool(fx.ins[3].unwrap().kind(1) == KMaybeLeak, true, "owned on one path only");
  const r = verify(p);
  assertEqUsize(r.errors.length, 0, "a leak is not an error");
  assertEqUsize(r.warnings.length, 1, "but a warning at the return");
  assert(reportPlaced(p, r.warnings), "placed");
  assertEqUsize(blockInStates(p, f).length, 5, "one in-state slot per block");
}

@Test
function fixpointRevisitsALoopHeadWhoseInStateGrew(): void {
  // b0: x = struct; goto b1.  b1: branch c ? b2 : b3.  b2: release x; goto b1.  b3: release x; return.
  // The back edge makes x MaybeLeak at b1, which must reach b3: a worklist that did not re-queue b1 would leave b3 at
  // Unique (and `isStable` would fail).
  const blocks = [
    plainBlock([IStructNew(1, 0, [])], TGoto(1)),
    plainBlock([], TBranch(OLocal(0), 2, 3)),
    plainBlock([IRelease(1)], TGoto(1)),
    plainBlock([IRelease(1)], TReturn(None)),
  ];
  const p = progOf([fnOf("f", 1, [lb("c"), lr("x")], blocks)]);
  let fx = new Fixpoint(p, p.functions[0]);
  fx.run();
  assertEqBool(fx.ins[1].unwrap().kind(1) == KMaybeLeak, true, "poisoned at the loop head");
  assertEqBool(fx.ins[3].unwrap().kind(1) == KMaybeLeak, true, "and after the loop");
  assert(
    hasMsg(verify(p), "dead or inconsistent on some incoming path"),
    "the release after the loop is rejected",
  );
}

@Test
function redefiningARootKillsItsAliases(): void {
  // l1 = struct; l2 = borrow l1; l1 = borrow p: l2 must die, or it would be an alias of an alias (and dangle).
  const p = straight(
    1,
    [lr("p"), lr("a"), lr("b"), li("t")],
    [IStructNew(1, 0, []), IBorrow(2, 1), IBorrow(1, 0), ITag(3, OLocal(2))],
  );
  const r = verify(p);
  assert(hasMsg(r, "use of `b` which is dead"), "the old alias is dead");
  let t = new Transfer(
    p,
    p.functions[0],
    0,
    0,
    new State([mk(KParam, 0), mk(KDead, 0), mk(KDead, 0), mk(KDead, 0)], []),
    [],
    [],
  );
  t.run();
  assert(borrowsFlatIn(t.ls), "flat");
}

@Test
function reportsNameExistingPositions(): void {
  // a function-level error, an instruction error, a terminator error, the program and a vtable
  const bad = MFunction {
    name: "g",
    paramCount: 2,
    paramOwned: [false],
    inout: false, uniqueIn: false, uniqueOut: false,
    locals: [lr("p"), lr("q")],
    ret: MVoid,
    blocks: [plainBlock([], TReturn(None))],
  };
  const h = fnOf("h", 0, [lr("a")], [plainBlock([IRelease(7)], TGoto(9))]);
  const p = MProgram {
    functions: [h, bad],
    strings: [],
    main: 5,
    vtables: [MVTable { name: "vt", funcs: [8] }],
    inlineFns: [],
  };
  const r = verify(p);
  assert(reportPlaced(p, r.errors), "every error is placed");
  assert(
    hasMsg(r, "main function index out of range")
        && hasMsg(r, "vtable entry: function index out of range"),
    "program level",
  );
  assert(hasMsg(r, "paramOwned length differs from paramCount"), "function level");
  assert(hasMsg(r, "IRelease") && hasMsg(r, "TGoto"), "instruction and terminator");
  for (const e of r.errors) {
    if (e.func == "g") {
      assertEqUsize(e.block + e.instr, 0, "a function-level error is at 0/0");
      assert(!hasSpan(e.span), "without a span");
    }
    if (e.func == "h" && e.message.includes("TGoto")) {
      assertEqUsize(e.instr, 1, "the terminator is instruction instrs.length");
    }
  }
  assert(!isWellFormedProgram(p), "and the shared predicate agrees");
  const fake = VerifyIssue { func: "h", block: 3, instr: 0, message: "x", span: noSpan() };
  assert(!issuePlaced(h, fake), "block 3 does not exist");
}

@Test
function verifierWellFormednessImpliesTheSharedPredicate(): void {
  const good = diamond();
  assertEqUsize(verify(good).errors.length, 0, "verifies");
  assert(isWellFormedProgram(good), "well-formed");
  // an out-of-range string, local and block: each one is a verifier error and breaks the shared predicate
  const cases: MProgram[] = [
    straight(0, [lr("a")], [ICopy(0, OStr(4))]),
    straight(0, [lr("a")], [IRelease(3)]),
    progOf([fnOf("f", 0, [lr("a")], [plainBlock([], TGoto(1))])]),
  ];
  for (const p of cases) {
    assert(verify(p).errors.length > 0, "rejected");
    assert(!isWellFormedFunction(p, p.functions[0]), "ill-formed");
  }
}

// ---------------------------------------------------------------- defects fixed in step 3b

@Test
function aCallOfAnIllFormedCalleeIsReportedNotACrash(): void {
  // g claims two parameters but has one local: checking the call used to read g.locals[1] (out of range)
  const g = MFunction {
    name: "g",
    paramCount: 2,
    paramOwned: [false, false],
    inout: false, uniqueIn: false, uniqueOut: false,
    locals: [lr("p")],
    ret: MVoid,
    blocks: [plainBlock([], TReturn(None))],
  };
  const f = fnOf(
    "f",
    0,
    [lr("a"), lr("b")],
    [plainBlock([ICall(None, 1, [OStr(0), OStr(0)])], TReturn(None))],
  );
  const r = verify(progOf([f, g]));
  assert(hasMsg(r, "ICall: callee g has more parameters than locals"), "the call is rejected");
  assert(hasMsg(r, "paramCount exceeds the number of locals"), "and g itself");
}

@Test
function aClosureOrVtableTargetWithoutLocalsIsReportedNotACrash(): void {
  const g = MFunction {
    name: "g",
    paramCount: 1,
    paramOwned: [false],
    inout: false, uniqueIn: false, uniqueOut: false,
    locals: [],
    ret: MVoid,
    blocks: [plainBlock([], TReturn(None))],
  };
  const f = fnOf("f", 0, [lr("c")], [plainBlock([IClosure(0, 1, []), IRelease(0)], TReturn(None))]);
  const p = MProgram {
    functions: [f, g],
    strings: [],
    main: 0,
    vtables: [MVTable { name: "vt", funcs: [1] }],
    inlineFns: [],
  };
  const r = verify(p);
  assert(
    hasMsg(r, "IClosure: the lifted function must take the environment record"),
    "closure target",
  );
  assert(hasMsg(r, "vtable entry g must take the boxed value"), "vtable entry");
}

// ---------------------------------------------------------------- shared MIR predicates

@Test
function sharedPredicatesOfInstructionsAndTerminators(): void {
  const p = progOf([]);
  assert(instrInRange(p, 2, IMove(0, 1)) && !instrInRange(p, 1, IMove(0, 1)), "locals");
  assert(
    instrInRange(p, 1, ICopy(0, OStr(0))) && !instrInRange(p, 1, ICopy(0, OStr(1))),
    "strings",
  );
  assert(!instrInRange(p, 1, ICall(None, 0, [])), "functions");
  assert(
    instrLocals(IArrayPop(3, 1)).includes(3) && dstOf(IArrayPop(3, 1)).unwrap() == 3,
    "destination",
  );
  assert(dstOf(IRelease(0)).isNone(), "release defines nothing");
  assertEqUsize(successors(TSwitch(OInt(0), [], 2)).length, 1, "the default");
  const f = fnOf("f", 0, [lr("a")], [plainBlock([], TReturn(None))]);
  assert(termInRange(p, f, TGoto(0)) && !termInRange(p, f, TGoto(1)), "targets");
  assert(
    termInRange(p, f, TReturn(Some(OStr(0)))) && !termInRange(p, f, TReturn(Some(OStr(3)))),
    "returned strings",
  );
  assert(paramsWellFormed(f) && spansAligned(f.blocks), "params, spans");
  assertEqString(wfFunction(f), "", "the verifier agrees");
  assertEqString(wfInstr(p, f, IRelease(0)), "", "a release of a ref local");
  assert(wfInstr(p, f, ICopy(0, OInt(1))) != "", "an int into a ref local");
}

// ---------------------------------------------------------------- HIR integer kinds

@Test
function integerKindsRoundTripAndHaveExactRanges(): void {
  let k = 0;
  while (k <= 9) {
    assert(isKindNumber(k), "a kind");
    assertEqBool(intKindOf(kindType(k)) == k, true, "round trip " + kindName(k));
    if (kindNarrow(k)) {
      assertEqBool(
        kindHi(k) - kindLo(k) + 1 == pow2(kindBits(k)),
        true,
        "2^bits values: " + kindName(k),
      );
    }
    assertEqBool(kindLo(k) < 0, kindSigned(k), "signed kinds go below zero: " + kindName(k));
    assertEqBool(
      kindHi(k) == -1,
      kindUnsigned64(k),
      "the all-ones pattern is the u64 maximum: " + kindName(k),
    );
    k += 1;
  }
  assertEqString(kindName(3), "int", "kind 3 is int");
  assertEqBool(intKindOf(TyBool) == -1, true, "not an integer");
}

@Test
function callSitesHaveKnownEvidenceAndEdgeKinds(): void {
  assert(
    isEvidence("MUST") && isEvidence("MAY") && isEvidence("UNKNOWN") && !isEvidence("maybe"),
    "evidence",
  );
  assert(
    isCallVia("direct")
        && isCallVia("io:fs.read")
        && isCallVia("constructor")
        && isCallVia("unresolved")
        && !isCallVia("dynamic"),
    "via",
  );
  // a call of the enclosing function's parameter 1: no callee, a parameter index (the record invariants hold)
  const c = CallSite {
    caller: 0,
    callee: None,
    ev: "UNKNOWN",
    via: "indirect",
    span: span(0, 0, 1),
    param: 1,
    fnArgs: "",
  };
  assertEqString(c.via, "indirect", "a call of a function value has no callee");
}
