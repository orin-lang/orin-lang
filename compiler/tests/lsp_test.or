// Scripted LSP sessions against compiler/lsp (pure handler). Prints `ok` or one line per failure.
// Build: build/bootstrap/orin2 compile compiler/tests/lsp_test.or -o x.c && cc -O1 -w -I runtime/core x.c runtime/core/orin_runtime.c runtime/platform/orin_platform.c

import { Host, useFs } from "std:host";
import { FsGrant } from "std:fs";
import {
  LspServer, LspStep, newLspState, withTestIndex, lspExitCode, lspCacheHits, lspCacheMisses, handleText, pump, frameMessage, unframe,
  uriToPath, pathToUri, fullDocumentEdits
} from "../lsp";
import { Json, stringifyJson } from "../json";
import { SemanticIndex, SymbolDef, SymbolRef, TypeAt, ImplLink, SkFunction, SkParam, SkRecord, SkInterface } from "../hir";
import { span } from "../diag";
import { exit } from "std:process";

function eq(fails: string[], what: string, got: string, want: string): string[] {
  let f = fails;
  if (got != want) {
    f.push(what + ":\n  got  " + got + "\n  want " + want);
  }
  return f;
}

function show(s: LspStep): string {
  let parts: string[] = [];
  for (const j of s.out) {
    parts.push(stringifyJson(j));
  }
  return parts.join("\n");
}

function has(hay: string, needle: string): string {
  return hay.includes(needle).toString();
}

const INIT: string = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"processId\":null,\"capabilities\":{}}}";

function open(fs: FsGrant, st: LspServer, uri: string, text: string): LspStep {
  return handleText(fs, st, "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"" + uri
    + "\",\"languageId\":\"orin\",\"version\":1,\"text\":" + jsonStr(text) + "}}}");
}

function change(fs: FsGrant, st: LspServer, uri: string, text: string): LspStep {
  return handleText(fs, st, "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{\"textDocument\":{\"uri\":\""
    + uri + "\",\"version\":2},\"contentChanges\":[{\"text\":" + jsonStr(text) + "}]}}");
}

function close(fs: FsGrant, st: LspServer, uri: string): LspStep {
  return handleText(fs, st, "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didClose\",\"params\":{\"textDocument\":{\"uri\":\"" + uri + "\"}}}");
}

function req(fs: FsGrant, st: LspServer, id: int, method: string, params: string): LspStep {
  return handleText(fs, st, "{\"jsonrpc\":\"2.0\",\"id\":" + id.toString() + ",\"method\":\"" + method + "\",\"params\":" + params + "}");
}

// JSON string literal for `s` (escapes quotes, backslashes and newlines).
function jsonStr(s: string): string {
  let out = "\"";
  let i: usize = 0;
  while (i < s.length) {
    const c = s.charCodeAt(i);
    if (c == 34) {
      out += "\\\"";
    } else if (c == 92) {
      out += "\\\\";
    } else if (c == 10) {
      out += "\\n";
    } else {
      out += s.charAt(i);
    }
    i += 1;
  }
  return out + "\"";
}

function diagNote(uri: string, diags: string): string {
  return "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":\"" + uri + "\",\"diagnostics\":[" + diags + "]}}";
}

function initialized(fs: FsGrant): LspServer {
  const s1 = handleText(fs, newLspState(), INIT);
  return handleText(fs, s1.state, "{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{}}").state;
}

function testLifecycle(fs: FsGrant, f: string[]): string[] {
  let fails = f;
  // Requests before initialize are rejected.
  let s = handleText(fs, newLspState(), "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"textDocument/documentSymbol\",\"params\":{}}");
  fails = eq(fails, "before init", show(s), "{\"jsonrpc\":\"2.0\",\"id\":7,\"error\":{\"code\":-32002,\"message\":\"server not initialized\"}}");

  s = handleText(fs, newLspState(), INIT);
  fails = eq(fails, "initialize", show(s),
    "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"capabilities\":{\"textDocumentSync\":{\"openClose\":true,\"change\":1,\"save\":{\"includeText\":false}},"
    + "\"documentSymbolProvider\":true,\"completionProvider\":{\"resolveProvider\":false},\"documentFormattingProvider\":true,"
    + "\"definitionProvider\":true,\"hoverProvider\":true,\"referencesProvider\":true,\"implementationProvider\":true,\"renameProvider\":{\"prepareProvider\":true}},\"serverInfo\":{\"name\":\"orin\",\"version\":\"0.1.0\"}}}");
  s = handleText(fs, s.state, "{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{}}");
  fails = eq(fails, "initialized", show(s), "");

  // Unknown request -> MethodNotFound; unknown notification ignored; string ids are echoed.
  s = handleText(fs, s.state, "{\"jsonrpc\":\"2.0\",\"id\":\"abc\",\"method\":\"textDocument/semanticTokens/full\",\"params\":{}}");
  fails = eq(fails, "method not found", show(s),
    "{\"jsonrpc\":\"2.0\",\"id\":\"abc\",\"error\":{\"code\":-32601,\"message\":\"method not found: textDocument/semanticTokens/full\"}}");
  s = handleText(fs, s.state, "{\"jsonrpc\":\"2.0\",\"method\":\"$/setTrace\",\"params\":{\"value\":\"off\"}}");
  fails = eq(fails, "unknown notification", show(s), "");

  // Malformed JSON and missing params.
  s = handleText(fs, s.state, "{oops");
  fails = eq(fails, "parse error", has(show(s), "\"code\":-32700"), "true");
  s = req(fs, s.state, 3, "textDocument/documentSymbol", "{}");
  fails = eq(fails, "invalid params", show(s), "{\"jsonrpc\":\"2.0\",\"id\":3,\"error\":{\"code\":-32602,\"message\":\"invalid params\"}}");

  // Index-based features are not advertised/answered while the checker has no index.
  s = req(fs, s.state, 4, "textDocument/definition", "{\"textDocument\":{\"uri\":\"file:///t/x.or\"},\"position\":{\"line\":0,\"character\":0}}");
  fails = eq(fails, "definition null", show(s), "{\"jsonrpc\":\"2.0\",\"id\":4,\"result\":null}");

  // shutdown / exit.
  s = req(fs, s.state, 5, "shutdown", "null");
  fails = eq(fails, "shutdown", show(s), "{\"jsonrpc\":\"2.0\",\"id\":5,\"result\":null}");
  s = req(fs, s.state, 6, "textDocument/documentSymbol", "{}");
  fails = eq(fails, "after shutdown", has(show(s), "\"code\":-32600"), "true");
  fails = eq(fails, "no exit yet", lspExitCode(s.state).isNone().toString(), "true");
  s = handleText(fs, s.state, "{\"jsonrpc\":\"2.0\",\"method\":\"exit\"}");
  fails = eq(fails, "exit code 0", lspExitCode(s.state).unwrapOr(-1).toString(), "0");

  const abrupt = handleText(fs, initialized(fs), "{\"jsonrpc\":\"2.0\",\"method\":\"exit\"}");
  fails = eq(fails, "exit code 1", lspExitCode(abrupt.state).unwrapOr(-1).toString(), "1");
  return fails;
}

function testDiagnostics(fs: FsGrant, f: string[]): string[] {
  let fails = f;
  const uri = "file:///t/a.or";
  let st = initialized(fs);

  // Valid document: empty diagnostics.
  let s = open(fs, st, uri, "function f(x: int): int {\n  return x;\n}\n");
  fails = eq(fails, "open valid", show(s), diagNote(uri, ""));
  st = s.state;

  // Syntax error -> E0200 at the offending token.
  s = change(fs, st, uri, "function f( {\n");
  fails = eq(fails, "syntax", show(s), diagNote(uri,
    "{\"range\":{\"start\":{\"line\":0,\"character\":12},\"end\":{\"line\":0,\"character\":13}},\"severity\":1,\"code\":\"E0200\",\"source\":\"orin\","
    + "\"message\":\"expected identifier, found `{`\"}"));
  st = s.state;

  // Type error on the second line -> E0400 on `true`.
  s = change(fs, st, uri, "function f(): int {\n  return true;\n}\n");
  fails = eq(fails, "type error", show(s), diagNote(uri,
    "{\"range\":{\"start\":{\"line\":1,\"character\":9},\"end\":{\"line\":1,\"character\":13}},\"severity\":1,\"code\":\"E0400\",\"source\":\"orin\","
    + "\"message\":\"expected `int`, found `bool`\"}"));
  st = s.state;

  // Fixed again: cleared.
  s = change(fs, st, uri, "function f(): int {\n  return 1;\n}\n");
  fails = eq(fails, "fixed", show(s), diagNote(uri, ""));
  st = s.state;

  // Save re-publishes.
  s = handleText(fs, st, "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didSave\",\"params\":{\"textDocument\":{\"uri\":\"" + uri + "\"}}}");
  fails = eq(fails, "save", show(s), diagNote(uri, ""));

  // Close clears.
  s = close(fs, st, uri);
  fails = eq(fails, "close", show(s), diagNote(uri, ""));
  return fails;
}

function testCrossModule(fs: FsGrant, f: string[]): string[] {
  let fails = f;
  const ua = "file:///w/main.or";
  const ub = "file:///w/lib.or";
  let st = initialized(fs);
  let s = open(fs, st, ub, "export function g(x: int): int {\n  return \"s\";\n}\n");
  st = s.state;
  // lib.or alone: its own type error.
  fails = eq(fails, "lib alone", has(show(s), "\"code\":\"E0400\""), "true");
  s = open(fs, st, ua, "import { g } from \"./lib\";\nfunction main(): void {\n  console.log(g(1).toString());\n}\n");
  st = s.state;
  // main.or has no error of its own; the error in lib.or is attached to lib.or exactly once.
  const out = show(s);
  const lines = out.split("\n");
  fails = eq(fails, "cross n notes", lines.length.toString(), "2");
  fails = eq(fails, "cross lib", has(out, ub) + has(out, "\"code\":\"E0400\""), "truetrue");
  let mainNote = "";
  for (const l of lines) {
    if (l.includes(ua)) {
      mainNote = l;
    }
  }
  fails = eq(fails, "cross main clean", mainNote, diagNote(ua, ""));

  // Fix lib via a change: both documents clean.
  s = change(fs, st, ub, "export function g(x: int): int {\n  return x;\n}\n");
  st = s.state;
  fails = eq(fails, "cross fixed", show(s), diagNote(ub, "") + "\n" + diagNote(ua, ""));

  // Break lib's export: the importer reports E0300.
  s = change(fs, st, ub, "function g(x: int): int {\n  return x;\n}\n");
  st = s.state;
  fails = eq(fails, "cross E0300", has(show(s), "\"code\":\"E0300\""), "true");

  // Close lib: it is cleared (and the importer still sees it through the disk fallback, which
  // does not exist here -> E0301).
  s = close(fs, st, ub);
  fails = eq(fails, "cross close", has(show(s), "\"code\":\"E0301\""), "true");
  return fails;
}

function testQueries(fs: FsGrant, f: string[]): string[] {
  let fails = f;
  const uri = "file:///q/a.or";
  const src = "import { h } from \"./nothere\";\nexport type P = { x: int; };\nfunction f(a: int): int {\n  return a;\n}\n";
  let st = initialized(fs);
  st = open(fs, st, uri, src).state;

  let s = req(fs, st, 10, "textDocument/documentSymbol", "{\"textDocument\":{\"uri\":\"" + uri + "\"}}");
  fails = eq(fails, "docsym", show(s),
    "{\"jsonrpc\":\"2.0\",\"id\":10,\"result\":["
    + "{\"name\":\"P\",\"detail\":\"type P (record)\",\"kind\":23,\"range\":{\"start\":{\"line\":1,\"character\":0},\"end\":{\"line\":1,\"character\":28}},"
    + "\"selectionRange\":{\"start\":{\"line\":1,\"character\":12},\"end\":{\"line\":1,\"character\":13}},\"children\":["
    + "{\"name\":\"x\",\"detail\":\"int\",\"kind\":8,\"range\":{\"start\":{\"line\":1,\"character\":18},\"end\":{\"line\":1,\"character\":25}},"
    + "\"selectionRange\":{\"start\":{\"line\":1,\"character\":18},\"end\":{\"line\":1,\"character\":19}},\"children\":[]}]},"
    + "{\"name\":\"f\",\"detail\":\"function f(a: int): int\",\"kind\":12,\"range\":{\"start\":{\"line\":2,\"character\":0},\"end\":{\"line\":4,\"character\":1}},"
    + "\"selectionRange\":{\"start\":{\"line\":2,\"character\":9},\"end\":{\"line\":2,\"character\":10}},\"children\":[]}]}");

  s = req(fs, st, 11, "textDocument/completion", "{\"textDocument\":{\"uri\":\"" + uri + "\"},\"position\":{\"line\":3,\"character\":2}}");
  const c = show(s);
  fails = eq(fails, "completion head", has(c, "{\"jsonrpc\":\"2.0\",\"id\":11,\"result\":{\"isIncomplete\":false,\"items\":[{\"label\":\"P\",\"kind\":22,"), "true");
  fails = eq(fails, "completion decl", has(c, "{\"label\":\"f\",\"kind\":3,\"detail\":\"function f(a: int): int\"}"), "true");
  fails = eq(fails, "completion import", has(c, "{\"label\":\"h\",\"kind\":6,"), "true");
  fails = eq(fails, "completion keyword", has(c, "{\"label\":\"while\",\"kind\":14,\"detail\":\"keyword\"}"), "true");
  fails = eq(fails, "completion builtin", has(c, "{\"label\":\"Option\""), "true");

  // Formatting: the real formatter answers with a list of edits (here: none, the text is canonical).
  s = req(fs, st, 12, "textDocument/formatting", "{\"textDocument\":{\"uri\":\"" + uri + "\"},\"options\":{\"tabSize\":2,\"insertSpaces\":true}}");
  fails = eq(fails, "formatting", show(s), "{\"jsonrpc\":\"2.0\",\"id\":12,\"result\":[]}");

  // The edit helper used when a formatter is wired.
  const edits = fullDocumentEdits("a\nb", "a\n  b");
  fails = eq(fails, "full edit", stringifyJson(edits[0]),
    "{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":1,\"character\":1}},\"newText\":\"a\\n  b\"}");
  fails = eq(fails, "no edit", fullDocumentEdits("x", "x").length.toString(), "0");
  return fails;
}

// Interfaces (ADR-0019): document symbols and `textDocument/implementation` over a hand-built index.
function testInterfaces(fs: FsGrant, f: string[]): string[] {
  let fails = f;
  const uri = "file:///q/shape.or";
  const text = "interface Shape {\n  area(): int;\n}\nclass Sq implements Shape {\n  area(): int { return 1; }\n}\n";
  let st = initialized(fs);
  st = open(fs, st, uri, text).state;
  let s = req(fs, st, 40, "textDocument/documentSymbol", "{\"textDocument\":{\"uri\":\"" + uri + "\"}}");
  fails = eq(fails, "iface docsym", show(s),
    "{\"jsonrpc\":\"2.0\",\"id\":40,\"result\":["
    + "{\"name\":\"Shape\",\"detail\":\"interface Shape\",\"kind\":11,\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":2,\"character\":1}},"
    + "\"selectionRange\":{\"start\":{\"line\":0,\"character\":10},\"end\":{\"line\":0,\"character\":15}},\"children\":["
    + "{\"name\":\"area\",\"detail\":\"method area(): int\",\"kind\":12,\"range\":{\"start\":{\"line\":1,\"character\":2},\"end\":{\"line\":1,\"character\":14}},"
    + "\"selectionRange\":{\"start\":{\"line\":1,\"character\":2},\"end\":{\"line\":1,\"character\":6}},\"children\":[]}]},"
    + "{\"name\":\"Sq\",\"detail\":\"class Sq\",\"kind\":23,\"range\":{\"start\":{\"line\":3,\"character\":0},\"end\":{\"line\":5,\"character\":1}},"
    + "\"selectionRange\":{\"start\":{\"line\":3,\"character\":6},\"end\":{\"line\":3,\"character\":8}},\"children\":[]}]}");

  // Spans (file 0): `Shape` 10..15, `area` 20..24; class `Sq` 41..43, its `Shape` 55..60, its `area` 65..69.
  const defs = [
    SymbolDef { id: 0, name: "Shape", kind: SkInterface, nameSpan: span(0, 10, 15), declSpan: span(0, 0, 34), unit: 0, container: None, exported: false, detail: "interface Shape (implemented by Sq)", deprecated: None },
    SymbolDef { id: 1, name: "area", kind: SkFunction, nameSpan: span(0, 20, 24), declSpan: span(0, 20, 32), unit: 0, container: Some(0), exported: false, detail: "method area(): int", deprecated: None },
    SymbolDef { id: 2, name: "Sq", kind: SkRecord, nameSpan: span(0, 41, 43), declSpan: span(0, 35, 93), unit: 0, container: None, exported: false, detail: "class Sq implements Shape", deprecated: None },
    SymbolDef { id: 3, name: "area", kind: SkFunction, nameSpan: span(0, 65, 69), declSpan: span(0, 65, 91), unit: 0, container: Some(2), exported: false, detail: "method area(): int", deprecated: None }
  ];
  const refs = [SymbolRef { span: span(0, 55, 60), def: 0 }];
  const idx = SemanticIndex { defs: defs, refs: refs, types: [], impls: [ImplLink { cls: 2, iface: 0, span: span(0, 55, 60) }], calls: [], annos: [], fnDefs: [], fnKinds: [], typed: true };
  let st2 = withTestIndex(newLspState(), idx);
  st2 = handleText(fs, st2, INIT).state;
  st2 = handleText(fs, st2, "{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{}}").state;
  st2 = open(fs, st2, uri, text).state;
  const doc = "\"textDocument\":{\"uri\":\"" + uri + "\"}";
  // On the interface name: the implementing class.
  s = req(fs, st2, 41, "textDocument/implementation", "{" + doc + ",\"position\":{\"line\":0,\"character\":11}}");
  fails = eq(fails, "implementation of interface", show(s),
    "{\"jsonrpc\":\"2.0\",\"id\":41,\"result\":[{\"uri\":\"" + uri + "\",\"range\":{\"start\":{\"line\":3,\"character\":6},\"end\":{\"line\":3,\"character\":8}}}]}");
  // On the interface method: the method of the class.
  s = req(fs, st2, 42, "textDocument/implementation", "{" + doc + ",\"position\":{\"line\":1,\"character\":3}}");
  fails = eq(fails, "implementation of method", show(s),
    "{\"jsonrpc\":\"2.0\",\"id\":42,\"result\":[{\"uri\":\"" + uri + "\",\"range\":{\"start\":{\"line\":4,\"character\":2},\"end\":{\"line\":4,\"character\":6}}}]}");
  // On the class: nothing.
  s = req(fs, st2, 43, "textDocument/implementation", "{" + doc + ",\"position\":{\"line\":3,\"character\":7}}");
  fails = eq(fails, "implementation of class", show(s), "{\"jsonrpc\":\"2.0\",\"id\":43,\"result\":[]}");
  return fails;
}

function testIndexRequests(fs: FsGrant, f: string[]): string[] {
  let fails = f;
  const uri = "file:///q/idx.or";
  const text = "function add(a: int): int { return a; }\nfunction main(): void { add(1); }\n";
  // Spans (file 0): decl `add` 9..12; param `a` 13..14; use of `a` at 35; call `add` on line 1.
  const l1: usize = 40;
  const defs = [
    SymbolDef { id: 0, name: "add", kind: SkFunction, nameSpan: span(0, 9, 12), declSpan: span(0, 0, 39), unit: 0, container: None, exported: false, detail: "function add(a: int): int", deprecated: None },
    SymbolDef { id: 1, name: "a", kind: SkParam, nameSpan: span(0, 13, 14), declSpan: span(0, 13, 19), unit: 0, container: Some(0), exported: false, detail: "a: int", deprecated: None },
    SymbolDef { id: 2, name: "main", kind: SkFunction, nameSpan: span(0, l1 + 9, l1 + 13), declSpan: span(0, l1, l1 + 33), unit: 0, container: None, exported: false, detail: "function main(): void", deprecated: None }
  ];
  const refs = [
    SymbolRef { span: span(0, 35, 36), def: 1 },
    SymbolRef { span: span(0, l1 + 24, l1 + 27), def: 0 }
  ];
  const types = [TypeAt { span: span(0, l1 + 24, l1 + 30), ty: "int" }];
  const idx = SemanticIndex { defs: defs, refs: refs, types: types, impls: [], calls: [], annos: [], fnDefs: [], fnKinds: [], typed: true };

  let st = withTestIndex(newLspState(), idx);
  const init = handleText(fs, st, INIT);
  fails = eq(fails, "caps advertise", has(show(init), "\"definitionProvider\":true,\"hoverProvider\":true,\"referencesProvider\":true,\"implementationProvider\":true,\"renameProvider\":{\"prepareProvider\":true}"), "true");
  st = handleText(fs, init.state, "{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{}}").state;
  st = open(fs, st, uri, text).state;
  const doc = "\"textDocument\":{\"uri\":\"" + uri + "\"}";
  const onCall = "\"position\":{\"line\":1,\"character\":24}";

  let s = req(fs, st, 20, "textDocument/definition", "{" + doc + "," + onCall + "}");
  fails = eq(fails, "definition", show(s),
    "{\"jsonrpc\":\"2.0\",\"id\":20,\"result\":{\"uri\":\"" + uri + "\",\"range\":{\"start\":{\"line\":0,\"character\":9},\"end\":{\"line\":0,\"character\":12}}}}");
  s = req(fs, st, 21, "textDocument/definition", "{" + doc + ",\"position\":{\"line\":0,\"character\":2}}");
  fails = eq(fails, "definition none", show(s), "{\"jsonrpc\":\"2.0\",\"id\":21,\"result\":null}");

  s = req(fs, st, 22, "textDocument/hover", "{" + doc + "," + onCall + "}");
  fails = eq(fails, "hover", show(s),
    "{\"jsonrpc\":\"2.0\",\"id\":22,\"result\":{\"contents\":{\"kind\":\"markdown\",\"value\":\"```orin\\nfunction add(a: int): int\\n```\\n\\n**Effects**: none (pure)\"},"
    + "\"range\":{\"start\":{\"line\":1,\"character\":24},\"end\":{\"line\":1,\"character\":27}}}}");
  s = req(fs, st, 23, "textDocument/hover", "{" + doc + ",\"position\":{\"line\":1,\"character\":28}}");
  fails = eq(fails, "hover type", has(show(s), "\"value\":\"```orin\\nint\\n```\""), "true");

  s = req(fs, st, 24, "textDocument/references", "{" + doc + "," + onCall + ",\"context\":{\"includeDeclaration\":true}}");
  fails = eq(fails, "references", show(s),
    "{\"jsonrpc\":\"2.0\",\"id\":24,\"result\":["
    + "{\"uri\":\"" + uri + "\",\"range\":{\"start\":{\"line\":0,\"character\":9},\"end\":{\"line\":0,\"character\":12}}},"
    + "{\"uri\":\"" + uri + "\",\"range\":{\"start\":{\"line\":1,\"character\":24},\"end\":{\"line\":1,\"character\":27}}}]}");
  s = req(fs, st, 25, "textDocument/references", "{" + doc + "," + onCall + ",\"context\":{\"includeDeclaration\":false}}");
  fails = eq(fails, "references no decl", has(show(s), "\"line\":0"), "false");

  s = req(fs, st, 26, "textDocument/prepareRename", "{" + doc + "," + onCall + "}");
  fails = eq(fails, "prepareRename", show(s),
    "{\"jsonrpc\":\"2.0\",\"id\":26,\"result\":{\"range\":{\"start\":{\"line\":1,\"character\":24},\"end\":{\"line\":1,\"character\":27}},\"placeholder\":\"add\"}}");

  s = req(fs, st, 27, "textDocument/rename", "{" + doc + "," + onCall + ",\"newName\":\"plus\"}");
  fails = eq(fails, "rename", show(s),
    "{\"jsonrpc\":\"2.0\",\"id\":27,\"result\":{\"changes\":{\"" + uri + "\":["
    + "{\"range\":{\"start\":{\"line\":0,\"character\":9},\"end\":{\"line\":0,\"character\":12}},\"newText\":\"plus\"},"
    + "{\"range\":{\"start\":{\"line\":1,\"character\":24},\"end\":{\"line\":1,\"character\":27}},\"newText\":\"plus\"}]}}}");
  s = req(fs, st, 28, "textDocument/rename", "{" + doc + "," + onCall + ",\"newName\":\"main\"}");
  fails = eq(fails, "rename collision", show(s),
    "{\"jsonrpc\":\"2.0\",\"id\":28,\"error\":{\"code\":-32803,\"message\":\"`main` is already defined in this scope\"}}");
  return fails;
}

// `@Deprecated` (ADR-0024): a warning with the Deprecated tag on each use, and the annotation in the hover.
function testDeprecated(fs: FsGrant, f: string[]): string[] {
  let fails = f;
  const uri = "file:///d/a.or";
  const text = "@Deprecated(\"use g\")\nfunction f(): int {\n  return 1;\n}\nfunction main(): void {\n  console.log(f().toString());\n}\n";
  let st = initialized(fs);
  const s = open(fs, st, uri, text);
  st = s.state;
  fails = eq(fails, "deprecated warning", show(s), diagNote(uri,
    "{\"range\":{\"start\":{\"line\":5,\"character\":14},\"end\":{\"line\":5,\"character\":15}},\"severity\":2,\"code\":\"W0440\",\"source\":\"orin\","
    + "\"message\":\"`f` is deprecated: use g\",\"tags\":[2]}"));
  const h = req(fs, st, 50, "textDocument/hover", "{\"textDocument\":{\"uri\":\"" + uri + "\"},\"position\":{\"line\":5,\"character\":14}}");
  fails = eq(fails, "deprecated hover", has(show(h), "\"value\":\"```orin\\n@Deprecated(\\\"use g\\\")\\nfunction f(): int\\n```\\n\\n**Effects**: none (pure)\""), "true");
  // Errors and warnings are separate: a document without uses has no diagnostics at all.
  const noUse = change(fs, st, uri, "@Deprecated(\"use g\")\nfunction f(): int {\n  return 1;\n}\nfunction main(): void {\n}\n");
  fails = eq(fails, "deprecated unused", show(noUse), diagNote(uri, ""));
  return fails;
}

// Hover shows the inferred, transitive effect summary of a function (ADR-0037 D2): a direct effect, one reached through a
// callee (with the route), a pure function, and a call through a function value (UNKNOWN, never pure).
function testHoverEffects(fs: FsGrant, f: string[]): string[] {
  let fails = f;
  const uri = "file:///h/a.or";
  const text = "function say(): void {\n  console.log(\"x\");\n}\nfunction twice(): void {\n  say();\n  say();\n}\nfunction pick(): (x: int) => int {\n  return x => x;\n}\n"
    + "function dyn(): int {\n  const g = pick();\n  return g(1);\n}\nfunction pure(n: int): int {\n  return n;\n}\nfunction main(): void {\n  twice();\n  console.log(dyn().toString());\n  console.log(pure(1).toString());\n}\n";
  let st = initialized(fs);
  st = open(fs, st, uri, text).state;
  const doc = "\"textDocument\":{\"uri\":\"" + uri + "\"}";
  // on the declaration of `say` (line 0), `twice` (line 3), `dyn` (line 10), `pure` (line 14)
  const say = req(fs, st, 60, "textDocument/hover", "{" + doc + ",\"position\":{\"line\":0,\"character\":10}}");
  fails = eq(fails, "hover direct effect", has(show(say), "**Effects** (inferred, transitive):\\n- `Console.Write OUTPUT [MUST] ambient` direct"), "true");
  const twice = req(fs, st, 61, "textDocument/hover", "{" + doc + ",\"position\":{\"line\":3,\"character\":10}}");
  fails = eq(fails, "hover transitive effect", has(show(twice), "- `Console.Write OUTPUT [MAY] ambient` via (root)::say"), "true");
  const dyn = req(fs, st, 62, "textDocument/hover", "{" + doc + ",\"position\":{\"line\":10,\"character\":10}}");
  fails = eq(fails, "hover unknown", has(show(dyn), "- `Unknown.FunctionValue [UNKNOWN]` call of a function value of unknown origin"), "true");
  const pure = req(fs, st, 63, "textDocument/hover", "{" + doc + ",\"position\":{\"line\":14,\"character\":10}}");
  fails = eq(fails, "hover pure", has(show(pure), "**Effects**: none (pure)"), "true");
  // on a call: the effects of the callee
  const call = req(fs, st, 64, "textDocument/hover", "{" + doc + ",\"position\":{\"line\":18,\"character\":3}}");
  fails = eq(fails, "hover on a call", has(show(call), "via (root)::say"), "true");
  return fails;
}

function testFraming(fs: FsGrant, f: string[]): string[] {
  let fails = f;
  fails = eq(fails, "frame", frameMessage("{\"a\":1}"), "Content-Length: 7\r\n\r\n{\"a\":1}");
  // Multi-byte body: Content-Length counts bytes.
  fails = eq(fails, "frame utf8", frameMessage("\"\xc3\xa9\""), "Content-Length: 4\r\n\r\n\"\xc3\xa9\"");
  const two = frameMessage("{\"a\":1}") + frameMessage("[2]");
  let u = unframe(two + "Content-Len");
  fails = eq(fails, "unframe ok", u.isOk().toString(), "true");
  if (u.isOk()) {
    fails = eq(fails, "unframe msgs", u.unwrap().messages.join("|"), "{\"a\":1}|[2]");
    fails = eq(fails, "unframe rest", u.unwrap().rest, "Content-Len");
  }
  u = unframe("Content-Length: 10\r\n\r\n12345");
  fails = eq(fails, "partial body", u.unwrap().messages.length.toString() + ":" + u.unwrap().rest.length.toString(), "0:27");
  u = unframe("content-length:  3 \r\nContent-Type: x\r\n\r\nabcX");
  fails = eq(fails, "case-insens", u.unwrap().messages.join("|") + "/" + u.unwrap().rest, "abc/X");
  fails = eq(fails, "missing header", unframe("Foo: 1\r\n\r\nabc").unwrapErr(), "missing Content-Length header");
  fails = eq(fails, "bad header", unframe("Content-Length: x\r\n\r\n").unwrapErr(), "invalid Content-Length header");

  // pump: framed initialize + shutdown in one buffer, split read for the second.
  const m1 = frameMessage(INIT);
  const m2 = frameMessage("{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"shutdown\"}");
  const cut = m2.length - 5;
  let p = pump(fs, newLspState(), m1 + m2.substring(0, cut));
  fails = eq(fails, "pump 1", p.isOk().toString(), "true");
  if (p.isOk()) {
    const first = p.unwrap();
    fails = eq(fails, "pump 1 out", has(first.output, "\"capabilities\""), "true");
    fails = eq(fails, "pump rest", first.rest, m2.substring(0, cut));
    const p2 = pump(fs, first.state, first.rest + m2.substring(cut, m2.length));
    fails = eq(fails, "pump 2", p2.unwrap().output, frameMessage("{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":null}"));
  }

  fails = eq(fails, "uri->path", uriToPath("file:///a/b%20c/d.or").unwrapOr("?"), "/a/b c/d.or");
  fails = eq(fails, "uri other", uriToPath("untitled:x").isNone().toString(), "true");
  fails = eq(fails, "path->uri", pathToUri("/a/b c/d+e.or"), "file:///a/b%20c/d%2Be.or");
  return fails;
}

function stats(st: LspServer): string {
  return lspCacheHits(st).toString() + "/" + lspCacheMisses(st).toString();
}

function hoverAtF(fs: FsGrant, st: LspServer, id: int, uri: string): LspStep {
  return req(fs, st, id, "textDocument/hover", "{\"textDocument\":{\"uri\":\"" + uri + "\"},\"position\":{\"line\":0,\"character\":9}}");
}

// The analysis cache (analysis/cache.or): requests at one workspace revision share one analysis (hits/misses), and every
// change that can alter the answer (didChange, didSave, didClose, another document's change) invalidates it.
function testAnalysisCache(fs: FsGrant, f: string[]): string[] {
  let fails = f;
  const uri = "file:///c/a.or";
  let st = initialized(fs);
  fails = eq(fails, "fresh", stats(st), "0/0");
  let s = open(fs, st, uri, "function f(a: int): int {\n  return a;\n}\n");
  st = s.state;
  fails = eq(fails, "open analyses once", stats(st), "0/1");

  // Two hovers and a definition at this revision: no new analysis, same answers as the first.
  s = hoverAtF(fs, st, 20, uri);
  st = s.state;
  const h1 = show(s);
  fails = eq(fails, "hover int", has(h1, "function f(a: int): int"), "true");
  s = hoverAtF(fs, st, 20, uri);
  st = s.state;
  fails = eq(fails, "same hover", show(s), h1);
  s = req(fs, st, 22, "textDocument/definition", "{\"textDocument\":{\"uri\":\"" + uri + "\"},\"position\":{\"line\":0,\"character\":9}}");
  st = s.state;
  fails = eq(fails, "requests hit", stats(st), "3/1");

  // didChange: the new contents are analysed once (republish); the hover after it sees them and hits.
  s = change(fs, st, uri, "function f(a: int): bool {\n  return true;\n}\n");
  st = s.state;
  fails = eq(fails, "change analyses once", stats(st), "3/2");
  s = hoverAtF(fs, st, 23, uri);
  st = s.state;
  fails = eq(fails, "hover sees the change", has(show(s), "function f(a: int): bool"), "true");
  fails = eq(fails, "hover not the old text", has(show(s), "): int"), "false");
  fails = eq(fails, "hover after change hits", stats(st), "4/2");

  // A document whose load fails is not cached; the repair is seen at once.
  st = change(fs, st, uri, "function f( {\n").state;
  s = hoverAtF(fs, st, 24, uri);
  st = s.state;
  fails = eq(fails, "broken document not cached", stats(st), "4/4");
  st = change(fs, st, uri, "function f(a: int): string {\n  return \"s\";\n}\n").state;
  s = hoverAtF(fs, st, 25, uri);
  st = s.state;
  fails = eq(fails, "hover after repair", has(show(s), "function f(a: int): string"), "true");

  // didSave drops the entries (the disk may have changed): the republish analyses again, once.
  const before = lspCacheMisses(st);
  s = handleText(fs, st, "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didSave\",\"params\":{\"textDocument\":{\"uri\":\"" + uri + "\"}}}");
  st = s.state;
  fails = eq(fails, "save re-analyses", (lspCacheMisses(st) - before).toString(), "1");

  // Two documents: a change of the imported one is seen in the importer's diagnostics.
  const ua = "file:///c/main.or";
  const ub = "file:///c/lib.or";
  st = open(fs, initialized(fs), ub, "export function g(x: int): int {\n  return x;\n}\n").state;
  s = open(fs, st, ua, "import { g } from \"./lib\";\nfunction main(): void {\n  const n: int = g(1);\n}\n");
  st = s.state;
  fails = eq(fails, "importer clean", has(show(s), "E0"), "false");
  s = change(fs, st, ub, "export function g(x: int): string {\n  return \"s\";\n}\n");
  st = s.state;
  fails = eq(fails, "importer sees the new type", has(show(s), "E0400"), "true");
  s = close(fs, st, ub);
  st = s.state;
  fails = eq(fails, "close: lib falls back to the disk", has(show(s), "E0"), "true");
  return fails;
}

function main(host: Host): void {
  useFs(host, fs => { run(fs); });
}

function run(fs: FsGrant): void {
  let f: string[] = [];
  f = testLifecycle(fs, f);
  f = testDiagnostics(fs, f);
  f = testCrossModule(fs, f);
  f = testQueries(fs, f);
  f = testIndexRequests(fs, f);
  f = testInterfaces(fs, f);
  f = testDeprecated(fs, f);
  f = testHoverEffects(fs, f);
  f = testAnalysisCache(fs, f);
  f = testFraming(fs, f);
  if (f.length == 0) {
    console.log("ok");
  } else {
    for (const m of f) {
      console.log("FAIL " + m);
    }
    exit(1);
  }
}
