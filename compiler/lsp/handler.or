// Language Server Protocol message handling (spec 18 §3). No I/O of its own: the server state is a value.
//
//   server.handle(fs, msg) -> out            one decoded JSON-RPC message in, messages out
//   server.handleText(fs, body)              same, from the raw JSON text (parse errors -> -32700)
//   server.pump(fs, buffer)                  Content-Length framed bytes in -> framed bytes out
//
// The free functions `handle(fs, st, msg) -> { state, out }`, `handleText` and `pump` are the same as functions of
// the state (the tests and the stdio loop use them).
//
// The stdio loop (reading stdin, writing stdout) is NOT here: the driver appends bytes to a
// buffer, calls `pump`, writes `output`, keeps `rest` as the new buffer and stops when
// `lspExitCode(state)` is Some.
//
// Phase 1 behaviour:
//   - Full-text sync. Every open document is its own analysis entry; on every change ALL open
//     documents are re-analysed and `publishDiagnostics` is sent for each open document, for
//     every other file that has diagnostics, and (empty) for files whose diagnostics went away.
//   - Only `file://` URIs are handled (others are ignored). Positions are UTF-16 based.
//   - definition/hover/references/rename need the checker's SemanticIndex; until the checker
//     produces it (`indexAvailable()`) they are not advertised and answer null.
//
// Contract: every request is answered exactly once, with the id it was given (`repliesTo`), and nothing else the
// server sends carries an id (it sends no requests of its own); a message after `exit` is not answered.

import { FsGrant } from "std:fs";
import {
  Json, JField, JNull, JNum, JStr, JArr, JBool, JObj, jField, asArr, getField, getStr, getInt,
  getBool, getArr, getPath, getPathStr, getPathInt, parseJson, stringifyJson, jsonEq,
} from "../json";
import {
  Workspace, newWorkspace, AnalysisCache, newAnalysisCache, Analysis, PathDiag, fileIndexOf,
  indexAvailable, documentSymbols, readText, documentationAt, declCompletions, namespaceCompletions, namespaceImportPath, keywordCompletions,
  builtinCompletions, CompletionItem, DkLocal, posToOffset, definitionAt, hoverAt, referencesTo,
  renameEdits, implementationsAt, symbolSpanAt, symbolAt, TextEdit, effectsContext, isFunctionDef,
  hoverEffectText, defIdsDense,
} from "../analysis";
import { SemanticIndex } from "../hir";
import { Span } from "../diag";
import { normalizePath } from "../loader";
import { frameMessage, unframe } from "./frame";
import { formatAvailable, formatDocument } from "./format";
import { uriToPath, pathToUri } from "./uri";
import {
  rangeJson, documentSymbolJson, completionJson, diagnosticJson, fullDocumentEdits,
} from "./convert";
import { addUnique } from "../util";

// ---- JSON-RPC envelopes -------------------------------------------------------------------

function respond(id: Json, result: Json): Json {
  return JObj([jField("jsonrpc", JStr("2.0")), jField("id", id), jField("result", result)]);
}

function respondError(id: Json, code: int, message: string): Json {
  return JObj([
    jField("jsonrpc", JStr("2.0")),
    jField("id", id),
    jField("error", JObj([jField("code", JNum(code)), jField("message", JStr(message))])),
  ]);
}

function notification(method: string, params: Json): Json {
  return JObj([
    jField("jsonrpc", JStr("2.0")),
    jField("method", JStr(method)),
    jField("params", params),
  ]);
}

const PARSE_ERROR: int = -32700;
const INVALID_REQUEST: int = -32600;
const METHOD_NOT_FOUND: int = -32601;
const INVALID_PARAMS: int = -32602;
const SERVER_NOT_INITIALIZED: int = -32002;
const REQUEST_FAILED: int = -32803;

// ---- the reply rule (contracts) -----------------------------------------------------------

// A request: a message with a string `method` and an `id`.
export function isRequest(msg: Json): bool {
  return getStr(msg, "method").isSome() && getField(msg, "id").isSome();
}

// A response of the server: it has an `id` and a `result` or an `error`, and no `method`.
export function isResponse(j: Json): bool {
  return getField(j, "id").isSome()
      && getStr(j, "method").isNone()
      && (getField(j, "result").isSome() || getField(j, "error").isSome());
}

// A notification of the server: a `method` and no `id`.
export function isNotification(j: Json): bool {
  return getStr(j, "method").isSome() && getField(j, "id").isNone();
}

// The response `j` answers the request id `id`.
export function answers(j: Json, id: Json): bool {
  const got = getField(j, "id");
  return isResponse(j) && got.isSome() && jsonEq(got.unwrap(), id);
}

// `out` is what the server may send for `msg`: exactly one response, carrying the id of `msg`, when `msg` is a request,
// none otherwise; everything else is a notification.
export function repliesTo(msg: Json, out: Json[]): bool {
  const responses = out.filter(j => isResponse(j));
  if (!out.every(j => isResponse(j) || isNotification(j))) {
    return false;
  }
  if (!isRequest(msg)) {
    return responses.length == 0;
  }
  return responses.length == 1 && answers(responses[0], getField(msg, "id").unwrap());
}

function noDuplicates(xs: string[]): bool {
  let i: usize = 0;
  while (i < xs.length) {
    if (xs.indexOf(xs[i]).unwrapOr(i) != i) {
      return false;
    }
    i += 1;
  }
  return true;
}

// ---- the server state ---------------------------------------------------------------------

// Analysis of the document, its semantic index and the cursor offset (index-based requests).
type Ctx = { a: Analysis; idx: SemanticIndex; file: usize; off: usize; };

type LDiag = { path: string; key: string; json: Json; };

// The state of one language-server session: the document store (open buffers) and the protocol phase. `shutdown` is
// only accepted after `initialize`; `published` lists each file with markers on the client once.
@Invariant(!this.shutdownRequested || this.inited)
@Invariant(noDuplicates(this.published))
export class LspServer {
  ws: Workspace = newWorkspace();
  // Analyses of the open documents at the current workspace revision (analysis/cache.or); cleared on save and close.
  cache: AnalysisCache = newAnalysisCache(64);
  inited: bool = false; // `initialize` received
  shutdownRequested: bool = false;
  exited: bool = false; // `exit` received
  published: string[] = []; // paths that currently have non-empty diagnostics published
  // Test seam: when Some, used instead of `Analysis.index` (hand-built indexes in compiler/tests/lsp_test.or).
  testIndex: Option<SemanticIndex> = None;

  // Process exit code once `exit` was received: 0 after a prior `shutdown`, else 1.
  @Ensures(result.isSome() == this.exited)
  exitCode(): Option<int> {
    if (!this.exited) {
      return None;
    }
    return Some(this.shutdownRequested ? 0 : 1);
  }

  // One decoded message in, the messages to send out.
  @Ensures(old(this.exited) ==> result.length == 0)
  @Ensures(!old(this.exited) ==> repliesTo(msg, result))
  @Ensures(old(this.inited) ==> this.inited)
  handle(fs: FsGrant, msg: Json): Json[] {
    if (this.exited) {
      return [];
    }
    const method = getStr(msg, "method");
    if (method.isNone()) {
      return []; // a response from the client (we send no requests) or garbage
    }
    const id = getField(msg, "id");
    if (id.isSome()) {
      const reply = this.request(fs, id.unwrap(), method.unwrap(), msg);
      return [reply];
    }
    return this.notify(fs, method.unwrap(), msg);
  }

  // The raw JSON text of one message; a text that is not JSON is answered with a parse error (id null).
  @Ensures(parseJson(body).isErr() ==> result.length == 1 && answers(result[0], JNull))
  @Ensures(parseJson(body).isOk() && !old(this.exited)
      ==> repliesTo(parseJson(body).unwrap(), result))
  handleText(fs: FsGrant, body: string): Json[] {
    const r = parseJson(body);
    if (r.isErr()) {
      return [respondError(JNull, PARSE_ERROR, "parse error: " + r.unwrapErr())];
    }
    const out = this.handle(fs, r.unwrap());
    return out;
  }

  // ---- requests -----------------------------------------------------------------------------

  private capabilities(): Json {
    let caps: JField[] = [
      jField(
        "textDocumentSync",
        JObj([
          jField("openClose", JBool(true)),
          jField("change", JNum(1)),
          jField("save", JObj([jField("includeText", JBool(false))])),
        ]),
      ),
      jField("documentSymbolProvider", JBool(true)),
      jField("completionProvider", JObj([jField("resolveProvider", JBool(false))])),
    ];
    if (formatAvailable()) {
      caps.push(jField("documentFormattingProvider", JBool(true)));
    }
    if (indexAvailable() || this.testIndex.isSome()) {
      caps.push(jField("definitionProvider", JBool(true)));
      caps.push(jField("hoverProvider", JBool(true)));
      caps.push(jField("referencesProvider", JBool(true)));
      caps.push(jField("implementationProvider", JBool(true)));
      caps.push(jField("renameProvider", JObj([jField("prepareProvider", JBool(true))])));
    }
    return JObj(caps);
  }

  // The one reply to the request `id`.
  @Ensures(answers(result, id))
  private request(fs: FsGrant, id: Json, method: string, msg: Json): Json {
    if (method == "initialize") {
      const result = JObj([
        jField("capabilities", this.capabilities()),
        jField(
          "serverInfo",
          JObj([jField("name", JStr("orin")), jField("version", JStr("0.1.0"))]),
        ),
      ]);
      this.inited = true;
      return respond(id, result);
    }
    if (!this.inited) {
      return respondError(id, SERVER_NOT_INITIALIZED, "server not initialized");
    }
    if (this.shutdownRequested) {
      return respondError(id, INVALID_REQUEST, "server is shutting down");
    }
    if (method == "shutdown") {
      this.shutdownRequested = true;
      return respond(id, JNull);
    }
    if (method == "textDocument/documentSymbol") {
      return this.documentSymbol(fs, id, msg);
    }
    if (method == "textDocument/completion") {
      return this.completion(fs, id, msg);
    }
    if (method == "textDocument/formatting") {
      return this.formatting(fs, id, msg);
    }
    if (method == "textDocument/definition") {
      return this.definition(fs, id, msg);
    }
    if (method == "textDocument/hover") {
      return this.hover(fs, id, msg);
    }
    if (method == "textDocument/implementation") {
      return this.implementation(fs, id, msg);
    }
    if (method == "textDocument/references") {
      return this.references(fs, id, msg);
    }
    if (method == "textDocument/prepareRename") {
      return this.prepareRename(fs, id, msg);
    }
    if (method == "textDocument/rename") {
      return this.rename(fs, id, msg);
    }
    return respondError(id, METHOD_NOT_FOUND, "method not found: " + method);
  }

  private documentSymbol(fs: FsGrant, id: Json, msg: Json): Json {
    const p = docPath(msg);
    if (p.isNone()) {
      return invalidParams(id);
    }
    const text = readText(fs, this.ws, p.unwrap()).unwrapOr("");
    const items = documentSymbols(fs, this.ws, p.unwrap()).map(s => documentSymbolJson(text, s));
    return respond(id, JArr(items));
  }

  private completion(fs: FsGrant, id: Json, msg: Json): Json {
    const p = docPath(msg);
    if (p.isNone()) {
      return invalidParams(id);
    }
    // After `ns.` (a namespace import, ADR-0048 addendum) only the members of the namespace are offered.
    const line = getPathInt(msg, ["params", "position", "line"]);
    const ch = getPathInt(msg, ["params", "position", "character"]);
    const src = readText(fs, this.ws, p.unwrap());
    if (src.isSome() && line.isSome() && ch.isSome() && line.unwrap() >= 0 && ch.unwrap() >= 0) {
      const at = posToOffset(src.unwrap(), line.unwrap().toUsize(), ch.unwrap().toUsize());
      const members = namespaceCompletions(fs, this.ws, p.unwrap(), src.unwrap(), at);
      if (members.isSome()) {
        let list = members.unwrap();
        const ip = namespaceImportPath(src.unwrap(), at);
        if (ip.isSome() && ip.unwrap().startsWith("std:")) {
          list = this.cache.stdMembers(ip.unwrap());
        }
        return respond(id, JObj([jField("isIncomplete", JBool(false)), jField("items", JArr(list.map(c => completionJson(c))))]));
      }
    }
    let items: Json[] = declCompletions(fs, this.ws, p.unwrap()).map(c => completionJson(c));
    const lc = this.context(fs, msg, false);
    if (lc.isSome()) {
      items = items.concat(localCompletions(lc.unwrap()).map(c => completionJson(c)));
    }
    items = items.concat(keywordCompletions().map(c => completionJson(c)));
    items = items.concat(builtinCompletions().map(c => completionJson(c)));
    return respond(id, JObj([jField("isIncomplete", JBool(false)), jField("items", JArr(items))]));
  }

  private formatting(fs: FsGrant, id: Json, msg: Json): Json {
    const p = docPath(msg);
    if (p.isNone()) {
      return invalidParams(id);
    }
    const t = readText(fs, this.ws, p.unwrap());
    if (t.isNone()) {
      return invalidParams(id);
    }
    if (!formatAvailable()) {
      const none: Json[] = [];
      return respond(id, JArr(none)); // stub: no edits
    }
    const r = formatDocument(t.unwrap());
    if (r.isErr()) {
      return respondError(id, REQUEST_FAILED, r.unwrapErr());
    }
    return respond(id, JArr(fullDocumentEdits(t.unwrap(), r.unwrap())));
  }

  // ---- index-based requests -----------------------------------------------------------------

  // Workspace-wide queries (references, rename) need an analysis whose program contains every
  // user of the symbol: when `path` is imported by another open document, that document is used as
  // the entry instead (first match in open order); otherwise `path` is its own entry.
  private wideAnalysis(fs: FsGrant, path: string): Analysis {
    const me = normalizePath(path);
    for (const o of this.ws.paths()) {
      if (normalizePath(o) == me) {
        continue;
      }
      const a = this.cache.analyze(fs, this.ws, o);
      if (a.index.isSome() && fileIndexOf(a, path).isSome()) {
        return a;
      }
    }
    return this.cache.analyze(fs, this.ws, path);
  }

  private analysisFor(fs: FsGrant, path: string, wide: bool): Analysis {
    if (wide) {
      return this.wideAnalysis(fs, path);
    }
    return this.cache.analyze(fs, this.ws, path);
  }

  // Analysis of the document, its semantic index and the cursor offset. None when the index is
  // not available or the params are malformed.
  @Ensures(result.isSome() ==> result.unwrap().file < result.unwrap().a.sm.files.length)
  @Ensures(result.isSome()
      ==> result.unwrap().off <= result.unwrap().a.sm.files[result.unwrap().file].text.length)
  @Ensures(result.isSome() ==> defIdsDense(result.unwrap().idx))
  private context(fs: FsGrant, msg: Json, wide: bool): Option<Ctx> {
    const p = docPath(msg);
    const line = getPathInt(msg, ["params", "position", "line"]);
    const ch = getPathInt(msg, ["params", "position", "character"]);
    if (p.isNone() || line.isNone() || ch.isNone() || line.unwrap() < 0 || ch.unwrap() < 0) {
      return None;
    }
    const a = this.analysisFor(fs, p.unwrap(), wide);
    let idx: Option<SemanticIndex> = a.index;
    if (this.testIndex.isSome()) {
      idx = this.testIndex;
    }
    if (idx.isNone()) {
      return None;
    }
    const fi = fileIndexOf(a, p.unwrap());
    if (fi.isNone()) {
      return None;
    }
    const text = a.sm.files[fi.unwrap()].text;
    return Some(Ctx {
      a: a,
      idx: idx.unwrap(),
      file: fi.unwrap(),
      off: posToOffset(text, line.unwrap().toUsize(), ch.unwrap().toUsize()),
    });
  }

  private definition(fs: FsGrant, id: Json, msg: Json): Json {
    const c = this.context(fs, msg, false);
    if (c.isNone()) {
      return respond(id, JNull);
    }
    const x = c.unwrap();
    const d = definitionAt(x.idx, x.file, x.off);
    if (d.isNone()) {
      return respond(id, JNull);
    }
    return respond(id, locationJson(x.a, d.unwrap()));
  }

  // Go to implementations (ADR-0019): classes implementing the interface at the cursor, or their methods.
  private implementation(fs: FsGrant, id: Json, msg: Json): Json {
    const c = this.context(fs, msg, true);
    let locs: Json[] = [];
    if (c.isSome()) {
      const x = c.unwrap();
      locs = implementationsAt(x.idx, x.file, x.off).map(sp => locationJson(x.a, sp));
    }
    return respond(id, JArr(locs));
  }

  private hover(fs: FsGrant, id: Json, msg: Json): Json {
    const c = this.context(fs, msg, false);
    if (c.isNone()) {
      return respond(id, JNull);
    }
    const x = c.unwrap();
    const h = hoverAt(x.idx, x.file, x.off);
    if (h.isNone()) {
      return respond(id, JNull);
    }
    const info = h.unwrap();
    let value = "```orin\n" + info.text + "\n```";
    // Documentation follows the resolved declaration (including cross-file references).
    // Contracts are already part of the symbol signature; never claim they are verified here.
    const sym = symbolAt(x.idx, x.file, x.off);
    if (sym.isSome() && sym.unwrap() < x.idx.defs.length) {
      const def = x.idx.defs[sym.unwrap()];
      if (def.declSpan.file < x.a.sm.files.length) {
        const source = x.a.sm.files[def.declSpan.file].text;
        const doc = documentationAt(source, def.declSpan.start);
        if (doc.isSome()) {
          value += "\n\n" + doc.unwrap();
        }
      }
    }
    // A function, method or constructor: its inferred effect summary (ADR-0037 D2; the same analysis as `orin effects`).
    if (sym.isSome() && x.a.program.isSome()) {
      const ec = effectsContext(x.a.program.unwrap(), x.idx, x.a.sm);
      if (isFunctionDef(ec, sym.unwrap())) {
        value = value + "\n\n" + hoverEffectText(ec, sym.unwrap());
      }
    }
    const contents = JObj([jField("kind", JStr("markdown")), jField("value", JStr(value))]);
    return respond(
      id,
      JObj([
        jField("contents", contents),
        jField("range", rangeJson(spanText(x.a, info.span), info.span.start, info.span.end)),
      ]),
    );
  }

  private references(fs: FsGrant, id: Json, msg: Json): Json {
    const c = this.context(fs, msg, true);
    let locs: Json[] = [];
    if (c.isSome()) {
      const x = c.unwrap();
      let includeDecl = false;
      const ctx = getPath(msg, ["params", "context"]);
      if (ctx.isSome()) {
        includeDecl = getBool(ctx.unwrap(), "includeDeclaration").unwrapOr(false);
      }
      locs = referencesTo(x.idx, x.file, x.off, includeDecl).map(sp => locationJson(x.a, sp));
    }
    return respond(id, JArr(locs));
  }

  private prepareRename(fs: FsGrant, id: Json, msg: Json): Json {
    const c = this.context(fs, msg, true);
    if (c.isNone()) {
      return respond(id, JNull);
    }
    const x = c.unwrap();
    const s = symbolSpanAt(x.idx, x.file, x.off);
    if (s.isNone()) {
      return respond(id, JNull);
    }
    const sp = s.unwrap();
    const text = spanText(x.a, sp);
    return respond(
      id,
      JObj([
        jField("range", rangeJson(text, sp.start, sp.end)),
        jField("placeholder", JStr(text.substring(sp.start, sp.end))),
      ]),
    );
  }

  private rename(fs: FsGrant, id: Json, msg: Json): Json {
    const c = this.context(fs, msg, true);
    const newName = getPathStr(msg, ["params", "newName"]);
    if (newName.isNone()) {
      return invalidParams(id);
    }
    if (c.isNone()) {
      return respondError(id, REQUEST_FAILED, "no semantic information available for rename");
    }
    const x = c.unwrap();
    if (this.testIndex.isNone() && x.a.diags.length > 0) {
      // The index is partial while the program has errors (type-dependent references are missing).
      return respondError(id, REQUEST_FAILED, "fix the errors in the workspace before renaming");
    }
    const r = renameEdits(x.idx, x.file, x.off, newName.unwrap());
    if (r.isErr()) {
      return respondError(id, REQUEST_FAILED, r.unwrapErr());
    }
    return respond(id, JObj([jField("changes", JObj(editsByFile(x.a, r.unwrap())))]));
  }

  // ---- notifications and diagnostics --------------------------------------------------------

  // The notifications to send for a notification of the client (never a response).
  @Ensures(result.every(j => isNotification(j)))
  private notify(fs: FsGrant, method: string, msg: Json): Json[] {
    if (method == "exit") {
      this.exited = true;
      return [];
    }
    if (!this.inited || this.shutdownRequested) {
      return [];
    }
    if (method == "textDocument/didOpen") {
      const p = docPath(msg);
      const text = getPathStr(msg, ["params", "textDocument", "text"]);
      if (p.isNone() || text.isNone()) {
        return [];
      }
      this.ws.open(p.unwrap(), text.unwrap());
      return this.republish(fs, []);
    }
    if (method == "textDocument/didChange") {
      const p = docPath(msg);
      const changes = getPath(msg, ["params", "contentChanges"]);
      if (p.isNone() || changes.isNone()) {
        return [];
      }
      const itemsOpt = asArr(changes.unwrap());
      if (itemsOpt.isNone() || itemsOpt.unwrap().length == 0) {
        return [];
      }
      const items = itemsOpt.unwrap();
      // Full sync: the last change carries the whole document.
      const text = getStr(items[items.length - 1], "text");
      if (text.isNone()) {
        return [];
      }
      this.ws.open(p.unwrap(), text.unwrap());
      return this.republish(fs, []);
    }
    if (method == "textDocument/didSave") {
      this.cache.clear(); // the disk may have changed under the files that are not open
      return this.republish(fs, []);
    }
    if (method == "textDocument/didClose") {
      const p = docPath(msg);
      if (p.isNone()) {
        return [];
      }
      this.ws.close(p.unwrap());
      this.cache.clear();
      return this.republish(fs, [p.unwrap()]);
    }
    if (method == "workspace/didChangeWatchedFiles") {
      this.cache.clear();
      return [];
    }
    return []; // initialized, $/cancelRequest, workspace/*, ... are ignored
  }

  // Diagnostics of all open documents (each analysed as its own entry), de-duplicated.
  private collectDiags(fs: FsGrant): LDiag[] {
    let out: LDiag[] = [];
    let keys: string[] = [];
    for (const entry of this.ws.paths()) {
      const a = this.cache.analyze(fs, this.ws, entry);
      for (const d of a.diags.concat(a.warnings)) {
        const key = d.path + "|" + d.code + "|" + d.start.toString() + "|" + d.end.toString() + "|"
            + d.message;
        if (keys.includes(key)) {
          continue;
        }
        const fi = fileIndexOf(a, d.path);
        const text = fi.isSome() ? a.sm.files[fi.unwrap()].text : "";
        keys.push(key);
        out.push(LDiag { path: d.path, key: key, json: diagnosticJson(text, d) });
      }
    }
    return out;
  }

  // Recompute diagnostics and publish them for: every open document, every file that has
  // diagnostics, every file that had diagnostics published before, and `extra` (e.g. a document
  // that was just closed, so its markers are cleared).
  @Ensures(result.length >= old(this.published.length) && result.length >= this.published.length)
  private republish(fs: FsGrant, extra: string[]): Json[] {
    const all = this.collectDiags(fs);
    let targets: string[] = [];
    for (const p of this.ws.paths()) {
      targets = addUnique(targets, p);
    }
    let nowPublished: string[] = [];
    for (const d of all) {
      targets = addUnique(targets, d.path);
      nowPublished = addUnique(nowPublished, d.path);
    }
    for (const p of this.published) {
      targets = addUnique(targets, p);
    }
    for (const p of extra) {
      targets = addUnique(targets, p);
    }
    this.published = nowPublished;
    return targets.map(
      t => notification(
        "textDocument/publishDiagnostics",
        JObj([
          jField("uri", JStr(pathToUri(t))),
          jField("diagnostics", JArr(all.filter(d => d.path == t).map(d => d.json))),
        ]),
      ),
    );
  }

  // Feed raw bytes: decode all complete framed messages, handle them, return the framed output (and the incomplete
  // tail). Err on a malformed header block.
  @Ensures(result.isOk() ==> buffer.endsWith(result.unwrap().rest))
  @Ensures(old(this.inited) ==> this.inited)
  pump(fs: FsGrant, buffer: string): Result<Pumped, string> {
    const u = unframe(buffer)?;
    let outs: string[] = [];
    for (const body of u.messages) {
      const out = this.handleText(fs, body);
      for (const j of out) {
        outs.push(frameMessage(stringifyJson(j)));
      }
    }
    return Ok(Pumped { state: this, rest: u.rest, output: outs.join("") });
  }
}

// ---- helpers of the requests ------------------------------------------------------------------

function docPath(msg: Json): Option<string> {
  const u = getPathStr(msg, ["params", "textDocument", "uri"]);
  if (u.isNone()) {
    return None;
  }
  return uriToPath(u.unwrap());
}

function invalidParams(id: Json): Json {
  return respondError(id, INVALID_PARAMS, "invalid params");
}

// Parameters and locals of the function around the cursor that are declared before it
// (scope-insensitive approximation: sibling blocks are included). One item per name.
function localCompletions(x: Ctx): CompletionItem[] {
  let out: CompletionItem[] = [];
  let seen: string[] = [];
  for (const d of x.idx.defs) {
    const isLocal = match (d.kind) {
      SkLocal => true,
      SkParam => true,
      _ => false,
    };
    if (!isLocal || d.nameSpan.file != x.file || d.nameSpan.start >= x.off) {
      continue;
    }
    const inFn = match (d.container) {
      Some(f) => f < x.idx.defs.length
          && x.idx.defs[f].declSpan.file == x.file
          && x.idx.defs[f].declSpan.start <= x.off
          && x.off <= x.idx.defs[f].declSpan.end,
      None => false,
    };
    if (!inFn || seen.includes(d.name)) {
      continue;
    }
    seen.push(d.name);
    out.push(CompletionItem { label: d.name, kind: DkLocal, detail: d.detail });
  }
  return out;
}

function spanText(a: Analysis, sp: Span): string {
  return a.sm.files[sp.file].text;
}

function locationJson(a: Analysis, sp: Span): Json {
  return JObj([
    jField("uri", JStr(pathToUri(a.sm.files[sp.file].path))),
    jField("range", rangeJson(spanText(a, sp), sp.start, sp.end)),
  ]);
}

// The `changes` of a WorkspaceEdit: the edits grouped by file, files in order of their first edit.
@Ensures(result.length <= edits.length)
function editsByFile(a: Analysis, edits: TextEdit[]): JField[] {
  let files: usize[] = [];
  let lists: Json[][] = [];
  for (const e of edits) {
    const k = files.indexOf(e.span.file).unwrapOr(files.length);
    if (k == files.length) {
      files.push(e.span.file);
      const empty: Json[] = [];
      lists.push(empty);
    }
    lists[k].push(
      JObj([
        jField("range", rangeJson(spanText(a, e.span), e.span.start, e.span.end)),
        jField("newText", JStr(e.newText)),
      ]),
    );
  }
  let changes: JField[] = [];
  let i: usize = 0;
  while (i < files.length) {
    changes.push(jField(pathToUri(a.sm.files[files[i]].path), JArr(lists[i])));
    i += 1;
  }
  return changes;
}

// ---- the functional interface ---------------------------------------------------------------

export type LspStep = { state: LspServer; out: Json[]; };

export type Pumped = { state: LspServer; rest: string; output: string; };

export function newLspState(): LspServer {
  return new LspServer();
}

export function withTestIndex(st: LspServer, idx: SemanticIndex): LspServer {
  let s = st;
  s.testIndex = Some(idx);
  return s;
}

// How many analyses the session answered from its cache / by running them (tests, benchmarks).
export function lspCacheHits(st: LspServer): usize {
  return st.cache.hits;
}

export function lspCacheMisses(st: LspServer): usize {
  return st.cache.misses;
}

// Process exit code once `exit` was received: 0 after a prior `shutdown`, else 1.
export function lspExitCode(st: LspServer): Option<int> {
  return st.exitCode();
}

export function handleText(fs: FsGrant, st: LspServer, body: string): LspStep {
  let s = st;
  const out = s.handleText(fs, body);
  return LspStep { state: s, out: out };
}

export function handle(fs: FsGrant, st: LspServer, msg: Json): LspStep {
  let s = st;
  const out = s.handle(fs, msg);
  return LspStep { state: s, out: out };
}

// Feed raw bytes: decode all complete framed messages, handle them, return framed output.
export function pump(fs: FsGrant, st: LspServer, buffer: string): Result<Pumped, string> {
  let s = st;
  const p = s.pump(fs, buffer)?;
  return Ok(p);
}
