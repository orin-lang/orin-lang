// Contract verification, phase 2 (ADR-0012, spec 15) and ADR-0031 part B: `orin verify --contracts`. Beyond Orin-B.
//
// Verification conditions for functions, methods and constructors, discharged by an SMT solver (z3, SMT-LIB 2
// text on stdin). Documented in docs/contracts.md (the supported fragment and the honest limits). Files:
//   vt.or     verifier types, the program's type tables
//   gen.or    SMT generation state, sorts (datatypes for arrays, records, Option, Result, Map; strings)
//   ctx.or    symbolic values, states, the function table, small term builders, syntactic analyses
//   expr.or   expressions: arithmetic, arrays, fields, calls (modular), quantifiers, sums
//   stmt.or   statements: assignment to places, mutating calls, branches, match, loops
//   vc.or     this file: program tables, solver, functions / methods / constructors, class invariants
//   report.or statuses, refusal protocol fields, assumptions, JSON and text
// Semantics: PARTIAL correctness over unbounded mathematical integers in contracts; the program's arithmetic
// traps on overflow, division by zero, an index out of range and `unwrap` of `None`, so executions that trap
// never return: a proof about the returning paths assumes they do not happen, and an index or `unwrap` failure
// is reported as an obligation of its own. Termination is not proved.
// Statuses: VERIFIED (solver: unsat), REFUTED (sat, with a counterexample, only when the path used no
// abstraction), UNKNOWN (solver unknown / timeout / unavailable, outside the fragment, or a counterexample that
// may be spurious because of an abstraction), always with the reason. A result never claims more than its list
// of assumptions (report.or) allows.

import { FsGrant } from "std:fs";
import { ProcessGrant } from "std:process";
import { SourceMap } from "../diag";
import {
  Ident, FunctionDecl, Param, TypeExpr, Block, Stmt, Expr, ContractClause,
  IFunction, IClass, IType, IConst, ClassDecl, MField, MCtor, MMethod, MethodDecl, CtorDecl,
  TypeDecl, DAlias, DRecord, DUnion,
  CRequires, CEnsures, CInvariant, CDecreases, CRule
} from "../syntax";
import { Program } from "../hir";
import { LoadedProgram } from "../loader";
import { isSyntacticallyTrivial, inferPurity, allFunctions } from "../check";
import { writeFile, readFile } from "std:fs";
import { shellRun, mapOrderedProcess } from "../util";
import { parallelism } from "std:task";
import { Res, QWarn, Report, assumptionsFor } from "./report";
import { replyValues } from "./sx";
import {
  VT, VInt, VBool, VStr, VUnit, VArr, VOpt, VRes, VMap, VRec, VUni, VBad,
  vtKey, vtName, isBad, badReason, vtEq, isIntTy, RecDef, UniDef, AliasDef, Tab, recOfType, recOfClass, uniOfType, payloadTy, resolveTyP, fieldTyOf, identNames, sealTab, fieldIndex
} from "./vt";
import { Gen, Obl, SortR, sortOf, opaqueSort } from "./gen";
import { qualKey, bareOf, buildScopes } from "./scope";
import {
  Var, Chk, TR, St, Ret, Ex, Fn, Cls, ConstInfo, Prog, Cx, I64_MIN, I64_MAX, lineOf, clauseText, lit, inRange, inKind, concat, unionUsize, andAll,
  noChks, noExp, lookupVar, sortS, tyOf, fresh, freshFree, wfOf, recField, arrLen, arrSel, clausesOfList, exprOf, rulesOfList, hasClauses,
  Writes, writesStmts
} from "./ctx";
import { tr, trClause, wdOf, sigOf, invTerms, valueInvariants, Cl, Sig, isUnit, clHyp, clGoal } from "./expr";
import { execStmts, emit } from "./stmt";
import { constIds, sliceKeep } from "./slice";

export { Report, Res, QWarn } from "./report";

const W_TAUTOLOGY: string = "W0460";
const W_UNSAT_REQUIRES: string = "W0461";
const W_IMPLIED_ENSURES: string = "W0462";

// ------------------------------------------------------------------------------------- program tables

function concatNames(a: string[], b: string[]): string[] {
  let out = a;
  for (const x of b) {
    out.push(x);
  }
  return out;
}

function unitFns(u: string, file: string, text: string, d: FunctionDecl): Fn {
  let names: string[] = [];
  let tys: TypeExpr[] = [];
  let acc: int[] = [];
  for (const p of d.params) {
    names.push(p.name.name);
    tys.push(p.ty);
    acc.push(0);
  }
  return Fn {
    key: qualKey(u, d.name.name), disp: d.name.name, sym: d.name.name, name: d.name.name, unit: u, file: file, text: text, cls: "", kind: 0, priv: false, generic: d.typeParams.length > 0,
    pnames: names, ptys: tys, pacc: acc, ret: d.ret, body: d.body, contracts: d.contracts, span: d.span, pure: false, mutating: false,
    frame: [], frameAll: false, line: lineOf(text, d.span.start), params: d.params, verify: !u.startsWith("$"), tparams: identNames(d.typeParams)
  };
}

function methodFn(u: string, file: string, text: string, c: ClassDecl, m: MethodDecl): Fn {
  let names: string[] = [];
  let tys: TypeExpr[] = [];
  let acc: int[] = [];
  for (const p of m.params) {
    names.push(p.name.name);
    tys.push(p.ty);
    acc.push(0);
  }
  return Fn {
    key: qualKey(u, c.name.name) + "." + m.name.name, disp: c.name.name + "." + m.name.name, sym: c.name.name + "." + m.name.name, name: m.name.name, unit: u, file: file, text: text, cls: qualKey(u, c.name.name), kind: m.isStatic ? 2 : 1, priv: m.priv,
    generic: m.typeParams.length > 0 || c.typeParams.length > 0, pnames: names, ptys: tys, pacc: acc, ret: m.ret, body: m.body, contracts: m.contracts,
    span: m.span, pure: false, mutating: false, frame: [], frameAll: false, line: lineOf(text, m.span.start), params: m.params, verify: !u.startsWith("$"), tparams: concatNames(identNames(c.typeParams), identNames(m.typeParams))
  };
}

function ctorFn(u: string, file: string, text: string, c: ClassDecl, k: CtorDecl): Fn {
  let names: string[] = [];
  let tys: TypeExpr[] = [];
  let acc: int[] = [];
  let ps: Param[] = [];
  for (const p of k.params) {
    names.push(p.name.name);
    tys.push(p.ty);
    acc.push(p.access);
    ps.push(Param { name: p.name, ty: p.ty, span: p.span });
  }
  return Fn {
    key: qualKey(u, c.name.name) + ".constructor", disp: c.name.name + ".constructor", sym: c.name.name + ".constructor", name: "constructor", unit: u, file: file, text: text, cls: qualKey(u, c.name.name), kind: 3, priv: false, generic: c.typeParams.length > 0,
    pnames: names, ptys: tys, pacc: acc, ret: None, body: k.body, contracts: k.contracts, span: k.span, pure: false, mutating: false,
    frame: [], frameAll: false, line: lineOf(text, k.span.start), params: ps, verify: !u.startsWith("$"), tparams: identNames(c.typeParams)
  };
}

function classInfo(u: string, file: string, text: string, c: ClassDecl, ctor: Option<usize>): Cls {
  let fields: string[] = [];
  let ftys: TypeExpr[] = [];
  let finit: Option<Expr>[] = [];
  for (const m of c.members) {
    match (m) {
      MField(f) => {
        fields.push(f.name.name);
        ftys.push(f.ty);
        finit.push(f.init);
      },
      _ => {}
    }
  }
  for (const m of c.members) {
    match (m) {
      MCtor(k) => {
        for (const p of k.params) {
          if (p.access != 0 && !fields.includes(p.name.name)) {
            fields.push(p.name.name);
            ftys.push(p.ty);
            finit.push(None);
          }
        }
      },
      _ => {}
    }
  }
  return Cls { name: qualKey(u, c.name.name), unit: u, file: file, text: text, fields: fields, ftys: ftys, finit: finit, invs: clausesOfList(c.contracts, 4), generic: c.typeParams.length > 0, ctor: ctor, tparams: identNames(c.typeParams) };
}

// Count of a name in a map (0 when absent).
function bumped(m: Map<string, usize>, k: string): Map<string, usize> {
  let out = m;
  out.set(k, m.get(k).unwrapOr(0) + 1);
  return out;
}

// The fixpoint of the frames: the fields a mutating method writes, including what the methods of its own class
// that it calls on `this` write.
function computeFrames(p0: Prog): Prog {
  let p = p0;
  const n = p.fns.length;
  let writes: Writes[] = [];
  let k: usize = 0;
  while (k < n) {
    const f = p.fns[k];
    const co = p.clsIx.get(f.cls);
    if ((f.kind == 1 && f.mutating || f.kind == 3) && co.isSome()) {
      writes.push(writesStmts(p, p.classes[co.unwrap()], f.body.stmts, Writes { fields: [], thisCalls: [], unknown: false }));
    } else {
      writes.push(Writes { fields: [], thisCalls: [], unknown: false });
    }
    k += 1;
  }
  let frames: string[][] = [];
  let all: bool[] = [];
  k = 0;
  while (k < n) {
    frames.push(writes[k].fields);
    all.push(writes[k].unknown);
    k += 1;
  }
  let changed = true;
  let rounds: usize = 0;
  while (changed && rounds < 20) {
    changed = false;
    rounds += 1;
    k = 0;
    while (k < n) {
      const f = p.fns[k];
      if (f.kind == 1 && f.mutating) {
        for (const c of writes[k].thisCalls) {
          const mi = p.fnIx.get(f.cls + "." + c);
          if (mi.isNone()) {
            if (!all[k]) {
              all[k] = true;
              changed = true;
            }
          } else if (p.fns[mi.unwrap()].mutating) {
            const j = mi.unwrap();
            if (all[j] && !all[k]) {
              all[k] = true;
              changed = true;
            }
            for (const fld of frames[j]) {
              if (!frames[k].includes(fld)) {
                frames[k].push(fld);
                changed = true;
              }
            }
          }
        }
      }
      k += 1;
    }
  }
  let fns = p.fns;
  k = 0;
  while (k < n) {
    let f = fns[k];
    f.frame = frames[k];
    // A mutating method whose writes the analysis could not see: every field may change.
    f.frameAll = all[k] || (f.kind == 1 && f.mutating && frames[k].length == 0);
    fns[k] = f;
    k += 1;
  }
  p.fns = fns;
  return p;
}

function buildProg(prog: LoadedProgram, sm: SourceMap, hir: Program): Prog {
  let tab = new Tab();
  let fns: Fn[] = [];
  let classes: Cls[] = [];
  let consts: ConstInfo[] = [];
  let fnIx = new Map<string, usize>();
  let fnCount = new Map<string, usize>();
  let clsIx = new Map<string, usize>();
  let mutNames = new Map<string, bool>();
  // purity and mutation, from the analyses of the checker (ADR-0031 A4, ADR-0009)
  const pur = inferPurity(hir.functions, allFunctions(hir.functions));
  let pureOf = new Map<string, bool>();
  let hi: usize = 0;
  while (hi < hir.functions.length) {
    if (pur.reached[hi] && !pur.impure[hi]) {
      pureOf.set(hir.functions[hi].name, true);
    }
    hi += 1;
  }
  let mutOf = new Map<string, bool>();
  for (const m of hir.mutating) {
    mutOf.set(m, true);
  }
  for (const u of prog.units) {
    if (u.name.startsWith("$") && !u.name.startsWith("$stdlib/")) {
      continue;
    }
    const f = sm.files[u.file];
    for (const it of u.ast.items) {
      match (it) {
        IType(d) => {
          match (d.body) {
            DRecord(fs) => { tab.addRec(recOfType(u.name, d, fs, f.text)); },
            DUnion(vs) => { tab.addUni(uniOfType(u.name, d, vs)); },
            DAlias(t) => { tab.addAlias(AliasDef { name: qualKey(u.name, d.name.name), unit: u.name, target: t, generic: d.typeParams.length > 0 }); }
          }
        },
        IClass(c) => {
          tab.addRec(recOfClass(u.name, c, f.text));
        },
        IConst(c) => {
          consts.push(ConstInfo { key: qualKey(u.name, c.name.name), name: c.name.name, unit: u.name, decl: c, text: f.text });
        },
        _ => {}
      }
    }
  }
  for (const u of prog.units) {
    if (u.name.startsWith("$") && !u.name.startsWith("$stdlib/")) {
      continue;
    }
    const f = sm.files[u.file];
    for (const it of u.ast.items) {
      match (it) {
        IFunction(d) => {
          let fn = unitFns(u.name, f.path, f.text, d);
          fn.pure = pureOf.has(u.name + "." + d.name.name);
          fnIx.set(fn.key, fns.length);
          fnCount = bumped(fnCount, fn.key);
          fns.push(fn);
        },
        IClass(c) => {
          let ctorIx: Option<usize> = None;
          for (const m of c.members) {
            match (m) {
              MCtor(k) => {
                const fn = ctorFn(u.name, f.path, f.text, c, k);
                ctorIx = Some(fns.length);
                fns.push(fn);
              },
              _ => {}
            }
          }
          clsIx.set(qualKey(u.name, c.name.name), classes.length);
          classes.push(classInfo(u.name, f.path, f.text, c, ctorIx));
          for (const m of c.members) {
            match (m) {
              MMethod(md) => {
                let fn = methodFn(u.name, f.path, f.text, c, md);
                const q = u.name + "." + c.name.name + "." + md.name.name;
                fn.mutating = fn.kind == 1 && mutOf.has(q);
                fn.pure = pureOf.has(q);
                if (fn.mutating) {
                  mutNames.set(md.name.name, true);
                }
                fnIx.set(fn.key, fns.length);
                fnCount = bumped(fnCount, fn.key);
                fns.push(fn);
              },
              _ => {}
            }
          }
        },
        _ => {}
      }
    }
  }
  // SMT symbols: the source-like name, plus a counter when two functions of the program share it
  let dispCount = new Map<string, usize>();
  for (const fn of fns) {
    dispCount = bumped(dispCount, fn.disp);
  }
  let fx: usize = 0;
  while (fx < fns.length) {
    if (dispCount.get(fns[fx].disp).unwrapOr(0) > 1) {
      fns[fx].sym = fns[fx].disp + "_u" + fx.toString();
    }
    fx += 1;
  }
  const scopes = buildScopes(prog);
  tab.setScope(scopes.types);
  const sealed = sealTab(tab);
  let p = Prog { tab: sealed, fns: fns, fnIx: fnIx, fnCount: fnCount, classes: classes, clsIx: clsIx, consts: consts, mutNames: mutNames, vscope: scopes.vals };
  return computeFrames(p);
}

// ----------------------------------------------------------------------------------------------- solver

function prelude(): string {
  return "(set-option :produce-models true)\n(set-logic ALL)\n"
    + "(define-fun tdiv ((a Int) (b Int)) Int (ite (>= a 0) (ite (>= b 0) (div a b) (- (div a (- b)))) (ite (>= b 0) (- (div (- a) b)) (div (- a) (- b)))))\n"
    + "(define-fun trem ((a Int) (b Int)) Int (- a (* b (tdiv a b))))\n";
}

type Rt = { p: Prog; or: Oracle; fi: usize; qn: usize; out: Res[]; warns: QWarn[]; miss: string[]; };

// A value the counterexample shows: `label = value`, shown when its guard holds (an element only below the
// length, a payload only when present).
type Probe = { label: string; term: string; kind: int; guard: string; idx: int; };

type Solved = { status: string; values: string[]; };

function assertAll(xs: string[]): string {
  let s = "";
  for (const x of xs) {
    s += "(assert " + x + ")\n";
  }
  return s;
}

// The query text for "does `goal` follow from the facts, the assumptions `base` and the path condition `pc`":
// everything asserted and `(not goal)`; `unsat` means it follows.
function queryText(g: Gen, base: string[], pc: string[], goal: string, probes: Probe[], withLemmas: bool, extra: string[]): string {
  return queryOf(g, base, pc, goal, probes, withLemmas, extra, false).text;
}

// A query text and the number of facts it leaves out (slicing).
type Q = { text: string; dropped: usize; total: usize; };

// With `slice` the assertions (facts, lemmas, assumptions, path condition) that share no constant with the goal, directly
// or through other assertions, are left out (slice.or): a subset of the assumptions, so `unsat` of the slice proves the
// goal and nothing else is concluded from it. `extra` is always asserted.
function queryOf(g: Gen, base: string[], pc: string[], goal: string, probes: Probe[], withLemmas: bool, extra: string[], slice: bool): Q {
  let get = "";
  if (probes.length > 0) {
    let ts: string[] = [];
    for (const pr of probes) {
      ts.push(pr.term);
    }
    get = "(get-value (" + ts.join(" ") + "))\n";
  }
  let items = g.factsList();
  if (withLemmas) {
    items = concat(items, g.lemmasList());
  }
  items = concat(concat(items, base), pc);
  let kept = items;
  let dropped: usize = 0;
  if (slice) {
    const keep = sliceKeep(constIds(g.declsList()), items, concat(extra, [goal]));
    kept = [];
    let i: usize = 0;
    while (i < items.length) {
      if (keep[i]) {
        kept.push(items[i]);
      } else {
        dropped += 1;
      }
      i += 1;
    }
  }
  return Q { text: g.declsText() + "\n" + assertAll(kept) + assertAll(extra) + "(assert (not " + goal + "))\n(check-sat)\n" + get,
    dropped: dropped, total: items.length };
}

// The solver's answers, by query. With one thread a query is solved when it is asked. With more, `solve` cannot run
// the solver (a task has one grant, and a function's proofs need the file system and the process), so a query without
// an answer is written to its file and answered `pending` (a Solved whose `values` are its file base and its key); the
// asker passes these up in `miss`, the driver solves them in parallel, enters the answers here, and runs the functions
// that asked again. An answer depends on the text of its query only, so the results do not depend on the number of
// threads.
type Oracle = { z3: string; lim: SolverLimits; deferred: bool; answers: Map<string, Result<Solved, string>>; };

// The solver budget of one run (`orin verify --contracts --timeout-ms N --retry-ms N --rlimit N --slice`). `timeoutMs` is the wall
// time of the first query of an obligation; `retryMs` the wall time of the bounded-search retry after an `unknown`
// (rawProve), 0 = no retry; `rlimit` is z3's deterministic resource limit (0 = none), applied to both queries on top of
// the wall time, so that a query that runs out of it gives `unknown` on every machine.
export type SolverLimits = { timeoutMs: int; retryMs: int; rlimit: int; slice: bool; };

export function defaultSolverLimits(): SolverLimits {
  return SolverLimits { timeoutMs: 4000, retryMs: 1000, rlimit: 0, slice: false };
}

const PENDING: string = "pending";

// A slice that leaves out fewer facts than this is not worth a query of its own (it is as hard as the full one).
const SLICE_MIN_DROP: usize = 16;

// The wall time of a sliced query: a quarter of the first query's (it has fewer facts; when it does not solve quickly the full
// query is asked).
function sliceMs(lim: SolverLimits): int {
  const q = lim.timeoutMs / 4;
  return q < 1 ? 1 : q;
}

function solverCommand(z3: string, lim: SolverLimits, base: string): string {
  const ms = base.endsWith("b") ? lim.retryMs : base.endsWith("s") ? sliceMs(lim) : lim.timeoutMs;
  const hard = (ms + 999) / 1000 + 2;
  const rl = lim.rlimit > 0 ? " rlimit=" + lim.rlimit.toString() : "";
  return z3 + " -in -t:" + ms.toString() + " -T:" + hard.toString() + rl + " < " + base + ".smt2 > " + base + ".out 2>&1";
}

// The answer in `base.out` after the solver ran with exit status `rc`.
function readAnswer(fs: FsGrant, z3: string, base: string, rc: int): Result<Solved, string> {
  if (rc != 0 && rc != 1) {
    return Err("solver `" + z3 + "` could not be run (exit status " + rc.toString() + ")");
  }
  const o = readFile(fs, base + ".out");
  if (o.isErr()) {
    return Err("cannot read solver output");
  }
  const text = o.unwrap();
  const nl = text.indexOf("\n");
  const first = (nl.isSome() ? text.substring(0, nl.unwrap()) : text).trim();
  const rest = nl.isSome() ? text.substring(nl.unwrap() + 1, text.length) : "";
  if (first == "unsat" || first == "sat" || first == "unknown") {
    return Ok(Solved { status: first, values: first == "sat" ? replyValues(rest) : [] });
  }
  return Err("solver answered: " + first);
}

function solve(fs: FsGrant, proc: ProcessGrant, or: Oracle, fi: usize, qn: usize, tag: string, query: string): Result<Solved, string> {
  const base = "build/contracts-vc/f" + fi.toString() + "q" + qn.toString() + tag;
  const text = prelude() + query;
  const key = base + "\n" + text;
  if (or.deferred) {
    const known = or.answers.get(key);
    if (known.isSome()) {
      return known.unwrap();
    }
  }
  const w = writeFile(fs, base + ".smt2", text);
  if (w.isErr()) {
    return Err("cannot write " + base + ".smt2: " + w.unwrapErr());
  }
  if (or.deferred) {
    return Ok(Solved { status: PENDING, values: [base, key] });
  }
  return readAnswer(fs, or.z3, base, shellRun(proc, solverCommand(or.z3, or.lim, base)));
}

// Solves the missed queries (pairs of file base and key) on all threads and enters the answers.
function solveMissing(fs: FsGrant, proc: ProcessGrant, or0: Oracle, miss: string[]): Oracle {
  let or = or0;
  const n = miss.length / 2;
  let cmds: string[] = [];
  let j: usize = 0;
  while (j < n) {
    cmds.push(solverCommand(or0.z3, or0.lim, miss[2 * j]));
    j += 1;
  }
  const rcs = mapOrderedProcess(proc, n, (k, pg) => shellRun(pg, cmds[k]));
  let k: usize = 0;
  while (k < n) {
    or.answers.set(miss[2 * k + 1], readAnswer(fs, or0.z3, miss[2 * k], rcs[k]));
    k += 1;
  }
  return or;
}

// ---------------------------------------------------------------------------------------- counterexamples

function probesOf(g: Gen, tab: Tab, label: string, term: string, vt: VT, depth: usize, out0: Probe[]): Probe[] {
  let out = out0;
  if (out.length > 48) {
    return out;
  }
  match (vt) {
    VInt(_) => { out.push(Probe { label: label, term: term, kind: 0, guard: "", idx: 0 }); },
    VBool => { out.push(Probe { label: label, term: term, kind: 0, guard: "", idx: 0 }); },
    VStr => { out.push(Probe { label: label + ".length", term: "(slen " + term + ")", kind: 0, guard: "", idx: 0 }); },
    VArr(el) => {
      const sn = g.sortFor(vtKey(vt));
      if (sn.isSome()) {
        out.push(Probe { label: label + ".length", term: arrLen(sn.unwrap(), term), kind: 0, guard: "", idx: 0 });
        let i: usize = 0;
        while (i < 3) {
          const elTerm = arrSel(sn.unwrap(), term, i.toString());
          const lbl = label + "[" + i.toString() + "]";
          const before = out.length;
          out = probesOf(g, tab, lbl, elTerm, el, depth + 1, out);
          // mark the probes of this element as guarded by the length
          let j = before;
          while (j < out.length) {
            if (out[j].kind == 0) {
              out[j] = Probe { label: out[j].label, term: out[j].term, kind: 1, guard: label + ".length", idx: i.toInt() };
            }
            j += 1;
          }
          i += 1;
        }
      }
    },
    VOpt(el) => {
      const sn = g.sortFor(vtKey(vt));
      if (sn.isSome()) {
        out.push(Probe { label: label + ".isSome()", term: "((_ is some" + sn.unwrap() + ") " + term + ")", kind: 0, guard: "", idx: 0 });
        const before = out.length;
        out = probesOf(g, tab, label + ".unwrap()", "(val" + sn.unwrap() + " " + term + ")", el, depth + 1, out);
        let j = before;
        while (j < out.length) {
          out[j] = Probe { label: out[j].label, term: out[j].term, kind: 2, guard: label + ".isSome()", idx: 0 };
          j += 1;
        }
      }
    },
    VMap(_, _) => {
      const sn = g.sortFor(vtKey(vt));
      if (sn.isSome()) {
        out.push(Probe { label: label + ".size", term: "(" + sn.unwrap() + "s " + term + ")", kind: 0, guard: "", idx: 0 });
      }
    },
    VUni(un) => {
      const u = tab.findUni(un);
      const sn = g.sortFor(vtKey(vt));
      if (u.isSome() && sn.isSome() && depth < 3 && !tab.isCyclic("u:" + un)) {
        for (const v of u.unwrap().variants) {
          const tl = label + " is " + v.name;
          out.push(Probe { label: tl, term: "((_ is " + sn.unwrap() + "." + v.name + ") " + term + ")", kind: 0, guard: "", idx: 0 });
          let i: usize = 0;
          while (i < v.payload.length) {
            const pt = payloadTy(tab, u.unwrap(), v.payload[i]);
            if (!isBad(pt)) {
              const before = out.length;
              out = probesOf(g, tab, label + "." + v.name + "." + i.toString(), "(" + sn.unwrap() + "." + v.name + "." + i.toString() + " " + term + ")", pt, depth + 1, out);
              let j = before;
              while (j < out.length) {
                out[j] = Probe { label: out[j].label, term: out[j].term, kind: 2, guard: tl, idx: 0 };
                j += 1;
              }
            }
            i += 1;
          }
        }
      }
    },
    VRec(rn) => {
      const rd = tab.findRec(rn);
      const sn = g.sortFor(vtKey(vt));
      if (rd.isSome() && sn.isSome() && depth < 3 && !tab.isCyclic("r:" + rn)) {
        let i: usize = 0;
        const d = rd.unwrap();
        while (i < d.fields.length) {
          const ft = fieldTyOf(tab, d, i);
          if (!isBad(ft)) {
            out = probesOf(g, tab, label + "." + d.fields[i], "(" + sn.unwrap() + "." + d.fields[i] + " " + term + ")", ft, depth + 1, out);
          }
          i += 1;
        }
      }
    },
    _ => {}
  }
  return out;
}

function probesOfVars(g: Gen, tab: Tab, vars: Var[]): Probe[] {
  let out: Probe[] = [];
  for (const v of vars) {
    out = probesOf(g, tab, v.name, v.term, v.vt, 0, out);
  }
  return out;
}

// `x = 5` lines for the probes of a sat answer.
@Ensures(result.length <= probes.length)
function counterexample(probes: Probe[], values: string[]): string[] {
  let out: string[] = [];
  if (values.length != probes.length) {
    return out;
  }
  let i: usize = 0;
  while (i < probes.length) {
    const pr = probes[i];
    let show = true;
    if (pr.kind == 1 || pr.kind == 2) {
      let j: usize = 0;
      while (j < probes.length) {
        if (probes[j].label == pr.guard) {
          if (pr.kind == 1) {
            // element index below the length
            const n = values[j];
            show = !n.startsWith("-") && n.length < 10 && pr.idx.toString().length <= n.length && lessThan(pr.idx, n);
          } else {
            show = values[j] == "true";
          }
        }
        j += 1;
      }
    }
    if (show) {
      out.push(pr.label + " = " + values[i]);
    }
    i += 1;
  }
  return out;
}

function lessThan(i: int, n: string): bool {
  const p = parseInt(n);
  return p.isSome() && i < p.unwrap();
}

// -------------------------------------------------------------------------------- one proof query, a status

type Verdict = { status: string; reason: string; cex: string[]; };

function describeSolverUnknown(): string {
  return "solver returned unknown (timeout or incomplete theory)";
}

@Ensures(result.out.length == rt0.out.length + 1)
function pushRes(rt0: Rt, f: Fn, line: usize, kind: string, clause: string, v: Verdict, used: string[]): Rt {
  let rt = rt0;
  rt.out.push(Res {
    fn: f.disp, file: f.file, line: line, kind: kind, clause: clause, rules: rulesOfList(f.contracts), status: v.status, reason: v.reason, cex: v.cex,
    assumes: v.status == "VERIFIED" ? assumptionsFor(used) : []
  });
  return rt;
}

@Ensures(result.status == "UNKNOWN" && result.reason == reason)
function unknownV(reason: string): Verdict {
  return Verdict { status: "UNKNOWN", reason: reason, cex: [] };
}

// ---------------------------------------------------------------------------------------- the function

// Everything a function's proofs share.
type Entry = { g: Gen; vars: Var[]; base: string[]; rangeBase: string[]; probes: Probe[]; sig: Sig; cx: Cx; cls: Option<Cls>; };

function clauseKinds(f: Fn, c: Option<Cls>): usize {
  return clausesOfList(f.contracts, 1).length;
}

// Does a method of this class have to preserve its invariants (public, changes `this`)?
function checksInvariants(f: Fn, c: Option<Cls>): bool {
  if (c.isNone() || c.unwrap().invs.length == 0) {
    return false;
  }
  return (f.kind == 1 && !f.priv && (f.mutating)) || f.kind == 3;
}

function allUnknown(rt0: Rt, f: Fn, c: Option<Cls>, reason: string): Rt {
  let rt = rt0;
  for (const cl of clausesOfList(f.contracts, 1)) {
    rt = pushRes(rt, f, lineOf(f.text, cl.span.start), "ensures", clauseText(f.text, cl), unknownV(reason), []);
  }
  if (checksInvariants(f, c)) {
    for (const iv of c.unwrap().invs) {
      rt = pushRes(rt, f, f.line, "invariant", clauseText(c.unwrap().text, iv), unknownV(reason), []);
    }
  }
  return rt;
}

// The entry state of a function: parameters (and `this`) as free constants of their sorts in their ranges; class
// invariants of the objects passed in are assumed (A-INV).
function entryOf(rt: Rt, f: Fn, c: Option<Cls>): Result<Entry, string> {
  let g = new Gen();
  const cx0 = Cx { p: rt.p, unit: f.unit, f: f, res: None, ens: false, body: true, olds: [], ret: VUnit, inQ: false, text: f.text };
  const sig = sigOf(cx0, f)?;
  let vars: Var[] = [];
  let base: string[] = [];
  let i: usize = 0;
  while (i < f.pnames.length) {
    const so = sortS(g, cx0, sig.ptys[i])?;
    g = so.g;
    const nm = "p_" + f.pnames[i];
    g.declare("(declare-const " + nm + " " + so.s + ")");
    const wf = wfOf(g, cx0, nm, sig.ptys[i], 0)?;
    g = wf.g;
    if (wf.f != "") {
      base.push(wf.f);
    }
    vars.push(Var { name: f.pnames[i], term: nm, vt: sig.ptys[i] });
    i += 1;
  }
  if (f.kind == 1) {
    const ct = VRec(f.cls);
    const so = sortS(g, cx0, ct)?;
    g = so.g;
    g.declare("(declare-const p_this " + so.s + ")");
    const wt = wfOf(g, cx0, "p_this", ct, 0)?;
    g = wt.g;
    if (wt.f != "") {
      base.push(wt.f);
    }
    vars.push(Var { name: "this", term: "p_this", vt: ct });
  }
  const cx = Cx { p: rt.p, unit: f.unit, f: f, res: None, ens: false, body: true, olds: [], ret: sig.rty, inQ: false, text: f.text };
  return Ok(Entry { g: g, vars: vars, base: base, rangeBase: base, probes: [], sig: sig, cx: cx, cls: c });
}

// Assume the class invariants of every class-typed parameter and of `this` (public methods).
function assumeInvariants(rt: Rt, f: Fn, en0: Entry): Entry {
  let en = en0;
  for (const v of en.vars) {
    match (v.vt) {
      VRec(_) => {
        if (v.name == "this" && (f.priv || f.kind == 3)) {
          continue;
        }
        const iv = valueInvariants(en.g, en.cx, v.vt, v.term);
        en.g = iv.g;
        for (const t of iv.terms) {
          en.base.push(t);
        }
        if (iv.terms.length > 0) {
          en.g.useAssumption("A-INV");
        }
      },
      _ => {}
    }
  }
  return en;
}

// The variables `old(..)` reads (the entry state) with `this` replaced by the final one for the post-state.
function postVars(entry: Var[], fin: Var[]): Var[] {
  let out: Var[] = [];
  for (const v of entry) {
    if (v.name == "this") {
      const t = lookupVar(fin, "this");
      out.push(t.isSome() ? t.unwrap() : v);
    } else {
      out.push(v);
    }
  }
  return out;
}

// What the solver said, before it is judged.
type Raw = { status: string; reason: string; values: string[]; miss: string[]; };

// Is `unknown` worth a second try? The quantified facts that make a proof possible (the lemmas about sums, the
// elementwise definitions) often keep the solver from building a model when the claim is false. A bounded search
// drops the lemmas (they follow from the definitions, so a model of the definitions satisfies them) and limits the
// length of every array and string that is shown in the counterexample: a model found that way is a model of the
// original query, hence a real counterexample.
function rawProve(fs: FsGrant, proc: ProcessGrant, or: Oracle, fi: usize, qn: usize, g: Gen, base: string[], pc: string[], goal: string, probes: Probe[]): Raw {
  // First the sliced query (slice.or): `unsat` is a proof. Anything else (a model of fewer assumptions, `unknown`) is
  // no answer, the full query is asked as before, so slicing can only add proofs and costs a query when it fails.
  if (or.lim.slice) {
    const qs = queryOf(g, base, pc, goal, probes, true, [], true);
    if (qs.dropped >= SLICE_MIN_DROP && qs.dropped * 4 >= qs.total) {
      const ss = solve(fs, proc, or, fi, qn, "s", qs.text);
      if (ss.isOk()) {
        if (ss.unwrap().status == PENDING) {
          return Raw { status: "error", reason: PENDING, values: [], miss: ss.unwrap().values };
        }
        if (ss.unwrap().status == "unsat") {
          return Raw { status: "unsat", reason: "", values: [], miss: [] };
        }
      }
    }
  }
  const q = queryText(g, base, pc, goal, probes, true, []);
  const s = solve(fs, proc, or, fi, qn, "", q);
  if (s.isErr()) {
    return Raw { status: "error", reason: s.unwrapErr(), values: [], miss: [] };
  }
  const r = s.unwrap();
  if (r.status == PENDING) {
    return Raw { status: "error", reason: PENDING, values: [], miss: r.values };
  }
  if (r.status == "unknown" && probes.length > 0 && or.lim.retryMs > 0) {
    let bounds: string[] = [];
    for (const pr of probes) {
      if (pr.label.endsWith(".length") && pr.kind == 0) {
        bounds.push("(<= " + pr.term + " 3)");
      }
    }
    if (bounds.length > 0) {
      const q2 = queryText(g, base, pc, goal, probes, false, bounds);
      const s2 = solve(fs, proc, or, fi, qn, "b", q2);
      if (s2.isOk() && s2.unwrap().status == PENDING) {
        return Raw { status: "error", reason: PENDING, values: [], miss: s2.unwrap().values };
      }
      if (s2.isOk() && s2.unwrap().status == "sat") {
        return Raw { status: "sat", reason: "", values: s2.unwrap().values, miss: [] };
      }
    }
  }
  return Raw { status: r.status, reason: "", values: r.values, miss: [] };
}

// A sat answer is a counterexample only if nothing on the way was an abstraction.
// VERIFIED only from unsat; REFUTED only from sat on a path without abstraction (the soundness rule of ADR-0036).
@Ensures(result.status == "VERIFIED" ==> r.status == "unsat")
@Ensures(r.status == "unsat" ==> result.status == "VERIFIED")
@Ensures(result.status == "REFUTED" ==> r.status == "sat" && approx == "")
function judge(g: Gen, r: Raw, approx: string, probes: Probe[]): Verdict {
  if (r.status == "unsat") {
    return Verdict { status: "VERIFIED", reason: "", cex: [] };
  }
  if (r.status == "error") {
    return unknownV(r.reason);
  }
  if (r.status == "sat") {
    if (approx != "") {
      return unknownV(approx);
    }
    if (g.approxReason() != "") {
      return unknownV(g.approxReason() + " (a counterexample is not trusted)");
    }
    const cex = counterexample(probes, r.values);
    return Verdict { status: "REFUTED", reason: "", cex: cex.length > 0 ? cex : ["(no model values)"] };
  }
  return unknownV(describeSolverUnknown());
}

// The reason an obligation's counterexample is not trusted (only computed when there is a model).
function obligApprox(g: Gen, base: string[], raw: Raw, o: Obl): string {
  if (raw.status != "sat") {
    return "";
  }
  if (o.approx != "") {
    return o.approx;
  }
  return taintOf(g, base, o.pc, o.goal);
}

// One goal at the end of one path: what holds on the path, what is to be proved, what the path used.
type RetGoal = { pc: string[]; goal: string; approx: string; deps: usize[]; };

// The loops a result relies on: all their invariant obligations must be VERIFIED, else the result is UNKNOWN.
// A result that relied on an unproved loop invariant is never upgraded: only VERIFIED can change, to UNKNOWN.
@Ensures(v.status != "VERIFIED" ==> result.status == v.status)
@Ensures(result.status == "VERIFIED" ==> v.status == "VERIFIED")
function depsVerdict(g: Gen, statuses: string[], deps: usize[], v: Verdict): Verdict {
  if (v.status != "VERIFIED") {
    return v;
  }
  for (const d of deps) {
    for (const id of g.loopMembers(d)) {
      if (id < statuses.length && statuses[id] != "VERIFIED") {
        const o = g.oblList()[id];
        return unknownV("relies on a loop invariant that is not proved: " + o.clause + " (line " + o.line.toString() + ")");
      }
    }
  }
  return v;
}

// A clause at the end of every path: proved together; when that fails and some paths went through an
// abstraction, the exact paths are tried alone (a counterexample on one of them is a real one).
type Proved = { v: Verdict; used: usize; miss: string[]; };

// Why a path's counterexample is not trusted, once the solver has produced one: the path went through an
// abstraction (a loop), or its path condition or goal mentions a value that is only known through a callee's contract.
function pathApprox(g: Gen, base: string[], r: RetGoal): string {
  if (r.approx != "") {
    return r.approx;
  }
  return taintOf(g, base, r.pc, r.goal);
}

const TAINT_REASON: string = "the counterexample depends on a value the model does not know: the result of a call that is only known through its contract (A-CALL), or the contents of a string";

// The assumptions about the inputs (`base`: the @Requires and invariants) count too: a model of an input that a pure
// helper in a @Requires only abstractly allows need not be an input the real function accepts.
function taintOf(g: Gen, base: string[], pc: string[], goal: string): string {
  if (g.mentionsTaint(goal)) {
    return TAINT_REASON;
  }
  for (const b of base) {
    if (g.mentionsTaint(b)) {
      return TAINT_REASON;
    }
  }
  for (const p of pc) {
    if (g.mentionsTaint(p)) {
      return TAINT_REASON;
    }
  }
  return "";
}

function proveRets(fs: FsGrant, proc: ProcessGrant, or: Oracle, fi: usize, qn0: usize, g: Gen, base: string[], goals: RetGoal[], statuses: string[], probes: Probe[]): Proved {
  let parts: string[] = [];
  let deps: usize[] = [];
  for (const r of goals) {
    parts.push("(=> " + andAll(r.pc) + " " + r.goal + ")");
    deps = unionUsize(deps, r.deps);
  }
  let used: usize = 1;
  let miss: string[] = [];
  const raw = rawProve(fs, proc, or, fi, qn0, g, base, [], andAll(parts), probes);
  miss = concat(miss, raw.miss);
  if (raw.status == "unsat") {
    return Proved { v: depsVerdict(g, statuses, deps, Verdict { status: "VERIFIED", reason: "", cex: [] }), used: used, miss: miss };
  }
  if (raw.status != "sat") {
    return Proved { v: judge(g, raw, "", probes), used: used, miss: miss };
  }
  // A model: it is a counterexample only if some path that is exact (no abstraction, no dependence on a callee's
  // contract) can violate the clause. Paths without such a flaw are judged alone.
  let anyApprox = "";
  let allExact = true;
  for (const r of goals) {
    const a = pathApprox(g, base, r);
    if (a != "") {
      allExact = false;
      if (anyApprox == "") {
        anyApprox = a;
      }
    }
  }
  if (allExact) {
    return Proved { v: judge(g, raw, "", probes), used: used, miss: miss };
  }
  for (const r of goals) {
    if (pathApprox(g, base, r) == "") {
      const one = rawProve(fs, proc, or, fi, qn0 + used, g, base, [], "(=> " + andAll(r.pc) + " " + r.goal + ")", probes);
      used += 1;
      miss = concat(miss, one.miss);
      if (one.status == "sat") {
        return Proved { v: judge(g, one, "", probes), used: used, miss: miss };
      }
    }
  }
  return Proved { v: unknownV(anyApprox), used: used, miss: miss };
}

// ---------------------------------------------------------------------------------------- the function

function isEnsuresTask(k: string): bool {
  return k == "ensures";
}

type Task = { kind: string; text: string; line: usize; e: Expr; ctext: string; inv: bool; };

// The clauses a function must prove at its returns: its @Ensures and, for a public method that changes `this`
// and for a constructor, the class invariants.
function tasksOf(f: Fn, c: Option<Cls>): Task[] {
  let out: Task[] = [];
  for (const cl of clausesOfList(f.contracts, 1)) {
    const ex = exprOf(cl);
    if (ex.isSome()) {
      out.push(Task { kind: "ensures", text: clauseText(f.text, cl), line: lineOf(f.text, cl.span.start), e: ex.unwrap(), ctext: f.text, inv: false });
    }
  }
  if (checksInvariants(f, c)) {
    for (const iv of c.unwrap().invs) {
      const ex = exprOf(iv);
      if (ex.isSome()) {
        out.push(Task { kind: "invariant", text: clauseText(c.unwrap().text, iv), line: f.line, e: ex.unwrap(), ctext: c.unwrap().text, inv: true });
      }
    }
  }
  return out;
}

// The state of a constructor before its body: the fields take the parameters (parameter properties), their
// initialiser (when it translates) or an arbitrary value (a leading `this.f = e;` sets it next).
function ctorEntry(en0: Entry, f: Fn, cls: Cls): Result<Entry, string> {
  let en = en0;
  let g = en.g;
  const ct = VRec(cls.name);
  const so = sortS(g, en.cx, ct)?;
  g = so.g;
  const icx = Cx { p: en.cx.p, unit: cls.unit, f: f, res: None, ens: false, body: false, olds: [], ret: VUnit, inQ: false, text: cls.text };
  let args: string[] = [];
  let i: usize = 0;
  while (i < cls.fields.length) {
    const name = cls.fields[i];
    const ft = resolveTyP(en.cx.p.tab, cls.unit, cls.ftys[i], cls.tparams);
    let term = "";
    let k: usize = 0;
    while (k < f.pnames.length) {
      if (f.pnames[k] == name && f.pacc[k] != 0) {
        const pv = lookupVar(en.vars, name);
        if (pv.isSome()) {
          term = pv.unwrap().term;
        }
      }
      k += 1;
    }
    if (term == "" && cls.finit[i].isSome() && !isBad(ft)) {
      const none: Var[] = [];
      const r = trClause2(g, none, icx, cls.finit[i].unwrap(), ft);
      match (r) {
        Ok(x) => {
          g = x.g;
          term = x.t;
        },
        Err(_) => {}
      }
    }
    if (term == "") {
      if (isBad(ft)) {
        const os = opaqueSort(g);
        g = os.g;
        const nm = g.next("o");
        g.declare("(declare-const " + nm + " " + os.s + ")");
        term = nm;
      } else {
        const fr = freshFree(g, en.cx, ft)?;
        g = fr.g;
        term = fr.name;
      }
    }
    args.push(term);
    i += 1;
  }
  const th = fresh(g, en.cx, ct, "(mk" + so.s + (args.length > 0 ? " " + args.join(" ") : "") + ")")?;
  g = th.g;
  en.g = g;
  en.vars.push(Var { name: "this", term: th.name, vt: ct });
  return Ok(en);
}

function trClause2(g: Gen, vars: Var[], cx: Cx, e: Expr, exp: VT): Result<TR, string> {
  return tr(g, vars, cx, e, exp);
}

function verifyFn(fs: FsGrant, proc: ProcessGrant, rt0: Rt, f: Fn): Rt {
  let rt = rt0;
  let cls: Option<Cls> = None;
  if (f.cls != "") {
    const co = rt.p.clsIx.get(f.cls);
    if (co.isSome()) {
      cls = Some(rt.p.classes[co.unwrap()]);
    }
  }
  for (const c of clausesOfList(f.contracts, 2)) {
    rt = pushRes(rt, f, lineOf(f.text, c.span.start), "decreases", clauseText(f.text, c), unknownV("termination measures are not checked (v1)"), []);
  }

  if (f.kind != 0 && cls.isNone()) {
    return allUnknown(rt, f, cls, "class `" + bareOf(f.cls) + "` is outside the fragment");
  }
  const enR = entryOf(rt, f, cls);
  if (enR.isErr()) {
    return allUnknown(rt, f, cls, enR.unwrapErr());
  }
  let en = enR.unwrap();
  if (f.kind == 3) {
    const cr = ctorEntry(en, f, cls.unwrap());
    if (cr.isErr()) {
      return allUnknown(rt, f, cls, cr.unwrapErr());
    }
    en = cr.unwrap();
  }
  en = assumeInvariants(rt, f, en);
  // @Requires: hypotheses.
  const rcx = Cx { p: rt.p, unit: f.unit, f: f, res: None, ens: false, body: false, olds: [], ret: en.sig.rty, inQ: false, text: f.text };
  let reqTerms: string[] = [];
  for (const c of clausesOfList(f.contracts, 0)) {
    const ex = exprOf(c);
    if (ex.isSome()) {
      const r = trClause(en.g, en.vars, rcx, ex.unwrap());
      match (r) {
        Ok(x) => {
          en.g = x.g;
          reqTerms.push(clHyp(x));
        },
        Err(m) => {
          return allUnknown(rt, f, cls, "@Requires: " + m);
        }
      }
    }
  }
  const rangeBase = en.base;
  let base = concat(en.base, reqTerms);
  en.probes = probesOfVars(en.g, rt.p.tab, en.vars);
  if (f.kind == 0) {
    rt = qualityChecks(fs, proc, rt, f, en, reqTerms);
  }
  // Execute the body.
  const st0 = St { vars: en.vars, pc: [], deps: [], approx: "" };
  const exR = execStmts(en.g, st0, en.cx, f.body.stmts, true);
  if (exR.isErr()) {
    return allUnknown(rt, f, cls, exR.unwrapErr());
  }
  const ex = exR.unwrap();
  let g = ex.g;
  let rets = ex.rets;
  if (ex.fall) {
    rets.push(Ret { st: ex.st, val: "", vt: VUnit, isVoid: true });
  }
  const reportSafety = hasClauses(f) || checksInvariants(f, cls);
  // The obligations found on the way (call preconditions, indexes, `unwrap`, loop invariants). Those found while
  // unrolling a loop (`exact`) repeat the ones of the abstract pass: they are solved only when the abstract one is
  // not proved, and a real counterexample among them is the answer for that place.
  const obls = g.oblList();
  let keys: string[] = [];
  let verdicts: Verdict[] = [];
  let statuses: string[] = [];
  for (const o of obls) {
    keys.push(o.kind + "|" + o.line.toString() + "|" + o.clause);
    verdicts.push(unknownV("not solved"));
    statuses.push("PENDING");
  }
  let id: usize = 0;
  while (id < obls.length) {
    const o = obls[id];
    const wanted = o.kind == "call-precondition" || o.kind == "loop-invariant" || reportSafety;
    if (!wanted) {
      statuses[id] = "SKIPPED";
    } else if (!o.exact) {
      const raw = rawProve(fs, proc, rt.or, rt.fi, rt.qn, g, base, o.pc, o.goal, en.probes);
      rt.qn += 1;
      rt.miss = concat(rt.miss, raw.miss);
      verdicts[id] = judge(g, raw, obligApprox(g, base, raw, o), en.probes);
      statuses[id] = verdicts[id].status;
    }
    id += 1;
  }
  id = 0;
  while (id < obls.length) {
    const o = obls[id];
    if (o.exact && statuses[id] == "PENDING") {
      let covered = false;
      let j: usize = 0;
      while (j < obls.length) {
        if (!obls[j].exact && keys[j] == keys[id] && statuses[j] == "VERIFIED") {
          covered = true;
        }
        j += 1;
      }
      if (covered) {
        statuses[id] = "COVERED";
      } else {
        const raw = rawProve(fs, proc, rt.or, rt.fi, rt.qn, g, base, o.pc, o.goal, en.probes);
        rt.qn += 1;
        rt.miss = concat(rt.miss, raw.miss);
        verdicts[id] = judge(g, raw, obligApprox(g, base, raw, o), en.probes);
        statuses[id] = verdicts[id].status;
      }
    }
    id += 1;
  }
  let reportedExact: string[] = [];
  id = 0;
  while (id < obls.length) {
    const o = obls[id];
    if (!o.exact && statuses[id] != "SKIPPED" && !o.hidden) {
      let v = depsVerdict(g, statuses, o.deps, verdicts[id]);
      if (v.status != "VERIFIED") {
        let j: usize = 0;
        while (j < obls.length) {
          if (obls[j].exact && keys[j] == keys[id] && statuses[j] == "REFUTED") {
            v = verdicts[j];
          }
          j += 1;
        }
      }
      rt = pushRes(rt, f, o.line, o.kind, o.clause, v, g.usedList());
    }
    id += 1;
  }
  // An obligation that only the unrolled pass has (no abstract twin) and that fails for real.
  id = 0;
  while (id < obls.length) {
    const o = obls[id];
    if (o.exact && statuses[id] == "REFUTED" && !reportedExact.includes(keys[id])) {
      let twin = false;
      let j: usize = 0;
      while (j < obls.length) {
        if (!obls[j].exact && keys[j] == keys[id] && statuses[j] != "SKIPPED") {
          twin = true;
        }
        j += 1;
      }
      if (!twin) {
        reportedExact.push(keys[id]);
        rt = pushRes(rt, f, o.line, o.kind, o.clause, verdicts[id], g.usedList());
      }
    }
    id += 1;
  }
  // Postconditions and class invariants at every return.
  const rty = en.sig.rty;
  for (const t of tasksOf(f, cls)) {
    let goals: RetGoal[] = [];
    let failure = "";
    for (const r of rets) {
      if (r.isVoid != isUnit(rty)) {
        failure = "return statements do not match the declared result type";
        continue;
      }
      let res: Option<Var> = None;
      if (!r.isVoid) {
        res = Some(Var { name: "result", term: r.val, vt: r.vt });
      }
      let env = postVars(en.vars, r.st.vars);
      let ecx = Cx { p: rt.p, unit: f.unit, f: f, res: res, ens: true, body: false, olds: en.vars, ret: rty, inQ: false, text: t.ctext };
      if (t.inv) {
        const tv = lookupVar(env, "this");
        if (tv.isNone()) {
          failure = "no `this` at a return";
          continue;
        }
        env = [Var { name: "this", term: tv.unwrap().term, vt: tv.unwrap().vt }];
        ecx = Cx { p: rt.p, unit: f.unit, f: f, res: None, ens: false, body: false, olds: [], ret: rty, inQ: false, text: t.ctext };
      }
      const c = trClause(g, env, ecx, t.e);
      match (c) {
        Err(m) => { failure = m; },
        Ok(x) => {
          g = x.g;
          goals.push(RetGoal { pc: r.st.pc, goal: clGoal(x), approx: r.st.approx, deps: r.st.deps });
        }
      }
    }
    if (failure != "") {
      rt = pushRes(rt, f, t.line, t.kind, t.text, unknownV(failure), []);
    } else {
      const pr = proveRets(fs, proc, rt.or, rt.fi, rt.qn, g, base, goals, statuses, en.probes);
      rt.qn += pr.used;
      rt.miss = concat(rt.miss, pr.miss);
      rt = pushRes(rt, f, t.line, t.kind, t.text, pr.v, g.usedList());
    }
  }
  return rt;
}

// ---------------------------------------------------------------------------------------------- quality

type Entail = { rt: Rt; holds: bool; };

// True exactly when the solver proves `goal` from the facts of `g` and the assumptions `base` (`unsat` of the
// negation). `sat`, `unknown` and solver errors all mean "not proved": a finding needs a proof.
function entails(fs: FsGrant, proc: ProcessGrant, rt0: Rt, g: Gen, base: string[], goal: string): Entail {
  let rt = rt0;
  const none: Probe[] = [];
  const raw = rawProve(fs, proc, rt.or, rt.fi, rt.qn, g, base, [], goal, none);
  rt.qn += 1;
  rt.miss = concat(rt.miss, raw.miss);
  return Entail { rt: rt, holds: raw.status == "unsat" };
}

function pushWarn(rt0: Rt, f: Fn, code: string, kind: string, c: ContractClause, message: string): Rt {
  let rt = rt0;
  rt.warns.push(QWarn {
    code: code, fn: f.disp, file: f.file, line: lineOf(f.text, c.span.start), kind: kind,
    clause: clauseText(f.text, c), message: message, status: "VERIFIED"
  });
  return rt;
}

function decl0(f: Fn): FunctionDecl {
  return FunctionDecl {
    exported: false, name: Ident { name: f.name, span: f.span }, typeParams: [], bounds: [], params: f.params, ret: f.ret, body: f.body,
    contracts: f.contracts, annotations: [], span: f.span
  };
}

// The contract-quality checks of one function in the supported fragment (ADR-0028). They concern the clauses
// only (not the body), so they run before the body is examined. A clause the fragment cannot translate is
// skipped silently: a warning is only issued with a solver proof.
//   W0460  clause valid with no premises (parameters in their type's range only): it cannot fail
//   W0461  the @Requires clauses together are unsatisfiable: the function can never be called
//   W0462  an @Ensures that follows from the @Requires alone, whatever the result is: the body cannot violate it
function qualityChecks(fs: FsGrant, proc: ProcessGrant, rt0: Rt, f: Fn, en: Entry, reqTerms: string[]): Rt {
  let rt = rt0;
  const d = decl0(f);
  let g = en.g;
  const reqs = clausesOfList(f.contracts, 0);
  const enss = clausesOfList(f.contracts, 1);
  const rcx = Cx { p: rt.p, unit: f.unit, f: f, res: None, ens: false, body: false, olds: [], ret: en.sig.rty, inQ: false, text: f.text };
  for (const c of reqs) {
    const e = exprOf(c);
    if (e.isNone()) {
      continue;
    }
    const t = trClause(g, en.vars, rcx, e.unwrap());
    if (t.isErr()) {
      return rt;
    }
    g = t.unwrap().g;
    if (!isSyntacticallyTrivial(d, c)) {
      const r = entails(fs, proc, rt, g, en.rangeBase, clGoal(t.unwrap()));
      rt = r.rt;
      if (r.holds && g.approxReason() == "") {
        rt = pushWarn(rt, f, W_TAUTOLOGY, "tautology", c, "`@Requires` is valid without any premises: it excludes no input and catches no bug");
      }
    }
  }
  const withReqs = concat(en.rangeBase, reqTerms);
  if (reqTerms.length > 0) {
    const u = entails(fs, proc, rt, g, withReqs, "false");
    rt = u.rt;
    if (u.holds) {
      return pushWarn(rt, f, W_UNSAT_REQUIRES, "unsatisfiable-requires", reqs[0], "the `@Requires` clauses of `" + f.disp + "` are unsatisfiable: the function can never be called, and every `@Ensures` holds vacuously");
    }
  }
  // `result` is a fresh unconstrained value: what holds for all of them cannot be violated by the body.
  let g2 = g;
  let res: Option<Var> = None;
  let resBase = en.rangeBase;
  if (!isUnit(en.sig.rty)) {
    const fr = freshFree(g2, en.cx, en.sig.rty);
    if (fr.isErr()) {
      return rt;
    }
    g2 = fr.unwrap().g;
    res = Some(Var { name: "result", term: fr.unwrap().name, vt: en.sig.rty });
  }
  const ecx = Cx { p: rt.p, unit: f.unit, f: f, res: res, ens: true, body: false, olds: en.vars, ret: en.sig.rty, inQ: false, text: f.text };
  for (const c of enss) {
    const e = exprOf(c);
    if (e.isNone()) {
      continue;
    }
    const t = trClause(g2, en.vars, ecx, e.unwrap());
    if (t.isErr()) {
      continue;
    }
    g2 = t.unwrap().g;
    const goal = clGoal(t.unwrap());
    const taut = entails(fs, proc, rt, g2, resBase, goal);
    rt = taut.rt;
    if (taut.holds) {
      if (!isSyntacticallyTrivial(d, c) && g2.approxReason() == "") {
        rt = pushWarn(rt, f, W_TAUTOLOGY, "tautology", c, "`@Ensures` is valid without any premises: it holds for every result and catches no bug");
      }
    } else if (reqTerms.length > 0) {
      const imp = entails(fs, proc, rt, g2, concat(resBase, reqTerms), goal);
      rt = imp.rt;
      if (imp.holds && g2.approxReason() == "") {
        rt = pushWarn(rt, f, W_IMPLIED_ENSURES, "implied-ensures", c, "`@Ensures` follows from the `@Requires` alone for every possible result: the body cannot violate it");
      }
    }
  }
  return rt;
}

// ----------------------------------------------------------------------------------------------- driver

// What proving one function yields; the driver puts these together in function order. `miss`: the queries that had no
// answer yet (then the rest is not final).
type FnRes = { out: Res[]; warns: QWarn[]; miss: string[]; };

// Functions are independent: query files are named after the function index (f<fi>q<n>), and nothing but the
// read-only program and the answers of the solver is shared.
function verifyOne(fs: FsGrant, proc: ProcessGrant, p: Prog, or: Oracle, fi: usize): FnRes {
  const rt = verifyFn(fs, proc, Rt { p: p, or: or, fi: fi, qn: 0, out: [], warns: [], miss: [] }, p.fns[fi]);
  return FnRes { out: rt.out, warns: rt.warns, miss: rt.miss };
}

export function verifyContracts(fs: FsGrant, proc: ProcessGrant, prog: LoadedProgram, sm: SourceMap, hir: Program, z3: string, lim: SolverLimits): Report {
  const p = buildProg(prog, sm, hir);
  shellRun(proc, "mkdir -p build/contracts-vc");
  let or = Oracle { z3: z3, lim: lim, deferred: parallelism() > 1, answers: new Map<string, Result<Solved, string>>() };
  // Functions without clauses are still analysed (their calls of contracted functions are proof obligations);
  // if they are outside the fragment nothing is reported for them.
  let todo: usize[] = [];
  let done: FnRes[] = [];
  let open: usize[] = [];
  let i: usize = 0;
  while (i < p.fns.length) {
    if (p.fns[i].verify) {
      open.push(todo.length);
      todo.push(i);
      done.push(FnRes { out: [], warns: [], miss: [] });
    }
    i += 1;
  }
  // Rounds: a function that asked a query without an answer is run again after the queries of the round are solved;
  // one that asked none is final. Without deferring there is one round.
  while (open.length > 0) {
    let again: usize[] = [];
    let miss: string[] = [];
    for (const k of open) {
      const r = verifyOne(fs, proc, p, or, todo[k]);
      if (r.miss.length == 0) {
        done[k] = r;
      } else {
        again.push(k);
        miss = concat(miss, r.miss);
      }
    }
      if (miss.length > 0) {
      or = solveMissing(fs, proc, or, miss);
    }
    open = again;
  }
  let results: Res[] = [];
  let warns: QWarn[] = [];
  for (const r of done) {
    for (const x of r.out) {
      results.push(x);
    }
    for (const w of r.warns) {
      warns.push(w);
    }
  }
  return Report { results: results, warnings: warns };
}
