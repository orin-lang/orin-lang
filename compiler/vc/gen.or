// SMT-LIB generation state of the contract verifier (ADR-0031 B6): the declarations and facts of one
// verification run of a function, the proof obligations collected while executing it, and the SMT sorts of the
// verifier types (arrays as a data array plus a length, records / classes / unions / `Option` / `Result` as
// datatypes, `Map` as presence array, value array and size, strings as an uninterpreted sort with a length).

import { VT, VInt, VBool, VStr, VUnit, VArr, VOpt, VRes, VMap, VRec, VUni, VOpq, VBad, Tab, vtKey, vtName, payloadTy, fieldTyOf, RecDef, UniDef, isBad, badReason, intLo, intHi } from "./vt";
import { bareOf } from "./scope";

// A proof obligation found while executing a function: it must hold on every execution that reaches it.
//   kind: "call-precondition" | "bounds" | "unwrap" | "loop-invariant" | "invariant" | "ensures"
//   what: callee name or a short description; clause: the clause text or the operation
//   goal: the SMT term to prove; pc: the path condition (assumptions on this path)
//   deps: ids of the loop-invariant obligations whose invariants this one assumes
//   exact: found while unrolling a loop a few iterations (no abstraction): its counterexamples are real
//   hidden: an inferred loop bound: only used (assumed after the loop), never reported by itself
//   approx: non-empty when the path went through an abstraction (the reason): a counterexample is then not
//   trusted (UNKNOWN), a proof still counts.
export type Obl = {
  kind: string; what: string; line: usize; clause: string; goal: string; pc: string[]; deps: usize[]; approx: string;
  file: string; fn: string; text: string; hidden: bool; exact: bool;
};

// Declarations (`declare-const`, datatypes, functions) are kept in the order they were created: a sort is always
// declared before its first use. Facts are definitions and valid axioms that hold in every execution (a fresh
// constant equals the term it names, a pure function satisfies its contract at a call): they are asserted
// in every query. Path-dependent assumptions are not facts; they travel in the path condition of the state.
@Invariant(this.sortKeys.length == this.sortSmts.length && this.litTexts.length == this.litNames.length)
export class Gen {
  private decls: string[] = [];
  private facts: string[] = [];
  private counter: usize = 0;
  private sortKeys: string[] = [];
  private sortSmts: string[] = [];
  private funNames: string[] = [];
  private litTexts: string[] = [];
  private litNames: string[] = [];
  private obls: Obl[] = [];
  private lemmas: string[] = [];
  private loopObls: usize[][] = [];
  private approxWhy: string = "";
  private strKinds: string[] = [];
  private taints: string[] = [];
  private exactMode: bool = false;
  private memoKeys: string[] = [];
  private memoVals: string[] = [];
  private usedIds: string[] = [];
  private active: string[] = [];

  // A new unique SMT symbol with the given prefix (the counter only grows, so no symbol is handed out twice).
  @Ensures(this.counter == old(this.counter) + 1)
  next(prefix: string): string {
    this.counter += 1;
    return prefix + this.counter.toString();
  }

  @Ensures(this.decls.length == old(this.decls.length) + 1)
  declare(d: string): void {
    this.decls.push(d);
  }

  @Ensures(this.facts.length == old(this.facts.length) + 1)
  assert(f: string): void {
    this.facts.push(f);
  }

  factCount(): usize {
    return this.facts.length;
  }

  // The facts added since the first `n`, removed again (used for the facts of a quantifier body, which must
  // not be asserted outside it).
  @Requires(n <= this.facts.length)
  @Ensures(this.facts.length == n && result.length == old(this.facts.length) - n)
  takeFactsFrom(n: usize): string[] {
    let out: string[] = [];
    let kept: string[] = [];
    let i: usize = 0;
    while (i < this.facts.length) {
      if (i < n) {
        kept.push(this.facts[i]);
      } else {
        out.push(this.facts[i]);
      }
      i += 1;
    }
    this.facts = kept;
    return out;
  }

  declsText(): string {
    return this.decls.join("\n");
  }

  factsList(): string[] {
    return this.facts;
  }

  // Lemma facts: valid theorems about recursive definitions (sums); asserted like facts, kept apart so that the
  // query text shows them in one place.
  @Ensures(this.lemmas.length == old(this.lemmas.length) + 1)
  lemma(f: string): void {
    this.lemmas.push(f);
  }

  lemmasList(): string[] {
    return this.lemmas;
  }

  sortFor(key: string): Option<string> {
    let i: usize = 0;
    while (i < this.sortKeys.length) {
      if (this.sortKeys[i] == key) {
        return Some(this.sortSmts[i]);
      }
      i += 1;
    }
    return None;
  }

  @Requires(this.sortFor(key).isNone())
  @Ensures(this.sortFor(key).isSome())
  registerSort(key: string, smt: string): void {
    this.sortKeys.push(key);
    this.sortSmts.push(smt);
  }

  // Exact mode: loops are unrolled a few iterations instead of abstracted (bounded refutation, stmt.or).
  @Ensures(this.exactMode == b)
  setExact(b: bool): void {
    this.exactMode = b;
  }

  isExact(): bool {
    return this.exactMode;
  }

  // A small memo table: a recursive definition (a sum) is made once per distinct summand.
  memoGet(key: string): Option<string> {
    let i: usize = 0;
    while (i < this.memoKeys.length) {
      if (this.memoKeys[i] == key) {
        return Some(this.memoVals[i]);
      }
      i += 1;
    }
    return None;
  }

  @Requires(this.memoGet(key).isNone())
  @Ensures(this.memoGet(key).isSome())
  memoPut(key: string, val: string): void {
    this.memoKeys.push(key);
    this.memoVals.push(val);
  }

  // The functions whose contract is being instantiated at a call right now: a call of one of them inside its own
  // contract (directly, or through another function's contract) is not instantiated again.
  isActive(key: string): bool {
    return this.active.includes(key);
  }

  enter(key: string): void {
    this.active.push(key);
  }

  leave(key: string): void {
    if (this.active.length > 0) {
      this.active.pop();
    }
  }

  hasFun(name: string): bool {
    return this.funNames.includes(name);
  }

  @Ensures(this.hasFun(name))
  registerFun(name: string): void {
    if (!this.funNames.includes(name)) {
      this.funNames.push(name);
      // The result of a pure function is known only through its contract.
      if (name.startsWith("uf_") || name.startsWith("um_")) {
        this.taints.push(name);
      }
    }
  }

  // A symbol whose value is only constrained by the contract of a callee (the result of a call, the receiver after a
  // mutating call, a function the solver may interpret freely). A counterexample that depends on it is not trusted:
  // the real function computes one definite value, the model may pick another that the contract also allows.
  @Ensures(this.taints.includes(sym))
  @Ensures(this.taints.length <= old(this.taints.length) + 1)
  taint(sym: string): void {
    if (!this.taints.includes(sym)) {
      this.taints.push(sym);
    }
  }

  // Does the SMT text mention a tainted symbol (as a whole token)?
  mentionsTaint(text: string): bool {
    for (const t of this.taints) {
      if (hasToken(text, t)) {
        return true;
      }
    }
    return false;
  }

  // The SMT constant of a string literal (a fresh one for a new text).
  litFor(text: string): Option<string> {
    let i: usize = 0;
    while (i < this.litTexts.length) {
      if (this.litTexts[i] == text) {
        return Some(this.litNames[i]);
      }
      i += 1;
    }
    return None;
  }

  @Requires(this.litFor(text).isNone())
  @Ensures(this.litFor(text).isSome())
  registerLit(text: string, name: string): void {
    this.litTexts.push(text);
    this.litNames.push(name);
  }

  litConsts(): string[] {
    return this.litNames;
  }

  // The texts of the literals, in the order of `litConsts`.
  @Ensures(result.length == this.litNames.length)
  litTextList(): string[] {
    return this.litTexts;
  }

  // The encoding of something in this function is an over-approximation (a model of the solver may not be a real
  // execution): a counterexample is then not trusted. The first reason is kept.
  @Ensures(old(this.approxWhy) != "" ==> this.approxWhy == old(this.approxWhy))
  @Ensures(old(this.approxWhy) == "" ==> this.approxWhy == why)
  noteApprox(why: string): void {
    if (this.approxWhy == "") {
      this.approxWhy = why;
    }
  }

  // The proof reads string contents through an operation: "chr" (`charCodeAt`), "concat" (`+`) or "derive" (anything
  // that builds a string whose contents matter: `substring`, `charAt`, `toString`, `trim`, a template literal, an
  // equality with a computed string).
  @Ensures(this.strKinds.includes(kind))
  @Ensures(this.strKinds.length <= old(this.strKinds.length) + 1)
  noteStr(kind: string): void {
    if (!this.strKinds.includes(kind)) {
      this.strKinds.push(kind);
    }
  }

  // Why a counterexample of this function is not trusted ("" when it is). Strings: a model is realisable by real
  // strings as long as the claim uses lengths, `charCodeAt` alone, or `+` alone; once contents are derived (or `+`
  // meets `charCodeAt`, whose relation the model does not know) a model may be spurious.
  approxReason(): string {
    if (this.approxWhy != "") {
      return this.approxWhy;
    }
    if (this.strKinds.includes("derive") || (this.strKinds.includes("chr") && this.strKinds.includes("concat"))) {
      return "string contents are only modelled by length (the operations on contents are uninterpreted)";
    }
    return "";
  }

  // The proof uses an assumption (an id of report.or): it is listed on the results of the function.
  @Ensures(this.usedIds.includes(id))
  @Ensures(this.usedIds.length <= old(this.usedIds.length) + 1)
  useAssumption(id: string): void {
    if (!this.usedIds.includes(id)) {
      this.usedIds.push(id);
    }
  }

  usedList(): string[] {
    return this.usedIds;
  }

  // Loops: the obligations of a loop's invariants (entry and preservation). A path that assumes the invariants
  // depends on the loop (its id), and is only as good as all of these.
  @Ensures(result == old(this.loopObls.length) && this.loopObls.length == result + 1)
  @Ensures(this.loopObls[result].length == 0)
  newLoop(): usize {
    const none: usize[] = [];
    this.loopObls.push(none);
    return this.loopObls.length - 1;
  }

  @Requires(loop < this.loopObls.length)
  @Ensures(this.loopObls.length == old(this.loopObls.length))
  @Ensures(this.loopObls[loop].length == old(this.loopObls[loop].length) + 1)
  loopAdd(loop: usize, obl: usize): void {
    this.loopObls[loop].push(obl);
  }

  loopMembers(loop: usize): usize[] {
    return this.loopObls[loop];
  }

  @Ensures(result == old(this.obls.length) && this.obls.length == result + 1)
  addObl(o: Obl): usize {
    this.obls.push(o);
    return this.obls.length - 1;
  }

  oblList(): Obl[] {
    return this.obls;
  }
}

function isSymChar(c: usize): bool {
  return (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 || c == 46;
}

// Does `text` contain `tok` as a whole SMT symbol (not as part of a longer one)?
export function hasToken(text: string, tok: string): bool {
  let pos: usize = 0;
  while (pos < text.length) {
    const rest = text.substring(pos, text.length);
    const at = rest.indexOf(tok);
    if (at.isNone()) {
      return false;
    }
    const start = pos + at.unwrap();
    const end = start + tok.length;
    const before = start == 0 || !isSymChar(text.charCodeAt(start - 1).toUsize());
    const after = end >= text.length || !isSymChar(text.charCodeAt(end).toUsize());
    if (before && after) {
      return true;
    }
    pos = start + 1;
  }
  return false;
}

export type SortR = { g: Gen; s: string; };

// ---------------------------------------------------------------------------------------------- sorts

// A sort for values the verifier does not model (an unsupported field type): any value of it is arbitrary
// and it is never compared or read.
export function opaqueSort(g0: Gen): SortR {
  let g = g0;
  if (g.sortFor("opaque").isNone()) {
    g.registerSort("opaque", "Opq");
    g.declare("(declare-sort Opq 0)");
  }
  return SortR { g: g, s: "Opq" };
}

// A string is a pair (length, id): the id stands for the contents. Two strings with the same length and id are
// equal. The datatype is free, so well-formedness (`wfOf`) says what every real string satisfies: the length is not
// negative and the only empty string has id 0. Operations on contents (`charCodeAt`, `substring`, `+` ...) are
// uninterpreted functions of the ids: their results are determined by the arguments but otherwise arbitrary,
// which over-approximates the real behaviours (see `strApprox`).
function strSort(g0: Gen): SortR {
  let g = g0;
  if (g.sortFor("string").isNone()) {
    g.registerSort("string", "Str");
    g.declare("(declare-datatypes ((Str 0)) (((mkStr (slen Int) (sid Int)))))");
  }
  return SortR { g: g, s: "Str" };
}

// The SMT sort of a type. A type outside the fragment is an error with its reason.
export function sortOf(g0: Gen, tab: Tab, t: VT): Result<SortR, string> {
  let g = g0;
  return match (t) {
    VInt(_) => Ok(SortR { g: g, s: "Int" }),
    VBool => Ok(SortR { g: g, s: "Bool" }),
    VUnit => Ok(SortR { g: g, s: "Int" }),
    VStr => Ok(strSort(g)),
    VOpq(n) => {
      const key = "opq:" + n;
      const known = g.sortFor(key);
      if (known.isSome()) {
        return Ok(SortR { g: g, s: known.unwrap() });
      }
      g.registerSort(key, "Opq_" + n);
      g.declare("(declare-sort Opq_" + n + " 0)");
      return Ok(SortR { g: g, s: "Opq_" + n });
    },
    VBad(why) => Err(why),
    _ => sortOfData(g, tab, t)
  };
}

// The sort for a position inside a datatype: unsupported types become the opaque sort.
function sortOfPart(g: Gen, tab: Tab, t: VT): SortR {
  const r = sortOf(g, tab, t);
  return match (r) {
    Ok(x) => x,
    Err(_) => opaqueSort(g)
  };
}

function sortOfData(g0: Gen, tab: Tab, t: VT): Result<SortR, string> {
  let g = g0;
  const key = vtKey(t);
  const known = g.sortFor(key);
  if (known.isSome()) {
    return Ok(SortR { g: g, s: known.unwrap() });
  }
  return match (t) {
    VArr(e) => {
      const es = sortOf(g, tab, e)?;
      g = es.g;
      const again = g.sortFor(key);
      if (again.isSome()) {
        // Making the part sorts of a recursive type can make this very sort already (re-entrancy).
        return Ok(SortR { g: g, s: again.unwrap() });
      }
      const n = g.next("A");
      g.registerSort(key, n);
      g.declare("(declare-datatypes ((" + n + " 0)) (((mk" + n + " (" + n + "d (Array Int " + es.s + ")) (" + n + "n Int)))))");
      return Ok(SortR { g: g, s: n });
    },
    VOpt(e) => {
      const es = sortOf(g, tab, e)?;
      g = es.g;
      const again = g.sortFor(key);
      if (again.isSome()) {
        // Making the part sorts of a recursive type can make this very sort already (re-entrancy).
        return Ok(SortR { g: g, s: again.unwrap() });
      }
      const n = g.next("O");
      g.registerSort(key, n);
      g.declare("(declare-datatypes ((" + n + " 0)) (((none" + n + ") (some" + n + " (val" + n + " " + es.s + ")))))");
      return Ok(SortR { g: g, s: n });
    },
    VRes(a, b) => {
      const as = sortOf(g, tab, a)?;
      g = as.g;
      const bs = sortOf(g, tab, b)?;
      g = bs.g;
      const again = g.sortFor(key);
      if (again.isSome()) {
        // Making the part sorts of a recursive type can make this very sort already (re-entrancy).
        return Ok(SortR { g: g, s: again.unwrap() });
      }
      const n = g.next("E");
      g.registerSort(key, n);
      g.declare("(declare-datatypes ((" + n + " 0)) (((ok" + n + " (okv" + n + " " + as.s + ")) (err" + n + " (errv" + n + " " + bs.s + ")))))");
      return Ok(SortR { g: g, s: n });
    },
    VMap(k, v) => {
      const ks = sortOf(g, tab, k)?;
      g = ks.g;
      const vs = sortOf(g, tab, v)?;
      g = vs.g;
      const again = g.sortFor(key);
      if (again.isSome()) {
        // Making the part sorts of a recursive type can make this very sort already (re-entrancy).
        return Ok(SortR { g: g, s: again.unwrap() });
      }
      const n = g.next("M");
      g.registerSort(key, n);
      g.declare("(declare-datatypes ((" + n + " 0)) (((mk" + n + " (" + n + "h (Array " + ks.s + " Bool)) (" + n + "v (Array " + ks.s + " " + vs.s + ")) (" + n + "s Int)))))");
      return Ok(SortR { g: g, s: n });
    },
    VRec(name) => sortOfRec(g, tab, name, key),
    VUni(name) => sortOfUni(g, tab, name, key),
    _ => Err("no sort for this type")
  };
}

function sortOfRec(g0: Gen, tab: Tab, name: string, key: string): Result<SortR, string> {
  let g = g0;
  const r = tab.findRec(name);
  if (r.isNone()) {
    return Err("unknown record or class `" + bareOf(name) + "`");
  }
  const sn = "Rec_" + tab.symOf(name);
  const d = r.unwrap();
  if (tab.isCyclic("r:" + name)) {
    return Ok(sortOfCyclicRec(g, tab, d, sn, key));
  }
  let fields: string[] = [];
  let i: usize = 0;
  while (i < d.fields.length) {
    const fs = sortOfPart(g, tab, fieldTyOf(tab, d, i));
    g = fs.g;
    fields.push("(" + sn + "." + d.fields[i] + " " + fs.s + ")");
    i += 1;
  }
  g.registerSort(key, sn);
  g.declare("(declare-datatypes ((" + sn + " 0)) (((mk" + sn + " " + fields.join(" ") + "))))");
  return Ok(SortR { g: g, s: sn });
}

// A recursive record or class (it reaches itself through its fields) has no finite SMT datatype. Its sort is
// uninterpreted and it gets one accessor function `Rec_X.f` per field. There is no constructor function and no axiom:
// a value built in the code (a literal, a field write, the receiver after a loop or in a constructor) is a fresh
// constant whose accessors are stated as facts (`cyclicMk`, ctx.or), so the queries stay free of quantifiers. That is
// what a datatype would say about the values that arise, minus well-foundedness and extensionality, which a proof never
// needs: every real value is a model, so a proof is sound; a model of the solver need not be a real value (it may be
// cyclic), so no counterexample about such a function is trusted (`noteApprox`). Equality of the values themselves is
// not translated (expr.or). The sort is registered before the field sorts are made (a field may mention the type
// again, directly or through another recursive type).
function sortOfCyclicRec(g0: Gen, tab: Tab, d: RecDef, sn: string, key: string): SortR {
  let g = g0;
  g.registerSort(key, sn);
  g.declare("(declare-sort " + sn + " 0)");
  g.noteApprox("the fields of the recursive type `" + bareOf(d.name) + "` are modelled by uninterpreted accessors (a model need not be a finite value)");
  let i: usize = 0;
  while (i < d.fields.length) {
    const fs = sortOfPart(g, tab, fieldTyOf(tab, d, i));
    g = fs.g;
    g.declare("(declare-fun " + sn + "." + d.fields[i] + " (" + sn + ") " + fs.s + ")");
    i += 1;
  }
  return SortR { g: g, s: sn };
}

// A recursive union: an uninterpreted sort, a tag function `Uni_X.tag` (the index of the variant, so a value is of
// exactly one variant: the test for variant k is `tag = k`) and payload accessors `Uni_X.V.i` (the names of the
// datatype of a non-recursive union). A nullary variant is a constant with its tag; a variant built with a payload is
// a fresh constant with its tag and accessors as facts (`cyclicVariant`, ctx.or). No quantifier.
function sortOfCyclicUni(g0: Gen, tab: Tab, u: UniDef, sn: string, key: string): SortR {
  let g = g0;
  g.registerSort(key, sn);
  g.declare("(declare-sort " + sn + " 0)");
  g.noteApprox("the variants of the recursive union `" + bareOf(u.name) + "` are modelled by uninterpreted accessors (a model need not be a finite value)");
  g.declare("(declare-fun " + sn + ".tag (" + sn + ") Int)");
  let k: usize = 0;
  while (k < u.variants.length) {
    const v = u.variants[k];
    const ctor = sn + "." + v.name;
    let i: usize = 0;
    while (i < v.payload.length) {
      const fs = sortOfPart(g, tab, payloadTy(tab, u, v.payload[i]));
      g = fs.g;
      g.declare("(declare-fun " + ctor + "." + i.toString() + " (" + sn + ") " + fs.s + ")");
      i += 1;
    }
    if (v.payload.length == 0) {
      g.declare("(declare-const " + ctor + " " + sn + ")");
      g.declare("(assert (= (" + sn + ".tag " + ctor + ") " + k.toString() + "))");
    }
    k += 1;
  }
  return SortR { g: g, s: sn };
}

// The index of variant `name` in the union `u`.
export function variantIndex(u: UniDef, name: string): Option<usize> {
  let k: usize = 0;
  while (k < u.variants.length) {
    if (u.variants[k].name == name) {
      return Some(k);
    }
    k += 1;
  }
  return None;
}

function sortOfUni(g0: Gen, tab: Tab, name: string, key: string): Result<SortR, string> {
  let g = g0;
  const u = tab.findUni(name);
  if (u.isNone()) {
    return Err("unknown union `" + bareOf(name) + "`");
  }
  const sn = "Uni_" + tab.symOf(name);
  if (tab.isCyclic("u:" + name)) {
    return Ok(sortOfCyclicUni(g, tab, u.unwrap(), sn, key));
  }
  let ctors: string[] = [];
  for (const v of u.unwrap().variants) {
    let fields: string[] = [];
    let i: usize = 0;
    while (i < v.payload.length) {
      const fs = sortOfPart(g, tab, payloadTy(tab, u.unwrap(), v.payload[i]));
      g = fs.g;
      fields.push("(" + sn + "." + v.name + "." + i.toString() + " " + fs.s + ")");
      i += 1;
    }
    ctors.push("(" + sn + "." + v.name + (fields.length > 0 ? " " + fields.join(" ") : "") + ")");
  }
  g.registerSort(key, sn);
  g.declare("(declare-datatypes ((" + sn + " 0)) ((" + ctors.join(" ") + ")))");
  return Ok(SortR { g: g, s: sn });
}

// The reason a type cannot be used, for messages (empty when it can).
export function whyBad(t: VT): string {
  return isBad(t) ? badReason(t) : "";
}

export function describe(t: VT): string {
  return vtName(t);
}
