// Symbolic execution of statements for the contract verifier (ADR-0031 B6-B9, loops): assignments to locals,
// fields and elements, mutating calls (`push`, `pop`, `set`, `delete`, mutating methods with their frames),
// branches, `match`, and loops (user `@Invariant`, inferred counter bounds, or havoc).

import { Span } from "../diag";
import {
  TypeExpr, Block, Stmt, Expr, ContractClause, MatchArm, ArmBody, Ident,
  SLet, SAssign, SExpr, SReturn, SIf, SBlock, SContract, SWhile, SForOf, SBreak, SContinue,
  EInt, EBigInt, EStr, EBool, EIdent, EThis, ETry, FieldInit, EBinary, ECall, EMember, EIndex, EMatch, EUnary, ECond, EArrow, EArray, ERecord, ENew, ETemplate,
  BAdd, BLt, BLe, BGt, BGe, BAnd, BOr, BImplies, BSub, BMul, BDiv, BRem, BEq, BNe,
  OpAssign, OpAddAssign, OpSubAssign, OpMulAssign, OpDivAssign, OpRemAssign, AssignOp, BinaryOp,
  BExpr, BBlock, CInvariant, CDecreases, CRequires, CEnsures
} from "../syntax";
import {
  VT, VInt, VBool, VStr, VUnit, VArr, VOpt, VRes, VMap, VRec, VUni, VBad,
  vtName, isBad, badReason, vtEq, isIntTy, intKindOf, concrete, joinKinds, fieldIndex, resolveTy, fieldTyOf
} from "./vt";
import { Gen, Obl, SortR, sortOf, opaqueSort } from "./gen";
import { bareOf } from "./scope";
import {
  cyclicMk, Var, Chk, TR, St, Ret, Ex, Fn, Cls, Prog, Cx, lineOf, clauseText, srcText, lit, inKind, guarded, concat, concatChk, unionUsize, andAll,
  noChks, noExp, lookupVar, prefix, tailFrom, mk, sortS, tyOf, fresh, freshFree, typeFact, arrLen, arrData, arrMk, arrSel, inBounds, isSomeT, isOkT,
  recField, mapHas, mapSize, mapFact, tfOf, assignedIn, hasJump, rootOf, isThisExpr, clausesOfList, exprOf, hasClauses, valKey
} from "./ctx";
import { tr, trClause, wdOf, callFnX, isUnit, sigOf, Cl, clHyp, clGoal, matchPattern } from "./expr";

// ------------------------------------------------------------------------------------------ emitting

export type Emitted = { g: Gen; st: St; };

// Turn the checks of an expression into obligations (reported) and assumptions (the path continues only when
// they hold: a failed check traps, so it never returns). Each is assumed after the point where it occurs.
@Ensures(result.st.pc.length == st0.pc.length + chks.length)
export function emit(g0: Gen, st0: St, cx: Cx, chks: Chk[]): Emitted {
  let g = g0;
  let st = st0;
  for (const c of chks) {
    if (c.oblig) {
      const site = c.kind == "invariant-site";
      const o = Obl {
        kind: c.kind, what: c.what, line: c.line, clause: c.clause, goal: c.goal, pc: st.pc, deps: st.deps, approx: st.approx,
        file: cx.f.file, fn: cx.f.disp, text: cx.f.text, hidden: site, exact: g.isExact()
      };
      // An obligation that repeats an earlier one on the same path (same place, same goal, and the earlier goal
      // is already assumed here) is redundant: the earlier one is reported.
      let dup = false;
      const existing = g.oblList();
      let k = existing.length;
      let looked: usize = 0;
      while (k > 0 && looked < 6) {
        k -= 1;
        looked += 1;
        const x = existing[k];
        if (x.kind == o.kind && x.line == o.line && x.clause == o.clause && x.goal == o.goal && x.pc.length < o.pc.length && isPrefix(x.pc, o.pc)) {
          dup = true;
        }
      }
      if (!dup) {
        g.addObl(o);
      }
    }
    // An `invariant-site` obligation is proved for the callee's sake only: the path goes on whether or not it holds.
    st.pc.push(c.kind == "invariant-site" ? "true" : c.goal);
  }
  return Emitted { g: g, st: st };
}

function isPrefix(a: string[], b: string[]): bool {
  let i: usize = 0;
  while (i < a.length) {
    if (a[i] != b[i]) {
      return false;
    }
    i += 1;
  }
  return true;
}

export type TS = { g: Gen; st: St; t: string; vt: VT; };

// Translate an expression in a state and emit its checks.
export function trEmit(g: Gen, st: St, cx: Cx, e: Expr, exp: VT): Result<TS, string> {
  const r = tr(g, st.vars, cx, e, exp)?;
  const em = emit(r.g, st, cx, r.chks);
  return Ok(TS { g: em.g, st: em.st, t: r.t, vt: r.vt });
}

function assignIndex(vars: Var[], name: string): Option<usize> {
  let i = vars.length;
  while (i > 0) {
    i -= 1;
    if (vars[i].name == name) {
      return Some(i);
    }
  }
  return None;
}

function cxPlain(cx: Cx): Cx {
  return Cx { p: cx.p, unit: cx.unit, f: cx.f, res: None, ens: false, body: false, olds: [], ret: cx.ret, inQ: false, text: cx.text };
}

// ----------------------------------------------------------------------------------------- places

// Write `val` (of type `vt`) to the place `place`: a local, a field `a.f`, an element `a[i]`, nested to any
// depth. The enclosing values are rebuilt (value semantics: no aliasing).
export function setPlace(g0: Gen, st0: St, cx: Cx, place: Expr, val: string, vt: VT): Result<Emitted, string> {
  let g = g0;
  let st = st0;
  return match (place.kind) {
    EIdent(id) => {
      const idx = assignIndex(st.vars, id.name);
      if (idx.isNone()) {
        return Err("assignment to the unknown variable `" + id.name + "`");
      }
      const old = st.vars[idx.unwrap()];
      if (!vtEq(old.vt, vt)) {
        return Err("assignment changes the type of `" + id.name + "` (" + vtName(old.vt) + " to " + vtName(vt) + ")");
      }
      const f = fresh(g, cx, old.vt, val)?;
      g = f.g;
      st.vars[idx.unwrap()] = Var { name: id.name, term: f.name, vt: old.vt };
      return Ok(Emitted { g: g, st: st });
    },
    EThis => {
      const idx = assignIndex(st.vars, "this");
      if (idx.isNone()) {
        return Err("`this` outside a method");
      }
      const old = st.vars[idx.unwrap()];
      if (!vtEq(old.vt, vt)) {
        return Err("assignment changes the type of `this`");
      }
      const f = fresh(g, cx, old.vt, val)?;
      g = f.g;
      st.vars[idx.unwrap()] = Var { name: "this", term: f.name, vt: old.vt };
      return Ok(Emitted { g: g, st: st });
    },
    EMember(b, fld) => {
      const bt = trEmit(g, st, cx, b, noExp())?;
      g = bt.g;
      st = bt.st;
      return match (bt.vt) {
        VRec(rn) => {
          const rd = cx.p.tab.findRec(rn);
          if (rd.isNone()) {
            return Err("unknown record `" + bareOf(rn) + "`");
          }
          const d = rd.unwrap();
          const fi = fieldIndex(d, fld.name);
          if (fi.isNone()) {
            return Err("no field `" + fld.name + "` on `" + bareOf(rn) + "`");
          }
          const ft = fieldTyOf(cx.p.tab, d, fi.unwrap());
          if (isBad(ft)) {
            return Err("field `" + bareOf(rn) + "." + fld.name + "` has an unsupported type (" + badReason(ft) + ")");
          }
          if (!vtEq(ft, vt)) {
            return Err("field `" + bareOf(rn) + "." + fld.name + "` has type `" + vtName(ft) + "`, assigned `" + vtName(vt) + "`");
          }
          const so = sortS(g, cx, bt.vt)?;
          g = so.g;
          let args: string[] = [];
          let i: usize = 0;
          while (i < d.fields.length) {
            args.push(i == fi.unwrap() ? val : recField(so.s, d.fields[i], bt.t));
            i += 1;
          }
          if (cx.p.tab.isCyclic("r:" + rn)) {
            const cm = cyclicMk(g, cx, bt.vt, so.s, d.fields, args)?;
            return setPlace(cm.g, st, cx, b, cm.name, bt.vt);
          }
          const nv = "(mk" + so.s + " " + args.join(" ") + ")";
          return setPlace(g, st, cx, b, nv, bt.vt);
        },
        _ => Err("field assignment on a value of type `" + vtName(bt.vt) + "`")
      };
    },
    EIndex(b, ie) => {
      const bt = trEmit(g, st, cx, b, noExp())?;
      g = bt.g;
      st = bt.st;
      const it = tr(g, st.vars, cx, ie, VInt("usize"))?;
      return match (bt.vt) {
        VArr(el) => {
          if (!vtEq(el, vt)) {
            return Err("element assignment of type `" + vtName(vt) + "` to an array of `" + vtName(el) + "`");
          }
          const so = sortS(it.g, cx, bt.vt)?;
          const goal = inBounds(so.s, bt.t, it.t);
          const clause = "index in bounds: `" + srcText(cx.text, place) + "`";
          const em = emit(so.g, st, cx, concatChk(it.chks, [Chk { oblig: true, kind: "bounds", what: "index", line: lineOf(cx.text, place.span.start), clause: clause, goal: goal }]));
          g = em.g;
          st = em.st;
          const nv = arrMk(so.s, "(store " + arrData(so.s, bt.t) + " " + it.t + " " + val + ")", arrLen(so.s, bt.t));
          return setPlace(g, st, cx, b, nv, bt.vt);
        },
        _ => Err("element assignment on a value of type `" + vtName(bt.vt) + "`")
      };
    },
    _ => Err("unsupported assignment target")
  };
}

// ------------------------------------------------------------------------------------ mutating calls

export type MutR = { g: Gen; st: St; t: string; vt: VT; };

// A statement-level call that changes its receiver: `xs.push(e)`, `xs.pop()`, `m.set(k, v)`, `m.delete(k)` and a
// mutating method of a class. None when the call is not of that kind (it is then an ordinary expression).
function execCallStmt(g0: Gen, st0: St, cx: Cx, e: Expr): Result<Option<MutR>, string> {
  let g = g0;
  let st = st0;
  const none: Option<MutR> = None;
  return match (e.kind) {
    ECall(callee, args) => match (callee.kind) {
      EMember(base, m) => {
        // Not a value: a class name (static call), `console`.
        match (base.kind) {
          EIdent(id) => {
            if (lookupVar(st.vars, id.name).isNone()) {
              return Ok(none);
            }
          },
          _ => {}
        }
        const r = tr(g, st.vars, cx, base, noExp())?;
        const name = m.name;
        return match (r.vt) {
          VArr(el) => {
            if (name != "push" && name != "pop") {
              return Ok(none);
            }
            const em = emit(r.g, st, cx, r.chks);
            g = em.g;
            st = em.st;
            const so = sortS(g, cx, r.vt)?;
            g = so.g;
            const len = arrLen(so.s, r.t);
            if (name == "push" && args.length == 1) {
              const x = trEmit(g, st, cx, args[0], el)?;
              g = x.g;
              st = x.st;
              if (!vtEq(x.vt, el)) {
                return Err("`push` of `" + vtName(x.vt) + "` to an array of `" + vtName(el) + "`");
              }
              const nv = arrMk(so.s, "(store " + arrData(so.s, r.t) + " " + len + " " + x.t + ")", "(+ " + len + " 1)");
              const sp = setPlace(g, st, cx, base, nv, r.vt)?;
              return Ok(Some(MutR { g: sp.g, st: sp.st, t: "0", vt: VUnit }));
            }
            if (name == "pop" && args.length == 0) {
              const os = sortS(g, cx, VOpt(el))?;
              g = os.g;
              const res = "(ite (> " + len + " 0) (some" + os.s + " " + arrSel(so.s, r.t, "(- " + len + " 1)") + ") none" + os.s + ")";
              const nv = arrMk(so.s, arrData(so.s, r.t), "(ite (> " + len + " 0) (- " + len + " 1) 0)");
              const fr = fresh(g, cx, VOpt(el), res)?;
              g = fr.g;
              const sp = setPlace(g, st, cx, base, nv, r.vt)?;
              return Ok(Some(MutR { g: sp.g, st: sp.st, t: fr.name, vt: VOpt(el) }));
            }
            return Err("array method `" + name + "` with this many arguments");
          },
          VMap(k, v) => {
            if (name != "set" && name != "delete") {
              return Ok(none);
            }
            const em = emit(r.g, st, cx, r.chks);
            g = em.g;
            st = em.st;
            const so = sortS(g, cx, r.vt)?;
            g = so.g;
            const kt = trEmit(g, st, cx, args[0], k)?;
            g = kt.g;
            st = kt.st;
            const has = mapHas(so.s, r.t, kt.t);
            const sz = mapSize(so.s, r.t);
            g.assert(mapFact(so.s, r.t, kt.t));
            if (name == "set" && args.length == 2) {
              const vt2 = trEmit(g, st, cx, args[1], v)?;
              g = vt2.g;
              st = vt2.st;
              const nv = "(mk" + so.s + " (store (" + so.s + "h " + r.t + ") " + kt.t + " true) (store (" + so.s + "v " + r.t + ") " + kt.t + " " + vt2.t + ") (ite " + has + " " + sz + " (+ " + sz + " 1)))";
              const sp = setPlace(g, st, cx, base, nv, r.vt)?;
              return Ok(Some(MutR { g: sp.g, st: sp.st, t: "0", vt: VUnit }));
            }
            if (name == "delete" && args.length == 1) {
              const nv = "(mk" + so.s + " (store (" + so.s + "h " + r.t + ") " + kt.t + " false) (" + so.s + "v " + r.t + ") (ite " + has + " (- " + sz + " 1) " + sz + "))";
              const sp = setPlace(g, st, cx, base, nv, r.vt)?;
              return Ok(Some(MutR { g: sp.g, st: sp.st, t: has, vt: VBool }));
            }
            return Err("Map method `" + name + "` with this many arguments");
          },
          VRec(cn) => {
            const mi = cx.p.fnIx.get(cn + "." + name);
            if (mi.isNone() || !cx.p.fns[mi.unwrap()].mutating || cx.p.fns[mi.unwrap()].kind != 1) {
              return Ok(none);
            }
            const f = cx.p.fns[mi.unwrap()];
            const c = callFnX(r.g, st.vars, cx, f, Some(r), args, e, noExp())?;
            const em = emit(c.g, st, cx, c.chks);
            g = em.g;
            st = em.st;
            if (c.newThis == "") {
              return Err("internal: a mutating call without a new receiver");
            }
            const sp = setPlace(g, st, cx, base, c.newThis, r.vt)?;
            return Ok(Some(MutR { g: sp.g, st: sp.st, t: c.t, vt: c.vt }));
          },
          _ => Ok(none)
        };
      },
      _ => Ok(none)
    },
    _ => Ok(none)
  };
}

// ------------------------------------------------------------------------------------ hoisting effects

// Effects inside an expression: a call of a mutating method (`this.next()`, `xs.pop()`) and `e?` (an early return on
// Err / None). The expression translation is pure, so these are executed as statements before the expression, in the
// order the expression evaluates them (left to right), and replaced by a temporary holding the value. Everything
// that the expression evaluates before an effect is bound to a temporary first, so an effect never changes what an
// earlier operand reads and a trap of an earlier operand still comes first. Only operands that are always evaluated
// are hoisted from: the right operand of `&&` / `||` / `==>`, the branches of `?:` and the arms of a `match` stay as
// they are (the expression is then not supported, as before).

export type HX = { g: Gen; st: St; e: Expr; rets: Ret[]; };
type Kids = { g: Gen; ops: Expr[]; mut: bool; baseIn: bool; };
type HO = { g: Gen; st: St; ops: Expr[]; rets: Ret[]; };
type MC = { g: Gen; mut: bool; };

function isBuiltinMut(n: string): bool {
  return n == "push" || n == "pop" || n == "set" || n == "delete";
}

function one(x: Expr): Expr[] {
  let out: Expr[] = [];
  out.push(x);
  return out;
}

function isAtom(e: Expr): bool {
  return match (e.kind) {
    EInt(_) => true,
    EBigInt(_) => true,
    EBool(_) => true,
    EStr(_) => true,
    EIdent(id) => id.name.startsWith("$h") || id.name == "$unit",
    _ => false
  };
}

function isSimplePlace(e: Expr): bool {
  return match (e.kind) {
    EIdent(_) => true,
    EThis => true,
    EMember(b, _) => isSimplePlace(b),
    _ => false
  };
}

// A syntactic over-approximation of "contains an effect": the exact test (with types) is `effNode`.
export function mayEffect(cx: Cx, e: Expr): bool {
  return match (e.kind) {
    ETry(_) => true,
    EUnary(_, x) => mayEffect(cx, x),
    EBinary(_, l, r) => mayEffect(cx, l) || mayEffect(cx, r),
    ECond(c, a, b) => mayEffect(cx, c) || mayEffect(cx, a) || mayEffect(cx, b),
    EMember(b, _) => mayEffect(cx, b),
    EIndex(b, i) => mayEffect(cx, b) || mayEffect(cx, i),
    EMatch(sc, _) => mayEffect(cx, sc),
    EArray(xs) => anyEffect(cx, xs),
    ENew(_, _, args) => anyEffect(cx, args),
    ETemplate(_, xs) => anyEffect(cx, xs),
    ERecord(_, sp, inits) => {
      if (sp.isSome() && mayEffect(cx, sp.unwrap())) {
        return true;
      }
      for (const i of inits) {
        if (mayEffect(cx, i.value)) {
          return true;
        }
      }
      return false;
    },
    ECall(c, args) => {
      match (c.kind) {
        EMember(b, m) => {
          if (isBuiltinMut(m.name) || cx.p.mutNames.has(m.name) || mayEffect(cx, b)) {
            return true;
          }
        },
        EIdent(_) => {},
        _ => {
          if (mayEffect(cx, c)) {
            return true;
          }
        }
      }
      return anyEffect(cx, args);
    },
    _ => false
  };
}

function anyEffect(cx: Cx, xs: Expr[]): bool {
  for (const x of xs) {
    if (mayEffect(cx, x)) {
      return true;
    }
  }
  return false;
}

// Is `b.name(..)` a call of a method that changes `b` (as `execCallStmt` executes it)?
function isMutCall(g0: Gen, st: St, cx: Cx, b: Expr, name: string): Result<MC, string> {
  let g = g0;
  if (!isBuiltinMut(name) && !cx.p.mutNames.has(name)) {
    return Ok(MC { g: g, mut: false });
  }
  const r = tr(g, st.vars, cx, b, noExp());
  return match (r) {
    Err(_) => Ok(MC { g: g, mut: false }),
    Ok(x) => {
      g = x.g;
      return match (x.vt) {
        VArr(_) => Ok(MC { g: g, mut: name == "push" || name == "pop" }),
        VMap(_, _) => Ok(MC { g: g, mut: name == "set" || name == "delete" }),
        VRec(cn) => {
          const mi = cx.p.fnIx.get(cn + "." + name);
          if (mi.isNone()) {
            return Ok(MC { g: g, mut: false });
          }
          const f = cx.p.fns[mi.unwrap()];
          return Ok(MC { g: g, mut: f.mutating && f.kind == 1 });
        },
        _ => Ok(MC { g: g, mut: false })
      };
    }
  };
}

// The operands of `e` that are always evaluated, in evaluation order. `mut`: `e` is a call of a mutating method (its
// receiver is a place, not an operand); `baseIn`: the first operand is the receiver of a method call.
function kidsOf(g0: Gen, st: St, cx: Cx, e: Expr): Result<Kids, string> {
  let g = g0;
  return match (e.kind) {
    EUnary(_, x) => Ok(Kids { g: g, ops: one(x), mut: false, baseIn: false }),
    EBinary(op, l, r) => {
      const sc = match (op) {
        BAnd => true,
        BOr => true,
        BImplies => true,
        _ => false
      };
      let ops = one(l);
      if (!sc) {
        ops.push(r);
      }
      return Ok(Kids { g: g, ops: ops, mut: false, baseIn: false });
    },
    ECond(c, _, _) => Ok(Kids { g: g, ops: one(c), mut: false, baseIn: false }),
    EMember(b, _) => Ok(Kids { g: g, ops: one(b), mut: false, baseIn: false }),
    EIndex(b, i) => {
      let ops = one(b);
      ops.push(i);
      return Ok(Kids { g: g, ops: ops, mut: false, baseIn: false });
    },
    EMatch(sc, _) => Ok(Kids { g: g, ops: one(sc), mut: false, baseIn: false }),
    EArray(xs) => Ok(Kids { g: g, ops: xs, mut: false, baseIn: false }),
    ENew(_, _, args) => Ok(Kids { g: g, ops: args, mut: false, baseIn: false }),
    ETemplate(_, xs) => Ok(Kids { g: g, ops: xs, mut: false, baseIn: false }),
    ERecord(_, sp, inits) => {
      let ops: Expr[] = [];
      if (sp.isSome()) {
        ops.push(sp.unwrap());
      }
      for (const i of inits) {
        ops.push(i.value);
      }
      return Ok(Kids { g: g, ops: ops, mut: false, baseIn: false });
    },
    ECall(c, args) => match (c.kind) {
      EIdent(_) => Ok(Kids { g: g, ops: args, mut: false, baseIn: false }),
      EMember(b, m) => {
        let isVal = true;
        match (b.kind) {
          EIdent(id) => {
            if (lookupVar(st.vars, id.name).isNone()) {
              isVal = false;
            }
          },
          _ => {}
        }
        if (!isVal) {
          return Ok(Kids { g: g, ops: args, mut: false, baseIn: false });
        }
        const mc = isMutCall(g, st, cx, b, m.name)?;
        g = mc.g;
        if (!mc.mut) {
          let ops = one(b);
          for (const a of args) {
            ops.push(a);
          }
          return Ok(Kids { g: g, ops: ops, mut: false, baseIn: true });
        }
        if (mayEffect(cx, b)) {
          return Err("an effect inside the receiver of a mutating method call is not supported");
        }
        if (anyEffect(cx, args) && !isSimplePlace(b)) {
          return Err("an effect inside the arguments of a mutating method call on `" + srcText(cx.text, b) + "`: the order of evaluation is not preserved");
        }
        return Ok(Kids { g: g, ops: args, mut: true, baseIn: false });
      },
      _ => Ok(Kids { g: g, ops: [], mut: false, baseIn: false })
    },
    _ => Ok(Kids { g: g, ops: [], mut: false, baseIn: false })
  };
}

function one1(x: Stmt): Stmt[] {
  let out: Stmt[] = [];
  out.push(x);
  return out;
}

// A `match` whose arms are all expressions and one of them contains an effect.
function armsHaveEffect(cx: Cx, arms: MatchArm[]): bool {
  let eff = false;
  for (const a of arms) {
    match (a.body) {
      BExpr(x) => {
        if (mayEffect(cx, x)) {
          eff = true;
        }
      },
      BBlock(_) => { return false; }
    }
  }
  return eff;
}

function tailE(xs: Expr[], start: usize): Expr[] {
  let out: Expr[] = [];
  let i = start;
  while (i < xs.length) {
    out.push(xs[i]);
    i += 1;
  }
  return out;
}

// `e` with its operands (as `kidsOf` lists them) replaced.
function withOps(e: Expr, ops: Expr[], k: Kids): Expr {
  return match (e.kind) {
    EUnary(op, _) => Expr { kind: EUnary(op, ops[0]), span: e.span },
    EBinary(op, _, r) => Expr { kind: EBinary(op, ops[0], ops.length == 2 ? ops[1] : r), span: e.span },
    ECond(_, a, b) => Expr { kind: ECond(ops[0], a, b), span: e.span },
    EMember(_, f) => Expr { kind: EMember(ops[0], f), span: e.span },
    EIndex(_, _) => Expr { kind: EIndex(ops[0], ops[1]), span: e.span },
    EMatch(_, arms) => Expr { kind: EMatch(ops[0], arms), span: e.span },
    EArray(_) => Expr { kind: EArray(ops), span: e.span },
    ENew(n, t, _) => Expr { kind: ENew(n, t, ops), span: e.span },
    ETemplate(ps, _) => Expr { kind: ETemplate(ps, ops), span: e.span },
    ERecord(n, sp, inits) => {
      let off: usize = 0;
      let sp2 = sp;
      if (sp.isSome()) {
        sp2 = Some(ops[0]);
        off = 1;
      }
      let inits2: FieldInit[] = [];
      let i: usize = 0;
      while (i < inits.length) {
        inits2.push(FieldInit { name: inits[i].name, value: ops[off + i], span: inits[i].span });
        i += 1;
      }
      return Expr { kind: ERecord(n, sp2, inits2), span: e.span };
    },
    ECall(c, _) => match (c.kind) {
      EMember(_, m) => {
        if (k.baseIn) {
          return Expr { kind: ECall(Expr { kind: EMember(ops[0], m), span: c.span }, tailE(ops, 1)), span: e.span };
        }
        return Expr { kind: ECall(c, ops), span: e.span };
      },
      _ => Expr { kind: ECall(c, ops), span: e.span }
    },
    _ => e
  };
}

// Does `e` contain an effect (exactly: with the types of the receivers)?
function effNode(g0: Gen, st: St, cx: Cx, e: Expr): Result<bool, string> {
  let g = g0;
  if (!mayEffect(cx, e)) {
    return Ok(false);
  }
  match (e.kind) {
    ETry(_) => { return Ok(true); },
    _ => {}
  }
  const k = kidsOf(g, st, cx, e)?;
  if (k.mut) {
    return Ok(true);
  }
  for (const o of k.ops) {
    if (effNode(k.g, st, cx, o)?) {
      return Ok(true);
    }
  }
  return Ok(false);
}

function tmpName(st: St): string {
  return "$h" + st.vars.length.toString();
}

function mkId(name: string, at: Expr): Expr {
  return Expr { kind: EIdent(Ident { name: name, span: at.span }), span: at.span };
}

// Evaluate `e` now and keep its value in a temporary.
function bindTemp(g0: Gen, st0: St, cx: Cx, e: Expr): Result<HX, string> {
  let g = g0;
  let st = st0;
  match (e.kind) {
    EArrow(_, _, _) => { return Err("a function value before an effect: the order of evaluation is not preserved"); },
    _ => {}
  }
  const t = trEmit(g, st, cx, e, noExp())?;
  g = t.g;
  st = t.st;
  if (isUnit(t.vt)) {
    return Err("a void value before an effect");
  }
  const ty = concrete(t.vt);
  if (isBad(ty)) {
    return Err("a value of an unsupported type before an effect (" + badReason(ty) + ")");
  }
  const f = fresh(g, cx, ty, t.t)?;
  g = f.g;
  const nm = tmpName(st);
  st.vars.push(Var { name: nm, term: f.name, vt: ty });
  return Ok(HX { g: g, st: st, e: mkId(nm, e), rets: [] });
}

// Bind a value computed by an effect (`t` of type `vt`) to a temporary; a void value has none (`$unit`).
function bindValue(g0: Gen, st0: St, cx: Cx, at: Expr, t: string, vt: VT): Result<HX, string> {
  let g = g0;
  let st = st0;
  if (isUnit(vt)) {
    return Ok(HX { g: g, st: st, e: mkId("$unit", at), rets: [] });
  }
  const ty = concrete(vt);
  if (isBad(ty)) {
    return Err("a value of an unsupported type (" + badReason(ty) + ")");
  }
  const f = fresh(g, cx, ty, t)?;
  g = f.g;
  const nm = tmpName(st);
  st.vars.push(Var { name: nm, term: f.name, vt: ty });
  return Ok(HX { g: g, st: st, e: mkId(nm, at), rets: [] });
}

// Hoist the effects out of the operands `ops` (evaluated left to right).
function hoistOps(g0: Gen, st0: St, cx: Cx, ops: Expr[]): Result<HO, string> {
  let g = g0;
  let st = st0;
  let rets: Ret[] = [];
  let last: usize = 0;
  let found = false;
  let j: usize = 0;
  while (j < ops.length) {
    if (effNode(g, st, cx, ops[j])?) {
      last = j;
      found = true;
    }
    j += 1;
  }
  if (!found) {
    return Ok(HO { g: g, st: st, ops: ops, rets: rets });
  }
  let out: Expr[] = [];
  j = 0;
  while (j < ops.length) {
    if (j > last) {
      out.push(ops[j]);
    } else {
      const hx = hoistExec(g, st, cx, ops[j], true)?;
      g = hx.g;
      st = hx.st;
      for (const r of hx.rets) {
        rets.push(r);
      }
      let x = hx.e;
      if (j < last && !isAtom(x)) {
        const b = bindTemp(g, st, cx, x)?;
        g = b.g;
        st = b.st;
        x = b.e;
      }
      out.push(x);
    }
    j += 1;
  }
  return Ok(HO { g: g, st: st, ops: out, rets: rets });
}

// Execute the effects inside `e` (and, when `exec`, the effect that `e` itself is) in evaluation order. The result is
// `e` with each effect replaced by a temporary; `rets` are the early returns of `?` on the way.
export function hoistExec(g0: Gen, st0: St, cx: Cx, e: Expr, exec: bool): Result<HX, string> {
  let g = g0;
  let st = st0;
  if (!mayEffect(cx, e)) {
    return Ok(HX { g: g, st: st, e: e, rets: [] });
  }
  match (e.kind) {
    ETry(x) => {
      const hx = hoistExec(g, st, cx, x, true)?;
      g = hx.g;
      st = hx.st;
      let rets = hx.rets;
      const v = trEmit(g, st, cx, hx.e, noExp())?;
      g = v.g;
      st = v.st;
      const fv = fresh(g, cx, concrete(v.vt), v.t)?;
      g = fv.g;
      const tq = tryOn(g, st, cx, e, fv.name, v.vt)?;
      g = tq.g;
      st = tq.st;
      rets.push(tq.ret);
      const b = bindValue(g, st, cx, e, tq.val, tq.vt)?;
      return Ok(HX { g: b.g, st: b.st, e: b.e, rets: rets });
    },
    _ => {}
  }
  const k = kidsOf(g, st, cx, e)?;
  g = k.g;
  const ho = hoistOps(g, st, cx, k.ops)?;
  g = ho.g;
  st = ho.st;
  const e2 = withOps(e, ho.ops, k);
  if (k.mut && exec) {
    const mr = execCallStmt(g, st, cx, e2)?;
    if (mr.isNone()) {
      return Err("internal: a mutating call that is not executed as a statement");
    }
    const b = bindValue(mr.unwrap().g, mr.unwrap().st, cx, e, mr.unwrap().t, mr.unwrap().vt)?;
    return Ok(HX { g: b.g, st: b.st, e: b.e, rets: ho.rets });
  }
  return Ok(HX { g: g, st: st, e: e2, rets: ho.rets });
}

type TryR = { g: Gen; st: St; ret: Ret; val: string; vt: VT; };

// `v?` for the Result / Option value `v` (a variable): when it is Err / None the function returns at once (that return
// is `ret`, from the state where `v` is Err / None); the path continues where it is Ok / Some, with the payload `val`.
function tryOn(g0: Gen, st0: St, cx: Cx, e: Expr, v: string, vt: VT): Result<TryR, string> {
  let g = g0;
  let st = st0;
  const so = sortS(g, cx, vt)?;
  g = so.g;
  const rs = sortS(g, cx, cx.ret)?;
  g = rs.g;
  let good = "";
  let retVal = "";
  let pay = "";
  let pvt = VUnit;
  match (vt) {
    VRes(a, b) => {
      match (cx.ret) {
        VRes(_, b2) => {
          if (!vtEq(b, b2)) {
            return Err("`?` converts the error type `" + vtName(b) + "` to `" + vtName(b2) + "`");
          }
        },
        _ => { return Err("`?` on a Result in a function that returns `" + vtName(cx.ret) + "`"); }
      }
      good = isOkT(so.s, v);
      retVal = "(err" + rs.s + " (errv" + so.s + " " + v + "))";
      pay = "(okv" + so.s + " " + v + ")";
      pvt = a;
    },
    VOpt(t) => {
      match (cx.ret) {
        VOpt(_) => {},
        _ => { return Err("`?` on an Option in a function that returns `" + vtName(cx.ret) + "`"); }
      }
      good = isSomeT(so.s, v);
      retVal = "none" + rs.s;
      pay = "(val" + so.s + " " + v + ")";
      pvt = t;
    },
    _ => { return Err("`?` on a value of type `" + vtName(vt) + "`"); }
  }
  const stRet = St { vars: st.vars, pc: concat(st.pc, ["(not " + good + ")"]), deps: st.deps, approx: st.approx };
  const ret = Ret { st: stRet, val: retVal, vt: cx.ret, isVoid: false };
  st.pc.push(good);
  if (!isUnit(pvt)) {
    const tf = tfOf(g, cx, pvt, pay)?;
    const em = emit(tf.g, st, cx, tf.chks);
    g = em.g;
    st = em.st;
  }
  return Ok(TryR { g: g, st: st, ret: ret, val: pay, vt: pvt });
}

// ---------------------------------------------------------------------------------------- statements

function binOfAssign(op: AssignOp): Option<BinaryOp> {
  return match (op) {
    OpAssign => None,
    OpAddAssign => Some(BAdd),
    OpSubAssign => Some(BSub),
    OpMulAssign => Some(BMul),
    OpDivAssign => Some(BDiv),
    OpRemAssign => Some(BRem)
  };
}

function isCallNamed(e: Expr, name: string): bool {
  return match (e.kind) {
    ECall(c, _) => match (c.kind) {
      EIdent(id) => id.name == name,
      _ => false
    },
    _ => false
  };
}

function isConsoleCall(e: Expr): bool {
  return match (e.kind) {
    ECall(c, _) => match (c.kind) {
      EMember(b, _) => match (b.kind) {
        EIdent(id) => id.name == "console",
        _ => false
      },
      _ => false
    },
    _ => false
  };
}

export function execStmts(g0: Gen, st0: St, cx: Cx, stmts: Stmt[], top: bool): Result<Ex, string> {
  let g = g0;
  let st = st0;
  let rets: Ret[] = [];
  let pending: ContractClause[] = [];
  let k: usize = 0;
  while (k < stmts.length) {
    const s = stmts[k];
    k += 1;
    let keepPending = false;
    match (s.kind) {
      SContract(c) => {
        pending.push(c);
        keepPending = true;
      },
      SLet(_, name, ann, init) => {
        let exp = noExp();
        match (ann) {
          Some(t) => {
            exp = tyOf(cx, t);
            if (isBad(exp)) {
              return Err("local `" + name.name + "` has an unsupported type (" + badReason(exp) + ")");
            }
          },
          None => {}
        }
        const hx = hoistExec(g, st, cx, init, false)?;
        g = hx.g;
        st = hx.st;
        for (const r of hx.rets) {
          rets.push(r);
        }
        const mr = execCallStmt(g, st, cx, hx.e)?;
        let val = "";
        let vty = noExp();
        if (mr.isSome()) {
          g = mr.unwrap().g;
          st = mr.unwrap().st;
          val = mr.unwrap().t;
          vty = mr.unwrap().vt;
        } else {
          const t = trEmit(g, st, cx, hx.e, exp)?;
          g = t.g;
          st = t.st;
          val = t.t;
          vty = t.vt;
        }
        if (isUnit(vty)) {
          return Err("`let " + name.name + "` of a void value");
        }
        if (!isBad(exp) && !vtEq(vty, exp)) {
          return Err("local `" + name.name + "` has type `" + vtName(exp) + "`, initialiser `" + vtName(vty) + "`");
        }
        const ty = isBad(exp) ? concrete(vty) : exp;
        const f = fresh(g, cx, ty, val)?;
        g = f.g;
        st.vars.push(Var { name: name.name, term: f.name, vt: ty });
      },
      SAssign(target, op, value) => {
        const bo = binOfAssign(op);
        // the type of the place (its checks are emitted by the write, or by the compound operation), then the value
        const cur0 = tr(g, st.vars, cx, target, noExp())?;
        g = cur0.g;
        const cur = TS { g: g, st: st, t: cur0.t, vt: cur0.vt };
        let rhs = value;
        if (bo.isNone() && isSimplePlace(target)) {
          const hx = hoistExec(g, st, cx, value, false)?;
          g = hx.g;
          st = hx.st;
          for (const r of hx.rets) {
            rets.push(r);
          }
          rhs = hx.e;
        }
        if (bo.isSome()) {
          rhs = Expr { kind: EBinary(bo.unwrap(), target, value), span: s.span };
        }
        let mr: Option<MutR> = None;
        if (bo.isNone()) {
          mr = execCallStmt(g, st, cx, rhs)?;
        }
        let val = "";
        let vty = noExp();
        if (mr.isSome()) {
          g = mr.unwrap().g;
          st = mr.unwrap().st;
          val = mr.unwrap().t;
          vty = mr.unwrap().vt;
        } else {
          const t = trEmit(g, st, cx, rhs, cur.vt)?;
          g = t.g;
          st = t.st;
          val = t.t;
          vty = t.vt;
        }
        const sp = setPlace(g, st, cx, target, val, isIntTy(vty) && isIntTy(cur.vt) ? cur.vt : vty)?;
        g = sp.g;
        st = sp.st;
      },
      SExpr(e0) => {
        const hx = hoistExec(g, st, cx, e0, false)?;
        g = hx.g;
        st = hx.st;
        for (const r of hx.rets) {
          rets.push(r);
        }
        // `f()?;`: all there is to do has been done (the value is not used)
        const e = isAtom(hx.e) ? Expr { kind: EBool(true), span: e0.span } : hx.e;
        if (isCallNamed(e, "exit") && valKey(cx, "exit").isNone()) {
          // The process ends: no path continues.
          match (e.kind) {
            ECall(_, args) => {
              for (const a of args) {
                const t = trEmit(g, st, cx, a, noExp())?;
                g = t.g;
                st = t.st;
              }
            },
            _ => {}
          }
          return Ok(Ex { g: g, st: st, fall: false, rets: rets });
        }
        const mr = execCallStmt(g, st, cx, e)?;
        if (mr.isSome()) {
          g = mr.unwrap().g;
          st = mr.unwrap().st;
        } else if (isConsoleCall(e)) {
          // Output has no effect on the values the contracts speak about; its arguments are still evaluated.
          match (e.kind) {
            ECall(_, args) => {
              for (const a of args) {
                const t = trEmit(g, st, cx, a, noExp())?;
                g = t.g;
                st = t.st;
              }
            },
            _ => {}
          }
        } else {
          match (e.kind) {
            EMatch(scrut, arms) => {
              const r = execMatch(g, st, cx, scrut, arms, 0)?;
              g = r.g;
              for (const x of r.rets) {
                rets.push(x);
              }
              if (!r.fall) {
                return Ok(Ex { g: g, st: r.st, fall: false, rets: rets });
              }
              st = r.st;
            },
            _ => {
              const t = trEmit(g, st, cx, e, noExp())?;
              g = t.g;
              st = t.st;
            }
          }
        }
      },
      SReturn(v) => {
        match (v) {
          Some(e0) => {
            // `return match (s) { P => e, .. }` with an effect in an arm: each arm is a `return` of its own
            match (e0.kind) {
              EMatch(sc, arms) => {
                if (armsHaveEffect(cx, arms)) {
                  const hs = hoistExec(g, st, cx, sc, true)?;
                  g = hs.g;
                  st = hs.st;
                  for (const r of hs.rets) {
                    rets.push(r);
                  }
                  let arms2: MatchArm[] = [];
                  for (const a of arms) {
                    match (a.body) {
                      BExpr(x) => {
                        const ret = Stmt { kind: SReturn(Some(x)), span: a.span };
                        arms2.push(MatchArm { pattern: a.pattern, body: BBlock(Block { stmts: one1(ret), span: a.span }), span: a.span });
                      },
                      BBlock(_) => {}
                    }
                  }
                  const mr = execMatch(g, st, cx, hs.e, arms2, 0)?;
                  for (const r of mr.rets) {
                    rets.push(r);
                  }
                  // every arm returns; the path where no arm matched is excluded by the exhaustiveness of the match
                  return Ok(Ex { g: mr.g, st: mr.st, fall: false, rets: rets });
                }
              },
              _ => {}
            }
            const hx = hoistExec(g, st, cx, e0, true)?;
            g = hx.g;
            st = hx.st;
            for (const r of hx.rets) {
              rets.push(r);
            }
            const t = trEmit(g, st, cx, hx.e, cx.ret)?;
            g = t.g;
            rets.push(Ret { st: t.st, val: t.t, vt: t.vt, isVoid: false });
            return Ok(Ex { g: g, st: t.st, fall: false, rets: rets });
          },
          None => {
            rets.push(Ret { st: st, val: "", vt: VUnit, isVoid: true });
            return Ok(Ex { g: g, st: st, fall: false, rets: rets });
          }
        }
      },
      SBlock(b) => {
        const n0 = st.vars.length;
        const r = execStmts(g, st, cx, b.stmts, false)?;
        g = r.g;
        for (const x of r.rets) {
          rets.push(x);
        }
        if (!r.fall) {
          return Ok(Ex { g: g, st: r.st, fall: false, rets: rets });
        }
        st = r.st;
        st.vars = prefix(st.vars, n0);
      },
      SIf(c0, thenB, els) => {
        const hx = hoistExec(g, st, cx, c0, true)?;
        g = hx.g;
        st = hx.st;
        for (const r of hx.rets) {
          rets.push(r);
        }
        const r = execIf(g, st, cx, hx.e, thenB, els)?;
        g = r.g;
        for (const x of r.rets) {
          rets.push(x);
        }
        if (!r.fall) {
          return Ok(Ex { g: g, st: r.st, fall: false, rets: rets });
        }
        st = r.st;
      },
      SWhile(c, b) => {
        if (g.isExact()) {
          const u = Unroll { isWhile: true, cond: Some(c), iterVar: None, arrTerm: "", arrSort: "", elemTy: VUnit, body: b };
          const r = unrollStep(g, st, cx, u, 0)?;
          g = r.g;
          for (const x of r.rets) {
            rets.push(x);
          }
          if (!r.fall) {
            return Ok(Ex { g: g, st: r.st, fall: false, rets: rets });
          }
          st = r.st;
        } else {
          const stBefore = st;
          const r = execLoop(g, st, cx, true, Some(c), None, None, b, pending, s.span, stmts, k - 1)?;
          g = r.g;
          for (const x of r.rets) {
            rets.push(x);
          }
          // The same loop and the rest of the function, unrolled a few iterations without abstraction: what it
          // finds is real (bounded refutation).
          if (top && wantExact(cx)) {
            const er = exactFlow(g, stBefore, cx, s, tailStmts(stmts, k));
            match (er) {
              Ok(x) => {
                g = x.g;
                for (const y of x.rets) {
                  rets.push(y);
                }
                if (x.fall && isUnit(cx.ret)) {
                  rets.push(Ret { st: x.st, val: "", vt: VUnit, isVoid: true });
                }
              },
              Err(_) => {}
            }
          }
          if (!r.fall) {
            return Ok(Ex { g: g, st: r.st, fall: false, rets: rets });
          }
          st = r.st;
        }
      },
      SForOf(id, e, b) => {
        if (g.isExact()) {
          const it = trEmit(g, st, cx, e, noExp())?;
          g = it.g;
          st = it.st;
          const el = match (it.vt) {
            VArr(t) => t,
            _ => VBad("not an array")
          };
          if (isBad(el)) {
            return Err("`for .. of` over a value of type `" + vtName(it.vt) + "` is not supported");
          }
          const so = sortS(g, cx, it.vt)?;
          g = so.g;
          const u = Unroll { isWhile: false, cond: None, iterVar: Some(id), arrTerm: it.t, arrSort: so.s, elemTy: el, body: b };
          const r = unrollStep(g, st, cx, u, 0)?;
          g = r.g;
          for (const x of r.rets) {
            rets.push(x);
          }
          if (!r.fall) {
            return Ok(Ex { g: g, st: r.st, fall: false, rets: rets });
          }
          st = r.st;
        } else {
          const stBefore = st;
          const r = execLoop(g, st, cx, false, None, Some(id), Some(e), b, pending, s.span, stmts, k - 1)?;
          g = r.g;
          for (const x of r.rets) {
            rets.push(x);
          }
          if (top && wantExact(cx)) {
            const er = exactFlow(g, stBefore, cx, s, tailStmts(stmts, k));
            match (er) {
              Ok(x) => {
                g = x.g;
                for (const y of x.rets) {
                  rets.push(y);
                }
                if (x.fall && isUnit(cx.ret)) {
                  rets.push(Ret { st: x.st, val: "", vt: VUnit, isVoid: true });
                }
              },
              Err(_) => {}
            }
          }
          if (!r.fall) {
            return Ok(Ex { g: g, st: r.st, fall: false, rets: rets });
          }
          st = r.st;
        }
      },
      SBreak => {
        // The path leaves the loop body (the effect of a loop with a jump is havoc'd by execLoop).
        return Ok(Ex { g: g, st: st, fall: false, rets: rets });
      },
      SContinue => {
        return Ok(Ex { g: g, st: st, fall: false, rets: rets });
      }
    }
    if (!keepPending) {
      pending = [];
    }
  }
  return Ok(Ex { g: g, st: st, fall: true, rets: rets });
}

// The state after two branches of a conditional, merged: variables that differ get a conditional value, the
// path conditions of the branches are guarded by the branch condition.
function mergeBranches(g0: Gen, cx: Cx, pc0: string[], ct: string, n0: usize, r1: Ex, r2: Ex, st1: St): Result<Ex, string> {
  let g = g0;
  const notC = "(not " + ct + ")";
  const rets = concatRets(r1.rets, r2.rets);
  if (!r1.fall && !r2.fall) {
    return Ok(Ex { g: g, st: st1, fall: false, rets: rets });
  }
  if (r1.fall && !r2.fall) {
    return Ok(Ex { g: g, st: St { vars: prefix(r1.st.vars, n0), pc: r1.st.pc, deps: r1.st.deps, approx: r1.st.approx }, fall: true, rets: rets });
  }
  if (!r1.fall && r2.fall) {
    return Ok(Ex { g: g, st: St { vars: prefix(r2.st.vars, n0), pc: r2.st.pc, deps: r2.st.deps, approx: r2.st.approx }, fall: true, rets: rets });
  }
  let merged: Var[] = [];
  let i: usize = 0;
  while (i < n0) {
    const a = r1.st.vars[i];
    const b = r2.st.vars[i];
    if (a.term == b.term) {
      merged.push(a);
    } else {
      const f = fresh(g, cx, a.vt, "(ite " + ct + " " + a.term + " " + b.term + ")")?;
      g = f.g;
      merged.push(Var { name: a.name, term: f.name, vt: a.vt });
    }
    i += 1;
  }
  const base = pc0.length + 1;
  const pc = concat(concat(pc0, guarded(ct, tailFrom(r1.st.pc, base))), guarded(notC, tailFrom(r2.st.pc, base)));
  const approx = r1.st.approx != "" ? r1.st.approx : r2.st.approx;
  return Ok(Ex { g: g, st: St { vars: merged, pc: pc, deps: unionUsize(r1.st.deps, r2.st.deps), approx: approx }, fall: true, rets: rets });
}

function concatRets(a: Ret[], b: Ret[]): Ret[] {
  let out: Ret[] = [];
  for (const x of a) {
    out.push(x);
  }
  for (const x of b) {
    out.push(x);
  }
  return out;
}

function execElse(g: Gen, st: St, cx: Cx, els: Option<Stmt>): Result<Ex, string> {
  return match (els) {
    None => Ok(Ex { g: g, st: st, fall: true, rets: [] }),
    Some(s) => execStmts(g, st, cx, [s], false)
  };
}

function execIf(g0: Gen, st: St, cx: Cx, c: Expr, thenB: Block, els: Option<Stmt>): Result<Ex, string> {
  const ct = trEmit(g0, st, cx, c, VBool)?;
  if (!vtEq(ct.vt, VBool)) {
    return Err("`if` condition is not bool");
  }
  const n0 = st.vars.length;
  const pc0 = ct.st.pc;
  const s1 = St { vars: ct.st.vars, pc: concat(pc0, [ct.t]), deps: ct.st.deps, approx: ct.st.approx };
  const r1 = execStmts(ct.g, s1, cx, thenB.stmts, false)?;
  const s2 = St { vars: ct.st.vars, pc: concat(pc0, ["(not " + ct.t + ")"]), deps: ct.st.deps, approx: ct.st.approx };
  const r2 = execElse(r1.g, s2, cx, els)?;
  return mergeBranches(r2.g, cx, pc0, ct.t, n0, r1, r2, s1);
}

// `match (e) { .. }` as a statement: arm k is taken when its pattern matches and no earlier one did.
function execMatch(g0: Gen, st: St, cx: Cx, scrut: Expr, arms: MatchArm[], k0: usize): Result<Ex, string> {
  let g = g0;
  const s0 = trEmit(g, st, cx, scrut, noExp())?;
  const sr = TR { g: s0.g, t: s0.t, vt: s0.vt, chks: noChks() };
  const so = sortS(s0.g, cx, s0.vt)?;
  return execMatchFrom(so.g, s0.st, cx, sr, so.s, arms, 0);
}

function execMatchFrom(g0: Gen, st: St, cx: Cx, s: TR, sn: string, arms: MatchArm[], k: usize): Result<Ex, string> {
  let g = g0;
  if (k >= arms.length) {
    // no arm matched: the match is exhaustive (the checker rejects the others), so this path cannot happen and
    // nothing leaves it: the match falls through only on the paths of its arms. (Falling through here with a
    // false path condition made a function whose arms all `return` look as if it ended without a value.)
    return Ok(Ex { g: g, st: st, fall: false, rets: [] });
  }
  const arm = arms[k];
  const mp = matchPattern(g, cx, s, sn, arm.pattern)?;
  g = mp.g;
  const n0 = st.vars.length;
  let vars1 = st.vars;
  for (const b of mp.binds) {
    vars1.push(b);
  }
  let tfs: string[] = [];
  for (const bd of mp.binds) {
    const tfb = tfOf(g, cx, bd.vt, bd.term)?;
    g = tfb.g;
    for (const c of tfb.chks) {
      tfs.push(c.goal);
    }
  }
  const s1 = St { vars: vars1, pc: concat(concat(st.pc, [mp.test]), tfs), deps: st.deps, approx: st.approx };
  const body: Stmt[] = match (arm.body) {
    BExpr(x) => [Stmt { kind: SExpr(x), span: arm.span }],
    BBlock(b) => b.stmts
  };
  const r1 = execStmts(g, s1, cx, body, false)?;
  const s2 = St { vars: st.vars, pc: concat(st.pc, ["(not " + mp.test + ")"]), deps: st.deps, approx: st.approx };
  const r2 = execMatchFrom(r1.g, s2, cx, s, sn, arms, k + 1)?;
  // vars1 has the bindings; the merge works on the first n0 variables
  return mergeBranches(r2.g, cx, st.pc, mp.test, n0, r1, r2, s1);
}

// ------------------------------------------------------------------------------- bounded exact unrolling

// How many iterations of a loop are unrolled exactly.
const UNROLL: usize = 3;

type Unroll = { isWhile: bool; cond: Option<Expr>; iterVar: Option<Ident>; arrTerm: string; arrSort: string; elemTy: VT; body: Block; };

function tailStmts(stmts: Stmt[], start: usize): Stmt[] {
  let out: Stmt[] = [];
  let i = start;
  while (i < stmts.length) {
    out.push(stmts[i]);
    i += 1;
  }
  return out;
}

// Only functions with something to prove get the second, exact pass.
function wantExact(cx: Cx): bool {
  return hasClauses(cx.f) || cx.f.kind == 1 || cx.f.kind == 3;
}

// The loop (a statement) and what follows it, executed with every loop unrolled (no abstraction at all): the
// obligations and the returns found are those of real executions that leave each loop within a few iterations.
function exactFlow(g0: Gen, st: St, cx: Cx, loopStmt: Stmt, rest: Stmt[]): Result<Ex, string> {
  let g = g0;
  g.setExact(true);
  let all: Stmt[] = [loopStmt];
  for (const x of rest) {
    all.push(x);
  }
  const r = execStmts(g, st, cx, all, true)?;
  let g2 = r.g;
  g2.setExact(false);
  return Ok(Ex { g: g2, st: r.st, fall: r.fall, rets: r.rets });
}

// `if (c) { body; <next iteration> } else { exit }`, UNROLL deep; after the last level the loop is assumed to exit
// (executions with more iterations are not covered, which keeps every path exact).
function unrollStep(g0: Gen, st: St, cx: Cx, u: Unroll, d: usize): Result<Ex, string> {
  let g = g0;
  let st1 = st;
  let ct = "";
  if (u.isWhile) {
    const c = trEmit(g, st, cx, u.cond.unwrap(), VBool)?;
    if (!vtEq(c.vt, VBool)) {
      return Err("`while` condition is not bool");
    }
    g = c.g;
    st1 = c.st;
    ct = c.t;
  } else {
    ct = "(< " + d.toString() + " " + arrLen(u.arrSort, u.arrTerm) + ")";
  }
  const notC = "(not " + ct + ")";
  if (d >= UNROLL) {
    return Ok(Ex { g: g, st: St { vars: st1.vars, pc: concat(st1.pc, [notC]), deps: st1.deps, approx: st1.approx }, fall: true, rets: [] });
  }
  const n0 = st1.vars.length;
  let vars1 = st1.vars;
  if (!u.isWhile) {
    vars1.push(Var { name: u.iterVar.unwrap().name, term: arrSel(u.arrSort, u.arrTerm, d.toString()), vt: u.elemTy });
  }
  const s1 = St { vars: vars1, pc: concat(st1.pc, [ct]), deps: st1.deps, approx: st1.approx };
  const r1 = execStmts(g, s1, cx, u.body.stmts, false)?;
  let thenR = r1;
  if (r1.fall) {
    const next = St { vars: prefix(r1.st.vars, n0), pc: r1.st.pc, deps: r1.st.deps, approx: r1.st.approx };
    const r1b = unrollStep(r1.g, next, cx, u, d + 1)?;
    thenR = Ex { g: r1b.g, st: r1b.st, fall: r1b.fall, rets: concatRets(r1.rets, r1b.rets) };
  }
  const s2 = St { vars: st1.vars, pc: concat(st1.pc, [notC]), deps: st1.deps, approx: st1.approx };
  const r2 = Ex { g: thenR.g, st: s2, fall: true, rets: [] };
  return mergeBranches(thenR.g, cx, st1.pc, ct, n0, thenR, r2, s1);
}

// ------------------------------------------------------------------------------------------------ loops

// A loop invariant: a user clause (`@Invariant(e)` before the loop) or an inferred counter bound.
type LInv = { label: string; clause: Option<ContractClause>; ctr: Option<Ctr>; line: usize; };

// `while (i < N)` with a counter `i` that the body only increases by one, once per iteration, and a bound `N` the
// body does not change: `i0 <= i` and `i <= max(i0, N)` (for `<=`: `max(i0, N + 1)`) hold at every iteration.
type Ctr = { name: string; bound: Expr; incl: bool; i0: string; };

function mentions(e: Expr, names: string[]): bool {
  return match (e.kind) {
    EIdent(id) => names.includes(id.name),
    EThis => names.includes("this") || names.includes("this."),
    EUnary(_, x) => mentions(x, names),
    EBinary(_, l, r) => mentions(l, names) || mentions(r, names),
    ECond(c, a, b) => mentions(c, names) || mentions(a, names) || mentions(b, names),
    EMember(b, f) => {
      if (isThisExpr(b)) {
        return names.includes("this") || names.includes("this." + f.name);
      }
      return mentions(b, names);
    },
    EIndex(b, i) => mentions(b, names) || mentions(i, names),
    ECall(c, args) => {
      if (mentions(c, names)) {
        return true;
      }
      for (const a of args) {
        if (mentions(a, names)) {
          return true;
        }
      }
      return false;
    },
    EInt(_) => false,
    EBool(_) => false,
    _ => true
  };
}

// Number of `name += 1` / `name = name + 1` statements in the list (not inside nested loops); None when the
// variable is assigned any other way, shadowed, or touched inside a nested loop.
function incrementsOf(stmts: Stmt[], name: string): Option<usize> {
  let n: usize = 0;
  for (const s of stmts) {
    const r = incrementsStmt(s, name);
    if (r.isNone()) {
      return None;
    }
    n += r.unwrap();
  }
  return Some(n);
}

function isIdentNamed(e: Expr, name: string): bool {
  return match (e.kind) {
    EIdent(id) => id.name == name,
    _ => false
  };
}

function isOne(e: Expr): bool {
  return match (e.kind) {
    EInt(n) => n == 1,
    _ => false
  };
}

function incrementsStmt(s: Stmt, name: string): Option<usize> {
  return match (s.kind) {
    SAssign(target, op, value) => {
      if (!isIdentNamed(target, name)) {
        return Some(0);
      }
      const isInc = match (op) {
        OpAddAssign => isOne(value),
        OpAssign => match (value.kind) {
          EBinary(bop, l, r) => match (bop) {
            BAdd => isIdentNamed(l, name) && isOne(r),
            _ => false
          },
          _ => false
        },
        _ => false
      };
      return isInc ? Some(1) : None;
    },
    SLet(_, id, _, _) => id.name == name ? None : Some(0),
    SIf(_, t, e) => {
      const a = incrementsOf(t.stmts, name);
      if (a.isNone()) {
        return None;
      }
      if (e.isSome()) {
        const b = incrementsStmt(e.unwrap(), name);
        if (b.isNone()) {
          return None;
        }
        // at most one of the two branches runs
        return Some(a.unwrap() > b.unwrap() ? a.unwrap() : b.unwrap());
      }
      return a;
    },
    SBlock(b) => incrementsOf(b.stmts, name),
    SWhile(_, b) => {
      const r = incrementsOf(b.stmts, name);
      return r.isSome() && r.unwrap() == 0 ? Some(0) : None;
    },
    SForOf(id, _, b) => {
      if (id.name == name) {
        return None;
      }
      const r = incrementsOf(b.stmts, name);
      return r.isSome() && r.unwrap() == 0 ? Some(0) : None;
    },
    _ => Some(0)
  };
}

function inferCounter(st: St, cond: Expr, body: Block, mods: string[]): Option<Ctr> {
  let name = "";
  let bound: Option<Expr> = None;
  let incl = false;
  match (cond.kind) {
    EBinary(op, l, r) => {
      match (op) {
        BLt => {
          match (l.kind) {
            EIdent(id) => { name = id.name; bound = Some(r); },
            _ => {}
          }
        },
        BLe => {
          match (l.kind) {
            EIdent(id) => { name = id.name; bound = Some(r); incl = true; },
            _ => {}
          }
        },
        BGt => {
          match (r.kind) {
            EIdent(id) => { name = id.name; bound = Some(l); },
            _ => {}
          }
        },
        BGe => {
          match (r.kind) {
            EIdent(id) => { name = id.name; bound = Some(l); incl = true; },
            _ => {}
          }
        },
        _ => {}
      }
    },
    _ => {}
  }
  const none: Option<Ctr> = None;
  if (name == "" || bound.isNone() || !mods.includes(name)) {
    return none;
  }
  const v = lookupVar(st.vars, name);
  if (v.isNone() || !isIntTy(v.unwrap().vt)) {
    return none;
  }
  if (mentions(bound.unwrap(), mods)) {
    return none;
  }
  const inc = incrementsOf(body.stmts, name);
  if (inc.isNone() || inc.unwrap() != 1) {
    return none;
  }
  return Some(Ctr { name: name, bound: bound.unwrap(), incl: incl, i0: v.unwrap().term });
}

// An invariant at the variables `vars`: the term and the well-definedness of its clause.
function invAt(g: Gen, cx: Cx, vars: Var[], inv: LInv): Result<Cl, string> {
  if (inv.clause.isNone() && inv.ctr.unwrap().i0 == "=") {
    // the counter of a `for .. of` loop equals the position of the iteration
    const cv = lookupVar(vars, inv.ctr.unwrap().name);
    const ix = lookupVar(vars, "loopIndex");
    if (cv.isNone() || ix.isNone()) {
      return Err("counter not in scope");
    }
    return Ok(Cl { g: g, t: "(= " + cv.unwrap().term + " " + ix.unwrap().term + ")", wd: wdOf(noChks()), tf: "true" });
  }
  const pc = cxPlain(cx);
  if (inv.clause.isSome()) {
    const ex = exprOf(inv.clause.unwrap());
    if (ex.isNone()) {
      return Err("empty clause");
    }
    return trClause(g, vars, pc, ex.unwrap());
  }
  const ctr = inv.ctr.unwrap();
  const v = lookupVar(vars, ctr.name);
  if (v.isNone()) {
    return Err("counter not in scope");
  }
  const n = tr(g, vars, pc, ctr.bound, v.unwrap().vt)?;
  const nb = ctr.incl ? "(+ " + n.t + " 1)" : n.t;
  const t = "(and (<= " + ctr.i0 + " " + v.unwrap().term + ") (<= " + v.unwrap().term + " (ite (<= " + ctr.i0 + " " + nb + ") " + nb + " " + ctr.i0 + ")))";
  return Ok(Cl { g: n.g, t: t, wd: wdOf(n.chks), tf: "true" });
}

// `for (const x of xs)`: an `@Invariant` before the loop may use `loopIndex`, the position in `xs` of the iteration it is
// about (docs/contracts.md, Loops). `at` is its term; "" for a `while` loop, which has no such variable.
function withIndex(vars: Var[], at: string): Var[] {
  if (at == "") {
    return vars;
  }
  return vars.concat([Var { name: "loopIndex", term: at, vt: VInt("usize") }]);
}

// `for (const x of xs) { ..; k += 1; }` with `let k = 0` before the loop: a counter the body only increments, once, as its
// last statement. The verifier proposes `k == position` (a hidden invariant, proved like a user invariant) so that the
// loop invariants can speak about `k` (sources that may not use `loopIndex` yet).
function forOfCounter(outer: Stmt[], at: usize, body: Block, name: string, elem: string): bool {
  if (name.startsWith("this.") || name == elem || body.stmts.length == 0) {
    return false;
  }
  // `let name = 0` earlier in the same block, with nothing writing `name` between it and the loop
  let zero = false;
  let j = at < outer.length ? at : outer.length;
  while (j > 0) {
    j -= 1;
    let done = false;
    match (outer[j].kind) {
      SLet(_, id, _, init) => {
        if (id.name == name) {
          done = true;
          match (init.kind) {
            EInt(z) => { zero = z == 0; },
            _ => {}
          }
        }
      },
      _ => {
        const w = incrementsStmt(outer[j], name);
        if (!(w.isSome() && w.unwrap() == 0)) {
          done = true;
        }
      }
    }
    if (done) {
      break;
    }
  }
  if (!zero) {
    return false;
  }
  const n = body.stmts.length;
  const isInc = match (body.stmts[n - 1].kind) {
    SAssign(target, op, value) => isIdentNamed(target, name) && match (op) {
      OpAddAssign => isOne(value),
      _ => false
    },
    _ => false
  };
  if (!isInc) {
    return false;
  }
  let pre: Stmt[] = [];
  let i: usize = 0;
  while (i + 1 < n) {
    pre.push(body.stmts[i]);
    i += 1;
  }
  const r = incrementsOf(pre, name);
  return r.isSome() && r.unwrap() == 0;
}

type HV = { g: Gen; vars: Var[]; touched: string[]; };

// Fresh values for what a loop changes. `names` are variables, `this` or `this.f`.
function havocVars(g0: Gen, cx: Cx, vars: Var[], names: string[]): Result<HV, string> {
  let g = g0;
  let out = vars;
  let touched: string[] = [];
  for (const n of names) {
    if (n.startsWith("this.")) {
      continue;
    }
    const idx = assignIndex(out, n);
    if (idx.isSome()) {
      const v = out[idx.unwrap()];
      const f = freshFree(g, cx, v.vt)?;
      g = f.g;
      out[idx.unwrap()] = Var { name: v.name, term: f.name, vt: v.vt };
      touched.push(n);
    }
  }
  // fields of `this`: a new object that keeps the other fields
  if (!names.includes("this")) {
    let flds: string[] = [];
    for (const n of names) {
      if (n.startsWith("this.")) {
        flds.push(n.substring(5, n.length));
      }
    }
    const ti = assignIndex(out, "this");
    if (flds.length > 0 && ti.isSome()) {
      const tv = out[ti.unwrap()];
      match (tv.vt) {
        VRec(rn) => {
          const rd = cx.p.tab.findRec(rn);
          if (rd.isSome()) {
            const so = sortS(g, cx, tv.vt)?;
            g = so.g;
            const d = rd.unwrap();
            let args: string[] = [];
            let i: usize = 0;
            while (i < d.fields.length) {
              if (flds.includes(d.fields[i])) {
                const ft = fieldTyOf(cx.p.tab, d, i);
                if (isBad(ft)) {
                  const os = opaqueSort(g);
                  g = os.g;
                  const nm = g.next("o");
                  g.declare("(declare-const " + nm + " " + os.s + ")");
                  args.push(nm);
                } else {
                  const f = freshFree(g, cx, ft)?;
                  g = f.g;
                  args.push(f.name);
                }
              } else {
                args.push(recField(so.s, d.fields[i], tv.term));
              }
              i += 1;
            }
            const f2r = cx.p.tab.isCyclic("r:" + rn) ? cyclicMk(g, cx, tv.vt, so.s, d.fields, args) : fresh(g, cx, tv.vt, "(mk" + so.s + " " + args.join(" ") + ")");
            const f2 = f2r?;
            g = f2.g;
            out[ti.unwrap()] = Var { name: "this", term: f2.name, vt: tv.vt };
            touched.push("this." + flds.join(", this."));
          }
        },
        _ => {}
      }
    }
  }
  return Ok(HV { g: g, vars: out, touched: touched });
}

function modifiedNames(cx: Cx, st: St, body: Block): string[] {
  const all = assignedIn(cx.p, body.stmts, []);
  let out: string[] = [];
  for (const n of all) {
    if (n.startsWith("this.")) {
      if (lookupVar(st.vars, "this").isSome()) {
        out.push(n);
      }
    } else if (lookupVar(st.vars, n).isSome()) {
      out.push(n);
    }
  }
  return out;
}

function execLoop(g0: Gen, st0: St, cx: Cx, isWhile: bool, cond: Option<Expr>, iterVar: Option<Ident>, iterExpr: Option<Expr>, body: Block, pending: ContractClause[], span: Span, outer: Stmt[], at: usize): Result<Ex, string> {
  let g = g0;
  let st = st0;
  const line = lineOf(cx.text, span.start);
  // `for (const x of xs)`: the iterated array is evaluated once.
  let elemTy = noExp();
  let arrTerm = "";
  let arrSortName = "";
  if (!isWhile) {
    const it = trEmit(g, st, cx, iterExpr.unwrap(), noExp())?;
    g = it.g;
    st = it.st;
    match (it.vt) {
      VArr(el) => {
        elemTy = el;
        arrTerm = it.t;
        const so = sortS(g, cx, it.vt)?;
        g = so.g;
        arrSortName = so.s;
      },
      _ => {
        return Err("`for .. of` over a value of type `" + vtName(it.vt) + "` is not supported");
      }
    }
  }
  const mods = modifiedNames(cx, st, body);
  const jump = hasJump(body.stmts);
  // Invariants: the user's, then an inferred counter bound.
  let invs: LInv[] = [];
  if (!jump) {
    for (const c of pending) {
      match (c.kind) {
        CInvariant => {
          invs.push(LInv { label: clauseText(cx.text, c), clause: Some(c), ctr: None, line: lineOf(cx.text, c.span.start) });
        },
        _ => {}
      }
    }
    if (!isWhile) {
      for (const nm of mods) {
        if (forOfCounter(outer, at, body, nm, iterVar.unwrap().name)) {
          invs.push(LInv { label: "inferred position counter `" + nm + "`", clause: None, ctr: Some(Ctr { name: nm, bound: iterExpr.unwrap(), incl: false, i0: "=" }), line: line });
        }
      }
    }
    if (isWhile) {
      const ctr = inferCounter(st, cond.unwrap(), body, mods);
      if (ctr.isSome()) {
        invs.push(LInv { label: "inferred counter bound of `" + ctr.unwrap().name + "`", clause: None, ctr: ctr, line: line });
      }
    }
  }
  // Entry: every invariant holds before the first iteration.
  let kept: LInv[] = [];
  const lid = g.newLoop();
  let userCount: usize = 0;
  for (const inv of invs) {
    const t = invAt(g, cx, withIndex(st.vars, isWhile ? "" : "0"), inv);
    match (t) {
      Ok(x) => {
        g = x.g;
        const goal = clGoal(x);
        const hidden = inv.clause.isNone();
        const id = g.addObl(Obl {
          kind: "loop-invariant", what: "entry", line: inv.line, clause: inv.label + " (holds on entry to the loop)", goal: goal, pc: st.pc,
          deps: st.deps, approx: st.approx, file: cx.f.file, fn: cx.f.disp, text: cx.f.text, hidden: hidden, exact: false
        });
        g.loopAdd(lid, id);
        kept.push(inv);
        if (!hidden) {
          userCount += 1;
        }
      },
      Err(_) => {}
    }
  }
  g.useAssumption("A-LOOP");
  const reasonIn = userCount > 0
    ? "inside a loop: the loop invariant may be too weak to exclude this state (a counterexample is not trusted)"
    : "loop without invariant: the state inside the loop is unconstrained (a counterexample is not trusted)";
  // The state at the start of an arbitrary iteration: what the loop changes is arbitrary, the invariants hold.
  const hv1 = havocVars(g, cx, st.vars, mods)?;
  g = hv1.g;
  let pc1 = st.pc;
  // `for .. of`: this iteration is at the position `iv`, and its element is `arr[iv]`.
  let iv = "";
  let xvName = "";
  if (!isWhile) {
    const ix = freshFree(g, cx, VInt("usize"))?;
    g = ix.g;
    iv = ix.name;
    pc1.push(inBounds(arrSortName, arrTerm, iv));
    const xv = freshFree(g, cx, elemTy)?;
    g = xv.g;
    xvName = xv.name;
    pc1.push("(= " + xvName + " " + arrSel(arrSortName, arrTerm, iv) + ")");
  }
  for (const inv of kept) {
    const t = invAt(g, cx, withIndex(hv1.vars, iv), inv);
    match (t) {
      Ok(x) => {
        g = x.g;
        pc1.push(clHyp(x));
      },
      Err(_) => {}
    }
  }
  let s1 = St { vars: hv1.vars, pc: pc1, deps: unionUsize(st.deps, [lid]), approx: reasonIn };
  if (!isWhile) {
    s1.vars.push(Var { name: iterVar.unwrap().name, term: xvName, vt: elemTy });
  } else {
    const c = trEmit(g, s1, cx, cond.unwrap(), VBool)?;
    if (!vtEq(c.vt, VBool)) {
      return Err("`while` condition is not bool");
    }
    g = c.g;
    s1 = c.st;
    s1.pc.push(c.t);
  }
  const bodyR = execStmts(g, s1, cx, body.stmts, false)?;
  g = bodyR.g;
  // The invariants are preserved by one iteration.
  if (bodyR.fall && !jump) {
    for (const inv of kept) {
      const t = invAt(g, cx, withIndex(bodyR.st.vars, isWhile ? "" : "(+ " + iv + " 1)"), inv);
      match (t) {
        Ok(x) => {
          g = x.g;
          const goal = clGoal(x);
          const id = g.addObl(Obl {
            kind: "loop-invariant", what: "preserved", line: inv.line, clause: inv.label + " (preserved by the loop body)", goal: goal, pc: bodyR.st.pc,
            deps: bodyR.st.deps, approx: bodyR.st.approx, file: cx.f.file, fn: cx.f.disp, text: cx.f.text, hidden: inv.clause.isNone(), exact: false
          });
          g.loopAdd(lid, id);
        },
        Err(_) => {}
      }
    }
  }
  // After the loop: what it changes is arbitrary, the invariants hold, and (for `while`, without `break`) the
  // condition is false.
  const hv3 = havocVars(g, cx, st.vars, mods)?;
  g = hv3.g;
  let pc3 = st.pc;
  for (const inv of kept) {
    const t = invAt(g, cx, withIndex(hv3.vars, isWhile ? "" : arrLen(arrSortName, arrTerm)), inv);
    match (t) {
      Ok(x) => {
        g = x.g;
        pc3.push(clHyp(x));
      },
      Err(_) => {}
    }
  }
  if (isWhile && !jump) {
    const c = tr(g, hv3.vars, cx, cond.unwrap(), VBool)?;
    g = c.g;
    pc3.push("(not " + c.t + ")");
  }
  let approx3 = st.approx;
  if (hv3.touched.length > 0) {
    approx3 = userCount > 0
      ? "after a loop: the loop invariant may not determine " + hv3.touched.join(", ") + " (a counterexample is not trusted)"
      : "loop without invariant: " + hv3.touched.join(", ") + " is unconstrained after the loop (a counterexample is not trusted)";
  }
  if (jump) {
    approx3 = "loop with `break` or `continue`: its effect is not modelled (a counterexample is not trusted)";
  }
  const st3 = St { vars: hv3.vars, pc: pc3, deps: unionUsize(st.deps, [lid]), approx: approx3 };
  return Ok(Ex { g: g, st: st3, fall: true, rets: bodyR.rets });
}
