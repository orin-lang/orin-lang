    StdMutant { target: "html", name: "provider-url-rule-drops-xlink", oldText: ", \"xlink-href\"]", newText: "]", extra: "" },
    StdMutant { target: "html", name: "provider-event-prefix-wrong", oldText: "prefix: \"on\"", newText: "prefix: \"no\"", extra: "" },
