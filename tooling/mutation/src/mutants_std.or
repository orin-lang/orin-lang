    StdMutant { target: "html", name: "provider-void-adds-p", oldText: "\"area\", \"base\"", newText: "\"p\", \"area\", \"base\"", extra: "" },
    StdMutant { target: "html", name: "provider-rawtext-drops-style", oldText: "rawTextTags: [\"script\", \"style\"]", newText: "rawTextTags: [\"script\"]", extra: "" },
