}

// std:net mutants (target "net"): library/std/net.or imports the internal std:fsraw, so a copy outside the library root
// cannot be compiled. The mutant is applied to a copy of the compiler sources and of the library, the copy is rebuilt with
// the given compiler, and tests/std/net_test.or runs with the mutated compiler.
export function netMutants(): StdMutant[] {
  return [
    StdMutant { target: "net", name: "delimiterEnd-misses-delimiter-at-end", oldText: "  while (i + m <= n) {", newText: "  while (i + m < n) {", extra: "" },
    StdMutant { target: "net", name: "readUntil-receives-past-the-limit", oldText: "const r = recvMs(s, limit - this.pending.length(), clampMs(left));", newText: "const r = recvMs(s, limit, clampMs(left));", extra: "" },
    StdMutant { target: "net", name: "readExact-reports-short-read-as-timeout", oldText: "            return Ok(FillClosed(this.take(this.pending.length())));\n          }\n          if (e.kind != Timeout || end - netNow(s) <= 0) {\n            return Err(e);\n          }\n        }\n      }\n    }\n    return Ok(Filled(this.take(n)));", newText: "            return Err(netErrorFromCode(CODE_TIMEOUT));\n          }\n          if (e.kind != Timeout || end - netNow(s) <= 0) {\n            return Err(e);\n          }\n        }\n      }\n    }\n    return Ok(Filled(this.take(n)));", extra: "" },
    StdMutant { target: "net", name: "readExact-loop-bound", oldText: "    while (this.pending.length() < n) {\n      const left", newText: "    while (this.pending.length() <= n) {\n      const left", extra: "" },
    StdMutant { target: "net", name: "parsePeer-keeps-brackets", oldText: "h = h.substring(1, h.length - 1);", newText: "h = h;", extra: "" },
    StdMutant { target: "net", name: "isDenied-wrong-code", oldText: "return e.kind == Denied;", newText: "return e.kind == Timeout;", extra: "" },
    StdMutant { target: "net", name: "recv-ignores-maxBytes", oldText: "const r = netRecv(s, maxBytes, ms);", newText: "const r = netRecv(s, 65536, ms);", extra: "" },
    StdMutant { target: "net", name: "readUntil-deadline-ignored", oldText: "    const end = deadline.at.millis;\n    let begin: usize = 0;", newText: "    const end = netNow(s) + 1000000;\n    let begin: usize = 0;", extra: "" },
    StdMutant { target: "net", name: "sendAll-ignores-view-start", oldText: "  let off = data.storageStart();", newText: "  let off: usize = 0;", extra: "" },
    StdMutant { target: "net", name: "send-ignores-view-start", oldText: "  return sendFrom(s, data.storage(), start, start + data.length(), clampMs(timeout.millis));", newText: "  return sendFrom(s, data.storage(), 0, data.length(), clampMs(timeout.millis));", extra: "" },
  ];
}
