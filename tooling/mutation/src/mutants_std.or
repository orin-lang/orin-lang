// The mutants of the provable std modules (tools/mutate_std.py MUTANTS and NET_MUTANTS, unchanged and in the same order).
// Each mutant is a one-line, deliberately wrong change of library/std/<target>.or: `oldText` (it must occur in the module)
// is replaced by `newText`. `extra` names an expect-trap test of tests/std/expect_trap/ that must FAIL (trap) on the real
// code; a mutant that survives the module's tests is killed when that test passes with it.

export type StdMutant = { target: string; name: string; oldText: string; newText: string; extra: string; };

export function stdMutants(): StdMutant[] {
  return [
    // ---- std:taskcore (the pure bookkeeping of std:task: Ring = one channel buffer, Ledger = one scope's task table)
    StdMutant { target: "taskcore", name: "ring-push-slot-ignores-head", oldText: "return (head + len) % cap;", newText: "return len % cap;", extra: "" },
    StdMutant { target: "taskcore", name: "ring-push-forgets-len", oldText: "    const slot = ringSlot(this.cap, this.head, this.len);\n    this.len += 1;\n    return slot;", newText: "    const slot = ringSlot(this.cap, this.head, this.len);\n    return slot;", extra: "" },
    StdMutant { target: "taskcore", name: "ring-pop-head-stays", oldText: "    this.head = ringNextHead(this.cap, this.head);\n    this.len -= 1;", newText: "    this.len -= 1;", extra: "" },
    StdMutant { target: "taskcore", name: "ring-pop-wrap-off-by-one", oldText: "return (head + 1) % cap;", newText: "return (head + 1) % (cap + 1);", extra: "" },
