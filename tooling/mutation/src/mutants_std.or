    StdMutant { target: "html", name: "provider-escape-apostrophe-raw", oldText: "encoded: \"&#39;\" },", newText: "encoded: \"'\" },", extra: "" },
    StdMutant { target: "html", name: "provider-escape-lt-wrong", oldText: "encoded: \"&lt;\" },", newText: "encoded: \"&gt;\" },", extra: "" },
