    StdMutant { target: "text", name: "trim-keeps-trailing-blank", oldText: "  while (last > first && isBlankLine(lines[last - 1])) {", newText: "  while (last > lines.length && isBlankLine(lines[last - 1])) {", extra: "" },
    StdMutant { target: "text", name: "trim-keeps-leading-blank", oldText: "  while (first < lines.length && isBlankLine(lines[first])) {", newText: "  while (first > lines.length && isBlankLine(lines[first])) {", extra: "" },
