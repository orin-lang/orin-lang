    StdMutant { target: "text", name: "dedent-width-not-prefix", oldText: "  while (i < a.length && i < b.length && a.charCodeAt(i) == b.charCodeAt(i)) {", newText: "  while (i < a.length && i < b.length) {", extra: "" },
    StdMutant { target: "text", name: "cr-not-blank", oldText: "    if (c != 32 && c != 9 && c != 13) {\n      return false;", newText: "    if (c != 32 && c != 9) {\n      return false;", extra: "" },
    StdMutant { target: "text", name: "crlf-gives-two-newlines", oldText: "      if (i + 1 < text.length && text.charCodeAt(i + 1) == 10) {\n        i += 1;\n      }", newText: "      if (i + 1 < text.length && text.charCodeAt(i + 1) == 10) {\n      }", extra: "" },
