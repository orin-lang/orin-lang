import { assertEqString, assertEqUsize, assertEqBool } from "std:test";
import { StdMutant, stdMutants, netMutants } from "../src/mutants_std";
import { Row, selectShard, selectStd, testFiles, isEarlyExit, rewriteImports, rowLine, summaryLines, dirName, neededTests } from "../src/std_check";

function countOf(ms: StdMutant[], target: string): usize {
  let n: usize = 0;
  for (const m of ms) {
    if (m.target == target) {
      n += 1;
    }
  }
  return n;
}

function names(ms: StdMutant[]): string {
  let out: string[] = [];
  for (const m of ms) {
    out.push(m.target + "/" + m.name);
  }
  return out.join(" ");
}

@Test
function theTableHasTheMutantsOfEveryModule(): void {
  const all = stdMutants();
  assertEqUsize(all.length, 205, "std mutants");
  assertEqUsize(countOf(all, "task_internal"), 16, "task_internal");
  assertEqUsize(countOf(all, "bytes"), 19, "bytes");
  assertEqUsize(countOf(all, "utf8"), 19, "utf8");
  assertEqUsize(countOf(all, "collections"), 37, "collections");
  assertEqUsize(countOf(all, "collections_internal"), 7, "collections_internal");
  assertEqUsize(countOf(all, "http"), 42, "http");
  assertEqUsize(countOf(all, "text"), 7, "text");
  assertEqUsize(countOf(all, "html"), 58, "html");
  assertEqUsize(netMutants().length, 10, "net mutants");
  assertEqString(all[0].target + "/" + all[0].name, "task_internal/ring-push-slot-ignores-head", "first mutant");
  assertEqString(netMutants()[0].name, "delimiterEnd-misses-delimiter-at-end", "first net mutant");
}

@Test
function everyMutantChangesSomethingAndHasAUniqueDirectory(): void {
  let seen: string[] = [];
  for (const m of stdMutants().concat(netMutants())) {
    assertEqBool(m.oldText.length > 0, true, "old text of " + m.name);
    assertEqBool(m.oldText != m.newText, true, "a change in " + m.name);
    const d = dirName(m);
    assertEqBool(seen.includes(d), false, "unique directory " + d);
    seen.push(d);
  }
}

@Test
function expectTrapTestsBelongToTheirMutants(): void {
  let extras: string[] = [];
  for (const m of stdMutants()) {
    if (m.extra != "") {
      extras.push(m.extra);
    }
  }
  assertEqUsize(extras.length, 6, "six mutants name an expect-trap test");
  assertEqString(extras[0], "utf8_ctor_rejects_invalid", "first");
  const needed = neededTests(stdMutants());
  assertEqBool(needed.includes("tests/std/spec_sorted.or"), true, "spec_sorted");
  assertEqBool(needed.includes("tests/std/expect_trap/http_limits_ctor_rejects_zero.or"), true, "an expect-trap test");
  assertEqBool(needed.includes("tests/std/http_prop_test.or"), true, "an extra test file");
  assertEqBool(needed.includes("tests/std/net_test.or"), false, "net is not a std module directory");
}

@Test
function shardsPartitionTheMutants(): void {
  const all = stdMutants();
  const a = selectShard(all, 1, 3);
  const b = selectShard(all, 2, 3);
  const c = selectShard(all, 3, 3);
  assertEqUsize(a.length + b.length + c.length, all.length, "together every mutant once");
  assertEqString(a[0].name, all[0].name, "shard 1 starts at the first");
  assertEqString(b[0].name, all[1].name, "shard 2 starts at the second");
  assertEqString(a[1].name, all[3].name, "every third one");
  assertEqUsize(selectShard(all, 1, 1).length, all.length, "1/1 is everything");
}

@Test
function selectionByModule(): void {
  const std = stdMutants();
  const net = netMutants();
  assertEqUsize(selectStd(std, net, "", 1, 1).length, 205, "no module: every std module, not net");
  assertEqUsize(selectStd(std, net, "http", 1, 1).length, 42, "http");
  assertEqUsize(selectStd(std, net, "http", 1, 3).length, 14, "http 1/3");
  assertEqUsize(selectStd(std, net, "http", 2, 3).length, 14, "http 2/3");
  assertEqUsize(selectStd(std, net, "net", 1, 1).length, 10, "net");
  assertEqUsize(selectStd(std, net, "nothing", 1, 1).length, 0, "an unknown module selects nothing");
  // shards of http are taken from the http mutants alone
  assertEqString(selectStd(std, net, "http", 2, 3)[0].target, "http", "target");
}

@Test
function testFilesOfAModule(): void {
  assertEqString(testFiles("bytes").join(","), "bytes_test", "default");
  assertEqString(testFiles("utf8").join(","), "utf8_test,utf8_dfa_test", "extra tests follow");
  assertEqString(testFiles("collections").join(","), "collections_test,sorted_btree_test,collections_generic_test", "collections");
  assertEqString(testFiles("http").join(","), "http_reject_test,http_test,http_split_test,http_prop_test", "http order");
  assertEqBool(isEarlyExit("http"), true, "http stops at the first killing test file");
  assertEqBool(isEarlyExit("html"), false, "html runs all");
}

@Test
function importsOfTheStdModulesBecomeRelative(): void {
  assertEqString(rewriteImports("import { a } from \"std:bytes\";\nimport { b } from \"std:test\";"),
    "import { a } from \"./bytes\";\nimport { b } from \"std:test\";", "only the mutated modules");
  assertEqString(rewriteImports("\"std:task/internal\" \"std:ox\" \"std:html\""), "\"./task_internal\" \"./ox\" \"./html\"", "task/internal ox html");
  assertEqString(
    rewriteImports("import { transferCount } from \"std:fsraw\";\nx"),
    "function transferCount(which: usize): usize { return 0; }\nx",
    "the fsraw import of task_internal becomes a stub",
  );
  assertEqString(rewriteImports("\"std:net\""), "\"std:net\"", "net stays");
  assertEqString(rewriteImports("std:bytes"), "std:bytes", "quotes delimit the name");
}

@Test
function resultLinesHaveTheFixedFormat(): void {
  const r = Row { target: "task_internal", name: "ring-push-slot-ignores-head", status: "killed by tests", fails1: 2, viol: 0, fails2: 2 };
  assertEqString(rowLine(r),
    "task_internal ring-push-slot-ignores-head          killed by tests      tests failing:  2 (contract traps  0); without contracts:  2",
    "columns");
  const big = Row { target: "html", name: "x", status: "SURVIVED", fails1: 100, viol: 12, fails2: 0 };
  assertEqString(rowLine(big),
    "html         x                                    SURVIVED             tests failing: 100 (contract traps 12); without contracts:  0",
    "wide numbers");
}

@Test
function summaryPerModuleInOrderOfAppearance(): void {
  const rows = [
    Row { target: "b", name: "1", status: "killed by contract", fails1: 1, viol: 1, fails2: 1 },
    Row { target: "a", name: "2", status: "killed by tests", fails1: 1, viol: 0, fails2: 0 },
    Row { target: "b", name: "3", status: "SURVIVED", fails1: 0, viol: 0, fails2: 0 },
    Row { target: "b", name: "4", status: "killed by tests", fails1: 2, viol: 0, fails2: 2 }
  ];
  const s = summaryLines(rows);
  assertEqUsize(s.length, 2, "two modules");
  assertEqString(s[0], "b: 3 mutants, 2 killed (1 with a contract violation), 2 killed without contracts", "b first");
  assertEqString(s[1], "a: 1 mutants, 1 killed (0 with a contract violation), 0 killed without contracts", "a");
}

@Test
function mutantNamesAreListedInOrder(): void {
  const first = selectStd(stdMutants(), netMutants(), "task", 1, 1);
  assertEqUsize(first.length, 16, "task");
  assertEqBool(names(first).startsWith("task_internal/ring-push-slot-ignores-head task_internal/ring-push-forgets-len"), true, "table order");
}
