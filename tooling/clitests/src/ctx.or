// The context of one suite: the work directory, the check log and the way to run the compiler under test. The language
// has no API that captures the output of a child process (`std:io` has `shell` and `shellTimeout`), so every run
// redirects stdout and stderr to files of the work directory and reads them back. A mutating method needs a `let`
// receiver and the checks are spread over many helper functions that only receive the context, so the context is
// immutable and its state (the check log) lives in a file, like the module globals of the Python scripts.

import { FsGrant, readFile, withFile, Append, exists } from "std:fs";
import { ProcessGrant } from "std:process";
import { shell } from "std:io";
import { shq, strip } from "./text";

// True when `path` exists; a path the grant refuses to look at counts as absent.
export function existsOr(fs: FsGrant, path: string): bool {
  const r = exists(fs, path);
  return r.isOk() && r.unwrap();
}

// Exit status 0..255 of the command, -1 when it could not be run (the tool keeps statuses as data).
export function shellStatus(p: ProcessGrant, cmd: string): int {
  const r = shell(p, cmd);
  return r.isOk() ? r.unwrap() : 0 - 1;
}

// The outcome of one run: exit status (0..255), stdout, stderr.
export type Ran = { rc: int; out: string; err: string; };

export type Totals = { checks: int; failures: int; };

export function readText(fs: FsGrant, path: string): string {
  const r = readFile(fs, path);
  return r.isOk() ? r.unwrap() : "";
}

// `mktemp -d` with a prefix (the `tempfile.mkdtemp` of the Python scripts); "" on failure. `note` is a scratch file.
export function makeTemp(fs: FsGrant, proc: ProcessGrant, prefix: string, note: string): string {
  if (shellStatus(proc, "mktemp -d \"${TMPDIR:-/tmp}/" + prefix + "XXXXXX\" > " + shq(note)) != 0) {
    return "";
  }
  let p = strip(readText(fs, note));
  while (p.includes("//")) {
    p = p.split("//").join("/");
  }
  return p;
}

export class Ctx {
  dir: string;      // private work directory (output files, check log)
  root: string;     // repository root, absolute

  constructor(dir: string, root: string) {
    this.dir = dir;
    this.root = root;
  }

  // check(cond, what): the `check` of test_osig.py. Prints `FAIL: <what>` and logs the outcome.
  check(fs: FsGrant, cond: bool, what: string): void {
    withFile(fs, this.dir + "/log", Append, f => { f.write(cond ? "ok\n" : "FAIL\n"); });
    if (!cond) {
      console.log("FAIL: " + what);
    }
  }

  totals(fs: FsGrant): Totals {
    let checks = 0;
    let failures = 0;
    for (const line of readText(fs, this.dir + "/log").split("\n")) {
      if (line == "ok") {
        checks += 1;
      } else if (line == "FAIL") {
        checks += 1;
        failures += 1;
      }
    }
    return Totals { checks: checks, failures: failures };
  }

  // `subprocess.run([exe] + args, cwd=cwd)` with captured output.
  run(fs: FsGrant, proc: ProcessGrant, cwd: string, exe: string, args: string[]): Ran {
    let words: string[] = [shq(exe)];
    for (const a of args) {
      words.push(shq(a));
    }
    const o = this.dir + "/stdout";
    const e = this.dir + "/stderr";
    const rc = shellStatus(proc, "cd " + shq(cwd) + " && " + words.join(" ") + " > " + shq(o) + " 2> " + shq(e));
    return Ran { rc: rc, out: readText(fs, o), err: readText(fs, e) };
  }
}
