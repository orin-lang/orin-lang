// std:net/internal -- helpers behind std:net (ADR-0048 rule 7.3). NOT API: user code does not import this module.
//
// Pure helpers without a handle: the wait clamp and the text scanners. They can change in any release.

// The longest single wait of any call of std:net: one hour, in milliseconds.
export const MAX_MS: int = 3600000;

// clampMs(ms): int -- `ms` limited to 0 .. MAX_MS. O(1).
@Ensures(result >= 0 && result <= MAX_MS)
@Ensures(ms >= 0 && ms <= MAX_MS ==> result == ms)
export function clampMs(ms: int): int {
  if (ms < 0) {
    return 0;
  }
  return ms > MAX_MS ? MAX_MS : ms;
}

// waitUntilMs(now, end): int -- the wait left at `now` until the absolute deadline `end` (both monotonic millis): 0 when it
// has passed, at most one hour. O(1).
@Ensures(result >= 0 && result <= MAX_MS)
export function waitUntilMs(now: int, end: int): int {
  return clampMs(end - now);
}

// portDigits(text, start): Result<int, usize> -- the decimal port in text[start, end): 1 to 5 digits, 0 .. 65535. Err holds the
// byte offset of the offending byte (`start` when it is empty or too large). O(length).
@Ensures(result.isOk() ==> result.unwrap() >= 0 && result.unwrap() <= 65535)
export function portDigits(text: string, start: usize): Result<int, usize> {
  if (start >= text.length) {
    return Err(start);
  }
  let v: int = 0;
  let i = start;
  while (i < text.length) {
    const c = text.charCodeAt(i);
    if (c < 48 || c > 57) {
      return Err(i);
    }
    v = v * 10 + (c - 48);
    if (v > 65535) {
      return Err(start);
    }
    i += 1;
  }
  return Ok(v);
}

// splitLines(text): string[] -- the non-empty lines of `text` (separated by LF). O(length).
export function splitLines(text: string): string[] {
  let out: string[] = [];
  let start: usize = 0;
  let i: usize = 0;
  while (i < text.length) {
    if (text.charCodeAt(i) == 10) {
      if (i > start) {
        out.push(text.substring(start, i));
      }
      start = i + 1;
    }
    i += 1;
  }
  return out;
}
