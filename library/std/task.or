// std:task -- structured concurrency with isolated tasks (ADR-0017 stage 0; docs/concurrency.md).
//
// UNSTABLE until the concurrency freeze. The whole library is Orin. Only the primitives under it are C: the L0 thread and
// monitor operations (runtime/platform/orin_platform.h) and the transfer / task-start functions of the temporary runtime interface
// `orin_rt_*` (runtime/core/orin_runtime.c, to move to Orin in R3). Nothing in this file is trusted beyond what the compiler
// checks: the scheduler bookkeeping (the scope's task table), the channel buffers, the join results and the panic
// propagation are ordinary Orin with invariants and contracts.
//
// MODEL. A task is an operating-system thread with its own heap. A value that crosses from one task to another (a
// captured variable of a task body, a result, a message) is MOVED when it is uniquely owned (every reference in it has
// count 1: no copy is made) and deep-copied otherwise; to the program both are a value copy. Reference counts stay
// non-atomic: no object is ever reachable from two tasks, so there is no shared mutable memory and no data race. The only
// state tasks share is a MONITOR: a lock-protected array of integers owned by the L0 layer. std:task keeps the task table of a
// scope in one and the buffer of a channel in one; a buffer holds transfer tokens, never values.
//
//   scope(s => {
//     const a = s.spawn(() => work(1));
//     const b = s.spawn(() => work(2));
//     return a.join() + b.join();
//   })
//
// * `scope(body)` runs `body(s)` and, before it returns, joins every task spawned in it whether or not the body joined it:
//   no task outlives its scope. If a task that nobody joined panicked, the scope panics (traps) after all tasks have ended.
// * `s.spawn(f)` starts `f` as a task; `h.join()` waits for it and returns its result. A panic (trap) in a task ends only
//   that task; `join` (or the end of the scope) turns it into a trap of the joining task with the message
//   `task panicked: <message>`. A panic is never lost silently. `spawn` is a method of the scope; `T` may be void.
// * `channel<T>(capacity)` makes a bounded channel; `ch.tx.send(v)` blocks while it is full, `ch.rx.recv()` blocks while it
//   is empty and returns `None` once the channel is closed and drained. `tx.close()` ends the stream, `rx.close()`
//   cancels it (a blocked or later `send` returns `Err(Closed)`). Each end can be copied and used by any number of tasks. Close both
//   ends to release the channel: after that any use of it traps.
// * Resource handles are not values: a task body cannot capture one (E0483). A grant is delegated with `spawnFs`,
//   `spawnProcess`, `spawnStdio` or `spawnClock`: the spawner derives a fresh grant with the same authority and MOVES it
//   into the task (the task owns it and revokes it when it ends, also when it panics) and the body receives it as a
//   parameter, like the body of a scope function of std:host. `spawnNet(s, net, body)` does the same for a NetGrant
//   (with `scopeNet` to carry the grant into the scope); an accepted connection is moved into a task by std:net
//   (`spawnAccepted`, or `acceptDetached` + a channel + `serveAccepted` for a bounded pool of workers; ADR-0017 Addendum C).
// * `parallelMap(xs, f, parts)` is DEPRECATED: use the `parallel()` pipeline of arrays (`map`) (data-parallel) or `forkJoin` (task-parallel).
//
// * Timed and wakeable waits (ADR-0017 Addendum B, C1). Every timed call has an ABSOLUTE form on a `Deadline` of std:time (an
//   instant on the monotonic clock, so retries and nested waits cannot stretch it) and a relative form that takes the
//   `ClockGrant` to read "now" (a deadline is the only thing that needs authority; waiting for one does not):
//   `rx.recvUntil(d)` / `rx.recvTimeout(clock, t)`, `tx.sendUntil(v, d)` / `tx.sendTimeout(clock, v, t)`,
//   `h.joinUntil(d)` / `h.joinTimeout(clock, t)`, `select(rxs)` / `selectUntil(rxs, d)` / `selectTimeout(clock, rxs, t)`,
//   `sleep(clock, t)` / `sleepUntil(d)`. A timed call returns `Result<_, TaskError>`: `Timeout` when the deadline passed
//   first, `Closed` when the channel is closed and drained (all of them, for `select`), `ClockUnavailable` / `InvalidDuration`
//   from the relative forms. A value that is there when the deadline passes is still delivered, never dropped.
//
// * Cancellation of network waits (ADR-0017 Addendum D, C3). Every scope owns a cancellation token (a wake source of L0); a task
//   is bound to the token of the scope it was spawned in, a nested scope's token is a child of the token of the task that opened
//   it. `s.cancel()` / `token.cancel()` sets the token (permanent, idempotent): every task of the scope blocked in a network wait
//   of std:net (accept, connect, recv, send) wakes at once with `Err(Cancelled)`, and so does every later network call of a
//   cancelled task, until the scope ends. `s.token()` is a copyable value a task may capture (a task cannot capture the Scope), and
//   `isCancelled()` is the cooperative check for long computations. A token kept after its scope ended is stale and harmless:
//   `cancel()` returns false and cannot cancel another scope that reuses the slot (generation-tagged handles). Waits on channels
//   (`recv`, `send`, `join`, `select`, `sleep`) do NOT observe the token yet (they are woken by their deadline or by the channel,
//   C2); a task that waits on a channel and on the network at once should use the deadline forms.
//
// Stage 0 has no `async` / `await`, no cancellation of channel waits other than `rx.close()` (scope cancellation is C2), no deadlock detection
// (all tasks blocked is a hang) and no work stealing: a task is a thread, so thousands are fine, hundreds of thousands are not.
// A panic in the BODY of a scope (not in a task) is not unwound: tasks still running keep running until the process ends.

import {
  Ledger, Ranges, ringCanPush, ringSlot, ringNextHead, ringIsDone, deadlineAfterMillis,
} from "std:task/internal";
import { Deadline, Duration, MonotonicInstant, monotonicNow } from "std:time";
import {
  FsGrant, ProcessGrant, StdioGrant, ClockGrant, NetGrant, grantAdoptNet, grantRevoke, grantClone,
  grantMove, grantAdoptFs, grantAdoptProcess, grantAdoptStdio, grantAdoptClock, monNew, monFree,
  monLock, monUnlock, monWait, monNotifyAll, monGet, monSet, monGrow, transitPut, transitTake,
  transitDrop, taskSpawn, taskJoin, taskMessage, taskTrap, monNotifyOne, parThreads, lendPut,
  monWaitUntil, taskWatch, wakeOpen, wakeClose, wakeSignal, wakeBind, wakeBound, wakeCheck,
} from "std:fsraw";

// ------------------------------------------------------------------------------------------------------ transfer

// The unit of transfer: a one-field record. Building it consumes the value (the runtime then moves a uniquely owned graph
// and copies a shared one); a task body, a result and a message all travel in one.
type Box<T> = { v: T; };

type Thunk = () => void;

// putBox<T>(v): the transfer token of `v`. A token is taken exactly once, by takeBox or dropped by transitDrop.
// The runtime publishes the box itself (no second box) when it is the only reference and its value moves; that needs
// the box released here, before the token is handed to another task: it dies at the end of this function, and every
// token travels through a monitor or a thread start afterwards. Keep the box a temporary of this function.
function putBox<T>(v: T): usize {
  return transitPut(Box<T> { v: v });
}

function takeBox<T>(tok: usize): T {
  const b: Box<T> = transitTake(tok);
  return b.v;
}

// ------------------------------------------------------------------------------------------------------ errors

// TaskErrorKind -- why a call of std:task returned no value (ADR-0048 section 3.1). Timeout = the deadline passed (outcome `Deadline` of std:task/internal),
// Closed = the channel is closed and drained (outcome `Closed`), ClockUnavailable = the monotonic clock failed, InvalidDuration =
// a negative timeout. `Sender.send` reports only `Closed`.
export type TaskErrorKind = Timeout | Closed | ClockUnavailable | InvalidDuration;

// TaskError -- the one error type of the module: `{ kind }`. Render it with `taskErrorMessage`.
export type TaskError = { kind: TaskErrorKind; };

// taskErrorMessage(e: TaskError): string -- a stable, nonempty explanation of `e`. Never fails; O(1).
@Ensures(result.length > 0)
export function taskErrorMessage(e: TaskError): string {
  return match (e.kind) {
    Timeout => "the deadline passed",
    Closed => "the channel is closed",
    ClockUnavailable => "monotonic clock unavailable",
    InvalidDuration => "a timeout must not be negative",
  };
}

function fail(kind: TaskErrorKind): TaskError {
  return TaskError { kind: kind };
}

// The absolute deadline `timeout` after now (saturating: a huge timeout means practically never).
function deadlineIn(clock: ClockGrant, timeout: Duration): Result<Deadline, TaskError> {
  if (timeout.millis < 0) {
    return Err(fail(InvalidDuration));
  }
  const now = monotonicNow(clock);
  if (now.isErr()) {
    return Err(fail(ClockUnavailable));
  }
  return Ok(Deadline {
    at: MonotonicInstant { millis: deadlineAfterMillis(now.unwrap().millis, timeout.millis) },
  });
}

// ------------------------------------------------------------------------------------------------------ channels

// Monitor words of a channel: [0] capacity, [1] head, [2] len, [3] flags (1 = tx closed, 2 = rx closed), [4] number of
// watchers (the wake monitors of `select` calls waiting on this channel), [5] room for watchers, [6 + i] the token in ring
// slot i, [6 + capacity + k] watcher k.
const CH_HDR: usize = 6;

// The channel functions work on the monitor's words as plain locals (cap, head, len, flags) with the arithmetic of
// std:task/internal's `Ring` (`ringCanPush`, `ringSlot`, ...): a `Ring` object per send / receive was 40% of the allocations
// of a channel benchmark. The words are loaded, changed and stored back inside one critical section, as before.
function chTx(flags: usize): bool {
  return flags % 2 == 1;
}

function chRx(flags: usize): bool {
  return flags >= 2;
}

// A monitor has two condition queues: 0 = "there is room" (blocked senders), 1 = "there is a value" (blocked receivers). A
// send wakes one receiver, a receive wakes one sender, a close wakes everybody.
function wakeAll(m: usize): void {
  monNotifyAll(m, 0);
  monNotifyAll(m, 1);
  pingWatchers(m);
}

// Wakes every `select` waiting on the channel (locked by the caller): bumps the ticket (word 0) of each watcher's monitor. Lock
// order is channel, then watcher; a selector never holds its watcher monitor while it takes a channel.
function pingWatchers(ch: usize): void {
  const n = monGet(ch, 4);
  const base = CH_HDR + monGet(ch, 0);
  let k: usize = 0;
  while (k < n) {
    const w = monGet(ch, base + k);
    monLock(w);
    monSet(w, 0, monGet(w, 0) + 1);
    monNotifyAll(w, 0);
    monUnlock(w);
    k += 1;
  }
}

// Takes the oldest value (the channel is locked, len > 0) and returns its token; the caller unlocks and calls takeBox.
function popLocked(ch: usize, cap: usize, head: usize, len: usize, flags: usize): usize {
  const tok = monGet(ch, CH_HDR + head);
  storeRing(ch, ringNextHead(cap, head), len - 1, flags);
  monNotifyOne(ch, 0);
  return tok;
}

function storeRing(m: usize, head: usize, len: usize, flags: usize): void {
  monSet(m, 1, head);
  monSet(m, 2, len);
  monSet(m, 3, flags);
}

// Sender<T> -- the sending end of a channel. A copy refers to the same channel. The monitor handle is private. The constructor is
// not for user code: obtain a Sender from channel(). (A monitor handle is never 0: a forged `new Sender<T>(0)` is a contract
// violation, and any other forged handle is refused by the platform layer at its first use. The language cannot hide a
// constructor yet.)
@Invariant(this.ch != 0)
export class Sender<T> {
  private ch: usize;

  // new Sender<T>(ch) -- not for user code: obtain a Sender from channel().
  @Requires(ch != 0)
  constructor(ch: usize) {
    this.ch = ch;
  }

  // send(v): Result<void, TaskError> -- hands `v` to the channel (moved if it is uniquely owned, copied otherwise) and returns
  // Ok(). Err(Closed) when the channel is closed by either end; `v` is then dropped, never lost silently. Blocks while the
  // channel is full. O(1) plus the transfer of `v`.
  send(v: T): Result<void, TaskError> {
    const tok = putBox<T>(v);
    const ch = this.ch;
    monLock(ch);
    const cap = monGet(ch, 0);
    let head = monGet(ch, 1);
    let len = monGet(ch, 2);
    let flags = monGet(ch, 3);
    while (!ringCanPush(len, cap, chTx(flags), chRx(flags)) && flags == 0) {
      monWait(ch, 0);
      head = monGet(ch, 1);
      len = monGet(ch, 2);
      flags = monGet(ch, 3);
    }
    if (!ringCanPush(len, cap, chTx(flags), chRx(flags))) {
      monUnlock(ch);
      transitDrop(tok);
      return Err(fail(Closed));
    }
    const slot = ringSlot(cap, head, len);
    monSet(ch, CH_HDR + slot, tok);
    storeRing(ch, head, len + 1, flags);
    monNotifyOne(ch, 1);
    pingWatchers(ch);
    monUnlock(ch);
    return Ok();
  }

  // sendUntil(v, deadline): Result<void, TaskError> -- send(v) that gives up when the absolute monotonic deadline passes while
  // the channel is full: Err(Timeout), or Err(Closed) when it is closed by either end. `v` is dropped on an error. A free slot
  // at the deadline still accepts it. Traps if the deadline is negative. Blocks until the deadline at most.
  @Requires(deadline.at.millis >= 0)
  sendUntil(v: T, deadline: Deadline): Result<void, TaskError> {
    const tok = putBox(v);
    const ch = this.ch;
    const dl = deadline.at.millis.toUsize();
    monLock(ch);
    const cap = monGet(ch, 0);
    let head = monGet(ch, 1);
    let len = monGet(ch, 2);
    let flags = monGet(ch, 3);
    let late = false;
    while (!ringCanPush(len, cap, chTx(flags), chRx(flags)) && flags == 0 && !late) {
      late = monWaitUntil(ch, 0, dl) == 1;
      head = monGet(ch, 1);
      len = monGet(ch, 2);
      flags = monGet(ch, 3);
    }
    if (!ringCanPush(len, cap, chTx(flags), chRx(flags))) {
      monUnlock(ch);
      transitDrop(tok);
      return Err(fail(flags != 0 ? Closed : Timeout));
    }
    const slot = ringSlot(cap, head, len);
    monSet(ch, CH_HDR + slot, tok);
    storeRing(ch, head, len + 1, flags);
    monNotifyOne(ch, 1);
    pingWatchers(ch);
    monUnlock(ch);
    return Ok();
  }

  // sendTimeout(clock, v, timeout): Result<void, TaskError> -- sendUntil(v, now + timeout). Err(InvalidDuration) for a negative
  // timeout, Err(ClockUnavailable) when the clock cannot be read. Blocks for `timeout` at most.
  sendTimeout(clock: ClockGrant, v: T, timeout: Duration): Result<void, TaskError> {
    const d = deadlineIn(clock, timeout)?;
    return this.sendUntil(v, d);
  }

  // close(): void -- no more values will be sent; receivers drain what is buffered and then get None. Idempotent. Releases the
  // channel when the receiving end is closed too (any later use then traps). O(waiters).
  close(): void {
    const ch = this.ch;
    monLock(ch);
    let flags = monGet(ch, 3);
    if (!chTx(flags)) {
      flags += 1;
    }
    monSet(ch, 3, flags);
    wakeAll(ch);
    const done = chTx(flags) && chRx(flags);
    monUnlock(ch);
    if (done) {
      monFree(ch);
    }
  }
}

// Receiver<T> -- the receiving end of a channel. A copy refers to the same channel (several receivers share the stream). The
// monitor handle is private. The constructor is not for user code: obtain a Receiver from channel().
@Invariant(this.ch != 0)
export class Receiver<T> {
  private ch: usize;

  // new Receiver<T>(ch) -- not for user code: obtain a Receiver from channel().
  @Requires(ch != 0)
  constructor(ch: usize) {
    this.ch = ch;
  }

  // recv(): Option<T> -- the oldest value, or None once the channel is closed and drained (or cancelled by rx.close()). Blocks
  // while the channel is empty. O(1) plus the transfer of the value.
  recv(): Option<T> {
    const ch = this.ch;
    monLock(ch);
    const cap = monGet(ch, 0);
    let head = monGet(ch, 1);
    let len = monGet(ch, 2);
    let flags = monGet(ch, 3);
    while (len == 0 && !ringIsDone(len, chTx(flags), chRx(flags))) {
      monWait(ch, 1);
      head = monGet(ch, 1);
      len = monGet(ch, 2);
      flags = monGet(ch, 3);
    }
    if (len == 0) {
      monUnlock(ch);
      return None;
    }
    const tok = monGet(ch, CH_HDR + head);
    storeRing(ch, ringNextHead(cap, head), len - 1, flags);
    monNotifyOne(ch, 0);
    monUnlock(ch);
    const v: T = takeBox(tok);
    return Some(v);
  }

  // recvUntil(deadline): Result<T, TaskError> -- recv() that gives up when the absolute monotonic deadline passes while the channel is empty:
  // Ok(value), Err(Timeout), or Err(Closed) once the channel is closed and drained. A value that is already there is
  // returned even if the deadline has passed. Traps if the deadline is negative.
  @Requires(deadline.at.millis >= 0)
  recvUntil(deadline: Deadline): Result<T, TaskError> {
    const ch = this.ch;
    const dl = deadline.at.millis.toUsize();
    monLock(ch);
    const cap = monGet(ch, 0);
    let head = monGet(ch, 1);
    let len = monGet(ch, 2);
    let flags = monGet(ch, 3);
    let late = false;
    while (len == 0 && !ringIsDone(len, chTx(flags), chRx(flags)) && !late) {
      late = monWaitUntil(ch, 1, dl) == 1;
      head = monGet(ch, 1);
      len = monGet(ch, 2);
      flags = monGet(ch, 3);
    }
    if (len == 0) {
      monUnlock(ch);
      return Err(fail(ringIsDone(len, chTx(flags), chRx(flags)) ? Closed : Timeout));
    }
    const tok = popLocked(ch, cap, head, len, flags);
    monUnlock(ch);
    const v: T = takeBox(tok);
    return Ok(v);
  }

  // recvTimeout(clock, timeout): Result<T, TaskError> -- recvUntil(now + timeout). Err(InvalidDuration) for a negative timeout,
  // Err(ClockUnavailable) when the clock cannot be read. Blocks for `timeout` at most.
  recvTimeout(clock: ClockGrant, timeout: Duration): Result<T, TaskError> {
    const d = deadlineIn(clock, timeout)?;
    return this.recvUntil(d);
  }

  // close(): void -- this end is done: buffered values are dropped, a blocked or later send returns Err(Closed). Idempotent.
  // Releases the channel when the sending end is closed too (any later use then traps). O(buffered values + waiters).
  close(): void {
    const ch = this.ch;
    monLock(ch);
    const cap = monGet(ch, 0);
    let head = monGet(ch, 1);
    let len = monGet(ch, 2);
    let flags = monGet(ch, 3);
    let toks: usize[] = [];
    while (len > 0) {
      toks.push(monGet(ch, CH_HDR + head));
      head = ringNextHead(cap, head);
      len -= 1;
    }
    if (!chRx(flags)) {
      flags += 2;
    }
    storeRing(ch, head, len, flags);
    wakeAll(ch);
    const done = chTx(flags) && chRx(flags);
    monUnlock(ch);
    for (const t of toks) {
      transitDrop(t);
    }
    if (done) {
      monFree(ch);
    }
  }

  // One monitor `w` (word 0 = a ticket) is registered with every channel; a send or close on any of them bumps the ticket and
  // notifies. The selector reads the ticket, scans the channels in order (the first with a value wins), and waits only while the
  // ticket is unchanged, so a send between the scan and the wait is never lost; it holds no monitor while it takes another. A
  // deadline `dl` < 0 means none.
  //
  // selectAmong(rxs, dl): Result<Selected<T>, TaskError> -- the body of select / selectUntil / selectTimeout. NOT for user code: it is
  // a method of Receiver only because the monitor handle is private to the class; call select(rxs) instead.
  selectAmong(rxs: Receiver<T>[], dl: int): Result<Selected<T>, TaskError> {
    const n = rxs.length;
    const w = monNew(1);
    let k: usize = 0;
    while (k < n) {
      watch(rxs[k].ch, w);
      k += 1;
    }
    let state = 0;
    let index: usize = 0;
    let tok: usize = 0;
    let late = false;
    while (state == 0) {
      monLock(w);
      const ticket = monGet(w, 0);
      monUnlock(w);
      let closed: usize = 0;
      let j: usize = 0;
      while (j < n && state == 0) {
        const ch = rxs[j].ch;
        monLock(ch);
        const cap = monGet(ch, 0);
        const head = monGet(ch, 1);
        const len = monGet(ch, 2);
        const flags = monGet(ch, 3);
        if (len > 0) {
          tok = popLocked(ch, cap, head, len, flags);
          index = j;
          state = 1;
        } else if (ringIsDone(len, chTx(flags), chRx(flags))) {
          closed += 1;
        }
        monUnlock(ch);
        j += 1;
      }
      if (state == 0 && closed == n) {
        state = 2;
      } else if (state == 0 && late) {
        state = 3;
      } else if (state == 0) {
        monLock(w);
        while (monGet(w, 0) == ticket && !late) {
          if (dl < 0) {
            monWait(w, 0);
          } else {
            late = monWaitUntil(w, 0, dl.toUsize()) == 1;
          }
        }
        monUnlock(w);
      }
    }
    k = 0;
    while (k < n) {
      unwatch(rxs[k].ch, w);
      k += 1;
    }
    monFree(w);
    if (state == 1) {
      const v: T = takeBox(tok);
      return Ok(Selected<T> { index: index, value: v });
    }
    return Err(fail(state == 2 ? Closed : Timeout));
  }
}

// Channel<T> -- the two ends of a channel: `{ tx, rx }`.
export type Channel<T> = { tx: Sender<T>; rx: Receiver<T>; };

// channel<T>(capacity: usize): Channel<T> -- a bounded channel of at least one slot; both ends refer to the same channel. A
// capacity of 0 (rendezvous) is not supported in stage 0: E0482 for a constant, a trap otherwise (also without contract
// checking). O(capacity).
@Requires(capacity >= 1)
export function channel<T>(capacity: usize): Channel<T> {
  if (capacity == 0) {
    taskTrap("channel capacity must be at least 1");
  }
  const m = monNew(CH_HDR + capacity);
  monLock(m);
  monSet(m, 0, capacity);
  monUnlock(m);
  return Channel<T> { tx: new Sender<T>(m), rx: new Receiver<T>(m) };
}

// ------------------------------------------------------------------------------------------------------ select, sleep

// Selected<T> -- the result of a `select`: which receiver (position in the array) delivered, and the value.
export type Selected<T> = { index: usize; value: T; };

// Registers the wake monitor `w` of a select with the channel (and removes it again).
function watch(ch: usize, w: usize): void {
  monLock(ch);
  const base = CH_HDR + monGet(ch, 0);
  const n = monGet(ch, 4);
  const room = monGet(ch, 5);
  if (n == room) {
    const grown = room == 0 ? 2 : room * 2;
    monGrow(ch, base + grown);
    monSet(ch, 5, grown);
  }
  monSet(ch, base + n, w);
  monSet(ch, 4, n + 1);
  monUnlock(ch);
}

function unwatch(ch: usize, w: usize): void {
  monLock(ch);
  const base = CH_HDR + monGet(ch, 0);
  const n = monGet(ch, 4);
  let k: usize = 0;
  while (k < n) {
    if (monGet(ch, base + k) == w) {
      monSet(ch, base + k, monGet(ch, base + n - 1));
      monSet(ch, 4, n - 1);
      k = n;
    } else {
      k += 1;
    }
  }
  monUnlock(ch);
}

// select(rxs): Result<Selected<T>, TaskError> -- waits until one of the receivers has a value and returns its position and the value
// (the first ready receiver in array order wins a tie). Receivers that are closed and drained are skipped; Err(Closed) when all of
// them are. The receivers must carry one value type (use a variant for different kinds). Traps on an empty array. Blocks until a
// value arrives or all channels end. O(n) per wake-up for n receivers.
@Requires(rxs.length >= 1)
export function select<T>(rxs: Receiver<T>[]): Result<Selected<T>, TaskError> {
  return rxs[0].selectAmong(rxs, -1);
}

// selectUntil(rxs, deadline): Result<Selected<T>, TaskError> -- select that gives up with Err(Timeout) when the absolute monotonic
// deadline passes first. A value that is already there is delivered even if the deadline has passed. Traps if the deadline is
// negative or `rxs` is empty. Blocks until the deadline at most.
@Requires(rxs.length >= 1 && deadline.at.millis >= 0)
export function selectUntil<T>(
  rxs: Receiver<T>[],
  deadline: Deadline,
): Result<Selected<T>, TaskError> {
  return rxs[0].selectAmong(rxs, deadline.at.millis);
}

// selectTimeout(clock, rxs, timeout): Result<Selected<T>, TaskError> -- selectUntil(rxs, now + timeout). Err(InvalidDuration) for a
// negative timeout, Err(ClockUnavailable) when the clock cannot be read. Traps on an empty array. Blocks for `timeout` at most.
@Requires(rxs.length >= 1)
export function selectTimeout<T>(
  clock: ClockGrant,
  rxs: Receiver<T>[],
  timeout: Duration,
): Result<Selected<T>, TaskError> {
  const d = deadlineIn(clock, timeout)?;
  return rxs[0].selectAmong(rxs, d.at.millis);
}

// sleepUntil(deadline): void -- blocks until the absolute monotonic deadline has passed (at least that long: never early; returns
// at once when it has passed). Traps if the deadline is negative. Blocks the calling task.
@Requires(deadline.at.millis >= 0)
export function sleepUntil(deadline: Deadline): void {
  const m = monNew(1);
  monLock(m);
  let late = false;
  while (!late) {
    late = monWaitUntil(m, 0, deadline.at.millis.toUsize()) == 1;
  }
  monUnlock(m);
  monFree(m);
}

// sleep(clock, timeout): Result<void, TaskError> -- blocks for at least `timeout` on the monotonic clock. Err(InvalidDuration) for
// a negative timeout, Err(ClockUnavailable) when the clock cannot be read. Blocks the calling task.
export function sleep(clock: ClockGrant, timeout: Duration): Result<void, TaskError> {
  const d = deadlineIn(clock, timeout)?;
  sleepUntil(d);
  return Ok();
}

// ------------------------------------------------------------------------------------------------------ scopes

const LG_HDR: usize = 5;
const LG_WAKE: usize = 4; // header word of the scope's cancellation token (0 = none: the table was full or the nesting too deep)
const LG_STRIDE: usize = 3;
const LG_FIRST: usize = 8;

function loadLedger(m: usize): Ledger {
  return new Ledger(monGet(m, 0), monGet(m, 1), monGet(m, 2) == 1);
}

// First word of the entry of task i.
function entry(i: usize): usize {
  return LG_HDR + LG_STRIDE * i;
}

// The cancellation token of the scope whose task table is `tab`; traps when it has none.
function scopeWake(tab: usize): usize {
  monLock(tab);
  const w = monGet(tab, LG_WAKE);
  monUnlock(tab);
  if (w == 0) {
    taskTrap("this scope has no cancellation token (token table full or scopes nested too deep)");
  }
  return w;
}

// CancelToken -- a copyable value that cancels the scope it came from (`Scope.token()`), also from another task. It holds a
// generation-tagged handle of L0: after the scope ended it is stale, `cancel()` then does nothing and `isCancelled()` is false.
// The constructor is not for user code: obtain a token from `Scope.token()`.
@Invariant(this.wake >= 0)
export class CancelToken {
  private wake: usize;

  // new CancelToken(wake) -- not for user code: obtain a token from Scope.token().
  constructor(wake: usize) {
    this.wake = wake;
  }

  // cancel(): bool -- sets the token. Returns true when this call cancelled it, false when it was cancelled already or is stale.
  // Waits of std:net observing the token (the scope's tasks, and the tasks of scopes nested in them) return `Err(Cancelled)`. O(1).
  cancel(): bool {
    return wakeSignal(this.wake) == 1;
  }

  // isCancelled(): bool -- the token or an ancestor scope's token is set. False for a stale token. O(depth).
  isCancelled(): bool {
    return wakeCheck(this.wake) == 1;
  }
}

// isCancelled(): bool -- the calling task's own token, or an ancestor's, is set: it should stop at its next convenient point. A task
// that is not inside any scope is never cancelled. O(depth).
export function isCancelled(): bool {
  return wakeCheck(wakeBound()) == 1;
}

// Scope -- the handle of a task table. `scope` makes one and passes it to its body; it is valid only until `scope` returns. The
// table handle is private; the constructor is not for user code: obtain a Scope from scope() and its variants.
@Invariant(this.tab != 0)
export class Scope {
  private tab: usize;

  // new Scope(tab) -- not for user code: obtain a Scope from scope(), scopeFs(), ...
  @Requires(tab != 0)
  constructor(tab: usize) {
    this.tab = tab;
  }

  // spawn<T>(f): TaskHandle<T> -- starts `f` as a task of the scope and returns its handle; T may be void (ADR-0040). `f` and
  // everything it captures move to the task (unique values) or are copied to it; the task cannot affect the spawner's values. A
  // body that captures a resource handle is E0483, one that captures a `Scope` is E0481. Traps when the scope has ended or no
  // thread can be started. O(1) plus starting a thread and the transfer of the captures.
  spawn<T>(f: () => T): TaskHandle<T> {
    const res = monNew(2);
    monLock(this.tab);
    const own = monGet(this.tab, LG_WAKE);
    monUnlock(this.tab);
    const wake = own != 0 ? own : wakeBound(); // a scope without a token of its own passes the spawner's on
    const body: Thunk = () => runTask(f, wake, res);
    const tok = putBox(body);
    monLock(this.tab);
    let lg = loadLedger(this.tab);
    if (lg.closed) {
      monUnlock(this.tab);
      transitDrop(tok);
      monFree(res);
      taskTrap("spawn in a scope that has ended");
    }
    const idx = lg.add();
    const need = entry(idx) + LG_STRIDE;
    const have = monGet(this.tab, 3);
    if (need > have) {
      monGrow(this.tab, have * 2);
      monSet(this.tab, 3, have * 2);
    }
    monSet(this.tab, 0, lg.count);
    monSet(this.tab, entry(idx), 0);
    monSet(this.tab, entry(idx) + 1, res);
    monSet(this.tab, entry(idx) + 2, 0);
    monUnlock(this.tab);
    const th = taskSpawn(tok);
    monLock(this.tab);
    monSet(this.tab, entry(idx), th);
    monNotifyAll(this.tab, 0);
    monUnlock(this.tab);
    return new TaskHandle<T>(this.tab, idx, res);
  }

  // token(): CancelToken -- the scope's cancellation token, to hand to tasks (`s.spawn(() => ... token.cancel() ...)`). Traps if
  // the scope has none (the token table is full, or scopes are nested more than 32 deep). O(1).
  token(): CancelToken {
    return new CancelToken(scopeWake(this.tab));
  }

  // cancel(): bool -- `token().cancel()`: true when this call cancelled the scope. Traps if the scope has no token. O(1).
  cancel(): bool {
    return wakeSignal(scopeWake(this.tab)) == 1;
  }

  // isCancelled(): bool -- the scope's token (or an ancestor's) is set. Traps if the scope has no token. O(depth).
  isCancelled(): bool {
    return wakeCheck(scopeWake(this.tab)) == 1;
  }
}

// TaskHandle<T> -- a started task. `join` may be called once; a second call, or a call after the scope has ended, traps. The table
// and result handles are private; the constructor is not for user code: obtain a handle from spawn().
@Invariant(this.tab != 0 && this.res != 0)
export class TaskHandle<T> {
  private tab: usize;
  private idx: usize;
  private res: usize;

  // new TaskHandle<T>(tab, idx, res) -- not for user code: obtain a handle from Scope.spawn().
  @Requires(tab != 0 && res != 0)
  constructor(tab: usize, idx: usize, res: usize) {
    this.tab = tab;
    this.idx = idx;
    this.res = res;
  }

  // join(): T -- waits for the task and returns its result. If the task panicked, traps with `task panicked: <message>`. Traps if
  // the handle was joined before. Blocks until the task ends.
  join(): T {
    monLock(this.tab);
    const st = monGet(this.tab, entry(this.idx) + 2);
    if (st != 0) {
      monUnlock(this.tab);
      taskTrap("task joined twice (or after the end of its scope)");
    }
    monSet(this.tab, entry(this.idx) + 2, 1);
    const th = monGet(this.tab, entry(this.idx));
    monUnlock(this.tab);
    const status = taskJoin(th);
    if (status != 0) {
      monFree(this.res);
      taskTrap("task panicked: " + taskMessage());
    }
    monLock(this.res);
    const tok = monGet(this.res, 0);
    monUnlock(this.res);
    monFree(this.res);
    return takeBox<T>(tok);
  }

  // joinUntil(deadline): Result<T, TaskError> -- waits for the task until the absolute monotonic deadline. Err(Timeout) if it has
  // not ended by then (the handle stays valid: join or joinUntil it again); otherwise exactly `join()` (a panic of the task is a
  // trap of the joiner). Traps if the deadline is negative, or the handle was joined before. Blocks until the deadline at most.
  @Requires(deadline.at.millis >= 0)
  joinUntil(deadline: Deadline): Result<T, TaskError> {
    const dl = deadline.at.millis.toUsize();
    monLock(this.res);
    let late = false;
    while (monGet(this.res, 1) == 0 && !late) {
      late = monWaitUntil(this.res, 0, dl) == 1;
    }
    const ended = monGet(this.res, 1) != 0;
    monUnlock(this.res);
    if (!ended) {
      return Err(fail(Timeout));
    }
    return Ok(this.join());
  }

  // joinTimeout(clock, timeout): Result<T, TaskError> -- joinUntil(now + timeout). Err(InvalidDuration) for a negative timeout,
  // Err(ClockUnavailable) when the clock cannot be read. Blocks for `timeout` at most.
  joinTimeout(clock: ClockGrant, timeout: Duration): Result<T, TaskError> {
    const d = deadlineIn(clock, timeout)?;
    return this.joinUntil(d);
  }

  // tryJoinTask(): Option<T> -- join() that returns None instead of trapping when the task panicked (its message is then
  // `taskMessage()`). A second join still traps. NOT for user code: it is a method only because the handle fields are private; it
  // serves the fork/join pool below. (`join` keeps its own copy of these lines so that programs that do not use the fork/join
  // pool compile to the same code as before the pool was added.)
  tryJoinTask(): Option<T> {
    monLock(this.tab);
    const st = monGet(this.tab, entry(this.idx) + 2);
    if (st != 0) {
      monUnlock(this.tab);
      taskTrap("task joined twice (or after the end of its scope)");
    }
    monSet(this.tab, entry(this.idx) + 2, 1);
    const th = monGet(this.tab, entry(this.idx));
    monUnlock(this.tab);
    const status = taskJoin(th);
    if (status != 0) {
      monFree(this.res);
      return None;
    }
    monLock(this.res);
    const tok = monGet(this.res, 0);
    monUnlock(this.res);
    monFree(this.res);
    const v: T = takeBox<T>(tok);
    return Some(v);
  }
}

// What a task does, as the runtime runs it: compute, publish the result in the result monitor. Result monitor words: [0] the token
// of the result, [1] 1 once the task has ended (by return or trap; set by the runtime, taskWatch), which `joinUntil` waits for.
function runTask<T>(f: () => T, wake: usize, res: usize): void {
  wakeBind(wake);
  taskWatch(res);
  const r = f();
  const tok = putBox<T>(r);
  monLock(res);
  monSet(res, 0, tok);
  monUnlock(res);
}

// spawn(s, f): TaskHandle<T> -- the function form of `s.spawn(f)`; see Scope.spawn for errors and cost.
@Deprecated("use s.spawn(f)")
export function spawn<T>(s: Scope, f: () => T): TaskHandle<T> {
  return s.spawn(f);
}

// spawnDo(s, f): TaskHandle<bool> -- spawn for a body that returns nothing; join() then returns true. See Scope.spawn for errors and cost.
@Deprecated("use s.spawn(f), which accepts a void body (TaskHandle<void>)")
export function spawnDo(s: Scope, f: () => void): TaskHandle<bool> {
  return s.spawn(() => {
    f();
    return true;
  });
}

// Joins every task of the table that nobody joined, closes the table and returns "" or the message of the first panic.
function drain(tab: usize): string {
  let failure = "";
  let more = true;
  while (more) {
    monLock(tab);
    let lg = loadLedger(tab);
    if (lg.isScanned()) {
      lg.close();
      monSet(tab, 2, 1);
      monUnlock(tab);
      more = false;
    } else {
      const e = entry(lg.cursor);
      const claimed = monGet(tab, e + 2) != 0;
      const th = monGet(tab, e);
      if (claimed) {
        lg.advance();
        monSet(tab, 1, lg.cursor);
        monUnlock(tab);
      } else if (th == 0) {
        monWait(tab, 0);
        monUnlock(tab);
      } else {
        const res = monGet(tab, e + 1);
        monSet(tab, e + 2, 1);
        lg.advance();
        monSet(tab, 1, lg.cursor);
        monUnlock(tab);
        const status = taskJoin(th);
        if (status != 0) {
          if (failure == "") {
            failure = taskMessage();
          }
        } else {
          monLock(res);
          const tok = monGet(res, 0);
          monUnlock(res);
          transitDrop(tok);
        }
        monFree(res);
      }
    }
  }
  return failure;
}

// begin(): a new, empty task table.
@Ensures(result != 0)
function begin(): usize {
  const tab = monNew(LG_FIRST * LG_STRIDE);
  const w = wakeOpen(); // binds the new token to this thread: the body of the scope observes it too
  monLock(tab);
  monSet(tab, 3, LG_FIRST * LG_STRIDE);
  monSet(tab, LG_WAKE, w);
  monUnlock(tab);
  return tab;
}

// finish(tab): joins every task of the table, frees it, and panics if a task nobody joined panicked.
function finish(tab: usize): void {
  const failure = drain(tab);
  monLock(tab);
  const w = monGet(tab, LG_WAKE);
  monUnlock(tab);
  if (w != 0) {
    wakeClose(w); // every task has ended: nothing waits on the token any more; the thread is bound to the enclosing token again
  }
  monFree(tab);
  if (failure != "") {
    taskTrap("task panicked: " + failure);
  }
}

// scope(body): R -- runs `body` with a new scope and returns its result after every task spawned in the scope has ended. Traps
// (after all tasks have ended) if a task nobody joined panicked; see the header comment for panics. Blocks until every task of
// the scope has ended.
export function scope<R>(body: (s: Scope) => R): R {
  const tab = begin();
  const r = body(new Scope(tab));
  finish(tab);
  return r;
}

// scopeFs(fs, body): R -- `scope` for a body that also uses a grant. A closure cannot capture a grant (E0452), so the grant is
// passed through: the body gets it back as a second parameter (the same shape as `withFileFs` of std:fs). Use it with spawnFs.
// Errors and blocking as for scope. scopeProcess, scopeStdio, scopeClock and scopeNet below are the same for the other grants.
export function scopeFs<R>(fs: FsGrant, body: (s: Scope, g: FsGrant) => R): R {
  const tab = begin();
  const r = body(new Scope(tab), fs);
  finish(tab);
  return r;
}

// scopeProcess(proc, body): R -- `scope` carrying a ProcessGrant; see scopeFs. Use it with spawnProcess.
export function scopeProcess<R>(proc: ProcessGrant, body: (s: Scope, g: ProcessGrant) => R): R {
  const tab = begin();
  const r = body(new Scope(tab), proc);
  finish(tab);
  return r;
}

// scopeStdio(stdio, body): R -- `scope` carrying a StdioGrant; see scopeFs. Use it with spawnStdio.
export function scopeStdio<R>(stdio: StdioGrant, body: (s: Scope, g: StdioGrant) => R): R {
  const tab = begin();
  const r = body(new Scope(tab), stdio);
  finish(tab);
  return r;
}

// scopeClock(clock, body): R -- `scope` carrying a ClockGrant; see scopeFs. Use it with spawnClock.
export function scopeClock<R>(clock: ClockGrant, body: (s: Scope, g: ClockGrant) => R): R {
  const tab = begin();
  const r = body(new Scope(tab), clock);
  finish(tab);
  return r;
}

// scopeNet(net, body): R -- `scope` for a body that also uses a NetGrant (ADR-0017 Addendum C), for spawnNet and for a server that
// binds a listener inside the scope (`useListener(g, ..)`) and hands accepted connections to tasks. Errors and blocking as for scope.
export function scopeNet<R>(net: NetGrant, body: (s: Scope, g: NetGrant) => R): R {
  const tab = begin();
  const r = body(new Scope(tab), net);
  finish(tab);
  return r;
}

// scopeDo(body), scopeFsDo, ...: the old flavours for a body that returns nothing. `scope` and `scopeFs` ... accept a void
// body now (ADR-0040); these wrappers stay one release.
@Deprecated("use scope(body) with a void body")
export function scopeDo(body: (s: Scope) => void): void {
  scope(body);
}

@Deprecated("use scopeFs(fs, body) with a void body")
export function scopeFsDo(fs: FsGrant, body: (s: Scope, g: FsGrant) => void): void {
  scopeFs(fs, body);
}

@Deprecated("use scopeProcess(proc, body) with a void body")
export function scopeProcessDo(
  proc: ProcessGrant,
  body: (s: Scope, g: ProcessGrant) => void,
): void {
  scopeProcess(proc, body);
}

@Deprecated("use scopeStdio(stdio, body) with a void body")
export function scopeStdioDo(stdio: StdioGrant, body: (s: Scope, g: StdioGrant) => void): void {
  scopeStdio(stdio, body);
}

@Deprecated("use scopeNet(net, body) with a void body")
export function scopeNetDo(net: NetGrant, body: (s: Scope, g: NetGrant) => void): void {
  scopeNet(net, body);
}

@Deprecated("use scopeClock(clock, body) with a void body")
export function scopeClockDo(clock: ClockGrant, body: (s: Scope, g: ClockGrant) => void): void {
  scopeClock(clock, body);
}

// ------------------------------------------------------------------------------------------------------ delegating grants
//
// A grant is a resource handle (ADR-0025, ADR-0027): it is only ever a parameter, never a captured or sent value. To give
// authority to a task, the spawner DERIVES a grant of the same family (never more authority than its own: same scope, same
// flags), MOVES it into the task, and the task's wrapper adopts it, passes it to the body as a parameter and revokes it
// when the body returns (the runtime also revokes it if the task panics). The compiler checks both halves: the derived handle
// is moved exactly once on every path of the spawner (the MIR verifier's closer rule), and the adopted one is revoked
// exactly once on every path of the task wrapper. The spawner's own grant is untouched.

function runFs<T>(tok: usize, body: (g: FsGrant) => T): T {
  const g = grantAdoptFs(tok);
  const r = body(g);
  grantRevoke(g);
  return r;
}

function runProcess<T>(tok: usize, body: (g: ProcessGrant) => T): T {
  const g = grantAdoptProcess(tok);
  const r = body(g);
  grantRevoke(g);
  return r;
}

function runStdio<T>(tok: usize, body: (g: StdioGrant) => T): T {
  const g = grantAdoptStdio(tok);
  const r = body(g);
  grantRevoke(g);
  return r;
}

function runClock<T>(tok: usize, body: (g: ClockGrant) => T): T {
  const g = grantAdoptClock(tok);
  const r = body(g);
  grantRevoke(g);
  return r;
}

function runNet<T>(tok: usize, body: (g: NetGrant) => T): T {
  const g = grantAdoptNet(tok);
  const r = body(g);
  grantRevoke(g);
  return r;
}

// spawnFs(s, fs, body): TaskHandle<T> -- a task whose body gets a file-system grant of the authority of `fs`, owned by the task
// (revoked when the body returns or traps). Errors and cost as for Scope.spawn. spawnProcess, spawnStdio, spawnClock and spawnNet are
// the same for the other grants.
export function spawnFs<T>(s: Scope, fs: FsGrant, body: (g: FsGrant) => T): TaskHandle<T> {
  const c = grantClone(fs);
  const tok = grantMove(c);
  return s.spawn(() => runFs(tok, body));
}

// spawnProcess(s, proc, body): TaskHandle<T> -- spawnFs for a ProcessGrant.
export function spawnProcess<T>(
  s: Scope,
  proc: ProcessGrant,
  body: (g: ProcessGrant) => T,
): TaskHandle<T> {
  const c = grantClone(proc);
  const tok = grantMove(c);
  return s.spawn(() => runProcess(tok, body));
}

// spawnStdio(s, stdio, body): TaskHandle<T> -- spawnFs for a StdioGrant.
export function spawnStdio<T>(
  s: Scope,
  stdio: StdioGrant,
  body: (g: StdioGrant) => T,
): TaskHandle<T> {
  const c = grantClone(stdio);
  const tok = grantMove(c);
  return s.spawn(() => runStdio(tok, body));
}

// spawnClock(s, clock, body): TaskHandle<T> -- spawnFs for a ClockGrant.
export function spawnClock<T>(
  s: Scope,
  clock: ClockGrant,
  body: (g: ClockGrant) => T,
): TaskHandle<T> {
  const c = grantClone(clock);
  const tok = grantMove(c);
  return s.spawn(() => runClock(tok, body));
}

// spawnNet(s, net, body): TaskHandle<T> -- a task whose body gets a network grant of the authority of `net` (the same scope: listen address,
// connect pattern and ports, and the ORIN_DENY policy), owned by the task. A task that needs more than one connection
// binds, accepts and connects through it; a task that serves ONE accepted connection is started with `spawnAccepted` of
// std:net, which moves the connection itself.
export function spawnNet<T>(s: Scope, net: NetGrant, body: (g: NetGrant) => T): TaskHandle<T> {
  const c = grantClone(net);
  const tok = grantMove(c);
  return s.spawn(() => runNet(tok, body));
}

// ------------------------------------------------------------------------------------------------------ parallelMap

// parallelMap(xs, f, parts): B[] -- `xs.map(f)` computed by `parts` tasks, each mapping one contiguous chunk; the result is in
// order. `f` is copied to every task, each chunk moves or is copied to its task. parts = 0 or 1 maps in the calling task. A panic
// of `f` traps the caller. O(n) work over `parts` tasks. Deprecated (ADR-0048 rule 7.6): the `parallel()` pipeline of arrays (`map`). (This file never writes the call as a dot-parallel-paren, which would make the loader import the pipeline prelude into std:task: an import cycle.)
@Deprecated("use the parallel() array pipeline (its map) or forkJoin")
@Ensures(result.length == xs.length)
export function parallelMap<A, B>(xs: A[], f: (x: A) => B, parts: usize): B[] {
  if (parts <= 1 || xs.length <= 1) {
    return xs.map(f);
  }
  const n = parts < xs.length ? parts : xs.length;
  const size = (xs.length + n - 1) / n;
  return scope(s => {
    let hs: TaskHandle<B[]>[] = [];
    let lo: usize = 0;
    while (lo < xs.length) {
      const hi = lo + size < xs.length ? lo + size : xs.length;
      const chunk = xs.slice(lo, hi);
      hs.push(s.spawn(() => chunk.map(f)));
      lo = hi;
    }
    let out: B[] = [];
    for (const h of hs) {
      out = out.concat(h.join());
    }
    return out;
  });
}

// ------------------------------------------------------------------------------------------------------ fork/join pool
//
// The pool behind `parallel()` on an array `xs` (ADR-0039, docs/std.md "Parallel pipelines"); usable directly too. A computation is split
// into `chunks` numbered pieces; `body(k)` computes piece k. With `workers` >= 2 the pool starts that many worker tasks for
// the call (a pool lives for one call: structured, like `scope`). Worker w starts with the contiguous range of pieces
// w * chunks / workers .. (w + 1) * chunks / workers - 1 and takes them from the front; when its range is empty it STEALS the
// back half of the largest range left (std:task/internal `Ranges`, kept in one monitor). Results are put back in piece order,
// so the result never depends on the number of workers or on who computed what. With `workers` <= 1 the pieces run in
// order on the calling task. A panic in a piece cancels the pieces nobody has started, waits for the workers that are
// still running and then traps the caller with the piece's own message (so a parallel pipeline traps like the sequential
// one). `body` is copied to every worker like any task body: what it captures moves or is copied (`parallel()` lends
// its input array instead, see "lending" in runtime/core/orin_runtime.c).

// A finished piece: its number and its result.
type Done<R> = { k: usize; r: R; };

// Monitor words of a pool: [0] chunks, [1] cut, [2] workers, then lo / hi of every worker.
const POOL_HDR: usize = 3;

function loadRanges(m: usize): Ranges {
  const n = monGet(m, 2);
  let lo: usize[] = [];
  let hi: usize[] = [];
  let w: usize = 0;
  while (w < n) {
    lo.push(monGet(m, POOL_HDR + 2 * w));
    hi.push(monGet(m, POOL_HDR + 2 * w + 1));
    w += 1;
  }
  return new Ranges(lo, hi, monGet(m, 1), monGet(m, 0));
}

function storeRanges(m: usize, r: Ranges): void {
  monSet(m, 0, r.chunks);
  monSet(m, 1, r.cut);
  monSet(m, 2, r.lo.length);
  let w: usize = 0;
  while (w < r.lo.length) {
    monSet(m, POOL_HDR + 2 * w, r.lo[w]);
    monSet(m, POOL_HDR + 2 * w + 1, r.hi[w]);
    w += 1;
  }
}

// The loop of worker w: claim a piece, compute it, repeat; with `until`, a piece whose result is a hit cancels every piece
// after it.
function poolWork<R>(
  m: usize,
  w: usize,
  body: (k: usize) => R,
  until: bool,
  hit: (r: R) => bool,
): Done<R>[] {
  let out: Done<R>[] = [];
  let more = true;
  while (more) {
    monLock(m);
    let rs = loadRanges(m);
    const c = rs.claim(w);
    storeRanges(m, rs);
    monUnlock(m);
    match (c) {
      Some(k) => {
        const r = body(k);
        if (until && hit(r)) {
          monLock(m);
          let rs2 = loadRanges(m);
          rs2.cancelAfter(k);
          storeRanges(m, rs2);
          monUnlock(m);
        }
        out.push(Done<R> { k: k, r: r });
      },
      None => {
        more = false;
      },
    }
  }
  return out;
}

// Runs the pieces on `nw` >= 2 worker tasks; the finished pieces in no particular order.
function runPool<R>(
  chunks: usize,
  nw: usize,
  body: (k: usize) => R,
  until: bool,
  hit: (r: R) => bool,
): Done<R>[] {
  const m = monNew(POOL_HDR + 2 * nw);
  let lo: usize[] = [];
  let hi: usize[] = [];
  let w: usize = 0;
  while (w < nw) {
    lo.push(chunks * w / nw);
    hi.push(chunks * (w + 1) / nw);
    w += 1;
  }
  monLock(m);
  storeRanges(m, new Ranges(lo, hi, chunks, chunks));
  monUnlock(m);
  const tab = begin();
  const s = new Scope(tab);
  let hs: TaskHandle<Done<R>[]>[] = [];
  w = 0;
  while (w < nw) {
    const me = w;
    hs.push(s.spawn(() => poolWork(m, me, body, until, hit)));
    w += 1;
  }
  let all: Done<R>[] = [];
  let failure = "";
  let failed = false;
  for (const h of hs) {
    match (h.tryJoinTask()) {
      Some(ds) => {
        for (const d of ds) {
          all.push(d);
        }
      },
      None => {
        if (!failed) {
          failed = true;
          failure = taskMessage();
          monLock(m);
          let rs = loadRanges(m);
          rs.cancelAll();
          storeRanges(m, rs);
          monUnlock(m);
        }
      },
    }
  }
  finish(tab);
  monFree(m);
  if (failed) {
    taskTrap(failure);
  }
  return all;
}

// The results of `chunks` pieces in piece order (every piece ran exactly once: the unwrap checks it).
function inOrder<R>(chunks: usize, ds: Done<R>[]): Option<R>[] {
  let slots: Option<R>[] = [];
  while (slots.length < chunks) {
    slots.push(None);
  }
  for (const d of ds) {
    slots[d.k] = Some(d.r);
  }
  return slots;
}

// parallelism(): usize -- how many worker threads a parallel computation uses: the environment variable ORIN_THREADS when it is a
// number from 1 to 1024, else the number of processors online. Results of `forkJoin` and `parallel()` never depend on it.
@Ensures(result >= 1)
export function parallelism(): usize {
  const t = parThreads();
  return t >= 1 ? t : 1;
}

// forkJoin(chunks, workers, body): R[] -- [body(0), body(1), ..., body(chunks - 1)], computed by `workers` worker tasks (work
// stealing) when workers >= 2, else in order by the calling task. A panic in a piece traps the caller (see the pool comment above).
// O(chunks) bookkeeping; blocks until every piece has run.
@Ensures(result.length == chunks)
export function forkJoin<R>(chunks: usize, workers: usize, body: (k: usize) => R): R[] {
  if (workers <= 1 || chunks <= 1) {
    let out: R[] = [];
    while (out.length < chunks) {
      out.push(body(out.length));
    }
    return out;
  }
  const nw = workers < chunks ? workers : chunks;
  const slots = inOrder(chunks, runPool(chunks, nw, body, false, (r: R) => false));
  return slots.map(o => o.unwrap());
}

// The record a lend is made from (two slots: see runtime/core/orin_runtime.c "lending").
type Lent<A> = { v: A; spare: usize; };

// forkJoinLent(lent, chunks, workers, body): R[] -- forkJoin, with `lent` LENT to the worker tasks (ADR-0039 section 4, ADR-0049
// row 13a) instead of copied. `body` reaches the lent value through its captures; the lent graph is pinned while the pool
// runs (counts frozen: nothing in it is freed or changed in place) and shared by every worker without a copy, so a
// capture of the lent value costs nothing per worker. The other captures of `body` are copied to every worker as in
// forkJoin and must stay small. Results are built by the workers and travel back by move or copy; a result never refers
// into the lent graph (a transfer by a worker copies pinned objects). The lent value is released again before the call
// returns, also for the calling task, which only spawns and joins while it is lent (the owner's obligation of lending).
// With workers <= 1 or chunks <= 1 nothing is lent and `body` runs in order on the calling task. `lent` can be any value
// but a handle (E0480).
@Ensures(result.length == chunks)
export function forkJoinLent<A, R>(
  lent: A,
  chunks: usize,
  workers: usize,
  body: (k: usize) => R,
): R[] {
  if (workers <= 1 || chunks <= 1) {
    return forkJoin(chunks, 1, body);
  }
  const tok = lendPut(Lent<A> { v: lent, spare: 0 });
  const r = forkJoin(chunks, workers, body);
  transitDrop(tok);
  return r;
}

// forkJoinUntil(chunks, workers, body, hit): R[] -- [body(0), ..., body(j)] where j is the first piece whose result is a hit (all
// pieces when none is). Pieces after a hit are cancelled; the pieces before the first hit always run, so the result is the
// same as computing the pieces one by one and stopping at the first hit. Errors, cost and blocking as for forkJoin.
@Ensures(result.length <= chunks)
export function forkJoinUntil<R>(
  chunks: usize,
  workers: usize,
  body: (k: usize) => R,
  hit: (r: R) => bool,
): R[] {
  let out: R[] = [];
  if (workers <= 1 || chunks <= 1) {
    let k: usize = 0;
    while (k < chunks) {
      const r = body(k);
      const h = hit(r);
      out.push(r);
      k = h ? chunks : k + 1;
    }
    return out;
  }
  const nw = workers < chunks ? workers : chunks;
  const slots = inOrder(chunks, runPool(chunks, nw, body, true, hit));
  let k: usize = 0;
  while (k < chunks) {
    const r = slots[k].unwrap();
    const h = hit(r);
    out.push(r);
    k = h ? chunks : k + 1;
  }
  return out;
}
