// std:fs -- whole-file functions and streaming file access through the scope API (ADR-0025).
//
// UNSTABLE (ADR-0016 two-stage freeze): std I/O stays unstable until the project owner confirms the freeze. Every
// function that touches the file system takes the FILE-SYSTEM GRANT (`FsGrant`, ADR-0027) as its first argument:
// `readFile(fs, path)`, `withFile(fs, path, mode, body)`. A grant comes from `main(host: Host)` through std:host
// (`useFs(host, fs => ...)`) and can be narrowed with `withUnder` / `withReadOnly` below; the scope shape and the `File`
// methods did not change. The language rules for `File` and for grants are not unstable: see below.
//
// `File` is a RESOURCE HANDLE, not a value (spec 06): it can be passed to functions (borrowed) but not stored in a
// record / class / array / Option / Result / Map, returned, assigned to another variable, captured by a closure,
// compared or converted to string; those uses are compile errors E0450 / E0451 / E0452 (compiler/check/resources.or)
// and, independently, MIR verifier errors (docs/mir.md, "Resource handles"). The only way to obtain one is a
// scope function below: it opens the file, calls `body` with the handle as the body's PARAMETER, and closes the
// file when `body` returns -- on every path, including when the result is later turned into an `Err`. A trap
// inside `body` ends the process; the runtime flushes and closes open files in its exit hook, so bytes already
// handed to `write` are not lost (a kill by signal still loses buffered bytes).
//
// Errors of reads/writes/flushes inside the scope are remembered by the file (the methods themselves stay
// simple: `readLine(): Option<string>`, `write(s): void`); the scope function reports the first one as
// `Err(FsError)` when it closes the file. A failed read looks like end of file to `body`.
//
// Why two flavours: a generic result `T` cannot be `void`; `withFile` returns the body's value, `useFile`
// takes a body that returns nothing. Both exist for one file and for two files (`withFiles`, `useFiles`), which is how
// you stream from one file to another: a handle cannot be captured by a nested scope's closure.
//
// Failure (ADR-0048 section 3): every function that can fail for an outside reason returns `Result<_, FsError>`; the
// error has a `kind` (NotFound, PermissionDenied, Denied, ...), the failed operation `op`, the `path` and the `reason`
// text, and `fsErrorMessage(e)` renders it. Nothing traps on a missing path, a non-directory, a permission error or a
// refusal by the host policy / the narrowed grant; only a forged, stale or wrong-family grant and allocation failure do.
//
// Whole-file functions: readFile(fs, path): Result<string, FsError>, writeFile(fs, path, data): Result<void, FsError>,
// exists(fs, path): Result<bool, FsError>, listDir(fs, path): Result<string[], FsError> (the entries of a directory in
// byte order, physical subdirectories with a trailing `/`; directory symlinks are not followed; a readable empty
// directory yields `Ok([])`; a partial listing is never returned).
//
// Entry functions (they act on the NAME, so a symbolic link is renamed, removed or replaced itself, never its target):
// rename(fs, source, target): Result<void, FsError>, removeFile(fs, path): Result<void, FsError>, removeDir(fs, path):
// Result<void, FsError> (empty directories only), writeFileAtomic(fs, path, data): Result<void, FsError> (a reader or a
// crash sees the old contents or all of the new ones). All four are writes: a read-only grant refuses them.
//
// Narrowing (ADR-0027): `withUnder(fs, dir, body)` runs `body` with a grant that only reaches paths inside `dir`
// (compared after making both absolute and removing "." / ".." / repeated "/" -- and, for existing path prefixes,
// after resolving symbolic links, so a link that leaves the scope does not work); `withReadOnly(fs, body)` with a
// grant that cannot create, write or truncate. A narrowed grant never has more authority than its parent: asking for
// a directory outside the parent's scope yields a grant that reaches nothing. Narrowed grants are handles like any
// other (a scope parameter, no capture, no storing).

import {
  File, FsGrant, fsReadFile, fsWriteFile, fsExists, fsListDir, fsRename, fsRemoveFile, fsRemoveDir, fsWriteFileAtomic, fileOpen, fileIsOpen, fileOpenError, fileClose, grantUnder,
  grantReadOnly, grantRevoke
} from "std:fsraw";

export { File, FsGrant } from "std:fsraw";

// Why an operation failed. NotFound, PermissionDenied, IsDirectory, NotDirectory and AlreadyExists are the operating
// system's answers; Denied is the host policy (ORIN_DENY names `fs`), OutsideScope a path outside a narrowed grant
// (`withUnder`) or one that cannot be resolved inside it, ReadOnly a write through `withReadOnly`, WrongMode a read on
// a file opened for writing or the reverse, TooManyFiles the limit of 256 open files, NotEmpty a `removeDir` of a directory
// that still has entries, Io every other system error.
export type FsErrorKind =
  NotFound
  | PermissionDenied
  | IsDirectory
  | NotDirectory
  | AlreadyExists
  | NotEmpty
  | Denied
  | OutsideScope
  | ReadOnly
  | WrongMode
  | TooManyFiles
  | Io;

// What was being attempted when the error happened.
export type FsOp = OpRead | OpWrite | OpOpen | OpList | OpStat | OpClose | OpRename | OpRemove;

// An error of this module. `path` is the path as the caller wrote it, `reason` the system's or the policy's explanation
// (diagnostic text, not for matching: match on `kind`). Render it with `fsErrorMessage`.
export type FsError = { kind: FsErrorKind; op: FsOp; path: string; reason: string; };

// fsErrorMessage(e: FsError): string -- "cannot read 'a.txt': No such file or directory" (verbs: read, write, open, list,
// check, rename, remove; a failure found when a file is closed reads "I/O error on 'p': reason"). Never empty. O(path + reason).
export function fsErrorMessage(e: FsError): string {
  return match (e.op) {
    OpClose => "I/O error on '" + e.path + "': " + e.reason,
    _ => "cannot " + opVerb(e.op) + " '" + e.path + "': " + e.reason
  };
}

function opVerb(op: FsOp): string {
  return match (op) {
    OpRead => "read",
    OpWrite => "write",
    OpOpen => "open",
    OpList => "list",
    OpStat => "check",
    OpClose => "close",
    OpRename => "rename",
    OpRemove => "remove"
  };
}

// The kind for the explanation text of the runtime (the strerror text of the platform or one of the policy texts).
function kindOfReason(reason: string): FsErrorKind {
  if (reason == "denied by the host policy (ORIN_DENY)") {
    return Denied;
  }
  if (reason == "outside the granted file scope" || reason == "path cannot be resolved inside the granted scope") {
    return OutsideScope;
  }
  if (reason == "the file grant is read-only") {
    return ReadOnly;
  }
  if (reason == "No such file or directory") {
    return NotFound;
  }
  if (reason == "Permission denied" || reason == "Operation not permitted") {
    return PermissionDenied;
  }
  if (reason == "Is a directory") {
    return IsDirectory;
  }
  if (reason == "Not a directory") {
    return NotDirectory;
  }
  if (reason == "File exists") {
    return AlreadyExists;
  }
  if (reason == "Directory not empty") {
    return NotEmpty;
  }
  if (reason == "Bad file descriptor") {
    return WrongMode;
  }
  if (reason == "Too many open files") {
    return TooManyFiles;
  }
  return Io;
}

// The runtime reports "cannot <verb> '<path>': <reason>"; the reason is what follows the prefix.
function reasonOf(op: FsOp, path: string, raw: string): string {
  const prefix = "cannot " + opVerb(op) + " '" + path + "': ";
  if (raw.startsWith(prefix)) {
    return raw.substring(prefix.length, raw.length);
  }
  return raw;
}

function fromReason(op: FsOp, path: string, reason: string): FsError {
  return FsError { kind: kindOfReason(reason), op: op, path: path, reason: reason };
}

function fromRaw(op: FsOp, path: string, raw: string): FsError {
  return fromReason(op, path, reasonOf(op, path, raw));
}

// The error for a refusal code of the grant (100001 host policy, 100003 read-only, 100002 scope, 100004 unresolvable).
function denial(op: FsOp, path: string, code: int): FsError {
  if (code == 100001) {
    return FsError { kind: Denied, op: op, path: path, reason: "denied by the host policy (ORIN_DENY)" };
  }
  if (code == 100003) {
    return FsError { kind: ReadOnly, op: op, path: path, reason: "the file grant is read-only" };
  }
  if (code == 100004) {
    return FsError { kind: OutsideScope, op: op, path: path, reason: "path cannot be resolved inside the granted scope" };
  }
  return FsError { kind: OutsideScope, op: op, path: path, reason: "outside the granted file scope" };
}

// readFile(fs, path): Result<string, FsError>
// The whole file as text. Err: NotFound, PermissionDenied, IsDirectory, Denied, OutsideScope or Io. O(file size); allocates
// the result.
export function readFile(fs: FsGrant, path: string): Result<string, FsError> {
  const r = fsReadFile(fs, path);
  return match (r) {
    Ok(text) => Ok(text),
    Err(raw) => Err(fromRaw(OpRead, path, raw))
  };
}

// writeFile(fs, path, data): Result<void, FsError>
// Creates or truncates `path` and writes `data`. Err: NotFound (missing directory), PermissionDenied, IsDirectory,
// Denied, OutsideScope, ReadOnly or Io. O(data size).
export function writeFile(fs: FsGrant, path: string, data: string): Result<void, FsError> {
  const r = fsWriteFile(fs, path, data);
  if (r.isErr()) {
    return Err(fromRaw(OpWrite, path, r.unwrapErr()));
  }
  return Ok();
}

// exists(fs, path): Result<bool, FsError>
// True when `path` names a file, a directory or the target of a symbolic link; a dangling link and a path the process
// cannot stat are `Ok(false)`. Err only when the grant refuses the query (Denied, OutsideScope). O(1) system call.
export function exists(fs: FsGrant, path: string): Result<bool, FsError> {
  const r = fsExists(fs, path);
  if (r < 0) {
    return Err(denial(OpStat, path, 0 - r));
  }
  return Ok(r != 0);
}

// listDir(fs, path): Result<string[], FsError>
// The entries of the directory in byte order, subdirectories with a trailing "/", "." and ".." omitted; symbolic links are
// not followed. Err: NotFound, NotDirectory, PermissionDenied, Denied, OutsideScope or Io, never a partial listing.
// O(n log n) in the number of entries; allocates the array.
export function listDir(fs: FsGrant, path: string): Result<string[], FsError> {
  const r = fsListDir(fs, path);
  return match (r) {
    Ok(entries) => Ok(entries),
    Err(raw) => Err(fromRaw(OpList, path, raw))
  };
}

// rename(fs, source, target): Result<void, FsError>
// Renames `source` to `target`; an existing `target` is replaced atomically (POSIX rename). Both paths must lie inside the grant's
// scope and the grant must allow writes; `source` is a link itself when it is a symbolic link. Err (the path is always
// `source`): NotFound, PermissionDenied, IsDirectory, NotDirectory, NotEmpty (a non-empty directory at `target`), Denied,
// OutsideScope, ReadOnly or Io (also for a rename across file systems). O(1) system calls.
export function rename(fs: FsGrant, source: string, target: string): Result<void, FsError> {
  const r = fsRename(fs, source, target);
  if (r.isErr()) {
    return Err(fromRaw(OpRename, source, r.unwrapErr()));
  }
  return Ok();
}

// removeFile(fs, path): Result<void, FsError>
// Removes a file or a symbolic link (the link, not its target). A directory is an Err (IsDirectory or PermissionDenied,
// depending on the system); use removeDir. Err: NotFound, PermissionDenied, IsDirectory, NotDirectory, Denied,
// OutsideScope, ReadOnly or Io. O(1) system calls.
export function removeFile(fs: FsGrant, path: string): Result<void, FsError> {
  const r = fsRemoveFile(fs, path);
  if (r.isErr()) {
    return Err(fromRaw(OpRemove, path, r.unwrapErr()));
  }
  return Ok();
}

// removeDir(fs, path): Result<void, FsError>
// Removes an EMPTY directory; nothing is removed recursively. Err: NotEmpty, NotFound, NotDirectory, PermissionDenied,
// Denied, OutsideScope, ReadOnly or Io. O(1) system calls.
export function removeDir(fs: FsGrant, path: string): Result<void, FsError> {
  const r = fsRemoveDir(fs, path);
  if (r.isErr()) {
    return Err(fromRaw(OpRemove, path, r.unwrapErr()));
  }
  return Ok();
}

// writeFileAtomic(fs, path, data): Result<void, FsError>
// Writes `data` to a temporary file in the directory of `path`, flushes it to disk and renames it over `path`, so a reader
// or a crash sees either the old contents or all of `data`. Unlike writeFile, a symbolic link at `path` is replaced, not
// followed. On Err `path` is untouched. Err: NotFound (missing directory), PermissionDenied, IsDirectory, Denied,
// OutsideScope, ReadOnly or Io. O(data size).
export function writeFileAtomic(fs: FsGrant, path: string, data: string): Result<void, FsError> {
  const r = fsWriteFileAtomic(fs, path, data);
  if (r.isErr()) {
    return Err(fromRaw(OpWrite, path, r.unwrapErr()));
  }
  return Ok();
}

// How a file is opened: Read (the file must exist), Write (create or truncate), Append (create if missing,
// every write goes to the end). A file opened with Read cannot be written and vice versa (the failed operation is
// reported as an `Err` of kind WrongMode when the scope ends).
export type FileMode = Read | Write | Append;

function modeCode(m: FileMode): int {
  return match (m) {
    Read => 0,
    Write => 1,
    Append => 2
  };
}

// The error of a failed open: the handle holds the reason text.
function openError(path: string, h: File): FsError {
  return fromReason(OpOpen, path, fileOpenError(h));
}

// The error of a failed operation found at close ("I/O error: <reason>" from the runtime).
function closeError(path: string, raw: string): FsError {
  const prefix = "I/O error: ";
  const reason = raw.startsWith(prefix) ? raw.substring(prefix.length, raw.length) : raw;
  return fromReason(OpClose, path, reason);
}

// The first failure of the closes of two files (path A first).
function firstClose(pathA: string, a: Option<string>, pathB: string, b: Option<string>): Option<FsError> {
  return match (a) {
    Some(m) => Some(closeError(pathA, m)),
    None => match (b) {
      Some(n) => Some(closeError(pathB, n)),
      None => None
    }
  };
}

// withFile<T>(fs, path, mode, body): Result<T, FsError>
// Opens `path`, runs `body(file)`, closes the file, and returns `Ok(<body's value>)`; `Err` if the file cannot be opened
// (body is not called; kinds as for readFile / writeFile) or if any operation on it or the final flush/close failed (the
// body's value is discarded). O(1) plus the work of `body`; at most 256 files can be open at once.
export function withFile<T>(fs: FsGrant, path: string, mode: FileMode, body: (file: File) => T): Result<T, FsError> {
  const h = fileOpen(fs, path, modeCode(mode));
  if (!fileIsOpen(h)) {
    const err = openError(path, h);
    fileClose(h);
    return Err(err);
  }
  const r = body(h);
  const e = fileClose(h);
  return match (e) {
    Some(m) => Err(closeError(path, m)),
    None => Ok(r)
  };
}

// useFile(fs, path, mode, body): Result<void, FsError> -- `withFile` for a body that returns nothing.
export function useFile(fs: FsGrant, path: string, mode: FileMode, body: (file: File) => void): Result<void, FsError> {
  const h = fileOpen(fs, path, modeCode(mode));
  if (!fileIsOpen(h)) {
    const err = openError(path, h);
    fileClose(h);
    return Err(err);
  }
  body(h);
  const e = fileClose(h);
  return match (e) {
    Some(m) => Err(closeError(path, m)),
    None => Ok()
  };
}

// withFiles<T>(fs, pathA, modeA, pathB, modeB, body): Result<T, FsError>
// Two files open at the same time (for example copying a file line by line). If the second cannot be opened the first is
// closed again; the first failure to close is reported (file A before file B).
export function withFiles<T>(
  fs: FsGrant, pathA: string, modeA: FileMode, pathB: string, modeB: FileMode, body: (a: File, b: File) => T
): Result<T, FsError> {
  const a = fileOpen(fs, pathA, modeCode(modeA));
  if (!fileIsOpen(a)) {
    const err = openError(pathA, a);
    fileClose(a);
    return Err(err);
  }
  const b = fileOpen(fs, pathB, modeCode(modeB));
  if (!fileIsOpen(b)) {
    const err = openError(pathB, b);
    fileClose(b);
    fileClose(a);
    return Err(err);
  }
  const r = body(a, b);
  const eb = fileClose(b);
  const ea = fileClose(a);
  return match (firstClose(pathA, ea, pathB, eb)) {
    Some(err) => Err(err),
    None => Ok(r)
  };
}

// useFiles(fs, pathA, modeA, pathB, modeB, body): Result<void, FsError> -- `withFiles` for a body that returns nothing.
export function useFiles(
  fs: FsGrant, pathA: string, modeA: FileMode, pathB: string, modeB: FileMode, body: (a: File, b: File) => void
): Result<void, FsError> {
  const a = fileOpen(fs, pathA, modeCode(modeA));
  if (!fileIsOpen(a)) {
    const err = openError(pathA, a);
    fileClose(a);
    return Err(err);
  }
  const b = fileOpen(fs, pathB, modeCode(modeB));
  if (!fileIsOpen(b)) {
    const err = openError(pathB, b);
    fileClose(b);
    fileClose(a);
    return Err(err);
  }
  body(a, b);
  const eb = fileClose(b);
  const ea = fileClose(a);
  return match (firstClose(pathA, ea, pathB, eb)) {
    Some(err) => Err(err),
    None => Ok()
  };
}

// withUnder<T>(fs, dir, body: (sub: FsGrant) => T): T
// Runs `body` with a grant restricted to the directory `dir` (and below). `dir` may be relative (to the working
// directory) or absolute. Not allowed to widen: if `dir` is not inside the scope of `fs`, the result reaches nothing
// (every operation is refused with OutsideScope). O(1) plus the work of `body`.
export function withUnder<T>(fs: FsGrant, dir: string, body: (sub: FsGrant) => T): T {
  const g = grantUnder(fs, dir);
  const r = body(g);
  grantRevoke(g);
  return r;
}

// useUnder(fs, dir, body: (sub: FsGrant) => void): void -- `withUnder` for a body that returns nothing.
export function useUnder(fs: FsGrant, dir: string, body: (sub: FsGrant) => void): void {
  const g = grantUnder(fs, dir);
  body(g);
  grantRevoke(g);
}

// withReadOnly<T>(fs, body: (ro: FsGrant) => T): T
// Runs `body` with a grant that can read but not create, write or truncate (such an operation is refused with ReadOnly).
// O(1) plus the work of `body`.
export function withReadOnly<T>(fs: FsGrant, body: (ro: FsGrant) => T): T {
  const g = grantReadOnly(fs);
  const r = body(g);
  grantRevoke(g);
  return r;
}

// useReadOnly(fs, body: (ro: FsGrant) => void): void -- `withReadOnly` for a body that returns nothing.
export function useReadOnly(fs: FsGrant, body: (ro: FsGrant) => void): void {
  const g = grantReadOnly(fs);
  body(g);
  grantRevoke(g);
}

// withFileFs<T>(fs, path, mode, body: (file: File, fs: FsGrant) => T): Result<T, FsError>
// `withFile` whose body also receives the SAME grant again as a parameter. A closure cannot capture a grant (the capture
// would let it outlive the scope), so a body that must open further files (a nested scope, a recursive helper) gets the
// grant this way.
export function withFileFs<T>(fs: FsGrant, path: string, mode: FileMode, body: (file: File, fs: FsGrant) => T): Result<T, FsError> {
  const h = fileOpen(fs, path, modeCode(mode));
  if (!fileIsOpen(h)) {
    const err = openError(path, h);
    fileClose(h);
    return Err(err);
  }
  const r = body(h, fs);
  const e = fileClose(h);
  return match (e) {
    Some(m) => Err(closeError(path, m)),
    None => Ok(r)
  };
}
