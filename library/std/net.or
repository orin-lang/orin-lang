// std:net -- blocking TCP on the L0 network primitives (ADR-0033, ADR-0027, ADR-0025). UNSTABLE (ADR-0016).
//
// Authority. Every function that touches the network takes a handle as its first argument. The root `NetGrant` comes
// from `main(host: Host)` through `withNet(host, net => ...)` (std:host). It is NARROWED, never widened:
//   withListen(net, addr, port, l => ...)                      `l` may listen on `addr:port` only
//   withConnect(net, hostPattern, portLo, portHi, c => ...)    `c` may connect / resolve only names matching the pattern
// A host pattern is "*" (any), "*.example.com" (names below example.com) or an exact name or address, compared with the
// text the program supplies (ASCII case-insensitive; see ADR-0033 for the limits). A request outside the scope is refused
// with `Err(NetError)` (isDenied) by L0 before any system call. `ORIN_DENY=net` denies the whole family the same way.
//
// Resources. `Listener` and `Stream` are RESOURCE HANDLES (ADR-0025, like `File`): they exist only as the parameter of a
// scope function (`withListener`, `withAccepted`, `withConnection`) and are closed when it returns, on every path; they
// cannot be stored, copied, returned or captured by a closure (E0450-E0452 and the MIR verifier). Because a Stream
// cannot be stored, state that belongs to one connection (the bytes read ahead, a parser) lives in a normal value
// next to it: a `StreamReader`, an `http.RequestParser`.
//
// Time. Every call that can wait takes a `timeout: Duration` of std:time (clamped to 0 .. 3,600,000 ms); there is no
// infinite wait. A timeout of `readUntil` / `readExact` / `sendAll` is a DEADLINE for the whole operation (a client that
// sends one byte per `timeout - 1` ms does not extend it); `recv` / `send` / `accept` time out per call, and `connect`
// bounds all the addresses of a name together. Every operation also has an ABSOLUTE form on a `Deadline` of std:time (an instant
// on the monotonic clock, ADR-0017 Addendum B section 5), which several calls can share so that a whole exchange has one
// deadline however many small reads and writes it takes: `recvUntil`, `sendUntil`, `sendAllUntil`, `readExactUntil`,
// `readDelimitedUntil` of a `StreamReader`, `withAcceptedUntil`, `acceptDetachedUntil`, `withConnectionUntil`,
// and their deadline forms. A deadline that has passed still lets an operation that is ready complete once (a zero wait), never more.
// Deadlines of your own are computed with `monotonicMillis(stream)`.
//
// Cancellation (ADR-0017 Addendum D). A task that is cancelled (`Scope.cancel()` / `CancelToken.cancel()` of std:task, also from
// another task) stops waiting at once: a call blocked in accept, connect, recv or send returns `Err(NetError { kind: Cancelled })`
// within milliseconds, and every later network call of that task
// returns it without touching the socket (a pending connection or the bytes in the kernel stay where they are). Pure computation
// is not interrupted: check `isCancelled()` of std:task. Name resolution is the exception: `getaddrinfo` runs to the OS
// resolver's own end (see `resolve`), in `resolve` and in the lookup that `connect` does for a name; a literal address
// is not looked up, and a cancelled task does not start a lookup.
//
// Blocking. One task serves one connection at a time. A server that serves many connections at once MOVES each accepted
// connection into a task (ADR-0017 Addendum C): `spawnAccepted` starts a task for it; `acceptDetached` + a channel of
// `Accepted` + `serveAccepted` feed a fixed pool of worker tasks (a bounded number of connections in service, the rest
// wait in the channel and then in the kernel's backlog). A moved Stream leaves the accepting task and belongs to the
// worker, which closes it; a slow client holds one worker up to the deadlines you set.
//
// Errors. Every failure is a `NetError { kind, code, offset }` (`NetErrorKind`: Denied, Closed, Timeout, Reset,
// Cancelled, InvalidArgument, InvalidPeer, Os); `netErrorMessage(e)` is its text. Nothing here traps for an ordinary failure, except a
// forged / stale / wrong-kind handle (the runtime traps: it is a bug, not a condition).
//
// Contract standard (ADR-0030): every class has an @Invariant, every public function states @Requires / @Ensures.

import { Bytes, fromArray, empty } from "std:bytes";
import { Scope, TaskHandle, spawn } from "std:task";
import { Deadline, Duration, MonotonicInstant } from "std:time";
import { MAX_MS, clampMs, waitUntilMs, portDigits, splitLines } from "std:net/internal";
import {
  NetGrant, Listener, Stream, grantListen, grantConnect, grantRevoke, grantMove, grantAdoptStream, netListen, netAccept, netConnect, netStatus, netClose,
  netPort, netNow, netRecv, netSend, netShutdown, netPeer, netResolve, netErrorText
} from "std:fsraw";

export { NetGrant, Listener, Stream } from "std:fsraw";

// ------------------------------------------------------------------------------------------------ errors

// Why an operation of this module failed (rule 3.1.4: bare words describing the cause).
//   Denied           refused by the grant's scope or by the host policy (`ORIN_DENY=net`)
//   Closed           the peer closed the connection (L0 code 1001); from `recv` it is the end of the stream
//   Timeout          nothing happened within the time given (1002)
//   Cancelled        the cancellation token of the task's scope was set (1004); see "Cancellation" above
//   Reset            the connection was reset or broke (1003)
//   InvalidArgument  an argument was refused (EINVAL: a backlog of 0, an address that is not numeric, a port out of range)
//   InvalidPeer      `parsePeer` was given text that is not `host:port` or `[ipv6]:port`
//   Os               any other error of the operating system (ECONNREFUSED, EADDRINUSE, ENOENT for an unknown name ...);
//                    `NetError.code` holds the errno
export type NetErrorKind = Denied | Closed | Timeout | Cancelled | Reset | InvalidArgument | InvalidPeer | Os;

// An error of this module. `code` is the L0 code (1 permission denied, 1001 closed by the peer, 1002 timeout, 1003 reset, 1004 cancelled,
// otherwise the errno of the OS) and 0 for an error that did not come from L0 (`InvalidPeer`). `offset` is the byte offset
// into the text for `InvalidPeer` and 0 for every other kind. The text is `netErrorMessage(e)`.
export type NetError = { kind: NetErrorKind; code: int; offset: usize; };

const CODE_DENIED: int = 1;
const CODE_EOF: int = 1001;
const CODE_TIMEOUT: int = 1002;
const CODE_RESET: int = 1003;
const CODE_CANCELLED: int = 1004;
const CODE_INVALID: int = 22;
const CHUNK: usize = 65536;

// kindOfCode(code): the kind of an L0 code. O(1).
function kindOfCode(code: int): NetErrorKind {
  if (code == CODE_DENIED) {
    return Denied;
  }
  if (code == CODE_EOF) {
    return Closed;
  }
  if (code == CODE_TIMEOUT) {
    return Timeout;
  }
  if (code == CODE_RESET) {
    return Reset;
  }
  if (code == CODE_CANCELLED) {
    return Cancelled;
  }
  if (code == CODE_INVALID) {
    return InvalidArgument;
  }
  return Os;
}

// netErrorFromCode(code): NetError -- the error of an L0 code, with its kind. O(1).
@Ensures(result.code == code && result.offset == 0)
export function netErrorFromCode(code: int): NetError {
  return NetError { kind: kindOfCode(code), code: code, offset: 0 };
}

// netErrorMessage(e): string -- a sentence for the error (the operating system's text for an L0 code). Never empty. O(1).
@Ensures(result.length > 0)
export function netErrorMessage(e: NetError): string {
  const text = match (e.kind) {
    InvalidPeer => `invalid peer address at byte ${e.offset.toString()}`,
    Cancelled => "cancelled: the cancellation token of the task's scope was set",
    _ => netErrorText(e.code)
  };
  return text.length > 0 ? text : `network error ${e.code.toString()}`;
}

// isDenied(e): bool -- refused by the grant's scope or by the host policy (`e.kind` is Denied). O(1).
export function isDenied(e: NetError): bool {
  return e.kind == Denied;
}

// isTimeout(e): bool -- nothing happened within the time given (Timeout). O(1).
export function isTimeout(e: NetError): bool {
  return e.kind == Timeout;
}

// isReset(e): bool -- the connection was reset or broke (Reset). O(1).
export function isReset(e: NetError): bool {
  return e.kind == Reset;
}

// isClosed(e): bool -- the peer closed the connection (Closed): from `recv` the end of the stream. O(1).
export function isClosed(e: NetError): bool {
  return e.kind == Closed;
}

// isCancelled(e): bool -- the cancellation token of the task's scope was set (Cancelled). O(1).
export function isCancelled(e: NetError): bool {
  return e.kind == Cancelled;
}

// ------------------------------------------------------------------------------------------------ peers

// Peer = { host: string; port: int } -- the address of the other end of a stream: `host` is the numeric address, `port` its port.
export type Peer = { host: string; port: int; };

function invalidPeer(offset: usize): NetError {
  return NetError { kind: InvalidPeer, code: 0, offset: offset };
}

function isInvalidPeer(e: NetError): bool {
  return match (e.kind) {
    InvalidPeer => true,
    _ => false
  };
}

// parsePeer(text): Result<Peer, NetError> -- "1.2.3.4:5" or "[::1]:5" to a Peer (the brackets of an IPv6 literal are
// dropped). Err(InvalidPeer) with the byte offset of the problem when there is no port, the port is not 0 .. 65535, the
// host is empty, or an IPv6 literal is not in brackets. O(n).
@Ensures(result.isOk() ==> result.unwrap().port >= 0 && result.unwrap().port <= 65535 && result.unwrap().host.length > 0)
@Ensures(result.isErr() ==> isInvalidPeer(result.unwrapErr()))
export function parsePeer(text: string): Result<Peer, NetError> {
  let i = text.length;
  while (i > 0) {
    i -= 1;
    if (text.charCodeAt(i) == 58) {
      const port = portDigits(text, i + 1);
      if (port.isErr()) {
        return Err(invalidPeer(port.unwrapErr()));
      }
      let h = text.substring(0, i);
      if (h.length >= 2 && h.charCodeAt(0) == 91 && h.charCodeAt(h.length - 1) == 93) {
        h = h.substring(1, h.length - 1);
      } else if (h.indexOf(":").isSome()) {
        return Err(invalidPeer(i));
      }
      if (h.length == 0) {
        return Err(invalidPeer(0));
      }
      return Ok(Peer { host: h, port: port.unwrap() });
    }
  }
  return Err(invalidPeer(text.length));
}

// ------------------------------------------------------------------------------------------------ narrowing

// withListen<T>(net, addr, port, body): T -- runs body with a grant that can only listen on exactly `addr:port` (addr is
// an address literal: "0.0.0.0", "127.0.0.1", "::1" ...; port 0 = any port the OS picks), and returns its result. If
// `net` does not allow that, the grant reaches nothing (every listen is refused). The grant is revoked when body returns.
// O(1).
export function withListen<T>(net: NetGrant, addr: string, port: int, body: (l: NetGrant) => T): T {
  const g = grantListen(net, addr, port);
  const r = body(g);
  grantRevoke(g);
  return r;
}

// useListen(net, addr, port, body): void -- `withListen` for a body that returns nothing.
@Deprecated("use withListen(net, addr, port, body) with a void body (ADR-0048)")
export function useListen(net: NetGrant, addr: string, port: int, body: (l: NetGrant) => void): void {
  withListen(net, addr, port, body);
}

// withConnect<T>(net, hostPattern, portLo, portHi, body): T -- runs body with a grant that can only connect to / resolve
// hosts matching `hostPattern` on ports portLo..portHi. A pattern or range outside `net`'s scope yields a grant that
// reaches nothing. The grant is revoked when body returns. O(1).
export function withConnect<T>(net: NetGrant, hostPattern: string, portLo: int, portHi: int, body: (c: NetGrant) => T): T {
  const g = grantConnect(net, hostPattern, portLo, portHi);
  const r = body(g);
  grantRevoke(g);
  return r;
}

// useConnect(net, hostPattern, portLo, portHi, body): void -- `withConnect` for a body that returns nothing.
@Deprecated("use withConnect(net, hostPattern, portLo, portHi, body) with a void body (ADR-0048)")
export function useConnect(net: NetGrant, hostPattern: string, portLo: int, portHi: int, body: (c: NetGrant) => void): void {
  withConnect(net, hostPattern, portLo, portHi, body);
}

// ------------------------------------------------------------------------------------------------ listeners

// withListener<T>(net, addr, port, backlog, body): Result<T, NetError> -- binds a listener on addr:port (SO_REUSEADDR),
// runs body(listener) and closes it. `Err` if `net` does not allow it (Denied), the port is in use (Os) or the arguments
// are invalid (InvalidArgument); body is not called then. `port` 0 binds a free port, `portOf(listener)` tells which.
// backlog 1..4096. The listener is created through a grant narrowed to exactly addr:port. O(1); one socket.
export function withListener<T>(net: NetGrant, addr: string, port: int, backlog: int, body: (ln: Listener) => T): Result<T, NetError> {
  const g = grantListen(net, addr, port);
  const ln = netListen(g, addr, port, backlog, 1);
  const code = netStatus(ln);
  if (code != 0) {
    netClose(ln);
    grantRevoke(g);
    return Err(netErrorFromCode(code));
  }
  const r = body(ln);
  netClose(ln);
  grantRevoke(g);
  return Ok(r);
}

// useListener(net, addr, port, backlog, body): Result<void, NetError> -- `withListener` for a body that returns nothing.
@Deprecated("use withListener(net, addr, port, backlog, body) with a void body (ADR-0048)")
export function useListener(net: NetGrant, addr: string, port: int, backlog: int, body: (ln: Listener) => void): Result<void, NetError> {
  return withListener(net, addr, port, backlog, body);
}

// useListenerNet(net, addr, port, backlog, body): Result<void, NetError> -- `withListenerNet` for a body that returns nothing.
@Deprecated("use withListenerNet(net, addr, port, backlog, body) with a void body (ADR-0048)")
export function useListenerNet(
  net: NetGrant, addr: string, port: int, backlog: int, body: (ln: Listener, net: NetGrant) => void
): Result<void, NetError> {
  return withListenerNet(net, addr, port, backlog, body);
}

// withListenerNet<T>(net, addr, port, backlog, body): Result<T, NetError> -- `withListener` whose body also receives `net` again
// as a parameter (a closure cannot capture a grant, so a body that must also connect, for example a loopback test, gets it this
// way); the listener is closed afterwards. Returns the body's value (any T, `void` included).
export function withListenerNet<T>(
  net: NetGrant, addr: string, port: int, backlog: int, body: (ln: Listener, net: NetGrant) => T
): Result<T, NetError> {
  const g = grantListen(net, addr, port);
  const ln = netListen(g, addr, port, backlog, 1);
  const code = netStatus(ln);
  if (code != 0) {
    netClose(ln);
    grantRevoke(g);
    return Err(netErrorFromCode(code));
  }
  const r = body(ln, net);
  netClose(ln);
  grantRevoke(g);
  return Ok(r);
}

// portOf(ln): int -- the port the listener is bound to (the real one when it was asked for port 0). O(1).
@Ensures(result >= 0 && result <= 65535)
export function portOf(ln: Listener): int {
  return netPort(ln);
}

// withAccepted<T>(ln, timeout, body): Result<T, NetError> -- waits up to `timeout` for a connection, runs
// body(stream, peer) and closes the stream (a graceful `close` after `shutdownWrite` is the body's business).
// `Err(Timeout)` if none came (isTimeout: normal in a server loop), another Err on failure; body is not called then.
// TCP_NODELAY is on. Waits up to `timeout`; one socket.
export function withAccepted<T>(ln: Listener, timeout: Duration, body: (s: Stream, peer: Peer) => T): Result<T, NetError> {
  const s = netAccept(ln, clampMs(timeout.millis), 1);
  const code = netStatus(s);
  if (code != 0) {
    netClose(s);
    return Err(netErrorFromCode(code));
  }
  const peer = parsePeer(netPeer(s));
  if (peer.isErr()) {
    netClose(s);
    return Err(peer.unwrapErr());
  }
  const r = body(s, peer.unwrap());
  netClose(s);
  return Ok(r);
}

// useAccepted(ln, timeout, body): Result<void, NetError> -- `withAccepted` for a body that returns nothing.
@Deprecated("use withAccepted(ln, timeout, body) with a void body (ADR-0048)")
export function useAccepted(ln: Listener, timeout: Duration, body: (s: Stream, peer: Peer) => void): Result<void, NetError> {
  return withAccepted(ln, timeout, body);
}

// withAcceptedUntil<T>(ln, deadline, body): Result<T, NetError> -- `withAccepted` that waits until the absolute `deadline` (a single
// wait is capped at one hour like every wait of this module: a later deadline behaves as one hour from now). The deadline of the
// whole exchange is typically shared with the body's own `...Until` calls. Cancellable. Err(Timeout) if none came.
export function withAcceptedUntil<T>(ln: Listener, deadline: Deadline, body: (s: Stream, peer: Peer) => T): Result<T, NetError> {
  const s = netAccept(ln, waitUntilMs(netNow(ln), deadline.at.millis), 1);
  const code = netStatus(s);
  if (code != 0) {
    netClose(s);
    return Err(netErrorFromCode(code));
  }
  const peer = parsePeer(netPeer(s));
  if (peer.isErr()) {
    netClose(s);
    return Err(peer.unwrapErr());
  }
  const r = body(s, peer.unwrap());
  netClose(s);
  return Ok(r);
}

// ------------------------------------------------------------------------------------------------ concurrent servers

// An accepted connection on its way to another task (ADR-0017 Addendum C): the Stream has left the accepting task's grant
// table (`acceptDetached`) and waits as a one-shot token until a task adopts it (`serveAccepted`). It is a plain value, so
// it can travel through a channel (`channel<Accepted>`) to a pool of workers. It is `@Sealed` (the token is private to this
// module: only `acceptDetached` makes one); `peer` is readable. Exactly one `serveAccepted` / `dropAccepted`
// per `Accepted`: a second one traps ("invalid grant token"), and a token nobody takes keeps its socket open until the
// process ends, so a producer that cannot hand one over calls `dropAccepted`.
@Sealed
export type Accepted = { _token: usize; peer: Peer; };

// acceptDetached(ln, timeout): Result<Accepted, NetError> -- waits up to `timeout` for a connection and MOVES it out of this
// task: Ok(Accepted), or `Err(Timeout)` (isTimeout: normal in a server loop) / another Err. TCP_NODELAY is on.
export function acceptDetached(ln: Listener, timeout: Duration): Result<Accepted, NetError> {
  const s = netAccept(ln, clampMs(timeout.millis), 1);
  const code = netStatus(s);
  if (code != 0) {
    netClose(s);
    return Err(netErrorFromCode(code));
  }
  const peer = parsePeer(netPeer(s));
  if (peer.isErr()) {
    netClose(s);
    return Err(peer.unwrapErr());
  }
  const tok = grantMove(s);
  return Ok(Accepted { _token: tok, peer: peer.unwrap() });
}

// acceptDetachedUntil(ln, deadline): Result<Accepted, NetError> -- `acceptDetached` that waits until the absolute `deadline`. Cancellable.
export function acceptDetachedUntil(ln: Listener, deadline: Deadline): Result<Accepted, NetError> {
  const s = netAccept(ln, waitUntilMs(netNow(ln), deadline.at.millis), 1);
  const code = netStatus(s);
  if (code != 0) {
    netClose(s);
    return Err(netErrorFromCode(code));
  }
  const peer = parsePeer(netPeer(s));
  if (peer.isErr()) {
    netClose(s);
    return Err(peer.unwrapErr());
  }
  const tok = grantMove(s);
  return Ok(Accepted { _token: tok, peer: peer.unwrap() });
}

// serveAccepted<T>(a, body): T -- in the task that serves it: adopts the connection, runs body(stream, peer) and closes the stream.
export function serveAccepted<T>(a: Accepted, body: (s: Stream, peer: Peer) => T): T {
  const s = grantAdoptStream(a._token);
  const r = body(s, a.peer);
  netClose(s);
  return r;
}

// serveAcceptedDo(a, body): void -- `serveAccepted` for a body that returns nothing.
@Deprecated("use serveAccepted(a, body) with a void body (ADR-0048)")
export function serveAcceptedDo(a: Accepted, body: (s: Stream, peer: Peer) => void): void {
  serveAccepted(a, body);
}

// dropAccepted(a): void -- closes a connection that will not be served (the pool is shutting down, the queue is full).
export function dropAccepted(a: Accepted): void {
  const s = grantAdoptStream(a._token);
  netClose(s);
}

// spawnAccepted<T>(sc, ln, timeout, body): Result<TaskHandle<T>, NetError> -- accepts one connection (as `acceptDetached`) and
// starts a task of the scope `sc` that serves it: body(stream, peer), then the stream is closed. The task owns the connection; this task keeps the listener.
// Unbounded: a task per connection; bound the number in flight yourself (see the example server) or use a worker pool.
export function spawnAccepted<T>(
  sc: Scope, ln: Listener, timeout: Duration, body: (s: Stream, peer: Peer) => T
): Result<TaskHandle<T>, NetError> {
  const a = acceptDetached(ln, timeout);
  return match (a) {
    Ok(acc) => Ok(spawn(sc, () => serveAccepted(acc, body))),
    Err(e) => Err(e)
  };
}

// spawnAcceptedDo(sc, ln, timeout, body): Result<TaskHandle<bool>, NetError> -- `spawnAccepted` for a body that returns nothing;
// join() then returns true.
@Deprecated("use spawnAccepted(sc, ln, timeout, body), which accepts a void body (TaskHandle<void>) (ADR-0048)")
export function spawnAcceptedDo(
  sc: Scope, ln: Listener, timeout: Duration, body: (s: Stream, peer: Peer) => void
): Result<TaskHandle<bool>, NetError> {
  return spawnAccepted(sc, ln, timeout, (s, peer) => {
    body(s, peer);
    return true;
  });
}

// ------------------------------------------------------------------------------------------------ connections

// withConnection<T>(net, host, port, timeout, body): Result<T, NetError> -- connects (a name is resolved by the OS
// first: that lookup is not bounded by `timeout`), runs body(stream) and closes the stream. `Err` if refused (Denied),
// unreachable (Os) or timed out (Timeout); body is not called then. Waits up to `timeout`; one socket.
export function withConnection<T>(net: NetGrant, host: string, port: int, timeout: Duration, body: (s: Stream) => T): Result<T, NetError> {
  const s = netConnect(net, host, port, clampMs(timeout.millis), 1);
  const code = netStatus(s);
  if (code != 0) {
    netClose(s);
    return Err(netErrorFromCode(code));
  }
  const r = body(s);
  netClose(s);
  return Ok(r);
}

// useConnection(net, host, port, timeout, body): Result<void, NetError> -- `withConnection` for a body that returns nothing.
@Deprecated("use withConnection(net, host, port, timeout, body) with a void body (ADR-0048)")
export function useConnection(net: NetGrant, host: string, port: int, timeout: Duration, body: (s: Stream) => void): Result<void, NetError> {
  return withConnection(net, host, port, timeout, body);
}

// withConnectionUntil<T>(net, host, port, deadline, body): Result<T, NetError> -- `withConnection` whose connect ends at the absolute
// `deadline` (all addresses of the name together; a wait is capped at one hour). The lookup of a NAME is not bounded by it and
// cannot be cancelled (see `resolve`). Cancellable while it connects: Err(Cancelled).
export function withConnectionUntil<T>(net: NetGrant, host: string, port: int, deadline: Deadline, body: (s: Stream) => T): Result<T, NetError> {
  const s = netConnect(net, host, port, waitUntilMs(netNow(net), deadline.at.millis), 1);
  const code = netStatus(s);
  if (code != 0) {
    netClose(s);
    return Err(netErrorFromCode(code));
  }
  const r = body(s);
  netClose(s);
  return Ok(r);
}

// useConnectionUntil(net, host, port, deadline, body): Result<void, NetError> -- `withConnectionUntil` for a body that returns nothing.
@Deprecated("use withConnectionUntil(net, host, port, deadline, body) with a void body (ADR-0048)")
export function useConnectionUntil(net: NetGrant, host: string, port: int, deadline: Deadline, body: (s: Stream) => void): Result<void, NetError> {
  return withConnectionUntil(net, host, port, deadline, body);
}

// useConnectionBeside(net, host, port, timeout, ln, body): Result<void, NetError> -- `withConnectionBeside` for a body that
// returns nothing.
@Deprecated("use withConnectionBeside(net, host, port, timeout, ln, body) with a void body (ADR-0048)")
export function useConnectionBeside(
  net: NetGrant, host: string, port: int, timeout: Duration, ln: Listener, body: (s: Stream, ln: Listener) => void
): Result<void, NetError> {
  return withConnectionBeside(net, host, port, timeout, ln, body);
}

// withConnectionBeside<T>(net, host, port, timeout, ln, body): Result<T, NetError> -- `withConnection` whose body also receives
// the listener `ln` again (a closure cannot capture a handle): a client and the server side of the same process, for example a
// loopback test. The connection completes before `accept` (the kernel queues it, backlog permitting).
export function withConnectionBeside<T>(
  net: NetGrant, host: string, port: int, timeout: Duration, ln: Listener, body: (s: Stream, ln: Listener) => T
): Result<T, NetError> {
  const s = netConnect(net, host, port, clampMs(timeout.millis), 1);
  const code = netStatus(s);
  if (code != 0) {
    netClose(s);
    return Err(netErrorFromCode(code));
  }
  const r = body(s, ln);
  netClose(s);
  return Ok(r);
}

// resolve(net, name): Result<string[], NetError> -- the numeric addresses of `name` (IPv4 and IPv6, no duplicates), or
// Err (Denied when the grant's scope does not cover `name`, Os for an unknown name). LIMITATION: the lookup is the C library's
// blocking `getaddrinfo`; it is bounded by no timeout and no deadline and cannot be interrupted by a cancellation (a task blocked
// in it finishes the lookup first and returns `Cancelled` from its next network call; a task that is already cancelled does not
// start one). A literal address needs no lookup. A server that must stay cancellable should resolve names in a task of its own and
// not wait for it past the deadline (`joinUntil`), or connect to addresses. A resolver pool is not provided: the OS offers no
// way to abandon a lookup. O(addresses).
export function resolve(net: NetGrant, name: string): Result<string[], NetError> {
  const r = netResolve(net, name);
  return match (r) {
    Ok(text) => Ok(splitLines(text)),
    Err(code) => Err(netErrorFromCode(code))
  };
}

// ------------------------------------------------------------------------------------------------ stream operations

// recv(s, maxBytes, timeout): Result<Bytes, NetError> -- waits up to `timeout` for bytes and returns 1..min(maxBytes, 65536) of
// them. `Err` otherwise: kind Closed when the peer closed (the end of the stream: no more data ever), Timeout when nothing
// arrived, Reset, Cancelled, or InvalidArgument for maxBytes 0. Never traps. One system call; the bytes are copied once from
// the L0 buffer into the result.
@Ensures(result.isOk() ==> result.unwrap().length() >= 1 && result.unwrap().length() <= maxBytes)
@Ensures(maxBytes == 0 ==> result.isErr())
export function recv(s: Stream, maxBytes: usize, timeout: Duration): Result<Bytes, NetError> {
  return recvMs(s, maxBytes, clampMs(timeout.millis));
}

// recv with the wait in milliseconds, already clamped.
@Requires(ms >= 0 && ms <= MAX_MS)
@Ensures(result.isOk() ==> result.unwrap().length() >= 1 && result.unwrap().length() <= maxBytes)
@Ensures(maxBytes == 0 ==> result.isErr())
function recvMs(s: Stream, maxBytes: usize, ms: int): Result<Bytes, NetError> {
  if (maxBytes == 0) {
    return Err(netErrorFromCode(CODE_INVALID));
  }
  const r = netRecv(s, maxBytes, ms);
  return match (r) {
    Ok(arr) => Ok(fromArray(arr)),
    Err(code) => Err(netErrorFromCode(code))
  };
}

// recvUntil(s, maxBytes, deadline): Result<Bytes, NetError> -- `recv` that waits until the absolute `deadline`: bytes that are
// ready are returned even when it has passed (a zero wait), Err(Timeout) when none came by then. Unlike a wait of `recv`, it is
// not cut at one hour. Cancellable: Err(Cancelled). maxBytes 0 is Err(InvalidArgument). Never traps.
@Ensures(result.isOk() ==> result.unwrap().length() >= 1 && result.unwrap().length() <= maxBytes)
@Ensures(maxBytes == 0 ==> result.isErr())
export function recvUntil(s: Stream, maxBytes: usize, deadline: Deadline): Result<Bytes, NetError> {
  const end = deadline.at.millis;
  while (true) {
    const r = recvMs(s, maxBytes, waitUntilMs(netNow(s), end));
    if (r.isOk() || r.unwrapErr().kind != Timeout || end - netNow(s) <= 0) {
      return r;
    }
  }
  return Err(netErrorFromCode(CODE_TIMEOUT));
}

// send(s, data, timeout): Result<usize, NetError> -- one attempt: waits up to `timeout` until the socket is writable and
// hands the OS at most 65536 bytes of `data`; Ok(n) with 0 <= n <= min(length, 65536) (a partial write is normal), Err
// otherwise (Timeout, Reset: the peer is gone). `sendAll` loops. Does not copy `data`.
export function send(s: Stream, data: Bytes, timeout: Duration): Result<usize, NetError> {
  const start = data.storageStart();
  return sendFrom(s, data.storage(), start, start + data.length(), clampMs(timeout.millis));
}

// One attempt to send arr[off, end) (the bytes of a `Bytes` read from its storage, without a copy); `ms` is already clamped.
@Requires(off <= end && end <= arr.length)
function sendFrom(s: Stream, arr: u8[], off: usize, end: usize, ms: int): Result<usize, NetError> {
  const r = netSend(s, arr, off, end - off, ms);
  return match (r) {
    Ok(n) => Ok(n),
    Err(code) => Err(netErrorFromCode(code))
  };
}

// sendUntil(s, data, deadline): Result<usize, NetError> -- `send` that waits until the absolute `deadline` for the socket to be writable. Err(Timeout) when it
// stayed full until then; Err(Cancelled) when cancelled. Not cut at one hour.
export function sendUntil(s: Stream, data: Bytes, deadline: Deadline): Result<usize, NetError> {
  const start = data.storageStart();
  const end = deadline.at.millis;
  while (true) {
    const r = sendFrom(s, data.storage(), start, start + data.length(), waitUntilMs(netNow(s), end));
    if (r.isOk() || r.unwrapErr().kind != Timeout || end - netNow(s) <= 0) {
      return r;
    }
  }
  return Err(netErrorFromCode(CODE_TIMEOUT));
}

// sendAll(s, data, timeout): Result<void, NetError> -- sends all of `data`, resending the tail after partial writes;
// `timeout` is a deadline for the whole call. Err(Timeout) if the peer does not read fast enough, Err(Reset) if it is
// gone. O(length); `data` itself is not copied.
export function sendAll(s: Stream, data: Bytes, timeout: Duration): Result<void, NetError> {
  return sendAllEnd(s, data, netNow(s) + clampMs(timeout.millis));
}

// sendAllUntil(s, data, deadline): Result<void, NetError> -- `sendAll` with an absolute deadline for the whole call (several calls can share one). The
// check of the clock happens before every write, so a peer that reads one byte at a time cannot stretch it. Err(Timeout),
// Err(Reset), Err(Cancelled) (also between two writes).
export function sendAllUntil(s: Stream, data: Bytes, deadline: Deadline): Result<void, NetError> {
  return sendAllEnd(s, data, deadline.at.millis);
}

function sendAllEnd(s: Stream, data: Bytes, deadline: int): Result<void, NetError> {
  const arr = data.storage();
  const end = data.storageStart() + data.length();
  let off = data.storageStart();
  while (off < end) {
    const left = deadline - netNow(s);
    if (left <= 0) {
      return Err(netErrorFromCode(CODE_TIMEOUT));
    }
    const r = sendFrom(s, arr, off, end, left > MAX_MS ? MAX_MS : left);
    match (r) {
      Ok(n) => {
        if (n == 0) {
          return Err(netErrorFromCode(CODE_RESET));
        }
        off += n;
      },
      Err(e) => {
        if (e.kind != Timeout || deadline - netNow(s) <= 0) {
          return Err(e);
        }
      }
    }
  }
  return Ok();
}

// shutdownWrite(s): Result<void, NetError> -- half-close: sends FIN so the peer reads EOF while this side can still read.
// The first step of a graceful close (then drain with `recv` for a bounded time, then let the scope close the stream); a
// bare close with unread input makes the OS send RST, which can discard the response just written. O(1).
export function shutdownWrite(s: Stream): Result<void, NetError> {
  const code = netShutdown(s, 1);
  if (code != 0) {
    return Err(netErrorFromCode(code));
  }
  return Ok();
}

// monotonicMillis(s): int -- a monotonic clock in milliseconds (arbitrary origin) for deadlines; it needs a live stream,
// so a function that has no clock grant can still enforce a deadline on the connection it was given. Not the wall clock
// of `time.nowMillis`. O(1).
// Traps if the underlying monotonic clock fails: it never substitutes a timestamp or disables a deadline.
export function monotonicMillis(s: Stream): int {
  return netNow(s);
}

// ------------------------------------------------------------------------------------------------ reading with a buffer

// What `readExact` / `readUntil` produced when the read itself worked: Filled(bytes), FillClosed(the bytes read before the peer
// closed: a short read, not an error because the bytes are data), FillLimit (the limit was reached without the delimiter; the
// bytes stay buffered). A deadline that passed, a reset or a cancellation is the `Err(NetError)` of the call (Timeout: the bytes
// read so far stay buffered).
export type Fill = Filled(Bytes) | FillClosed(Bytes) | FillLimit;

// A read buffer for one stream: the bytes read ahead of what the caller consumed. A normal value (a Stream cannot be
// stored). `cap` bounds the buffered bytes: no operation ever holds more, so a hostile peer cannot grow it.
@Invariant(this.cap >= 1 && this.pending.length() <= this.cap)
export class StreamReader {
  private pending: Bytes;
  private cap: usize;

  // new StreamReader(cap) -- an empty buffer that holds at most `cap` bytes (1 .. 268435456). Traps otherwise.
  @Requires(cap >= 1 && cap <= 268435456)
  constructor(cap: usize) {
    this.pending = empty();
    this.cap = cap;
  }

  // buffered(): Bytes -- the bytes read ahead and not yet consumed. O(1).
  @Ensures(result.length() <= this.cap)
  buffered(): Bytes {
    return this.pending;
  }

  // capacity(): usize -- the most bytes the buffer holds. O(1).
  @Ensures(result == this.cap)
  capacity(): usize {
    return this.cap;
  }

  // unread(data): void -- puts `data` back in front of the buffered bytes (for example the rest of a chunk a parser did
  // not use). Traps if the buffer would exceed its capacity. O(length).
  @Requires(data.length() + this.pending.length() <= this.cap)
  @Ensures(this.buffered().length() == old(this.buffered().length()) + data.length())
  unread(data: Bytes): void {
    this.pending = data.concat(this.pending);
  }

  // take(n): Bytes -- removes and returns the first n buffered bytes. Traps if fewer than n are buffered. O(length).
  @Requires(n <= this.pending.length())
  @Ensures(result.length() == n)
  @Ensures(this.pending.length() == old(this.pending.length()) - n)
  take(n: usize): Bytes {
    const head = this.pending.slice(0, n);
    this.pending = this.pending.slice(n, this.pending.length());
    return head;
  }

  // readSome(s, maxBytes, timeout): Result<Bytes, NetError> -- buffered bytes if there are any (at most maxBytes, no system
  // call), else one `recv` (its errors, Closed at the end of the stream). Traps if maxBytes is 0.
  @Requires(maxBytes >= 1)
  readSome(s: Stream, maxBytes: usize, timeout: Duration): Result<Bytes, NetError> {
    if (this.pending.length() > 0) {
      const n = this.pending.length() < maxBytes ? this.pending.length() : maxBytes;
      return Ok(this.take(n));
    }
    return recv(s, maxBytes < this.cap ? maxBytes : this.cap, timeout);
  }

  // readExact(s, n, timeout): Result<Fill, NetError> -- exactly n bytes (Ok(Filled)), or what arrived before the peer closed
  // (Ok(FillClosed)); Err(Timeout) when the DEADLINE `timeout` (for the whole call) passed, Err(Reset) or Err(Cancelled). Never
  // reads past n bytes: further bytes stay in the stream. Traps if n exceeds the capacity.
  @Requires(n <= this.cap)
  @Ensures(result.isOk() ==> match (result.unwrap()) { Filled(b) => b.length() == n, _ => true })
  @Ensures(this.pending.length() <= this.cap)
  readExact(s: Stream, n: usize, timeout: Duration): Result<Fill, NetError> {
    return this.readExactUntil(s, n, Deadline { at: MonotonicInstant { millis: netNow(s) + clampMs(timeout.millis) } });
  }

  // readExactUntil(s, n, deadline): Result<Fill, NetError> -- `readExact` with an absolute deadline for the whole call, however many
  // small reads it takes (a peer that sends one byte at a time cannot stretch it, and several calls can share one deadline).
  @Requires(n <= this.cap)
  @Ensures(result.isOk() ==> match (result.unwrap()) { Filled(b) => b.length() == n, _ => true })
  @Ensures(this.pending.length() <= this.cap)
  readExactUntil(s: Stream, n: usize, deadline: Deadline): Result<Fill, NetError> {
    const end = deadline.at.millis;
    while (this.pending.length() < n) {
      const left = end - netNow(s);
      if (left < 0) {
        return Err(netErrorFromCode(CODE_TIMEOUT));
      }
      const want = n - this.pending.length();
      const r = recvMs(s, want, clampMs(left));
      match (r) {
        Ok(b) => {
          this.pending = this.pending.concat(b);
        },
        Err(e) => {
          if (e.kind == Closed) {
            return Ok(FillClosed(this.take(this.pending.length())));
          }
          if (e.kind != Timeout || end - netNow(s) <= 0) {
            return Err(e);
          }
        }
      }
    }
    return Ok(Filled(this.take(n)));
  }

  // readUntil(s, delim, limit, timeout): Result<Fill, NetError> -- the bytes up to and including the first occurrence of `delim`
  // (Ok(Filled)), with at most `limit` bytes examined: Ok(FillLimit) if `limit` bytes contain no delimiter (the buffer then keeps
  // them), Ok(FillClosed) (the bytes so far) if the peer closed first, Err(Timeout) at the DEADLINE `timeout` for the whole call,
  // Err(Reset) or Err(Cancelled). Receives at most limit - buffered bytes each time, so at most `limit` bytes are buffered by
  // the call. Traps if delim is empty, limit is shorter than delim or limit exceeds the capacity.
  @Requires(delim.length() >= 1 && limit >= delim.length() && limit <= this.cap)
  @Ensures(result.isOk() ==> match (result.unwrap()) { Filled(b) => b.length() <= limit && b.length() >= delim.length(), _ => true })
  @Ensures(this.pending.length() <= this.cap)
  readUntil(s: Stream, delim: Bytes, limit: usize, timeout: Duration): Result<Fill, NetError> {
    return this.readDelimitedUntil(s, delim, limit, Deadline { at: MonotonicInstant { millis: netNow(s) + clampMs(timeout.millis) } });
  }

  // readDelimitedUntil(s, delim, limit, deadline): Result<Fill, NetError> -- `readUntil` with an absolute deadline for the whole call.
  @Requires(delim.length() >= 1 && limit >= delim.length() && limit <= this.cap)
  @Ensures(result.isOk() ==> match (result.unwrap()) { Filled(b) => b.length() <= limit && b.length() >= delim.length(), _ => true })
  @Ensures(this.pending.length() <= this.cap)
  readDelimitedUntil(s: Stream, delim: Bytes, limit: usize, deadline: Deadline): Result<Fill, NetError> {
    const end = deadline.at.millis;
    let begin: usize = 0;
    while (true) {
      const at = delimiterEnd(this.pending, delim, begin, limit);
      match (at) {
        Some(stop) => {
          return Ok(Filled(this.take(stop)));
        },
        None => {}
      }
      if (this.pending.length() >= limit) {
        return Ok(FillLimit);
      }
      begin = this.pending.length() >= delim.length() ? this.pending.length() - delim.length() + 1 : 0;
      const left = end - netNow(s);
      if (left < 0) {
        return Err(netErrorFromCode(CODE_TIMEOUT));
      }
      const r = recvMs(s, limit - this.pending.length(), clampMs(left));
      match (r) {
        Ok(b) => {
          this.pending = this.pending.concat(b);
        },
        Err(e) => {
          if (e.kind == Closed) {
            return Ok(FillClosed(this.take(this.pending.length())));
          }
          if (e.kind != Timeout || end - netNow(s) <= 0) {
            return Err(e);
          }
        }
      }
    }
    return Ok(FillLimit);
  }
}

// delimiterEnd(hay, delim, begin, limit): Option<usize> -- the end index (exclusive) of the first occurrence of `delim` in
// hay that starts at an index >= begin and ends at <= limit, or None. O(length * delim) worst case, O(length) typical.
// Internal (ADR-0048 7.4): this is a Bytes search, which will become `Bytes.indexOfBytes(needle, from)` in std:bytes; this
// local copy goes away then.
@Ensures(result.isSome() ==> result.unwrap() >= delim.length() && result.unwrap() <= limit && result.unwrap() <= hay.length())
function delimiterEnd(hay: Bytes, delim: Bytes, begin: usize, limit: usize): Option<usize> {
  const n = hay.length() < limit ? hay.length() : limit;
  const m = delim.length();
  if (m == 0 || n < m) {
    return None;
  }
  let i = begin;
  while (i + m <= n) {
    let k: usize = 0;
    while (k < m && hay.at(i + k) == delim.at(k)) {
      k += 1;
    }
    if (k == m) {
      return Some(i + m);
    }
    i += 1;
  }
  return None;
}
