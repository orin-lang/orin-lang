// OSIG task events (ADR-0017 stage 0): starting a task is a CONTROL event (PERFORMS_IO to ~io:Task.Spawn), a send / receive on a
// channel is an OUTPUT / INPUT event, a join a CONTROL event; what a task body does is attributed to the enclosing function
// with MAY evidence, like every closure. Delegating a grant to a task records the family of the grant.
import { Host, withFs } from "std:host";
import { FsGrant } from "std:fs";
import { scope, scopeFs, spawn, spawnFs, channel, Channel } from "std:task";

function produce(ch: Channel<int>): void {
  ch.tx.send(1);
  ch.tx.close();
}

function consume(ch: Channel<int>): int {
  return match (ch.rx.recv()) {
    Ok(v) => v,
    Err(e) => 0
  };
}

function fanOut(): int {
  const ch = channel<int>(2);
  return scope(s => {
    const p = spawn(s, () => {
      produce(ch);
      return 0;
    });
    const c = spawn(s, () => consume(ch));
    return p.join() + c.join();
  });
}

function withAuthority(fs: FsGrant): bool {
  return scopeFs(fs, (s, g) => spawnFs(s, g, fsg => true).join());
}

function pure(n: int): int {
  return n * 2;
}

function main(host: Host): void {
  console.log(fanOut().toString());
  withFs(host, fs => {
    console.log(withAuthority(fs) ? "yes" : "no");
  });
}
