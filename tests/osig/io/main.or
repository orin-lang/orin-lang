// OSIG primitive I/O edges (ADR-0027): PERFORMS_IO from the enclosing function to a compiler-owned Effect node.
import { Host, withHost, withNet } from "std:host";
import { FsGrant, readFile, writeFile, withFile, useUnder, Read } from "std:fs";
import { ProcessGrant, args } from "std:process";
import { StdioGrant, readLine, shell } from "std:io";
import { ClockGrant, nowMillis, milliseconds } from "std:time";
import { Bytes, fromString } from "std:bytes";
import { NetGrant, Listener, Stream, useListener, useAccepted, withConnection, useListen, recv, sendAll } from "std:net";

function load(fs: FsGrant, path: string): string {
  const r = readFile(fs, path);
  return r.isOk() ? r.unwrap() : "";
}

function save(fs: FsGrant, path: string, text: string): void {
  writeFile(fs, path, text);
}

function stream(fs: FsGrant, path: string): int {
  const r = withFile(fs, path, Read, f => f.readLine().isSome() ? 1 : 0);
  return r.isOk() ? r.unwrap() : 0;
}

function tick(clock: ClockGrant): int {
  return nowMillis(clock);
}

function run(proc: ProcessGrant, stdio: StdioGrant): void {
  const a = args(proc);
  const l = readLine(stdio);
  shell(proc, "true");
  console.log("done");
}

function scoped(fs: FsGrant): void {
  useUnder(fs, "data", sub => {
    console.log(load(sub, "data/x"));
  });
}

function netio(net: NetGrant): void {
  useListener(net, "127.0.0.1", 0, 4, (ln: Listener) => {
    useAccepted(ln, milliseconds(10), (s: Stream, p) => {
      recv(s, 4, milliseconds(10));
      sendAll(s, fromString("x"), milliseconds(10));
    });
  });
  withConnection(net, "127.0.0.1", 80, milliseconds(10), (s: Stream) => 1);
  useListen(net, "127.0.0.1", 8080, l => { console.log("narrowed"); });
}

function pure(n: int): int {
  return n * 2;
}

function main(host: Host): void {
  withHost(host, (fs, proc, stdio, clock) => {
    scoped(fs);
    run(proc, stdio);
  });
  withNet(host, net => { netio(net); });
}
