import { Host, withHost } from "std:host";
import { FsGrant } from "std:fs";
import { loadConfig, saveConfig } from "./store";
import { say } from "./report";
import { emitAll } from "./plugins";
import { runDynamic } from "./dynamic";
import { fact } from "./util";

function main(host: Host): void {
  withHost(host, (fs, proc, stdio, clock) => {
    const cfg = loadConfig(fs, "app.cfg");
    say(cfg);
    saveConfig(fs, "app.out", cfg);
    emitAll();
    say(fact(5).toString());
  });
  console.log(runDynamic().toString());
}
