// Tests for std:task (ADR-0017 stage 0): channel semantics in one task, transfer by move or copy (the counters), and the structure
// of a scope. The pure bookkeeping classes `Ring` and `Ledger` are tested in task_internal_test.or. Run with `orin test` (contracts
// checked) and with `--no-contracts`; see tools/test_std.sh.
import { assert, assertEq, assertEqUsize, assertEqBool, assertEqString } from "std:test";
import {
  scope, scopeDo, spawn, spawnDo, channel, TaskHandle, parallelMap, forkJoin, forkJoinUntil,
  forkJoinLent, parallelism, TaskError
} from "std:task";
import { movedCount, copiedCount } from "std:task/internal";

// True when `r` is the error `Closed` (ADR-0048 E6: Sender.send reports a closed channel as a typed error, not a bool).
function isClosed(r: Result<void, TaskError>): bool {
  return match (r) {
    Ok() => false,
    Err(e) => match (e.kind) {
      Closed => true,
      _ => false,
    },
  };
}

// True when a recv() ended with the error `Closed` (end of the stream).
function recvClosed(r: Result<string, TaskError>): bool {
  return match (r) {
    Ok(v) => false,
    Err(e) => match (e.kind) {
      Closed => true,
      _ => false,
    },
  };
}

// ------------------------------------------------------------------------------------------------ channels (one task)

@Test
function channelFifoAndClose(): void {
  const ch = channel<string>(3);
  assertEqBool(ch.tx.send("one").isOk(), true, "send 1");
  assertEqBool(ch.tx.send("two").isOk(), true, "send 2");
  assertEqBool(ch.tx.send("three").isOk(), true, "send 3 (the channel is now full)");
  assertEqString(ch.rx.recv().unwrap(), "one", "fifo 1");
  assertEqBool(ch.tx.send("four").isOk(), true, "a slot is free again");
  ch.tx.close();
  assertEqBool(isClosed(ch.tx.send("five")), true, "send after close is refused, not lost silently");
  assertEqString(ch.rx.recv().unwrap(), "two", "drain 2");
  assertEqString(ch.rx.recv().unwrap(), "three", "drain 3");
  assertEqString(ch.rx.recv().unwrap(), "four", "drain 4");
  assertEqBool(recvClosed(ch.rx.recv()), true, "Err(Closed) once closed and drained");
  assertEqBool(ch.rx.recv().isErr(), true, "and stays Err");
  ch.rx.close();
}

@Test
function receiverCancelDropsAndRefuses(): void {
  const ch = channel<int[]>(4);
  ch.tx.send([1, 2, 3]);
  ch.tx.send([4]);
  ch.rx.close();
  assertEqBool(isClosed(ch.tx.send([5])), true, "a cancelled channel refuses senders");
  ch.tx.close();
}

// ------------------------------------------------------------------------------------------------ move or copy

function makeBig(n: int): string[] {
  let xs: string[] = [];
  let i = 0;
  while (i < n) {
    xs.push("item " + i.toString());
    i += 1;
  }
  return xs;
}

// Every value that crosses is counted exactly once, as a move or as a copy; a value that the sender still holds can only be copied, and
// the receiver's copy is independent of it. WHETHER a fresh temporary is moved depends on the build (the optimiser's owned-parameter
// inference, ADR-0010, passes it by move; contract checking keeps an extra reference and copies), so this test does not pin it:
// tests/concurrency/move_counts.or does, in the default build.
@Test
function everyCrossingIsCountedOnce(): void {
  const ch = channel<string[]>(4);
  const m0 = movedCount();
  const c0 = copiedCount();
  ch.tx.send(makeBig(500));
  assertEqUsize((movedCount() - m0) + (copiedCount() - c0), 1, "one crossing, counted once");
  const keep = makeBig(500);
  ch.tx.send(keep);
  assertEqUsize((movedCount() - m0) + (copiedCount() - c0), 2, "two crossings, counted twice");
  assertEqBool(copiedCount() - c0 >= 1, true, "a value the sender still holds is copied");
  assertEqUsize(keep.length, 500, "the sender's value is intact");
  ch.tx.close();
  assertEqUsize(ch.rx.recv().unwrap().length, 500, "the first value arrives");
  const got = ch.rx.recv().unwrap();
  assertEqUsize(got.length, 500, "the second arrives");
  assertEqString(got[499], "item 499", "with its content");
  ch.rx.close();
}

@Test
function scalarsCostNothing(): void {
  const ch = channel<int>(2);
  const m0 = movedCount();
  const c0 = copiedCount();
  ch.tx.send(41);
  assertEqUsize(movedCount() - m0, 0, "a scalar is neither moved");
  assertEqUsize(copiedCount() - c0, 0, "nor copied");
  assertEq(ch.rx.recv().unwrap(), 41, "but arrives");
  ch.tx.close();
  ch.rx.close();
}

// ------------------------------------------------------------------------------------------------ scopes

@Test
function scopeJoinsWhatTheBodyDidNot(): void {
  const done = channel<int>(8);
  scopeDo(s => {
    let i = 0;
    while (i < 6) {
      const k = i;
      spawnDo(s, () => {
        done.tx.send(k);
      });
      i += 1;
    }
  });
  done.tx.close();
  let n = 0;
  let sum = 0;
  let more = true;
  while (more) {
    match (done.rx.recv()) {
      Ok(v) => {
        n += 1;
        sum += v;
      },
      Err(e) => {
        more = false;
      },
    }
  }
  assertEq(n, 6, "every task ran before the scope returned");
  assertEq(sum, 15, "with its own argument");
  done.rx.close();
}

@Test
function resultsComeBackInAnyJoinOrder(): void {
  const r = scope(s => {
    let hs: TaskHandle<int>[] = [];
    let i = 0;
    while (i < 10) {
      const k = i;
      hs.push(spawn(s, () => k * k));
      i += 1;
    }
    let out: int[] = [];
    let j = hs.length;
    while (j > 0) {
      j -= 1;
      out.push(hs[j].join());
    }
    return out;
  });
  assertEq(r[0], 81, "last task first");
  assertEq(r[9], 0, "first task last");
}

@Test
function parallelMapMatchesMap(): void {
  const xs = makeBig(37);
  const want = xs.map(x => x.length);
  const got = parallelMap(xs, x => x.length, 4);
  assertEqUsize(got.length, want.length, "same length");
  let i: usize = 0;
  while (i < want.length) {
    assertEqUsize(got[i], want[i], "same element");
    i += 1;
  }
}

@Test
function forkJoinKeepsPieceOrder(): void {
  const seq = forkJoin(37, 1, k => k * k);
  const par = forkJoin(37, 4, k => k * k);
  assertEqUsize(seq.length, 37, "one result per piece");
  let i: usize = 0;
  while (i < 37) {
    assertEqUsize(par[i], i * i, "piece order is kept");
    assertEqUsize(seq[i], par[i], "the same with one and four workers");
    i += 1;
  }
  assertEqUsize(forkJoin(0, 4, k => k).length, 0, "no pieces");
  assertEqBool(parallelism() >= 1, true, "at least one thread");
}

@Test
function forkJoinUntilStopsAtTheFirstHit(): void {
  const rs = forkJoinUntil(50, 4, k => k >= 17 && k % 5 == 2, h => h);
  assertEqUsize(rs.length, 18, "the pieces up to the first hit (17)");
  assertEqBool(rs[17], true, "the last is the hit");
  assertEqBool(rs.slice(0, 17).some(h => h), false, "none before it");
  assertEqUsize(forkJoinUntil(9, 3, k => false, h => h).length, 9, "no hit: every piece");
}

// ---- forkJoinLent (ADR-0049 row 13a): the pieces of forkJoin, reading a lent graph ------------------------------------------

type Entry = { id: usize; name: string; tags: string[]; };

function entries(n: usize): Entry[] {
  let es: Entry[] = [];
  while (es.length < n) {
    const id = es.length;
    es.push(Entry { id: id, name: "e" + id.toString(), tags: ["a" + id.toString(), "b"] });
  }
  return es;
}

@Test
function forkJoinLentKeepsPieceOrder(): void {
  const es = entries(100);
  let w: usize = 0;
  while (w <= 8) {
    const rs = forkJoinLent(es, 25, w, k => es[k * 4].name + "/" + es[k * 4 + 3].tags[0]);
    assertEqUsize(rs.length, 25, "one result per piece");
    let k: usize = 0;
    while (k < 25) {
      assertEqString(rs[k], "e" + (k * 4).toString() + "/a" + (k * 4 + 3).toString(), "piece order is kept");
      k += 1;
    }
    w += 1;
  }
  assertEqUsize(forkJoinLent(es, 0, 4, k => k).length, 0, "no pieces");
  assertEqUsize(forkJoinLent(es, 1, 4, k => k + 5)[0], 5, "one piece: the sequential path");
}

@Test
function forkJoinLentSequentialPathLendsNothing(): void {
  const es = entries(50);
  const c0 = copiedCount();
  const m0 = movedCount();
  const rs = forkJoinLent(es, 10, 1, k => es[k].id);
  assertEqUsize(rs.length, 10, "length");
  assertEqUsize((copiedCount() - c0) + (movedCount() - m0), 0, "no transfer at all on the calling task");
}

@Test
function forkJoinLentResultsDoNotAliasTheGraph(): void {
  let es = entries(40);
  const rs = forkJoinLent(es, 8, 4, k => es[k * 5]);
  assertEqUsize(rs.length, 8, "length");
  es[0].name = "changed";
  es[0].tags[0] = "changed";
  assertEqString(rs[0].name, "e0", "the result kept its value");
  assertEqString(rs[0].tags[0], "a0", "also in a nested array");
  let r0 = rs[0];
  r0.name = "mine";
  assertEqString(es[0].name, "changed", "and the graph does not see a change of the result");
  assertEqString(rs[1].name, "e5", "the other results are untouched");
}

@Test
function forkJoinLentNests(): void {
  const es = entries(60);
  const outer = forkJoinLent(
    es,
    6,
    3,
    k => {
      const mine = entries(20 + k);
      const inner = forkJoinLent(mine, 4, 2, j => mine[j * 5].name + es[k * 10].name);
      return inner.join(",");
    },
  );
  assertEqUsize(outer.length, 6, "length");
  assertEqString(outer[2], "e0e20,e5e20,e10e20,e15e20", "inner pool of the third piece");
  assertEqString(outer[5], "e0e50,e5e50,e10e50,e15e50", "inner pool of the last piece");
}
