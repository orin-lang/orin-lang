// std:net (ADR-0033): the pure helpers, and StreamReader / recv / send on a real loopback socket. Run by tools/test_std.sh
// with contract checking (every @Invariant / @Requires / @Ensures of std:net is a run-time trap) and without.
import { assert, assertEq, assertEqUsize, assertEqString, assertEqBool, fail } from "std:test";
import { Host, withNet } from "std:host";
import { milliseconds, Deadline, MonotonicInstant } from "std:time";
import { Scope, scopeNetDo } from "std:task";
import { Bytes, fromString, fromInts } from "std:bytes";
import {
  NetGrant, Listener, Stream, Peer, NetError, NetErrorKind, parsePeer, netErrorFromCode, netErrorMessage, isDenied,
  isTimeout, isReset, withListenerNet, withConnectionBeside, withAccepted, withListener, portOf, recv, send, sendAll, shutdownWrite,
  monotonicMillis, StreamReader, recvUntil, sendUntil, sendAllUntil, withAcceptedUntil, withConnectionUntil,
  acceptDetachedUntil, dropAccepted, acceptDetached, useListen, useConnect, useListener, useListenerNet, useAccepted,
  serveAcceptedDo, useConnection, useConnectionUntil, useConnectionBeside, Fill, Filled, FillClosed, FillLimit, isClosed, isCancelled, Denied, Closed,
  Timeout, Cancelled, Reset, InvalidArgument, InvalidPeer, Os
} from "std:net";

function kindName(k: NetErrorKind): string {
  return match (k) {
    Denied => "Denied",
    Closed => "Closed",
    Timeout => "Timeout",
    Cancelled => "Cancelled",
    Reset => "Reset",
    InvalidArgument => "InvalidArgument",
    InvalidPeer => "InvalidPeer",
    Os => "Os"
  };
}

@Test
function peerParsing(): void {
  const a = parsePeer("127.0.0.1:8080").unwrap();
  assertEqString(a.host, "127.0.0.1", "ipv4 host");
  assertEq(a.port, 8080, "ipv4 port");
  const b = parsePeer("[::1]:443").unwrap();
  assertEqString(b.host, "::1", "ipv6 host");
  assertEq(b.port, 443, "ipv6 port");
  assertEq(parsePeer("localhost:0").unwrap().port, 0, "port 0 is a port");
  assertEq(parsePeer("h:65535").unwrap().port, 65535, "the largest port");
}

@Test
function peerParsingRejects(): void {
  // no sentinel: every bad text is an Err(InvalidPeer) with the byte offset of the problem
  const none = parsePeer("nonsense");
  assert(none.isErr(), "no port");
  assertEqString(kindName(none.unwrapErr().kind), "InvalidPeer", "kind");
  assertEqUsize(none.unwrapErr().offset, 8, "offset: the end of the text");
  const digits = parsePeer("1.2.3.4:99x");
  assert(digits.isErr(), "bad port");
  assertEqUsize(digits.unwrapErr().offset, 10, "offset: the first bad digit");
  assert(parsePeer("1.2.3.4:").isErr(), "empty port");
  assert(parsePeer("1.2.3.4:65536").isErr(), "port too large");
  assert(parsePeer("1.2.3.4:999999999999999999999").isErr(), "port far too large");
  assert(parsePeer(":80").isErr(), "empty host");
  assert(parsePeer("::1:80").isErr(), "an IPv6 literal needs brackets");
  assert(parsePeer("[::1:80").isErr(), "unbalanced bracket");
  assert(parsePeer("").isErr(), "empty text");
  assert(netErrorMessage(none.unwrapErr()).length > 0, "every error has text");
  assertEqString(netErrorMessage(none.unwrapErr()), "invalid peer address at byte 8", "message");
}

@Test
function errorClassification(): void {
  assert(isDenied(netErrorFromCode(1)), "EPERM is a denial");
  assert(isTimeout(netErrorFromCode(1002)), "timeout");
  assert(isReset(netErrorFromCode(1003)), "reset");
  assert(!isDenied(netErrorFromCode(1002)), "a timeout is not a denial");
  assert(isClosed(netErrorFromCode(1001)) && !isClosed(netErrorFromCode(1002)), "closed by the peer");
  assert(isCancelled(netErrorFromCode(1004)) && !isCancelled(netErrorFromCode(1003)), "cancelled");
  assertEqString(kindName(netErrorFromCode(1).kind), "Denied", "kind of 1");
  assertEqString(kindName(netErrorFromCode(1001).kind), "Closed", "kind of 1001");
  assertEqString(kindName(netErrorFromCode(1002).kind), "Timeout", "kind of 1002");
  assertEqString(kindName(netErrorFromCode(1003).kind), "Reset", "kind of 1003");
  assertEqString(kindName(netErrorFromCode(1004).kind), "Cancelled", "kind of 1004");
  assert(netErrorMessage(netErrorFromCode(1004)).length > 0, "cancellation has text");
  assertEqString(kindName(netErrorFromCode(22).kind), "InvalidArgument", "kind of EINVAL");
  assertEqString(kindName(netErrorFromCode(111).kind), "Os", "any other errno");
  assertEq(netErrorFromCode(111).code, 111, "the errno is kept");
  assert(netErrorMessage(netErrorFromCode(1002)).length > 0, "every error has text");
  assert(netErrorMessage(netErrorFromCode(111)).length > 0, "an errno has text");
}

@Test
function delimiterSearchThroughReadUntil(host: Host): void {
  // The delimiter search is internal; its boundaries are observable through `readUntil` on bytes that are already buffered
  // (no byte arrives, so every answer that does not need the network is immediate).
  withNet(host, net => {
    const l = withListenerNet(net, "127.0.0.1", 0, 8, (ln, n) => {
      pair(ln, n, (c: Stream) => {}, (s: Stream) => {
        const crlf = fromString("\r\n");
        const h = fromString("GET / HTTP/1.1\r\nHost: x\r\n\r\n");
        let rd = new StreamReader(64);
        rd.unread(h);
        assertEqString(fillKind(rd.readUntil(s, crlf, 64, milliseconds(50))), "filled GET / HTTP/1.1\r\n", "first CRLF");
        assertEqString(fillKind(rd.readUntil(s, crlf, 64, milliseconds(50))), "filled Host: x\r\n", "second CRLF");
        rd = new StreamReader(64);
        rd.unread(h);
        assertEqString(fillKind(rd.readUntil(s, crlf, 15, milliseconds(50))), "limit", "the delimiter would end past the limit");
        assertEqString(fillKind(rd.readUntil(s, crlf, 16, milliseconds(50))), "filled GET / HTTP/1.1\r\n", "the delimiter ends exactly at the limit");
        rd = new StreamReader(64);
        rd.unread(fromString("ab\r"));
        assertEqString(fillKind(rd.readUntil(s, crlf, 64, milliseconds(30))), "timeout", "half a delimiter: wait for the rest");
        rd = new StreamReader(64);
        rd.unread(fromString("aaab"));
        assertEqString(fillKind(rd.readUntil(s, fromString("aab"), 10, milliseconds(30))), "filled aaab", "overlapping prefix");
        rd = new StreamReader(64);
        assertEqString(fillKind(rd.readUntil(s, crlf, 10, milliseconds(30))), "timeout", "empty buffer, nothing arrives");
      });
    });
    assert(l.isOk(), "listener");
  });
}

function kind(r: Result<Bytes, NetError>): string {
  return match (r) {
    Ok(b) => "data " + b.length().toString(),
    Err(e) => isClosed(e) ? "eof" : isTimeout(e) ? "timeout" : isReset(e) ? "reset" : "error"
  };
}

function fillKind(r: Result<Fill, NetError>): string {
  return match (r) {
    Ok(f) => match (f) {
      Filled(b) => "filled " + b.toRawString(),
      FillClosed(b) => "closed " + b.toRawString(),
      FillLimit => "limit"
    },
    Err(e) => isTimeout(e) ? "timeout" : "error"
  };
}

// client side: connect to the listener in the same process and run `body` with the accepted stream (the connect completes
// before accept: the kernel queues it)
function pair(ln: Listener, net: NetGrant, client: (c: Stream) => void, server: (s: Stream) => void): void {
  const r = withConnectionBeside(net, "127.0.0.1", portOf(ln), milliseconds(2000), ln, (c: Stream, ln2: Listener) => {
    client(c);
    const a = withAccepted(ln2, milliseconds(2000), (s: Stream, p: Peer) => { server(s); });
    assert(a.isOk(), "accepted");
  });
  assert(r.isOk(), "connected");
}

@Test
function readUntilAndExact(host: Host): void {
  withNet(host, net => {
    const l = withListenerNet(net, "127.0.0.1", 0, 8, (ln, n) => {
      pair(ln, n, (c: Stream) => {
        // a head that arrives as three separate sends, and a body behind it
        sendAll(c, fromString("GET / HT"), milliseconds(1000));
        sendAll(c, fromString("TP/1.1\r"), milliseconds(1000));
        sendAll(c, fromString("\nHost: x\r\n\r\nbody!"), milliseconds(1000));
        shutdownWrite(c);
      }, (s: Stream) => {
        let rd = new StreamReader(1024);
        assertEqString(fillKind(rd.readUntil(s, fromString("\r\n"), 100, milliseconds(1000))), "filled GET / HTTP/1.1\r\n", "request line");
        assertEqString(fillKind(rd.readUntil(s, fromString("\r\n\r\n"), 100, milliseconds(1000))), "filled Host: x\r\n\r\n", "rest of the head");
        assertEqString(fillKind(rd.readExact(s, 3, milliseconds(1000))), "filled bod", "exact");
        assertEqString(fillKind(rd.readExact(s, 5, milliseconds(1000))), "closed y!", "the peer closed before 5 bytes");
        assertEqUsize(rd.buffered().length(), 0, "nothing buffered at the end");
      });
    });
    assert(l.isOk(), "listener");
  });
}

@Test
function limitsAndDeadlines(host: Host): void {
  withNet(host, net => {
    const l = withListenerNet(net, "127.0.0.1", 0, 8, (ln, n) => {
      pair(ln, n, (c: Stream) => {
        sendAll(c, fromString("0123456789"), milliseconds(1000));
      }, (s: Stream) => {
        let rd = new StreamReader(64);
        assertEqString(fillKind(rd.readUntil(s, fromString("\n"), 4, milliseconds(500))), "limit", "no delimiter within 4 bytes");
        assert(rd.buffered().length() <= 4, "at most the limit was received");
        // the rest is still there for the next read: nothing was lost
        assertEqString(fillKind(rd.readExact(s, 10, milliseconds(500))), "filled 0123456789", "all ten bytes, nothing lost");
        // a deadline for the whole call: nothing more arrives
        const t0 = monotonicMillis(s);
        assertEqString(fillKind(rd.readExact(s, 1, milliseconds(120))), "timeout", "deadline");
        const dt = monotonicMillis(s) - t0;
        assert(dt >= 100 && dt < 2000, "the deadline is about 120 ms, not much less and not infinite: " + dt.toString());
        assertEqString(kind(recv(s, 8, milliseconds(20))), "timeout", "recv timeout");
      });
    });
    assert(l.isOk(), "listener");
  });
}

@Test
function recvAndSend(host: Host): void {
  withNet(host, net => {
    const l = withListenerNet(net, "127.0.0.1", 0, 8, (ln, n) => {
      pair(ln, n, (c: Stream) => {
        const one = send(c, fromInts([1, 2, 3, 250, 251]), milliseconds(1000));
        assertEqUsize(one.unwrap(), 5, "send reports what it handed over");
        assert(send(c, fromString(""), milliseconds(1000)).unwrap() == 0, "an empty send");
      }, (s: Stream) => {
        assertEqString(kind(recv(s, 2, milliseconds(1000))), "data 2", "recv is capped by maxBytes");
        const r = recv(s, 100, milliseconds(1000));
        match (r) {
          Ok(b) => {
            assertEqUsize(b.length(), 3, "the rest");
            assertEq(b.at(0).toInt(), 3, "byte values survive");
            assertEq(b.at(2).toInt(), 251, "high byte values survive");
          },
          Err(e) => { fail("expected data"); }
        }
        assertEqString(kind(recv(s, 0, milliseconds(10))), "error", "maxBytes 0");
        sendAll(s, fromString("x"), milliseconds(1000));
      });
    });
    assert(l.isOk(), "listener");
  });
}

@Test
function sendViewsOfALargerArray(host: Host): void {
  withNet(host, net => {
    const l = withListenerNet(net, "127.0.0.1", 0, 8, (ln, n) => {
      pair(ln, n, (c: Stream) => {
        // views that start and end inside their storage: only their own bytes go out
        const all = fromString("xxHELLOyyWORLDzz");
        assertEqUsize(send(c, all.slice(2, 7), milliseconds(1000)).unwrap(), 5, "send of a view");
        assert(sendAll(c, all.slice(9, 14), milliseconds(1000)).isOk(), "sendAll of a view");
        shutdownWrite(c);
      }, (s: Stream) => {
        let rd = new StreamReader(64);
        assertEqString(fillKind(rd.readExact(s, 10, milliseconds(1000))), "filled HELLOWORLD", "only the bytes of the views");
        assertEqString(fillKind(rd.readExact(s, 1, milliseconds(1000))), "closed ", "nothing after them");
      });
    });
    assert(l.isOk(), "listener");
  });
}

@Test
function refusals(host: Host): void {
  withNet(host, net => {
    const a = withListenerNet(net, "127.0.0.1", 0, 0, (ln, n) => { fail("backlog 0 must be refused"); });
    assert(a.isErr(), "backlog 0");
    const b = withListenerNet(net, "not an address", 0, 4, (ln, n) => { fail("not numeric"); });
    assert(b.isErr(), "a name is not an address");
    const c = withListenerNet(net, "127.0.0.1", 99999, 4, (ln, n) => { fail("bad port"); });
    assert(c.isErr(), "port out of range");
  });
}

@Test
function readUntilNeverBuffersPastTheLimit(host: Host): void {
  withNet(host, net => {
    const l = withListenerNet(net, "127.0.0.1", 0, 8, (ln, n) => {
      pair(ln, n, (c: Stream) => {
        sendAll(c, fromString("0123456789"), milliseconds(1000));
      }, (s: Stream) => {
        let rd = new StreamReader(64);
        rd.unread(fromString("xx"));
        assertEqString(fillKind(rd.readUntil(s, fromString("\n"), 4, milliseconds(500))), "limit", "no delimiter within 4 bytes");
        assertEqUsize(rd.buffered().length(), 4, "two bytes were already buffered, so only two more were received");
      });
    });
    assert(l.isOk(), "listener");
  });
}

@Test
function readUntilDeadline(host: Host): void {
  withNet(host, net => {
    const l = withListenerNet(net, "127.0.0.1", 0, 8, (ln, n) => {
      pair(ln, n, (c: Stream) => {
        sendAll(c, fromString("abc"), milliseconds(1000));
      }, (s: Stream) => {
        let rd = new StreamReader(64);
        const t0 = monotonicMillis(s);
        assertEqString(fillKind(rd.readUntil(s, fromString("\n"), 64, milliseconds(150))), "timeout", "the delimiter never comes");
        const dt = monotonicMillis(s) - t0;
        assert(dt >= 120 && dt < 3000, "readUntil honours its deadline: " + dt.toString());
        assertEqUsize(rd.buffered().length(), 3, "the bytes that did arrive stay buffered");
      });
    });
    assert(l.isOk(), "listener");
  });
}

function at(ms: int): Deadline {
  return Deadline { at: MonotonicInstant { millis: ms } };
}

@Test
function absoluteDeadlines(host: Host): void {
  withNet(host, net => {
    const l = withListenerNet(net, "127.0.0.1", 0, 8, (ln, n) => {
      pair(ln, n, (c: Stream) => {
        sendAll(c, fromString("abcd"), milliseconds(1000));
      }, (s: Stream) => {
        const t0 = monotonicMillis(s);
        // a deadline that has passed still delivers what is ready, and nothing waits
        assertEqString(kind(recvUntil(s, 2, at(t0 - 1000))), "data 2", "ready bytes at a passed deadline");
        let rd = new StreamReader(64);
        // two bytes are left; one deadline for the whole call, shared with the recvUntil below
        const dl = at(t0 + 200);
        assertEqString(fillKind(rd.readExactUntil(s, 5, dl)), "timeout", "five bytes never come");
        const dt = monotonicMillis(s) - t0;
        assert(dt >= 180 && dt < 3000, "readExactUntil ends at its deadline: " + dt.toString());
        assertEqUsize(rd.buffered().length(), 2, "the bytes that did arrive stay buffered");
        assertEqString(kind(recvUntil(s, 8, dl)), "timeout", "the shared deadline has passed: no wait");
        assert(monotonicMillis(s) - t0 < 3000, "recvUntil at a passed deadline does not wait");
        assertEqString(kind(recvUntil(s, 0, dl)), "error", "maxBytes 0");
        assert(sendAllUntil(s, fromString("ok"), at(monotonicMillis(s) + 1000)).isOk(), "sendAllUntil of a little data");
        assert(sendUntil(s, fromString("ok"), at(monotonicMillis(s) + 1000)).unwrap() == 2, "sendUntil");
        const late = sendAllUntil(s, fromString("x"), at(t0 - 1));
        assert(late.isErr() && late.unwrapErr().kind == Timeout, "sendAllUntil at a passed deadline times out");
      });
    });
    assert(l.isOk(), "listener");
  });
}

@Test
function acceptAndConnectUntil(host: Host): void {
  withNet(host, net => {
    const r = withListenerNet(net, "127.0.0.1", 0, 8, (ln, n) => {
      const c = withConnectionBeside(n, "127.0.0.1", portOf(ln), milliseconds(2000), ln, (s: Stream, l2: Listener) => {
        const now = monotonicMillis(s);
        const a = withAcceptedUntil(l2, at(now + 2000), (t: Stream, p: Peer) => p.host);
        assert(a.isOk() && a.unwrap() == "127.0.0.1", "accepted before the deadline");
        const none = withAcceptedUntil(l2, at(monotonicMillis(s) + 100), (t: Stream, p: Peer) => 0);
        assert(none.isErr() && none.unwrapErr().kind == Timeout, "nobody connects: Timeout at the deadline");
        const d = acceptDetachedUntil(l2, at(monotonicMillis(s) - 5));
        assert(d.isErr() && d.unwrapErr().kind == Timeout, "a passed deadline with nothing queued");
        return 7;
      });
      assert(c.isOk() && c.unwrap() == 7, "withConnectionBeside returns the value of its body");
      const u = withConnectionUntil(n, "127.0.0.1", portOf(ln), at(monotonicMillis0(n) + 2000), (s: Stream) => 9);
      assert(u.isOk() && u.unwrap() == 9, "connect before the deadline");
      return 1;
    });
    assert(r.isOk() && r.unwrap() == 1, "withListenerNet returns the value of its body");
  });
}

// monotonic time through a scratch connection (a program with a NetGrant has no other clock)
function monotonicMillis0(net: NetGrant): int {
  const r = withListenerNet(net, "127.0.0.1", 0, 1, (ln, n) => {
    const c = withConnectionBeside(n, "127.0.0.1", portOf(ln), milliseconds(2000), ln, (s: Stream, l2: Listener) => monotonicMillis(s));
    return c.isOk() ? c.unwrap() : 0;
  });
  return r.isOk() ? r.unwrap() : 0;
}

@Test
function cancelledScopeFailsNetCalls(host: Host): void {
  withNet(host, net => {
    scopeNetDo(net, (sc: Scope, g: NetGrant) => {
      assert(sc.cancel(), "cancel changes the token once");
      const l = withListenerNet(g, "127.0.0.1", 0, 8, (ln, n) => {
        // every network call of a cancelled task fails with Cancelled, without waiting and without touching the socket
        const c = withConnectionBeside(n, "127.0.0.1", portOf(ln), milliseconds(5000), ln, (s: Stream, l2: Listener) => {
          fail("connect must not succeed in a cancelled scope");
        });
        assert(c.isErr() && c.unwrapErr().kind == Cancelled, "connect: Cancelled");
        const a = withAccepted(ln, milliseconds(5000), (s: Stream, p: Peer) => { fail("accept must not succeed"); });
        assert(a.isErr() && a.unwrapErr().kind == Cancelled, "accept: Cancelled");
        assertEqString(netErrorMessage(a.unwrapErr()).length > 0 ? "text" : "empty", "text", "Cancelled has text");
      });
      assert(l.isOk(), "binding a listener is not a wait: it still works");
    });
  });
}

// The ADR-0048 twins of the scope functions stay one release as @Deprecated wrappers (W0440) over the `with*` form with a
// void body; each one still opens, runs the body and closes.
@Test
function deprecatedTwinsStillWork(host: Host): void {
  withNet(host, net => {
    useListen(net, "127.0.0.1", 0, l => {
      assert(withListener(l, "127.0.0.1", 0, 8, (ln: Listener) => portOf(ln)).isOk(), "useListen: the narrowed grant listens");
    });
    useConnect(net, "localhost", 1, 65535, c => {
      assert(isDenied(withListener(c, "127.0.0.1", 0, 8, (ln: Listener) => 0).unwrapErr()), "useConnect: cannot listen");
    });
    const one = useListener(net, "127.0.0.1", 0, 8, (ln: Listener) => { assert(portOf(ln) > 0, "bound"); });
    assert(one.isOk(), "useListener");
    const l = useListenerNet(net, "127.0.0.1", 0, 8, (ln, n) => {
      const port = portOf(ln);
      const c = useConnectionBeside(n, "127.0.0.1", port, milliseconds(2000), ln, (s: Stream, l2: Listener) => {
        sendAll(s, fromString("a"), milliseconds(1000));
        const a = useAccepted(l2, milliseconds(2000), (srv: Stream, p: Peer) => {
          assertEqString(kind(recv(srv, 1, milliseconds(1000))), "data 1", "useAccepted serves the stream");
        });
        assert(a.isOk(), "useAccepted");
      });
      assert(c.isOk(), "useConnectionBeside");
      // a connection completes before accept (the kernel queues it), so the client can finish first
      const now = withConnectionBeside(n, "127.0.0.1", port, milliseconds(2000), ln, (s: Stream, l2: Listener) => monotonicMillis(s));
      dropAccepted(acceptDetached(ln, milliseconds(2000)).unwrap());
      const second = useConnectionUntil(n, "127.0.0.1", port, at(now.unwrap() + 2000), (s2: Stream) => {
        sendAll(s2, fromString("b"), milliseconds(1000));
      });
      assert(second.isOk(), "useConnectionUntil");
      const d = acceptDetached(ln, milliseconds(2000));
      assert(d.isOk(), "acceptDetached");
      serveAcceptedDo(d.unwrap(), (srv: Stream, p: Peer) => {
        assertEqString(kind(recv(srv, 1, milliseconds(1000))), "data 1", "serveAcceptedDo serves the stream");
      });
      const third = useConnection(n, "127.0.0.1", port, milliseconds(2000), (s3: Stream) => {});
      assert(third.isOk(), "useConnection");
      dropAccepted(acceptDetached(ln, milliseconds(2000)).unwrap());
    });
    assert(l.isOk(), "useListenerNet");
  });
}
