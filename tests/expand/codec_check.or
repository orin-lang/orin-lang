// Reads the files named on the command line and decodes each with the std:meta codec (library/std/metajson.or):
//   codec_check input  <file.jsonl>   every line must be an `Input` (what `orin expand --input` prints)
//   codec_check output <file.json>    the file must be an `Output` (a recorded output of the test hook)
// Prints `ok` per decoded document, or the decoder's error with its path, and exits 1 on the first failure. tools/test_expand.py
// uses it to prove that the compiler side (compiler/meta) and the std:meta side agree on the encoding.
import { decodeInput, decodeOutput } from "std:meta";
import { Host, withHost } from "std:host";
import { readFile, fsErrorMessage } from "std:fs";
import { args, exit } from "std:process";

function main(host: Host): void {
  withHost(
    host,
    (fs, proc, stdio, clock) => {
      const a = args(proc);
      if (a.length != 2) {
        console.error("usage: codec_check input|output <file>");
        exit(2);
        return;
      }
      const text = readFile(fs, a[1]);
      if (text.isErr()) {
        console.error("cannot read " + a[1] + ": " + fsErrorMessage(text.unwrapErr()));
        exit(2);
        return;
      }
      if (a[0] == "output") {
        const r = decodeOutput(text.unwrap());
        if (r.isErr()) {
          console.error(a[1] + ": " + r.unwrapErr());
          exit(1);
          return;
        }
        console.log("ok");
        return;
      }
      for (const line of text.unwrap().split("\n")) {
        if (line != "") {
          const r = decodeInput(line);
          if (r.isErr()) {
            console.error(a[1] + ": " + r.unwrapErr());
            exit(1);
            return;
          }
          console.log("ok");
        }
      }
    },
  );
}
