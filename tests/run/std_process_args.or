import { Host, withHost } from "std:host";
import { ProcessGrant } from "std:process";
import { args } from "std:process";

function main(host: Host): void {
  withHost(host, (fs, proc, stdio, clock) => { run(proc); });
}
function run(proc: ProcessGrant): void {
  const a = args(proc);
  console.log("args: " + a.length.toString());
  for (const x of a) {
    console.log(x);
  }
  console.log("done");
}
