// A private field of an exported class may have a private type; the class and its public API do not leak it (E0306 is for signatures).
type Hidden = { n: int; };

export class Box {
  private h: Hidden = Hidden { n: 41 };

  bump(): int {
    return this.h.n + 1;
  }
}

function main() {
  const b = new Box();
  console.log(b.bump().toString());
}
