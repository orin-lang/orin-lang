import { Host, withFs } from "std:host";
import { FsGrant } from "std:fs";
import { readFile, writeFile, exists, FsError, fsErrorMessage } from "std:fs";

const PATH: string = "build/tests/tmp_std_fs.txt";

function roundtrip(fs: FsGrant, path: string, data: string): Result<string, FsError> {
  writeFile(fs, path, data)?;
  const back = readFile(fs, path)?;
  return Ok(back);
}

function main(host: Host): void {
  withFs(host, fs => { run(fs); });
}
function run(fs: FsGrant): void {
  console.log(writeFile(fs, PATH, "alpha\nbeta").isOk().toString());
  console.log(exists(fs, PATH).unwrap().toString());
  match (readFile(fs, PATH)) {
    Ok(s) => {
      console.log(s.length.toString());
      const parts = s.split("\n");
      console.log(parts.length.toString());
      console.log(parts[0]);
      console.log(parts[1]);
    },
    Err(e) => { console.log("read failed: " + fsErrorMessage(e)); },
  }
  match (roundtrip(fs, PATH, "gamma")) {
    Ok(s) => { console.log(s); },
    Err(e) => { console.log("err " + fsErrorMessage(e)); },
  }
  console.log(readFile(fs, "build/tests/definitely_missing_file.txt").isErr().toString());
  console.log(exists(fs, "build/tests/definitely_missing_file.txt").unwrap().toString());
  console.log(writeFile(fs, "build/tests/no_such_dir/x.txt", "x").isErr().toString());
}
