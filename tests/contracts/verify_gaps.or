// Inputs for tools/test_verify_contracts.py: places where the verifier used to give up with UNKNOWN on code that is inside the
// fragment (ADR-0053 Addendum A).
// 1. A `match` statement whose arms all `return` ends the function: the path "no arm matched" is impossible (the match is
//    exhaustive) and does not fall off the end. The function used to be UNKNOWN: "return statements do not match the declared
//    result type". A wrong claim about such a function is still REFUTED.
// expect: oneOfTwo ensures VERIFIED
// expect: oneOfTwoWrong ensures REFUTED
// expect: wildArm ensures VERIFIED
// expect: wildArmWrong ensures REFUTED
// expect: shapeArea ensures VERIFIED
// expect: shapeAreaWrong ensures REFUTED
// expect: shapeResult ensures VERIFIED
// expect: shapeResultWrong ensures REFUTED
// expect: nested ensures VERIFIED
// expect: nestedWrong ensures REFUTED
// expect: fallsToTail ensures VERIFIED
// expect: fallsToTailWrong ensures REFUTED
// 2. A parameter, field or result of an interface type is an opaque value (nothing is known about it): a class converts to
//    it implicitly at a call (ADR-0019) and the callee can store and pass it on. Before, every function taking one was
//    "outside the fragment".
// expect: Impl.make ensures VERIFIED
// expect: Impl.makeWrong ensures REFUTED
// expect: build ensures VERIFIED
// expect: buildWrong ensures REFUTED
// expect: pass ensures VERIFIED
// expect: passWrong ensures REFUTED

type Shape = Circle(int) | Square(int);

@Ensures(result >= 1 && result <= 2)
function oneOfTwo(o: Option<int>): int {
  match (o) {
    Some(t) => { return 1; },
    None => { return 2; },
  }
}

@Ensures(result == 1)
function oneOfTwoWrong(o: Option<int>): int {
  match (o) {
    Some(t) => { return 1; },
    None => { return 2; },
  }
}

@Ensures(result == 7)
function wildArm(n: int): int {
  match (n) {
    1 => { return 7; },
    _ => { return 7; },
  }
}

@Ensures(result == 7)
function wildArmWrong(n: int): int {
  match (n) {
    1 => { return 7; },
    _ => { return 8; },
  }
}

@Ensures(result >= 0)
function shapeArea(s: Shape): int {
  match (s) {
    Circle(r) => { return 3; },
    Square(a) => { return 4; },
  }
}

@Ensures(result >= 4)
function shapeAreaWrong(s: Shape): int {
  match (s) {
    Circle(r) => { return 3; },
    Square(a) => { return 4; },
  }
}

@Ensures(result.isOk() ==> result.unwrap() == 1)
function shapeResult(s: Shape): Result<int, string> {
  match (s) {
    Circle(r) => { return Ok(1); },
    _ => { return Err("square"); },
  }
}

@Ensures(result.isOk() ==> result.unwrap() == 2)
function shapeResultWrong(s: Shape): Result<int, string> {
  match (s) {
    Circle(r) => { return Ok(1); },
    _ => { return Err("square"); },
  }
}

@Ensures(result >= 1 && result <= 3)
function nested(o: Option<Shape>): int {
  match (o) {
    Some(s) => {
      match (s) {
        Circle(r) => { return 1; },
        Square(a) => { return 2; },
      }
    },
    None => { return 3; },
  }
}

@Ensures(result <= 2)
function nestedWrong(o: Option<Shape>): int {
  match (o) {
    Some(s) => {
      match (s) {
        Circle(r) => { return 1; },
        Square(a) => { return 2; },
      }
    },
    None => { return 3; },
  }
}

@Ensures(result == 5)
function fallsToTail(o: Option<int>): int {
  match (o) {
    Some(t) => { return 5; },
    None => {},
  }
  return 5;
}

@Ensures(result == 6)
function fallsToTailWrong(o: Option<int>): int {
  match (o) {
    Some(t) => { return 5; },
    None => {},
  }
  return 5;
}

interface Sink {
  put(x: int): int;
}

class Worker {
  constructor(public n: int, private sink: Sink) {}
}

class Impl implements Sink {
  put(x: int): int {
    return x + 1;
  }

  @Ensures(result.n == 5)
  make(): Worker {
    return new Worker(5, this);
  }

  @Ensures(result.n == 6)
  makeWrong(): Worker {
    return new Worker(5, this);
  }
}

@Ensures(result.n == k)
function build(k: int, s: Sink): Worker {
  return new Worker(k, s);
}

@Ensures(result.n == k + 1)
function buildWrong(k: int, s: Sink): Worker {
  return new Worker(k, s);
}

@Ensures(result == k)
function pass(k: int, s: Sink): int {
  const t: Sink = s;
  return k;
}

@Ensures(result == k + 1)
function passWrong(k: int, s: Sink): int {
  const t: Sink = s;
  return k;
}

function main(): void {}
