// expect: lit_chr_wrong ensures UNKNOWN

// `pop` returns the last element and drops it: the length goes down by one and the prefix is unchanged.
@Requires(xs.length > 0)
@Ensures(result.length == xs.length - 1)
function pop_len(xs: int[]): int[] {
  let ys = xs;
  ys.pop().unwrap();
  return ys;
}

@Requires(xs.length > 0)
@Ensures(result == xs[xs.length - 1])
function pop_last(xs: int[]): int {
  let ys = xs;
  const x = ys.pop().unwrap();
  return x;
}

@Requires(xs.length > 1)
@Ensures(result.length == xs.length - 1)
@Ensures(result[0] == xs[0])
function pop_prefix(xs: int[]): int[] {
  let ys = xs;
  ys.pop().unwrap();
  return ys;
}

// Wrong: nothing says the array is not empty (the `unwrap` is REFUTED; the ensures hold on the paths that return).
@Ensures(result.length + 1 == xs.length)
function pop_empty(xs: int[]): int[] {
  let ys = xs;
  ys.pop().unwrap();
  return ys;
}

// Wrong: the array is one shorter, not as long.
@Requires(xs.length > 0)
@Ensures(result.length == xs.length)
function pop_wrong(xs: int[]): int[] {
  let ys = xs;
  ys.pop().unwrap();
  return ys;
}

// A work list: pop until it is empty (the loop condition is the non-emptiness the `unwrap` needs).
@Ensures(result == xs.length)
function pop_loop(xs: usize[]): usize {
  let work = xs;
  let n: usize = 0;
  @Invariant(work.length + n == xs.length)
  while (work.length > 0) {
    work.pop().unwrap();
    n += 1;
  }
  return n;
}

function cmpInt(a: int, b: int): int {
  return a - b;
}

// `sort` is a permutation: the length and the members are those of the receiver.
@Ensures(result.length == xs.length)
function sort_len(xs: int[]): int[] {
  return xs.sort(cmpInt);
}

@Ensures(result.every(y => xs.includes(y)) && xs.every(x => result.includes(x)))
function sort_members(xs: int[]): int[] {
  return xs.sort(cmpInt);
}

@Requires(xs.length > 0)
@Ensures(xs.includes(result))
function sort_first(xs: int[]): int {
  return xs.sort(cmpInt)[0];
}

// The order is not modelled: not proved, and not refuted either.
@Requires(xs.length > 1)
@Ensures(result[0] <= result[1])
function sort_sorted_unknown(xs: int[]): int[] {
  return xs.sort(cmpInt);
}

@Ensures(result.length == xs.length + 1)
function sort_len_wrong(xs: int[]): int[] {
  return xs.sort(cmpInt);
}

// `findIndex` / `find`: the first match, exactly.
@Ensures(result.isSome() ==> result.unwrap() < xs.length)
function find_idx_in_range(xs: int[]): Option<usize> {
  return xs.findIndex(x => x > 3);
}

@Ensures(result.isSome() ==> xs[result.unwrap()] > 3)
function find_idx_match(xs: int[]): Option<usize> {
  return xs.findIndex(x => x > 3);
}

@Ensures(result.isNone() ==> xs.every(x => x <= 3))
function find_idx_none(xs: int[]): Option<usize> {
  return xs.findIndex(x => x > 3);
}

// Wrong: a match may exist at any position, not only at 0.
@Ensures(result.isSome() ==> result.unwrap() == 0)
function find_idx_wrong(xs: int[]): Option<usize> {
  return xs.findIndex(x => x > 3);
}

@Ensures(result.isSome() ==> result.unwrap() > 3)
function find_some(xs: int[]): Option<int> {
  return xs.find(x => x > 3);
}

@Ensures(result.isSome() ==> xs.includes(result.unwrap()))
function find_member(xs: int[]): Option<int> {
  return xs.find(x => x > 3);
}

// Wrong: a smaller element may be found.
@Ensures(result.isSome() ==> result.unwrap() > 4)
function find_wrong(xs: int[]): Option<int> {
  return xs.find(x => x > 3);
}

// `reduce`: only the empty case is stated.
@Requires(xs.length == 0)
@Ensures(result == 7)
function reduce_empty(xs: int[]): int {
  return xs.reduce((acc: int, x: int) => acc + x, 7);
}

@Ensures(result >= 0)
function reduce_unknown(xs: int[]): int {
  return xs.reduce((acc: int, x: int) => acc + x, 0);
}

// `split`: at least one piece; the pieces are not longer than the string.
@Ensures(result.length >= 1)
function split_nonempty(s: string): string[] {
  return s.split(",");
}

@Ensures(result.length <= s.length)
function split_first(s: string): string {
  return s.split(",")[0];
}

@Ensures(result.length >= 1 && result.length <= s.length + 1)
function split_two(s: string): string[] {
  return s.split("::");
}

@Requires(s.length == 0)
@Ensures(result.length == 1 && result[0].length == 0)
function split_short(s: string): string[] {
  return s.split(",");
}

// Wrong: a string with a separator has more pieces.
@Ensures(result.length == 1)
function split_wrong(s: string): string[] {
  return s.split(",");
}

// An empty separator traps.
@Ensures(result.length >= 1)
function split_sep(s: string, sep: string): string[] {
  return s.split(sep);
}

@Requires(sep.length > 0)
@Ensures(result.length >= 1)
function split_sep_ok(s: string, sep: string): string[] {
  return s.split(sep);
}

// `indexOf`: a position leaves room for the needle; the empty needle is at 0; a longer needle is not found.
@Ensures(result.isSome() ==> result.unwrap() + x.length <= s.length)
function index_of_room(s: string, x: string): Option<usize> {
  return s.indexOf(x);
}

@Requires(x.length == 0)
@Ensures(result.isSome() && result.unwrap() == 0)
function index_of_empty(s: string, x: string): Option<usize> {
  return s.indexOf(x);
}

@Requires(x.length > s.length)
@Ensures(result.isNone())
function index_of_long(s: string, x: string): Option<usize> {
  return s.indexOf(x);
}

// Wrong: the needle may be found.
@Ensures(result.isNone())
function index_of_wrong(s: string, x: string): Option<usize> {
  return s.indexOf(x);
}

function main(): void {
  console.log("verify_methods");
}

// `startsWith` / `endsWith` / `includes` are functions of the two strings: a test in the body and the same test in a
// contract agree, with the length / empty / equal / prefix-implies-substring axioms.
@Ensures(p.startsWith("$") ==> result == "")
function sw_same(p: string): string {
  if (p.startsWith("$")) {
    return "";
  }
  return p;
}

@Ensures(result ==> s.length >= t.length)
function sw_len(s: string, t: string): bool {
  return s.endsWith(t);
}

@Requires(t.length == 0)
@Ensures(result)
function sw_empty(s: string, t: string): bool {
  return s.includes(t);
}

@Ensures(result ==> s.includes(t))
function sw_includes(s: string, t: string): bool {
  return s.startsWith(t);
}

@Ensures(result == xs.every(x => x.startsWith("a")))
function sw_every(xs: string[]): bool {
  return xs.every(x => x.startsWith("a"));
}

// Wrong in general: not proved, not refuted (contents are not modelled).
@Ensures(result)
function sw_wrong(s: string, t: string): bool {
  return s.startsWith(t);
}

// Literal contents: the bytes of a short literal are known to `charCodeAt` (a call's precondition on a code literal).
@Ensures(result == (c.length == 5 && (c.charCodeAt(0) == 69 || c.charCodeAt(0) == 87)))
function is_code(c: string): bool {
  return c.length == 5 && (c.charCodeAt(0) == 69 || c.charCodeAt(0) == 87);
}

@Requires(is_code(c))
@Ensures(result == c.length)
function use_code(c: string): usize {
  return c.length;
}

@Ensures(result == 5)
function lit_code_ok(): usize {
  return use_code("E0412");
}

// Wrong: `X` is not a code letter (the precondition is not proved).
@Ensures(result == 5)
function lit_code_bad(): usize {
  return use_code("X0412");
}

@Ensures(result == 87)
function lit_chr_local(): int {
  const w = "W12";
  return w.charCodeAt(0);
}

// Wrong: the byte is 69, not 70.
@Ensures(result == 70)
function lit_chr_wrong(): int {
  return "E0001".charCodeAt(0);
}
