// Inputs for tools/test_verify_contracts.py: class invariants in private methods (ADR-0031 B8, ADR-0053 Addendum A).
// A private method may be called in the middle of an update of its object, so the invariants are not assumed on entry. A private
// method with a result that is not proved assumes them anyway when EVERY call of it proves them in the state of the call (hidden
// `invariant-site` obligations of the callers) and every mention of its name in the class is such a call. Otherwise nothing changes.
//
// Callers prove the invariant: the index bound the helper needs follows from it.
// expect: Cur.constructor invariant VERIFIED
// expect: Cur.peek bounds VERIFIED
// expect: Cur.peek ensures VERIFIED
// expect: Cur.step ensures VERIFIED
// expect: Cur.step invariant VERIFIED
// expect: Cur.read ensures VERIFIED
// expect: Cur.viaChain ensures VERIFIED
// A helper reached through another helper; the chain starts in public methods.
// expect: Cur.second bounds VERIFIED
// expect: Cur.second ensures VERIFIED
// expect: Cur.first ensures VERIFIED
// A wrong claim about an eligible helper is REFUTED, not VERIFIED, even with the invariant assumed.
// expect: Cur.peekWrong bounds VERIFIED
// expect: Cur.peekWrong ensures REFUTED
// expect: Cur.useWrong ensures VERIFIED
// One call in the middle of an update (the invariant does not hold there): the helper keeps the old verdict.
// expect: Mid.constructor invariant VERIFIED
// expect: Mid.at bounds REFUTED
// expect: Mid.at ensures VERIFIED
// expect: Mid.good ensures VERIFIED
// expect: Mid.bad ensures VERIFIED
// expect: Mid.bad invariant VERIFIED
// A mention that is not a call (here in a contract of another method) makes the helper not eligible.
// expect: Spec.constructor invariant VERIFIED
// expect: Spec.at bounds REFUTED
// expect: Spec.at ensures VERIFIED
// expect: Spec.read ensures VERIFIED
// A helper that nothing calls is never run: it assumes the invariants (vacuously).
// expect: Dead.constructor invariant VERIFIED
// expect: Dead.at bounds VERIFIED
// expect: Dead.at ensures VERIFIED

@Invariant(this.pos < this.xs.length)
class Cur {
  xs: int[];
  pos: usize;

  @Requires(xs.length > 0)
  constructor(xs: int[]) {
    this.xs = xs;
    this.pos = 0;
  }

  @Ensures(result == this.xs[this.pos])
  private peek(): int {
    return this.xs[this.pos];
  }

  @Ensures(result == this.xs[this.pos])
  read(): int {
    return this.peek();
  }

  @Ensures(result == old(this.xs[this.pos]))
  step(): int {
    const v = this.peek();
    if (this.pos + 1 < this.xs.length) {
      this.pos += 1;
    }
    return v;
  }

  @Ensures(result == this.xs[this.pos])
  private second(): int {
    return this.xs[this.pos];
  }

  @Ensures(result == this.xs[this.pos])
  private first(): int {
    return this.second();
  }

  @Ensures(result == this.xs[this.pos])
  viaChain(): int {
    return this.first();
  }

  @Ensures(result == this.xs[this.pos] + 1)
  private peekWrong(): int {
    return this.xs[this.pos];
  }

  @Ensures(result == this.xs[this.pos] + 1)
  useWrong(): int {
    return this.peekWrong();
  }
}

@Invariant(this.pos < this.xs.length)
class Mid {
  xs: int[];
  pos: usize;

  @Requires(xs.length > 0)
  constructor(xs: int[]) {
    this.xs = xs;
    this.pos = 0;
  }

  @Ensures(result == this.xs[this.pos])
  private at(): int {
    return this.xs[this.pos];
  }

  @Ensures(result == this.xs[this.pos])
  good(): int {
    return this.at();
  }

  // The call happens while `pos` is out of range: the invariant does not hold there.
  @Ensures(this.pos == old(this.pos))
  bad(): int {
    const keep = this.pos;
    this.pos = this.xs.length;
    const v = this.at();
    this.pos = keep;
    return v;
  }
}

@Invariant(this.pos < this.xs.length)
class Spec {
  xs: int[];
  pos: usize;

  @Requires(xs.length > 0)
  constructor(xs: int[]) {
    this.xs = xs;
    this.pos = 0;
  }

  @Ensures(result == this.xs[this.pos])
  private at(): int {
    return this.xs[this.pos];
  }

  @Ensures(result == this.at())
  read(): int {
    return this.at();
  }
}

@Invariant(this.pos < this.xs.length)
class Dead {
  xs: int[];
  pos: usize;

  @Requires(xs.length > 0)
  constructor(xs: int[]) {
    this.xs = xs;
    this.pos = 0;
  }

  @Ensures(result == this.xs[this.pos])
  private at(): int {
    return this.xs[this.pos];
  }
}

function main(): void {}
