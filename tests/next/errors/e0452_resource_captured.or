// error: E0452
// a closure cannot capture a handle
import { Host, withFs } from "std:host";
import { FsGrant } from "std:fs";
import { withFile, useFile, Read, Write, File } from "std:fs";
function main(host: Host): void {
  withFs(host, fs => { run(fs); });
}
function run(fs: FsGrant): void {
  const r = useFile(fs, "build/tests/x.txt", Read, f => {
    const h = () => f.readAll();
    const s = h();
  });
}
