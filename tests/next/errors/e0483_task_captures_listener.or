// error: E0483
// A Listener stays in the task that bound it: a task body cannot capture it (accept in the owning task and move the Stream).
import { Host, withNet } from "std:host";
import { Scope, scopeNetDo, spawn } from "std:task";
import { NetGrant, Listener, withListener, withAccepted, portOf } from "std:net";

function main(host: Host): void {
  withNet(host, net => {
    scopeNetDo(net, (sc: Scope, g: NetGrant) => {
      withListener(g, "127.0.0.1", 0, 4, (ln: Listener) => {
        const h = spawn(sc, () => portOf(ln));
      });
    });
  });
}
