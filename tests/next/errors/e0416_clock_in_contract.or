// error: E0416
// Reading the clock is I/O: a helper that calls nowMillis is impure and cannot appear in a contract.
import { Host, withHost } from "std:host";
import { ClockGrant } from "std:time";
import { nowMillis } from "std:clock";

function recent(clock: ClockGrant, t: int): bool {
  return nowMillis(clock) - t < 1000;
}

@Requires(recent(clock, t))
function check(clock: ClockGrant, t: int): int {
  return t;
}

function main(host: Host): void {
  withHost(host, (fs, proc, stdio, clock) => { console.log(check(clock, 0).toString()); });
}
