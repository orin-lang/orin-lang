// error: E0452
// in particular a nested scope cannot use the handle of the outer one
import { Host, withFs } from "std:host";
import { FsGrant } from "std:fs";
import { withFile, Read, Write, File } from "std:fs";
function main(host: Host): void {
  withFs(host, fs => { run(fs); });
}
function run(fs: FsGrant): void {
  const r = withFile(fs, "build/tests/x.txt", Read, f => {
    const q = withFile(fs, "build/tests/y.txt", Write, g => { g.write(f.readAll()); });
  });
}
