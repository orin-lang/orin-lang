// error: E0471
// A grant of the wrong family (a ClockGrant where a NetGrant is needed).
import { Host, withHost } from "std:host";
import { useListener, Listener } from "std:net";
function main(host: Host): void {
  withHost(host, (fs, proc, stdio, clock) => {
    const r = useListener(clock, "127.0.0.1", 0, 4, (ln: Listener) => {});
  });
}
