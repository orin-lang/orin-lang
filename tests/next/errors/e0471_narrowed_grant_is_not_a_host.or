// error: E0471
// CAP-5: a narrowed grant cannot be turned back into a wider one: the only source of a file grant is the `Host`.
import { Host, useFs } from "std:host";
import { withReadOnly } from "std:fs";

function main(host: Host): void {
  useFs(host, fs => {
    withReadOnly(fs, ro => {
      useFs(ro, wide => {
        console.log("widened");
      });
    });
  });
}
