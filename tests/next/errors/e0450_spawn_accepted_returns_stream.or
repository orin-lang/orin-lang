// error: E0450
// The body of spawnAccepted cannot hand the Stream back as the task's result: a handle is not a value.
import { Host, withNet } from "std:host";
import { milliseconds } from "std:time";
import { Scope, scopeNetDo } from "std:task";
import { NetGrant, Listener, Stream, useListener, spawnAccepted } from "std:net";

function main(host: Host): void {
  withNet(host, net => {
    scopeNetDo(net, (sc: Scope, g: NetGrant) => {
      useListener(g, "127.0.0.1", 0, 4, (ln: Listener) => {
        spawnAccepted(sc, ln, milliseconds(100), (s: Stream, p) => s);
      });
    });
  });
}
