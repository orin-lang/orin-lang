// error: E0483
// An accepted Stream is a resource handle of the accepting task: a task body cannot capture it. The connection is MOVED into
// a task with spawnAccepted (or acceptDetached + serveAccepted), never copied by capture (ADR-0017 Addendum C).
import { Host, useNet } from "std:host";
import { milliseconds } from "std:time";
import { Scope, scopeNetDo, spawn } from "std:task";
import { NetGrant, Listener, Stream, useListener, useAccepted, recv } from "std:net";

function main(host: Host): void {
  useNet(host, net => {
    scopeNetDo(net, (sc: Scope, g: NetGrant) => {
      useListener(g, "127.0.0.1", 0, 4, (ln: Listener) => {
        useAccepted(ln, milliseconds(100), (s: Stream, p) => {
          const h = spawn(sc, () => match (recv(s, 10, milliseconds(10))) { Ok(b) => true, Err(e) => false });
        });
      });
    });
  });
}
