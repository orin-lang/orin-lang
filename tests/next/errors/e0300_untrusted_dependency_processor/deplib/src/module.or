// A dependency that ships an annotation with its processor (ADR-0046 §2, trust policy).
import { Input, Output, MDecl, fn, named, ret, str, exportDecl, output } from "std:meta";

@Annotation(type)
export type Describe = { };

@Processor(Describe)
export function describeProc(input: Input): Output {
  let decls: MDecl[] = [];
  for (const d of input.decls) {
    decls.push(exportDecl(fn("describe" + d.name, [], named("string"), [ret(str("generated for " + d.name))]), true));
  }
  return output(decls);
}
