import { Input, Output, output } from "std:meta";

@Annotation(type)
export type Noisy = { };

function shout(text: string): void {
  console.log(text);
}

// Not pure: it calls a function that performs I/O.
@Processor(Noisy)
export function noisyProc(input: Input): Output {
  shout("generating");
  return output([]);
}
