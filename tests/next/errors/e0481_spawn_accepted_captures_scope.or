// error: E0481
// The body of spawnAccepted is a task body: it cannot capture the Scope it is spawned in.
import { Host, withNet } from "std:host";
import { milliseconds } from "std:time";
import { Scope, scopeNetDo, spawnDo } from "std:task";
import { NetGrant, Listener, Stream, useListener, spawnAcceptedDo } from "std:net";

function main(host: Host): void {
  withNet(host, net => {
    scopeNetDo(net, (sc: Scope, g: NetGrant) => {
      useListener(g, "127.0.0.1", 0, 4, (ln: Listener) => {
        spawnAcceptedDo(sc, ln, milliseconds(100), (s: Stream, p) => {
          spawnDo(sc, () => { });
        });
      });
    });
  });
}
