// error: E0483
// A NetGrant is delegated with spawnNet (a fresh grant of the same scope is moved in), never captured.
import { Host, withNet } from "std:host";
import { milliseconds } from "std:time";
import { Scope, scopeNetDo, spawn } from "std:task";
import { NetGrant, withConnection, Stream } from "std:net";

function main(host: Host): void {
  withNet(host, net => {
    scopeNetDo(net, (sc: Scope, g: NetGrant) => {
      const h = spawn(sc, () => withConnection(g, "127.0.0.1", 1, milliseconds(100), (s: Stream) => { }).isOk());
    });
  });
}
