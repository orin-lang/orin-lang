// std:net on the loopback interface, one process: a listener, a client that connects (the kernel completes the handshake
// before accept), accept, byte exchange, partial reads, readExact / readUntil, half-close, timeouts, scope refusals.
import { Host, useNet } from "std:host";
import { milliseconds } from "std:time";
import { Bytes, fromString, fromArray } from "std:bytes";
import {
  NetGrant, Listener, Stream, useListenerNet, useAccepted, useConnection, useConnectionBeside, useListen, useConnect, withConnect, portOf, recv, sendAll,
  shutdownWrite, StreamReader, Fill, NetError, isClosed, isTimeout, isReset, isDenied, resolve, monotonicMillis, netErrorMessage
} from "std:net";

function say(label: string, ok: bool): void {
  console.log(label + ": " + (ok ? "ok" : "FAIL"));
}

function kind(r: Result<Bytes, NetError>): string {
  return match (r) {
    Ok(b) => "data " + b.length().toString(),
    Err(e) => isClosed(e) ? "eof" : isTimeout(e) ? "timeout" : isReset(e) ? "reset" : "error " + netErrorMessage(e)
  };
}

function text(b: Bytes): string {
  return b.toRawString();
}

function serve(ln: Listener, net: NetGrant): void {
  const port = portOf(ln);
  say("port", port > 0);
  const r = useConnectionBeside(net, "127.0.0.1", port, milliseconds(2000), ln, (c: Stream, ln2: Listener) => {
    const sent = sendAll(c, fromString("hello world\r\nrest"), milliseconds(1000));
    say("sendAll", sent.isOk());
    // the server side: accept the queued connection
    const a = useAccepted(ln2, milliseconds(1000), (s: Stream, peer) => {
      say("peer", peer.host == "127.0.0.1" && peer.port > 0);
      // a recv never returns more than asked for
      const r1 = recv(s, 4, milliseconds(1000));
      console.log("recv cap 4: " + kind(r1));
      let rd = new StreamReader(1024);
      const line = rd.readUntil(s, fromString("\r\n"), 100, milliseconds(1000));
      match (line) {
        Ok(Filled(b)) => { console.log("line: " + text(b).length.toString()); },
        _ => { console.log("line: FAIL"); }
      }
      // nothing more to read: a bounded wait times out, it does not hang
      const t0 = monotonicMillis(s);
      const idle = recv(s, 10, milliseconds(50));
      console.log("idle: " + kind(idle));
      say("waited", monotonicMillis(s) - t0 >= 40);
      // the client half-closes: EOF after the remaining bytes
      const rest = rd.readExact(s, 4, milliseconds(1000));
      match (rest) {
        Ok(Filled(b)) => { console.log("rest: " + text(b)); },
        Ok(FillClosed(b)) => { console.log("rest closed: " + text(b)); },
        _ => { console.log("rest: FAIL"); }
      }
      say("shutdown", shutdownWrite(s).isOk());
    });
    say("accept", a.isOk());
    const after = recv(c, 10, milliseconds(1000));
    console.log("client sees: " + kind(after));
  });
  say("connection", r.isOk());
  // a limit is a limit
  const r2 = useConnectionBeside(net, "127.0.0.1", port, milliseconds(2000), ln, (c: Stream, ln2: Listener) => {
    sendAll(c, fromString("0123456789"), milliseconds(1000));
    useAccepted(ln2, milliseconds(1000), (s: Stream, peer) => {
      let rd = new StreamReader(64);
      const f = rd.readUntil(s, fromString("\n"), 5, milliseconds(500));
      match (f) {
        Ok(FillLimit) => { console.log("limit: ok"); },
        _ => { console.log("limit: FAIL"); }
      }
      say("buffered at most the limit", rd.buffered().length() <= 5);
    });
  });
  say("limit connection", r2.isOk());
  // accept with nobody connecting: a timeout error
  const none = useAccepted(ln, milliseconds(30), (s: Stream, peer) => { console.log("unexpected"); });
  say("accept timeout", none.isErr() && isTimeout(none.unwrapErr()));
}

function main(host: Host): void {
  useNet(host, net => {
    const l = useListenerNet(net, "127.0.0.1", 0, 16, (ln, n) => { serve(ln, n); });
    say("listen", l.isOk());
    // a connect to a port nobody listens on is refused (the OS), and times out or fails, never hangs
    const refused = useConnection(net, "127.0.0.1", 1, milliseconds(500), (c: Stream) => { console.log("unexpected"); });
    say("refused", refused.isErr());
    // resolve
    const rr = resolve(net, "localhost");
    say("resolve", rr.isOk() && rr.unwrap().length > 0);
  });
  // narrowing never widens
  useNet(host, net => {
    useConnect(net, "*.example.com", 80, 443, c => {
      const a = useConnection(c, "127.0.0.1", 80, milliseconds(200), (s: Stream) => { console.log("unexpected"); });
      say("connect outside the granted pattern", a.isErr() && isDenied(a.unwrapErr()));
      const b = resolve(c, "localhost");
      say("resolve outside the granted pattern", b.isErr() && isDenied(b.unwrapErr()));
      useConnect(c, "*", 0, 65535, c2 => {
        const w = useConnection(c2, "127.0.0.1", 80, milliseconds(200), (s: Stream) => { console.log("unexpected"); });
        say("widened pattern is refused", w.isErr() && isDenied(w.unwrapErr()));
      });
    });
    useListen(net, "127.0.0.1", 0, l => {
      const a = useConnection(l, "127.0.0.1", 80, milliseconds(200), (s: Stream) => { console.log("unexpected"); });
      say("a listen grant cannot connect", a.isErr() && isDenied(a.unwrapErr()));
      useListen(l, "0.0.0.0", 0, l2 => {
        const w = useListenerNet(l2, "0.0.0.0", 0, 4, (ln, n) => { console.log("unexpected"); });
        say("widened listen address is refused", w.isErr() && isDenied(w.unwrapErr()));
      });
    });
  });
}
