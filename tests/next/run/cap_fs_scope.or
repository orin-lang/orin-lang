// A narrowed file grant cannot reach outside its scope (ADR-0027, ADR-0021 acceptance test 2): `..`, an absolute path,
// a symbolic link to a directory / a file outside, and a dangling link are refused by the runtime; the platform layer
// does the path work. Not covered (documented): races between check and open, hard links, mounts.
import { Host, withHost } from "std:host";
import { FsGrant, FsError, fsErrorMessage, readFile, writeFile, exists, withFile, useUnder, Read } from "std:fs";
import { ProcessGrant } from "std:process";
import { shell } from "std:io";

const ROOT: string = "build/tests/cap_scope";

function setup(proc: ProcessGrant): void {
  shell(proc, "rm -rf build/tests/cap_scope && mkdir -p build/tests/cap_scope/in build/tests/cap_scope/out"
    + " && echo inside > build/tests/cap_scope/in/a.txt && echo secret > build/tests/cap_scope/out/s.txt"
    + " && ln -s ../out build/tests/cap_scope/in/escape && ln -s ../out/s.txt build/tests/cap_scope/in/flink"
    + " && ln -s ../out/nothing build/tests/cap_scope/in/dangling && ln -s . build/tests/cap_scope/in/self");
}

function show(label: string, r: Result<string, FsError>): void {
  console.log(label + ": " + (r.isOk() ? "ok " + r.unwrap().trim() : fsErrorMessage(r.unwrapErr())));
}

function showW(label: string, r: Result<void, FsError>): void {
  console.log(label + ": " + (r.isOk() ? "ok" : fsErrorMessage(r.unwrapErr())));
}

function probe(sub: FsGrant): void {
  show("inside", readFile(sub, ROOT + "/in/a.txt"));
  show("inside through a link that stays inside", readFile(sub, ROOT + "/in/self/a.txt"));
  show("dot-dot", readFile(sub, ROOT + "/in/../out/s.txt"));
  show("dot-dot twice", readFile(sub, ROOT + "/in/x/../../out/s.txt"));
  show("absolute outside", readFile(sub, "/etc/passwd"));
  show("link to a directory outside", readFile(sub, ROOT + "/in/escape/s.txt"));
  show("link to a file outside", readFile(sub, ROOT + "/in/flink"));
  showW("create below a link outside", writeFile(sub, ROOT + "/in/escape/new.txt", "x"));
  showW("create through a dangling link", writeFile(sub, ROOT + "/in/dangling", "x"));
  showW("create inside", writeFile(sub, ROOT + "/in/new.txt", "x"));
  console.log("exists inside: " + exists(sub, ROOT + "/in/a.txt").unwrap().toString());
  const o = withFile(sub, ROOT + "/out/s.txt", Read, f => f.readAll());
  console.log("open outside: " + (o.isErr() ? fsErrorMessage(o.unwrapErr()) : "OPENED"));
  const o2 = withFile(sub, ROOT + "/in/a.txt", Read, f => f.readAll().trim());
  console.log("open inside: " + o2.unwrap());
}

function main(host: Host): void {
  withHost(host, (fs, proc, stdio, clock) => { run(fs, proc); });
}

function run(fs: FsGrant, proc: ProcessGrant): void {
  setup(proc);
  useUnder(fs, ROOT + "/in", sub => { probe(sub); });
  // the secret was never written through the escapes
  console.log("escape file created: " + exists(fs, ROOT + "/out/new.txt").unwrap().toString() + " " + exists(fs, ROOT + "/out/nothing").unwrap().toString());
}
