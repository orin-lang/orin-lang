// std:task timed join with a void task (ADR-0040 + C1): TaskHandle<void>.joinTimeout returns Result<void, TaskError>.
import { Host, withClock } from "std:host";
import { seconds } from "std:time";
import { scopeClock, taskErrorMessage } from "std:task";

function main(host: Host): void {
  withClock(host, clock => {
    scopeClock(clock, (s, c) => {
      const h = s.spawn(() => console.log("void task"));
      const r = h.joinTimeout(c, seconds(30));
      console.log(r.isOk() ? "ok" : "err " + taskErrorMessage(r.unwrapErr()));
    });
  });
}
