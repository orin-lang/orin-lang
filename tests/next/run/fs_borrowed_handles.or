// A File is passed to functions (borrowed): helpers, recursion, function values taking a File.
import { Host, useFs } from "std:host";
import { FsGrant } from "std:fs";
import { withFile, Read, Write, File } from "std:fs";

const PATH: string = "build/tests/fs_borrowed_handles.txt";

function writeNumbers(f: File, n: int): void {
  let i: int = 1;
  while (i <= n) {
    f.writeLine(i.toString());
    i += 1;
  }
}

function sum(f: File): int {
  let total: int = 0;
  while (true) {
    const l = f.readLine();
    if (l.isNone()) {
      return total;
    }
    total += parseInt(l.unwrap()).unwrapOr(0);
  }
  return total;
}

// recursion on a borrowed handle
function countLines(f: File, acc: int): int {
  const l = f.readLine();
  if (l.isNone()) {
    return acc;
  }
  return countLines(f, acc + 1);
}

function lines(f: File): string[] {
  let out: string[] = [];
  while (true) {
    const l = f.readLine();
    if (l.isNone()) {
      return out;
    }
    out.push(l.unwrap());
  }
  return out;
}

// the handle can be passed on to several callees, in any order, any number of times
function twice(f: File): string {
  const a = f.readLine().unwrapOr("?");
  const b = f.readLine().unwrapOr("?");
  return a + b;
}

function apply(f: File, g: (h: File) => int): int {
  return g(f);
}

function main(host: Host): void {
  useFs(host, fs => { run(fs); });
}
function run(fs: FsGrant): void {
  withFile(fs, PATH, Write, f => { writeNumbers(f, 10); }).unwrap();
  console.log("sum " + withFile(fs, PATH, Read, f => sum(f)).unwrap().toString());
  console.log("count " + withFile(fs, PATH, Read, f => countLines(f, 0)).unwrap().toString());
  const ls = withFile(fs, PATH, Read, f => lines(f)).unwrap();
  console.log("lines " + ls.length.toString() + " " + ls.join(","));
  console.log("twice " + withFile(fs, PATH, Read, f => twice(f)).unwrap());
  // a function value that takes a File is an ordinary value
  const counter = (h: File): int => countLines(h, 0);
  console.log("value " + withFile(fs, PATH, Read, f => apply(f, counter)).unwrap().toString());
  console.log("inline " + withFile(fs, PATH, Read, f => apply(f, h => sum(h) * 2)).unwrap().toString());
  const table: ((h: File) => int)[] = [counter, sum];
  console.log("table " + withFile(fs, PATH, Read, f => table[1](f)).unwrap().toString());
}
