// exit: 101
// stderr: trap: task panicked: unwrap on None
// differential-skip-builtins: C2 behaviour change (a trap cancels the live children, which now print their cancellation line); the legacy world (--c-builtins, bootstrap/seed/runtime) is frozen
// std:task, trap-safe cleanup (C2): a task that traps inside a nested scope does not leave its children behind. Before the trap reaches the
// joiner the runtime cancels the scope of the children and joins them, so the child sees the cancellation, finishes its output, and has
// ended when `join` of the parent traps. The parent's own output comes first; the child can only stop after the trap.
import { scope, spawn, isCancelled } from "std:task";

function boom(): int {
  const none: Option<int> = None;
  return none.unwrap();
}

function parent(): int {
  return scope(w => {
    spawn(w, () => {
      while (!isCancelled()) {
      }
      console.log("child: cancelled by the trap of its parent");
      return 0;
    });
    console.log("parent: trapping");
    return boom();
  });
}

function main(): void {
  const r = scope(s => spawn(s, () => parent()).join());
  console.log("not reached " + r.toString());
}
