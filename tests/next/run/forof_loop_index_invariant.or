// `loopIndex` in an `@Invariant` before `for .. of` is type-checked and erased (also under --check-contracts).
// flags: --check-contracts
function countPositive(xs: int[]): usize {
  let n: usize = 0;
  @Invariant(n <= loopIndex)
  for (const x of xs) {
    if (x > 0) {
      n += 1;
    }
  }
  return n;
}

function main(): void {
  console.log(countPositive([3, -1, 4, 0, 5]).toString());
}
