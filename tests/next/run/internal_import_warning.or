// warns: W0493 W0493 W0493
// A user program that imports an internal std module (`std:taskcore`, `std:metacore`, `std:x/internal`) gets W0493 per import
// (ADR-0048 rule 7.3, ADR-0056). The std library itself imports them without a warning, which the rest of the suite shows
// (every program that uses std:task, std:meta, std:bytes or std:collections stays warning-free).
import { ringSlot } from "std:taskcore";
import { MRef } from "std:metacore";
import { allTrue } from "std:collections/internal";

function main(): void {
  console.log(`${ringSlot(4, 1, 2)} ${allTrue([true, true])}`);
}
