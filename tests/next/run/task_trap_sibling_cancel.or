// exit: 101
// stderr: trap: task panicked: unwrap on None
// wasm-skip: a task busy-polls isCancelled() for a flag only its trapping sibling sets; tasks run one at a time to completion, so it never ends
// differential-skip-builtins: C2 behaviour change (a trapping child cancels its siblings; legacy never delivers the cancellation and hangs); the legacy world (--c-builtins, bootstrap/seed/runtime) is frozen
// std:task, trap-safe cleanup (C2): a child that traps cancels its scope, so the siblings that are still running stop at their next
// checkpoint (`isCancelled`); the scope waits for all of them and then traps with the message of the failure. (Before C2 the sibling
// never saw the cancellation and the program hung.)
import { scope, spawn, isCancelled } from "std:task";

function main(): void {
  scope(s => {
    // printed before the trapping task exists, so before the sibling can see the cancellation: the output order is fixed
    console.log("body: done");
    spawn(s, () => {
      while (!isCancelled()) {
      }
      console.log("sibling: cancelled by the trap of another task of the scope");
      return 0;
    });
    spawn(s, () => {
      const none: Option<int> = None;
      return none.unwrap();
    });
    return 0;
  });
  console.log("not reached");
}
