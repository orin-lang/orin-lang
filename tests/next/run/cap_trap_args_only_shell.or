// exit: 101
// stderr: capability denied: process shell
// `withArgsOnly` removes the right to spawn: `shell` traps instead of running the command
import { Host, withProcess, withArgsOnly } from "std:host";
import { ProcessGrant, args } from "std:process";
import { shell } from "std:io";

function main(host: Host): void {
  withProcess(host, proc => {
    console.log("with spawn: " + shell(proc, "true").unwrap().toString());
    withArgsOnly(proc, p => {
      console.log("args still work: " + args(p).length.toString());
      shell(p, "echo MUST NOT RUN");
      console.log("unreachable");
    });
  });
}
