// exit: 101
// A trap inside a scope ends the process (status 101); the runtime's exit hook flushes and closes the open file
// (tools/test_tooling.sh checks the bytes that reached the disk).
import { Host, useFs } from "std:host";
import { FsGrant } from "std:fs";
import { withFile, Write } from "std:fs";

function main(host: Host): void {
  useFs(host, fs => { run(fs); });
}
function run(fs: FsGrant): void {
  const r = withFile(fs, "build/tests/fs_trap_in_scope.txt", Write, f => {
    f.write("written before the trap");
    console.log("in scope");
    const none: Option<int> = None;
    console.log(none.unwrap().toString());
  });
  console.log("not reached");
}
