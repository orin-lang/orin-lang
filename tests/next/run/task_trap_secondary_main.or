// exit: 101
// stderr: trap: unwrap on None
// stderr: also trapped while cleaning up: index out of bounds
// std:task, primary and secondary failures (C2): the body of a scope traps (the primary failure); the task it started traps too, on its
// own, when it sees the cancellation (a secondary failure). The runtime reports the primary one first and the secondary one on a line
// of its own, after the cleanup has joined the task.
import { scope, spawn, isCancelled } from "std:task";

function main(): void {
  scope(s => {
    spawn(s, () => {
      while (!isCancelled()) {
      }
      const xs: int[] = [1];
      return xs[7];
    });
    console.log("body: trapping");
    const none: Option<int> = None;
    return none.unwrap();
  });
  console.log("not reached");
}
