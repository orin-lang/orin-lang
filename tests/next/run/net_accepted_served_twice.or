// exit: 101
// stderr: invalid grant token
// An accepted connection is MOVED: its `Accepted` token is adopted once. Serving the same `Accepted` a second time traps
// (ADR-0017 Addendum C); the first adoption has already closed the socket.
import { Host, withNet } from "std:host";
import { milliseconds } from "std:time";
import { Bytes, bytesFromString } from "std:bytes";
import { Scope, scopeNetDo, spawnNet } from "std:task";
import { NetGrant, Listener, Stream, withListenerNet, acceptDetached, serveAccepted, withConnection, portOf, sendAll } from "std:net";

function main(host: Host): void {
  withNet(host, net => {
    scopeNetDo(net, (sc: Scope, g: NetGrant) => {
      withListenerNet(g, "127.0.0.1", 0, 4, (ln: Listener, n2: NetGrant) => {
        const port = portOf(ln);
        const c = spawnNet(sc, n2, (cg: NetGrant) => {
          withConnection(cg, "127.0.0.1", port, milliseconds(2000), (s: Stream) => {
            sendAll(s, bytesFromString("x"), milliseconds(1000));
            return 0;
          });
          return 0;
        });
        const a = acceptDetached(ln, milliseconds(2000));
        if (a.isOk()) {
          const acc = a.unwrap();
          serveAccepted(acc, (s: Stream, peer) => 0);
          console.log("served once");
          serveAccepted(acc, (s: Stream, peer) => 0);
          console.log("unreachable");
        }
        c.join();
      });
    });
  });
}
