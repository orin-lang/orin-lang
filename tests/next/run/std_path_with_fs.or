import { Host, withFs } from "std:host";
import { FsGrant } from "std:fs";
import { writeFile, readFile } from "std:fs";
import { joinAll, dirname, basename } from "std:path";

function main(host: Host): void {
  withFs(host, fs => { run(fs); });
}
function run(fs: FsGrant): void {
  const p = joinAll(["build", "tests", "std_path_with_fs.txt"]);
  writeFile(fs, p, "ok " + basename(p) + " in " + dirname(p)).unwrap();
  console.log(readFile(fs, p).unwrap());
}
