// Grants are passed down as borrowed arguments through ordinary functions, recursion and function values that take them
// as parameters; the scope ends them. Nested scopes use withFileFs (a closure cannot capture a grant).
import { Host, withFs } from "std:host";
import { FsGrant, FsError, writeFile, readFile, withFileFs, useFile, Read, Write } from "std:fs";

const P: string = "build/tests/cap_chain.txt";

function writeThrough(fs: FsGrant, n: int): Result<void, FsError> {
  return writeFile(fs, P, "n=" + n.toString());
}

function readBack(fs: FsGrant, f: (g: FsGrant) => string): string {
  return f(fs);
}

function main(host: Host): void {
  withFs(host, fs => {
    writeThrough(fs, 5).unwrap();
    console.log(readBack(fs, g => readFile(g, P).unwrap()));
    const depth = withFileFs(fs, P, Read, (f, fs2) => {
      const inner = withFileFs(fs2, P, Read, (f2, fs3) => readFile(fs3, P).unwrap().length);
      return inner.unwrap();
    });
    console.log("nested: " + depth.unwrap().toString());
  });
}
