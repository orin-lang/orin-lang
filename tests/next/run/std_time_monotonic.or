// Non-flaky real-clock smoke: equal millisecond samples are allowed; no tight timing bounds.
import { Host, withClock } from "std:host";
import { monotonicNow, deadlineAfter, milliseconds, remaining } from "std:time";
import { assert } from "std:test";
import { checkMonotonicArithmetic } from "../../std/time_monotonic_test";

function main(host: Host): void {
  checkMonotonicArithmetic();
  withClock(
    host,
    clock => {
      const first = monotonicNow(clock).unwrap();
      const second = monotonicNow(clock).unwrap();
      assert(second.millis >= first.millis, "monotonic observations never decrease");
      const deadline = deadlineAfter(second, milliseconds(0)).unwrap();
      assert(remaining(deadline, second).unwrap().millis == 0, "zero delay expires immediately");
      console.log("monotonic clock passed");
    },
  );
}
