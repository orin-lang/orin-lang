// exit: 101
// stderr: trap: task panicked: unwrap on None
// std:task, trap-safe cleanup (C2): the descendants of a trapping task are cancelled and joined even when they cannot observe a
// cancellation token. Here the parent traps while its child waits for a channel nobody will ever send to, and the child's own task waits
// in a channel too. Both are woken from their monitor wait and end ("task cancelled"); the parent's trap then reaches main. Nothing hangs
// (the test would time out) and the process ends with the trap of the parent.
import { scope, spawn, channel } from "std:task";

function parent(): int {
  return scope(w => {
    const quiet = channel<int>(1);
    spawn(w, () => {
      return scope(v => {
        spawn(v, () => {
          return quiet.rx.recv().unwrap();
        });
        return quiet.rx.recv().unwrap();
      });
    });
    console.log("parent: trapping");
    const none: Option<int> = None;
    return none.unwrap();
  });
}

function main(): void {
  const r = scope(s => spawn(s, () => parent()).join());
  console.log("not reached " + r.toString());
}
