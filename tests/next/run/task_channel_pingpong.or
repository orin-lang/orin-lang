// std:task: channels. A task echoes every number it receives, plus one, back through a second channel: ping-pong between
// two tasks over two bounded channels (capacity 1: every send waits for the receiver), then close and drain.
import { scope, spawnDo, channel } from "std:task";

function main(): void {
  const ping = channel<int>(1);
  const pong = channel<int>(1);
  const last = scope(s => {
    spawnDo(s, () => {
      let more = true;
      while (more) {
        match (ping.rx.recv()) {
          Ok(v) => {
            pong.tx.send(v + 1);
          },
          Err(e) => {
            more = false;
          },
        }
      }
      pong.tx.close();
    });
    let v = 0;
    let round = 0;
    while (round < 1000) {
      ping.tx.send(v);
      match (pong.rx.recv()) {
        Ok(r) => {
          v = r + 1;
        },
        Err(e) => {
          console.log("unexpected close");
        },
      }
      round += 1;
    }
    ping.tx.close();
    match (pong.rx.recv()) {
      Ok(_) => {
        console.log("unexpected value");
      },
      Err(e) => {
        console.log("pong closed");
      },
    }
    return v;
  });
  console.log("last value: " + last.toString());
  ping.rx.close();
  pong.rx.close();
}
