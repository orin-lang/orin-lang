// std:task: the scope joins every task spawned in it when the body returns, joined or not: the five tasks below do some
// work and publish a message each; nobody joins them, but when `scope` returns all five messages are in the channel.
import { scopeDo, spawnDo, channel } from "std:task";

function work(k: int): int {
  let acc = 0;
  let i = 0;
  while (i < 200000) {
    acc = (acc + i * k) % 1000003;
    i += 1;
  }
  return acc;
}

function main(): void {
  const out = channel<int>(8);
  scopeDo(s => {
    let k = 1;
    while (k <= 5) {
      const mine = k;
      spawnDo(s, () => {
        out.tx.send(work(mine));
      });
      k += 1;
    }
    console.log("body done, nothing joined");
  });
  out.tx.close();
  let n = 0;
  let sum = 0;
  let more = true;
  while (more) {
    match (out.rx.recv()) {
      Ok(v) => {
        n += 1;
        sum += v;
      },
      Err(e) => {
        more = false;
      },
    }
  }
  console.log("messages: " + n.toString());
  console.log("sum: " + sum.toString());
  out.rx.close();
}
