// The runtime keeps at most 256 files open; the 257th open fails with an Err (EMFILE) and everything that was
// opened is closed again on the way out.
import { Host, withFs } from "std:host";
import { FsGrant } from "std:fs";
import { withFile, withFileFs, useFile, Read, Write, File } from "std:fs";

const PATH: string = "build/tests/fs_many_files.txt";

// nests `depth` more scopes; returns the number of scopes that could be opened
function nest(fs: FsGrant, depth: int, opened: int): int {
  if (depth == 0) {
    return opened;
  }
  const r = withFileFs(fs, PATH, Read, (f, fs2) => nest(fs2, depth - 1, opened + 1));
  return match (r) {
    Ok(inner) => inner,
    Err(e) => opened
  };
}

function main(host: Host): void {
  withFs(host, fs => { run(fs); });
}
function run(fs: FsGrant): void {
  useFile(fs, PATH, Write, f => { f.writeLine("x"); }).unwrap();
  console.log("nest 10: " + nest(fs, 10, 0).toString());
  console.log("nest 256: " + nest(fs, 256, 0).toString());
  console.log("nest 300: " + nest(fs, 300, 0).toString());
  // after all of that the table is empty again
  console.log("reopen 256: " + nest(fs, 256, 0).toString());
  console.log("read: " + withFile(fs, PATH, Read, f => f.readLine().unwrapOr("")).unwrap());
}
