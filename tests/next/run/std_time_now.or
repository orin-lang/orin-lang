import { Host, withHost } from "std:host";
import { ClockGrant } from "std:time";
import { nowMillis, durationBetween, toMillis, formatIso } from "std:time";

function main(host: Host): void {
  withHost(host, (fs, proc, stdio, clock) => { run(clock); });
}
function run(clock: ClockGrant): void {
  const a = nowMillis(clock);
  const b = nowMillis(clock);
  // 2023-11-14 .. 2100: the clock is sane and does not run backwards between two reads here.
  console.log((a > 1700000000000).toString());
  console.log((a < 4102444800000).toString());
  console.log((toMillis(durationBetween(a, b)) >= 0).toString());
  console.log((formatIso(a).length == 24).toString());
}
