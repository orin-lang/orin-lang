import { Host, withHost } from "std:host";
import { StdioGrant } from "std:io";
import { readLine, readBytes, writeStdout } from "std:io";

function main(host: Host): void {
  withHost(host, (fs, proc, stdio, clock) => { run(stdio); });
}
function run(stdio: StdioGrant): void {
  let n: int = 0;
  while (true) {
    const l = readLine(stdio);
    if (l.isNone()) {
      break;
    }
    const s = l.unwrap();
    if (s == "BYTES") {
      const b = readBytes(stdio, 5);
      writeStdout(stdio, "bytes=[" + b.unwrapOr("<eof>") + "]");
      writeStdout(stdio, "\n");
      const rest = readBytes(stdio, 100);
      console.log("short read none: " + rest.isNone().toString());
      continue;
    }
    n += 1;
    console.log(n.toString() + ": " + s + " (" + s.length.toString() + ")");
  }
  console.log("lines=" + n.toString());
  console.log("eof readLine none: " + readLine(stdio).isNone().toString());
  console.log("empty read some: " + readBytes(stdio, 0).isSome().toString());
}
