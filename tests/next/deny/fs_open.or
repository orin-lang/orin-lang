// ORIN_DENY=fs: operations that return a Result report the denial as an Err (the program keeps running)
import { Host, withFs } from "std:host";
import { readFile, writeFile, withFile, fsErrorMessage, Read } from "std:fs";
function main(host: Host): void {
  withFs(host, fs => {
    const r = readFile(fs, "tests/next/deny/fs_open.or");
    console.log("read: " + (r.isOk() ? "ok" : fsErrorMessage(r.unwrapErr())));
    const w = writeFile(fs, "build/tests/deny_out.txt", "x");
    console.log("write: " + (w.isOk() ? "ok" : fsErrorMessage(w.unwrapErr())));
    const f = withFile(fs, "tests/next/deny/fs_open.or", Read, file => file.readLine().isSome());
    console.log("open: " + (f.isOk() ? "ok" : fsErrorMessage(f.unwrapErr())));
  });
  console.log("done");
}
