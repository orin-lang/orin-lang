// no denial: every family works (the control run of tools/test_capabilities.sh)
import { Host, withHost } from "std:host";
import { readFile } from "std:fs";
import { args } from "std:process";
import { readLine, shell } from "std:io";
import { nowMillis } from "std:time";
function main(host: Host): void {
  withHost(host, (fs, proc, stdio, clock) => {
    console.log("fs " + readFile(fs, "tests/next/deny/all_ok.or").isOk().toString());
    console.log("process " + args(proc).length.toString() + " " + shell(proc, "true").unwrap().toString());
    console.log("stdio " + readLine(stdio).isSome().toString());
    console.log("clock " + (nowMillis(clock) > 0).toString());
  });
}
