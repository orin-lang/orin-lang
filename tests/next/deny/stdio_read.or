// ORIN_DENY=stdio: reading stdin traps (an EOF would be indistinguishable from a real end of input)
import { Host, withStdio } from "std:host";
import { readLine } from "std:io";
function main(host: Host): void {
  withStdio(host, stdio => {
    console.log("before");
    console.log(readLine(stdio).isSome().toString());
  });
}
