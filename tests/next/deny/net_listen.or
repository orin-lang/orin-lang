// ORIN_DENY=net: a network operation returns Err (it has a Result), the program keeps running
import { Host, withNet } from "std:host";
import { milliseconds } from "std:time";
import { withListener, withConnection, resolve, isDenied, netErrorMessage, Listener, Stream } from "std:net";

function main(host: Host): void {
  withNet(host, net => {
    const r = withListener(net, "127.0.0.1", 0, 4, (ln: Listener) => { console.log("inside the listener scope"); });
    console.log(r.isOk() ? "listen: ok" : "listen: " + netErrorMessage(r.unwrapErr()));
    const c = withConnection(net, "127.0.0.1", 9, milliseconds(100), (s: Stream) => 1);
    console.log(c.isOk() ? "connect: ok" : (isDenied(c.unwrapErr()) ? "connect: denied" : "connect: failed"));
    const d = resolve(net, "localhost");
    console.log(d.isOk() ? "resolve: ok" : "resolve: " + netErrorMessage(d.unwrapErr()));
  });
  console.log("done");
}
