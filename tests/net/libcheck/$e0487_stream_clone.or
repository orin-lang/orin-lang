// error: E0487
// Library-level rule: a Stream is moved into a task, never duplicated.
import { Host, withNet } from "std:host";
import { grantClone, NetGrant, Listener, netListen, netAccept, grantListen, grantRevoke, netClose } from "std:fsraw";

function f(net: NetGrant): void {
  const g = grantListen(net, "127.0.0.1", 0);
  const ln = netListen(g, "127.0.0.1", 0, 4, 1);
  const s = netAccept(ln, 1, 1);
  const c = grantClone(s);
  netClose(s);
  netClose(ln);
  grantRevoke(g);
}

function main(host: Host): void {
  withNet(host, net => { f(net); });
}
