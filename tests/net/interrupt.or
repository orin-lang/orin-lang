// Interruptible network waits and operation-wide deadlines (ADR-0017 Addendum D, work package C3), for tools/test_net.sh
// (plain and ThreadSanitizer). Every case prints "<name>: ok" or "<name>: FAIL <why>"; the last line is "interrupt: ok" or
// "interrupt: FAIL". Times are read from the monotonic clock of a Stream (the only clock a program with a NetGrant has).
//
//   accept        a task blocked in accept wakes when its scope is cancelled from another task: Err(Cancelled), not Timeout
//   recv          the same for recv on an idle connection
//   send          the same for a send that fills the socket buffers of a peer that never reads
//   connect       the same for a connect that hangs (a listener with a full accept queue swallows the SYN; skipped where the OS
//                 refuses instead of dropping)
//   precancelled  a task spawned into an already cancelled scope fails every network call at once, without touching the socket
//   nested        cancelling an outer scope wakes a task of a scope nested in one of its tasks; cancelling the inner one wakes
//                 only the inner tasks
//   trickle       one deadline across many small reads: a peer sending a byte every 25 ms cannot stretch readExactUntil
//   senddeadline  sendAllUntil ends at its deadline although the peer reads nothing
//   connectdeadline connect to a hanging address ends at the deadline of withConnectionUntil
import { Host, withNet } from "std:host";
import { Deadline, MonotonicInstant, milliseconds } from "std:time";
import { Bytes, fromString } from "std:bytes";
import { Scope, TaskHandle, CancelToken, Sender, channel, scopeNet, spawnNet, sleepUntil } from "std:task";
import {
  NetGrant, Listener, Stream, Peer, NetError, NetErrorKind, StreamReader, Fill, Filled, FillClosed, FillLimit,
  Denied, Closed, Timeout, Cancelled, Reset, InvalidArgument, InvalidPeer, Os,
  withListenerNet, withConnectionBeside, withAccepted, withConnection, withConnectionUntil, acceptDetached, dropAccepted, Accepted, portOf, recv, recvUntil,
  sendAll, sendAllUntil, monotonicMillis, netErrorMessage
} from "std:net";

const DELAY: int = 200;
const LONG: int = 30000;   // every blocking call below is given 30 s: only a cancellation (or the case's own deadline) ends it early
const WAKE_SLACK: int = 1500;

type Probe = { what: string; t0: int; t1: int; };
type Outcome = { p: Probe; changed: bool; };

function kindName(k: NetErrorKind): string {
  return match (k) {
    Denied => "Denied",
    Closed => "Closed",
    Timeout => "Timeout",
    Cancelled => "Cancelled",
    Reset => "Reset",
    InvalidArgument => "InvalidArgument",
    InvalidPeer => "InvalidPeer",
    Os => "Os"
  };
}

function recvName(r: Result<Bytes, NetError>): string {
  return match (r) {
    Ok(b) => "data",
    Err(e) => e.kind == Closed ? "eof" : kindName(e.kind)
  };
}

function fillName(r: Result<Fill, NetError>): string {
  return match (r) {
    Ok(f) => match (f) {
      Filled(b) => "filled",
      FillClosed(b) => "closed",
      FillLimit => "limit"
    },
    Err(e) => kindName(e.kind)
  };
}

// A Result whose failure is reported as a Probe.
function probeOf(r: Result<Probe, NetError>, what: string): Probe {
  if (r.isOk()) {
    return r.unwrap();
  }
  return Probe { what: what + ": " + netErrorMessage(r.unwrapErr()), t0: 0, t1: 0 };
}

// The monotonic clock in milliseconds, read through a scratch loopback connection (-1 when that fails).
function nowMs(net: NetGrant): int {
  const r = withListenerNet(net, "127.0.0.1", 0, 1, (ln: Listener, n: NetGrant) => {
    const c = withConnectionBeside(n, "127.0.0.1", portOf(ln), milliseconds(2000), ln, (s: Stream, l2: Listener) => monotonicMillis(s));
    return c.isOk() ? c.unwrap() : -1;
  });
  return r.isOk() ? r.unwrap() : -1;
}

function at(ms: int): Deadline {
  return Deadline { at: MonotonicInstant { millis: ms } };
}

function verdict(name: string, p: Probe, wantKind: string): string {
  const waited = p.t1 - p.t0;
  if (p.what != wantKind) {
    return name + ": FAIL got " + p.what + " after " + waited.toString() + " ms, wanted " + wantKind;
  }
  if (waited < DELAY - 20) {
    return name + ": FAIL woke after " + waited.toString() + " ms, before the cancellation at " + DELAY.toString() + " ms";
  }
  if (waited > DELAY + WAKE_SLACK) {
    return name + ": FAIL woke only after " + waited.toString() + " ms";
  }
  return name + ": ok";
}

// ---------------------------------------------------------------------------------------------------- the blocked tasks

// accept: bind, make one connection and take it (so that the queue is empty and the clock is at hand), then wait for another.
function blockedAccept(net: NetGrant, starts: Sender<int>): Probe {
  const r = withListenerNet(net, "127.0.0.1", 0, 4, (ln: Listener, n: NetGrant) => {
    const q = withConnectionBeside(n, "127.0.0.1", portOf(ln), milliseconds(2000), ln, (c: Stream, l2: Listener) => {
      withAccepted(l2, milliseconds(2000), (a: Stream, p: Peer) => 0);
      const t0 = monotonicMillis(c);
      starts.send(t0);
      const a = acceptDetached(l2, milliseconds(LONG));
      const t1 = monotonicMillis(c);
      if (a.isOk()) {
        dropAccepted(a.unwrap());
        return Probe { what: "accepted", t0: t0, t1: t1 };
      }
      return Probe { what: kindName(a.unwrapErr().kind), t0: t0, t1: t1 };
    });
    return probeOf(q, "connect");
  });
  return probeOf(r, "listen");
}

// recv: the server side of an idle connection waits for bytes the client never sends.
function blockedRecv(net: NetGrant, starts: Sender<int>): Probe {
  const r = withListenerNet(net, "127.0.0.1", 0, 4, (ln: Listener, n: NetGrant) => {
    const q = withConnectionBeside(n, "127.0.0.1", portOf(ln), milliseconds(2000), ln, (c: Stream, l2: Listener) => {
      const a = withAccepted(l2, milliseconds(2000), (s: Stream, p: Peer) => {
        const t0 = monotonicMillis(s);
        starts.send(t0);
        const got = recv(s, 100, milliseconds(LONG));
        return Probe { what: recvName(got), t0: t0, t1: monotonicMillis(s) };
      });
      return probeOf(a, "accept");
    });
    return probeOf(q, "connect");
  });
  return probeOf(r, "listen");
}

// 1 MiB of text (a u8 array element takes 8 bytes of memory, so the tests send this block repeatedly instead of building one huge array)
function megabyte(): Bytes {
  let b = fromString("0123456789abcdef");
  while (b.length() < 1048576) {
    b = b.concat(b);
  }
  return b;
}

// send: the server side writes 1 MiB blocks (up to 200) to a client that never reads: the socket buffers fill after a few.
function blockedSend(net: NetGrant, starts: Sender<int>): Probe {
  const r = withListenerNet(net, "127.0.0.1", 0, 4, (ln: Listener, n: NetGrant) => {
    const q = withConnectionBeside(n, "127.0.0.1", portOf(ln), milliseconds(2000), ln, (c: Stream, l2: Listener) => {
      const a = withAccepted(l2, milliseconds(2000), (s: Stream, p: Peer) => {
        const t0 = monotonicMillis(s);
        starts.send(t0);
        const block = megabyte();
        let what = "sent";
        let i: int = 0;
        while (i < 200 && what == "sent") {
          const sent = sendAll(s, block, milliseconds(LONG));
          if (sent.isErr()) {
            what = kindName(sent.unwrapErr().kind);
          }
          i += 1;
        }
        return Probe { what: what, t0: t0, t1: monotonicMillis(s) };
      });
      return probeOf(a, "accept");
    });
    return probeOf(q, "connect");
  });
  return probeOf(r, "listen");
}

// Fills the accept queue of a backlog-1 listener until a connect times out; true when one did (the queue swallows SYNs).
function fillQueue(net: NetGrant, port: int): bool {
  let i: int = 0;
  while (i < 8) {
    const r = withConnection(net, "127.0.0.1", port, milliseconds(250), (s: Stream) => 0);
    if (r.isErr()) {
      return r.unwrapErr().kind == Timeout;
    }
    i += 1;
  }
  return false;
}

// connect: to a listener whose queue is full. what is "skipped" where the OS does not drop the SYN.
function blockedConnect(net: NetGrant, starts: Sender<int>): Probe {
  const r = withListenerNet(net, "127.0.0.1", 0, 1, (bh: Listener, n: NetGrant) => {
    const port = portOf(bh);
    if (!fillQueue(n, port)) {
      starts.send(nowMs(n));
      return Probe { what: "skipped", t0: 0, t1: 0 };
    }
    const t0 = nowMs(n);
    starts.send(t0);
    const c = withConnection(n, "127.0.0.1", port, milliseconds(LONG), (s: Stream) => 0);
    return Probe { what: c.isOk() ? "connected" : kindName(c.unwrapErr().kind), t0: t0, t1: 0 }; // t1: set by the caller
  });
  return probeOf(r, "listen");
}

// ---------------------------------------------------------------------------------------------------- cases

// One probe task and one canceller in a scope; the canceller sleeps DELAY ms after the probe's start and cancels the scope.
// A cancelled task cannot read the clock through the network any more, so the connect probe (which holds no stream) is timed by the
// caller right after the scope ended.
function cancelCase(net: NetGrant, name: string, which: int): string {
  const ch = channel<int>(2);
  const out = scopeNet(net, (sc: Scope, g: NetGrant) => {
    const tok = sc.token();
    const rx = ch.rx;
    const tx = ch.tx;
    const probe = spawnNet(sc, g, (t: NetGrant) => {
      return which == 0 ? blockedAccept(t, tx) : (which == 1 ? blockedRecv(t, tx) : (which == 2 ? blockedSend(t, tx) : blockedConnect(t, tx)));
    });
    const stopper = spawnNet(sc, g, (t: NetGrant) => {
      const t0 = match (rx.recv()) { Ok(v) => v, Err(e) => 0 };
      sleepUntil(at(t0 + DELAY));
      return tok.cancel();
    });
    const p = probe.join();
    return Outcome { p: p, changed: stopper.join() };
  });
  let p = out.p;
  if (which == 3 && p.what != "skipped") {
    p = Probe { what: p.what, t0: p.t0, t1: nowMs(net) };
  }
  if (p.what == "skipped") {
    return name + ": skipped (this OS does not drop a SYN for a full accept queue)";
  }
  return verdict(name, p, "Cancelled") + (out.changed ? "" : " (the token was already cancelled)");
}

// A task spawned into a cancelled scope fails at once, also against a listener that has a connection waiting.
function precancelled(net: NetGrant): string {
  return scopeNet(net, (sc: Scope, g: NetGrant) => {
    sc.cancel();
    const h = spawnNet(sc, g, (t: NetGrant) => {
      const r = withListenerNet(t, "127.0.0.1", 0, 4, (ln: Listener, n: NetGrant) => {
        const c = withConnection(n, "127.0.0.1", portOf(ln), milliseconds(LONG), (s: Stream) => 0);
        const a = acceptDetached(ln, milliseconds(LONG));
        return "connect " + (c.isErr() ? kindName(c.unwrapErr().kind) : "ok") + ", accept " + (a.isErr() ? kindName(a.unwrapErr().kind) : "ok");
      });
      return r.isOk() ? r.unwrap() : "no listener";
    });
    const r = h.join();
    return r == "connect Cancelled, accept Cancelled" ? "precancelled: ok" : "precancelled: FAIL " + r;
  });
}

// nested: a task of the outer scope opens an inner scope with a probe and a canceller of the INNER scope, while the outer scope has
// a second probe. The inner cancel (at DELAY) wakes the inner probe only; the outer probe is still blocked and is woken by the
// outer cancel (at 3 * DELAY).
function nested(net: NetGrant): string {
  const chOuter = channel<int>(2);
  const chInner = channel<int>(2);
  return scopeNet(net, (sc: Scope, g: NetGrant) => {
    const outerTok = sc.token();
    const rxOuter = chOuter.rx;
    const txOuter = chOuter.tx;
    const rxInner = chInner.rx;
    const txInner = chInner.tx;
    const outerProbe = spawnNet(sc, g, (t: NetGrant) => blockedRecv(t, txOuter));
    const middle = spawnNet(sc, g, (t: NetGrant) => {
      return scopeNet(t, (sc2: Scope, g2: NetGrant) => {
        const innerTok = sc2.token();
        const innerProbe = spawnNet(sc2, g2, (u: NetGrant) => blockedAccept(u, txInner));
        const innerStop = spawnNet(sc2, g2, (u: NetGrant) => {
          const t0 = match (rxInner.recv()) { Ok(v) => v, Err(e) => 0 };
          sleepUntil(at(t0 + DELAY));
          return innerTok.cancel();
        });
        const p = innerProbe.join();
        innerStop.join();
        return p;
      });
    });
    const outerStart = match (rxOuter.recv()) { Ok(v) => v, Err(e) => 0 };
    const innerResult = middle.join();
    sleepUntil(at(outerStart + 3 * DELAY));
    const outerSet = outerTok.cancel();
    const outerResult = outerProbe.join();
    const stayed = outerResult.t1 - outerResult.t0;
    const l1 = innerResult.what == "Cancelled" ? "nested inner: ok" : "nested inner: FAIL " + innerResult.what;
    const l2 = outerResult.what == "Cancelled" && stayed >= 3 * DELAY - 40 && stayed <= 3 * DELAY + WAKE_SLACK ? "nested outer: ok"
      : "nested outer: FAIL " + outerResult.what + " after " + stayed.toString() + " ms (it must outlast the inner cancel and end at the outer one)";
    const l3 = outerSet ? "nested token: ok" : "nested token: FAIL already set";
    return l1 + "\n" + l2 + "\n" + l3;
  });
}

// trickle: a peer that sends one byte every 25 ms; readExactUntil of 500 bytes with one 300 ms deadline ends at the deadline.
function trickleFeeder(net: NetGrant, port: int): bool {
  const r = withConnection(net, "127.0.0.1", port, milliseconds(2000), (c: Stream) => {
    const base = monotonicMillis(c);
    let i: int = 0;
    while (i < 200) {
      if (sendAll(c, fromString("x"), milliseconds(1000)).isErr()) {
        return false;
      }
      i += 1;
      sleepUntil(at(base + 25 * i));
    }
    return true;
  });
  return r.isOk();
}

function trickleReader(s: Stream): string {
  let rd = new StreamReader(1024);
  const t0 = monotonicMillis(s);
  const f = rd.readExactUntil(s, 500, at(t0 + 300));
  const dt = monotonicMillis(s) - t0;
  const got = rd.buffered().length();
  // then recvUntil in a loop on a second deadline: many small chunks, one deadline
  const t1 = monotonicMillis(s);
  const end = at(t1 + 300);
  let chunks: int = 0;
  let last = "data";
  while (last == "data") {
    last = recvName(recvUntil(s, 64, end));
    if (last == "data") {
      chunks += 1;
    }
  }
  const dt2 = monotonicMillis(s) - t1;
  if (fillName(f) != "Timeout") {
    return "trickle: FAIL readExactUntil gave " + fillName(f);
  }
  if (dt < 280 || dt > 300 + WAKE_SLACK) {
    return "trickle: FAIL readExactUntil ended after " + dt.toString() + " ms (deadline 300)";
  }
  if (got < 3 || got >= 500) {
    return "trickle: FAIL " + got.toString() + " bytes buffered";
  }
  if (last != "Timeout" || dt2 < 280 || dt2 > 300 + WAKE_SLACK || chunks < 3) {
    return "trickle: FAIL recvUntil loop ended " + last + " after " + dt2.toString() + " ms with " + chunks.toString() + " chunks";
  }
  return "trickle: ok";
}

function trickle(net: NetGrant): string {
  return scopeNet(net, (sc: Scope, g: NetGrant) => {
    const wire = withListenerNet(g, "127.0.0.1", 0, 4, (ln: Listener, n: NetGrant) => {
      const port = portOf(ln);
      const feeder = spawnNet(sc, n, (t: NetGrant) => trickleFeeder(t, port));
      const a = withAccepted(ln, milliseconds(2000), (s: Stream, p: Peer) => trickleReader(s));
      feeder.join();
      return a.isOk() ? a.unwrap() : "trickle: FAIL accept: " + netErrorMessage(a.unwrapErr());
    });
    return wire.isOk() ? wire.unwrap() : "trickle: FAIL no listener";
  });
}

// senddeadline: a peer that reads nothing; sendAllUntil of 1 MiB blocks with one 300 ms deadline.
function sendDeadline(net: NetGrant): string {
  const r = withListenerNet(net, "127.0.0.1", 0, 4, (ln: Listener, n: NetGrant) => {
    const q = withConnectionBeside(n, "127.0.0.1", portOf(ln), milliseconds(2000), ln, (c: Stream, l2: Listener) => {
      const a = withAccepted(l2, milliseconds(2000), (s: Stream, p: Peer) => {
        const t0 = monotonicMillis(s);
        const block = megabyte();
        const end = at(t0 + 300);
        let what = "sent everything";
        let i: int = 0;
        while (i < 200 && what == "sent everything") {
          const sent = sendAllUntil(s, block, end);
          if (sent.isErr()) {
            what = kindName(sent.unwrapErr().kind);
          }
          i += 1;
        }
        const dt = monotonicMillis(s) - t0;
        if (what != "Timeout") {
          return "senddeadline: FAIL " + what;
        }
        if (dt < 280 || dt > 300 + WAKE_SLACK) {
          return "senddeadline: FAIL ended after " + dt.toString() + " ms (deadline 300)";
        }
        return "senddeadline: ok";
      });
      return a.isOk() ? a.unwrap() : "senddeadline: FAIL accept";
    });
    return q.isOk() ? q.unwrap() : "senddeadline: FAIL connect";
  });
  return r.isOk() ? r.unwrap() : "senddeadline: FAIL listen";
}

// connectdeadline: connect to a listener with a full queue, absolute deadline 300 ms away.
function connectDeadline(net: NetGrant): string {
  const r = withListenerNet(net, "127.0.0.1", 0, 1, (bh: Listener, n: NetGrant) => {
    const port = portOf(bh);
    if (!fillQueue(n, port)) {
      return "connectdeadline: skipped (this OS does not drop a SYN for a full accept queue)";
    }
    const t0 = nowMs(n);
    const c = withConnectionUntil(n, "127.0.0.1", port, at(t0 + 300), (s: Stream) => 0);
    const dt = nowMs(n) - t0;
    if (c.isOk() || c.unwrapErr().kind != Timeout) {
      return "connectdeadline: FAIL " + (c.isOk() ? "connected" : kindName(c.unwrapErr().kind));
    }
    if (dt < 280 || dt > 300 + WAKE_SLACK) {
      return "connectdeadline: FAIL ended after " + dt.toString() + " ms (deadline 300)";
    }
    return "connectdeadline: ok";
  });
  return r.isOk() ? r.unwrap() : "connectdeadline: FAIL listen";
}

function report(line: string): int {
  console.log(line);
  return line.includes("FAIL") ? 1 : 0;
}

function main(host: Host): void {
  withNet(host, net => {
    let bad: int = 0;
    bad += report(cancelCase(net, "accept", 0));
    bad += report(cancelCase(net, "recv", 1));
    bad += report(cancelCase(net, "send", 2));
    bad += report(cancelCase(net, "connect", 3));
    bad += report(precancelled(net));
    bad += report(nested(net));
    bad += report(trickle(net));
    bad += report(sendDeadline(net));
    bad += report(connectDeadline(net));
    console.log(bad == 0 ? "interrupt: ok" : "interrupt: FAIL");
  });
}
