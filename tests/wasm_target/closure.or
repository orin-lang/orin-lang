// A function value passed through a local: the effect analysis cannot resolve the call (Unknown.*), so the manifest
// conservatively requires clock/v1 as well (compiler/analysis/orbit.or); it is not an error.
function apply(f: (x: int) => int, v: int): int {
  return f(v);
}

function main(): void {
  const dbl = (x: int) => x * 2;
  console.log(apply(dbl, 21).toString());
}
