// Task.Spawn and Task.Join need no capability on wasm64-orbit: the guest runs the tasks itself, one at a time. The spawned closure is an unresolved callback, so clock/v1 is listed too.
import { scope, spawn } from "std:task";
function main(): void {
  const total = scope(s => {
    const a = spawn(s, () => 20 + 1);
    const b = spawn(s, () => 21);
    return a.join() + b.join();
  });
  console.log(total.toString());
}
