// Process.Exit and Host.Acquire need no capability on wasm64-orbit: only "log/v1" (always) is required. (Process.Args needs process/v1: process.or.)
import { Host, withProcess } from "std:host";
import { exit } from "std:process";
function main(host: Host): void {
  withProcess(host, proc => { console.log("bye"); exit(3); });
}
