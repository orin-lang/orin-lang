// Process.Exit, Process.Args and Host.Acquire need no capability on wasm64-orbit: only "log/v1" (always) is required.
import { Host, useProcess } from "std:host";
import { args, exit } from "std:process";
function main(host: Host): void {
  useProcess(host, proc => { console.log(args(proc).length.toString()); exit(3); });
}
