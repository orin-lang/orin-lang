// Channel.Open / Send / Receive (with tasks) need no capability on wasm64-orbit either (clock/v1 is listed only because of the unresolved closure).
import { scope, spawnDo, channel } from "std:task";
function main(): void {
  const ch = channel<int>(4);
  scope(s => {
    spawnDo(s, () => { ch.tx.send(1); ch.tx.close(); });
    match (ch.rx.recv()) {
      Some(v) => { console.log(v.toString()); },
      None => { console.log("closed"); },
    }
  });
}
