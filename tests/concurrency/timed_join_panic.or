// exit: 101
// A task that panics ends its wait too: `joinTimeout` with a long timeout must return promptly (not after 60 s) and, like `join`,
// trap in the joiner with "task panicked: ...", status 101. (The end of a task is announced by the runtime also on a trap.)
import { Host, withClock } from "std:host";
import { seconds } from "std:time";
import { scopeClockDo, spawn } from "std:task";

function leaf(): int {
  const none: Option<int> = None;
  return none.unwrap();
}

function main(host: Host): void {
  console.log("start");
  withClock(host, clock => {
    scopeClockDo(clock, (s, c) => {
      const h = spawn(s, () => leaf());
      console.log("joining");
      h.joinTimeout(c, seconds(60));
      console.log("not reached");
    });
  });
}
