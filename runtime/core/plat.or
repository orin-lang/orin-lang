// $rt/plat -- the names of the L0 functions that `plat(k, a, b, c)` calls (ADR-0052 Addendum B, step R3e.0; hir/coreops.or).
//
// `plat` takes the table index `k` as a literal: a named constant is inlined to its literal, so the calls of `$rt` read
// `plat(PL_MONITOR_LOCK, m, 0, 0)`. The index is the position in the closed table of hir/coreops.or (`platOpName`); the signature of every
// function is in runtime/platform/orin_platform.h. Words go in, the result comes back as a word (a C `int` sign-extended; L0 returns 0 or
// a positive code), pointers are addresses, void functions give 0.

export const PL_THREAD_CREATE: usize = 0;       // (entry: fnAddr of a void(void *) entry, arg) -> handle > 0, 0 on failure
export const PL_THREAD_JOIN: usize = 1;         // (handle, &word of *arg) -> 0; L0 stores a `void *`, on a 32-bit target only the low 4 bytes: clear the word first
export const PL_THREAD_EXIT: usize = 2;         // () never returns
export const PL_THREAD_ID: usize = 3;           // () -> id >= 1
export const PL_MONITOR_NEW: usize = 4;         // (nwords) -> handle, 0 when none could be made
export const PL_MONITOR_FREE: usize = 5;        // (handle) -> 0, EBUSY, EINVAL
export const PL_MONITOR_LOCK: usize = 6;        // (handle) -> 0, EINVAL, EDEADLK
export const PL_MONITOR_UNLOCK: usize = 7;      // (handle) -> 0, EINVAL
export const PL_MONITOR_WAIT: usize = 8;        // (handle, cond) -> 0, EINVAL
export const PL_MONITOR_WAIT_UNTIL: usize = 9;  // (handle, cond, deadline_ms) -> 0, WAIT_TIMEOUT (1), EINVAL
export const PL_MONITOR_NOTIFY: usize = 10;     // (handle, cond, all) -> 0, EINVAL
export const PL_MONITOR_GET: usize = 11;        // (handle, i, &word) -> 0, EINVAL
export const PL_MONITOR_SET: usize = 12;        // (handle, i, v) -> 0, EINVAL
export const PL_MONITOR_GROW: usize = 13;       // (handle, nwords) -> 0, EINVAL, ENOMEM
export const PL_RUNTIME_LOCK: usize = 14;       // () the process-wide runtime lock
export const PL_RUNTIME_UNLOCK: usize = 15;     // ()
export const PL_CPU_COUNT: usize = 16;          // () -> processors online >= 1
export const PL_GETENV: usize = 17;             // (name: C string) -> the value (C string) or 0
export const PL_WRITE_LINE: usize = 18;         // (stream, buf, n): n bytes and a newline; stream 1 stdout (buffered), 2 stderr
export const PL_EXIT: usize = 19;               // (code) never returns
export const PL_WAKE_SIGNAL: usize = 20;        // (token) -> 1 when this call cancelled the token, 0 when it was cancelled already or is stale (C2)
export const PL_WAKE_BOUND: usize = 21;         // () -> the cancellation token bound to this thread, 0 = none (C2)
