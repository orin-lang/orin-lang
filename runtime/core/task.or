// $rt/task -- the task interface of `std:task`, written in Orin (ADR-0052 Addendum B). This file holds `parThreads` (step R3e.3); step
// R3e.4 adds the task record, spawn, join, message, watch, the thread entry and the trap.

import { load8, addrOf, plat, wadd, wmul } from "std:core";
import { PL_GETENV, PL_CPU_COUNT } from "./plat";

// The number of worker threads of a parallel pipeline (ADR-0039): the environment variable ORIN_THREADS when it is a number from 1 to
// 1024, otherwise the processors online. Results never depend on it (fixed chunks, combined in chunk order). `std:task` reaches this
// through `BTask(26)`; the backends call it in place of the C `orin_rt_par_threads` (mir/rt.or `l1Task`).
export function parThreads(): usize {
  const name = "ORIN_THREADS";
  const e = plat(PL_GETENV, wadd(addrOf(name), 32), 0, 0);
  if (e != 0 && load8(e) != 0) {
    let v: usize = 0;
    let ok = true;
    let p = e;
    let c = load8(p);
    while (c != 0 && ok) {
      if (c < 48 || c > 57 || v > 1024) {
        ok = false;
      } else {
        v = wadd(wmul(v, 10), c - 48);
      }
      p = wadd(p, 1);
      c = load8(p);
    }
    if (ok && v >= 1 && v <= 1024) {
      return v;
    }
  }
  return plat(PL_CPU_COUNT, 0, 0, 0);
}
