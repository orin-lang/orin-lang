// Word frequency over stdin (case-sensitive): words by descending count, then alphabetically.
import { Host, useHost } from "std:host";
import { StdioGrant, readLine } from "std:io";

function countWords(stdio: StdioGrant): Map<string, int> {
  let counts = new Map<string, int>();
  while (true) {
    const line = readLine(stdio);
    if (line.isNone()) {
      break;
    }
    for (const raw of line.unwrap().split(" ")) {
      const word = raw.trim();
      if (word.length == 0) {
        continue;
      }
      counts.set(word, counts.get(word).unwrapOr(0) + 1);
    }
  }
  return counts;
}

function main(host: Host): void {
  useHost(host, (fs, proc, stdio, clock) => {
    const counts = countWords(stdio);
    const entries = counts.entries().sort((a, b) => {
      if (a.value != b.value) {
        return b.value - a.value;
      }
      return a.key < b.key ? -1 : a.key > b.key ? 1 : 0;
    });
    for (const e of entries) {
      console.log(e.key + " " + e.value.toString());
    }
  });
}
