// Command-line parsing: the argument list in, a Parsed out. Pure, so every rule is a unit test.

export type Options = { lines: bool; words: bool; bytes: bool; };

export type Parsed =
  Run(Options)
  | Help
  | UsageError(string) // exit status 2
  | Unsupported(string); // a valid command line this tool cannot carry out: exit status 1

export function usage(): string {
  return "usage: wc [-l] [-w] [-c] [-]";
}

export function helpText(): string {
  return "wc - count lines, words and bytes on standard input\n" + "\n" + usage() + "\n" + "\n"
      + "  -l, --lines   print the number of lines (newline bytes)\n"
      + "  -w, --words   print the number of words (runs of non-white-space bytes)\n"
      + "  -c, --bytes   print the number of bytes\n" + "  -h, --help    print this text and exit\n"
      + "  -             read standard input (the default; the only input there is)\n" + "\n"
      + "With no -l, -w or -c all three are printed, in that order.\n"
      + "Exit status: 0 success, 1 the request cannot be carried out, 2 bad usage.\n";
}

function select(o: Options, letter: string): Option<Options> {
  if (letter == "l") {
    return Some(Options { lines: true, words: o.words, bytes: o.bytes });
  }
  if (letter == "w") {
    return Some(Options { lines: o.lines, words: true, bytes: o.bytes });
  }
  if (letter == "c") {
    return Some(Options { lines: o.lines, words: o.words, bytes: true });
  }
  return None;
}

function longName(name: string): string {
  return name == "lines" ? "l" : name == "words" ? "w" : name == "bytes" ? "c" : "";
}

export function parseArgs(argv: string[]): Parsed {
  let o = Options { lines: false, words: false, bytes: false };
  let any = false;
  let operandsAllowed = true; // false after "--"
  let flagsAllowed = true;
  for (const a of argv) {
    if (flagsAllowed && a == "--") {
      flagsAllowed = false;
    } else if (flagsAllowed && (a == "-h" || a == "--help")) {
      return Help;
    } else if (flagsAllowed && a.startsWith("--")) {
      const letter = longName(a.substring(2, a.length));
      if (letter == "") {
        return UsageError("unknown option " + a);
      }
      o = select(o, letter).unwrap();
      any = true;
    } else if (flagsAllowed && a.startsWith("-") && a.length > 1) {
      let i: usize = 1;
      while (i < a.length) {
        const next = select(o, a.charAt(i));
        if (next.isNone()) {
          return UsageError("unknown option -" + a.charAt(i));
        }
        o = next.unwrap();
        any = true;
        i += 1;
      }
    } else if (a != "-") {
      return Unsupported("cannot read " + a + ": only standard input is supported");
    }
  }
  if (!any) {
    o = Options { lines: true, words: true, bytes: true };
  }
  return Run(o);
}
