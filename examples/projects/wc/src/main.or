// wc: count lines, words and bytes on standard input.  Exit status: 0 success, 1 cannot carry out, 2 bad usage.
//
// Input comes from std:io (stdin) and arguments from std:process; there is no file access, so the program holds no
// file-system authority at all (its host policy could deny `fs` and it would not notice).
import { Host, useHost } from "std:host";
import { ProcessGrant, args, exit } from "std:process";
import { StdioGrant, readBytes } from "std:io";
import { Counts, emptyCounts, feedText } from "./count";
import {
  Options, Parsed, Run, Help, UsageError, Unsupported, parseArgs, helpText, usage,
} from "./options";
import { formatCounts } from "./format";

// Reads standard input to its end, one byte at a time (`readBytes(n)` is all-or-nothing, so n = 1 is the only way to keep
// every byte at end of input).
function countStdin(stdio: StdioGrant): Counts {
  let c = emptyCounts();
  while (true) {
    const b = readBytes(stdio, 1);
    if (b.isNone()) {
      return c;
    }
    c = feedText(c, b.unwrap());
  }
}

function report(o: Options, stdio: StdioGrant): int {
  console.log(formatCounts(countStdin(stdio), o));
  return 0;
}

function fail(status: int, message: string): int {
  console.error("wc: " + message);
  if (status == 2) {
    console.error(usage());
  }
  return status;
}

// Returns the exit status.
function run(proc: ProcessGrant, stdio: StdioGrant): int {
  return match (parseArgs(args(proc))) {
    Run(o) => report(o, stdio),
    Help => showHelp(),
    UsageError(m) => fail(2, m),
    Unsupported(m) => fail(1, m),
  };
}

function showHelp(): int {
  console.log(helpText());
  return 0;
}

function main(host: Host): void {
  useHost(
    host,
    (fs, proc, stdio, clock) => {
      const status = run(proc, stdio);
      if (status != 0) {
        exit(status);
      }
    },
  );
}
