// Counting: a small state machine fed one byte at a time, so it never needs the whole input in memory.

export type Counts = { lines: int; words: int; bytes: int; inWord: bool; };

export function emptyCounts(): Counts {
  return Counts { lines: 0, words: 0, bytes: 0, inWord: false };
}

// The bytes wc treats as white space: space, \t \n \v \f \r.
export function isSpace(b: int): bool {
  return b == 32 || b >= 9 && b <= 13;
}

export function feed(c: Counts, b: int): Counts {
  const space = isSpace(b);
  return Counts {
    lines: b == 10 ? c.lines + 1 : c.lines,
    words: !space && !c.inWord ? c.words + 1 : c.words,
    bytes: c.bytes + 1,
    inWord: !space,
  };
}

export function feedText(c: Counts, text: string): Counts {
  let r = c;
  let i: usize = 0;
  while (i < text.length) {
    r = feed(r, text.charCodeAt(i).toInt());
    i += 1;
  }
  return r;
}
