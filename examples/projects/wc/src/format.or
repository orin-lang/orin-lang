// Output: the selected counts, in the fixed order lines, words, bytes, each right-aligned in 7 columns (like GNU wc on stdin).
import { Counts } from "./count";
import { Options } from "./options";

const WIDTH: usize = 7;

function pad(n: int): string {
  let s = n.toString();
  while (s.length < WIDTH) {
    s = " " + s;
  }
  return s;
}

export function formatCounts(c: Counts, o: Options): string {
  let fields: string[] = [];
  if (o.lines) {
    fields.push(pad(c.lines));
  }
  if (o.words) {
    fields.push(pad(c.words));
  }
  if (o.bytes) {
    fields.push(pad(c.bytes));
  }
  return fields.join(" ");
}
