import { assertEq, assert } from "std:test";
import { emptyCounts, feedText, isSpace } from "../src/count";

@Test
function emptyInputCountsNothing(): void {
  const c = feedText(emptyCounts(), "");
  assertEq(c.lines, 0, "lines");
  assertEq(c.words, 0, "words");
  assertEq(c.bytes, 0, "bytes");
}

@Test
function linesAreNewlines(): void {
  assertEq(feedText(emptyCounts(), "a\nb\n").lines, 2, "two newlines");
  assertEq(feedText(emptyCounts(), "a\nb").lines, 1, "no final newline: still one newline byte");
  assertEq(feedText(emptyCounts(), "\n\n\n").lines, 3, "blank lines");
}

@Test
function wordsAreRunsOfNonSpace(): void {
  assertEq(feedText(emptyCounts(), "one two  three\tfour\nfive").words, 5, "mixed separators");
  assertEq(feedText(emptyCounts(), "   \n\t ").words, 0, "only white space");
  assertEq(feedText(emptyCounts(), "x").words, 1, "single byte");
}

@Test
function bytesAreNotCharacters(): void {
  assertEq(feedText(emptyCounts(), "héllo").bytes, 6, "e-acute is two bytes");
}

@Test
function chunksCanSplitAWord(): void {
  let c = feedText(emptyCounts(), "wo");
  c = feedText(c, "rd and");
  c = feedText(c, " more\n");
  assertEq(c.words, 3, "the state carries across chunks");
  assertEq(c.bytes, 14, "bytes");
}

@Test
function whiteSpaceSet(): void {
  assert(
    isSpace(32) && isSpace(9) && isSpace(10) && isSpace(11) && isSpace(12) && isSpace(13),
    "the six",
  );
  assert(!isSpace(0) && !isSpace(65) && !isSpace(160), "others");
}
