import { assert, assertEqString } from "std:test";
import { parseArgs, Options, Run, Help, UsageError, Unsupported, helpText } from "../src/options";
import { emptyCounts, feedText } from "../src/count";
import { formatCounts } from "../src/format";

function allOf(): Options {
  return Options { lines: true, words: true, bytes: true };
}

@Test
function noArgumentsMeansAllThree(): void {
  assert(parseArgs([]) == Run(allOf()), "default");
}

@Test
function flagsSelectCounts(): void {
  assert(parseArgs(["-l"]) == Run(Options { lines: true, words: false, bytes: false }), "-l");
  assert(
    parseArgs(["-w", "-c"]) == Run(Options { lines: false, words: true, bytes: true }),
    "-w -c",
  );
  assert(parseArgs(["-lc"]) == Run(Options { lines: true, words: false, bytes: true }), "-lc");
  assert(
    parseArgs(["--words"]) == Run(Options { lines: false, words: true, bytes: false }),
    "--words",
  );
}

@Test
function helpWins(): void {
  assert(parseArgs(["-l", "--help"]) == Help, "--help");
  assert(parseArgs(["-h"]) == Help, "-h");
  assert(helpText().startsWith("wc - count"), "text");
}

@Test
function badUsageIsReported(): void {
  assert(parseArgs(["-x"]) == UsageError("unknown option -x"), "short");
  assert(parseArgs(["-lx"]) == UsageError("unknown option -x"), "inside a group");
  assert(parseArgs(["--chars"]) == UsageError("unknown option --chars"), "long");
}

@Test
function operandsOtherThanStdinAreUnsupported(): void {
  assert(parseArgs(["-"]) == Run(allOf()), "dash is stdin");
  assert(
    parseArgs(["a.txt"]) == Unsupported("cannot read a.txt: only standard input is supported"),
    "file",
  );
  assert(
    parseArgs(["--", "-l"]) == Unsupported("cannot read -l: only standard input is supported"),
    "after --",
  );
}

@Test
function outputIsRightAlignedInTheFixedOrder(): void {
  const c = feedText(emptyCounts(), "a b\nc\n");
  assertEqString(formatCounts(c, allOf()), "      2       3       6", "all");
  assertEqString(
    formatCounts(c, Options { lines: false, words: false, bytes: true }),
    "      6",
    "bytes only",
  );
  assertEqString(
    formatCounts(c, Options { lines: true, words: false, bytes: true }),
    "      2       6",
    "lines and bytes",
  );
}
