import { assertEq, assertEqString, assert } from "std:test";
import { emptyStore, addNote, findNote, MAX_NOTES } from "../src/store";

@Test
function idsStartAtOneAndGrow(): void {
  const a = addNote(emptyStore(), "first", "one").unwrap();
  const b = addNote(a.store, "second", "two").unwrap();
  assertEq(a.note.id, 1, "first id");
  assertEq(b.note.id, 2, "second id");
  assertEq(b.store.notes.length.toInt(), 2, "two notes");
}

@Test
function addDoesNotChangeTheOldStore(): void {
  const empty = emptyStore();
  addNote(empty, "x", "y").unwrap();
  assertEq(empty.notes.length.toInt(), 0, "the original is a value and stays empty");
}

@Test
function findReturnsTheNoteOrNone(): void {
  const a = addNote(emptyStore(), "title", "text").unwrap();
  assertEqString(findNote(a.store, 1).unwrap().title, "title", "found");
  assert(findNote(a.store, 2).isNone(), "absent");
  assert(findNote(a.store, 0).isNone(), "zero is never an id");
}

@Test
function theStoreIsBounded(): void {
  let s = emptyStore();
  let i: int = 0;
  while (i < MAX_NOTES) {
    s = addNote(s, "n", "").unwrap().store;
    i += 1;
  }
  assert(addNote(s, "one too many", "").isErr(), "full");
}
