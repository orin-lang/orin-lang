import { assert, assertEq, assertEqString } from "std:test";
import { emptyStore } from "../src/store";
import { handle, parseNewNote } from "../src/api";

@Test
function healthIsOk(): void {
  const r = handle(emptyStore(), "GET", "/health", "");
  assertEq(r.answer.code, 200, "status");
  assertEqString(r.answer.body, "{\"status\":\"ok\"}", "body");
}

@Test
function createThenReadBack(): void {
  const c = handle(emptyStore(), "POST", "/notes", "{\"title\":\"milk\",\"text\":\"2 litres\"}");
  assertEq(c.answer.code, 201, "created");
  assertEqString(
    c.answer.body,
    "{\"id\":1,\"title\":\"milk\",\"text\":\"2 litres\"}",
    "created body",
  );
  const g = handle(c.store, "GET", "/notes/1", "");
  assertEq(g.answer.code, 200, "get");
  assertEqString(g.answer.body, c.answer.body, "same note");
  const l = handle(c.store, "GET", "/notes", "");
  assertEqString(l.answer.body, "[" + c.answer.body + "]", "list");
}

@Test
function emptyListAndMissingNote(): void {
  assertEqString(handle(emptyStore(), "GET", "/notes", "").answer.body, "[]", "empty list");
  assertEq(handle(emptyStore(), "GET", "/notes/7", "").answer.code, 404, "missing");
}

@Test
function badRequestsLeaveTheStoreAlone(): void {
  const r = handle(emptyStore(), "POST", "/notes", "{\"title\":");
  assertEq(r.answer.code, 400, "not json");
  assertEq(r.store.notes.length.toInt(), 0, "nothing stored");
  assertEq(
    handle(emptyStore(), "POST", "/notes", "{\"title\":\"a\"}").answer.code,
    400,
    "missing text",
  );
  assertEq(
    handle(emptyStore(), "POST", "/notes", "{\"title\":\"\",\"text\":\"\"}").answer.code,
    400,
    "empty title",
  );
  assertEq(
    handle(emptyStore(), "POST", "/notes", "{\"title\":\"a\",\"text\":\"b\",\"x\":1}").answer.code,
    400,
    "unknown member",
  );
  assertEq(
    handle(emptyStore(), "POST", "/notes", "{\"title\":1,\"text\":\"b\"}").answer.code,
    400,
    "wrong type",
  );
}

@Test
function otherStatuses(): void {
  assertEq(handle(emptyStore(), "DELETE", "/notes", "").answer.code, 405, "method");
  assertEq(handle(emptyStore(), "GET", "/notes/x", "").answer.code, 400, "bad id");
  assertEq(handle(emptyStore(), "GET", "/other", "").answer.code, 404, "route");
}

@Test
function parsingChecksSizes(): void {
  assert(parseNewNote("{\"title\":\"ok\",\"text\":\"\"}").isOk(), "empty text is fine");
  assert(parseNewNote("[]").isErr(), "array");
}
