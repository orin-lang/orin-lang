import { assert, assertEqString } from "std:test";
import {
  parseRoute, pathOf, Health, ListNotes, CreateNote, GetNote, BadId, WrongMethod, NotFound,
} from "../src/routes";

@Test
function pathsLoseQueryAndTrailingSlash(): void {
  assertEqString(pathOf("/notes?limit=2"), "/notes", "query");
  assertEqString(pathOf("/notes/"), "/notes", "slash");
  assertEqString(pathOf("/"), "/", "root stays");
}

@Test
function knownRoutes(): void {
  assert(parseRoute("GET", "/health") == Health, "health");
  assert(parseRoute("GET", "/notes") == ListNotes, "list");
  assert(parseRoute("POST", "/notes") == CreateNote, "create");
  assert(parseRoute("GET", "/notes/12?x=1") == GetNote(12), "get");
}

@Test
function wrongMethodsAndPaths(): void {
  assert(parseRoute("DELETE", "/notes") == WrongMethod("GET, POST"), "delete list");
  assert(parseRoute("POST", "/health") == WrongMethod("GET"), "post health");
  assert(parseRoute("PUT", "/notes/1") == WrongMethod("GET"), "put one");
  assert(parseRoute("GET", "/nope") == NotFound, "unknown");
}

@Test
function badIds(): void {
  assert(parseRoute("GET", "/notes/abc") == BadId, "letters");
  assert(parseRoute("GET", "/notes/-1") == BadId, "sign");
  assert(parseRoute("GET", "/notes/") == ListNotes, "trailing slash is the list");
  assert(parseRoute("GET", "/notes/1234567890") == BadId, "too long");
}
