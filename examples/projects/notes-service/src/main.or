// notes-service: a small concurrent JSON service.
//
//   notes-service [port] [maxConnections]
//     port             default 8080; 0 = any free port (printed on stderr as "listening on 127.0.0.1:PORT")
//     maxConnections   serve this many connections, then exit; 0 = forever (default)
//
//   GET  /health        200 {"status":"ok"}
//   GET  /notes         200 [{"id":1,"title":"..","text":".."}, ...]
//   POST /notes         201 + the new note; body {"title":"..","text":".."}
//   GET  /notes/{id}    200 + the note, or 404
import { Host, withProcess } from "std:host";
import { args } from "std:process";
import { Settings, run } from "./server";

function intArg(xs: string[], i: usize, dflt: int): int {
  if (i >= xs.length) {
    return dflt;
  }
  return match (parseInt(xs[i])) {
    Some(v) => v,
    None => dflt,
  };
}

function main(host: Host): void {
  const argv = withProcess(host, p => args(p));
  run(
    host,
    Settings {
      port: intArg(argv, 0, 8080),
      maxConnections: intArg(argv, 1, 0),
      workers: 8,
      queue: 16,
    },
  );
}
