// Routing: a method and a request target in, a Route out. Pure.

export type Route =
  Health
  | ListNotes
  | CreateNote
  | GetNote(int)
  | BadId
  | WrongMethod(string)
  | NotFound;

// The target without its query string and without a trailing slash ("/notes/?x=1" is "/notes").
export function pathOf(target: string): string {
  let p = target;
  const q = p.indexOf("?");
  if (q.isSome()) {
    p = p.substring(0, q.unwrap());
  }
  while (p.length > 1 && p.endsWith("/")) {
    p = p.substring(0, p.length - 1);
  }
  return p;
}

// Ids are plain decimal digits, 1 to 9 of them (no sign, no leading "+", no overflow).
function parseId(text: string): Option<int> {
  if (text.length == 0 || text.length > 9) {
    return None;
  }
  let i: usize = 0;
  while (i < text.length) {
    const c = text.charCodeAt(i);
    if (c < 48 || c > 57) {
      return None;
    }
    i += 1;
  }
  return parseInt(text);
}

function only(method: string, wanted: string, ok: Route): Route {
  return method == wanted ? ok : WrongMethod(wanted);
}

export function parseRoute(method: string, target: string): Route {
  const path = pathOf(target);
  if (path == "/health") {
    return only(method, "GET", Health);
  }
  if (path == "/notes") {
    if (method == "GET") {
      return ListNotes;
    }
    if (method == "POST") {
      return CreateNote;
    }
    return WrongMethod("GET, POST");
  }
  if (path.startsWith("/notes/")) {
    const id = parseId(path.substring(7, path.length));
    if (id.isNone()) {
      return BadId;
    }
    return only(method, "GET", GetNote(id.unwrap()));
  }
  return NotFound;
}
