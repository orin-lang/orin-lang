// The notes store: a plain value with pure operations. It knows nothing about HTTP, JSON or tasks, so it is
// trivial to test; the service keeps exactly one of these, inside the owner task (see owner.or).

export type Note = { id: int; title: string; text: string; };
export type Store = { notes: Note[]; next: int; };
export type Added = { store: Store; note: Note; };

// At most this many notes are kept; the service answers 507 beyond it.
export const MAX_NOTES: int = 1000;

export function emptyStore(): Store {
  return Store { notes: [], next: 1 };
}

// Appends a note with the next id (ids start at 1 and are never reused). Err when the store is full.
export function addNote(s: Store, title: string, text: string): Result<Added, string> {
  if (s.notes.length >= MAX_NOTES.toUsize()) {
    return Err("store is full");
  }
  const note = Note { id: s.next, title: title, text: text };
  let notes: Note[] = [];
  for (const n of s.notes) {
    notes.push(n);
  }
  notes.push(note);
  return Ok(Added { store: Store { notes: notes, next: s.next + 1 }, note: note });
}

export function findNote(s: Store, id: int): Option<Note> {
  for (const n of s.notes) {
    if (n.id == id) {
      return Some(n);
    }
  }
  return None;
}
